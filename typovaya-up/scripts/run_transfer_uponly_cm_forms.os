// Срез переноса вызовов ОМ только УП из модулей форм (ПеренестиВызовыОмУпИзМодуляФормы).
// oscript run_transfer_uponly_cm_forms.os -и <УП> -п <БП> -т <typovaya restored> -в <выход> --forms-file list.txt
Арг = АргументыКоманднойСтроки;
Исх = "";
Пост = "";
Тип = "";
Выход = "";
ФайлФорм = "";
Префикс = "УП_";
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-и" Тогда
		Й = Й + 1;
		Исх = Арг[Й];
	ИначеЕсли А = "-п" Тогда
		Й = Й + 1;
		Пост = Арг[Й];
	ИначеЕсли А = "-т" Тогда
		Й = Й + 1;
		Тип = Арг[Й];
	ИначеЕсли А = "-в" Тогда
		Й = Й + 1;
		Выход = Арг[Й];
	ИначеЕсли А = "--forms-file" Тогда
		Й = Й + 1;
		ФайлФорм = Арг[Й];
	ИначеЕсли А = "--prefix" Тогда
		Й = Й + 1;
		Префикс = Арг[Й];
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Исх = "" Или Пост = "" Или Выход = "" Или ФайлФорм = "" Тогда
	Сообщить("Нужны -и, -п, -в и --forms-file. Опционально -т typovaya restored.");
	ЗавершитьРаботу(1);
КонецЕсли;
К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Формы = Прот.ПрочитатьСписокФорм(ФайлФорм);
Если Формы.Количество() = 0 Тогда
	Сообщить("Пустой список форм: " + ФайлФорм);
	ЗавершитьРаботу(1);
КонецЕсли;
КореньТип = ?(Тип <> "", Тип, Исх);
ОмУп = Прот.ОбщиеМодулиТолькоВПервой(Исх, КореньТип);
ОмБп = Прот.ОбщиеМодулиТолькоВПервой(Пост, КореньТип);
Сообщить("ОМ только УП: " + ОмУп.Количество() + ", ОМ только БП: " + ОмБп.Количество());
КатВосст = ОбъединитьПути(Выход, "restored");
КатРасш = ОбъединитьПути(Выход, "extension");
СоздатьКаталог(КатВосст);
СоздатьКаталог(КатРасш);
ФормыОбъектов = Новый Соответствие;
УидыОбъектов = Новый Соответствие;
СтрокиФорм = Новый Массив;
СтрокиФорм.Добавить("rel,closed,moved,todo,hooks");
Тодо = Новый Массив;
Закрыто = 0;
Перенес = 0;
Пропущ = 0;
СФорм = 0;
Для Каждого ОтнСырой Из Формы Цикл
	Отн = Прот.НормПуть(ОтнСырой);
	ПутьУп = ОбъединитьПути(Исх, Отн);
	ПутьБп = ОбъединитьПути(Пост, Отн);
	ПутьТип = ОбъединитьПути(КореньТип, Отн);
	ПутьМУп = Прот.ПутьМодуляФормы(ПутьУп);
	ПутьМБп = Прот.ПутьМодуляФормы(ПутьБп);
	Если Не (Новый Файл(ПутьМУп)).Существует() Тогда
		Пропущ = Пропущ + 1;
		Тодо.Добавить(Отн + ": нет модуля УП");
		Продолжить;
	КонецЕсли;
	ХвостМ = Лев(Отн, СтрДлина(Отн) - СтрДлина("Form.xml")) + "Form\Module.bsl";
	ПутьМВосст = ОбъединитьПути(КатВосст, ХвостМ);
	ПутьМРасш = ОбъединитьПути(КатРасш, ХвостМ);
	Пер = Прот.ПеренестиВызовыОмУпИзМодуляФормы(ПутьМУп, ПутьМБп, ПутьМВосст, ПутьМРасш, ОмУп, Префикс, ОмБп);
	Для Каждого Стр Из Пер.todo Цикл
		Тодо.Добавить(Отн + " метод " + Стр);
	КонецЦикла;
	Закрыто = Закрыто + Пер.closed.Количество();
	Перенес = Перенес + Пер.moved.Количество();
	Если Пер.closed.Количество() + Пер.moved.Количество() = 0 Тогда
		Пропущ = Пропущ + 1;
		Если Пер.todo.Количество() = 0 Тогда
			Тодо.Добавить(Отн + ": нет методов с вызовами ОМ только УП — в срез не включена");
		КонецЕсли;
		Продолжить;
	КонецЕсли;
	СФорм = СФорм + 1;
	// Form.xml: typovaya (совпадает с БП для module_only; для both_differ оставляем typovaya-форму).
	ПутьXmlИст = ?( (Новый Файл(ПутьТип)).Существует(), ПутьТип, ПутьУп );
	Прот.СкопироватьФайлВ(ПутьXmlИст, ОбъединитьПути(КатВосст, Отн));
	Ключ = Прот.КлючОбъектаФормы(Отн);
	ИмяФормы = Прот.ИмяФормыИзПути(Отн);
	Если Ключ <> "" Тогда
		СписокФ = ФормыОбъектов.Получить(Ключ);
		Если СписокФ = Неопределено Тогда
			СписокФ = Новый Массив;
			ФормыОбъектов.Вставить(Ключ, СписокФ);
			УидыОбъектов.Вставить(Ключ, Прот.UuidИзМета(Прот.ПутьМетаОбъекта(КореньТип, Ключ)));
		КонецЕсли;
		Есть = Ложь;
		Для Каждого Уже Из СписокФ Цикл
			Если Уже = ИмяФормы Тогда
				Есть = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Не Есть Тогда
			СписокФ.Добавить(ИмяФормы);
		КонецЕсли;
	КонецЕсли;
	УидФормы = Прот.UuidИзМета(Прот.ПутьМетаФормы(КореньТип, Отн));
	ПутьМетаРасш = Прот.ПутьМетаФормы(КатРасш, Отн);
	Если ПутьМетаРасш <> "" Тогда
		СоздатьКаталог((Новый Файл(ПутьМетаРасш)).Путь);
		Запись = Новый ЗаписьТекста(ПутьМетаРасш, КодировкаТекста.UTF8);
		Запись.Записать(Прот.МетаЗаимствованнойФормы(ИмяФормы, УидФормы, ?(Ключ = "", ИмяФормы, Ключ)));
		Запись.Закрыть();
	КонецЕсли;
	СтрокиФорм.Добавить("""" + СтрЗаменить(Отн, """", """""") + ""","
		+ Пер.closed.Количество() + "," + Пер.moved.Количество() + "," + Пер.todo.Количество() + "," + Пер.hooks);
	Сообщить("  " + Отн + " closed=" + Пер.closed.Количество() + " moved=" + Пер.moved.Количество()
		+ " todo=" + Пер.todo.Количество() + " hooks=" + Пер.hooks);
КонецЦикла;
Для Каждого КЗ Из ФормыОбъектов Цикл
	Части = СтрРазделить(КЗ.Ключ, "\", Ложь);
	ПутьМетаРасшОб = ОбъединитьПути(КатРасш, КЗ.Ключ + ".xml");
	СоздатьКаталог((Новый Файл(ПутьМетаРасшОб)).Путь);
	Запись = Новый ЗаписьТекста(ПутьМетаРасшОб, КодировкаТекста.UTF8);
	Запись.Записать(Прот.МетаЗаимствованногоОбъекта(Части[0], Части[1], УидыОбъектов.Получить(КЗ.Ключ), КЗ.Значение, Прот.ПутьМетаОбъекта(КореньТип, КЗ.Ключ)));
	Запись.Закрыть();
КонецЦикла;
Стат = "{""forms"":" + СФорм + ",""closedMethods"":" + Закрыто + ",""movedMethods"":" + Перенес
	+ ",""skipped"":" + Пропущ + ",""todo"":" + Тодо.Количество() + "}";
Запись = Новый ЗаписьТекста(ОбъединитьПути(Выход, "proto_stat.json"), КодировкаТекста.UTF8);
Запись.Записать(Стат);
Запись.Закрыть();
Запись = Новый ЗаписьТекста(ОбъединитьПути(Выход, "proto_forms_stat.csv"), КодировкаТекста.UTF8);
Запись.Записать(СтрСоединить(СтрокиФорм, Символы.ПС) + Символы.ПС);
Запись.Закрыть();
Если Тодо.Количество() > 0 Тогда
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Выход, "proto_todo.txt"), КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(Тодо, Символы.ПС) + Символы.ПС);
	Запись.Закрыть();
КонецЕсли;
Сообщить("DONE forms=" + СФорм + " closedMethods=" + Закрыто + " movedMethods=" + Перенес
	+ " skipped=" + Пропущ + " todo=" + Тодо.Количество());