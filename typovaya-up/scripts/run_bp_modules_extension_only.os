// Только шаг МодулиБпВРасширении на готовом out (без пересборки extension).
Перем Каталог;

Функция Загрузить(Имя)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Каталог, Имя + ".os"));
КонецФункции

Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Арг = АргументыКоманднойСтроки;
Если Арг.Количество() < 1 Тогда
	Сообщить("run_bp_modules_extension_only.os <out>");
	ВызватьИсключение "args";
КонецЕсли;
Out = Арг[0];
Отч = Загрузить("ОтчетHTML");
Свод = Отч.ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Вб = Загрузить("ВозвратОбщихМодулейБп");
Мб = Загрузить("МодулиБпВРасширении");
Мб.Инициализировать(Вб);
Лог = Новый Массив;
Р = Мб.Обеспечить(ОбъединитьПути(Out, "restored"), ОбъединитьПути(Out, "extension"), Свод.meta.vendor, Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Сообщить(Отч.ВJSON(Р));