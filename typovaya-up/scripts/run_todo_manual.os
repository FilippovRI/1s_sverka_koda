// Пересчёт todo_manual_methods.md/.csv по готовому выходу без пересборки: oscript scripts/run_todo_manual.os <out>
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Out = АргументыКоманднойСтроки[0];
КэшП = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "КэшПроверок.os"));
Сохр = КэшП.ПрочитатьСравнениеЛюбой(ОбъединитьПути(Out, "cache", "compare.json"));
Если Сохр = Неопределено Тогда
	Сообщить("нет cache/compare.json в " + Out);
	ЗавершитьРаботу(2);
КонецЕсли;
Лог = Новый Массив;
ЗагрузитьСценарий(ОбъединитьПути(Каталог, "TodoРучныеМетоды.os")).Записать(Сохр.modules, ОбъединитьПути(Out, "extension"), ОбъединитьПути(Out, "restored"), Out, Лог);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
