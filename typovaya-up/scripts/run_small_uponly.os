// Быстрые шаги на готовом выходе без пересборки: smallUpOnlyObjects (мелкие объекты только УП → extension) и проверка
// ссылок restored перед загрузкой. Аргументы: <out> [только-проверка]
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Арг = АргументыКоманднойСтроки;
Если Арг.Количество() < 1 Тогда
	Сообщить("run_small_uponly.os <out> [только-проверка]");
	ВызватьИсключение "args";
КонецЕсли;
Out = Арг[0];
Отч = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОтчетHTML.os"));
Свод = Отч.ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Лог = Новый Массив;
Если Арг.Количество() < 2 Тогда
	ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ПереносМелкихОбъектовУп.os")).Применить(ОбъединитьПути(Out, "extension"), ОбъединитьПути(Out, "restored"),
		Свод.meta.source, Свод.meta.vendor, "УП_Доработки", Лог, Out);
КонецЕсли;
Р = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ПроверкаСсылокRestored.os")).Проверить(ОбъединитьПути(Out, "restored"), Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Если Р.missing.Количество() > 0 Тогда
	ЗавершитьРаботу(2);
КонецЕсли;
