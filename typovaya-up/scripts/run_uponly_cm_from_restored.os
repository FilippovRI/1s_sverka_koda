// Только шаг upOnlyCmFromRestored на готовом выходе (без пересборки хуков):
// ОМ только УП, подписки/регл. задания с их обработчиками и заимствование источников подписок.
Перем Каталог;
Функция Загрузить(Имя)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Каталог, Имя + ".os"));
КонецФункции
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Арг = АргументыКоманднойСтроки;
Если Арг.Количество() < 1 Тогда
	Сообщить("run_uponly_cm_from_restored.os <out>");
	ВызватьИсключение "args";
КонецЕсли;
Out = Арг[0];
Отч = Загрузить("ОтчетHTML");
Свод = Отч.ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Пер = Загрузить("ПереносОбъектовУп");
Пер.Инициализировать(Загрузить("ЧерновикРасширения"), Загрузить("ОбъектыТолькоУп"));
Лог = Новый Массив;
Р = Пер.УбратьОбщиеМодулиТолькоУпИзRestored(ОбъединитьПути(Out, "extension"), ОбъединитьПути(Out, "restored"),
	Свод.meta.source, Свод.meta.vendor, Новый Соответствие, "УП_Доработки", Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
