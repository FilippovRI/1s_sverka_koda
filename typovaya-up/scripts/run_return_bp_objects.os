// Шаги returnBpObjects + appModuleBpCalls (с условием «ОМ вернулись») на готовом выходе, как в Главный.os --только-extension.
// Аргументы: <out> [анализ]
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Арг = АргументыКоманднойСтроки;
Если Арг.Количество() < 1 Тогда
	Сообщить("run_return_bp_objects.os <out> [анализ]");
	ВызватьИсключение "args";
КонецЕсли;
Out = Арг[0];
Анализ = Арг.Количество() > 1;
Отч = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОтчетHTML.os"));
Свод = Отч.ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Лог = Новый Массив;
Р = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ВозвратОбъектовБпВRestored.os")).Вернуть(ОбъединитьПути(Out, "restored"),
	Свод.meta.vendor, ОбъединитьПути(Out, "extension"), Лог, Out, Анализ);
Если Не Анализ Тогда
	Возвр = Новый Соответствие;
	Для Каждого К Из Р.order Цикл
		Возвр.Вставить(НРег(Сред(К, 14)), Сред(К, 14));
	КонецЦикла;
	Ра = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ВызовыОмБпМодулейПриложения.os")).Применить(ОбъединитьПути(Out, "restored"),
		ОбъединитьПути(Out, "extension"), Свод.meta.vendor, "УП_", Лог, Out, Возвр);
КонецЕсли;
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
