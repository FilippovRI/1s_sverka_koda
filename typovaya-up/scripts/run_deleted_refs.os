// Ссылки на метаданные Удалить*.
// oscript scripts/run_deleted_refs.os <выгрузка-цель> <расширение> <вывод> [--хуки] [--замена]
// --замена: по уже готовому report/deleted_refs.md подставить аналог (&ИзменениеИКонтроль для цели).
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
А = АргументыКоманднойСтроки;
Если А.Количество() < 3 Тогда
	ВызватьИсключение "usage: run_deleted_refs.os <выгрузка-цель> <расширение> <вывод> [--хуки|--замена]";
КонецЕсли;
Хуки = Ложь;
Замена = Ложь;
Для Каждого Арг Из А Цикл
	Если НРег(Арг) = "--хуки" Тогда
		Хуки = Истина;
	КонецЕсли;
	Если НРег(Арг) = "--замена" Тогда
		Замена = Истина;
	КонецЕсли;
КонецЦикла;
Модуль = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ПроверкаУдалитьСсылок.os"));
Если Замена Тогда
	Рез = Модуль.ЗаменитьАналогиИзОтчёта(А[0], А[1], ОбъединитьПути(А[2], "report", "deleted_refs.md"));
	Сообщить("ik=" + Рез.ik + " replaced=" + Рез.replaced + " control=" + Рез.control + " skipped=" + Рез.skipped);
Иначе
	Р = Модуль.Проверить(А[0], А[1], А[2], Хуки);
	Сообщить("report: " + ОбъединитьПути(А[2], "report", "deleted_refs.md"));
	Сообщить("withAnalog=" + Р.withAnalog + " noAnalog=" + Р.noAnalog + " hooks=" + Р.hooks);
КонецЕсли;
