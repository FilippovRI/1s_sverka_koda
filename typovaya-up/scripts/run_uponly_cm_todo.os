// Пересчитать todo_uponly_cm_refs на готовом выходе, ничего не перенося: oscript scripts/run_uponly_cm_todo.os <out>
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Out = АргументыКоманднойСтроки[0];
Свод = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОтчетHTML.os")).ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Лог = Новый Массив;
ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ПереносМелкихОбъектовУп.os")).Применить(ОбъединитьПути(Out, "extension"), ОбъединитьПути(Out, "restored"),
	Свод.meta.source, Свод.meta.vendor, "УП_Доработки", Лог, Out, Истина);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
