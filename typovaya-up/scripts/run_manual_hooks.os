// Применить manual_hooks к готовому выходу без пересборки: oscript scripts/run_manual_hooks.os <out> <выгрузка БП> [имя расширения]
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
А = АргументыКоманднойСтроки;
Out = А[0];
Лог = Новый Массив;
Р = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "РучныеПерехваты.os")).Применить(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "manual_hooks"),
	А[1], ОбъединитьПути(Out, "extension"), ОбъединитьПути(Out, "restored"), ?(А.Количество() > 2, А[2], "УП_Доработки"), Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
ЗавершитьРаботу(?(Р.rejected > 0, 3, 0));
