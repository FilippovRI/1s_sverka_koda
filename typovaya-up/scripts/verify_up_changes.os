// Независимая сверка «не потеряны ли доработки УП».
// Не использует логику классификации генератора: сравнивает исходники УП и БП напрямую и ищет каждое отличие
// в restored, extension и todo-файлах выхода.
// Запуск: oscript scripts/verify_up_changes.os <выгрузка УП> <выгрузка БП> <каталог выхода>
// Пишет verify_up_changes.csv и verify_up_changes.md в каталог выхода.

Перем РвАннот;
Перем РвМаркер;
Перем РвПара;
Перем РвИмя;
Перем РвТег;
Перем КлассыПапок;

Процедура Инициализировать()
	РвАннот = Новый РегулярноеВыражение("&(Перед|После|Вместо|ИзменениеИКонтроль|Before|After|Around|ChangeAndValidate)\s*\(\s*""([^""]+)""");
	РвАннот.ИгнорироватьРегистр = Истина;
	// маркеры доработок УП в выгрузке: «// УП_начало», «// УП_конец», «// УП», «//уп», идентификаторы УП_…
	РвМаркер = Новый РегулярноеВыражение("(?<![\wЁё])уп_|//\s*уп(?![\wЁё])");
	РвМаркер.ИгнорироватьРегистр = Истина;
	РвПара = Новый РегулярноеВыражение("([\wЁё]+)\s*\.\s*([\wЁё]+)\s*\(");
	РвИмя = Новый РегулярноеВыражение("(?<![\wЁё.])([\wЁё]+)\s*\(");
	РвТег = Новый РегулярноеВыражение("(?<![\wЁё.])([A-Za-z]+)\.([\wЁё]+)");
	РвТег.ИгнорироватьРегистр = Ложь;
	КлассыПапок = Новый Соответствие;
	Пары = "Catalogs=Catalog;Documents=Document;Enums=Enum;ChartsOfCharacteristicTypes=ChartOfCharacteristicTypes;ChartsOfAccounts=ChartOfAccounts;"
		+ "ChartsOfCalculationTypes=ChartOfCalculationTypes;InformationRegisters=InformationRegister;AccumulationRegisters=AccumulationRegister;"
		+ "AccountingRegisters=AccountingRegister;CalculationRegisters=CalculationRegister;ExchangePlans=ExchangePlan;BusinessProcesses=BusinessProcess;"
		+ "Tasks=Task;DocumentJournals=DocumentJournal;Reports=Report;DataProcessors=DataProcessor;CommonModules=CommonModule;CommonForms=CommonForm;"
		+ "CommonCommands=CommonCommand;CommonTemplates=CommonTemplate;CommonPictures=CommonPicture;Constants=Constant;Roles=Role;Subsystems=Subsystem;"
		+ "WebServices=WebService;HTTPServices=HTTPService;FilterCriteria=FilterCriterion;SettingsStorages=SettingsStorage;"
		+ "DocumentNumerators=DocumentNumerator;Sequences=Sequence;FunctionalOptions=FunctionalOption;DefinedTypes=DefinedType;"
		+ "EventSubscriptions=EventSubscription;ScheduledJobs=ScheduledJob;CommandGroups=CommandGroup;CommonAttributes=CommonAttribute;"
		+ "SessionParameters=SessionParameter;XDTOPackages=XDTOPackage;StyleItems=StyleItem;Styles=Style;Languages=Language;"
		+ "FunctionalOptionsParameters=FunctionalOptionsParameter;WSReferences=WSReference;IntegrationServices=IntegrationService;Bots=Bot";
	Для Каждого П Из СтрРазделить(Пары, ";") Цикл
		Ч_ = СтрРазделить(П, "=");
		КлассыПапок.Вставить(Ч_[0], Ч_[1]);
	КонецЦикла;
КонецПроцедуры

Функция Прочитать(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Или Ф.ЭтоКаталог() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", СтрЗаменить(Т, Символы.ВК, ""));
КонецФункции

// Строка без комментария «//» вне строковых литералов, без пробелов по краям, в нижнем регистре.
Функция НормСтрока(Знач Стр)
	Если СтрНайти(Стр, "//") = 0 Тогда
		Возврат НРег(СокрЛП(СтрЗаменить(Стр, Символы.Таб, " ")));
	КонецЕсли;
	ВСтроке = Ложь;
	Для Н = 1 По СтрДлина(Стр) Цикл
		С = Сред(Стр, Н, 1);
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
		ИначеЕсли Не ВСтроке И С = "/" И Сред(Стр, Н + 1, 1) = "/" Тогда
			Стр = Лев(Стр, Н - 1);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НРег(СокрЛП(СтрЗаменить(Стр, Символы.Таб, " ")));
КонецФункции

// Соответствие НРег(имя метода) → Структура(Имя, Текст — нормализованный текст с заголовком), плюс "&цели" — цели аннотаций.
Функция Методы(Текст)
	Р = Новый Соответствие;
	Цели = Новый Соответствие;
	Если Текст = Неопределено Тогда
		Возврат Новый Структура("Методы, Цели, Маркеры", Р, Цели, Новый Соответствие);
	КонецЕсли;
	Маркеры = Новый Соответствие;
	Маркер = Ложь;
	Для Каждого С Из РвАннот.НайтиСовпадения(Текст) Цикл
		Цели.Вставить(НРег(С.Группы[2].Значение), Истина);
	КонецЦикла;
	Имя = "";
	Тело = Неопределено;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Н = НормСтрока(Стр);
		Если Тело = Неопределено Тогда
			Сл = СтрЗаменить(Н, "асинх ", "");
			Сл = СтрЗаменить(Сл, "async ", "");
			Для Каждого Кл Из СтрРазделить("процедура ,функция ,procedure ,function ", ",") Цикл
				Если СтрНачинаетсяС(Сл, Кл) Тогда
					Ост = СокрЛП(Сред(Сл, СтрДлина(Кл) + 1));
					Поз = СтрНайти(Ост, "(");
					Имя = СокрЛП(?(Поз > 0, Лев(Ост, Поз - 1), Ост));
					Тело = Новый Массив;
					Маркер = РвМаркер.Совпадает(Стр);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Тело <> Неопределено Тогда
				Тело.Добавить(Н);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Н <> "" Тогда
			Тело.Добавить(Н);
		КонецЕсли;
		Если Не Маркер И СтрНайти(Стр, "/") + СтрНайти(НРег(Стр), "уп") > 0 И РвМаркер.Совпадает(Стр) Тогда
			Маркер = Истина;
		КонецЕсли;
		Если СтрНачинаетсяС(Н, "конецпроцедуры") Или СтрНачинаетсяС(Н, "конецфункции") Или СтрНачинаетсяС(Н, "endprocedure") Или СтрНачинаетсяС(Н, "endfunction") Тогда
			Р.Вставить(Имя, СтрСоединить(Тело, Символы.ПС));
			Если Маркер Или СтрНачинаетсяС(Имя, "уп_") Тогда
				Маркеры.Вставить(Имя, Истина);
			КонецЕсли;
			Тело = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Методы, Цели, Маркеры", Р, Цели, Маркеры);
КонецФункции

// Объект «Tag.Имя» по относительному пути (Catalogs/X/... → Catalog.X; Ext/... → Configuration).
Функция ОбъектПоПути(Отн)
	Ч_ = СтрРазделить(Отн, "/");
	Если Ч_[0] = "Ext" Или Ч_.Количество() < 2 Тогда
		Возврат "Configuration";
	КонецЕсли;
	Тег = КлассыПапок.Получить(Ч_[0]);
	Имя = Ч_[1];
	Если СтрЗаканчиваетсяНа(Имя, ".xml") Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - 4);
	КонецЕсли;
	Возврат ?(Тег = Неопределено, Ч_[0], Тег) + "." + Имя;
КонецФункции

// todo: множество НРег «Tag.Имя», путей модулей и пар «объект|элемент» из всех todo_*.csv/.md каталога выхода.
Функция СобратьTodo(КаталогВыхода)
	Р = Новый Соответствие;
	Для Каждого Маска Из СтрРазделить("todo*.csv,todo*.md", ",") Цикл
		Для Каждого Ф Из НайтиФайлы(КаталогВыхода, Маска, Ложь) Цикл
			Т = Прочитать(Ф.ПолноеИмя);
			Если Т = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого С Из РвТег.НайтиСовпадения(Т) Цикл
				Р.Вставить(НРег(С.Группы[1].Значение + "." + С.Группы[2].Значение), Истина);
			КонецЦикла;
			Для Каждого Стр Из СтрРазделить(Т, Символы.ПС, Ложь) Цикл
				Для Каждого Поле Из СтрРазделить(СтрЗаменить(Стр, "|", ";"), ";", Ложь) Цикл
					П = НРег(СтрЗаменить(СокрЛП(Поле), "\", "/"));
					Если СтрНайти(П, "/") > 0 Или СтрНайти(П, ".") > 0 Тогда
						Р.Вставить(П, Истина);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

// ЦеликомОбъект: объект целиком упомянут в todo засчитывается (для объектов, которых нет в БП, и для метаданных);
// для кода объекта, общего с БП, нужен путь модуля или «объект.метод».
Функция ВTodo(Todo, Объект, Отн = "", Элемент = "", ЦеликомОбъект = Истина)
	Если ЦеликомОбъект И Todo.Получить(НРег(Объект)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Если Отн <> "" И Todo.Получить(НРег(Отн)) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Элемент <> "" И Todo.Получить(НРег(Объект + "." + Элемент)) <> Неопределено;
КонецФункции

Процедура Добавить(Рез, Вид, Объект, Модуль, Элемент, Статус)
	Рез.rows.Добавить(Новый Структура("kind, object, module, item, status, called, marker, sign", Вид, Объект, Модуль, Элемент, Статус, "", Ложь, ""));
	Ключ = Вид + "|" + Статус;
	Рез.stats.Вставить(Ключ, ?(Рез.stats.Получить(Ключ) = Неопределено, 0, Рез.stats.Получить(Ключ)) + 1);
	Рез.byStatus.Вставить(Статус, ?(Рез.byStatus.Получить(Статус) = Неопределено, 0, Рез.byStatus.Получить(Статус)) + 1);
КонецПроцедуры

// Код: методы УП, которых нет в БП или текст которых отличается.
Процедура СверитьКод(КореньУп, КореньБп, Восст, Расш, Todo, Рез)
	СоставБп = Состав(КореньБп);
	Длина = СтрДлина(КореньУп);
	Для Каждого Ф Из НайтиФайлы(КореньУп, "*.bsl", Истина) Цикл
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, Длина + 2), "\", "/");
		ТУп = Прочитать(Ф.ПолноеИмя);
		ТБп = Прочитать(ОбъединитьПути(КореньБп, Отн));
		Если ТБп <> Неопределено И ТБп = ТУп Тогда
			Продолжить;
		КонецЕсли;
		ДУп = Методы(ТУп);
		МУп = ДУп.Методы;
		МБп = Методы(ТБп).Методы;
		Отличия = Новый Массив;
		Для Каждого КЗ Из МУп Цикл
			Если МБп.Получить(КЗ.Ключ) <> КЗ.Значение Тогда
				Отличия.Добавить(КЗ.Ключ);
			КонецЕсли;
		КонецЦикла;
		Если Отличия.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Объект = ОбъектПоПути(Отн);
		МВ = Методы(Прочитать(ОбъединитьПути(Восст, Отн))).Методы;
		ДанРасш = Методы(Прочитать(ОбъединитьПути(Расш, Отн)));
		Для Каждого Им Из Отличия Цикл
			Если МВ.Получить(Им) = МУп.Получить(Им) Тогда
				Статус = "осталось в restored";
			ИначеЕсли ДанРасш.Методы.Получить(Им) <> Неопределено Или ДанРасш.Цели.Получить(Им) <> Неопределено
				Или ДанРасш.Методы.Получить("уп_" + Им) <> Неопределено Тогда
				// «УП_Имя» — копия метода УП в extension (несовместимая сигнатура или вспомогательный), вызовы переписаны
				Статус = "extension";
			ИначеЕсли ВTodo(Todo, Объект, Отн, Им, СоставБп.Получить(НРег(Объект)) = Неопределено) Тогда
				Статус = "todo";
			Иначе
				Статус = "ПОТЕРЯНО";
			КонецЕсли;
			Добавить(Рез, ?(МБп.Получить(Им) = Неопределено, "метод нет в БП", "метод изменён"), Объект, Отн, Им, Статус);
			Рез.rows[Рез.rows.ВГраница()].marker = ДУп.Маркеры.Получить(Им) <> Неопределено;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Объекты верхнего уровня Configuration.xml: Соответствие НРег «Tag.Имя» → «Tag.Имя».
Функция Состав(Корень)
	Р = Новый Соответствие;
	Т = Прочитать(ОбъединитьПути(Корень, "Configuration.xml"));
	Если Т = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Поз = СтрНайти(Т, "<ChildObjects>");
	Рв = Новый РегулярноеВыражение("<([A-Za-z]+)>([^<]+)</\1>");
	Для Каждого С Из Рв.НайтиСовпадения(?(Поз > 0, Сред(Т, Поз), Т)) Цикл
		Ключ = С.Группы[1].Значение + "." + СокрЛП(С.Группы[2].Значение);
		Р.Вставить(НРег(Ключ), Ключ);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Подчинённые элементы XML объекта: реквизиты, ТЧ, измерения, ресурсы, значения перечислений, формы, макеты, команды.
Функция Элементы(Путь)
	Р = Новый Соответствие;
	Т = Прочитать(Путь);
	Если Т = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("<(Attribute|TabularSection|Dimension|Resource|EnumValue|Command|AccountingFlag|ExtDimensionAccountingFlag|AddressingAttribute)\b[^>]*>\s*(?:<InternalInfo>[\s\S]*?</InternalInfo>\s*)?<Properties>\s*<Name>([^<]+)</Name>");
	Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
		Р.Вставить(НРег(С.Группы[1].Значение + "." + С.Группы[2].Значение), С.Группы[1].Значение + "." + С.Группы[2].Значение);
	КонецЦикла;
	Рв2 = Новый РегулярноеВыражение("<(Form|Template)>([^<]+)</\1>");
	Для Каждого С Из Рв2.НайтиСовпадения(Т) Цикл
		Р.Вставить(НРег(С.Группы[1].Значение + "." + С.Группы[2].Значение), С.Группы[1].Значение + "." + С.Группы[2].Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПапкаКласса(Тег)
	Для Каждого КЗ Из КлассыПапок Цикл
		Если КЗ.Значение = Тег Тогда
			Возврат КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Не-код: объекты УП, которых нет в БП, и подчинённые элементы УП, которых нет у объекта БП.
Процедура СверитьМетаданные(КореньУп, КореньБп, Восст, Расш, Todo, Рез)
	Уп = Состав(КореньУп);
	Бп = Состав(КореньБп);
	Вс = Состав(Восст);
	Рс = Состав(Расш);
	Для Каждого КЗ Из Уп Цикл
		Ч_ = СтрРазделить(КЗ.Значение, ".");
		Тег = Ч_[0];
		Папка = ПапкаКласса(Тег);
		Если Папка = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Бп.Получить(КЗ.Ключ) = Неопределено Тогда
			Если Вс.Получить(КЗ.Ключ) <> Неопределено Тогда
				Статус = "осталось в restored";
			ИначеЕсли Рс.Получить(КЗ.Ключ) <> Неопределено Тогда
				Статус = "extension";
			ИначеЕсли ВTodo(Todo, КЗ.Значение) Тогда
				Статус = "todo";
			Иначе
				Статус = "ПОТЕРЯНО";
			КонецЕсли;
			Добавить(Рез, "объект нет в БП", КЗ.Значение, Папка + "/" + Ч_[1] + ".xml", "", Статус);
			Продолжить;
		КонецЕсли;
		ЭУп = Элементы(ОбъединитьПути(КореньУп, Папка, Ч_[1] + ".xml"));
		Если ЭУп.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ЭБп = Элементы(ОбъединитьПути(КореньБп, Папка, Ч_[1] + ".xml"));
		ЭВ = Неопределено;
		ЭР = Неопределено;
		Для Каждого Э Из ЭУп Цикл
			Если ЭБп.Получить(Э.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЭВ = Неопределено Тогда
				ЭВ = Элементы(ОбъединитьПути(Восст, Папка, Ч_[1] + ".xml"));
				ЭР = Элементы(ОбъединитьПути(Расш, Папка, Ч_[1] + ".xml"));
			КонецЕсли;
			Им = Сред(Э.Значение, СтрНайти(Э.Значение, ".") + 1);
			Если ЭВ.Получить(Э.Ключ) <> Неопределено Тогда
				Статус = "осталось в restored";
			ИначеЕсли ЭР.Получить(Э.Ключ) <> Неопределено Тогда
				Статус = "extension";
			ИначеЕсли ВTodo(Todo, КЗ.Значение, "", Им) Тогда
				Статус = "todo";
			Иначе
				Статус = "ПОТЕРЯНО";
			КонецЕсли;
			Добавить(Рез, "элемент нет в БП: " + Лев(Э.Значение, СтрНайти(Э.Значение, ".") - 1), КЗ.Значение, Папка + "/" + Ч_[1] + ".xml", Им, Статус);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Вызовы в коде: пары «Слева.Метод(» и имена «Метод(» по объектам (НРег «Tag.Имя» → Соответствие имён).
Процедура СобратьВызовы(Корень, Пары, ИменаПоОбъектам, Фильтр = Неопределено)
	Если Не (Новый Файл(Корень)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Длина = СтрДлина(Корень);
	Для Каждого Ф Из НайтиФайлы(Корень, "*.bsl", Истина) Цикл
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, Длина + 2), "\", "/");
		Объект = НРег(ОбъектПоПути(Отн));
		Если Фильтр <> Неопределено И Фильтр.Получить(Объект) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Т = Прочитать(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из РвПара.НайтиСовпадения(Т) Цикл
			Пары.Вставить(НРег(С.Группы[1].Значение + "." + С.Группы[2].Значение), Истина);
		КонецЦикла;
		Если ИменаПоОбъектам <> Неопределено Тогда
			Им = ИменаПоОбъектам.Получить(Объект);
			Если Им = Неопределено Тогда
				Им = Новый Соответствие;
				ИменаПоОбъектам.Вставить(Объект, Им);
			КонецЕсли;
			Для Каждого С Из РвИмя.НайтиСовпадения(Т) Цикл
				Им.Вставить(НРег(С.Группы[1].Значение), Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Точный вызов: метод общего модуля — «Модуль.Метод(» где угодно или «Метод(» внутри того же модуля;
// метод объекта — «Метод(» в модулях/формах того же объекта или «ИмяОбъекта.Метод(» (вызов через менеджер).
Функция Вызывается(Объект, Метод, Пары, ИменаПоОбъектам)
	Ч_ = СтрРазделить(НРег(Объект), ".");
	Если Ч_.Количество() > 1 И Пары.Получить(Ч_[1] + "." + Метод) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Им = ИменаПоОбъектам.Получить(НРег(Объект));
	Возврат Им <> Неопределено И Им.Получить(Метод) <> Неопределено;
КонецФункции

// Для потерянных методов: точная отметка вызова (restored/extension) и признак настоящей доработки УП:
// маркер УП в тексте метода (// УП_начало, // УП, имя УП_…) или вызов из кода объектов только УП (их нет в БП).
// Остальное — разница версий типовых библиотек (вызывается — значит сломанный вызов, иначе мёртвый код версии).
Процедура ОтметитьВызовы(КореньУп, КореньБп, Восст, Расш, Рез)
	Есть = Ложь;
	Для Каждого С Из Рез.rows Цикл
		Если С.status = "ПОТЕРЯНО" И СтрНачинаетсяС(С.kind, "метод") Тогда
			Есть = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не Есть Тогда
		Возврат;
	КонецЕсли;
	Пары = Новый Соответствие;
	ИменаПоОбъектам = Новый Соответствие;
	СобратьВызовы(Восст, Пары, ИменаПоОбъектам);
	СобратьВызовы(Расш, Пары, ИменаПоОбъектам);
	// код объектов только УП (в БП их нет)
	ПарыУп = Новый Соответствие;
	ИменаУп = Новый Соответствие;
	СоставБп = Состав(КореньБп);
	СобратьВызовы(КореньУп, ПарыУп, ИменаУп, СоставБп);
	Для Каждого С Из Рез.rows Цикл
		Если Не (С.status = "ПОТЕРЯНО" И СтрНачинаетсяС(С.kind, "метод")) Тогда
			Продолжить;
		КонецЕсли;
		ВызовВыход = Вызывается(С.object, С.item, Пары, ИменаПоОбъектам);
		Ч_ = СтрРазделить(НРег(С.object), ".");
		ВызовУп = Ч_.Количество() > 1 И ПарыУп.Получить(Ч_[1] + "." + С.item) <> Неопределено;
		С.called = ?(ВызовВыход, "да", "нет");
		Если С.marker Тогда
			С.sign = "доработка УП: маркер";
		ИначеЕсли ВызовУп Тогда
			С.sign = "доработка УП: вызов из объекта только УП";
		ИначеЕсли ВызовВыход Тогда
			С.sign = "версия: сломанный вызов";
		Иначе
			С.sign = "версия: не вызывается";
		КонецЕсли;
		Для Каждого Ключ Из СтрРазделить("ПОТЕРЯНО, вызывается: " + С.called + "|ПОТЕРЯНО, " + С.sign, "|") Цикл
			Рез.byStatus.Вставить(Ключ, ?(Рез.byStatus.Получить(Ключ) = Неопределено, 0, Рез.byStatus.Получить(Ключ)) + 1);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция Сверить(КореньУп, КореньБп, КаталогВыхода, Лог) Экспорт
	Инициализировать();
	Восст = ОбъединитьПути(КаталогВыхода, "restored");
	Расш = ОбъединитьПути(КаталогВыхода, "extension");
	Todo = СобратьTodo(КаталогВыхода);
	Рез = Новый Структура("rows, stats, byStatus", Новый Массив, Новый Соответствие, Новый Соответствие);
	СверитьКод(КореньУп, КореньБп, Восст, Расш, Todo, Рез);
	СверитьМетаданные(КореньУп, КореньБп, Восст, Расш, Todo, Рез);
	ОтметитьВызовы(КореньУп, КореньБп, Восст, Расш, Рез);
	Записать(КаталогВыхода, Рез);
	Ит = Новый Массив;
	Для Каждого КЗ Из Рез.byStatus Цикл
		Ит.Добавить(КЗ.Ключ + " " + КЗ.Значение);
	КонецЦикла;
	Лог.Добавить("Сверка доработок УП: строк " + Рез.rows.Количество() + "; " + СтрСоединить(Ит, ", "));
	Возврат Рез;
КонецФункции

Функция Экр(З)
	Возврат СтрЗаменить(СтрЗаменить(З, ";", ","), "|", "/");
КонецФункции

Процедура Записать(Каталог, Рез)
	Csv = Новый Массив;
	Csv.Добавить("Вид;Объект;Модуль/файл;Элемент;Статус;Вызывается;Признак");
	Для Каждого С Из Рез.rows Цикл
		Csv.Добавить(Экр(С.kind) + ";" + Экр(С.object) + ";" + Экр(С.module) + ";" + Экр(С.item) + ";" + С.status + ";" + С.called + ";" + С.sign);
	КонецЦикла;
	Md = Новый Массив;
	Md.Добавить("# Сверка доработок УП: где оказалось каждое отличие УП от БП");
	Md.Добавить("");
	Md.Добавить("Независимая проверка: методы (нормализованный текст без комментариев и пробелов) и элементы метаданных УП, которых нет в БП или которые отличаются; ищутся в restored (тот же текст), extension (метод или аннотация на него, объект/элемент), todo-файлах выхода.");
	Md.Добавить("");
	Md.Добавить("| Статус | Количество |");
	Md.Добавить("|---|---|");
	Для Каждого КЗ Из Рез.byStatus Цикл
		Md.Добавить("| " + КЗ.Ключ + " | " + КЗ.Значение + " |");
	КонецЦикла;
	Md.Добавить("");
	Md.Добавить("| Вид | Статус | Количество |");
	Md.Добавить("|---|---|---|");
	Для Каждого КЗ Из Рез.stats Цикл
		Ч_ = СтрРазделить(КЗ.Ключ, "|");
		Md.Добавить("| " + Ч_[0] + " | " + Ч_[1] + " | " + КЗ.Значение + " |");
	КонецЦикла;
	Md.Добавить("");
	Md.Добавить("## ПОТЕРЯНО (первые 1000, сначала доработки УП)");
	Md.Добавить("");
	Md.Добавить("| Вид | Объект | Модуль/файл | Элемент | Вызывается | Признак |");
	Md.Добавить("|---|---|---|---|---|---|");
	Н = 0;
	Для Проход = 1 По 2 Цикл
	Для Каждого С Из Рез.rows Цикл
		Если С.status = "ПОТЕРЯНО" И Н < 1000 И (Проход = 1) = СтрНачинаетсяС(С.sign, "доработка") Тогда
			Md.Добавить("| " + Экр(С.kind) + " | " + Экр(С.object) + " | " + Экр(С.module) + " | " + Экр(С.item) + " | " + С.called + " | " + С.sign + " |");
			Н = Н + 1;
		КонецЕсли;
	КонецЦикла;
	КонецЦикла;
	ЗаписатьUtf8(ОбъединитьПути(Каталог, "verify_up_changes.csv"), СтрСоединить(Csv, Символы.ВК + Символы.ПС));
	ЗаписатьUtf8(ОбъединитьПути(Каталог, "verify_up_changes.md"), СтрСоединить(Md, Символы.ВК + Символы.ПС));
КонецПроцедуры

Процедура ЗаписатьUtf8(Путь, Текст)
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

Аргс = АргументыКоманднойСтроки;
Если Аргс.Количество() >= 3 Тогда
	Лог = Новый Массив;
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Р = Сверить(Аргс[0], Аргс[1], Аргс[2], Лог);
	Для Каждого С Из Лог Цикл
		Сообщить(С);
	КонецЦикла;
	Сообщить("время, с: " + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, "ЧДЦ=1; ЧГ="));
	ЗавершитьРаботу(?(Р.byStatus.Получить("ПОТЕРЯНО") = Неопределено, 0, 3));
КонецЕсли
