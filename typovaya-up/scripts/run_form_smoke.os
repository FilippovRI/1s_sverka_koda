// Дымовые тесты форм расширения для Vanessa Automation.
// oscript scripts/run_form_smoke.os <расширение> <вывод> [путь-базы]
// База по умолчанию: D:\typovaya-up-work\ib
// Сеанс 1С этот скрипт не запускает: файловую базу нельзя открывать вторым процессом.
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
А = АргументыКоманднойСтроки;
Если А.Количество() < 2 Тогда
	ВызватьИсключение "usage: run_form_smoke.os <расширение> <вывод> [путь-базы]";
КонецЕсли;
ПутьБазы = "D:\typovaya-up-work\ib";
Если А.Количество() >= 3 И Лев(А[2], 2) <> "--" Тогда
	ПутьБазы = А[2];
КонецЕсли;
Модуль = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ДымовыеФормы.os"));
Р = Модуль.Собрать(А[0], А[1], ПутьБазы);
Сообщить("сценарии=" + Р.сценарии + " формы_по_имени=" + Р.поИмени);
Сообщить("feature: " + ОбъединитьПути(А[1], "дымовые_формы.feature"));
Сообщить("база: " + Р.база);
