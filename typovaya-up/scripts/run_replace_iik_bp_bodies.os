// Подмена тел ИиК-методов в restored на тела БП, перестройка ИиК как БП→УП.
// typovaya-источник, выгрузки УП/БП и защищённые деревья не пишет.
// oscript run_replace_iik_bp_bodies.os -и <УП> -п <БП> -т <typovaya source> -в <срез restored+extension> [--forms-file list.txt]
Арг = АргументыКоманднойСтроки;
Исх = "";
Пост = "";
Тип = "";
Выход = "";
ФайлФорм = "";
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-и" Тогда
		Й = Й + 1;
		Исх = Арг[Й];
	ИначеЕсли А = "-п" Тогда
		Й = Й + 1;
		Пост = Арг[Й];
	ИначеЕсли А = "-т" Тогда
		Й = Й + 1;
		Тип = Арг[Й];
	ИначеЕсли А = "-в" Тогда
		Й = Й + 1;
		Выход = Арг[Й];
	ИначеЕсли А = "--forms-file" Тогда
		Й = Й + 1;
		ФайлФорм = Арг[Й];
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Исх = "" Или Пост = "" Или Тип = "" Или Выход = "" Тогда
	Сообщить("Нужны -и (УП), -п (БП), -т (typovaya source) и -в (срез с restored+extension).");
	ЗавершитьРаботу(1);
КонецЕсли;
К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Пер = ЗагрузитьСценарий(ОбъединитьПути(К, "ПереносОмУпИиК.os"));
КатВосст = Выход;
КатРасш = Выход;
Если (Новый Файл(ОбъединитьПути(Выход, "restored", "Configuration.xml"))).Существует() Тогда
	КатВосст = ОбъединитьПути(Выход, "restored");
КонецЕсли;
Если (Новый Файл(ОбъединитьПути(Выход, "extension", "Configuration.xml"))).Существует() Тогда
	КатРасш = ОбъединитьПути(Выход, "extension");
КонецЕсли;
Если Не (Новый Файл(ОбъединитьПути(КатВосст, "Configuration.xml"))).Существует() Тогда
	Сообщить("Нет Configuration.xml restored: " + КатВосст);
	ЗавершитьРаботу(1);
КонецЕсли;
Если Не (Новый Файл(ОбъединитьПути(КатРасш, "Configuration.xml"))).Существует() Тогда
	Сообщить("Нет Configuration.xml расширения: " + КатРасш);
	ЗавершитьРаботу(1);
КонецЕсли;
Если Пер.ПутьЗапрещёнДляЗаписи(КатВосст) Или Пер.ПутьЗапрещёнДляЗаписи(КатРасш) Тогда
	Сообщить("Отказ: приёмник в защищённом дереве.");
	ЗавершитьРаботу(2);
КонецЕсли;
Если ФайлФорм <> "" Тогда
	Формы = Прот.ПрочитатьСписокФорм(ФайлФорм);
Иначе
	Формы = Пер.СобратьФормыСВызовамиОмУп(Тип, Исх);
КонецЕсли;
Если Формы.Количество() = 0 Тогда
	Сообщить("Пустой список форм.");
	ЗавершитьРаботу(1);
КонецЕсли;
КатОтч = ОбъединитьПути(Выход, "reports");
СоздатьКаталог(КатОтч);
Лог = Новый Массив;
Сообщить("restored=" + КатВосст + ", extension=" + КатРасш + ", forms=" + Формы.Количество());
Рез = Пер.ЗаменитьТелаRestoredНаБп(Тип, Исх, Пост, КатВосст, КатРасш, Формы, Лог, КатОтч);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Ч = Новый ЗаписьТекста(ОбъединитьПути(КатОтч, "iik_bp_run.log"), КодировкаТекста.UTF8);
Ч.Записать(СтрСоединить(Лог, Символы.ПС) + Символы.ПС);
Ч.Закрыть();
Сообщить("OK run_replace_iik_bp_bodies");
