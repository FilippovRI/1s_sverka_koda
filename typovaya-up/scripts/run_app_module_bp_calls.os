// Только шаг appModuleBpCalls на готовом выходе: вызовы ОМ только БП в модулях приложения restored → extension.
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Арг = АргументыКоманднойСтроки;
Если Арг.Количество() < 1 Тогда
	Сообщить("run_app_module_bp_calls.os <out>");
	ВызватьИсключение "args";
КонецЕсли;
Out = Арг[0];
Отч = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОтчетHTML.os"));
Свод = Отч.ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Лог = Новый Массив;
Р = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ВызовыОмБпМодулейПриложения.os")).Применить(ОбъединитьПути(Out, "restored"),
	ОбъединитьПути(Out, "extension"), Свод.meta.vendor, "УП_", Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Для Каждого С Из Р.places Цикл
	Сообщить("  " + С);
КонецЦикла;
