// Заимствовать реквизиты для модулей заимствованных объектов в готовом выходе: oscript scripts/run_module_fields.os <out> [имя расширения]
А = АргументыКоманднойСтроки;
Лог = Новый Массив;
ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "РеквизитыМодулейЗаимствованных.os")).Применить(
	ОбъединитьПути(А[0], "extension"), ОбъединитьПути(А[0], "restored"), ?(А.Количество() > 1, А[1], "УП_Доработки"), Лог, А[0]);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
