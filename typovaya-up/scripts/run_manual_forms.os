// Скопировать Form.xml и модуль формы из УП в restored; форму из расширения убрать.
// oscript run_manual_forms.os -и <УП> -в <срез restored+extension> [--manual-forms-file list.txt]
Арг = АргументыКоманднойСтроки;
Исх = ""; Выход = ""; ФайлРучн = "";
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-и" Тогда
		Й = Й + 1; Исх = Арг[Й];
	ИначеЕсли А = "-в" Тогда
		Й = Й + 1; Выход = Арг[Й];
	ИначеЕсли А = "--manual-forms-file" Тогда
		Й = Й + 1; ФайлРучн = Арг[Й];
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Исх = "" Или Выход = "" Тогда
	Сообщить("Нужны -и (УП) и -в (срез). Опционально --manual-forms-file.");
	ЗавершитьРаботу(1);
КонецЕсли;
Если ФайлРучн = "" Тогда
	ФайлРучн = ОбъединитьПути(ТекущийСценарий().Каталог, "iik_manual_forms.txt");
КонецЕсли;
К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Пер = ЗагрузитьСценарий(ОбъединитьПути(К, "ПереносОмУпИиК.os"));
КатВосст = Выход;
КатРасш = Выход;
Если (Новый Файл(ОбъединитьПути(Выход, "restored", "Configuration.xml"))).Существует() Тогда
	КатВосст = ОбъединитьПути(Выход, "restored");
КонецЕсли;
Если (Новый Файл(ОбъединитьПути(Выход, "extension", "Configuration.xml"))).Существует() Тогда
	КатРасш = ОбъединитьПути(Выход, "extension");
КонецЕсли;
Если Пер.ПутьЗапрещёнДляЗаписи(КатВосст) Или Пер.ПутьЗапрещёнДляЗаписи(КатРасш) Тогда
	Сообщить("Отказ: защищённое дерево.");
	ЗавершитьРаботу(2);
КонецЕсли;
Формы = Прот.ПрочитатьСписокФорм(ФайлРучн);
Если Формы.Количество() = 0 Тогда
	Сообщить("Пустой список manual-forms: " + ФайлРучн);
	ЗавершитьРаботу(1);
КонецЕсли;
Лог = Новый Массив;
Сообщить("restored=" + КатВосст + ", extension=" + КатРасш + ", manual-forms=" + Формы.Количество());
Рез = Пер.ПрименитьРучныеФормыУп(Исх, КатВосст, КатРасш, Формы, Лог);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
КатОтч = ОбъединитьПути(Выход, "reports");
СоздатьКаталог(КатОтч);
Ч = Новый ЗаписьТекста(ОбъединитьПути(КатОтч, "iik_manual_forms_run.log"), КодировкаТекста.UTF8);
Ч.Записать(СтрСоединить(Лог, Символы.ПС) + Символы.ПС);
Ч.Закрыть();
Сообщить("OK run_manual_forms copied=" + Рез.forms + " todo=" + Рез.todo.Количество());
