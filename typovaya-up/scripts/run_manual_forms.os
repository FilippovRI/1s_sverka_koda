// Keep-up: Form.xml и модуль из УП в restored, из расширения форму убрать.
// &Вместо: typovaya + тела/хелперы БП в restored, хуки УП в расширении (только «чистые» формы).
// oscript run_manual_forms.os -и <УП> -п <БП> -т <typovaya> -в <срез> [--keepup-forms-file] [--vmesto-forms-file]
Арг = АргументыКоманднойСтроки;
Исх = ""; Выход = ""; Тип = ""; Пост = "";
ФайлКу = ""; ФайлВм = ""; ФайлРучн = "";
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-и" Тогда
		Й = Й + 1; Исх = Арг[Й];
	ИначеЕсли А = "-в" Тогда
		Й = Й + 1; Выход = Арг[Й];
	ИначеЕсли А = "-т" Тогда
		Й = Й + 1; Тип = Арг[Й];
	ИначеЕсли А = "-п" Тогда
		Й = Й + 1; Пост = Арг[Й];
	ИначеЕсли А = "--keepup-forms-file" Тогда
		Й = Й + 1; ФайлКу = Арг[Й];
	ИначеЕсли А = "--vmesto-forms-file" Тогда
		Й = Й + 1; ФайлВм = Арг[Й];
	ИначеЕсли А = "--manual-forms-file" Тогда
		Й = Й + 1; ФайлРучн = Арг[Й];
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Исх = "" Или Выход = "" Тогда
	Сообщить("Нужны -и (УП) и -в (срез). Опционально --keepup-forms-file и --vmesto-forms-file.");
	ЗавершитьРаботу(1);
КонецЕсли;
КатСкр = ТекущийСценарий().Каталог;
Если ФайлКу = "" Тогда
	ФайлКу = ОбъединитьПути(КатСкр, "iik_manual_keepup_forms.txt");
КонецЕсли;
Если ФайлВм = "" Тогда
	ФайлВм = ОбъединитьПути(КатСкр, "iik_manual_vmesto_forms.txt");
КонецЕсли;
К = ОбъединитьПути(КатСкр, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Пер = ЗагрузитьСценарий(ОбъединитьПути(К, "ПереносОмУпИиК.os"));
КатВосст = Выход;
КатРасш = Выход;
Если (Новый Файл(ОбъединитьПути(Выход, "restored", "Configuration.xml"))).Существует() Тогда
	КатВосст = ОбъединитьПути(Выход, "restored");
КонецЕсли;
Если (Новый Файл(ОбъединитьПути(Выход, "extension", "Configuration.xml"))).Существует() Тогда
	КатРасш = ОбъединитьПути(Выход, "extension");
КонецЕсли;
Если Пер.ПутьЗапрещёнДляЗаписи(КатВосст) Или Пер.ПутьЗапрещёнДляЗаписи(КатРасш) Тогда
	Сообщить("Отказ: защищённое дерево.");
	ЗавершитьРаботу(2);
КонецЕсли;

ОставитьУп = Новый Массив;
ЧерезВместо = Новый Массив;
ЕстьКу = (Новый Файл(ФайлКу)).Существует();
ЕстьВм = (Новый Файл(ФайлВм)).Существует();
Если ЕстьКу Или ЕстьВм Тогда
	Если ЕстьКу Тогда
		ОставитьУп = Прот.ПрочитатьСписокФорм(ФайлКу);
	КонецЕсли;
	Если ЕстьВм Тогда
		ЧерезВместо = Прот.ПрочитатьСписокФорм(ФайлВм);
	КонецЕсли;
Иначе
	Если ФайлРучн = "" Тогда
		ФайлРучн = ОбъединитьПути(КатСкр, "iik_manual_forms.txt");
	КонецЕсли;
	Формы = Прот.ПрочитатьСписокФорм(ФайлРучн);
	Если Формы.Количество() = 0 Тогда
		Сообщить("Пустой список manual-forms: " + ФайлРучн);
		ЗавершитьРаботу(1);
	КонецЕсли;
	Для Каждого Фр Из Формы Цикл
		Если Пер.ЭтоФормаОставляемаяЦеликомВRestored(Фр) Тогда
			ОставитьУп.Добавить(Фр);
		Иначе
			ЧерезВместо.Добавить(Фр);
		КонецЕсли;
	КонецЦикла;
КонецЕсли;
Если ОставитьУп.Количество() = 0 И ЧерезВместо.Количество() = 0 Тогда
	Сообщить("Пустые списки keep-up и &Вместо.");
	ЗавершитьРаботу(1);
КонецЕсли;

Лог = Новый Массив;
Сообщить("restored=" + КатВосст + ", extension=" + КатРасш + ", keep-up=" + ОставитьУп.Количество() + ", vmesto=" + ЧерезВместо.Количество());
Если ОставитьУп.Количество() > 0 Тогда
	РезУп = Пер.ПрименитьРучныеФормыУп(Исх, КатВосст, КатРасш, ОставитьУп, Лог);
Иначе
	РезУп = Новый Структура("forms, todo", 0, Новый Массив);
КонецЕсли;
РезВм = Новый Структура("forms, hooks, moved, prefixed, helpers, todo", 0, 0, 0, 0, 0, Новый Массив);
Если ЧерезВместо.Количество() > 0 Тогда
	Если Тип = "" Или Пост = "" Тогда
		Сообщить("Для &Вместо нужны -т (typovaya) и -п (БП).");
		ЗавершитьРаботу(1);
	КонецЕсли;
	РезВм = Пер.ПрименитьРучныеФормыВместо(Тип, Исх, Пост, КатВосст, КатРасш, ЧерезВместо, Лог, ОставитьУп);
КонецЕсли;
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
КатОтч = ОбъединитьПути(Выход, "reports");
СоздатьКаталог(КатОтч);
Ч = Новый ЗаписьТекста(ОбъединитьПути(КатОтч, "iik_manual_forms_run.log"), КодировкаТекста.UTF8);
Ч.Записать(СтрСоединить(Лог, Символы.ПС) + Символы.ПС);
Ч.Закрыть();
Сообщить("OK run_manual_forms keep-up=" + РезУп.forms + " vmesto=" + РезВм.forms + " hooks=" + РезВм.hooks + " moved=" + РезВм.moved + " prefixed=" + РезВм.prefixed + " helpers=" + РезВм.helpers + " todo=" + (РезУп.todo.Количество() + РезВм.todo.Количество()));
