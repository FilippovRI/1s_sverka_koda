// Класс 3 со ссылками из кода: метаданные БП → XML restored в готовом выходе.
// oscript scripts/run_metadata_bp.os <out> [выгрузка БП]  (по умолчанию — meta.vendor из summary.json)
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
А = АргументыКоманднойСтроки;
Out = А[0];
Если А.Количество() > 1 Тогда
	Бп = А[1];
Иначе
	Бп = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОтчетHTML.os")).ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json")).meta.vendor;
КонецЕсли;
Лог = Новый Массив;
ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ДобавлениеМетаданныхБп.os")).Применить(ОбъединитьПути(Out, "restored"), Бп, Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
