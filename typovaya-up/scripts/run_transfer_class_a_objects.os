// Срез класса «а»: код объектов только УП в расширение (заимствование), метаданные и Form.xml остаются в typovaya.
// Регистрация в Configuration.xml расширения: в генераторе (если файл есть) и при наложении среза (НаложитьСрезФорм).

Арг = АргументыКоманднойСтроки;
Тип = "";
Выход = "";
СписокФайл = "";
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-т" Или А = "--typovaya" Тогда
		Й = Й + 1;
		Тип = Арг[Й];
	ИначеЕсли А = "-в" Или А = "--out" Тогда
		Й = Й + 1;
		Выход = Арг[Й];
	ИначеЕсли А = "--objects-file" Тогда
		Й = Й + 1;
		СписокФайл = Арг[Й];
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Тип = "" Или Выход = "" Тогда
	Сообщить("Нужны -т <typovaya restored> и -в <выход среза>");
	ЗавершитьРаботу(1);
КонецЕсли;

Ключи = Новый Массив;
Если СписокФайл <> "" И (Новый Файл(СписокФайл)).Существует() Тогда
	ТекстСписка = Новый ЧтениеТекста(СписокФайл, КодировкаТекста.UTF8);
	Пока Истина Цикл
		Стр = ТекстСписка.ПрочитатьСтроку();
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Стр = СокрЛП(Стр);
		Если Стр <> "" И Не СтрНачинаетсяС(Стр, "#") Тогда
			Ключи.Добавить(СтрЗаменить(Стр, "/", "\"));
		КонецЕсли;
	КонецЦикла;
	ТекстСписка.Закрыть();
Иначе
	Для Каждого С Из СтрРазделить("Documents\Анкета,DataProcessors\ДоступныеАнкеты,InformationRegisters\СоответствияУполномоченногоПредставтеля,Catalogs\ШаблоныАнкет,InformationRegisters\НСКРегистрационныйФайлПФР,InformationRegisters\НСК_XSDсхемы,InformationRegisters\НСКЗагруженныеФайлыОтчетности,InformationRegisters\УчетнаяПолитикаОрганизаций,InformationRegisters\ФорматыВариантыОтчетов,Catalogs\УП_Респонденты,Constants\ИспользоватьАнкетирование,HTTPServices\ЗагрузкаФайловОтчетности,InformationRegisters\НСК_ПодготовленныеКОтправкеОтчеты,InformationRegisters\НСКДокументыКОтправкеПоПочте", ",") Цикл
		Ключи.Добавить(СокрЛП(С));
	КонецЦикла;
КонецЕсли;

К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
КатВосст = ОбъединитьПути(Выход, "restored");
КатРасш = ОбъединитьПути(Выход, "extension");
СоздатьКаталог(КатВосст);
СоздатьКаталог(КатРасш);

Модулей = 0;
Форм = 0;
Объектов = 0;
Тодо = Новый Массив;
Строки = Новый Массив;
Для Каждого Ключ Из Ключи Цикл
	Пер = Прот.ПеренестиКодОбъектаТолькоУпВРасширение(Ключ, Тип, КатВосст, КатРасш);
	Модулей = Модулей + Пер.movedModules.Количество();
	Форм = Форм + Пер.borrowedForms.Количество();
	Если Пер.movedModules.Количество() > 0 Или Пер.borrowedForms.Количество() > 0 Тогда
		Объектов = Объектов + 1;
	КонецЕсли;
	Для Каждого С Из Пер.todo Цикл
		Тодо.Добавить(С);
	КонецЦикла;
	Строки.Добавить(Ключ + ";moved=" + Пер.movedModules.Количество() + ";forms=" + Пер.borrowedForms.Количество() + ";todo=" + Пер.todo.Количество());
	Сообщить(Ключ + " moved=" + Пер.movedModules.Количество() + " forms=" + Пер.borrowedForms.Количество() + " todo=" + Пер.todo.Количество());
КонецЦикла;

Стат = "{""objects"":" + Объектов + ",""movedModules"":" + Модулей + ",""borrowedForms"":" + Форм + ",""todo"":" + Тодо.Количество() + "}";
Запись = Новый ЗаписьТекста(ОбъединитьПути(Выход, "proto_stat.json"), КодировкаТекста.UTF8);
Запись.Записать(Стат);
Запись.Закрыть();
Запись = Новый ЗаписьТекста(ОбъединитьПути(Выход, "proto_objects.txt"), КодировкаТекста.UTF8);
Запись.Записать(СтрСоединить(Строки, Символы.ПС) + Символы.ПС);
Запись.Закрыть();
Если Тодо.Количество() > 0 Тогда
	Запись = Новый ЗаписьТекста(ОбъединитьПути(Выход, "proto_todo.txt"), КодировкаТекста.UTF8);
	Запись.Записать(СтрСоединить(Тодо, Символы.ПС) + Символы.ПС);
	Запись.Закрыть();
КонецЕсли;
Сообщить("DONE objects=" + Объектов + " movedModules=" + Модулей + " borrowedForms=" + Форм + " todo=" + Тодо.Количество());
