// Статическая проверка ссылок Form.xml среза в итоговой restored (после шага метаданных БП).
// oscript scripts/run_validate_form_refs.os <restored> [proto_forms_stat.csv|forms.txt]
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ФормыБпПрототип.os"));
А = АргументыКоманднойСтроки;
Если А.Количество() < 1 Тогда
	ВызватьИсключение "usage: run_validate_form_refs.os <restored> [forms.csv|forms.txt]";
КонецЕсли;
Корень = А[0];
Фильтр = Новый Массив;
Если А.Количество() > 1 Тогда
	ПутьСписка = А[1];
	Текст = Новый ЧтениеТекста(ПутьСписка, КодировкаТекста.UTF8);
	Первая = Истина;
	Пока Истина Цикл
		Стр = Текст.ПрочитатьСтроку();
		Если Стр = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если Первая Тогда
			Первая = Ложь;
			Если СтрНачинаетсяС(СтрЗаменить(Стр, """", ""), "rel") Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Отн = Стр;
		Зап = СтрНайти(Отн, ",");
		Если Зап > 0 Тогда
			Отн = Лев(Отн, Зап - 1);
		КонецЕсли;
		Отн = СтрЗаменить(Отн, """", "");
		Отн = СокрЛП(Отн);
		Если Отн <> "" Тогда
			Фильтр.Добавить(Отн);
		КонецЕсли;
	КонецЦикла;
	Текст.Закрыть();
Иначе
	ВызватьИсключение "нужен список форм (proto_forms_stat.csv)";
КонецЕсли;
Замечания = Прот.ПроверитьСсылкиФорм(Корень, Фильтр);
Сообщить("validate_form_refs: forms=" + Фильтр.Количество() + " issues=" + Замечания.Количество());
Для Каждого С Из Замечания Цикл
	Сообщить(С);
КонецЦикла;
Если Замечания.Количество() > 0 Тогда
	ЗавершитьРаботу(1);
КонецЕсли;
