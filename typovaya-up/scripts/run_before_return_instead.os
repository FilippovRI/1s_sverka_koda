// oscript scripts/run_before_return_instead.os <extension> [report]
Если АргументыКоманднойСтроки.Количество() < 1 Тогда
	Сообщить("usage: run_before_return_instead.os <extension> [report]");
	ЗавершитьРаботу(1);
КонецЕсли;
КРасш = АргументыКоманднойСтроки[0];
КОтч = ?(АргументыКоманднойСтроки.Количество() > 1, АргументыКоманднойСтроки[1], "");
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Синтез.Инициализировать(Разбор);
Перев = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПереводПередВВместо.os"));
Перев.Инициализировать(Разбор, Синтез);
Лог = Новый Массив;
Р = Перев.Применить(КРасш, КОтч, Лог);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Если Не Р.ok Тогда
	Сообщить(Р.reason);
	ЗавершитьРаботу(1);
КонецЕсли;
Сообщить("converted=" + Р.converted.Количество() + " check=" + Р.check.Количество());
Если Р.reportPath <> "" Тогда
	Сообщить("report: " + Р.reportPath);
КонецЕсли;
