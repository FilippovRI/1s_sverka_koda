// Наложить срез форм (restored/extension в --срез) на полные выгрузки цели.
// Не меняет исходные выгрузки УП/БП и чужие каталоги сборки.

Арг = АргументыКоманднойСтроки;
Срез = "";
Восст = "";
Расш = "";
Ошибки = Новый Массив;
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "--срез" Или А = "--slice" Или А = "-с" Тогда
		Й = Й + 1;
		Срез = Арг[Й];
	ИначеЕсли А = "--restored" Или А = "--восстановленная" Или А = "-р" Тогда
		Й = Й + 1;
		Восст = Арг[Й];
	ИначеЕсли А = "--extension" Или А = "--расширение" Или А = "-е" Тогда
		Й = Й + 1;
		Расш = Арг[Й];
	ИначеЕсли А = "-h" Или А = "--help" Тогда
		Сообщить("overlay_forms_bp_proto.os --срез <proto> --restored <цель restored> --extension <цель extension>");
		ЗавершитьРаботу(0);
	Иначе
		Ошибки.Добавить("Неизвестный аргумент: " + А);
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Срез = "" Или Восст = "" Или Расш = "" Тогда
	Ошибки.Добавить("Нужны --срез, --restored и --extension.");
КонецЕсли;
Если Ошибки.Количество() > 0 Тогда
	Для Каждого С Из Ошибки Цикл
		Сообщить(С);
	КонецЦикла;
	ЗавершитьРаботу(1);
КонецЕсли;
К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Стат = Прот.НаложитьСрезФорм(Срез, Восст, Расш);
Сообщить("overlay: restoredCopied=" + Стат.restoredCopied + " extCopied=" + Стат.extCopied
	+ " objectsNew=" + Стат.objectsNew + " objectsMerged=" + Стат.objectsMerged
	+ " formsInChild=" + Стат.formsInChild + " cfgAdded=" + Стат.cfgAdded
	+ " missingTarget=" + Стат.missingTarget);
Если Стат.missingTarget > 0 Тогда
	ЗавершитьРаботу(2);
КонецЕсли;
