// Opt-in прототип форм: классификация и/или срез в отдельный каталог.
// Не трогает текущую сборку. Исходные выгрузки только читает.
//
// oscript typovaya-up/scripts/run_forms_bp_proto.os -и "D:\Выгрузка УП" -п "D:\выгрузка БП" -в "D:\typovaya-up-forms-proto" --forms-file "D:\typovaya-up-forms-proto\module_only_forms.txt"
// oscript typovaya-up/scripts/run_forms_bp_proto.os -и ... -п ... -в ... --class-csv forms_class.csv --status module_only

Арг = АргументыКоманднойСтроки;
Исх = "";
Пост = "";
Выход = "";
Класс = Ложь;
Формы = Новый Массив;
ФайлФорм = "";
ФайлCsv = "";
СтатусCsv = "";
Ошибки = Новый Массив;
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-и" Или А = "--исходная" Или А = "--source" Тогда
		Й = Й + 1;
		Исх = Арг[Й];
	ИначеЕсли А = "-п" Или А = "--поставщик" Или А = "--vendor" Тогда
		Й = Й + 1;
		Пост = Арг[Й];
	ИначеЕсли А = "-в" Или А = "--выход" Или А = "--out" Тогда
		Й = Й + 1;
		Выход = Арг[Й];
	ИначеЕсли А = "--classify" Или А = "--классификация" Тогда
		Класс = Истина;
	ИначеЕсли А = "--forms" Или А = "--формы" Тогда
		Й = Й + 1;
		Для Каждого Ч Из СтрРазделить(Арг[Й], ",", Ложь) Цикл
			Если СокрЛП(Ч) <> "" Тогда
				Формы.Добавить(СокрЛП(Ч));
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли А = "--forms-file" Или А = "--файл-форм" Тогда
		Й = Й + 1;
		ФайлФорм = Арг[Й];
	ИначеЕсли А = "--class-csv" Или А = "--csv" Тогда
		Й = Й + 1;
		ФайлCsv = Арг[Й];
	ИначеЕсли А = "--status" Или А = "--статус" Тогда
		Й = Й + 1;
		СтатусCsv = СокрЛП(Арг[Й]);
	ИначеЕсли А = "-h" Или А = "--help" Или А = "-?" Тогда
		Сообщить("run_forms_bp_proto.os -и <УП> -п <БП> -в <выход> [--classify] [--forms путь1,путь2] [--forms-file list.txt] [--class-csv file.csv --status module_only]");
		ЗавершитьРаботу(0);
	Иначе
		Ошибки.Добавить("Неизвестный аргумент: " + А);
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Исх = "" Или Пост = "" Или Выход = "" Тогда
	Ошибки.Добавить("Нужны -и, -п и -в.");
КонецЕсли;
К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Если ФайлФорм <> "" Тогда
	Для Каждого С Из Прот.ПрочитатьСписокФорм(ФайлФорм) Цикл
		Формы.Добавить(С);
	КонецЦикла;
	Если Формы.Количество() = 0 Тогда
		Ошибки.Добавить("Пустой или отсутствующий --forms-file: " + ФайлФорм);
	КонецЕсли;
КонецЕсли;
Если ФайлCsv <> "" Тогда
	Если СтатусCsv = "" Тогда
		Ошибки.Добавить("--class-csv требует --status.");
	Иначе
		Для Каждого С Из Прот.ПутиПоСтатусуИзCsv(ФайлCsv, СтатусCsv) Цикл
			Формы.Добавить(С);
		КонецЦикла;
		Если Формы.Количество() = 0 Тогда
			Ошибки.Добавить("В CSV нет строк со статусом " + СтатусCsv);
		КонецЕсли;
	КонецЕсли;
КонецЕсли;
Если Не Класс И Формы.Количество() = 0 Тогда
	Ошибки.Добавить("Укажите --classify и/или --forms / --forms-file / --class-csv --status.");
КонецЕсли;
Если Ошибки.Количество() > 0 Тогда
	Для Каждого С Из Ошибки Цикл
		Сообщить(С);
	КонецЦикла;
	Сообщить("run_forms_bp_proto.os -и <УП> -п <БП> -в <выход> [--classify] [--forms путь1,путь2] [--forms-file list.txt] [--class-csv file.csv --status module_only]");
	ЗавершитьРаботу(1);
КонецЕсли;

СоздатьКаталог(Выход);
Если Класс Тогда
	Сообщить("Классификация форм объектов, общих с БП...");
	Св = Прот.КлассифицироватьОбщиеФормы(Исх, Пост, Истина);
	Прот.ЗаписатьСводкуКлассификации(Св, Выход, Истина);
	Сообщить(Прот.СводкаВJSON(Св));
КонецЕсли;
Если Формы.Количество() > 0 Тогда
	Сообщить("Срез прототипа, форм: " + Формы.Количество());
	Стат = Прот.СгенерироватьСрезФорм(Исх, Пост, Выход, Формы, "УП_");
	Сообщить("proto: forms=" + Стат.forms + " restoredXml=" + Стат.restoredXml
		+ " borrowed=" + Стат.borrowed + " programmatic=" + Стат.programmatic
		+ " hooksAuto=" + Стат.hooksAuto + " hooksManual=" + Стат.hooksManual
		+ " hooksAdded=" + Стат.hooksAdded + " hooksSkip=" + Стат.hooksSkip
		+ " skipped=" + Стат.skipped
		+ " todo=" + Стат.todo.Количество());
КонецЕсли;
