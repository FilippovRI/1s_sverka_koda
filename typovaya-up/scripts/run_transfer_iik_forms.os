// Срез: &ИзменениеИКонтроль typovaya→УП в расширение. typovaya/restored не пишет.
// oscript run_transfer_iik_forms.os -и <УП> -т <typovaya restored> -в <срез> [--forms-file list.txt]
Арг = АргументыКоманднойСтроки;
Исх = "";
Тип = "";
Выход = "";
ФайлФорм = ""; ФайлРучн = "";
Й = 0;
Пока Й < Арг.Количество() Цикл
	А = Арг[Й];
	Если А = "-и" Тогда
		Й = Й + 1;
		Исх = Арг[Й];
	ИначеЕсли А = "-т" Тогда
		Й = Й + 1;
		Тип = Арг[Й];
	ИначеЕсли А = "-в" Тогда
		Й = Й + 1;
		Выход = Арг[Й];
	ИначеЕсли А = "--forms-file" Тогда
		Й = Й + 1;
		ФайлФорм = Арг[Й];
	ИначеЕсли А = "--manual-forms-file" Тогда
		Й = Й + 1;
		ФайлРучн = Арг[Й];
	КонецЕсли;
	Й = Й + 1;
КонецЦикла;
Если Исх = "" Или Тип = "" Или Выход = "" Тогда
	Сообщить("Нужны -и (УП), -т (typovaya) и -в (срез с extension). Опционально --forms-file.");
	ЗавершитьРаботу(1);
КонецЕсли;
К = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
Пер = ЗагрузитьСценарий(ОбъединитьПути(К, "ПереносОмУпИиК.os"));
КатРасш = Выход;
Если (Новый Файл(ОбъединитьПути(Выход, "extension", "Configuration.xml"))).Существует()
	Или (Новый Файл(ОбъединитьПути(Выход, "extension"))).Существует() Тогда
	КатРасш = ОбъединитьПути(Выход, "extension");
КонецЕсли;
Если Не (Новый Файл(ОбъединитьПути(КатРасш, "Configuration.xml"))).Существует() Тогда
	Сообщить("Нет Configuration.xml расширения: " + КатРасш);
	ЗавершитьРаботу(1);
КонецЕсли;
Если ФайлФорм <> "" Тогда
	Формы = Прот.ПрочитатьСписокФорм(ФайлФорм);
Иначе
	Формы = Пер.СобратьФормыСВызовамиОмУп(Тип, Исх);
КонецЕсли;
Если Формы.Количество() = 0 Тогда
	Сообщить("Пустой список форм.");
	ЗавершитьРаботу(1);
КонецЕсли;
КатОтч = ОбъединитьПути(Выход, "reports");
СоздатьКаталог(КатОтч);
Лог = Новый Массив;
Сообщить("extension=" + КатРасш + ", forms=" + Формы.Количество());
Ручные = Новый Массив;
Если ФайлРучн <> "" Тогда
	Ручные = Прот.ПрочитатьСписокФорм(ФайлРучн);
	Сообщить("manual-forms=" + Ручные.Количество() + " из " + ФайлРучн);
КонецЕсли;
Рез = Пер.Применить(Тип, Исх, КатРасш, Формы, Лог, КатОтч, Ручные);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Ч = Новый ЗаписьТекста(ОбъединитьПути(КатОтч, "iik_run.log"), КодировкаТекста.UTF8);
Ч.Записать(СтрСоединить(Лог, Символы.ПС) + Символы.ПС);
Ч.Закрыть();
Сообщить("OK run_transfer_iik_forms");
