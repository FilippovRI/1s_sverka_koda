// Прогон переноса отсутствующих в typovaya методов на готовый выход:
// oscript scripts/run_missing_cm_methods.os <extension> <restored> <выгрузка УП> [отчёт] [префикс]
КатSrc = ОбъединитьПути(ОбъединитьПути(ТекущийСценарий().Каталог, ".."), "src");
А = АргументыКоманднойСтроки;
Если А.Количество() < 3 Тогда
	Сообщить("usage: oscript scripts/run_missing_cm_methods.os <extension> <restored> <up> [report] [prefix]");
	ЗавершитьРаботу(2);
КонецЕсли;
Разбор = ЗагрузитьСценарий(ОбъединитьПути(КатSrc, "РазборМетодов.os"));
Контракт = ЗагрузитьСценарий(ОбъединитьПути(КатSrc, "КонтрактМетода.os"));
Сиг = ЗагрузитьСценарий(ОбъединитьПути(КатSrc, "ПереносСигнатур.os"));
Сиг.Инициализировать(Разбор, Контракт);
Мелкие = ЗагрузитьСценарий(ОбъединитьПути(КатSrc, "ПереносМелкихОбъектовУп.os"));
Мод = ЗагрузитьСценарий(ОбъединитьПути(КатSrc, "ПереносОтсутствующихМетодов.os"));
Мод.Инициализировать(Разбор, Сиг, Мелкие);
Лог = Новый Массив;
ОтчётКат = ?(А.Количество() > 3, А[3], "");
Префикс = ?(А.Количество() > 4, А[4], "УП_");
Р = Мод.Применить(А[0], А[1], А[2], Префикс, Лог, ОтчётКат);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Если Р.reportPath <> "" Тогда
	Сообщить("report: " + Р.reportPath);
КонецЕсли;
ЗавершитьРаботу(?(Р.ok, 0, 3));
