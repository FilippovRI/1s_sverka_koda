// Дополнить модули УП в готовом extension (без пересборки хуков).
Перем Каталог;
Функция Загрузить(Имя)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Каталог, Имя + ".os"));
КонецФункции
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Арг = АргументыКоманднойСтроки;
Если Арг.Количество() < 1 Тогда
	Сообщить("run_up_modules_extension_only.os <out>");
	ВызватьИсключение "args";
КонецЕсли;
Out = Арг[0];
Отч = Загрузить("ОтчетHTML");
Свод = Отч.ПрочитатьJsonФайл(ОбъединитьПути(Out, "summary.json"));
Чр = Загрузить("ЧерновикРасширения");
Пер = Загрузить("ПереносОбъектовУп");
ОТУ = Загрузить("ОбъектыТолькоУп");
Пер.Инициализировать(Чр, ОТУ);
Лог = Новый Массив;
Р = Пер.ДополнитьОбщиеМодулиПоСсылкам(ОбъединитьПути(Out, "extension"), ОбъединитьПути(Out, "restored"),
	Свод.meta.source, Свод.meta.vendor, Новый Соответствие, "УП_Доработки", Лог, Out);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
Сообщить(Отч.ВJSON(Р));