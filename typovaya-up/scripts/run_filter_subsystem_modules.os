// Применить фильтр модулей подсистем к готовому restored без полной пересборки:
// oscript scripts/run_filter_subsystem_modules.os <каталог restored>
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
А = АргументыКоманднойСтроки;
Если А.Количество() < 1 Тогда
	Сообщить("usage: oscript scripts/run_filter_subsystem_modules.os <restored>");
	ЗавершитьРаботу(2);
КонецЕсли;
Лог = Новый Массив;
Р = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ФильтрМодулейПодсистем.os")).Применить(А[0], Лог);
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
ЗавершитьРаботу(?(Р.status = "missing" Или Р.status = "no_proc" Или Р.status = "no_end", 3, 0));
