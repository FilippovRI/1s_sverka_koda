// Порт ключевых проверок tests/test_ast.os на ТиповаяUpРазборBsl (M4).

#Использовать asserts
#Использовать oneunit
#Использовать ".."

&Тест
Процедура AstСигнатураИАннотации() Экспорт
	А = Новый ТиповаяUpРазборBsl;
	Ожидаем.Что(А.ДоступенAstПарсер()).ЭтоИстина();
	ПС = Символы.ПС;
	Т = "#Область Р" + ПС
		+ "&НаСервере" + ПС
		+ "&ИзменениеИКонтроль(""Типовая"")" + ПС
		+ "Процедура УП_Типовая(А," + ПС
		+ "	Знач Б = 0) Экспорт" + ПС
		+ "	С = ""КонецПроцедуры // Процедура Х()""; // КонецПроцедуры" + ПС
		+ "КонецПроцедуры" + ПС
		+ "#КонецОбласти";
	Р = А.РазобратьМодульAst(Т);
	Ожидаем.Что(Р.ok).ЭтоИстина();
	Ожидаем.Что(Р.methods.Количество()).Равно(1);
	М = Р.methods[0];
	Ожидаем.Что(М.name).Равно("УП_Типовая");
	Ожидаем.Что(М.signatureText).Равно("Процедура УП_Типовая(А," + ПС + "	Знач Б = 0) Экспорт");
	Ожидаем.Что(М.annotations.Количество()).Равно(1);
	Ожидаем.Что(М.annotations[0].name).Равно("ИзменениеИКонтроль");
КонецПроцедуры