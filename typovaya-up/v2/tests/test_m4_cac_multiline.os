#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

&Тест
Процедура CacМногострочнаяСигнатураВExtension() Экспорт
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ф = З.ИзКаталогаМодулей("ФасадV1.os");
	Разбор = Ф.Подключить("РазборМетодов");
	Синтез = Новый ТиповаяUpСинтезХуков;
	СигПост = testlib.Т("Процедура Добавить(|	ОписаниеПодписей,|	СтрокаРолей,|"
		+ "	ПереопределяемыеИменаРеквизитов = Неопределено,|	ИмяРеквизитаОрганизация = ""Организация"") Экспорт|"
		+ "	М = 1;|КонецПроцедуры");
	СигИсх = testlib.Т("Процедура Добавить(|	ОписаниеПодписей,|	СтрокаРолей,|"
		+ "	ПереопределяемыеИменаРеквизитов = Неопределено,|	ИмяРеквизитаОрганизация = ""Организация"") Экспорт|"
		+ "	// УП_начало|	М = 2;|	// УП_конец|КонецПроцедуры");
	Хук = Синтез.ПредложитьХук(СигПост, СигИсх);
	Ожидаем.Что(Хук.hook).Равно("changeAndControl");
	Ожидаем.Что(СтрНайти(Хук.hookBody, "#Удаление") > 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Хук.hookBody, "// УП_начало") > 0).ЭтоИстина();
КонецПроцедуры