#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

&Тест
Процедура StubDefinedTypeСоставБезПадения() Экспорт
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	Ф = ТиповаяUp.ЗагрузчикВнутренних().ИзКаталогаМодулей("ФасадV1.os");
	Заг = Ф.Подключить("ЗаготовкиОбъектовБп");
	К = ПолучитьИмяВременногоФайла();
	УдалитьФайлы(К);
	Бп = ОбъединитьПути(К, "bp");
	Уп = ОбъединитьПути(К, "up");
	Осн = ОбъединитьПути(К, "main");
	СоздатьКаталог(Бп); СоздатьКаталог(Уп); СоздатьКаталог(Осн);
	Конф = "<?xml version=""1.0""?><Configuration><ChildObjects></ChildObjects></Configuration>";
	М = Новый Массив;
	М.Добавить(Бп); М.Добавить(Уп); М.Добавить(Осн);
	Для Каждого П Из М Цикл
		З = Новый ЗаписьТекста(ОбъединитьПути(П, "Configuration.xml"), "UTF-8");
		З.Записать(Конф); З.Закрыть();
	КонецЦикла;
	ПутьКат = ОбъединитьПути(Бп, "Catalogs");
	СоздатьКаталог(ПутьКат);
	З = Новый ЗаписьТекста(ОбъединитьПути(ПутьКат, "ВложСправ.xml"), "UTF-8");
	З.Записать("<?xml version=""1.0""?><MetaDataObject><Catalog uuid=""c1""><Properties><Name>ВложСправ</Name></Properties></Catalog></MetaDataObject>");
	З.Закрыть();
	СоздатьКаталог(ОбъединитьПути(Уп, "DefinedTypes"));
	З = Новый ЗаписьТекста(ОбъединитьПути(Уп, "DefinedTypes/ТипСоСправом.xml"), "UTF-8");
	З.Записать(testlib.Т("<?xml version=""1.0""?><MetaDataObject><DefinedType uuid=""dt-1"">"
		+ "<Properties><Name>ТипСоСправом</Name>|<Type><v8:Type>cfg:CatalogRef.ВложСправ</v8:Type></Type>"
		+ "</Properties></DefinedType></MetaDataObject>"));
	З.Закрыть();
	Форм = ОбъединитьПути(Осн, "CommonForms/Ф/Ext/Form.xml");
	СоздатьКаталог((Новый Файл(Форм)).Путь);
	З = Новый ЗаписьТекста(Форм, "UTF-8");
	З.Записать("<?xml version=""1.0""?><Form><Attributes><Attribute name=""A"">"
		+ "<Type><v8:Type>cfg:DefinedType.ТипСоСправом</v8:Type></Type></Attribute></Attributes></Form>");
	З.Закрыть();
	Заг.Инициализировать();
	Р = Заг.Применить(Осн, Бп, Новый Массив, "", Уп);
	Ожидаем.Что((Новый Файл(ОбъединитьПути(Осн, "Catalogs/ВложСправ.xml"))).Существует()).ЭтоИстина();
	Ожидаем.Что(Р.full >= 1).ЭтоИстина();
КонецПроцедуры