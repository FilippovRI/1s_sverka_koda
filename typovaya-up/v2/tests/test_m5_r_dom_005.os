#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

Функция ЕстьКласс(Р, Класс)
	Для Каждого Э Из Р.unresolved Цикл
		Если Э.class = Класс Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&Тест
Процедура RDom005КоллизияTypeIdТерритории() Экспорт
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	К = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(testlib.КореньTypovayaUp(), "tests", "fixtures"), "modcheck"), "internal_info_territory");
	М = Новый ТиповаяUpПроверкаЗамкнутости;
	Р = М.ПроверитьКаталог(К);
	Ожидаем.Что(Р.ok).ЭтоЛожь();
	Ожидаем.Что(ЕстьКласс(Р, "InternalInfoDuplicateTypeId")).ЭтоИстина();
	Д = М.ПроверитьУникальностьInternalInfo(К);
	Ожидаем.Что(Д.ok).ЭтоЛожь();
	Ожидаем.Что(Д.unresolved.Количество() >= 1).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ГенераторПересчитываетTypeIdDefinedType() Экспорт
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	Ф = ТиповаяUp.ЗагрузчикВнутренних().ИзКаталогаМодулей("ФасадV1.os");
	Заг = Ф.Подключить("ЗаготовкиОбъектовБп");
	Заг.Инициализировать();
	К = ПолучитьИмяВременногоФайла();
	УдалитьФайлы(К);
	СоздатьКаталог(К);
	Путь = ОбъединитьПути(К, "DefinedTypes/ТестТип.xml");
	СоздатьКаталог(ОбъединитьПути(К, "DefinedTypes"));
	Кол = "f99fe44f-f0cf-4efb-9e5d-456511c699c4";
	Тело = "<?xml version=""1.0""?><MetaDataObject><DefinedType uuid=""al-1"">" + Символы.ПС
		+ "<InternalInfo><xr:GeneratedType name=""DefinedType.ТестТип"" category=""DefinedType"">"
		+ "<xr:TypeId>" + Кол + "</xr:TypeId><xr:ValueId>v-old</xr:ValueId></xr:GeneratedType></InternalInfo>"
		+ "<Properties><Name>ТестТип</Name></Properties></DefinedType></MetaDataObject>";
	ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Ложь).Записать(Путь);
	Заг.ПересчитатьGeneratedTypeIdsDefinedType(Путь);
	После = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8).Прочитать();
	Ожидаем.Что(СтрНайти(После, Кол) = 0, "TypeId коллизии снят").ЭтоИстина();
	М = Новый ТиповаяUpПроверкаЗамкнутости;
	Ожидаем.Что(М.ПроверитьУникальностьInternalInfo(К).ok).ЭтоИстина();
КонецПроцедуры