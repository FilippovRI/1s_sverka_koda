#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

&Тест
Процедура СинтезХуковПравила() Экспорт
	Син = Новый ТиповаяUpСинтезХуков;
	Разбор = Новый ТиповаяUpРазборBsl;
	П = Син.ПредложитьХук(ТелоИз("А = 1;"), ТелоИз("А = 1;|Б = 2;"));
	Ожидаем.Что(П.decision).Равно("auto");
	Ожидаем.Что(П.hook).Равно("after");
	П = Син.ПредложитьХук(ТелоИз("Б = 1;"), ТелоИз("А = 0;|Б = 1;"));
	Ожидаем.Что(П.hook).Равно("before");
	П = Син.ПредложитьХук(ТелоИз("Х = 1;|У = 2;"), ТелоИз("Х = 1;|Вставка = 1;|У = 2;"));
	Ожидаем.Что(П.hook).Равно("changeAndControl");
	Ожидаем.Что(СтрНайти(П.hookBody, "#Вставка") > 0).ЭтоИстина();
	П = Син.ПредложитьХук(ТелоИз("Старое = 1;|Общее = 2;"), ТелоИз("Новое = 1;|Общее = 2;"));
	Ожидаем.Что(П.hook).Равно("changeAndControl");
	Ожидаем.Что(СтрНайти(П.hookBody, "#Удаление") > 0).ЭтоИстина();
	П = Син.ПредложитьХук("", "А = 1;");
	Ожидаем.Что(П.decision).Равно("manual");
	П = Син.ПредложитьХук("А = 1;", "Х = 1;" + Символы.ПС + "ПродолжитьВызов();" + Символы.ПС + "У = 2;");
	Ожидаем.Что(П.decision).Равно("manual");
	Полный = "Процедура Т()" + Символы.ПС + "	А = 1;" + Символы.ПС + "КонецПроцедуры";
	Ожидаем.Что(СокрЛП(Разбор.ИзвлечьТелоМетода(Полный))).Равно("А = 1;");
КонецПроцедуры

Функция ТелоИз(С)
	Возврат testlib.Т(С);
КонецФункции