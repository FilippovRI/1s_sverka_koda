#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

Функция СериализоватьМетод(Мт)
	Возврат Мт.name + "|" + Мт.status + "|" + Мт.hook + "|" + Мт.hookDecision + "|" + ?(Мт.Свойство("hookBody"), Мт.hookBody, "");
КонецФункции

Процедура СравнитьМодули(В1, В2, Сообщение)
	Ожидаем.Что(В2.Количество(), Сообщение + " modules").Равно(В1.Количество());
	Для Й = 0 По В1.ВГраница() Цикл
		М1 = В1[Й];
		М2 = В2[Й];
		Ожидаем.Что(М2.path, Сообщение).Равно(М1.path);
		Ожидаем.Что(М2.bucket, Сообщение + " bucket").Равно(М1.bucket);
		Ожидаем.Что(М2.methods.Количество(), М1.path + " methods").Равно(М1.methods.Количество());
		Для К = 0 По М1.methods.ВГраница() Цикл
			Ожидаем.Что(СериализоватьМетод(М2.methods[К]), М1.methods[К].name).Равно(СериализоватьМетод(М1.methods[К]));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПаритетСравненияUpBp() Экспорт
	Кор = testlib.КореньTypovayaUp();
	Ф = ОбъединитьПути(Кор, "tests");
	Ф = ОбъединитьПути(Ф, "fixtures");
	Уп = ОбъединитьПути(Ф, "UP");
	Бп = ОбъединитьПути(Ф, "BP");
	Мердж = ОбъединитьПути(Ф, "merge.xml");
	В1Ср = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "Сравнение.os"));
	В1Ч = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "ЧтениеВыгрузки.os"));
	В1Н = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "НастройкиСравнения.os"));
	В1Син = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "СинтезХуков.os"));
	В1Раз = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "РазборМетодов.os"));
	В1Без = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "БезопасностьПереноса.os"));
	В1К = ЗагрузитьСценарий(ОбъединитьПути(Кор, "src", "КонтрактМетода.os"));
	В1Син.Инициализировать(В1Раз, В1Без);
	В1Ср.Инициализировать(В1Раз, В1Ч, В1Н, В1Син, В1К, В1Без);
	Лог = Новый Массив;
	Д1 = В1Ч.ПрочитатьВыгрузку(Уп, Лог);
	Д2 = В1Ч.ПрочитатьВыгрузку(Бп, Лог);
	Пер = В1Н.ПрочитатьНастройки(Мердж, Лог).Пути;
	Р1 = В1Ср.СравнитьВыгрузки(Д1, Д2, Пер, Лог);
	Р2 = ТиповаяUp.СравнитьФикстуры(Уп, Бп, Мердж);
	СравнитьМодули(Р1, Р2, "UP+BP+merge");
КонецПроцедуры