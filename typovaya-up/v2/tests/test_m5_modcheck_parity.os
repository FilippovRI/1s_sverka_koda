#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

Функция ПутьФикс(Имя)
	Возврат ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(testlib.КореньTypovayaUp(), "tests", "fixtures"), "modcheck"), Имя);
КонецФункции

Функция СчетчикиV1(Корень)
	П = testlib.КореньTypovayaUp();
	П = ОбъединитьПути(П, "src");
	П = ОбъединитьПути(П, "ПроверкаЗамкнутости.os");
	Возврат ЗагрузитьСценарий(П).ВыполнитьПроверку(Корень, Корень, Корень).counts;
КонецФункции

Функция СчетчикиV2(Корень)
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	М = Новый ТиповаяUpПроверкаЗамкнутости;
	Возврат М.ПроверитьКаталог(Корень, Корень, Корень).counts;
КонецФункции

Функция СравнитьСчетчики(Имя)
	К = ПутьФикс(Имя);
	А = СчетчикиV1(К);
	Б = СчетчикиV2(К);
	Ключи = Новый Соответствие;
	Для Каждого КЗ Из А Цикл
		Ключи.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из Б Цикл
		Ключи.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из Ключи Цикл
		Кл = КЗ.Ключ;
		В1 = ?(А.Получить(Кл) = Неопределено, 0, А.Получить(Кл));
		В2 = ?(Б.Получить(Кл) = Неопределено, 0, Б.Получить(Кл));
		Ожидаем.Что(В2, Имя + "/" + Кл).Равно(В1);
	КонецЦикла;
КонецФункции

&Тест Процедура ПаритетStyle() Экспорт
	СравнитьСчетчики("style");
КонецПроцедуры
&Тест Процедура ПаритетDataPath() Экспорт
	СравнитьСчетчики("datapath");
КонецПроцедуры
&Тест Процедура ПаритетCfg() Экспорт
	СравнитьСчетчики("cfg");
КонецПроцедуры
&Тест Процедура ПаритетDefinedType() Экспорт
	СравнитьСчетчики("defined_type");
КонецПроцедуры
&Тест Процедура ПаритетExclusions() Экспорт
	СравнитьСчетчики("exclusions");
КонецПроцедуры
&Тест Процедура ПаритетNdflDataPath() Экспорт
	СравнитьСчетчики("ndfl_path");
КонецПроцедуры
&Тест Процедура ПаритетFormVt() Экспорт
	СравнитьСчетчики("form_vt");
КонецПроцедуры
&Тест Процедура ПаритетConfigChild() Экспорт
	СравнитьСчетчики("config_child");
КонецПроцедуры
&Тест Процедура ПаритетBpOnly() Экспорт
	СравнитьСчетчики("bp_only");
КонецПроцедуры