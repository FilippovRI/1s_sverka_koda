#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

Процедура ЗаписатьЧерновик(Модули, КореньУп, Выход)
	Ген = Новый ТиповаяUpГенераторРасширения;
	Ген.ЗаписатьЧерновик(Модули, КореньУп, Выход, "УП_Доработки", "УП_", Новый Массив);
КонецПроцедуры

&Тест
Процедура PreprocЧерновикОбёрткаМодуля9_11() Экспорт
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ф = З.ИзКаталогаМодулей("ФасадV1.os");
	Разбор = Ф.Подключить("РазборМетодов");
	Дир = "#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда";
	К = ПолучитьИмяВременногоФайла();
	УдалитьФайлы(К);
	СоздатьКаталог(К);
	КореньУп = ОбъединитьПути(К, "up");
	СоздатьКаталог(КореньУп);

	// §9
	Выход = ОбъединитьПути(К, "out");
	ПутьМ = "ChartsOfCalculationTypes\Начисления\Ext\ManagerModule.bsl";
	ТелоУп = testlib.Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры||Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры");
	ТелоБп = testlib.Т(Дир + "|Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры||Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры|#КонецЕсли|");
	МтРаб = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, insteadAppendContinue, explain",
		"Рабочая", "Процедура", "changed",
		testlib.Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры"),
		testlib.Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры"),
		"changeAndControl", "auto",
		testlib.Т("#Удаление|	Типовой = 1;|#КонецУдаления|#Вставка|	Типовой = 2;|#КонецВставки"),
		Ложь, "");
	М = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
		ПутьМ, "ChartOfCalculationTypes", "ChartOfCalculationTypes.Начисления", "manual", "",
		ТелоБп, ТелоУп, Истина, Новый Массив, Новый Структура("same, changed, added, removed", 1, 1, 0, 0));
	М.methods.Добавить(МтРаб);
	М.methods.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
		"ЗаписатьНачисление", "Процедура", "same",
		testlib.Т("Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры"),
		testlib.Т("Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры"),
		"none", "skip", "", ""));
	Модули = Новый Массив;
	Модули.Добавить(М);
	ЗаписатьЧерновик(Модули, КореньУп, Выход);
	Чтение = Новый ТиповаяUpЧтениеВыгрузки;
	ПутьВосст = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход, "restored", "ChartsOfCalculationTypes"), "Начисления", "Ext"), "ManagerModule.bsl");
	ПутьРасш = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход, "extension", "ChartsOfCalculationTypes"), "Начисления", "Ext"), "ManagerModule.bsl");
	Ожидаем.Что((Новый Файл(ПутьВосст)).Существует()).ЭтоИстина();
	Ожидаем.Что((Новый Файл(ПутьРасш)).Существует()).ЭтоИстина();
	ТВосст = Чтение.ПрочитатьТекстМодуля(ПутьВосст);
	ТРасш = Чтение.ПрочитатьТекстМодуля(ПутьРасш);
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(ТВосст).Есть).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(ТВосст, Дир)).Равно(1);
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(ТРасш).Есть).ЭтоИстина();
	Ожидаем.Что(СтрНайти(ТРасш, "&ИзменениеИКонтроль(""Рабочая"")") > 0).ЭтоИстина();
	ПутьОтч = ОбъединитьПути(Выход, "module_preproc_wrap.json");
	Отч = Чтение.ПрочитатьТекстМодуля(ПутьОтч);
	Ожидаем.Что(СтрНайти(Отч, "Начисления") > 0).ЭтоИстина();

	// §10 wrap-only
	МТолько = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
		"Catalogs\Банки\Ext\ObjectModule.bsl", "Catalog", "Catalog.Банки", "manual", "",
		testlib.Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|"),
		testlib.Т("Процедура А()|КонецПроцедуры|"),
		Истина, Новый Массив, Новый Структура("same, changed, added, removed", 1, 0, 0, 0));
	МТолько.methods.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
		"А", "Процедура", "same",
		testlib.Т("Процедура А()|КонецПроцедуры"), testlib.Т("Процедура А()|КонецПроцедуры"),
		"none", "skip", "", ""));
	Модули2 = Новый Массив;
	Модули2.Добавить(МТолько);
	Выход2 = ОбъединитьПути(К, "out2");
	ЗаписатьЧерновик(Модули2, КореньУп, Выход2);
	ПутьТолько = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход2, "restored", "Catalogs"), "Банки", "Ext"), "ObjectModule.bsl");
	Ожидаем.Что((Новый Файл(ПутьТолько)).Существует()).ЭтоИстина();
	ТТолько = Чтение.ПрочитатьТекстМодуля(ПутьТолько);
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(ТТолько).Есть).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(ТТолько, Дир)).Равно(1);
	ПутьExtТолько = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход2, "extension", "Catalogs"), "Банки", "Ext"), "ObjectModule.bsl");
	Ожидаем.Что((Новый Файл(ПутьExtТолько)).Существует()).ЭтоЛожь();

	// §11 уже обёрнутый УП
	МУже = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
		"Catalogs\Уже\Ext\ObjectModule.bsl", "Catalog", "Catalog.Уже", "manual", "",
		testlib.Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|"),
		testlib.Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|"),
		Ложь, Новый Массив, Новый Структура("same, changed, added, removed", 1, 0, 0, 0));
	МУже.methods.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
		"А", "Процедура", "same", "", "", "none", "skip", "", ""));
	Модули3 = Новый Массив;
	Модули3.Добавить(МУже);
	Выход3 = ОбъединитьПути(К, "out3");
	ЗаписатьЧерновик(Модули3, КореньУп, Выход3);
	ПутьУже = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход3, "restored", "Catalogs"), "Уже", "Ext"), "ObjectModule.bsl");
	Ожидаем.Что((Новый Файл(ПутьУже)).Существует()).ЭтоЛожь();
	Отч3 = Чтение.ПрочитатьТекстМодуля(ОбъединитьПути(Выход3, "module_preproc_wrap.json"));
	Ожидаем.Что(СтрНайти(Отч3, """count"": 0") > 0 Или СтрНайти(Отч3, """count"":0") > 0).ЭтоИстина();
КонецПроцедуры