// M4: diff extension/restored v1 (Главный) vs v2 (сопоставление v2 + генератор v1-фасад + хвост v1).

#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

Функция КореньUp()
	Ф = ОбъединитьПути(testlib.КореньTypovayaUp(), "tests", "fixtures");
	Возврат Новый Структура("up, bp, merge",
		ОбъединитьПути(Ф, "UP"), ОбъединитьПути(Ф, "BP"), ОбъединитьПути(Ф, "merge.xml"));
КонецФункции

Функция ПутьOscript()
	О = ПолучитьПеременнуюСреды("OSCRIPT");
	Если О <> "" И (Новый Файл(О)).Существует() Тогда
		Возврат О;
	КонецЕсли;
	О = "/home/ubuntu/onescript/bin/oscript";
	Если (Новый Файл(О)).Существует() Тогда
		Возврат О;
	КонецЕсли;
	Возврат "oscript";
КонецФункции

Функция ЗапуститьV1(Куда)
	Ф = КореньUp();
	К = Новый Команда();
	К.УстановитьКоманду(ПутьOscript());
	К.ДобавитьПараметр(ОбъединитьПути(testlib.КореньTypovayaUp(), "src", "Главный.os"));
	К.ДобавитьПараметр("-и");
	К.ДобавитьПараметр(Ф.up);
	К.ДобавитьПараметр("-п");
	К.ДобавитьПараметр(Ф.bp);
	К.ДобавитьПараметр("-н");
	К.ДобавитьПараметр(Ф.merge);
	К.ДобавитьПараметр("--без-отчета");
	К.ДобавитьПараметр("-в");
	К.ДобавитьПараметр(Куда);
	Возврат К.Исполнить();
КонецФункции

Функция ЗапуститьV2M4(Куда)
	Ф = КореньUp();
	К = Новый Команда();
	К.УстановитьКоманду(ПутьOscript());
	К.ДобавитьПараметр(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "tasks", "m4_full.os"));
	К.ДобавитьПараметр("-и");
	К.ДобавитьПараметр(Ф.up);
	К.ДобавитьПараметр("-п");
	К.ДобавитьПараметр(Ф.bp);
	К.ДобавитьПараметр("-н");
	К.ДобавитьПараметр(Ф.merge);
	К.ДобавитьПараметр("--без-отчета");
	К.ДобавитьПараметр("-в");
	К.ДобавитьПараметр(Куда);
	Возврат К.Исполнить();
КонецФункции

Процедура DiffКаталоги(А, Б, Метка)
	К = Новый Команда();
	К.УстановитьКоманду("diff");
	К.ДобавитьПараметр("-qr");
	К.ДобавитьПараметр(А);
	К.ДобавитьПараметр(Б);
	К.ПоказыватьВыводНемедленно(Ложь);
	Код = К.Исполнить();
	Ожидаем.Что(Код, Метка).Равно(0);
КонецПроцедуры

&Тест
Процедура ВыходV1V2ExtensionRestoredПаритет() Экспорт
	ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
	О1 = ПолучитьИмяВременногоФайла("d1");
	О2 = ПолучитьИмяВременногоФайла("d2");
	УдалитьФайлы(О1); УдалитьФайлы(О2);
	СоздатьКаталог(О1); СоздатьКаталог(О2);
	Ожидаем.Что(ЗапуститьV1(О1)).Равно(0);
	Ожидаем.Что(ЗапуститьV2M4(О2)).Равно(0);
	DiffКаталоги(ОбъединитьПути(О1, "extension"), ОбъединитьПути(О2, "extension"), "extension");
	DiffКаталоги(ОбъединитьПути(О1, "restored"), ОбъединитьПути(О2, "restored"), "restored");
КонецПроцедуры