#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

&Тест
Процедура ОбёрткаПрепроцессораМодуля() Экспорт
	Разбор = Новый ТиповаяUpРазборBsl;
	Дир = "#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда";
	Мод = testlib.Т(Дир + "|Процедура ЗаписатьНачисление(Описание)|	А = 1;|КонецПроцедуры|#КонецЕсли|");
	Об = Разбор.НайтиОбёрткуМодуля(Мод);
	Ожидаем.Что(Об.Есть).ЭтоИстина();
	Ожидаем.Что(СокрЛП(Об.Начало)).Равно(Дир);
	Ожидаем.Что(СокрЛП(Об.Конец)).Равно("#КонецЕсли");
	Мод2 = testlib.Т("// заголовок||" + Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|");
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(Мод2).Есть).ЭтоИстина();
	Мод3 = testlib.Т(Дир + "|Процедура А()|КонецПроцедуры||Процедура Б()|КонецПроцедуры|#КонецЕсли");
	Раз3 = Разбор.РазобратьМодульЛексически(Мод3);
	Ожидаем.Что(Раз3.Методы.Количество()).Равно(2);
	Ожидаем.Что(Раз3.Методы[0].ОбёрткаНачало).Равно("");
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(Мод3).Есть).ЭтоИстина();
	Мод4 = testlib.Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли||Процедура Б()|КонецПроцедуры|");
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(Мод4).Есть).ЭтоЛожь();
	Мод5 = testlib.Т("#Если Сервер Тогда|Процедура А()|КонецПроцедуры|#КонецЕсли||#Если Клиент Тогда|Процедура Б()|КонецПроцедуры|#КонецЕсли|");
	Ожидаем.Что(Разбор.НайтиОбёрткуМодуля(Мод5).Есть).ЭтоЛожь();
	Тело = testlib.Т("Процедура ЗаписатьНачисление(Описание)|	А = 1;|КонецПроцедуры|");
	Собр = Разбор.ПрименитьОбёрткуМодуля(Тело, Дир, "#КонецЕсли");
	Ожидаем.Что(СтрНачинаетсяС(Собр, Дир + Символы.ПС)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Собр, "Процедура ЗаписатьНачисление") > 0).ЭтоИстина();
	Собр2 = Разбор.ПрименитьОбёрткуМодуля(Собр, Дир, "#КонецЕсли");
	Ожидаем.Что(Собр2).Равно(Собр);
	Ожидаем.Что(СтрЧислоВхождений(Собр2, Дир)).Равно(1);
	Мод8 = testlib.Т("#Если Сервер Тогда|Процедура А()|#Если Клиент Тогда|	К = 1;|#КонецЕсли|КонецПроцедуры|#КонецЕсли|");
	Зам8 = Разбор.ПрименитьОбёрткуМодуля(Мод8, Дир, "#КонецЕсли");
	Ожидаем.Что(СтрНачинаетсяС(СокрЛ(Зам8), Дир)).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Зам8, "#Если Сервер Тогда") = 0).ЭтоИстина();
	Ожидаем.Что(СтрНайти(Зам8, "#Если Клиент Тогда") > 0).ЭтоИстина();
	Ожидаем.Что(СтрЧислоВхождений(Зам8, "#КонецЕсли")).Равно(2);
КонецПроцедуры