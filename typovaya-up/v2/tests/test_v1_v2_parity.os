#Использовать asserts
#Использовать oneunit
#Использовать ".."

Функция КореньV1()
	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
КонецФункции

Процедура СравнитьМетоды(Текст, Сообщение)
	В1 = ЗагрузитьСценарий(ОбъединитьПути(КореньV1(), "src", "РазборМетодов.os"));
	В2 = Новый ТиповаяUpРазборBsl;
	М1 = В1.РазобратьМодуль(Текст).Методы;
	М2 = В2.РазобратьМодульЛексически(Текст).Методы;
	Ожидаем.Что(М2.Количество(), Сообщение + " count").Равно(М1.Количество());
	Для Й = 0 По М1.ВГраница() Цикл
		Ожидаем.Что(М2[Й].Имя, Сообщение + " name").Равно(М1[Й].Имя);
		Ожидаем.Что(М2[Й].Норм, Сообщение + " norm").Равно(М1[Й].Норм);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПаритетЛексикаНаФикстурах() Экспорт
	Кор = ОбъединитьПути(КореньV1(), "tests", "fixtures", "UP");
	Ч = Новый ТиповаяUpЧтениеВыгрузки;
	Д = Ч.ПрочитатьВыгрузку(Кор, Новый Массив);
	Для Каждого КЗ Из Д.Модули Цикл
		Т = Ч.ПрочитатьТекстМодуля(КЗ.Значение);
		СравнитьМетоды(Т, КЗ.Ключ);
	КонецЦикла;
КонецПроцедуры

&Тест
Процедура ПаритетЧтениеВыгрузки() Экспорт
	Кор = ОбъединитьПути(КореньV1(), "tests", "fixtures", "UP");
	В1 = ЗагрузитьСценарий(ОбъединитьПути(КореньV1(), "src", "ЧтениеВыгрузки.os"));
	В2 = Новый ТиповаяUpЧтениеВыгрузки;
	Д1 = В1.ПрочитатьВыгрузку(Кор, Новый Массив);
	Д2 = В2.ПрочитатьВыгрузку(Кор, Новый Массив);
	Ожидаем.Что(Д2.Имя).Равно(Д1.Имя);
	Ожидаем.Что(Д2.Модули.Количество()).Равно(Д1.Модули.Количество());
КонецПроцедуры