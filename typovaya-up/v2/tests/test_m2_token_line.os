#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

&Тест
Процедура ХешЛексемИСинтезSkip() Экспорт
	Р = Новый ТиповаяUpРазборBsl;
	Син = Новый ТиповаяUpСинтезХуков;
	Х1 = Р.ХешЛексемСтроки("	Ид = 1; // комментарий");
	Х2 = Р.ХешЛексемСтроки("Ид=1;");
	Ожидаем.Что(Х1 <> "" И Х1 = Х2).ЭтоИстина();
	Х3 = Р.ХешЛексемСтроки("Ид = 2;");
	Ожидаем.Что(Х1 <> Х3).ЭтоИстина();
	Л = Р.ЛексемыСтроки("Текст = ""ВЫБРАТЬ"";");
	Ожидаем.Что(Л.Количество() >= 3 И Л[2] = "S:ВЫБРАТЬ").ЭтоИстина();
	Тип = testlib.Т("	А = 1;|	//выводим в список|	|	Б = 2;");
	Уп = testlib.Т("	А = 1;|	Б = 2;");
	Пр = Син.ПредложитьХук(Тип, Уп);
	Ожидаем.Что(Пр.decision).Равно("skip");
	Тип2 = testlib.Т("	А = 1;|	Б = 2;");
	Уп2 = testlib.Т("	А = 1;|	Б = 3;");
	Пр2 = Син.ПредложитьХук(Тип2, Уп2);
	Ожидаем.Что(Пр2.decision).Равно("auto");
	Ожидаем.Что(Пр2.hook).Равно("changeAndControl");
КонецПроцедуры