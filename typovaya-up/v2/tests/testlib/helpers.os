Функция КореньTypovayaUp() Экспорт
	// Вызов из модуля testlib: каталог сценария — tests/testlib.
	К = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	К = ОбъединитьПути(К, "..");
	Возврат ОбъединитьПути(К, "..");
КонецФункции

Функция Т(Знач СПайпами) Экспорт
	Возврат СтрЗаменить(СПайпами, "|", Символы.ПС);
КонецФункции

Функция ФайлВременный(Знач Текст) Экспорт
	Путь = ПолучитьИмяВременногоФайла("bsl");
	Зп = Новый ЗаписьТекста(Путь, "UTF-8", , , Символы.ПС);
	Зп.Записать(Текст);
	Зп.Закрыть();
	Возврат Путь;
КонецФункции

Функция МетодПоИмени(М, Имя) Экспорт
	Для Каждого Мт Из М.methods Цикл
		Если Мт.name = Имя Тогда
			Возврат Мт;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции