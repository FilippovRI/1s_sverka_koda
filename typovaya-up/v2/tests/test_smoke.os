#Использовать asserts
// Заготовка под oneunit + Autumn (&ТестовыйНабор); прогон CI — tasks/smoke.os

Перем Корень;
Перем ТиповаяUp;
Перем ПравилаДомена;

&ПередКаждым
Процедура ПередКаждым() Экспорт
	Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
	ТиповаяUp = ЗагрузитьСценарий(ОбъединитьПути(Корень, "Модули", "ТиповаяUp.os"));
	ПравилаДомена = ЗагрузитьСценарий(ОбъединитьПути(Корень, "Модули", "ПравилаДомена.os"));
КонецПроцедуры

&Тест
Процедура КаркасЗагружается() Экспорт
	Ожидаем.Что(ТиповаяUp.ЭтоКаркас(), "пакет помечен как каркас").ЭтоИстина();
	Ожидаем.Что(ТиповаяUp.ВерсияПакета(), "версия").Равно("0.0.1");
КонецПроцедуры

&Тест
Процедура ПравилаДоменаОпределены() Экспорт
	П = ПравилаДомена.ВсеПравила();
	Ожидаем.Что(П.Количество(), "число правил R-DOM").БольшеИлиРавно(10);
	Ожидаем.Что(ПравилаДомена.ВерсияВыгрузкиЦелевая(), "выгрузка").Равно("2.21");
КонецПроцедуры

&Тест
Процедура ИменаСлоевИVendorBsparser() Экспорт
	Ожидаем.Что(ТиповаяUp.ИменаСлоев().Количество(), "слои").Равно(14);
	База = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
	П = ОбъединитьПути(База, "vendor");
	П = ОбъединитьПути(П, "bsparser");
	П = ОбъединитьПути(П, "src");
	П = ОбъединитьПути(П, "ПарсерВстроенногоЯзыка");
	П = ОбъединитьПути(П, "Ext");
	П = ОбъединитьПути(П, "ObjectModule.bsl");
	Ожидаем.Что((Новый Файл(П)).Существует(), "vendored bsparser").ЭтоИстина();
КонецПроцедуры