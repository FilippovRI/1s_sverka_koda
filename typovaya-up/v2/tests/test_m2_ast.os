#Использовать oneunit
#Использовать ".."

&Тест
Процедура AstБазовыйРазбор() Экспорт
	А = Новый ТиповаяUpРазборBsl;
	Ожидаем.Что(А.ДоступенAstПарсер()).ЭтоИстина();
	ПС = Символы.ПС;
	Т = "&НаСервере" + ПС + "Процедура Х() Экспорт" + ПС + "	А = 1;" + ПС + "КонецПроцедуры";
	Р = А.РазобратьМодульAst(Т);
	Ожидаем.Что(Р.ok).ЭтоИстина();
	Ожидаем.Что(Р.methods.Количество()).Равно(1);
	Ожидаем.Что(Р.methods[0].name).Равно("Х");
КонецПроцедуры

&Тест
Процедура СинтаксисМодуляКодировкаCp1251() Экспорт
	П = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	П = ОбъединитьПути(П, "..");
	П = ОбъединитьПути(П, "tests");
	П = ОбъединитьПути(П, "fixtures");
	П = ОбъединитьПути(П, "UP");
	П = ОбъединитьПути(П, "CommonModules");
	П = ОбъединитьПути(П, "Кодировка");
	П = ОбъединитьПути(П, "Ext");
	Путь = ОбъединитьПути(П, "Module.bsl");
	Чтение = Новый ТиповаяUpЧтениеВыгрузки;
	Текст = Чтение.ПрочитатьТекстМодуля(Путь);
	Ожидаем.Что(СтрНайти(Текст, "Процедура") > 0).ЭтоИстина();
	Разбор = Новый ТиповаяUpРазборBsl;
	Ошибки = Разбор.ОшибкиСинтаксиса(Текст);
	Ожидаем.Что(Ошибки.Количество()).Равно(0);
КонецПроцедуры