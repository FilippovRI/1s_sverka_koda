#Использовать asserts
#Использовать oneunit
#Использовать ".."

Функция КореньПакета()
	К = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	Возврат ОбъединитьПути(К, "..");
КонецФункции

Функция Фикстура(Имя)
	К = ОбъединитьПути(КореньПакета(), "tests");
	Ф = ОбъединитьПути(К, "fixtures");
	Возврат ОбъединитьПути(Ф, Имя);
КонецФункции

&Тест
Процедура ЧтениеВыгрузкиУП() Экспорт
	Чтение = Новый ТиповаяUpЧтениеВыгрузки;
	Мета = Новый ТиповаяUpМетаданныеКонфигурации;
	Кор = Фикстура("UP");
	Д = Чтение.ПрочитатьВыгрузку(Кор, Новый Массив);
	Ожидаем.Что(Д.Имя).Равно("КонфигUP");
	Ожидаем.Что(Д.Версия).Равно("1.0");
	Ожидаем.Что(Д.Модули.Количество() > 0).ЭтоИстина();
	Св = Мета.СводкаВыгрузки(Д, Д.Корень);
	Ожидаем.Что(Св.модули.Количество() > 0).ЭтоИстина();
	Ожидаем.Что(Св.дерево.Количество() >= 0).ЭтоИстина();
КонецПроцедуры

&Тест
Процедура ConfigDumpInfoСкелет() Экспорт
	Мета = Новый ТиповаяUpМетаданныеКонфигурации;
	Кди = Мета.ПрочитатьConfigDumpInfo(Фикстура("skeleton_synthetic"));
	Ожидаем.Что(Кди.есть).ЭтоИстина();
	Ожидаем.Что(Кди.версияВыгрузки).Равно("2.21");
КонецПроцедуры

&Тест
Процедура CliПрочитатьВыгрузкиM1() Экспорт
	П = Новый Структура("source, vendor, settings, out, probeOnly, errors", Фикстура("UP"), "", "", "", Ложь, Новый Массив);
	С = ТиповаяUp.ПрочитатьВыгрузкиM1(П);
	Ожидаем.Что(С.source.имя).Равно("КонфигUP");
КонецПроцедуры