&Тест
Процедура РегрессииЛексикиКакV1() Экспорт
	Р = Новый ТиповаяUpРазборBsl;
	ПС = Символы.ПС;
	Ожидаем.Что(Р.УбратьКомментарий("A = ""http://x"";")).Равно("A = ""http://x"";");
	Ожидаем.Что(СокрЛП(Р.УбратьКомментарий("A = ""q""""w""; // c"))).Равно("A = ""q""""w"";");
	Ожидаем.Что(Р.УбратьКомментарий("// not code")).Равно("");
	Ожидаем.Что(Р.ЭтоМаркерКонцаМетода("  Т = ""КонецПроцедуры"";", "конецпроцедуры")).ЭтоЛожь();
	Ожидаем.Что(Р.ЭтоМаркерКонцаМетода("КонецПроцедуры;", "конецпроцедуры")).ЭтоИстина();
	Мод = "&НаСервере" + ПС + "Процедура ВЖивую(Знач X = 0) Экспорт" + ПС + "КонецПроцедуры;" + ПС + "Процедура Вторая()" + ПС + "КонецПроцедуры;";
	РазборМ = Р.РазобратьМодульЛексически(Мод);
	Ожидаем.Что(РазборМ.Методы.Количество()).Равно(2);
	Мл = "Процедура Много(" + ПС + "	Знач A = 0) Экспорт" + ПС + "КонецПроцедуры;";
	Ожидаем.Что(Р.РазобратьМодульЛексически(Мл).Методы[0].Имя).Равно("Много");
КонецПроцедуры