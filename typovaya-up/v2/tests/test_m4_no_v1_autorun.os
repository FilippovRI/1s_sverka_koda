#Использовать ".."
// Загрузка Главный.os через Фасад не должна выполнять полный CLI v1.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Ошибок = 0;
ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
Ф = ТиповаяUp.ЗагрузчикВнутренних().ИзКаталогаМодулей("ФасадV1.os");
Ф.Подключить("Главный");
П(Не (Новый Файл(ОбъединитьПути(ТекущийСценарий().Каталог, "out_autorun_guard"))).Существует(),
	"Главный: при Подключить не создаётся выход (нет авто-CLI)");

Если Ошибок = 0 Тогда
	Сообщить("OK: test_m4_no_v1_autorun");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;