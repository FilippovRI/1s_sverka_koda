#Использовать asserts
#Использовать oneunit
#Использовать ".."
#Использовать "testlib"

&Тест
Процедура ОбёрткаПрепроцессораВокругМетода() Экспорт
	Разбор = Новый ТиповаяUpРазборBsl;
	ПС = Символы.ПС;
	Мод = testlib.Т("#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда|Процедура ОбработкаФормированияКомандВходящегоЗапросаПоделиться(ДанныеЗапросаПоделиться, Команды)|	Команда = Новый ОписаниеКомандыВходящегоЗапросаПоделиться(ОбработчикКоманды, ""Загрузить выписку"");|КонецПроцедуры|#КонецЕсли|");
	Раз = Разбор.РазобратьМодульЛексически(Мод);
	Ожидаем.Что(Раз.Методы.Количество()).Равно(1);
	М = Раз.Методы[0];
	Ожидаем.Что(М.Имя).Равно("ОбработкаФормированияКомандВходящегоЗапросаПоделиться");
	Ожидаем.Что(СтрНайти(М.ОбёрткаНачало, "МобильноеПриложениеКлиент Или МобильныйКлиент") > 0).ЭтоИстина();
	Ожидаем.Что(СокрЛП(М.ОбёрткаКонец)).Равно("#КонецЕсли");
	Ожидаем.Что(СтрНайти(М.Текст, "#Если") = 0).ЭтоИстина();
	Собр = Разбор.ОбернутьТекстПрепроцессором(М.Текст, М.ОбёрткаНачало, М.ОбёрткаКонец);
	Ожидаем.Что(Собр).Равно(СокрП(Мод));
	Мод2 = testlib.Т("#Если Сервер Тогда||&НаСервере|Процедура А()|КонецПроцедуры||#КонецЕсли");
	Раз2 = Разбор.РазобратьМодульЛексически(Мод2);
	Ожидаем.Что(Раз2.Методы.Количество()).Равно(1);
	Ожидаем.Что(СтрНайти(Раз2.Методы[0].ОбёрткаНачало, "#Если Сервер Тогда") > 0).ЭтоИстина();
	Мод3 = testlib.Т("#Если Сервер Тогда|Процедура А()|КонецПроцедуры||Процедура Б()|КонецПроцедуры|#КонецЕсли");
	Раз3 = Разбор.РазобратьМодульЛексически(Мод3);
	Ожидаем.Что(Раз3.Методы.Количество()).Равно(2);
	Ожидаем.Что(Раз3.Методы[0].ОбёрткаНачало).Равно("");
	Мод4 = testlib.Т("#Если Сервер Тогда|Процедура А()|	С = 1;|КонецПроцедуры|#Иначе|Процедура Б()|	К = 1;|КонецПроцедуры|#КонецЕсли");
	Раз4 = Разбор.РазобратьМодульЛексически(Мод4);
	Ожидаем.Что(Раз4.Методы.Количество()).Равно(2);
	Ожидаем.Что(СокрЛП(Раз4.Методы[0].ОбёрткаНачало)).Равно("#Если Сервер Тогда");
КонецПроцедуры