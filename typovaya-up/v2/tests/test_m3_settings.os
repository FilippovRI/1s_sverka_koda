&Тест
Процедура НастройкиMerge() Экспорт
	Н = Новый ТиповаяUpНастройкиСравнения;
	Кор = testlib.КореньTypovayaUp();
	П = ОбъединитьПути(Кор, "tests");
	П = ОбъединитьПути(П, "fixtures");
	П = ОбъединитьПути(П, "merge.xml");
	Лог = Новый Массив;
	Р = Н.ПрочитатьНастройки(П, Лог);
	Ожидаем.Что(Р.Пути.Количество() > 0).ЭтоИстина();
	Ожидаем.Что(Н.ПутьМодуля("Catalog.Банки", "ObjectModule")).Равно("Catalogs\Банки\Ext\ObjectModule.bsl");
	Ожидаем.Что(Н.ТипПоКаталогу("Catalogs")).Равно("Catalog");
КонецПроцедуры