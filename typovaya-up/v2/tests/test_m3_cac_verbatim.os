&Тест
Процедура CacБайтВБайтТиповому() Экспорт
	Син = Новый ТиповаяUpСинтезХуков;
	Тип = testlib.Т("	Заг = 1;|	|	//выводим в список|	Т = ""ВЫБРАТЬ"" + "" "" + ""Поле"";" + "|" + "	В = 2;");
	Уп = testlib.Т("	Заг = 1;|	|	//выводим в список|	// УП_начало|	Х = 9;|	// УП_конец|	Т = ""ВЫБРАТЬ"" + "" "" + ""Поле"";" + "|" + "	В = 2;|");
	П = Син.ПредложитьХук(Тип, Уп);
	Ожидаем.Что(П.hook).Равно("changeAndControl");
	Ожидаем.Что(Син.ВосстановитьБазовыйТекстТиповогоИзХука(П.hookBody)).Равно(Тип);
КонецПроцедуры