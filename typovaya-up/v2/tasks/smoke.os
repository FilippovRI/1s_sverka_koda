#Использовать ".."

ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
Если ТиповаяUp.ВерсияПакета() <> "2.0.0" Тогда
	ВызватьИсключение "версия пакета";
КонецЕсли;
Разбор = Новый ТиповаяUpРазборBsl;
Если Не Разбор.ДоступенAstПарсер() Тогда
	ВызватьИсключение "bsparser";
КонецЕсли;
Сообщить("OK: v2 smoke");