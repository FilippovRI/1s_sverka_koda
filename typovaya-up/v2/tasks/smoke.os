// Smoke v2 (вызывается из tasks/test.os и run_tests.sh).

Перем Ошибок;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
ТиповаяUp = ЗагрузитьСценарий(ОбъединитьПути(Корень, "Модули", "ТиповаяUp.os"));
ПравилаДомена = ЗагрузитьСценарий(ОбъединитьПути(Корень, "Модули", "ПравилаДомена.os"));

Ошибок = 0;
П(ТиповаяUp.ЭтоКаркас(), "каркас");
П(ТиповаяUp.ВерсияПакета() = "0.0.1", "версия");
П(ПравилаДомена.ВсеПравила().Количество() >= 10, "правила домена");
П(ПравилаДомена.ВерсияВыгрузкиЦелевая() = "2.21", "выгрузка 2.21");
П(ТиповаяUp.ИменаСлоев().Количество() = 14, "имена слоёв");
База = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "..");
П = ОбъединитьПути(База, "vendor");
П = ОбъединитьПути(П, "bsparser");
П = ОбъединитьПути(П, "src");
П = ОбъединитьПути(П, "ПарсерВстроенногоЯзыка");
П = ОбъединитьПути(П, "Ext");
П = ОбъединитьПути(П, "ObjectModule.bsl");
П((Новый Файл(П)).Существует(), "bsparser vendor");

Если Ошибок = 0 Тогда Сообщить("OK: v2 smoke"); Иначе ЗавершитьРаботу(1); КонецЕсли;