#Использовать 1commands

Кор = ТекущийСценарий().Каталог;
КорВ2 = ОбъединитьПути(Кор, "..");
ПТест = ОбъединитьПути(КорВ2, "tests");
ПТест = ОбъединитьПути(ПТест, "testlib");
ПСим = ОбъединитьПути(КорВ2, "oscript_modules");
ПСим = ОбъединитьПути(ПСим, "testlib");
Л = Новый Команда();
Л.УстановитьКоманду("ln");
Л.ДобавитьПараметр("-sfn");
Л.ДобавитьПараметр(ПТест);
Л.ДобавитьПараметр(ПСим);
Л.Исполнить();
П = ОбъединитьПути(КорВ2, "oscript_modules");
П = ОбъединитьПути(П, "bin");
П = ОбъединитьПути(П, "oneunit");
К = Новый Команда();
К.УстановитьКоманду(П);
К.ДобавитьПараметр("execute");
К.ДобавитьПараметр("-d");
К.ДобавитьПараметр(ОбъединитьПути(КорВ2, "tests"));
Код = К.Исполнить();
Если Код <> 0 Тогда
	ВызватьИсключение "oneunit завершился с кодом " + Код;
КонецЕсли;