#Использовать 1commands

Кор = ТекущийСценарий().Каталог;
ПутьСмоук = ОбъединитьПути(Кор, "smoke.os");
К = Новый Команда();
К.УстановитьКоманду("oscript");
К.ДобавитьПараметр(ПутьСмоук);
Код = К.Исполнить();
Если Код <> 0 Тогда
	ВызватьИсключение "smoke.os завершился с кодом " + Код;
КонецЕсли;
// oneunit + Autumn (полный набор) — когда подключим &ТестовыйНабор, см. tests/test_smoke.os