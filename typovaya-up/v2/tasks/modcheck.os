#Использовать ".."

ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));
Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	Сообщить("usage: oscript tasks/modcheck.os <restored> [--бп path] [--уп path] [--json path] [--txt path]");
	ЗавершитьРаботу(2);
КонецЕсли;
Корень = АргументыКоманднойСтроки[0];
Кб = ""; Ку = ""; ПJson = ""; ПTxt = "";
Для Й = 1 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
	Если (А = "--бп" Или А = "--bp") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Кб = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли (А = "--уп" Или А = "--up") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Ку = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли А = "--json" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		ПJson = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли А = "--txt" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		ПTxt = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	КонецЕсли;
КонецЦикла;
Если ПJson = "" Тогда
	ПJson = ОбъединитьПути(Корень, "modcheck_closure.json");
КонецЕсли;
Если ПTxt = "" Тогда
	ПTxt = ОбъединитьПути(Корень, "modcheck_closure.txt");
КонецЕсли;
М = Новый ТиповаяUpПроверкаЗамкнутости;
Р = М.ПроверитьКаталог(Корень, Кб, Ку);
М.ЗаписатьОтчеты(Р, ПJson, ПTxt);
Сообщить("modcheck_closure v2: ok=" + ?(Р.ok, "true", "false") + " unresolved=" + Р.unresolved.Количество());
ЗавершитьРаботу(?(Р.ok, 0, 1));