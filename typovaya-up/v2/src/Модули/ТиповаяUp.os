// M1/M3: CLI, чтение, сопоставление. M4+ — заглушка пайплайна.

Перем ВнутреннийЗагрузчик;
Перем КореньV2;

Процедура УстановитьКореньV2(Знач Путь) Экспорт
	КореньV2 = Путь;
КонецПроцедуры

Функция СкриптЯдра(Знач ИмяФайла) Экспорт
	Возврат ЗагрузчикВнутренних().ИзКаталогаМодулей(ИмяФайла);
КонецФункции

Функция ЗагрузчикВнутренних() Экспорт
	Если ВнутреннийЗагрузчик = Неопределено Тогда
		Если ПустаяСтрока(КореньV2) Тогда
			ВызватьИсключение "Вызовите ТиповаяUp.УстановитьКореньV2 из сценария до использования классов пакета";
		КонецЕсли;
		Путь = ОбъединитьПути(КореньV2, "src");
		Путь = ОбъединитьПути(Путь, "internal");
		Путь = ОбъединитьПути(Путь, "Модули");
		Путь = ОбъединитьПути(Путь, "ВнутренниеМодули.os");
		ВнутреннийЗагрузчик = ЗагрузитьСценарий(Путь);
	КонецЕсли;
	Возврат ВнутреннийЗагрузчик;
КонецФункции

Функция ВерсияПакета() Экспорт
	Возврат "2.0.0";
КонецФункции

Функция ЭтоКаркас() Экспорт
	Возврат Ложь;
КонецФункции

// Упрощённый разбор argv (совместим с Главный.os v1).
Функция РазобратьАргументы(Аргументы) Экспорт
	Синонимы = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("--исходная:source,--source:source,-и:source,--поставщик:vendor,--vendor:vendor,-п:vendor,"
		+ "--настройки:settings,--settings:settings,-н:settings,--выход:out,--out:out,-в:out,--help:__help,--version:__ver", ",") Цикл
		КЗ = СтрРазделить(Пара, ":");
		Синонимы.Вставить(КЗ[0], КЗ[1]);
	КонецЦикла;
	Результат = Новый Структура("source, vendor, settings, out, probeOnly, errors", "", "", "", "out", Ложь, Новый Массив);
	Й = 0;
	Пока Й < Аргументы.Количество() Цикл
		Ключ = Синонимы.Получить(НРег(Аргументы[Й]));
		Если Ключ = "__help" Или Ключ = "__ver" Тогда
		ИначеЕсли Ключ = "probeOnly" Тогда
			Результат.probeOnly = Истина;
		ИначеЕсли Ключ = Неопределено Тогда
			Результат.errors.Добавить("Неизвестный параметр: " + Аргументы[Й]);
		ИначеЕсли Й + 1 >= Аргументы.Количество() Тогда
			Результат.errors.Добавить("Нет значения для " + Аргументы[Й]);
		Иначе
			Результат[Ключ] = Аргументы[Й + 1];
			Й = Й + 1;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// M1: чтение одной или двух выгрузок.
Функция ПрочитатьВыгрузкиM1(Знач Параметры) Экспорт
	Чтение = Новый ТиповаяUpЧтениеВыгрузки;
	Мета = Новый ТиповаяUpМетаданныеКонфигурации;
	Лог = Новый Массив;
	Р = Новый Структура("source, vendor, errors", Неопределено, Неопределено, Новый Массив);
	Если Параметры.source <> "" Тогда
		Д = Чтение.ПрочитатьВыгрузку(Параметры.source, Лог);
		Р.source = Мета.СводкаВыгрузки(Д, Д.Корень);
	КонецЕсли;
	Если Параметры.vendor <> "" Тогда
		Д = Чтение.ПрочитатьВыгрузку(Параметры.vendor, Лог);
		Р.vendor = Мета.СводкаВыгрузки(Д, Д.Корень);
	КонецЕсли;
	Для Каждого С Из Лог Цикл
		Р.errors.Добавить(С);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СравнитьФикстуры(Знач КореньУп, Знач КореньБп, Знач ПутьMerge = "") Экспорт
	Чтение = Новый ТиповаяUpЧтениеВыгрузки;
	Лог = Новый Массив;
	Уп = Чтение.ПрочитатьВыгрузку(КореньУп, Лог);
	Бп = Чтение.ПрочитатьВыгрузку(КореньБп, Лог);
	Периметр = Неопределено;
	Если ПутьMerge <> "" Тогда
		Н = Новый ТиповаяUpНастройкиСравнения;
		Периметр = Н.ПрочитатьНастройки(ПутьMerge, Лог).Пути;
	КонецЕсли;
	С = Новый ТиповаяUpСопоставлениеВыгрузок;
	Возврат С.СравнитьВыгрузки(Уп, Бп, Периметр, Лог);
КонецФункции

Процедура ВыполнитьПайплайн(Знач Аргументы) Экспорт
	З = ЗагрузчикВнутренних();
	Прогон = З.ИзКаталогаМодулей("ПрогонM4.os");
	Прогон.ВыполнитьПрогон(?(ТипЗнч(Аргументы) = Тип("Массив"), Аргументы, АргументыКоманднойСтроки));
КонецПроцедуры

Функция ИменаСлоев() Экспорт
	Возврат СтрРазделить(
		"ТиповаяUpЧтениеВыгрузки,ТиповаяUpМетаданныеКонфигурации,ТиповаяUpРазборBsl,ТиповаяUpНастройкиСравнения,"
		+ "ТиповаяUpСопоставлениеВыгрузок,ТиповаяUpСинтезХуков,ТиповаяUpДозаполнениеМодуля,ТиповаяUpГенераторRestored,"
		+ "ТиповаяUpГенераторРасширения,ТиповаяUpФормыРасширения,ТиповаяUpОтчет,ТиповаяUpСамопроверкаВыхода,"
		+ "ТиповаяUpПроверкаЗамкнутости,ТиповаяUpКонвейерModCheck", ",", Ложь);
КонецФункции