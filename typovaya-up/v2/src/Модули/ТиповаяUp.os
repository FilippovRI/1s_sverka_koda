// Фасад пакета: метаданные каркаса и оркестрация (реализация — фазы M1+).
// Классы слоёв подключаются через opm install -l и #Использовать ".." / пакет целиком.

Функция ВерсияПакета() Экспорт
	Возврат "0.0.1";
КонецФункции

Функция ЭтоКаркас() Экспорт
	Возврат Истина;
КонецФункции

// Заглушка разбора CLI. Параметры — как у Главный.os v1 (фаза M1).
//
// Возвращает Структура: ok, errors (массив), args (разобранные поля).
Функция РазобратьАргументы(Знач Аргументы) Экспорт
	Рез = Новый Структура("ok, errors, args", Истина, Новый Массив, Новый Структура);
	Если Аргументы.Количество() = 0 Тогда
		Рез.ok = Ложь;
		Рез.errors.Добавить("Ожидаются аргументы; каркас: --help");
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Полный пайплайн compare + extension + restored — не реализован (M3–M4).
Процедура ВыполнитьПайплайн(Знач РазобранныеАргументы) Экспорт
	ВызватьИсключение "Каркас v2: пайплайн не реализован. См. docs/PLAN_V2.md";
КонецПроцедуры

// Имена классов слоёв (инстанцирование — в тестах/CLI после полной загрузки пакета).
Функция ИменаСлоев() Экспорт
	Возврат СтрРазделить(
		"ТиповаяUpЧтениеВыгрузки,ТиповаяUpМетаданныеКонфигурации,ТиповаяUpРазборBsl,ТиповаяUpНастройкиСравнения,"
		+ "ТиповаяUpСопоставлениеВыгрузок,ТиповаяUpСинтезХуков,ТиповаяUpДозаполнениеМодуля,ТиповаяUpГенераторRestored,"
		+ "ТиповаяUpГенераторРасширения,ТиповаяUpФормыРасширения,ТиповаяUpОтчет,ТиповаяUpСамопроверкаВыхода,"
		+ "ТиповаяUpПроверкаЗамкнутости,ТиповаяUpКонвейерModCheck", ",", Ложь);
КонецФункции