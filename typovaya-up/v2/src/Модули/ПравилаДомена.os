// Идентификаторы тестируемых правил домена (см. docs/PLAN_V2.md).

// Возвращает массив структур {id, summary}.
Функция ВсеПравила() Экспорт
	П = Новый Массив;
	П.Добавить(Новый Структура("id, summary", "R-DOM-001", "Типовой УП из БП; доработки — расширение УП_"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-002", "restored: код и Form.xml БП дословно"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-003", "Состав УП + догрузка из БП / заглушки"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-004", "DefinedType как УП; коллизия имён — имя БП"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-005", "Уникальность InternalInfo/GeneratedType по конфигурации"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-006", "Код УП в extension; ИиК; Вместо только с ПродолжитьВызов"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-007", "Формы расширения: BP Form.xml + программный слой УП"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-008", "Замкнутость только через генератор; единые правила"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-009", "Платформа 8.5.1.1150, выгрузка 2.21"));
	П.Добавить(Новый Структура("id, summary", "R-DOM-010", "Самопроверка выхода (syntax, CAC, ClassId, …)"));
	Возврат П;
КонецФункции

Функция ВерсияПлатформыЦелевая() Экспорт
	Возврат "8.5.1.1150";
КонецФункции

Функция ВерсияВыгрузкиЦелевая() Экспорт
	Возврат "2.21";
КонецФункции

Функция ПрефиксРасширения() Экспорт
	Возврат "УП_";
КонецФункции

Функция ИмяРасширения() Экспорт
	Возврат "УП_Доработки";
КонецФункции