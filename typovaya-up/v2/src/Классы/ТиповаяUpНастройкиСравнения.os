Перем Ядро;
Перем Инициализирован;

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ядро = З.ИзКаталогаМодулей("НастройкиСравненияЯдро.os");
	Инициализирован = Истина;
КонецПроцедуры

Функция ПрочитатьНастройки(Знач ПутьMerge, Лог = Неопределено) Экспорт
	ОбеспечитьЯдро();
	Если Лог = Неопределено Тогда
		Лог = Новый Массив;
	КонецЕсли;
	Возврат Ядро.ПрочитатьНастройки(ПутьMerge, Лог);
КонецФункции

Функция ПутьМодуля(Знач ПолноеИмя, Знач ВидМодуля) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПутьМодуля(ПолноеИмя, ВидМодуля);
КонецФункции

Функция ТипПоКаталогу(Знач Каталог) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ТипПоКаталогу(Каталог);
КонецФункции