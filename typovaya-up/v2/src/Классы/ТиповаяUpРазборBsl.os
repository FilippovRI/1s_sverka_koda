#Использовать "../internal"

// Фасад BSL: маршруты lexical | ast (аналог --parser old|bsparser).
// Эталон: РазборМетодов.os, РазборAST.os, СинтаксисBsl.os.

Перем Обертка;
Перем Лексика;

Процедура ПриСоздании()
	Обертка = Новый ОберткаBsparser;
	Лексика = Новый ЛексическийРазборМодуля;
КонецПроцедуры

Функция ДоступенAstПарсер() Экспорт
	Возврат Обертка.Доступен();
КонецФункции

Функция ПутьAstПарсера() Экспорт
	Возврат Обертка.ПутьКПарсеру();
КонецФункции

// Лексический разбор на методы (быстрый путь).
Функция РазобратьМодульЛексически(Знач Текст) Экспорт
	Возврат Лексика.РазобратьМодуль(Текст);
КонецФункции

// AST через bsparser (фаза M2).
Функция РазобратьМодульAst(Знач Текст) Экспорт
	Возврат Обертка.Разобрать(Текст);
КонецФункции

// Контроль готового &ИзменениеИКонтроль (гибрид строк + AST) — фаза M3.
Функция ПроверитьХук(Знач Текст) Экспорт
	ВызватьИсключение "Каркас v2: ТиповаяUpРазборBsl.ПроверитьХук — фаза M3";
КонецФункции