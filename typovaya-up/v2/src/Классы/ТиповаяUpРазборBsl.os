// M2: фасад lexical | ast.

Перем Лексика;
Перем Ast;

Процедура ОбеспечитьФасад()
	Если Лексика <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Лексика = Новый ЛексическийРазборМодуля;
	Ast = Новый ОберткаBsparser;
КонецПроцедуры

Функция ДоступенAstПарсер() Экспорт
	ОбеспечитьФасад();
	Возврат Ast.Доступен();
КонецФункции

Функция ПутьAstПарсера() Экспорт
	ОбеспечитьФасад();
	Возврат Ast.ПутьКПарсеру();
КонецФункции

Функция ПодготовитьТекст(Знач Текст) Экспорт
	ОбеспечитьФасад();
	Возврат Ast.ПодготовитьТекст(Текст);
КонецФункции

Функция РазобратьМодульЛексически(Знач Текст) Экспорт
	ОбеспечитьФасад();
	Возврат Лексика.РазобратьМодуль(Текст);
КонецФункции

Функция УбратьКомментарий(Знач Стр) Экспорт
	ОбеспечитьФасад();
	Возврат Лексика.УбратьКомментарий(Стр);
КонецФункции

Функция ЭтоМаркерКонцаМетода(Знач Стр, Знач МаркерНРег) Экспорт
	ОбеспечитьФасад();
	Возврат Лексика.ЭтоМаркерКонцаМетода(Стр, МаркерНРег);
КонецФункции

Функция РазобратьМодульAst(Знач Текст) Экспорт
	ОбеспечитьФасад();
	Возврат Ast.РазобратьМодульAST(Текст);
КонецФункции

Функция ОшибкиСинтаксиса(Знач Текст) Экспорт
	ОбеспечитьФасад();
	Возврат Ast.ОшибкиТекстаСМаркерами(Текст);
КонецФункции

Функция ПроверитьХук(Знач Текст) Экспорт
	ОбеспечитьФасад();
	Возврат Ast.ПроверитьХук(Текст);
КонецФункции

Функция ИзмененныеМетоды(Знач ТекстУп, Знач ТекстБп) Экспорт
	ОбеспечитьФасад();
	Возврат Ast.ИзмененныеМетоды(ТекстУп, ТекстБп);
КонецФункции