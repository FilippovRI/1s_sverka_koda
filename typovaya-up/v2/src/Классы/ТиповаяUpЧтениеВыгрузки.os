Перем Ядро;
Перем Инициализирован;

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ядро = З.ИзКаталогаМодулей("ЧтениеВыгрузкиЯдро.os");
	Инициализирован = Истина;
КонецПроцедуры

// M1: чтение файловой выгрузки (эталон ЧтениеВыгрузки.os).

Функция ПрочитатьВыгрузку(Знач Корень, Лог = Неопределено) Экспорт
	ОбеспечитьЯдро();
	Если Лог = Неопределено Тогда
		Лог = Новый Массив;
	КонецЕсли;
	Возврат Ядро.ПрочитатьВыгрузку(Корень, Лог);
КонецФункции

Функция ПрочитатьТекстМодуля(Знач ПолныйПуть) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПрочитатьТекстМодуля(ПолныйПуть);
КонецФункции

Функция НормализоватьПуть(Знач Путь) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.НормализоватьПуть(Путь);
КонецФункции

Функция ИсключенныйПуть(Знач Отн) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ИсключенныйПуть(Отн);
КонецФункции