Перем Ядро;
Перем Инициализирован;

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ядро = З.ИзКаталогаМодулей("МетаданныеЯдро.os");
	Инициализирован = Истина;
КонецПроцедуры

// M1: Configuration.xml, ConfigDumpInfo, дерево объектов.

Функция ПапкиМетаданных() Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПапкиМетаданных();
КонецФункции

Функция СоставКонфигурации(ПутьКонф) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СоставКонфигурации(ПутьКонф);
КонецФункции

Функция ИменаТега(Состав, Тег) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ИменаТега(Состав, Тег);
КонецФункции

Функция ДеревоОбъектов(Корень, Состав) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ДеревоОбъектов(Корень, Состав);
КонецФункции

Функция ПрочитатьConfigDumpInfo(Корень) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПрочитатьConfigDumpInfo(Корень);
КонецФункции

Функция СводкаВыгрузки(ДанныеЧтения, Корень) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СводкаВыгрузки(ДанныеЧтения, Корень);
КонецФункции