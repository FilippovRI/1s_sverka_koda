Перем Ядро;
Перем Инициализирован;

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ядро = З.ИзКаталогаМодулей("СинтезХуковЯдро.os");
	Разбор = З.ИзКаталогаМодулей("ЛексическийРазборМетодов.os");
	Без = З.ИзКаталогаМодулей("БезопасностьПереносаЯдро.os");
	Ядро.Инициализировать(Разбор, Без);
	Инициализирован = Истина;
КонецПроцедуры

Функция ПредложитьХук(Знач ТекстТиповогоТела, Знач ТекстДоработанногоТела) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПредложитьХук(ТекстТиповогоТела, ТекстДоработанногоТела);
КонецФункции

Функция ВосстановитьБазовыйТекстТиповогоИзХука(Знач ТелоХука) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ВосстановитьБазовыйТекстТиповогоИзХука(ТелоХука);
КонецФункции

Функция ПроверитьЦелостностьТелаИк(Знач Тело) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПроверитьЦелостностьТелаИк(Тело);
КонецФункции

Функция ПрепроцессорСбалансированВБлокахИк(Знач Строки) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ПрепроцессорСбалансированВБлокахИк(Строки);
КонецФункции

Функция СкорректироватьХукДляФункции(Предл, ТекстТиповогоТела, ТекстДоработанногоТела) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СкорректироватьХукДляФункции(Предл, ТекстТиповогоТела, ТекстДоработанногоТела);
КонецФункции