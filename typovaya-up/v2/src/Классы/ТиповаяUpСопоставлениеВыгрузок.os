Перем Ядро;
Перем Инициализирован;

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ядро = З.ИзКаталогаМодулей("СопоставлениеЯдро.os");
	Разбор = З.ИзКаталогаМодулей("ЛексическийРазборМетодов.os");
	Чтение = З.ИзКаталогаМодулей("ЧтениеВыгрузкиЯдро.os");
	Настройки = З.ИзКаталогаМодулей("НастройкиСравненияЯдро.os");
	Синтез = З.ИзКаталогаМодулей("СинтезХуковЯдро.os");
	Контракт = З.ИзКаталогаМодулей("КонтрактМетодаЯдро.os");
	Без = З.ИзКаталогаМодулей("БезопасностьПереносаЯдро.os");
	Синтез.Инициализировать(Разбор, Без);
	Ядро.Инициализировать(Разбор, Чтение, Настройки, Синтез, Контракт, Без);
	Инициализирован = Истина;
КонецПроцедуры

Процедура ВключитьBsparser(Знач МодульAst = Неопределено) Экспорт
	ОбеспечитьЯдро();
	Если МодульAst = Неопределено Тогда
		З = ТиповаяUp.ЗагрузчикВнутренних();
		МодульAst = З.ИзКаталогаМодулей("РазборAstЯдро.os");
	КонецЕсли;
	Ядро.ВключитьBsparser(МодульAst);
КонецПроцедуры

Функция СравнитьВыгрузки(Знач Исходная, Знач Поставщик, Периметр, Лог = Неопределено) Экспорт
	ОбеспечитьЯдро();
	Если Лог = Неопределено Тогда
		Лог = Новый Массив;
	КонецЕсли;
	Возврат Ядро.СравнитьВыгрузки(Исходная, Поставщик, Периметр, Лог);
КонецФункции

Функция СтатистикаBsparser() Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СтатистикаBsparser();
КонецФункции

Функция СравнитьМодуль(Знач Путь, Знач ПутьУп, Знач ПутьБп) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СравнитьМодуль(Путь, ПутьУп, ПутьБп);
КонецФункции

Функция ОтчетBsparser() Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ОтчетBsparser();
КонецФункции

Функция ВнеМетодовБезОбластей(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ВнеМетодовБезОбластей(Текст);
КонецФункции

Функция СобратьОбработчикиМетаданных(Знач Корень) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СобратьОбработчикиМетаданных(Корень);
КонецФункции

Функция МаркерВнутриСтроки(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.МаркерВнутриСтроки(Текст);
КонецФункции

Функция СтрокиТелаAST(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.СтрокиТелаAST(Текст);
КонецФункции