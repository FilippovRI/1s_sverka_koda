// M5: modcheck замкнутости — фасад v1 + R-DOM-005 в ядре v1 (см. ПроверкаЗамкнутости.os).

Процедура ПриСоздании()
КонецПроцедуры

Функция МодульПроверки()
	Возврат ТиповаяUp.ЗагрузчикВнутренних().ИзКаталогаМодулей("ФасадV1.os").Подключить("ПроверкаЗамкнутости");
КонецФункции

// Параметры: restored (обяз.); vendor, source — БП/УП для inBp/inUp; либо позиционно (restored, vendor, source).
Функция ПроверитьКаталог(Знач Параметры, КореньБп = "", КореньУп = "") Экспорт
	Корень = Параметры;
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		Корень = Параметры.restored;
		Если Параметры.Свойство("vendor") Тогда
			КореньБп = Параметры.vendor;
		КонецЕсли;
		Если Параметры.Свойство("source") Тогда
			КореньУп = Параметры.source;
		КонецЕсли;
	КонецЕсли;
	Возврат МодульПроверки().ВыполнитьПроверку(Корень, КореньБп, КореньУп);
КонецФункции

// R-DOM-005: дубликаты TypeId/ValueId (классы InternalInfoDuplicate* в unresolved).
Функция ПроверитьУникальностьInternalInfo(Знач Корень) Экспорт
	Р = ПроверитьКаталог(Корень);
	Сч = Новый Соответствие;
	Список = Новый Массив;
	Для Каждого Э Из Р.unresolved Цикл
		Если Э.class = "InternalInfoDuplicateTypeId" Или Э.class = "InternalInfoDuplicateValueId" Тогда
			Список.Добавить(Э);
			Уч = Сч.Получить(Э.class);
			Сч.Вставить(Э.class, ?(Уч = Неопределено, 1, Уч + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ok, counts, unresolved", Список.Количество() = 0, Сч, Список);
КонецФункции

Процедура ЗаписатьОтчеты(Результат, ПутьJson, ПутьTxt) Экспорт
	МодульПроверки().ЗаписатьОтчеты(Результат, ПутьJson, ПутьTxt);
КонецПроцедуры