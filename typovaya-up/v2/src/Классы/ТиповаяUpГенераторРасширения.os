// M4: запись extension + restored через эталон v1 ЧерновикРасширения.os (поведение 1:1).

Процедура ПриСоздании()
КонецПроцедуры

// Параметры — как у ЧерновикРасширения.Записать.
Функция ЗаписатьЧерновик(Модули, КореньИсходной, Выход, ИмяРасширения, Префикс, Лог, КореньПоставщика = "") Экспорт
	Ф = ТиповаяUp.ЗагрузчикВнутренних().ИзКаталогаМодулей("ФасадV1.os");
	Ч = Ф.Подключить("ЧерновикРасширения");
	Разбор = Ф.Подключить("РазборМетодов");
	Настройки = Ф.Подключить("НастройкиСравнения");
	Ч.Инициализировать(Разбор, Настройки);
	Возврат Ч.Записать(Модули, КореньИсходной, Выход, ИмяРасширения, Префикс, Лог, КореньПоставщика);
КонецФункции