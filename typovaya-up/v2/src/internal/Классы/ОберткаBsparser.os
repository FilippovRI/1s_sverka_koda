Перем AstЯдро;
Перем Подготовка;
Перем Инициализирован; // Ложь после первой загрузки — Истина

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	AstЯдро = З.ИзКаталогаМодулей("РазборAstЯдро.os");
	Подготовка = З.ИзКаталогаМодулей("ПодготовкаСинтаксисBsl.os");
	Инициализирован = Истина;
КонецПроцедуры

// M2: vendored bsparser + подготовка текста.

Функция Доступен() Экспорт
	ОбеспечитьЯдро();
	Возврат AstЯдро.Доступен();
КонецФункции

Функция ПутьКПарсеру() Экспорт
	ОбеспечитьЯдро();
	Возврат Подготовка.ПутьПарсера();
КонецФункции

Функция ПодготовитьТекст(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Подготовка.БезКонструкцийВнеПарсера(Текст);
КонецФункции

Функция ОшибкиТекста(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Подготовка.ОшибкиТекста(Текст);
КонецФункции

Функция ОшибкиТекстаСМаркерами(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Подготовка.ОшибкиТекстаСМаркерами(Текст);
КонецФункции

Функция РазобратьМодульAST(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат AstЯдро.РазобратьМодульAST(Текст);
КонецФункции

Функция ПроверитьХук(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат AstЯдро.ПроверитьХук(Текст);
КонецФункции

Функция ИзмененныеМетоды(Знач ТекстУп, Знач ТекстБп) Экспорт
	ОбеспечитьЯдро();
	Возврат AstЯдро.ИзмененныеМетоды(ТекстУп, ТекстБп);
КонецФункции