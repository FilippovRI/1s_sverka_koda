// Загрузка vendored lead-tools bsparser (../vendor/bsparser от корня typovaya-up).
// Полный AST: Разобрать, ТаблицаТокенов, ТаблицаОшибок — как РазборAST.os v1.

Перем Парсер;
Перем Доступность;

Функция КаталогBsparser()
	П = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
	П = ОбъединитьПути(П, "..");
	П = ОбъединитьПути(П, "..");
	П = ОбъединитьПути(П, "..");
	П = ОбъединитьПути(П, "vendor");
	П = ОбъединитьПути(П, "bsparser");
	П = ОбъединитьПути(П, "src");
	П = ОбъединитьПути(П, "ПарсерВстроенногоЯзыка");
	П = ОбъединитьПути(П, "Ext");
	Возврат ОбъединитьПути(П, "ObjectModule.bsl");
КонецФункции

// Истина, если ObjectModule.bsl загружается.
Функция Доступен() Экспорт
	Если Доступность <> Неопределено Тогда
		Возврат Доступность;
	КонецЕсли;
	Путь = КаталогBsparser();
	Доступность = Ложь;
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Парсер = ЗагрузитьСценарий(Путь);
		Доступность = Истина;
	Исключение
		Парсер = Неопределено;
	КонецПопытки;
	Возврат Доступность;
КонецФункции

Функция ПутьКПарсеру() Экспорт
	Возврат КаталогBsparser();
КонецФункции

// Структура: ok, available, errors, module, tokens — заполняется в фазе M2.
Функция Разобрать(Знач Текст) Экспорт
	Рез = Новый Структура("ok, available, errors", Ложь, Доступен(), Новый Массив);
	Если Не Рез.available Тогда
		Возврат Рез;
	КонецЕсли;
	ВызватьИсключение "Каркас v2: ОберткаBsparser.Разобрать — фаза M2";
КонецФункции