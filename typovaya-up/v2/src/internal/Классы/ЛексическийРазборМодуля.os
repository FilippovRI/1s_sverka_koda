Перем Ядро;
Перем Инициализирован;

Процедура ОбеспечитьЯдро()
	Если Инициализирован = Истина Тогда
		Возврат;
	КонецЕсли;
	З = ТиповаяUp.ЗагрузчикВнутренних();
	Ядро = З.ИзКаталогаМодулей("ЛексическийРазборМетодов.os");
	Инициализирован = Истина;
КонецПроцедуры

// M2: лексический разбор методов (порт РазборМетодов.os).

Функция РазобратьМодуль(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.РазобратьМодуль(Текст);
КонецФункции

Функция УбратьКомментарий(Знач Стр) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.УбратьКомментарий(Стр);
КонецФункции

Функция РазобратьОбъявление(Знач Стр) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.РазобратьОбъявление(Стр);
КонецФункции

Функция Нормализовать(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.Нормализовать(Текст);
КонецФункции

Функция ЭтоМаркерКонцаМетода(Знач Стр, Знач МаркерНРег) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ЭтоМаркерКонцаМетода(Стр, МаркерНРег);
КонецФункции

Функция ИзвлечьТелоМетода(Знач Текст) Экспорт
	ОбеспечитьЯдро();
	Возврат Ядро.ИзвлечьТелоМетода(Текст);
КонецФункции