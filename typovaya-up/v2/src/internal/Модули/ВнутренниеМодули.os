Перем Кэш;

Функция ИзКаталогаМодулей(Знач ИмяФайла) Экспорт
	Если Кэш = Неопределено Тогда
		Кэш = Новый Соответствие;
	КонецЕсли;
	Если Кэш.Получить(ИмяФайла) <> Неопределено Тогда
		Возврат Кэш.Получить(ИмяФайла);
	КонецЕсли;
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, ИмяФайла);
	М = ЗагрузитьСценарий(Путь);
	Кэш.Вставить(ИмяФайла, М);
	Возврат М;
КонецФункции