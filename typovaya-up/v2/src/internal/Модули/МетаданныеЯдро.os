// Состав Configuration.xml, ConfigDumpInfo, карта папок метаданных (эталон v1).

Функция ПапкиМетаданных() Экспорт
	Р = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Catalog:Catalogs,Document:Documents,Enum:Enums,InformationRegister:InformationRegisters,"
		+ "AccumulationRegister:AccumulationRegisters,ChartOfAccounts:ChartsOfAccounts,DocumentJournal:DocumentJournals,"
		+ "ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,ChartOfCalculationTypes:ChartsOfCalculationTypes,"
		+ "AccountingRegister:AccountingRegisters,Task:Tasks,DataProcessor:DataProcessors,Report:Reports,"
		+ "CommonPicture:CommonPictures,StyleItem:StyleItems,Style:Styles,CommonCommand:CommonCommands,"
		+ "CommandGroup:CommandGroups,CommonTemplate:CommonTemplates,FilterCriterion:FilterCriteria,"
		+ "DefinedType:DefinedTypes,FunctionalOption:FunctionalOptions,CommonForm:CommonForms,CommonModule:CommonModules", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Р.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПрочитатьТекстФайла(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

// ChildObjects Configuration.xml: Соответствие Тег -> Соответствие(нрег -> Имя).
Функция СоставКонфигурации(ПутьКонф) Экспорт
	Р = Новый Соответствие;
	Т = ПрочитатьТекстФайла(ПутьКонф);
	Если Т = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого С Из (Новый РегулярноеВыражение("(?m)^\t\t\t<(\w+)>([^<]+)</\1>")).НайтиСовпадения(Т) Цикл
		Тег = С.Группы[1].Значение;
		Если Р.Получить(Тег) = Неопределено Тогда
			Р.Вставить(Тег, Новый Соответствие);
		КонецЕсли;
		Р.Получить(Тег).Вставить(НРег(С.Группы[2].Значение), С.Группы[2].Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИменаТега(Состав, Тег) Экспорт
	Р = Состав.Получить(Тег);
	Возврат ?(Р = Неопределено, Новый Соответствие, Р);
КонецФункции

// Дерево объектов: массив {тег, имя, папка, файл} по каталогу выгрузки.
Функция ДеревоОбъектов(Корень, Состав) Экспорт
	Папки = ПапкиМетаданных();
	Рез = Новый Массив;
	Для Каждого КЗ Из Состав Цикл
		Тег = КЗ.Ключ;
		Пап = Папки.Получить(Тег);
		Если Пап = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Об Из КЗ.Значение Цикл
			Имя = Об.Значение;
			Файл = ОбъединитьПути(Корень, Пап, Имя + ".xml");
			Рез.Добавить(Новый Структура("тег, имя, папка, файл, естьФайл",
				Тег, Имя, Пап, Файл, (Новый Файл(Файл)).Существует()));
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ConfigDumpInfo.xml: format, version, имена Metadata.
Функция ПрочитатьConfigDumpInfo(Корень) Экспорт
	Р = Новый Структура("есть, формат, версияВыгрузки, metadata", Ложь, "", "", Новый Массив);
	Путь = ОбъединитьПути(Корень, "ConfigDumpInfo.xml");
	Т = ПрочитатьТекстФайла(Путь);
	Если Т = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Р.есть = Истина;
	РвФ = Новый РегулярноеВыражение("format=""([^""]+)""");
	РвВ = Новый РегулярноеВыражение("<ConfigDumpInfo[^>]*version=""([^""]+)""");
	Сф = РвФ.НайтиСовпадения(Т);
	Св = РвВ.НайтиСовпадения(Т);
	Если Сф.Количество() > 0 Тогда
		Р.формат = Сф[0].Группы[1].Значение;
	КонецЕсли;
	Если Св.Количество() > 0 Тогда
		Р.версияВыгрузки = Св[0].Группы[1].Значение;
	КонецЕсли;
	РвИ = Новый РегулярноеВыражение("name=""([^""]+)""");
	Для Каждого Стр Из СтрРазделить(Т, Символы.ПС) Цикл
		Если СтрНайти(Стр, "<Metadata") = 0 Тогда
			Продолжить;
		КонецЕсли;
		С = РвИ.НайтиСовпадения(Стр);
		Если С.Количество() > 0 Тогда
			Р.metadata.Добавить(С[0].Группы[1].Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Сводка выгрузки для CLI/M1.
Функция СводкаВыгрузки(ДанныеЧтения, Корень) Экспорт
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Состав = СоставКонфигурации(ПутьКонф);
	Кди = ПрочитатьConfigDumpInfo(Корень);
	Дер = ДеревоОбъектов(Корень, Состав);
	Возврат Новый Структура(
		"корень, имя, версия, модули, естьConfigDumpInfo, configDump, состав, дерево",
		ДанныеЧтения.Корень, ДанныеЧтения.Имя, ДанныеЧтения.Версия, ДанныеЧтения.Модули,
		ДанныеЧтения.ЕстьConfigDumpInfo, Кди, Состав, Дер);
КонецФункции