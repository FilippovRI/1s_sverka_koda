// Постобработка после ЧерновикРасширения — логика 1:1 с Главный.os (v1), без дублирования сравнения.

// Быстрый режим --только-модули-и-формы: обёртки, overlay restored из БП, без stub/замкнутости/bsparser.
Процедура ПродолжитьХвостБыстро(П, Модули, Исходная, Поставщик, Лог, Сводка, ИтогЧ) Экспорт
	Ф = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФасадV1.os"));
	Отчет = Ф.Подключить("ОтчетHTML");
	Разбор = Ф.Подключить("РазборМетодов");
	Доз = Ф.Подключить("ДозаполнениеМодуля");
	Доз.Инициализировать(Разбор);
	ИтогОб = Доз.ОбработатьОбёрткиВместо(П.out, П.prefix);
	Сводка.Вставить("wrappersAdded", ИтогОб.count);
	Лог.Добавить("В расширение добавлены обёртки &Вместо: " + ИтогОб.count + " методов");
	Мф = Ф.Подключить("МодулиИФормыБыстро");
	КаталогВосст = ОбъединитьПути(П.out, "restored");
	Если П.Свойство("formsFromUp") И П.formsFromUp Тогда
		Рмф = Мф.ПрименитьМодулиБпФормыИзУп(КаталогВосст, Поставщик.Корень, Исходная.Корень, Лог, П.out);
		Сводка.Вставить("engine", "v2-m4-modules-forms-only-forms-from-up");
	Иначе
		Рмф = Мф.ПрименитьДословноБпКRestored(КаталогВосст, Поставщик.Корень, Исходная.Корень, Лог, П.out);
		Сводка.Вставить("engine", "v2-m4-modules-forms-only");
	КонецЕсли;
	Сводка.Вставить("formsFromUp", ?(П.Свойство("formsFromUp"), П.formsFromUp, Ложь));
	Сводка.Вставить("formsKeptUp", Рмф.formsKeptUp);
	Сводка.Вставить("formPrecheck", Новый Структура("checked, incompatible, topReasons",
		Рмф.formPrecheck.checked, Рмф.formPrecheck.incompatible, Рмф.formPrecheck.topReasons));
	Сводка.Вставить("modulesForms", Новый Структура("modulesBsl, formsXml, formsKeptUp, hooks, wrappersAdded, extensionMethods",
		Рмф.modulesBsl, Рмф.formsXml, Рмф.formsKeptUp.Количество(), ИтогЧ.hooks, ИтогОб.count, ИтогЧ.methods));
	Лог.Добавить("modulesForms: итог — модулей .bsl " + Рмф.modulesBsl + ", Form.xml " + Рмф.formsXml
		+ "; хуков " + ИтогЧ.hooks + ", обёрток &Вместо " + ИтогОб.count);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
КонецПроцедуры

Процедура ПродолжитьХвост(П, Модули, Исходная, Поставщик, Лог, Сводка, ИтогЧ, Стат) Экспорт
	Ф = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФасадV1.os"));
	Отчет = Ф.Подключить("ОтчетHTML");
	Разбор = Ф.Подключить("РазборМетодов");
	Синтез = Ф.Подключить("СинтезХуков");
	Синтез.Инициализировать(Разбор, Ф.Подключить("БезопасностьПереноса"));
	Доз = Ф.Подключить("ДозаполнениеМодуля");
	Доз.Инициализировать(Разбор);
	ИтогОб = Доз.ОбработатьОбёрткиВместо(П.out, П.prefix);
	Сводка.Вставить("wrappersAdded", ИтогОб.count);
	Лог.Добавить("В расширение добавлены обёртки &Вместо: " + ИтогОб.count + " методов (wrappers_added.json)");
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));

	Самопров = Ф.Подключить("СамопроверкаВыхода");
	Самопров.Инициализировать(Разбор, Доз, Синтез);
	ПарСинт = Новый Структура("enabled, limit, cachePath", Не П.noSyntax, Число(П.syntaxLimit),
		?(П.fullCheck, "", ОбъединитьПути(П.out, "cache", "syntax.json")));
	Рсп = Самопров.ПроверитьКаталогВыхода(П.out, Модули, Сводка, Исходная.Корень, ПарСинт);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "self_check.json"), Отчет.ВJSON(Рсп));

	Арн = Ф.Подключить("ПроверкаАрности");
	ПереносА = Ф.Подключить("ПереносСигнатур");
	КонтрактА = Ф.Подключить("КонтрактМетода");
	ПереносА.Инициализировать(Разбор, КонтрактА);
	Арн.Инициализировать(Разбор, КонтрактА, ПереносА);
	Рарн = Арн.Проверить(П.out, Исходная.Корень);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "arity_check.json"), Отчет.ВJSON(Рарн));

	Если ИтогЧ.Свойство("uponly") Тогда
		Рту = ИтогЧ.uponly;
	Иначе
		Рту = Ф.Подключить("ОбъектыТолькоУп").Проверить(Исходная.Корень, Поставщик.Корень, П.out, Лог, ОбъединитьПути(П.out, "restored"));
	КонецЕсли;
	Сводка.Вставить("uponly", Рту);

	КаталогВосстБп = ОбъединитьПути(П.out, "restored");
	ЗагКаркас = Ф.Подключить("ЗаготовкиОбъектовБп");
	ЗагКаркас.ОбеспечитьКаркасRestored(КаталогВосстБп, Исходная.Корень, Лог);
	Если Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосстБп, "Configuration.xml"))).Существует() Тогда
		ВозвратБп = Ф.Подключить("ВозвратОбщихМодулейБп");
		РвБп = ВозвратБп.Анализ(КаталогВосстБп, Поставщик.Корень);
		ВозвратБп.Вернуть(РвБп.clean, Поставщик.Корень, КаталогВосстБп);
		ЗаглБп = Ф.Подключить("ЗаглушкиОбщихМодулейБп");
		ЗаглБп.Инициализировать(ВозвратБп);
		ИменаЗаглБп = Новый Массив;
		Для Каждого КЗ Из РвБп.blocked Цикл
			ИменаЗаглБп.Добавить(КЗ.Ключ);
		КонецЦикла;
		КатТекстовБп = Новый Массив;
		КатТекстовБп.Добавить(КаталогВосстБп);
		КатТекстовБп.Добавить(ОбъединитьПути(П.out, "extension"));
		РзБп = ЗаглБп.Создать(ИменаЗаглБп, Поставщик.Корень, КаталогВосстБп, КатТекстовБп);
		СсБп = ЗаглБп.СсылкиНаОтсутствующиеОбъекты(КаталогВосстБп, КаталогВосстБп);
		РзЗаг = ЗагКаркас.ДополнитьЗаготовки(КаталогВосстБп, Поставщик.Корень, Лог, Исходная.Корень, "");
		ФормБп = ЗагКаркас.ВернутьFormXmlИзБп(КаталогВосстБп, Поставщик.Корень);
		Сводка.Вставить("restoredStubs", Новый Структура("stubs, fragments, requirements, importPaths, logExtras, formsLiteral",
			РзЗаг.stubs, РзЗаг.fragments, РзЗаг.requirements, 0, Новый Структура, ФормБп));
	КонецЕсли;

	Ф.Подключить("ПроверкаФорм").Проверить(П.out, Исходная.Корень, Разбор);
	ДСп = Ф.Подключить("ЗапросыДинСписков");
	ДСп.ПроверитьКаталог(ОбъединитьПути(П.out, "restored"), Исходная.Корень, Исходная.Корень);
	ДСп.ПроверитьКаталог(ОбъединитьПути(П.out, "extension"), Исходная.Корень, Исходная.Корень);

	ЧрП = Ф.Подключить("ЧерновикРасширения");
	ЗпП = Ф.Подключить("ЗаимствованиеПолейСписков");
	ЗпП.УстановитьЧерновик(ЧрП);
	КаталогРасшП = ОбъединитьПути(П.out, "extension");
	ЗпП.Применить(КаталогРасшП, Исходная.Корень, "", Ложь);
	ФрСтд = Ф.Подключить("ФормыRestored");
	ФрСтд.ОчиститьСтандартныеКомандыВКаталоге(КаталогРасшП, Лог);

	Обр = Ф.Подключить("ОбратнаяСборка");
	Обр.Инициализировать(Разбор);
	Робр = Обр.Проверить(П.out, Исходная.Корень, Поставщик.Корень, П.prefix);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "reverse_build.json"), Отчет.ВJSON(Робр));
	Сводка.Вставить("reverseBuild", Робр.summary);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
КонецПроцедуры