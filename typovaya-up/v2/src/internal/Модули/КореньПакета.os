// Каталог typovaya-up (родитель v2) от internal/Модули или src/Модули.

Функция КореньTypovayaUp() Экспорт
	П = ТекущийСценарий().Каталог;
	П = ОбъединитьПути(П, "..");
	П = ОбъединитьПути(П, "..");
	П = ОбъединитьПути(П, "..");
	Возврат ОбъединитьПути(П, "..");
КонецФункции

Функция ПутьVendorBsparser() Экспорт
	П = ОбъединитьПути(КореньTypovayaUp(), "vendor");
	П = ОбъединитьПути(П, "bsparser");
	П = ОбъединитьПути(П, "src");
	П = ОбъединитьПути(П, "ПарсерВстроенногоЯзыка");
	П = ОбъединитьПути(П, "Ext");
	Возврат ОбъединитьПути(П, "ObjectModule.bsl");
КонецФункции