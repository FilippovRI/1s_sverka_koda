// M4: сопоставление v2, генерация через фасад v1, хвост v1.

Функция РазобратьПараметры(Аргументы)
	// Не подключать Главный.os: при загрузке он выполняет полный CLI v1 (двойной прогон).
	Син = Новый Соответствие;
	Для Каждого П Из СтрРазделить("-и:source,--исходная:source,-п:vendor,--поставщик:vendor,-н:settings,--настройки:settings,-в:out,--выход:out", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Син.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Р = Новый Структура("source, vendor, settings, out, extension, prefix, noReport, noSyntax, syntaxLimit, fullCheck, noCache, parser, errors",
		"", "", "", "out", "УП_Доработки", "УП_", Ложь, Ложь, "0", Ложь, Истина, "old", Новый Массив);
	Й = 0;
	Пока Й < Аргументы.Количество() Цикл
		Ключ = Син.Получить(НРег(Аргументы[Й]));
		Если НРег(Аргументы[Й]) = "--без-отчета" Или НРег(Аргументы[Й]) = "--no-report" Тогда
			Р.noReport = Истина;
		ИначеЕсли Ключ = Неопределено Тогда
			// пропуск неизвестных для m4
		ИначеЕсли Й + 1 < Аргументы.Количество() Тогда
			Р[Ключ] = Аргументы[Й + 1];
			Й = Й + 1;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ВыполнитьПрогон(Аргументы) Экспорт
	П = РазобратьПараметры(Аргументы);
	Если П.source = "" Или П.vendor = "" Тогда
		ВызватьИсключение "M4: нужны -и и -п";
	КонецЕсли;
	Ф = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФасадV1.os"));
	Отчет = Ф.Подключить("ОтчетHTML");
	Лог = Новый Массив;
	Чтение = Новый ТиповаяUpЧтениеВыгрузки;
	Исходная = Чтение.ПрочитатьВыгрузку(П.source, Лог);
	Поставщик = Чтение.ПрочитатьВыгрузку(П.vendor, Лог);
	Периметр = Неопределено;
	Если П.settings <> "" Тогда
		Н = Новый ТиповаяUpНастройкиСравнения;
		Периметр = Н.ПрочитатьНастройки(П.settings, Лог).Пути;
	КонецЕсли;
	Сравн = Новый ТиповаяUpСопоставлениеВыгрузок;
	Модули = Сравн.СравнитьВыгрузки(Исходная, Поставщик, Периметр, Лог);
	Стат = Новый Структура("ast, fallbacks", 0, Новый Массив);
	СоздатьКаталог(П.out);
	Мета = Новый Структура("source, vendor, sourceName, vendorName, settings, settingsInfo, generated",
		П.source, П.vendor, Исходная.Имя + " " + Исходная.Версия, Поставщик.Имя + " " + Поставщик.Версия,
		П.settings, "", Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm'"));
	Сводка = Отчет.СобратьСводку(Модули, Мета);
	Сводка.Вставить("engine", "v2-m4");
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
	Ген = Новый ТиповаяUpГенераторРасширения;
	ИтогЧ = Ген.ЗаписатьЧерновик(Модули, Исходная.Корень, П.out, П.extension, П.prefix, Лог, Поставщик.Корень);
	Сводка.Вставить("returnedToVendor", ИтогЧ.returnedToVendor);
	Хвост = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ПродолжениеХвостV1.os"));
	Хвост.ПродолжитьХвост(П, Модули, Исходная, Поставщик, Лог, Сводка, ИтогЧ, Стат);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "log.txt"), СтрСоединить(Лог, Символы.ПС));
КонецПроцедуры