#Использовать "Модули/ТиповаяUp"

ТиповаяUp.УстановитьКореньV2(ОбъединитьПути(ТекущийСценарий().Каталог, ".."));

Процедура ПоказатьСправку()
	Сообщить(
		"typovaya-up " + ТиповаяUp.ВерсияПакета() + " (пакет v2)" + Символы.ПС
		+ "M1: чтение выгрузок; M2: разбор BSL; полный пайплайн — typovaya-up/src/Главный.os" + Символы.ПС + Символы.ПС
		+ "  --исходная, -и <каталог>   выгрузка УП" + Символы.ПС
		+ "  --поставщик, -п <каталог>  выгрузка БП" + Символы.ПС
		+ "  --проба, --probe           сводка в JSON (stdout)" + Символы.ПС
		+ "  --help / --version");
КонецПроцедуры

Арг = АргументыКоманднойСтроки;
Для Каждого А Из Арг Цикл
	Н = НРег(СокрЛП(А));
	Если Н = "--help" Или Н = "-h" Тогда
		ПоказатьСправку();
		ЗавершитьРаботу(0);
	ИначеЕсли Н = "--version" Или Н = "-v" Тогда
		Сообщить(ТиповаяUp.ВерсияПакета());
		ЗавершитьРаботу(0);
	КонецЕсли;
КонецЦикла;

П = ТиповаяUp.РазобратьАргументы(Арг);
Для Каждого А Из Арг Цикл
	Если НРег(А) = "--проба" Или НРег(А) = "--probe" Тогда
		П.probeOnly = Истина;
	КонецЕсли;
КонецЦикла;
Если П.errors.Количество() > 0 Тогда
	Для Каждого Е Из П.errors Цикл
		Сообщить(Е);
	КонецЦикла;
	ЗавершитьРаботу(1);
КонецЕсли;
Если П.source = "" И П.vendor = "" Тогда
	ПоказатьСправку();
	ЗавершитьРаботу(1);
КонецЕсли;

Сводка = ТиповаяUp.ПрочитатьВыгрузкиM1(П);
Если П.probeOnly Тогда
	Зап = Новый ЗаписьJSON;
	Зап.УстановитьСтроку();
	Зап.ЗаписатьНачалоОбъекта();
	Зап.ЗаписатьИмяСвойства("version");
	Зап.ЗаписатьЗначение(ТиповаяUp.ВерсияПакета());
	Для Каждого Ключ Из СтрРазделить("source,vendor", ",") Цикл
		Зап.ЗаписатьИмяСвойства(Ключ);
		Блок = Сводка[Ключ];
		Если Блок = Неопределено Тогда
			Зап.ЗаписатьЗначение(Неопределено);
			Продолжить;
		КонецЕсли;
		Зап.ЗаписатьНачалоОбъекта();
		Зап.ЗаписатьИмяСвойства("имя");
		Зап.ЗаписатьЗначение(Блок.имя);
		Зап.ЗаписатьИмяСвойства("версия");
		Зап.ЗаписатьЗначение(Блок.версия);
		Зап.ЗаписатьИмяСвойства("модулей");
		Зап.ЗаписатьЗначение(Блок.модули.Количество());
		Зап.ЗаписатьИмяСвойства("configDump");
		Зап.ЗаписатьНачалоОбъекта();
		Зап.ЗаписатьИмяСвойства("версияВыгрузки");
		Зап.ЗаписатьЗначение(?(Блок.configDump = Неопределено, "", Блок.configDump.версияВыгрузки));
		Зап.ЗаписатьКонецОбъекта();
		Зап.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Зап.ЗаписатьКонецОбъекта();
	Сообщить(Зап.Закрыть());
Иначе
	Для Каждого Ключ Из СтрРазделить("source,vendor", ",") Цикл
		Б = Сводка[Ключ];
		Если Б = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Сообщить(Ключ + ": " + Б.имя + " " + Б.версия + ", модулей " + Б.модули.Количество()
			+ ", ConfigDumpInfo " + ?(Б.естьConfigDumpInfo, "да", "нет"));
	КонецЦикла;
КонецЕсли;
ЗавершитьРаботу(0);