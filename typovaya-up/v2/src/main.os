// Точка входа CLI (каркас).

Перем МТиповаяUp;
Перем МПравилаДомена;

Процедура ПоказатьСправку()
	Сообщить(
		"typovaya-up-v2 (каркас " + МТиповаяUp.ВерсияПакета() + ")" + Символы.ПС
		+ "Целевая платформа: " + МПравилаДомена.ВерсияПлатформыЦелевая()
		+ ", выгрузка " + МПравилаДомена.ВерсияВыгрузкиЦелевая() + Символы.ПС
		+ Символы.ПС
		+ "  oscript src/main.os --help" + Символы.ПС
		+ "  oscript src/main.os --version" + Символы.ПС
		+ Символы.ПС
		+ "Полный CLI: typovaya-up/src/Главный.os (эталон)." + Символы.ПС
		+ "План миграции: typovaya-up/docs/PLAN_V2.md");
КонецПроцедуры

Кат = ТекущийСценарий().Каталог;
МТиповаяUp = ЗагрузитьСценарий(ОбъединитьПути(Кат, "Модули", "ТиповаяUp.os"));
МПравилаДомена = ЗагрузитьСценарий(ОбъединитьПути(Кат, "Модули", "ПравилаДомена.os"));

Арг = АргументыКоманднойСтроки;
Если Арг.Количество() = 0 Тогда
	ПоказатьСправку();
	ЗавершитьРаботу(1);
КонецЕсли;

Для Каждого А Из Арг Цикл
	Н = НРег(СокрЛП(А));
	Если Н = "--help" Или Н = "-h" Или Н = "/?" Тогда
		ПоказатьСправку();
		ЗавершитьРаботу(0);
	ИначеЕсли Н = "--version" Или Н = "-v" Тогда
		Сообщить(МТиповаяUp.ВерсияПакета());
		ЗавершитьРаботу(0);
	КонецЕсли;
КонецЦикла;

Сообщить("Каркас: укажите --help. Пайплайн сравнения пока в typovaya-up/src/Главный.os");
ЗавершитьРаботу(2);