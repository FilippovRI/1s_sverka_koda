// Юнит-тест переноса объектов «только в УП» в расширение (ОбъектыТолькоУп + ПереносОбъектовУп).
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Записать(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Функция П(Корн, Отн)
	Рез = Корн;
	Для Каждого Ч Из СтрРазделить(Отн, "/") Цикл
		Рез = ОбъединитьПути(Рез, Ч);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция Прочитать(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

Функция Мета(Класс, Имя, Уид, Доп = "")
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" version=""2.17"">" + Символы.ПС
		+ "	<" + Класс + " uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties>" + Символы.ПС
		+ "			<Name>" + Имя + "</Name>" + Символы.ПС
		+ "		</Properties>" + Символы.ПС
		+ Доп
		+ "	</" + Класс + ">" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Вр = ОбъединитьПути(ПолучитьИмяВременногоФайла(), "");
УП = ОбъединитьПути(Вр, "UP");
БП = ОбъединитьПути(Вр, "BP");
Вых = ОбъединитьПути(Вр, "out");
Расш = ОбъединитьПути(Вых, "extension");
Восст = ОбъединитьПути(Вых, "restored");
СоздатьКаталог(Расш);
СоздатьКаталог(Восст);

Записать(ОбъединитьПути(УП, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС + "<MetaDataObject>" + Символы.ПС
	+ "	<Configuration uuid=""11111111-1111-1111-1111-111111111111"">" + Символы.ПС
	+ "		<Properties>" + Символы.ПС + "			<CompatibilityMode>Version8_3_27</CompatibilityMode>" + Символы.ПС + "		</Properties>" + Символы.ПС
	+ "		<ChildObjects>" + Символы.ПС
	+ "			<Subsystem>Раздел</Subsystem>" + Символы.ПС
	+ "			<CommonPicture>Картинка</CommonPicture>" + Символы.ПС
	+ "			<Role>Роль</Role>" + Символы.ПС
	+ "			<CommonModule>МодульА</CommonModule>" + Символы.ПС
	+ "			<CommonModule>МодульБ</CommonModule>" + Символы.ПС
	+ "			<CommonModule>МодульВ</CommonModule>" + Символы.ПС
	+ "			<Catalog>Справ</Catalog>" + Символы.ПС
	+ "			<DataProcessor>Обр</DataProcessor>" + Символы.ПС
	+ "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС);
Для Каждого Корн Из СтрРазделить(УП + "|" + БП, "|") Цикл
	Записать(П(Корн, "Catalogs/Справ.xml"), Мета("Catalog", "Справ", "22222222-2222-2222-2222-222222222222",
		"		<ChildObjects>" + Символы.ПС + "			<Form>ФормаЭлемента</Form>" + Символы.ПС
		+ ?(Корн = УП, "			<Form>ФормаУп</Form>" + Символы.ПС + "			<Form>ФормаВыбора</Form>" + Символы.ПС, "")
		+ "		</ChildObjects>" + Символы.ПС));
	Записать(П(Корн, "Catalogs/Справ/Forms/ФормаЭлемента.xml"), Мета("Form", "ФормаЭлемента", "33333333-3333-3333-3333-333333333333"));
	Записать(П(Корн, "Catalogs/Справ/Ext/ObjectModule.bsl"), "Процедура П()" + Символы.ПС
		+ "	МодульБ.Сделать();" + Символы.ПС + ?(Корн = УП, "	МодульГ.Сделать();" + Символы.ПС, "") + "КонецПроцедуры" + Символы.ПС);
	Записать(П(Корн, "CommonPictures/Картинка.xml"), Мета("CommonPicture", "Картинка", "44444444-4444-4444-4444-444444444444"));
	Записать(П(Корн, "Roles/Роль.xml"), Мета("Role", "Роль", "55555555-5555-5555-5555-555555555555"));
	Записать(П(Корн, "Subsystems/Раздел.xml"), Мета("Subsystem", "Раздел", "66666666-6666-6666-6666-666666666666"));
КонецЦикла;
// формы УП у типового справочника: ФормаУп (только своё) и ФормаВыбора (на неё ссылается модуль менеджера — остаётся)
Записать(П(УП, "Catalogs/Справ/Forms/ФормаУп.xml"), Мета("Form", "ФормаУп", "77777777-7777-7777-7777-777777777777"));
Записать(П(УП, "Catalogs/Справ/Forms/ФормаУп/Ext/Form.xml"), "<Form><Attributes><Attribute name=""Объект"" id=""1"">"
	+ "<Type><v8:Type>cfg:CatalogObject.Справ</v8:Type></Type></Attribute></Attributes><DataPath>Объект.Наименование</DataPath>"
	+ "<Picture><xr:Ref>CommonPicture.Картинка</xr:Ref></Picture></Form>");
Записать(П(УП, "Catalogs/Справ/Forms/ФормаУп/Ext/Form/Module.bsl"), "&НаСервере" + Символы.ПС + "Процедура Х()" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
Записать(П(УП, "Catalogs/Справ/Forms/ФормаВыбора.xml"), Мета("Form", "ФормаВыбора", "88888888-8888-8888-8888-888888888888"));
Записать(П(УП, "Catalogs/Справ/Ext/ManagerModule.bsl"), "Процедура ОбработкаПолученияФормы()" + Символы.ПС
	+ "	ВыбраннаяФорма = ""ФормаВыбора"";" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
// общие модули только УП: А — без ссылок, Б — на него ссылается модуль справочника, В — на него ссылается только А
Записать(П(УП, "CommonModules/МодульА.xml"), Мета("CommonModule", "МодульА", "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"));
Записать(П(УП, "CommonModules/МодульА/Ext/Module.bsl"), "Процедура А() Экспорт" + Символы.ПС + "	МодульВ.В();" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
Записать(П(УП, "CommonModules/МодульБ.xml"), Мета("CommonModule", "МодульБ", "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"));
Записать(П(УП, "CommonModules/МодульБ/Ext/Module.bsl"), "Процедура Сделать() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
Записать(П(УП, "CommonModules/МодульГ.xml"), Мета("CommonModule", "МодульГ", "abababab-abab-abab-abab-abababababab"));
Записать(П(УП, "CommonModules/МодульГ/Ext/Module.bsl"), "Процедура Сделать() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
Записать(П(УП, "CommonModules/МодульВ.xml"), Мета("CommonModule", "МодульВ", "cccccccc-cccc-cccc-cccc-cccccccccccc"));
Записать(П(УП, "CommonModules/МодульВ/Ext/Module.bsl"), "Процедура В() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
// обработка только УП с командой, в составе подсистемы, в командном интерфейсе и в правах роли
Записать(П(УП, "DataProcessors/Обр.xml"), Мета("DataProcessor", "Обр", "dddddddd-dddd-dddd-dddd-dddddddddddd",
	"		<ChildObjects>" + Символы.ПС + "			<Command uuid=""eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"">" + Символы.ПС
	+ "				<Properties><Name>Открыть</Name></Properties>" + Символы.ПС + "			</Command>" + Символы.ПС + "		</ChildObjects>" + Символы.ПС));
Записать(П(УП, "DataProcessors/Обр/Ext/ObjectModule.bsl"), "Процедура Р()" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
Записать(П(УП, "Subsystems/Раздел.xml"), Мета("Subsystem", "Раздел", "66666666-6666-6666-6666-666666666666",
	"		<Content>" + Символы.ПС + "				<xr:Item xsi:type=""xr:MDObjectRef"">Catalog.Справ</xr:Item>" + Символы.ПС
	+ "				<xr:Item xsi:type=""xr:MDObjectRef"">DataProcessor.Обр</xr:Item>" + Символы.ПС + "		</Content>" + Символы.ПС));
Записать(П(УП, "Subsystems/Раздел/Ext/CommandInterface.xml"), "<CommandInterface>" + Символы.ПС
	+ "	<CommandsVisibility>" + Символы.ПС
	+ "		<Command name=""DataProcessor.Обр.Command.Открыть"">" + Символы.ПС + "			<Visibility><xr:Common>true</xr:Common></Visibility>" + Символы.ПС + "		</Command>" + Символы.ПС
	+ "		<Command name=""0:eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee"">" + Символы.ПС + "			<Visibility><xr:Common>true</xr:Common></Visibility>" + Символы.ПС + "		</Command>" + Символы.ПС
	+ "		<Command name=""Catalog.Справ.StandardCommand.OpenList"">" + Символы.ПС + "			<Visibility><xr:Common>true</xr:Common></Visibility>" + Символы.ПС + "		</Command>" + Символы.ПС
	+ "	</CommandsVisibility>" + Символы.ПС + "</CommandInterface>" + Символы.ПС);
Записать(П(УП, "Roles/Роль/Ext/Rights.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Rights xmlns=""http://v8.1c.ru/8.2/roles"" version=""2.17"">" + Символы.ПС
	+ "	<setForNewObjects>true</setForNewObjects>" + Символы.ПС + "	<setForAttributesByDefault>true</setForAttributesByDefault>" + Символы.ПС
	+ "	<independentRightsOfChildObjects>false</independentRightsOfChildObjects>" + Символы.ПС
	+ "	<object>" + Символы.ПС + "		<name>Catalog.Справ</name>" + Символы.ПС + "		<right><name>Read</name><value>true</value></right>" + Символы.ПС + "	</object>" + Символы.ПС
	+ "	<object>" + Символы.ПС + "		<name>DataProcessor.Обр</name>" + Символы.ПС + "		<right><name>Use</name><value>true</value></right>" + Символы.ПС + "	</object>" + Символы.ПС
	+ "	<object>" + Символы.ПС + "		<name>DataProcessor.Обр.Command.Открыть</name>" + Символы.ПС + "		<right><name>View</name><value>true</value></right>" + Символы.ПС + "	</object>" + Символы.ПС
	+ "</Rights>" + Символы.ПС);
Записать(ОбъединитьПути(БП, "Configuration.xml"), "<MetaDataObject/>");
// restored: типовой модуль справочника (доработка УП «МодульГ.Сделать()» ушла в расширение)
Записать(П(Восст, "Catalogs/Справ/Ext/ObjectModule.bsl"), "Процедура П()" + Символы.ПС + "	МодульБ.Сделать();" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);

Ч = ЗагрузитьСценарий(П(Корень, "src/ЧерновикРасширения.os"));
Ч.Инициализировать(ЗагрузитьСценарий(П(Корень, "src/РазборМетодов.os")), ЗагрузитьСценарий(П(Корень, "src/НастройкиСравнения.os")));
Объекты = Новый Соответствие;
Итог = Новый Структура("objects, noUuid, commands, forms", 0, 0, 0, 0);
Лог = Новый Массив;
Ч.ПеренестиОбъектыТолькоУп(УП, БП, Расш, Восст, Объекты, "УП_Доработки", Вых, Итог, Лог);

Решения = Новый Соответствие;
Ч_ = Новый ЧтениеJSON;
Ч_.ОткрытьФайл(ОбъединитьПути(Вых, "uponly_objects.json"));
Данные = ПрочитатьJSON(Ч_, Ложь);
Ч_.Закрыть();
Для Каждого Оп Из Данные.code Цикл
	Решения.Вставить(Оп.key, Оп.decision);
КонецЦикла;
Проверить(Решения.Получить("CommonModules\МодульА") = "moved", "МодульА без ссылок переносится");
Проверить(Решения.Получить("CommonModules\МодульБ") = "keep_main", "МодульБ (ссылка из типового модуля справочника) остаётся");
Проверить(Решения.Получить("CommonModules\МодульГ") = "moved", "МодульГ (ссылка только из доработки УП в типовом модуле) переносится");
Проверить(Решения.Получить("CommonModules\МодульВ") = "moved", "МодульВ (ссылка только из переносимого А) переносится");
Проверить(Решения.Получить("DataProcessors\Обр") = "moved", "обработка переносится (подсистема/роль/интерфейс чистятся)");
Проверить(Решения.Получить("Catalogs\Справ\Forms\ФормаУп") = "moved", "форма УП у типового переносится");
Проверить(Решения.Получить("Catalogs\Справ\Forms\ФормаВыбора") = "keep_main", "форма, на которую ссылается модуль менеджера, остаётся");

Проверить((Новый Файл(П(Расш, "CommonModules/МодульА/Ext/Module.bsl"))).Существует(), "модуль А скопирован в расширение");
ТМ = Прочитать(П(Расш, "CommonModules/МодульА.xml"));
Проверить(СтрНайти(ТМ, "aaaaaaaa-aaaa") = 0 И СтрНайти(ТМ, "<Name>МодульА</Name>") > 0, "у собственного объекта новый uuid, имя как в УП");
ТО = Прочитать(П(Расш, "DataProcessors/Обр.xml"));
Проверить(СтрНайти(ТО, "eeeeeeee-eeee") = 0, "uuid команды обработки заменён");
Проверить((Новый Файл(П(Расш, "Catalogs/Справ/Forms/ФормаУп/Ext/Form.xml"))).Существует(), "форма УП в заимствованном справочнике");
Проверить(Объекты.Получить("Catalog.Справ") <> Неопределено И Объекты.Получить("Catalog.Справ").Формы.Найти("ФормаУп") <> Неопределено, "справочник заимствован с формой");
Проверить(Объекты.Получить("CommonPicture.Картинка") <> Неопределено, "картинка формы заимствована");
Проверить(Объекты.Получить("CommonModule.МодульА") <> Неопределено И Объекты.Получить("CommonModule.МодульБ") = Неопределено, "в составе расширения только перенесённые модули");

ТК = Прочитать(ОбъединитьПути(Восст, "Configuration.xml"));
Проверить(СтрНайти(ТК, "<CommonModule>МодульА</CommonModule>") = 0 И СтрНайти(ТК, "<DataProcessor>Обр</DataProcessor>") = 0, "строки перенесённых удалены из Configuration.xml");
Проверить(СтрНайти(ТК, "<CommonModule>МодульБ</CommonModule>") > 0 И СтрНайти(ТК, "Version8_3_27") > 0, "остальное в Configuration.xml без изменений");
ТС = Прочитать(П(Восст, "Catalogs/Справ.xml"));
Проверить(СтрНайти(ТС, "<Form>ФормаУп</Form>") = 0 И СтрНайти(ТС, "<Form>ФормаВыбора</Form>") > 0, "из XML справочника убрана только перенесённая форма");
ТП = Прочитать(П(Восст, "Subsystems/Раздел.xml"));
Проверить(СтрНайти(ТП, "DataProcessor.Обр") = 0 И СтрНайти(ТП, "Catalog.Справ") > 0, "состав подсистемы restored очищен");
ТР = Прочитать(П(Расш, "Subsystems/Раздел.xml"));
Проверить(СтрНайти(ТР, "DataProcessor.Обр") > 0 И СтрНайти(ТР, "Adopted") > 0, "подсистема заимствована с перенесённой обработкой");
ТИ = Прочитать(П(Восст, "Subsystems/Раздел/Ext/CommandInterface.xml"));
Проверить(СтрНайти(ТИ, "Обр.Command") = 0 И СтрНайти(ТИ, "0:eeeeeeee") = 0 И СтрНайти(ТИ, "Catalog.Справ.StandardCommand") > 0, "командный интерфейс очищен");
ТПр = Прочитать(П(Восст, "Roles/Роль/Ext/Rights.xml"));
Проверить(СтрНайти(ТПр, "DataProcessor.Обр") = 0 И СтрНайти(ТПр, "Catalog.Справ") > 0, "права роли restored без перенесённой обработки");
ТПрР = Прочитать(П(Расш, "Roles/Роль/Ext/Rights.xml"));
Проверить(СтрНайти(ТПрР, "DataProcessor.Обр.Command.Открыть") > 0 И СтрНайти(ТПрР, "Catalog.Справ") = 0 И СтрНайти(ТПрР, "<setForNewObjects>false") > 0, "права перенесены в роль расширения");
Проверить(Объекты.Получить("Role.Роль") <> Неопределено И Объекты.Получить("Subsystem.Раздел") <> Неопределено, "роль и подсистема в составе расширения");
Удалённые = Прочитать(ОбъединитьПути(Вых, "uponly_removed_files.txt"));
Проверить(СтрНайти(Удалённые, "CommonModules\МодульА.xml") > 0 И СтрНайти(Удалённые, "Catalogs\Справ\Forms\ФормаУп.xml") > 0, "список файлов для удаления из папки загрузки");
Проверить(СтрНайти(Прочитать(ОбъединитьПути(Вых, "uponly_config_removed_lines.txt")), "<DataProcessor>Обр</DataProcessor>") > 0, "список строк Configuration.xml");

УдалитьФайлы(Вр);
Если Ошибок = 0 Тогда
	Сообщить("test_uponly: OK");
Иначе
	ВызватьИсключение "test_uponly: ошибок " + Ошибок;
КонецЕсли;
