// Юнит-тесты переноса различающихся сигнатур УП/БП в restored и УП_<Имя>.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Контракт = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "КонтрактМетода.os"));
Перенос = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПереносСигнатур.os"));
Перенос.Инициализировать(Разбор, Контракт);
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Ошибок = 0;

// 1. Пометить: разные сигнатуры
Мт = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"Ф", "Процедура", "changed",
	Т("Процедура Ф(А, Б, В = Ложь)|	Типовой = 1;|КонецПроцедуры"),
	Т("Процедура Ф(А, Б)|	Доработка = 1;|КонецПроцедуры"),
	"none", "manual", "", "Число параметров: 2 (УП) vs 3 (БП)");
Проверить(Перенос.Пометить(Мт,
	Т("Процедура Ф(А, Б, В = Ложь)|	Типовой = 1;|КонецПроцедуры"),
	Т("Процедура Ф(А, Б)|	Доработка = 1;|КонецПроцедуры")), "пометить разные сигнатуры");
Проверить(Перенос.ЭтоПеренос(Мт), "это перенос");
Проверить(СтрНайти(Мт.explain, "УП_Ф") > 0, "explain содержит УП_Ф: " + Мт.explain);

// одинаковые сигнатуры не помечаются
Мт2 = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"Г", "Процедура", "changed",
	Т("Процедура Г(А)|	А = 1;|КонецПроцедуры"),
	Т("Процедура Г(А)|	А = 2;|КонецПроцедуры"),
	"none", "manual", "", "");
Проверить(Не Перенос.Пометить(Мт2,
	Т("Процедура Г(А)|	А = 1;|КонецПроцедуры"),
	Т("Процедура Г(А)|	А = 2;|КонецПроцедуры")), "одинаковые сигнатуры");
Проверить(Не Перенос.ЭтоПеренос(Мт2), "не перенос");

// 2. restored: помеченный метод — тело БП, обычный ручной остаётся УП
М = Новый Структура("methods, sourceText", Новый Массив,
	Т("Процедура Ф(А, Б)|	Доработка = 1;|КонецПроцедуры||Процедура Р()|	РучнойУП = 1;|КонецПроцедуры|"));
М.methods.Добавить(Мт);
М.methods.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"Р", "Процедура", "changed",
	Т("Процедура Р()|	Типовой = 1;|КонецПроцедуры"),
	Т("Процедура Р()|	РучнойУП = 1;|КонецПроцедуры"),
	"none", "manual", "", ""));
В = Ч.ВосстановитьТекст(М);
Проверить(СтрНайти(В, "Типовой = 1;") > 0 И СтрНайти(В, "Процедура Ф(А, Б, В = Ложь)") > 0, "restored: сигнатура и тело БП: " + В);
Проверить(СтрНайти(В, "Доработка = 1;") = 0, "restored: нет тела УП у Ф");
Проверить(СтрНайти(В, "РучнойУП") > 0, "restored: обычный ручной метод оставлен");

// 3. Копия УП_ с #Если и Экспорт
Мт3 = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain, preprocPrefixSource, preprocSuffixSource",
	"Ф", "Процедура", "changed",
	Т("Процедура Ф(А, Б, В = Ложь)|	Типовой = 1;|КонецПроцедуры"),
	Т("Процедура Ф(А, Б)|	Доработка = 1;|КонецПроцедуры"),
	"none", "manual", "", "",
	"#Если Сервер Тогда", "#КонецЕсли");
Перенос.Пометить(Мт3, Мт3.vendorText, Мт3.sourceText);
Коп = Перенос.ТекстКопииУп(Мт3, "УП_");
Проверить(СтрНайти(Коп, "Процедура УП_Ф(А, Б)") > 0, "копия: имя и сигнатура УП: " + Коп);
Проверить(СтрНайти(Коп, "Доработка = 1;") > 0, "копия: тело УП");
Проверить(СтрНайти(Коп, "Экспорт") > 0, "копия: добавлен Экспорт");
Проверить(СтрНачинаетсяС(СокрЛ(Коп), "#Если Сервер Тогда"), "копия: обёртка #Если: " + Коп);
Проверить(СтрНайти(Коп, "#КонецЕсли") > 0, "копия: #КонецЕсли");

// 4. Перепись вызовов: УП — 3 обязательных, БП — 2.
//    Ф(1, 2, 3) только для УП → УП_Ф; Ф(1, 2) подходит БП — не трогаем.
СигУп3 = Перенос.РазобратьСигнатуру(Т("Процедура Ф(А, Б, В)|КонецПроцедуры"), "Ф");
СигБп2 = Перенос.РазобратьСигнатуру(Т("Процедура Ф(А, Б)|КонецПроцедуры"), "Ф");
Карта = Новый Соответствие;
Карта.Вставить("ф", Новый Структура("name, newName, path, sigUp, sigBp, kind, objectName",
	"Ф", "УП_Ф", "CommonModules\Тест\Ext\Module.bsl", СигУп3, СигБп2, "CommonModules", "Тест"));
ТекстВыз = Т("Процедура Р()|	Ф(1, 2);|	Ф(1, 2, 3);|	Модуль.Ф(1, 2, 3);|КонецПроцедуры");
Рез = Перенос.ПереписатьВызовы(ТекстВыз, Карта, Неопределено, Ложь);
Проверить(СтрНайти(Рез.Текст, Символы.Таб + "Ф(1, 2);") > 0, "2 аргумента (подходят БП) не переименованы: " + Рез.Текст);
Проверить(СтрНайти(Рез.Текст, "УП_Ф(1, 2, 3);") > 0, "3 аргумента переименованы в УП_Ф: " + Рез.Текст);
Проверить(Рез.count = 1, "ровно одна замена (без квалифицированного без карты): " + Рез.count);

// квалифицированный вызов
Квал = Новый Соответствие;
Квал.Вставить("тест.ф", Карта.Получить("ф"));
ТекстКв = Т("Процедура Р()|	Тест.Ф(1, 2, 3);|КонецПроцедуры");
РезК = Перенос.ПереписатьВызовы(ТекстКв, Неопределено, Квал, Ложь);
Проверить(СтрНайти(РезК.Текст, "Тест.УП_Ф(1, 2, 3);") > 0, "квалифицированный вызов: " + РезК.Текст);

// объявление не переписывается
ТекстОб = Т("Процедура Ф(А, Б, В)|	Возврат;|КонецПроцедуры");
РезО = Перенос.ПереписатьВызовы(ТекстОб, Карта, Неопределено, Ложь);
Проверить(СтрНайти(РезО.Текст, "Процедура Ф(А, Б, В)") > 0 И РезО.count = 0, "объявление не тронуто: " + РезО.Текст);

// только #Вставка
ТекстВст = Т("Процедура Р()|	Ф(1, 2, 3);|	#Вставка|	Ф(1, 2, 3);|	#КонецВставки|КонецПроцедуры");
РезВ = Перенос.ПереписатьВызовы(ТекстВст, Карта, Неопределено, Истина);
Проверить(СтрНайти(РезВ.Текст, "	Ф(1, 2, 3);") > 0, "вне вставки не тронуто: " + РезВ.Текст);
Проверить(СтрНайти(РезВ.Текст, "	УП_Ф(1, 2, 3);") > 0, "во вставке переименовано: " + РезВ.Текст);
Проверить(РезВ.count = 1, "одна замена во вставке: " + РезВ.count);

// вызов после Если/Возврат переписывается (это не объявление)
ТекстЕсли = Т("Функция Р()|	Если Тест.Ф(1, 2, 3) Тогда|	КонецЕсли;|	Возврат Тест.Ф(1, 2, 3);|КонецФункции");
РезЕ = Перенос.ПереписатьВызовы(ТекстЕсли, Неопределено, Квал, Истина);
Проверить(РезЕ.count = 0, "ТолькоВставки без #Вставка — без замен: " + РезЕ.count);
РезЕ = Перенос.ПереписатьВызовы(ТекстЕсли, Неопределено, Квал, Ложь);
Проверить(РезЕ.count = 2 И СтрНайти(РезЕ.Текст, "Если Тест.УП_Ф(1, 2, 3)") > 0 И СтрНайти(РезЕ.Текст, "Возврат Тест.УП_Ф(1, 2, 3)") > 0, "вызов после Если/Возврат: " + РезЕ.Текст);
ТекстНов = Т("Процедура Р()|	А = Новый Ф(1, 2, 3);|КонецПроцедуры");
Проверить(Перенос.ПереписатьВызовы(ТекстНов, Карта, Неопределено, Ложь).count = 0, "Новый Ф(...) — конструктор, не вызов");
// Ф(А,) — пропущенный последний аргумент считается
ТекстПр = "Ф(1, 2,)";
Проверить(Перенос.ПосчитатьАргументы(ТекстПр, 2, СтрДлина(ТекстПр)).argc = 3, "Ф(1, 2,) = 3 аргумента");
ТекстПр = "Ф()";
Проверить(Перенос.ПосчитатьАргументы(ТекстПр, 2, СтрДлина(ТекстПр)).argc = 0, "Ф() = 0 аргументов");

Если Ошибок = 0 Тогда
	Сообщить("OK test_signature_transfer");
Иначе
	Сообщить("FAILED test_signature_transfer: " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
