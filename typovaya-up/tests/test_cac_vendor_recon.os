Перем Ошибок, Корень, Син;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция БезХвоста(Знач С)
	Пока СтрДлина(С) > 0 Цикл
		Посл = КодСимвола(Прав(С, 1));
		Если Посл = 10 Или Посл = 13 Тогда
			С = Лев(С, СтрДлина(С) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция Норм(Знач С)
	С = СтрЗаменить(С, Символ(13) + Символ(10), Символы.ПС);
	С = СтрЗаменить(С, Символ(13), Символы.ПС);
	Возврат БезХвоста(С);
КонецФункции

Функция ПрочитатьФикстуру(Имя)
	Путь = ОбъединитьПути(ОбъединитьПути(Корень, "tests"), "fixtures");
	Путь = ОбъединитьПути(ОбъединитьПути(Путь, "cac_vendor"), Имя);
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Если С = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Норм(С);
КонецФункции

Процедура ПроверитьСлучай(Имя)
	Тип = ПрочитатьФикстуру(Имя + "_typ.bsl");
	Уп = ПрочитатьФикстуру(Имя + "_up.bsl");
	Пр = Син.ПредложитьХук(Тип, Уп);
	П(Пр.hook = "changeAndControl" Или Пр.hook = "changeAndControlFull", Имя + " hook=" + Пр.hook);
	Если Пр.hook <> "changeAndControl" И Пр.hook <> "changeAndControlFull" Тогда
		Возврат;
	КонецЕсли;
	База = Норм(Син.ВосстановитьБазовыйТекстТиповогоИзХука(Пр.hookBody));
	Если База <> Тип Тогда
		Сообщить("FAIL: " + Имя + " vendor != typovaya typLines="
			+ СтрРазделить(Тип, Символы.ПС, Истина).Количество()
			+ " reconLines=" + СтрРазделить(База, Символы.ПС, Истина).Количество());
		Ошибок = Ошибок + 1;
		ЛТ = СтрРазделить(Тип, Символы.ПС, Истина);
		ЛБ = СтрРазделить(База, Символы.ПС, Истина);
		М = ЛТ.Количество();
		Если ЛБ.Количество() < М Тогда
			М = ЛБ.Количество();
		КонецЕсли;
		Й = 0;
		Пока Й < М Цикл
			Если ЛТ[Й] <> ЛБ[Й] Тогда
				Сообщить("  first diff line " + (Й + 1));
				Возврат;
			КонецЕсли;
			Й = Й + 1;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Раз = ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "РазборМетодов.os"));
Син = ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "СинтезХуков.os"));
Син.Инициализировать(Раз, ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "БезопасностьПереноса.os")));
Ошибок = 0;
ПроверитьСлучай("student");
ПроверитьСлучай("sign");
ПроверитьСлучай("apptype");
ПроверитьСлучай("mark");
Если Ошибок = 0 Тогда
	Сообщить("OK: CAC vendor recon");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;