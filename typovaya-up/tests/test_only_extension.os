// --только-extension: restored не меняется (ни .bsl, ни Form.xml).

Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Exec(Стр)
	Код = 0;
	ЗапуститьПриложение(Стр, "", Истина, Код);
	Возврат Код;
КонецФункции

Функция СнимокКаталога(Кат)
	Р = Новый Соответствие;
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Кат, "*", Истина) Цикл
		Если Ф.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(Кат) + 2);
		Р.Вставить(Отн, СтрДлина(Новый ДвоичныеДанные(Ф.ПолноеИмя)));
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура СравнитьСнимки(До, После)
	Для Каждого КЗ Из До Цикл
		П(После.Получить(КЗ.Ключ) = КЗ.Значение, "unchanged " + КЗ.Ключ);
	КонецЦикла;
	П(После.Количество() = До.Количество(), "file count");
КонецПроцедуры

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Фикст = ОбъединитьПути(Каталог, "fixtures");
OUT = ОбъединитьПути(Каталог, "_only_ext_tmp");
Ошибок = 0;
Если (Новый Файл(OUT)).Существует() Тогда
	УдалитьФайлы(OUT);
КонецЕсли;

Гл = ОбъединитьПути(Корень, "src", "Главный.os");
БазАрг = " -и " + """" + ОбъединитьПути(Фикст, "UP") + """"
	+ " -п " + """" + ОбъединитьПути(Фикст, "BP") + """"
	+ " -н " + """" + ОбъединитьПути(Фикст, "merge.xml") + """"
	+ " --без-отчета -в " + """" + OUT + """";

П(Exec("oscript " + """" + Гл + """" + БазАрг) = 0, "полный прогон");
КатВс = ОбъединитьПути(OUT, "restored");
СнимокДо = СнимокКаталога(КатВс);

П(Exec("oscript " + """" + Гл + """" + БазАрг + " --только-extension") = 0, "only-extension run");
СнимокПосле = СнимокКаталога(КатВс);
СравнитьСнимки(СнимокДо, СнимокПосле);

Если Ошибок > 0 Тогда
	ЗавершитьРаботу(1);
КонецЕсли;
Сообщить("OK test_only_extension");