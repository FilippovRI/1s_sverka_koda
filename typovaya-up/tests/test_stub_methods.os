// Юнит-тесты: заглушки методов БП по логу CheckConfig основной (ЗаглушкиМетодовБп) и тело БП в restored.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Записать(Путь, Текст, BOM = Ложь)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, BOM).Записать(Путь);
КонецПроцедуры

Функция Прочитать(Путь)
	Т = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), "UTF-8");
	Если Лев(Т, 1) = Символ(65279) Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	Возврат Т;
КонецФункции

Функция Т(Строка)
	Возврат СтрЗаменить(Строка, "|", Символы.ПС);
КонецФункции

Ошибок = 0;
Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Зм = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ЗаглушкиМетодовБп.os"));
Зм.Инициализировать(ЗагрузитьСценарий(ОбъединитьПути(Каталог, "РазборМетодов.os")));

// пути модулей из лога
Проверить(Зм.ОтносительныйПуть("Справочник.Контрагенты.МодульОбъекта", "/") = "Catalogs/Контрагенты/Ext/ObjectModule.bsl", "путь модуля объекта");
Проверить(Зм.ОтносительныйПуть("ОбщийМодуль.А.Модуль", "/") = "CommonModules/А/Ext/Module.bsl", "путь общего модуля");
Проверить(Зм.ОтносительныйПуть("Документ.Д.Форма.ФормаДокумента.Форма", "/") = "Documents/Д/Forms/ФормаДокумента/Ext/Form/Module.bsl", "путь модуля формы");
Проверить(Зм.ОтносительныйПуть("Перечисление.П.МодульМенеджера", "/") = "Enums/П/Ext/ManagerModule.bsl", "путь модуля менеджера");

// разбор лога: строки расширения пропускаются, повторы (Сервер/Внешнее соединение) схлопываются
Лог = "{Справочник.К.МодульОбъекта(4,6)}: Переменная не определена (ИсторияКПП)" + Символы.ПС
	+ "	Если <<?>>ИсторияКПП.Количество() = 1 Тогда (Проверка: Сервер)" + Символы.ПС
	+ "{Справочник.К.МодульОбъекта(4,6)}: Переменная не определена (ИсторияКПП)" + Символы.ПС
	+ "{Справочник.К.МодульОбъекта(17,2)}: Процедура или функция с указанным именем не определена (ЕстьУп)" + Символы.ПС
	+ "{УП_Доработки Справочник.К.МодульОбъекта(3,2)}: Процедура или функция с указанным именем не определена (Х)" + Символы.ПС
	+ "{Справочник.К.МодульОбъекта(20,1)}: Переменная не определена (ВнеМетода)" + Символы.ПС;
Ош = Зм.ОшибкиОсновнойИзЛога(Лог);
Проверить(Ош.Количество() = 3, "ошибок основной 3, а не " + Ош.Количество());

Тмп = ПолучитьИмяВременногоФайла("stubm");
СоздатьКаталог(Тмп);
Бп = ОбъединитьПути(Тмп, "BP"); Вс = ОбъединитьПути(Тмп, "restored"); Пр = ОбъединитьПути(Тмп, "load"); Рс = ОбъединитьПути(Тмп, "extension");
Отн = "Catalogs/К/Ext/ObjectModule.bsl";
ТекстБп = Т("#Если Сервер Тогда||&НаСервере|Функция Проверка(Знач А,|		Б = 1) Экспорт|	Если ИсторияКПП.Количество() = 1 Тогда|		Возврат 1;|	КонецЕсли;|	Возврат 0;|КонецФункции||Процедура Другая()|	А = 1;|КонецПроцедуры||Процедура СКодомУп()|	ЕстьУп();|КонецПроцедуры||#КонецЕсли|");
// в каталоге проверки СКодомУп — тело УП (не равно БП): не глушится
ТекстПр = СтрЗаменить(ТекстБп, "	ЕстьУп();", "	ЕстьУп(1);");
Записать(ОбъединитьПути(Бп, Отн), ТекстБп);
Записать(ОбъединитьПути(Вс, Отн), СтрЗаменить(ТекстБп, Символы.ПС, Символы.ВК + Символы.ПС));
Записать(ОбъединитьПути(Пр, Отн), ТекстПр);
Хук = Т("&ИзменениеИКонтроль(""Проверка"")|Функция УП_Проверка(Знач А,|		Б = 1)|	#Вставка|	Если А = 2 Тогда|		Возврат 2;|	КонецЕсли;|	#КонецВставки|	Если ИсторияКПП.Количество() = 1 Тогда|		Возврат 1;|	КонецЕсли;|#Удаление|	Возврат 0;|#КонецУдаления|#Вставка|	Возврат 3;|#КонецВставки|КонецФункции|");
Записать(ОбъединитьПути(Рс, Отн), Хук, Истина);

Отбор = Зм.Отобрать(Ош, Пр, Бп);
Проверить(Отбор.items.Количество() = 1, "отобран 1 метод, а не " + Отбор.items.Количество());
Если Отбор.items.Количество() = 1 Тогда
	Проверить(Отбор.items[0].method = "Проверка", "отобран метод Проверка");
	Проверить(Отбор.items[0].reasons[0] = "Переменная не определена (ИсторияКПП)", "причина из лога");
КонецЕсли;
Проверить(Отбор.skipped.Количество() = 2, "пропусков 2 (код УП, вне методов), а не " + Отбор.skipped.Количество());

Ит = Зм.Применить(Отбор, Вс, Бп, Рс);
Проверить(Ит.stubbed = 1 И Ит.hooksRewritten = 1, "заглушено 1, хуков 1: " + Ит.stubbed + "/" + Ит.hooksRewritten);
Р = СтрЗаменить(Прочитать(ОбъединитьПути(Вс, Отн)), Символы.ВК, "");
Ожид = Т("#Если Сервер Тогда||&НаСервере|Функция Проверка(Знач А,|		Б = 1) Экспорт|	" + Зм.Маркер() + "|	Возврат Неопределено;|КонецФункции||Процедура Другая()|");
Проверить(СтрНайти(Р, Ожид) = 1, "restored: сигнатура, директива и обёртка БП, тело-заглушка");
Проверить(СтрНайти(Р, "Процедура СКодомУп()" + Символы.ПС + "	ЕстьУп();") > 0, "метод вне отбора не тронут");
Проверить(СтрНайти(Прочитать(ОбъединитьПути(Вс, Отн)), Символы.ВК + Символы.ПС) > 0, "CRLF сохранён");
Х = Прочитать(ОбъединитьПути(Рс, Отн));
ОжидХ = Т("&ИзменениеИКонтроль(""Проверка"")|Функция УП_Проверка(Знач А,|		Б = 1)|#Вставка|	Если А = 2 Тогда|		Возврат 2;|	КонецЕсли;|	Если ИсторияКПП.Количество() = 1 Тогда|		Возврат 1;|	КонецЕсли;|	Возврат 3;|#КонецВставки|	" + Зм.Маркер() + "|	Возврат Неопределено;|КонецФункции");
Проверить(СтрНайти(Х, ОжидХ) = 1, "хук ИиК: доработка УП в #Вставка, затем тело заглушки");
Ит2 = Зм.Применить(Отбор, Вс, Бп, Рс);
Проверить(Ит2.stubbed = 0 И Ит2.already = 1 И Ит2.hooksRewritten = 0, "повторное применение идемпотентно");
УдалитьФайлы(Тмп);

// ЧерновикРасширения: с выгрузкой БП тело УП в restored не оставляется
Проверить(СтрНайти(Прочитать(ОбъединитьПути(Каталог, "ЧерновикРасширения.os")), "ТелоБпВсегда = ОбщиеМодулиБп.Количество() > 0;") > 0, "флаг ТелоБпВсегда");

Если Ошибок > 0 Тогда
	Сообщить("test_stub_methods: ошибок " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
Сообщить("OK: stub methods");
