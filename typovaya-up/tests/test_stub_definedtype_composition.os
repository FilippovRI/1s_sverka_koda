// Регрессия: Применить не падает, если ДобавитьСоставМетаданныхВОбъекты
// добавляет объект в Собр.objects при обходе (DefinedType → Catalog по составу).
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Зап(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "_stub_dt_comp_tmp");
Если (Новый Файл(Корень)).Существует() Тогда
	УдалитьФайлы(Корень);
КонецЕсли;
Бп = ОбъединитьПути(Корень, "bp");
Уп = ОбъединитьПути(Корень, "up");
Осн = ОбъединитьПути(Корень, "main");
СоздатьКаталог(Бп);
СоздатьКаталог(Уп);
СоздатьКаталог(Осн);

Конф = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Configuration><ChildObjects></ChildObjects></Configuration>";
Зап(ОбъединитьПути(Бп, "Configuration.xml"), Конф);
Зап(ОбъединитьПути(Уп, "Configuration.xml"), Конф);
Зап(ОбъединитьПути(Осн, "Configuration.xml"), Конф);

Зап(ОбъединитьПути(Бп, "Catalogs/ВложСправ.xml"), "<?xml version=""1.0""?><MetaDataObject><Catalog uuid=""c1"">"
	+ "<Properties><Name>ВложСправ</Name></Properties><ChildObjects/></Catalog></MetaDataObject>");

ТипУп = "<?xml version=""1.0""?><MetaDataObject><DefinedType uuid=""dt-1"">" + Символы.ПС
	+ "<Properties><Name>ТипСоСправом</Name>" + Символы.ПС
	+ "<Type><v8:Type>cfg:CatalogRef.ВложСправ</v8:Type></Type></Properties></DefinedType></MetaDataObject>";
Зап(ОбъединитьПути(Уп, "DefinedTypes/ТипСоСправом.xml"), ТипУп);

Форм = ОбъединитьПути(Осн, "CommonForms/Ф/Ext/Form.xml");
СоздатьКаталог((Новый Файл(Форм)).Путь);
Зап(Форм, "<?xml version=""1.0""?><Form><Attributes><Attribute name=""A"">"
	+ "<Type><v8:Type>cfg:DefinedType.ТипСоСправом</v8:Type></Type></Attribute></Attributes></Form>");

Ошибок = 0;
Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ЗаготовкиОбъектовБп.os"));
Лог = Новый Массив;
Р = Заг.Применить(Осн, Бп, Лог, "", Уп);
П((Новый Файл(ОбъединитьПути(Осн, "DefinedTypes/ТипСоСправом.xml"))).Существует(), "DefinedType full");
П((Новый Файл(ОбъединитьПути(Осн, "Catalogs/ВложСправ.xml"))).Существует(), "состав: каталог из замыкания");
П(Р.full >= 1, "full count");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_stub_definedtype_composition";
КонецЕсли;
Сообщить("OK: test_stub_definedtype_composition");