// Юнит-тесты черновика расширения.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Функция Мт(Имя, Вид, Статус, Пост, Исх, Хук, Решение, Тело)
	Возврат Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
		Имя, Вид, Статус, Пост, Исх, Хук, Решение, Тело, "");
КонецФункции

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Ошибок = 0;

Пост = Т("&НаСервере|Функция Ф(А,|	Б) Экспорт|	Возврат А;|КонецФункции");
Исх = Т("&НаСервере|Функция Ф(А,|	Б) Экспорт|	Х = 1;|	Возврат А;|КонецФункции");
Р = Ч.ОтрисоватьМетод("УП_", Мт("Ф", "Функция", "changed", Пост, Исх, "instead", "auto", "Х = 1;|Возврат А;"));
Проверить(СтрНачинаетсяС(Р, "&Вместо(""Ф"")" + Символы.ПС + "Функция УП_Ф(А," + Символы.ПС + "	Б) Экспорт"), "instead header: " + Р);
Проверить(СтрНайти(Р, "ПродолжитьВызов();") = 0, "instead без безусловного ПродолжитьВызов");
Проверить(СтрНайти(Р, "&НаСервере") = 0, "instead без директивы типового");

Р = Ч.ОтрисоватьМетод("УП_", Мт("П", "Процедура", "changed", "Процедура П()|КонецПроцедуры", "", "before", "auto", "А = 1;"));
Проверить(СтрНайти(Р, "&Перед(""П"")" + Символы.ПС + "Процедура УП_П()") = 1, "before: " + Р);
Р = Ч.ОтрисоватьМетод("УП_", Мт("П", "Процедура", "changed", "Процедура П()|КонецПроцедуры", "", "after", "auto", "А = 1;"));
Проверить(СтрНайти(Р, "&После(""П"")") = 1, "after");
Р = Ч.ОтрисоватьМетод("УП_", Мт("П", "Процедура", "changed", "Процедура П()|КонецПроцедуры", "", "changeAndControl", "auto", "#Вставка|А = 1;|#КонецВставки"));
Проверить(СтрНайти(Р, "&ИзменениеИКонтроль(""П"")" + Символы.ПС + "Процедура УП_П()") = 1, "CAC");

Р = Ч.ОтрисоватьМетод("УП_", Мт("Нов", "Процедура", "added", "", Т("&НаКлиенте|Процедура Нов(Х) Экспорт|	Нов2 = 1;|КонецПроцедуры"), "newMethod", "auto", ""));
Проверить(Р = Т("&НаКлиенте|Процедура УП_Нов(Х) Экспорт|	Нов2 = 1;|КонецПроцедуры"), "newMethod: " + Р);

Проверить(Не Ч.ИдётВРасширение(Мт("М", "Процедура", "changed", "", "", "none", "manual", "")), "manual не пишется");
Проверить(Не Ч.ИдётВРасширение(Мт("М", "Процедура", "removed", "", "", "none", "manual", "")), "removed не пишется");
Проверить(Не Ч.ИдётВРасширение(Мт("М", "Процедура", "same", "", "", "none", "skip", "")), "same не пишется");

// Восстановление: ручной метод остаётся как в УП, хук -> типовой, новый удаляется.
М = Новый Структура("methods, sourceText", Новый Массив,
	Т("Перем МВ;||Процедура А()|	Доп = 1;|	А = 1;|КонецПроцедуры||Процедура Р()|	РучнойУП = 1;|КонецПроцедуры||Процедура Нов()|	Н = 1;|КонецПроцедуры|"));
М.methods.Добавить(Мт("А", "Процедура", "changed", Т("Процедура А()|	А = 1;|КонецПроцедуры"), "", "before", "auto", "Доп = 1;"));
М.methods.Добавить(Мт("Р", "Процедура", "changed", Т("Процедура Р()|	Типовой = 1;|КонецПроцедуры"), "", "none", "manual", ""));
М.methods.Добавить(Мт("Нов", "Процедура", "added", "", "", "newMethod", "auto", ""));
В = Ч.ВосстановитьТекст(М);
Проверить(СтрНайти(В, "Доп = 1;") = 0 И СтрНайти(В, "	А = 1;") > 0, "restored: типовое тело: " + В);
Проверить(СтрНайти(В, "Нов") = 0, "restored: нет нового метода");
Проверить(СтрНайти(В, "РучнойУП") > 0 И СтрНайти(В, "Перем МВ;") > 0, "restored: ручное оставлено");

// Удалённый в УП метод с вызовом — тело БП остаётся в restored.
М2 = Новый Структура("path, methods, sourceText",
	"Catalogs\\Тест\\Ext\\ObjectModule.bsl", Новый Массив,
	Т("Процедура Рабочая()|	Старая();|КонецПроцедуры|"));
М2.methods.Добавить(Мт("Рабочая", "Процедура", "same", "", "", "none", "skip", ""));
М2.methods.Добавить(Мт("Старая", "Процедура", "removed",
	Т("Процедура Старая()|	Типовой = 1;|КонецПроцедуры"), "", "none", "manual", ""));
В2 = Ч.ВосстановитьТекст(М2);
Проверить(СтрНайти(В2, "Старая();") > 0 И СтрНайти(В2, "Типовой = 1;") > 0, "restored: vendor removed with call");

Если Ошибок = 0 Тогда
	Сообщить("OK: черновик расширения");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
