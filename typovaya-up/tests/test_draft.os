// Юнит-тесты черновика расширения.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Функция Мт(Имя, Вид, Статус, Пост, Исх, Хук, Решение, Тело)
	Возврат Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
		Имя, Вид, Статус, Пост, Исх, Хук, Решение, Тело, "");
КонецФункции

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Ошибок = 0;

Пост = Т("&НаСервере|Функция Ф(А,|	Б) Экспорт|	Возврат А;|КонецФункции");
Исх = Т("&НаСервере|Функция Ф(А,|	Б) Экспорт|	Х = 1;|	Возврат А;|КонецФункции");
Р = Ч.ОтрисоватьМетод("УП_", Мт("Ф", "Функция", "changed", Пост, Исх, "instead", "auto", "Х = 1;|Возврат А;"));
Проверить(СтрНачинаетсяС(Р, "&Вместо(""Ф"")" + Символы.ПС + "Функция УП_Ф(А," + Символы.ПС + "	Б) Экспорт"), "instead header: " + Р);
Проверить(СтрНайти(Р, "ПродолжитьВызов();") = 0, "instead без безусловного ПродолжитьВызов");
Проверить(СтрНайти(Р, "&НаСервере") = 0, "instead без директивы типового");

Р = Ч.ОтрисоватьМетод("УП_", Мт("П", "Процедура", "changed", "Процедура П()|КонецПроцедуры", "", "before", "auto", "А = 1;"));
Проверить(СтрНайти(Р, "&Перед(""П"")" + Символы.ПС + "Процедура УП_П()") = 1, "before: " + Р);
Р = Ч.ОтрисоватьМетод("УП_", Мт("П", "Процедура", "changed", "Процедура П()|КонецПроцедуры", "", "after", "auto", "А = 1;"));
Проверить(СтрНайти(Р, "&После(""П"")") = 1, "after");
Р = Ч.ОтрисоватьМетод("УП_", Мт("П", "Процедура", "changed", "Процедура П()|КонецПроцедуры", "", "changeAndControl", "auto", "#Вставка|А = 1;|#КонецВставки"));
Проверить(СтрНайти(Р, "&ИзменениеИКонтроль(""П"")" + Символы.ПС + "Процедура П()") = 1, "CAC: имя как в typovaya, без УП_");

Р = Ч.ОтрисоватьМетод("УП_", Мт("Нов", "Процедура", "added", "", Т("&НаКлиенте|Процедура Нов(Х) Экспорт|	Нов2 = 1;|КонецПроцедуры"), "newMethod", "auto", ""));
Проверить(Р = Т("&НаКлиенте|Процедура УП_Нов(Х) Экспорт|	Нов2 = 1;|КонецПроцедуры"), "newMethod: " + Р);

Проверить(Не Ч.ИдётВРасширение(Мт("М", "Процедура", "changed", "", "", "none", "manual", "")), "manual не пишется");
Проверить(Не Ч.ИдётВРасширение(Мт("М", "Процедура", "removed", "", "", "none", "manual", "")), "removed не пишется");
Проверить(Не Ч.ИдётВРасширение(Мт("М", "Процедура", "same", "", "", "none", "skip", "")), "same не пишется");

// Восстановление: ручной метод остаётся как в УП, хук -> типовой, новый удаляется.
М = Новый Структура("methods, sourceText", Новый Массив,
	Т("Перем МВ;||Процедура А()|	Доп = 1;|	А = 1;|КонецПроцедуры||Процедура Р()|	РучнойУП = 1;|КонецПроцедуры||Процедура Нов()|	Н = 1;|КонецПроцедуры|"));
М.methods.Добавить(Мт("А", "Процедура", "changed", Т("Процедура А()|	А = 1;|КонецПроцедуры"), "", "before", "auto", "Доп = 1;"));
М.methods.Добавить(Мт("Р", "Процедура", "changed", Т("Процедура Р()|	Типовой = 1;|КонецПроцедуры"), "", "none", "manual", ""));
М.methods.Добавить(Мт("Нов", "Процедура", "added", "", "", "newMethod", "auto", ""));
В = Ч.ВосстановитьТекст(М);
Проверить(СтрНайти(В, "Доп = 1;") = 0 И СтрНайти(В, "	А = 1;") > 0, "restored: типовое тело: " + В);
Проверить(СтрНайти(В, "Нов") = 0, "restored: нет нового метода");
Проверить(СтрНайти(В, "РучнойУП") > 0 И СтрНайти(В, "Перем МВ;") > 0, "restored: ручное оставлено");

// Удалённый в УП метод с вызовом — тело БП остаётся в restored.
М2 = Новый Структура("path, methods, sourceText",
	"Catalogs\\Тест\\Ext\\ObjectModule.bsl", Новый Массив,
	Т("Процедура Рабочая()|	Старая();|КонецПроцедуры|"));
М2.methods.Добавить(Мт("Рабочая", "Процедура", "same", "", "", "none", "skip", ""));
М2.methods.Добавить(Мт("Старая", "Процедура", "removed",
	Т("Процедура Старая()|	Типовой = 1;|КонецПроцедуры"), "", "none", "manual", ""));
В2 = Ч.ВосстановитьТекст(М2);
Проверить(СтрНайти(В2, "Старая();") > 0 И СтрНайти(В2, "Типовой = 1;") > 0, "restored: vendor removed with call");

// Транзитивно: возвращённое тело БП вызывает другой удалённый в УП метод.
М3 = Новый Структура("path, methods, sourceText",
	"Catalogs\\Тест\\Ext\\ObjectModule.bsl", Новый Массив,
	Т("Процедура Рабочая()|	Старая();|КонецПроцедуры|"));
М3.methods.Добавить(Мт("Рабочая", "Процедура", "same", "", "", "none", "skip", ""));
М3.methods.Добавить(Мт("Старая", "Процедура", "removed",
	Т("Процедура Старая()|	Глубже();|КонецПроцедуры"), "", "none", "manual", ""));
М3.methods.Добавить(Мт("Глубже", "Процедура", "removed",
	Т("Процедура Глубже()|	Дно = 1;|КонецПроцедуры"), "", "none", "manual", ""));
М3.methods.Добавить(Мт("Невызываемая", "Процедура", "removed",
	Т("Процедура Невызываемая()|	Лишнее = 1;|КонецПроцедуры"), "", "none", "manual", ""));
В3 = Ч.ВосстановитьТекст(М3);
Проверить(СтрНайти(В3, "Процедура Глубже()") > 0 И СтрЧислоВхождений(В3, "Процедура Старая()") = 1, "restored: транзитивный удалённый метод: " + В3);
Проверить(СтрНайти(В3, "Лишнее") > 0 И СтрЧислоВхождений(В3, "Процедура Глубже()") = 1, "restored: невызываемый удалённый тоже возвращается, без дублей: " + В3);
Проверить(Ч.ЧислоВозвращённых(М3) = 3, "restored: помечены возвращённые (3)");

// Позиция как в БП, табы байт в байт.
М4 = Новый Структура("path, methods, sourceText",
	"Catalogs\Тест\Ext\ObjectModule.bsl", Новый Массив,
	Т("Перем МВ;||Процедура Рабочая()|	Р = 1;|КонецПроцедуры||Процедура Последняя()|	П = 1;|КонецПроцедуры|"));
М4.methods.Добавить(Мт("Первая", "Процедура", "removed", Т("Процедура Первая()|	Если 1 Тогда|		А = 1;|	КонецЕсли;|КонецПроцедуры"), "", "none", "manual", ""));
М4.methods.Добавить(Мт("Рабочая", "Процедура", "same", "", "", "none", "skip", ""));
М4.methods.Добавить(Мт("Средняя", "Процедура", "removed", Т("Процедура Средняя()|	С = 1;|КонецПроцедуры"), "", "none", "manual", ""));
М4.methods.Добавить(Мт("Последняя", "Процедура", "same", "", "", "none", "skip", ""));
В4 = Ч.ВосстановитьТекст(М4);
П1 = СтрНайти(В4, "Процедура Первая()"); П2 = СтрНайти(В4, "Процедура Рабочая()");
П3 = СтрНайти(В4, "Процедура Средняя()"); П4 = СтрНайти(В4, "Процедура Последняя()");
Проверить(П1 > СтрНайти(В4, "Перем МВ;") И П1 < П2 И П2 < П3 И П3 < П4, "restored: порядок как в БП: " + В4);
Проверить(СтрНайти(В4, Символы.Таб + Символы.Таб + "А = 1;") > 0, "restored: табы сохранены");
Проверить(М4.methods[0].Свойство("returned") И Ч.ЧислоВозвращённых(М4) = 2, "restored: returned=2");

// restored строго как в БП: при заданной выгрузке БП модуль restored = текст модуля БП дословно
// (Перем и код вне методов БП, никаких строк/методов УП); неперенесённые правки УП учитываются отдельно.
КореньБп = ОбъединитьПути(КаталогВременныхФайлов(), "typovaya_up_test_bp_" + Формат(ТекущаяУниверсальнаяДатаВМиллисекундах(), "ЧГ="));
СоздатьКаталог(ОбъединитьПути(КореньБп, "Catalogs", "Тест", "Ext"));
ТекстБпМодуля = "Перем ДанныеКС;" + Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС
	+ "Процедура Рабочая()" + Символы.ВК + Символы.ПС + "	ДанныеКС = 1;" + Символы.ВК + Символы.ПС + "КонецПроцедуры" + Символы.ВК + Символы.ПС;
ДБп = ПолучитьДвоичныеДанныеИзСтроки(ТекстБпМодуля, КодировкаТекста.UTF8);
ДБп.Записать(ОбъединитьПути(ОбъединитьПути(КореньБп, "Catalogs", "Тест"), "Ext", "ObjectModule.bsl"));
М5 = Новый Структура("path, methods, sourceText", "Catalogs\Тест\Ext\ObjectModule.bsl", Новый Массив,
	Т("Перем МВ;||Процедура Рабочая()|	ЗаполнитьКлиентУП();|КонецПроцедуры||Процедура ЗаполнитьКлиентУП()|КонецПроцедуры|"));
М5.methods.Добавить(Мт("Рабочая", "Процедура", "changed", Т("Процедура Рабочая()|	ДанныеКС = 1;|КонецПроцедуры"),
	Т("Процедура Рабочая()|	ЗаполнитьКлиентУП();|КонецПроцедуры"), "none", "manual", ""));
М5.methods.Добавить(Мт("ЗаполнитьКлиентУП", "Процедура", "added", "", Т("Процедура ЗаполнитьКлиентУП()|КонецПроцедуры"), "newMethod", "auto", ""));
Ч.УстановитьКореньПоставщика("");
Проверить(Ч.ТекстМодуляБпДляRestored(М5) = Неопределено, "restored=БП: без выгрузки БП — старый режим");
Ч.УстановитьКореньПоставщика(КореньБп);
В5 = Ч.ТекстМодуляБпДляRestored(М5);
Проверить(В5 <> Неопределено И СтрНайти(В5, "Перем ДанныеКС;") = 1, "restored=БП: Перем БП сохранены: " + В5);
Проверить(В5 <> Неопределено И СтрНайти(В5, "УП") = 0 И СтрНайти(В5, "Перем МВ;") = 0, "restored=БП: нет кода УП: " + В5);
Проверить(В5 <> Неопределено И СтрНайти(В5, Символы.ВК) = 0 И Лев(В5, 1) <> Символ(65279), "restored=БП: без BOM/ВК");
Ч.УчестьНеПеренесённыеПравкиУп(М5);
НП = Ч.НеПеренесённыеПравкиУп();
Проверить(НП.Количество() = 1 И НП[0].method = "Рабочая", "restored=БП: ручная правка УП учтена (1), новый метод — нет");
Ч.УстановитьКореньПоставщика("");
УдалитьФайлы(КореньБп);

Если Ошибок = 0 Тогда
	Сообщить("OK: черновик расширения");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
