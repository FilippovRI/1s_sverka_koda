// ФрагментыИк: #Вставка/#Удаление только на границах целых операторов и блоков (Если, Для/Пока, Попытка),
// перестройка перехвата с неверным видом УП по методу УП, отказ — перехват убран и в todo.
Перем Ошибок;
Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Функция Строки(Т)
	Возврат СтрРазделить(Т, Символы.ПС, Истина);
КонецФункции
Функция Вид(М, Строки_, Тег)
	Р = Новый Массив;
	Для Каждого Э Из М.Разметить(Строки_) Цикл
		Если Э.Тег <> Тег Тогда Р.Добавить(Э.Стр); КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Р, Символы.ПС);
КонецФункции
// Каждый фрагмент результата: строки #Вставка и #Удаление сбалансированы по блокам (простая проверка по словам).
Функция ФрагментыЦелые(Строки_)
	Глуб = 0; В = Ложь;
	Для Каждого С Из Строки_ Цикл
		Т = НРег(СокрЛП(С));
		Если Т = "#вставка" Или Т = "#удаление" Тогда
			В = Истина; Глуб = 0;
		ИначеЕсли Т = "#конецвставки" Или Т = "#конецудаления" Тогда
			Если Глуб <> 0 Тогда Возврат Ложь; КонецЕсли;
			В = Ложь;
		ИначеЕсли В Тогда
			Если СтрНачинаетсяС(Т, "если ") Или СтрНачинаетсяС(Т, "для ") Или СтрНачинаетсяС(Т, "пока ") Или Т = "попытка" Тогда Глуб = Глуб + 1; КонецЕсли;
			Если СтрНачинаетсяС(Т, "конецесли") Или СтрНачинаетсяС(Т, "конеццикла") Или СтрНачинаетсяС(Т, "конецпопытки") Тогда Глуб = Глуб - 1; КонецЕсли;
			Если Глуб = 0 И (СтрНачинаетсяС(Т, "иначе") Или Т = "исключение") Тогда Возврат Ложь; КонецЕсли;
			Если Глуб < 0 Тогда Возврат Ложь; КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции
Процедура Проверить(М, Имя, Текст)
	Исх = Строки(Текст);
	Р = М.Нормализовать(Исх);
	П(Р <> Неопределено И Р.Изменён, Имя + ": граница расширена");
	Если Р = Неопределено Тогда Возврат; КонецЕсли;
	П(ФрагментыЦелые(Р.Строки), Имя + ": фрагменты — целые блоки: " + СтрСоединить(Р.Строки, " / "));
	П(Вид(М, Р.Строки, "I") = Вид(М, Исх, "I"), Имя + ": вид БП не изменился");
	П(Вид(М, Р.Строки, "D") = Вид(М, Исх, "D"), Имя + ": вид УП не изменился");
КонецПроцедуры
Ошибок = 0;
М = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ФрагментыИк.os"));
// Если: вставка открывает блок, КонецЕсли — в другой вставке
Проверить(М, "Если", "	А = 1;
|#Вставка
|	Если Условие Тогда
|#КонецВставки
|	Б = 2;
|#Вставка
|	КонецЕсли;
|#КонецВставки
|	В = 3;");
// Если: вставлена ветка Иначе без начала блока
Проверить(М, "Иначе", "	Если А Тогда
|		Б = 1;
|#Вставка
|	Иначе
|		Б = 2;
|#КонецВставки
|	КонецЕсли;");
// Для / Пока: цикл разорван
Проверить(М, "Для", "#Вставка
|	Для Каждого Стр Из Список Цикл
|#КонецВставки
|	Обработать(Стр);
|#Вставка
|	КонецЦикла;
|#КонецВставки
|	Готово = Истина;");
Проверить(М, "Пока", "#Удаление
|	Пока Выборка.Следующий() Цикл
|#КонецУдаления
|	Обработать(Выборка);
|#Удаление
|	КонецЦикла;
|#КонецУдаления
|	Готово = Истина;");
// Попытка: Исключение вне фрагмента начала
Проверить(М, "Попытка", "#Вставка
|	Попытка
|#КонецВставки
|	Выполнить();
|#Вставка
|	Исключение
|		Записать();
|	КонецПопытки;
|#КонецВставки
|	Готово = Истина;");
// оператор разорван посреди выражения
Проверить(М, "Оператор", "	Текст = СтрШаблон(
|#Удаление
|		""%1"",
|#КонецУдаления
|#Вставка
|		""%1 %2"", Б,
|#КонецВставки
|		А);");
// целый фрагмент не трогается
Р0 = М.Нормализовать(Строки("	А = 1;
|#Вставка
|	Если Б Тогда
|		В = 2;
|	КонецЕсли;
|#КонецВставки
|	Г = 3;"));
П(Р0 <> Неопределено И Не Р0.Изменён, "целый фрагмент без изменений");
// модуль: вид УП перехвата не совпадает с методом УП — перестройка; с битым методом УП — перехват убран, todo
Модуль = "&ИзменениеИКонтроль(""Мет"")
|Процедура УП_Мет()
|	Пока Выборка.Следующий() Цикл
|#Вставка
|		Если Роль Тогда
|#КонецВставки
|		Добавить();
|	КонецЦикла;
|	Если Новый Тогда
|		Х = 1;
|	КонецЕсли;
|#Вставка
|		КонецЕсли;
|#КонецВставки
|КонецПроцедуры
|";
Уп = "Процедура Мет()
|	Пока Выборка.Следующий() Цикл
|		Если Роль Тогда
|		Добавить();
|		КонецЕсли;
|	КонецЦикла;
|	Если Новый Тогда
|		Х = 1;
|	КонецЕсли;
|КонецПроцедуры
|";
Р = М.ОбработатьМодуль(Модуль, Уп, "CommonModules/Т/Ext/Module.bsl");
П(Р.Итог.rebuilt = 1 И Р.Текст <> Неопределено, "перестроен по методу УП");
Если Р.Текст <> Неопределено Тогда
	Тело = Новый Массив;
	Для Каждого С Из Строки(Р.Текст) Цикл
		Если Не СтрНачинаетсяС(С, "&") И Не СтрНачинаетсяС(С, "Процедура") И Не СтрНачинаетсяС(С, "КонецПроцедуры") И С <> "" Тогда Тело.Добавить(С); КонецЕсли;
	КонецЦикла;
	П(ФрагментыЦелые(Тело), "перестроенный: целые блоки");
	П(СтрНайти(Вид(М, Тело, "D"), "		Добавить();" + Символы.ПС + "		КонецЕсли;" + Символы.ПС + "	КонецЦикла;") > 0, "перестроенный: вид УП = метод УП");
	П(Вид(М, Тело, "I") = "	Пока Выборка.Следующий() Цикл" + Символы.ПС + "		Добавить();" + Символы.ПС + "	КонецЦикла;" + Символы.ПС
		+ "	Если Новый Тогда" + Символы.ПС + "		Х = 1;" + Символы.ПС + "	КонецЕсли;", "перестроенный: вид БП сохранён");
КонецЕсли;
// метод УП с незакрытым блоком: безопасно нельзя — перехват убран
Р2 = М.ОбработатьМодуль("&НаСервере" + Символы.ПС + Модуль + "Процедура Своя()" + Символы.ПС + "КонецПроцедуры", СтрЗаменить(Уп, "		КонецЕсли;" + Символы.ПС, ""), "CommonModules/Т/Ext/Module.bsl");
П(Р2.Итог.removed = 1 И Р2.Тудо.Количество() = 1, "битый — убран и в todo");
П(Р2.Текст <> Неопределено И СтрНайти(Р2.Текст, "УП_Мет") = 0 И СтрНайти(Р2.Текст, "&НаСервере") = 0 И СтрНайти(Р2.Текст, "Процедура Своя()") > 0, "битый: метод и директива убраны, остальное на месте");
// метод УП с «	КонецФункции» с отступом и следующим методом; УП_X из удаляемых строк — переименование в виде УП
Мод2 = "&ИзменениеИКонтроль(""Мет2"")
|Функция УП_Мет2()
|	Если Х Тогда
|#Удаление
|		УП_Подписать(А, Б);
|#КонецУдаления
|#Вставка
|			Б);
|#КонецВставки
|	КонецЕсли;
|	Возврат 1;
|КонецФункции
|";
Уп2 = "Функция Мет2()
|	Если Х Тогда
|		Подписать(А);
|	КонецЕсли;
|	Возврат 1;
|	КонецФункции
|
|Функция Другая()
|	Возврат 2;
|КонецФункции
|";
Р4 = М.ОбработатьМодуль(Мод2, Уп2, "CommonModules/Т/Ext/Module.bsl");
П(Р4.Итог.rebuilt = 1 И Р4.Текст <> Неопределено И СтрНайти(Р4.Текст, "		УП_Подписать(А);") > 0 И СтрНайти(Р4.Текст, "Другая") = 0
	И СтрНайти(Р4.Текст, "			Б);") = 0, "отступ КонецФункции в УП и УП_X из удаления: " + Р4.Текст);
// п.3: код формы (ЭтаФорма) в модуле объекта — невызываемый метод убирается в todo, вызываемый и перехват остаются
ПС_ = Символы.ПС;
Мо = "#Если Сервер Тогда" + ПС_ + "&НаКлиенте" + ПС_ + "Процедура УП_ПечатьУП(Команда)" + ПС_ + "	Р.ОткрытьФорму(ЭтаФорма);" + ПС_ + "КонецПроцедуры" + ПС_ + ПС_
	+ "Процедура УП_Вызываемая()" + ПС_ + "	Х = ЭтаФорма;" + ПС_ + "КонецПроцедуры" + ПС_ + ПС_
	+ "Процедура Другая()" + ПС_ + "	УП_Вызываемая();" + ПС_ + "	// УП_ПечатьУП();" + ПС_ + "КонецПроцедуры" + ПС_ + "#КонецЕсли";
Рф = М.УбратьКодФормы(Мо, "Reports/О/Ext/ObjectModule.bsl");
П(Рф.Текст <> Неопределено И СтрНайти(Рф.Текст, "УП_ПечатьУП(Команда)") = 0 И СтрНайти(Рф.Текст, "&НаКлиенте") = 0
	И СтрНайти(Рф.Текст, "Процедура УП_Вызываемая()") > 0 И СтрНайти(Рф.Текст, "#КонецЕсли") > 0 И Рф.Тудо.Количество() = 1, "код формы в модуле объекта: " + Рф.Текст);
П(М.УбратьКодФормы("Процедура А()" + ПС_ + "	Х = 1;" + ПС_ + "КонецПроцедуры", "x").Текст = Неопределено, "модуль без ЭтаФорма не меняется");
Если Ошибок > 0 Тогда ВызватьИсключение "test_hook_fragments"; КонецЕсли;
Сообщить("OK: test_hook_fragments");
