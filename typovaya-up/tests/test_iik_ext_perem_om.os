// Перем typovaya в модуль расширения; реквизиты Form.xml после финального текста;
// общий модуль БП в restored, либо todo если тянет документы/регистры.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда Р = ОбъединитьПути(Р, П3); КонецЕсли;
	Если П4 <> "" Тогда Р = ОбъединитьПути(Р, П4); КонецЕсли;
	Если П5 <> "" Тогда Р = ОбъединитьПути(Р, П5); КонецЕсли;
	Если П6 <> "" Тогда Р = ОбъединитьПути(Р, П6); КонецЕсли;
	Если П7 <> "" Тогда Р = ОбъединитьПути(Р, П7); КонецЕсли;
	Если П8 <> "" Тогда Р = ОбъединитьПути(Р, П8); КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция КонфXml()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21"">" + Символы.ПС
		+ "	<Configuration uuid=""00000000-0000-0000-0000-000000000001"">" + Символы.ПС
		+ "		<Properties><Name>Тест</Name></Properties>" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "			<CommonModule>УжеЕсть</CommonModule>" + Символы.ПС
		+ "		</ChildObjects>" + Символы.ПС
		+ "	</Configuration>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МодульXml(Имя)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21"">" + Символы.ПС
		+ "	<CommonModule uuid=""11111111-1111-1111-1111-111111111111"">" + Символы.ПС
		+ "		<Properties>" + Символы.ПС
		+ "			<Name>" + Имя + "</Name>" + Символы.ПС
		+ "			<Global>false</Global>" + Символы.ПС
		+ "			<Server>true</Server>" + Символы.ПС
		+ "			<ServerCall>true</ServerCall>" + Символы.ПС
		+ "		</Properties>" + Символы.ПС
		+ "	</CommonModule>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Кат = П(ТекущийСценарий().Каталог, "_iik_ext_perem_om_tmp");
Если (Новый Файл(Кат)).Существует() Тогда
	УдалитьФайлы(Кат);
КонецЕсли;
Модуль = ЗагрузитьСценарий(П(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));

ТекстТип = "Перем КонтекстЭДОКлиент, КонтекстУжеПодключался;" + Символы.ПС
	+ "Перем СоответствиеТекущийОтчет Экспорт;" + Символы.ПС
	+ "Перем НеИспользуетсяВРасш;" + Символы.ПС
	+ Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Процедура ПриОткрытии(Отказ)" + Символы.ПС
	+ "КонецПроцедуры";
ТекстРасш = "&НаКлиенте" + Символы.ПС
	+ "Процедура УП_Подключить()" + Символы.ПС
	+ "	Если КонтекстЭДОКлиент = Неопределено Тогда" + Символы.ПС
	+ "		КонтекстУжеПодключался = Истина;" + Символы.ПС
	+ "	КонецЕсли;" + Символы.ПС
	+ "КонецПроцедуры";
ТекстНов = Модуль.ДополнитьРасшПеремТиповогоМодуля(ТекстРасш, ТекстТип, "");
Проверить(СтрНайти(ТекстНов, "Перем КонтекстЭДОКлиент, КонтекстУжеПодключался;") > 0, "объявлены typovaya Перем, используемые расширением");
Проверить(СтрНайти(ТекстНов, "Перем СоответствиеТекущийОтчет") = 0, "неиспользуемый Перем не копируется");
Проверить(СтрНайти(ТекстНов, "Перем НеИспользуетсяВРасш;") = 0, "неиспользуемый Перем не копируется (2)");
ТекстПовтор = Модуль.ДополнитьРасшПеремТиповогоМодуля(ТекстНов, ТекстТип, "");
Проверить(СтрЧислоВхождений(ТекстПовтор, "Перем КонтекстЭДОКлиент, КонтекстУжеПодключался;") = 1, "повторно Перем не дублируются");

ТекстТипДир = "&НаСервере" + Символы.ПС
	+ "Перем КонтекстЭДОСервер Экспорт;" + Символы.ПС
	+ Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "// комментарий между директивой и Перем" + Символы.ПС
	+ "Перем КонтекстЭДОКлиент, КонтекстУжеПодключался;" + Символы.ПС
	+ Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Процедура ПриОткрытии(Отказ)" + Символы.ПС
	+ "	Перем ЛокальнаяНеМодульная;" + Символы.ПС
	+ "КонецПроцедуры";
ТекстРасшДир = "&НаКлиенте" + Символы.ПС
	+ "Процедура УП_Подключить()" + Символы.ПС
	+ "	КонтекстЭДОКлиент = Неопределено;" + Символы.ПС
	+ "	КонтекстУжеПодключался = Истина;" + Символы.ПС
	+ "	КонтекстЭДОСервер = Неопределено;" + Символы.ПС
	+ "	ЛокальнаяНеМодульная = 1;" + Символы.ПС
	+ "КонецПроцедуры";
ТекстДир = Модуль.ДополнитьРасшПеремТиповогоМодуля(ТекстРасшДир, ТекстТипДир, "");
Проверить(СтрНайти(ТекстДир, "&НаКлиенте" + Символы.ПС + "Перем КонтекстЭДОКлиент, КонтекстУжеПодключался;") > 0, "сохранена директива &НаКлиенте у Перем");
Проверить(СтрНайти(ТекстДир, "&НаСервере" + Символы.ПС + "Перем КонтекстЭДОСервер Экспорт;") > 0, "сохранена директива &НаСервере у Перем");
Проверить(СтрНайти(ТекстДир, "Перем ЛокальнаяНеМодульная") = 0, "локальный Перем процедуры не копируется");

// Form.xml: typovaya-реквизит, на который ссылается уже готовый модуль расширения.
Отн = П("CommonForms", "ТестФорма", "Ext", "Form.xml");
ТипК = П(Кат, "typ");
УпК = П(Кат, "up");
БпК = П(Кат, "bp");
ВосстК = П(Кат, "rest");
РасшК = П(Кат, "ext");
XmlФорма = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
	+ "	<Attributes>" + Символы.ПС
	+ "		<Attribute name=""МассоваяПроверкаОтчетов"" id=""49"">" + Символы.ПС
	+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "	<Commands/>" + Символы.ПС
	+ "	<ChildItems/>" + Символы.ПС
	+ "</Form>" + Символы.ПС;
Записать(П(ТипК, Отн), XmlФорма);
Записать(П(УпК, Отн), XmlФорма);
Записать(П(БпК, Отн), "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
	+ "	<Attributes/>" + Символы.ПС
	+ "	<Commands/>" + Символы.ПС
	+ "	<ChildItems/>" + Символы.ПС
	+ "</Form>" + Символы.ПС);
Записать(П(ВосстК, Отн), XmlФорма);
МодульИк = "&НаКлиенте" + Символы.ПС
	+ "Процедура ПроверитьВИнтернетеНачало()" + Символы.ПС
	+ "	Если МассоваяПроверкаОтчетов Тогда" + Символы.ПС
	+ "		Возврат;" + Символы.ПС
	+ "	КонецЕсли;" + Символы.ПС
	+ "КонецПроцедуры";
Н = Модуль.ДополнитьFormXmlРасшПоМодулю(П(ТипК, Отн), П(УпК, Отн), П(БпК, Отн), П(ВосстК, Отн), П(РасшК, Отн), МодульИк);
Проверить(Н > 0, "реквизит typovaya, на который ссылается модуль расширения, добавлен: " + Н);
ТФ = Новый ЧтениеТекста(П(РасшК, Отн), КодировкаТекста.UTF8);
ТекстФ = ТФ.Прочитать();
ТФ.Закрыть();
Проверить(СтрНайти(ТекстФ, "<Attribute name=""МассоваяПроверкаОтчетов""") > 0, "в Form.xml расширения есть МассоваяПроверкаОтчетов");

// Общий модуль БП без документов/регистров — добавляется в restored.
Осн = П(Кат, "rest_om");
Бп = П(Кат, "bp_om");
ИмяОм = "КалендарьОтчетностиБРОВызовСервераПереопределяемый";
Записать(П(Осн, "Configuration.xml"), КонфXml());
Записать(П(Бп, "Configuration.xml"), КонфXml());
Записать(П(Бп, "CommonModules", ИмяОм + ".xml"), МодульXml(ИмяОм));
Записать(П(Бп, "CommonModules", ИмяОм, "Ext", "Module.bsl"),
	"Процедура ПриСозданииФормыРегламентированнойОтчетности(ОбъектФормы) Экспорт" + Символы.ПС
	+ "КонецПроцедуры");
ТелоБп = "	" + ИмяОм + ".ПриСозданииФормыРегламентированнойОтчетности(ЭтотОбъект);";
Нет = Модуль.ОбщиеМодулиБпОтсутствующиеВRestored(ТелоБп, Осн, Бп);
Проверить(Нет.Количество() = 1 И Нет[0] = ИмяОм, "обнаружен отсутствующий общий модуль БП");
Прич = Модуль.ОбеспечитьОбщиеМодулиБпВRestored(Нет, Бп, Осн);
Проверить(Прич = "", "безопасный общий модуль добавлен: " + Прич);
Проверить((Новый Файл(П(Осн, "CommonModules", ИмяОм + ".xml"))).Существует(), "xml общего модуля в restored");
ТК = Новый ЧтениеТекста(П(Осн, "Configuration.xml"), КодировкаТекста.UTF8);
ТекстК = ТК.Прочитать();
ТК.Закрыть();
Проверить(СтрНайти(ТекстК, "<CommonModule>" + ИмяОм + "</CommonModule>") > 0, "модуль зарегистрирован в Configuration.xml");

// Модуль, тянущий отсутствующий документ — не добавляем.
ИмяПлох = "МодульСДокументомБп";
Осн2 = П(Кат, "rest_om2");
Бп2 = П(Кат, "bp_om2");
Записать(П(Осн2, "Configuration.xml"), КонфXml());
Записать(П(Бп2, "Configuration.xml"), КонфXml());
Записать(П(Бп2, "CommonModules", ИмяПлох + ".xml"), МодульXml(ИмяПлох));
Записать(П(Бп2, "CommonModules", ИмяПлох, "Ext", "Module.bsl"),
	"Процедура ВыполнитьДействие() Экспорт" + Символы.ПС
	+ "	Док = Документы.Анкета.СоздатьДокумент();" + Символы.ПС
	+ "КонецПроцедуры");
ИменаПлох = Новый Массив;
ИменаПлох.Добавить(ИмяПлох);
Прич2 = Модуль.ОбеспечитьОбщиеМодулиБпВRestored(ИменаПлох, Бп2, Осн2);
Проверить(СтрНайти(Прич2, "документов/регистров") > 0, "модуль с документом в todo: " + Прич2);
Проверить(Не (Новый Файл(П(Осн2, "CommonModules", ИмяПлох + ".xml"))).Существует(), "плохой модуль не скопирован");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_ext_perem_om");
Иначе
	Сообщить("FAILED test_iik_ext_perem_om: " + Ошибок);
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));
