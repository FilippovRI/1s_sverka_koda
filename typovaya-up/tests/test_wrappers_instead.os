Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция Т(З) Возврат СтрЗаменить(З, "|", Символы.ПС); КонецФункции

Функция КаталогТеста()
	К = ОбъединитьПути(КаталогВременныхФайлов(), "typovaya-up-wrappers");
	УдалитьКаталогТихо(К);
	СоздатьКаталог(К);
	СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(К, "extension"), "CommonModules"), "Мод"), "Ext"));
	СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(К, "restored"), "CommonModules"), "Мод"), "Ext"));
	Возврат К;
КонецФункции

Процедура УдалитьКаталогТихо(К)
	Ф = Новый Файл(К);
	Если Ф.Существует() Тогда
		УдалитьФайлы(К);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьМодуль(КореньВыхода, Ветка, Текст)
	Путь = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньВыхода, Ветка), "CommonModules"), "Мод"), "Ext"), "Module.bsl");
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Функция ПрочитатьМодуль(КореньВыхода, Ветка)
	Путь = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньВыхода, Ветка), "CommonModules"), "Мод"), "Ext"), "Module.bsl");
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Ткст = Ч.Прочитать();
	Ч.Закрыть();
	Возврат Ткст;
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "РазборМетодов.os"));
Доз = ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Ошибок = 0;

Восст = Т("&НаСервере|Процедура Публичная() Экспорт|	А = 1;|КонецПроцедуры||"
	+ "Процедура Тайная()|	Возврат;|КонецПроцедуры||"
	+ "Процедура Много(|	Знач А,|	Б = 0)|	Возврат;|КонецПроцедуры||"
	+ "Функция СКомментарием() // хвост|	Возврат 1;|КонецФункции||"
	+ "Процедура УжеХук()|	Возврат;|КонецПроцедуры||"
	+ "Процедура НеВызывают()|	Возврат;|КонецПроцедуры");
Расш = Т("&ИзменениеИКонтроль(""Хук"")|Процедура УП_Хук() Экспорт|"
	+ "	Тайная();|	СКомментарием();|#Удаление|	Публичная();|#КонецУдаления|"
	+ "#Вставка|	Много(1, 2);|#КонецВставки|КонецПроцедуры||"
	+ "&ИзменениеИКонтроль(""УжеХук"")|Процедура УП_УжеХук()|	УжеХук();|КонецПроцедуры");

К = КаталогТеста();
ЗаписатьМодуль(К, "restored", Восст);
ЗаписатьМодуль(К, "extension", Расш);
ВосстДо = ПрочитатьМодуль(К, "restored");
Р = Доз.ОбработатьОбёрткиВместо(К, "УП_");
П(Р.count = 3, "count=3 (Тайная, Много, СКомментарием), got " + Р.count);
Имена = "";
Для Каждого Э Из Р.items Цикл
	Имена = Имена + "," + Э.name;
КонецЦикла;
П(СтрНайти(Имена, "Тайная") > 0, "item Тайная");
П(СтрНайти(Имена, "Много") > 0, "item Много");
П(СтрНайти(Имена, "СКомментарием") > 0, "item СКомментарием");
П(СтрНайти(Имена, "Публичная") = 0, "Публичная exported — no wrapper");
П(СтрНайти(Имена, "УжеХук") = 0, "УжеХук already has hook");
П(СтрНайти(Имена, "НеВызывают") = 0, "НеВызывают not called");
П(ПрочитатьМодуль(К, "restored") = ВосстДо, "restored unchanged");

Н = ПрочитатьМодуль(К, "extension");
П(СтрНайти(Н, "&Вместо(""Тайная"")") > 0, "directive Тайная");
П(СтрНайти(Н, "Процедура УП_Тайная()") > 0, "name УП_Тайная");
П(СтрНайти(Н, "ПродолжитьВызов()") > 0, "ПродолжитьВызов()");
П(СтрНайти(Н, "Процедура УП_Много(") > 0, "name УП_Много");
П(СтрНайти(Н, "ПродолжитьВызов(А, Б)") > 0, "params А, Б (Знач and default stripped)");
П(СтрНайти(Н, "Функция УП_СКомментарием()") > 0, "function name");
П(СтрНайти(Н, "Возврат ПродолжитьВызов()") > 0, "return continue");
П(СтрНайти(Н, "&Вместо(""УжеХук"")") = 0, "no wrapper for existing hook");
П((Новый Файл(ОбъединитьПути(К, "wrappers_added.json"))).Существует(), "json written");
Р2 = Доз.ОбработатьОбёрткиВместо(К, "УП_");
П(Р2.count = 0, "idempotent second run, got " + Р2.count);

УдалитьКаталогТихо(К);
Если Ошибок = 0 Тогда Сообщить("OK: wrappers instead"); Иначе ЗавершитьРаботу(1); КонецЕсли;