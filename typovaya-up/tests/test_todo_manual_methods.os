// TodoРучныеМетоды: методы УП в модулях manual без хука → todo_manual_methods (маркер УП отдельно).
Перем Ошибок;
Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Ошибок = 0;
ПС = Символы.ПС;
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_todo_manual_" + Строка(Новый УникальныйИдентификатор));
Расш = ОбъединитьПути(Вр, "extension");
Восст = ОбъединитьПути(Вр, "restored");
Бп = "Процедура А()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС + "Процедура Б()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура В()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС + "Процедура Г()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС;
Уп = "Процедура А()" + ПС + "	Х = 1; // комментарий" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Б()" + ПС + "	// УП_начало" + ПС + "	Возврат;" + ПС + "	// УП_конец" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура В()" + ПС + "	Х = 2;" + ПС + "КонецПроцедуры" + ПС + "Процедура Г()" + ПС + "	Х = 3;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Д()" + ПС + "КонецПроцедуры" + ПС + "Процедура Е()" + ПС + "	Х = 5;" + ПС + "КонецПроцедуры" + ПС;
Путь = "Documents/Док/Ext/ObjectModule.bsl";
// Г покрыт аннотацией, Д — копией УП_Д, Е — текст УП в restored
Зап(ОбъединитьПути(Расш, Путь), "&ИзменениеИКонтроль(""Г"")" + ПС + "Процедура Расш_Г()" + ПС + "КонецПроцедуры" + ПС + "Процедура УП_Д()" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Восст, Путь), "Процедура Е()" + ПС + "	Х = 5;" + ПС + "КонецПроцедуры" + ПС);
Модули = Новый Массив;
Модули.Добавить(Новый Структура("path, bucket, sourceText, vendorText, object", "Documents\Док\Ext\ObjectModule.bsl", "manual", Уп, Бп, "Document.Док"));
Модули.Добавить(Новый Структура("path, bucket, sourceText, vendorText, object", "Documents\Авто\Ext\ObjectModule.bsl", "auto", Уп, Бп, "Document.Авто"));
М = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "TodoРучныеМетоды.os"));
Лог = Новый Массив;
Р = М.Записать(Модули, Расш, Восст, Вр, Лог);
Csv = Чит(ОбъединитьПути(Вр, "todo_manual_methods.csv"));
П(Р.methods = 2 И Р.marked = 1 И Р.modules = 1, "методов " + Р.methods + ", с маркером " + Р.marked);
П(СтрНайти(Csv, "Document.Док;Documents/Док/Ext/ObjectModule.bsl;Б;4;изменён;да") > 0, "Б с маркером первым: " + Csv);
П(СтрНайти(Csv, "Document.Док;Documents/Док/Ext/ObjectModule.bsl;В;10;изменён;нет") > 0, "В без маркера");
П(СтрНайти(Csv, ";А;") = 0 И СтрНайти(Csv, ";Г;") = 0 И СтрНайти(Csv, ";Д;") = 0 И СтрНайти(Csv, ";Е;") = 0 И СтрНайти(Csv, "Авто") = 0, "покрытые/одинаковые/auto не в todo");
П(СтрНайти(Csv, ";Б;") < СтрНайти(Csv, ";В;"), "маркер УП — первыми");
УдалитьФайлы(Вр);
Если Ошибок > 0 Тогда ВызватьИсключение "test_todo_manual_methods"; КонецЕсли;
Сообщить("OK: test_todo_manual_methods");
