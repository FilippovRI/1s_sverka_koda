// Юнит-тесты: необязательные параметры БП, арность вызовов, контекстная проверка неразрешённых вызовов,
// отсутствие двойного префикса УП_УП_.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Процедура Записать(Корень, Отн, Текст)
	Путь = ОбъединитьПути(Корень, Отн);
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Зп = Новый ЗаписьТекста(Путь, "UTF-8");
	Зп.Записать(Текст);
	Зп.Закрыть();
КонецПроцедуры

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Контракт = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "КонтрактМетода.os"));
Перенос = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПереносСигнатур.os"));
Перенос.Инициализировать(Разбор, Контракт);
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Арн = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПроверкаАрности.os"));
Арн.Инициализировать(Разбор, Контракт, Перенос);
Ошибок = 0;

// 1. БП только дописала необязательные параметры
Проверить(Перенос.ТолькоДобавленыНеобязательные(Т("Процедура Ф(А, Б = 1, В = Ложь) Экспорт|КонецПроцедуры"),
	Т("Процедура Ф(А, Б = 1) Экспорт|КонецПроцедуры")), "необязательный параметр в конце -> истина");
Проверить(Не Перенос.ТолькоДобавленыНеобязательные(Т("Процедура Ф(А, Б, В) Экспорт|КонецПроцедуры"),
	Т("Процедура Ф(А, Б) Экспорт|КонецПроцедуры")), "обязательный новый параметр -> ложь");
Проверить(Не Перенос.ТолькоДобавленыНеобязательные(Т("Процедура Ф(Б, А = 1) Экспорт|КонецПроцедуры"),
	Т("Процедура Ф(А) Экспорт|КонецПроцедуры")), "переименование параметра -> ложь");
Проверить(Не Перенос.ТолькоДобавленыНеобязательные(Т("Процедура Ф(А, Б = 1)|КонецПроцедуры"),
	Т("Процедура Ф(А) Экспорт|КонецПроцедуры")), "разный Экспорт -> ложь");
Проверить(Не Перенос.ТолькоДобавленыНеобязательные(Т("Функция Ф(А, Б = 1)|КонецФункции"),
	Т("Процедура Ф(А)|КонецПроцедуры")), "разный вид метода -> ложь");

// 2. Метод УП уже с префиксом — второй префикс не добавляется
Мт = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"УП_Свой", "Процедура", "added", "", Т("Процедура УП_Свой()|	А = 1;|КонецПроцедуры"), "newMethod", "auto", "", "");
Текст = Ч.ОтрисоватьМетод("УП_", Мт);
Проверить(СтрНайти(Текст, "УП_УП_") = 0 И СтрНайти(Текст, "Процедура УП_Свой(") > 0, "нет двойного префикса: " + Текст);
Мт.name = "Свой";
Мт.sourceText = Т("Процедура Свой()|	А = 1;|КонецПроцедуры");
Проверить(СтрНайти(Ч.ОтрисоватьМетод("УП_", Мт), "Процедура УП_Свой(") > 0, "префикс новому методу добавляется");

// 3. Контекстная проверка неразрешённых вызовов и арность
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "tu_arity_" + Строка(Новый УникальныйИдентификатор));
Вых = ОбъединитьПути(Вр, "out");
Уп = ОбъединитьПути(Вр, "UP");
М = "CommonModules/Мод/Ext/Module.bsl";
Записать(Уп, М, Т("Процедура Экспортный(А) Экспорт|КонецПроцедуры|Процедура Скрытый()|КонецПроцедуры|"
	+ "Процедура Обёрнутый()|КонецПроцедуры|Процедура ТолькоУП()|КонецПроцедуры"));
Записать(Вых, "restored/" + М, Т("Процедура Экспортный(А, Б) Экспорт|КонецПроцедуры|Процедура Скрытый()|КонецПроцедуры|"
	+ "Процедура Обёрнутый()|КонецПроцедуры"));
Записать(Уп, "CommonModules/Глоб.xml", "<MetaDataObject><CommonModule><Properties><Global>true</Global></Properties></CommonModule></MetaDataObject>");
Записать(Уп, "CommonModules/Глоб/Ext/Module.bsl", Т("Процедура ГлобМетод() Экспорт|КонецПроцедуры"));
Записать(Вых, "extension/" + М, Т("&Вместо(""Обёрнутый"")|Процедура УП_Обёрнутый()|	ПродолжитьВызов();|КонецПроцедуры|"
	+ "Процедура УП_Новый()|	Экспортный(1, 2);|	Экспортный(1, 2, 3);|	Обёрнутый();|	ГлобМетод();|	Сообщить(""х"");|"
	+ "	Количество();|	Скрытый();|	ТолькоУП();|	НетНигде();|КонецПроцедуры"));
Р = Доз.СканироватьКаталогРасширенияСКонтекстом(ОбъединитьПути(Вых, "extension"), ОбъединитьПути(Вых, "restored"), Уп);
Проверить(Р.count = 2, "настоящих неразрешённых 2 (Скрытый без обёртки, ТолькоУП): " + Р.count + " " + СтрСоединить(Р.samples, "; "));
Проверить(Р.kinds.nonExportNoWrapper = 1 И Р.kinds.upOnlyNotTransferred = 1, "виды неразрешённых");
Проверить(Р.unknown = 1, "НетНигде -> unknown: " + Р.unknown + " " + СтрСоединить(Р.unknownSamples, "; "));
Ра = Арн.Проверить(Вых, Уп);
Проверить(Ра.broken = 1 И Ра.too_many = 1 И Ра.extension = 1, "арность: 1 вызов с лишним аргументом в extension: " + Ра.broken + "/" + Ра.too_many + "/" + Ра.extension);
УдалитьФайлы(Вр);

Если Ошибок = 0 Тогда
	Сообщить("OK: arity/unresolved");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
