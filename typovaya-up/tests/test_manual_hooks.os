// РучныеПерехваты: manual_hooks → extension (заимствование объекта), сверка тела БП, отклонённые — todo, идемпотентность.
Перем Ошибок;
Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Ошибок = 0;
ПС = Символы.ПС;
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_manual_hooks_" + Строка(Новый УникальныйИдентификатор));
Бп = ОбъединитьПути(Вр, "bp");
Расш = ОбъединитьПути(Вр, "extension");
Восст = ОбъединитьПути(Вр, "restored");
Хуки = ОбъединитьПути(Вр, "manual_hooks");
Зап(ОбъединитьПути(Расш, "Configuration.xml"), "<MetaDataObject>" + ПС + "	<Configuration>" + ПС + "		<ChildObjects>" + ПС
	+ "			<CommonModule>Общ</CommonModule>" + ПС + "		</ChildObjects>" + ПС + "	</Configuration>" + ПС + "</MetaDataObject>" + ПС);
// документ: модуля и объекта в extension нет; в БП модуль обёрнут #Если
Зап(ОбъединитьПути(Бп, "Documents", "Док/Ext/ObjectModule.bsl"), "#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда" + ПС
	+ "Функция Печать() Экспорт" + ПС + "	Возврат 1;" + ПС + "КонецФункции" + ПС + "#КонецЕсли" + ПС);
Зап(ОбъединитьПути(Восст, "Documents", "Док.xml"), "<MetaDataObject><Document uuid=""aaaaaaaa-1111-2222-3333-444444444444""><Properties><Name>Док</Name></Properties><ChildObjects><Attribute uuid=""bbbbbbbb-1111-2222-3333-444444444444""><Properties><Name>ИмяОтчета</Name><Type><v8:Type>xs:string</v8:Type></Type></Properties></Attribute><Attribute uuid=""cccccccc-1111-2222-3333-444444444444""><Properties><Name>Лишний</Name><Type><v8:Type>xs:string</v8:Type></Type></Properties></Attribute></ChildObjects></Document></MetaDataObject>");
Зап(ОбъединитьПути(Хуки, "Documents.Док.ObjectModule.Печать.bsl"), "// path: Documents/Док/Ext/ObjectModule.bsl" + ПС + "// method: Печать" + ПС + ПС
	+ "&ИзменениеИКонтроль(""Печать"")" + ПС + "Функция УП_Печать() Экспорт" + ПС + "#Удаление" + ПС + "	Возврат 1;" + ПС + "#КонецУдаления" + ПС
	+ "#Вставка" + ПС + "	Возврат ИмяОтчета;" + ПС + "#КонецВставки" + ПС + "КонецФункции" + ПС);
// общий модуль: в extension уже есть модуль (обёрнут #Если) — перехват дописывается перед #КонецЕсли
Зап(ОбъединитьПути(Бп, "CommonModules", "Общ/Ext/Module.bsl"), "Процедура А() Экспорт" + ПС + "	Х = 1;" + ПС + "	Y = 2;" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Расш, "CommonModules", "Общ/Ext/Module.bsl"), "#Если Сервер Тогда" + ПС + "Процедура Своя()" + ПС + "КонецПроцедуры" + ПС + "#КонецЕсли" + ПС);
Зап(ОбъединитьПути(Расш, "CommonModules", "Общ.xml"), "<MetaDataObject/>");
Зап(ОбъединитьПути(Хуки, "CommonModules.Общ.Module.А.bsl"), "// path: CommonModules/Общ/Ext/Module.bsl" + ПС + "// method: А" + ПС + ПС
	+ "&ИзменениеИКонтроль(""А"")" + ПС + "Процедура УП_А() Экспорт" + ПС + "	Х = 1;" + ПС + "#Вставка" + ПС + "	Возврат;" + ПС + "#КонецВставки" + ПС + "	Y = 2;" + ПС + "КонецПроцедуры" + ПС);
// тело БП не совпадает с ожидаемым — в todo, extension не меняется
Зап(ОбъединитьПути(Бп, "CommonModules", "Друг/Ext/Module.bsl"), "Процедура Б() Экспорт" + ПС + "	Х = 3;" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Хуки, "CommonModules.Друг.Module.Б.bsl"), "// path: CommonModules/Друг/Ext/Module.bsl" + ПС + "// method: Б" + ПС + ПС
	+ "&ИзменениеИКонтроль(""Б"")" + ПС + "Процедура УП_Б() Экспорт" + ПС + "	Х = 1;" + ПС + "#Вставка" + ПС + "	Возврат;" + ПС + "#КонецВставки" + ПС + "КонецПроцедуры" + ПС);
М = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "РучныеПерехваты.os"));
Лог = Новый Массив;
Р = М.Применить(Хуки, Бп, Расш, Восст, "УП_Доработки", Лог, Вр);
П(Р.applied = 2 И Р.rejected = 1 И Р.adopted = 1, "применено/отклонено/заимствовано: " + Р.applied + "/" + Р.rejected + "/" + Р.adopted);
ТД = Чит(ОбъединитьПути(Расш, "Documents", "Док/Ext/ObjectModule.bsl"));
П(СтрНайти(ТД, "#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда") = 1 И СтрНайти(ТД, "&ИзменениеИКонтроль(""Печать"")") > 0
	И СтрНайти(ТД, "#КонецЕсли") > СтрНайти(ТД, "КонецФункции"), "документ: новый модуль в обёртке БП");
ХД = Чит(ОбъединитьПути(Расш, "Documents", "Док.xml"));
П(СтрНайти(ХД, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0 И СтрНайти(ХД, "aaaaaaaa-1111-2222-3333-444444444444") > 0, "документ заимствован, не перенесён");
П(СтрНайти(ХД, "<Name>ИмяОтчета</Name>") > 0 И СтрНайти(ХД, "<Name>Лишний</Name>") = 0, "документ: заимствован реквизит из кода перехвата: " + ХД);
П(СтрНайти(Чит(ОбъединитьПути(Расш, "Configuration.xml")), "<Document>Док</Document>") > 0, "Configuration.xml extension");
ТО = Чит(ОбъединитьПути(Расш, "CommonModules", "Общ/Ext/Module.bsl"));
П(СтрНайти(ТО, "Процедура Своя()") > 0 И СтрНайти(ТО, "Процедура УП_А() Экспорт") > СтрНайти(ТО, "Процедура Своя()")
	И СтрНайти(ТО, "#КонецЕсли") > СтрНайти(ТО, "Процедура УП_А()"), "общий модуль: дописан перед #КонецЕсли");
П(Не (Новый Файл(ОбъединитьПути(Расш, "CommonModules", "Друг/Ext/Module.bsl"))).Существует(), "несовпавший перехват не применён");
Csv = Чит(ОбъединитьПути(Вр, "todo_manual_hooks.csv"));
П(СтрНайти(Csv, "CommonModules.Друг.Module.Б.bsl;CommonModules/Друг/Ext/Module.bsl;Б;тело метода в БП не совпадает") > 0, "todo: " + Csv);
// повтор — без изменений
Р2 = М.Применить(Хуки, Бп, Расш, Восст, "УП_Доработки", Лог, Вр);
П(Р2.applied = 0 И Р2.already = 2 И Чит(ОбъединитьПути(Расш, "CommonModules", "Общ/Ext/Module.bsl")) = ТО И Чит(ОбъединитьПути(Расш, "Documents", "Док/Ext/ObjectModule.bsl")) = ТД, "повтор идемпотентен");
УдалитьФайлы(Вр);
Для Каждого С Из Лог Цикл Сообщить(С); КонецЦикла;
Если Ошибок > 0 Тогда ВызватьИсключение "test_manual_hooks"; КонецЕсли;
Сообщить("OK: test_manual_hooks");
