// ПроверкаРасширенияБезФорм на чистом extension без Forms.
Ошибок = 0;
Пров = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПроверкаРасширенияБезФорм.os"));
Фикст = ОбъединитьПути(ТекущийСценарий().Каталог, "_ext_no_forms_tmp");
Если (Новый Файл(Фикст)).Существует() Тогда
	УдалитьФайлы(Фикст);
КонецЕсли;
СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(Фикст, "Catalogs"), "Спр"));
СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Фикст, "Catalogs"), "Спр"), "Ext"));
ПутьК = ОбъединитьПути(Фикст, "Configuration.xml");
Тм = Новый ТекстовыйДокумент;
Тм.УстановитьТекст("<?xml version=""1.0""?><MetaDataObject><Configuration><ChildObjects><Catalog>Спр</Catalog></ChildObjects></Configuration></MetaDataObject>");
Тм.Записать(ПутьК, КодировкаТекста.UTF8);
Д = ПолучитьДвоичныеДанныеИзСтроки("//mod", КодировкаТекста.UTF8NoBOM);
Д.Записать(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Фикст, "Catalogs"), "Спр"), "Ext"), "ObjectModule.bsl"));
Р = Пров.ПроверитьКаталог(Фикст);
Если Не Р.ok Тогда
	Сообщить("FAIL: ok expected");
	Ошибок = Ошибок + 1;
КонецЕсли;
ПФ = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Фикст, "Catalogs"), "Спр"), "Forms"), "Форма");
СоздатьКаталог(ОбъединитьПути(ПФ, "Ext"));
Д.Записать(ОбъединитьПути(ОбъединитьПути(ПФ, "Ext"), "Form.xml"));
Р2 = Пров.ПроверитьКаталог(Фикст);
Если Р2.ok Или Р2.formsDirs = 0 Тогда
	Сообщить("FAIL: must detect form body");
	Ошибок = Ошибок + 1;
КонецЕсли;
Если Ошибок > 0 Тогда
	ВызватьИсключение "test_extension_no_forms";
КонецЕсли;
Сообщить("OK: test_extension_no_forms");