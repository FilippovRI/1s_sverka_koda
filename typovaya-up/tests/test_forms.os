Перем Ошибок;
Процедура Проверить(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
А = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "АнализФорм.os"));
Ошибок = 0;
ФУП = ОбъединитьПути(Корень, "tests", "fixtures", "UP");
Путь = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ФУП, "Documents"), "Счет"), "Forms"), "ФормаДокумента");
Путь = ОбъединитьПути(ОбъединитьПути(Путь, "Ext"), "Form.xml");
Имена = А.ИменаРеквизитовFormXml(Путь);
Проверить(Имена.Найти("УПДопПоле") <> Неопределено, "УП реквизит");
OUT = ОбъединитьПути(Корень, "tests", "_forms_out");
УдалитьФайлы(OUT); СоздатьКаталог(OUT);
А.СравнитьФормы(ФУП, ОбъединитьПути(Корень, "tests", "fixtures", "BP"), Неопределено, OUT, Новый Массив);
Т = Новый ТекстовыйДокумент; Т.Прочитать(ОбъединитьПути(OUT, "forms_analysis.json"));
Проверить(СтрНайти(Т.ПолучитьТекст(), "УПДопПоле") > 0, "json added");
УдалитьФайлы(OUT);
Если Ошибок = 0 Тогда Сообщить("OK: формы"); Иначе ЗавершитьРаботу(1); КонецЕсли;
