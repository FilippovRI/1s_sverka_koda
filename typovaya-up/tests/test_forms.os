Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
А = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "АнализФорм.os"));
Ошибок = 0;
ФУП = ОбъединитьПути(Корень, "tests", "fixtures", "UP");
ФБП = ОбъединитьПути(Корень, "tests", "fixtures", "BP");
OUT = ОбъединитьПути(Корень, "tests", "_forms_out");
УдалитьФайлы(OUT); СоздатьКаталог(OUT);
Опции = Новый Структура("program", Истина);
А.СравнитьФормы(ФУП, ФБП, Неопределено, OUT, Новый Массив, Опции);
Т = Новый ТекстовыйДокумент; Т.Прочитать(ОбъединитьПути(OUT, "forms_analysis.json"));
J = Т.ПолучитьТекст();
П(СтрНайти(J, "УПДопПоле") > 0, "added УПДопПоле");
П(СтрНайти(J, """changeKind"":""added""") > 0, "added kind");
П(СтрНайти(J, """changeKind"":""changed""") > 0 И СтрНайти(J, "Номер") > 0, "changed Номер");
П(СтрНайти(J, "УПТаблица") > 0 И СтрНайти(J, "manual") > 0, "unsupported table");
П(СтрНайти(J, "preview") > 0, "preview with DataPath");
П(СтрНайти(J, "Раннее обращение") > 0, "manual early УПФлаг");
П(СтрНайти(J, """decision"":""supported""") = 0, "no supported when early ref");
П((Новый Файл(ОбъединитьПути(OUT, "forms_program", "candidates.bsl"))).Существует(), "program file");
П(СтрНайти(J, "ИзменитьРеквизиты") = 0, "json без raw bsl");
А2 = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "АнализФорм.os"));
OUT2 = ОбъединитьПути(OUT, "rerun");
СоздатьКаталог(OUT2);
А2.СравнитьФормы(ФУП, ФБП, Неопределено, OUT2, Новый Массив, Новый Структура("program", Ложь));
Т2 = Новый ТекстовыйДокумент; Т2.Прочитать(ОбъединитьПути(OUT2, "forms_analysis.json"));
П(Т.ПолучитьТекст() = Т2.ПолучитьТекст(), "повторный анализ стабилен");
УдалитьФайлы(OUT);
Если Ошибок = 0 Тогда Сообщить("OK: формы"); Иначе ЗавершитьРаботу(1); КонецЕсли;
