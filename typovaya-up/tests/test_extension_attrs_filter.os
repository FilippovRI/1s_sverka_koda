// ФильтрРеквизитовРасширения: метод с реквизитом БП, которого нет в УП, не идёт в extension.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_attrf_" + Строка(Новый УникальныйИдентификатор));
Уп = ОбъединитьПути(Вр, "up");
Бп = ОбъединитьПути(Вр, "bp");
СоздатьКаталог(ОбъединитьПути(Уп, "Documents", "ДокТест"));
СоздатьКаталог(ОбъединитьПути(Бп, "Documents", "ДокТест"));
Зап(ОбъединитьПути(Уп, "Documents", "ДокТест.xml"), "<?xml version=""1.0""?><MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xs=""http://www.w3.org/2001/XMLSchema""><Document><ChildObjects/></Document></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "Documents", "ДокТест.xml"), "<?xml version=""1.0""?><MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses""><Document><ChildObjects><Attribute uuid=""1""><Properties><Name>Организация</Name></Properties></Attribute></ChildObjects></Document></MetaDataObject>");
Настр = ЗагрузитьСценарий(ОбъединитьПути(Ск, "НастройкиСравнения.os"));
Фр = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ФильтрРеквизитовРасширения.os"));
Фр.Инициализировать(Настр);
Мт = Новый Структура("status, vendorText, hookBody, sourceText", "changed", "Процедура X()" + Символы.ПС + "	Организация = 1;" + Символы.ПС + "КонецПроцедуры", "", "");
Отс = Фр.ОтсутствующиеВТексте("Документ.ДокТест", Фр.ТекстМетодаДляПроверки(Мт), Уп, Бп);
П(Отс.Количество() >= 1, "found missing attr");
П(СтрНайти(СтрСоединить(Отс, " "), "Организация") > 0, "name");
УдалитьФайлы(Вр);
Если Ошибок > 0 Тогда ВызватьИсключение "test_extension_attrs_filter"; КонецЕсли;
Сообщить("OK: test_extension_attrs_filter");