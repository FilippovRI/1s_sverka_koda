Перем Ошибок, Корень;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Функция ТекстФайла(П)
	Т = Новый ТекстовыйДокумент; Т.Прочитать(П); Возврат Т.ПолучитьТекст();
КонецФункции

Функция КонтрольнаяСуммаФикстур()
	Ф = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "tests"), "fixtures"), "UP"), "Documents"), "Счет");
	Ф = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Ф, "Forms"), "ФормаДокумента"), "Ext");
	Ф = ОбъединитьПути(Ф, "Form.xml");
	Возврат ТекстФайла(Ф);
КонецФункции

Функция КонтрольнаяСуммаФайла(П)
	Возврат ТекстФайла(П);
КонецФункции

Процедура ЗаписатьТ(Путь, Текст)
	Тд = Новый ТекстовыйДокумент; Тд.УстановитьТекст(Текст); Тд.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

Процедура Скопировать(Откуда, Куда)
	Кат = Новый Файл(Куда).Путь;
	Если Не (Новый Файл(Кат)).Существует() Тогда
		СоздатьКаталог(Кат);
	КонецЕсли;
	КопироватьФайл(Откуда, Куда);
КонецПроцедуры

Функция БлокУПДопПоле(ТипДоб, КвДлина, КвДоп)
	Если ТипДоб = "boolean" Тогда
		Возврат "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>xs:boolean</v8:Type></Type></Attribute>";
	КонецЕсли;
	Т = "xs:string";
	Если ТипДоб = "decimal" Тогда
		Т = "xs:decimal";
	КонецЕсли;
	Б = "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>" + Т + "</v8:Type>";
	Если КвДлина >= 0 И Т = "xs:string" Тогда
		Д = "Variable";
		Если КвДоп = "fixed" Тогда Д = "Fixed"; ИначеЕсли КвДоп = "any" Тогда Д = "Any"; КонецЕсли;
		Б = Б + "<v8:StringQualifiers><v8:Length>" + КвДлина + "</v8:Length><v8:AllowedLength>" + Д + "</v8:AllowedLength></v8:StringQualifiers>";
	КонецЕсли;
	Возврат Б + "</Type></Attribute>";
КонецФункции

Процедура СоздатьДеревоПревью(База, ИсхКорень, ПостКорень, ТипDecimal, СтрокаВМодуль, КвДлина, КвДоп, ТипДоб)
	Рел = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути("Documents", "Счет"), "Forms"), "ФормаДокумента"), "Ext");
	ПУП = ОбъединитьПути(ОбъединитьПути(База, "UP"), Рел);
	ПБП = ОбъединитьПути(ОбъединитьПути(База, "BP"), Рел);
	СоздатьКаталог(ОбъединитьПути(ПУП, "Form"));
	СоздатьКаталог(ОбъединитьПути(ПБП, "Form"));
	Скопировать(ОбъединитьПути(ОбъединитьПути(ИсхКорень, Рел), "Form.xml"), ОбъединитьПути(ПУП, "Form.xml"));
	Скопировать(ОбъединитьПути(ОбъединитьПути(ПостКорень, Рел), "Form.xml"), ОбъединитьПути(ПБП, "Form.xml"));
	Т = ТекстФайла(ОбъединитьПути(ПУП, "Form.xml"));
	ТБ = ТекстФайла(ОбъединитьПути(ПБП, "Form.xml"));
	Т = СтрЗаменить(Т, "<DataPath>Объект.УПДопПоле</DataPath>", "");
	ТБ = СтрЗаменить(ТБ, "xs:decimal", "xs:string");
	ЗаписатьТ(ОбъединитьПути(ПБП, "Form.xml"), ТБ);
	Старый = "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>xs:string</v8:Type></Type></Attribute>";
	Если СтрНайти(Т, Старый) = 0 Тогда
		Старый = "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>xs:string</v8:Type><DataPath>Объект.УПДопПоле</DataPath></Type></Attribute>";
		Т = СтрЗаменить(Т, "<DataPath>Объект.УПДопПоле</DataPath>", "");
	КонецЕсли;
	Тд = ?(ТипDecimal, "decimal", ТипДоб);
	Кд = КвДлина;
	Если ТипDecimal Тогда
		Кд = -1;
	КонецЕсли;
	Т = СтрЗаменить(Т, Старый, БлокУПДопПоле(Тд, Кд, КвДоп));
	ЗаписатьТ(ОбъединитьПути(ПУП, "Form.xml"), Т);
	М = "Процедура Ф()" + Символы.ПС;
	Если СтрокаВМодуль <> "" Тогда
		М = М + "	" + СтрокаВМодуль + Символы.ПС;
	КонецЕсли;
	М = М + "КонецПроцедуры";
	ЗаписатьТ(ОбъединитьПути(ОбъединитьПути(ПУП, "Form"), "Module.bsl"), М);
	ЗаписатьТ(ОбъединитьПути(ОбъединитьПути(ПБП, "Form"), "Module.bsl"), "Процедура Ф() КонецПроцедуры");
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ФУП = ОбъединитьПути(Корень, "tests", "fixtures", "UP");
ФБП = ОбъединитьПути(Корень, "tests", "fixtures", "BP");
А = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "АнализФорм.os"));
Ошибок = 0;
ХешФикстур = КонтрольнаяСуммаФикстур();

OUT1 = ОбъединитьПути(Корень, "tests", "_preview_out1");
УдалитьФайлы(OUT1); СоздатьКаталог(OUT1);
А.СравнитьФормы(ФУП, ФБП, Неопределено, OUT1, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT1, "forms_analysis.json")), "изменён существующий") > 0, "changed existing manual");

OUT2 = ОбъединитьПути(Корень, "tests", "_preview_out2");
УдалитьФайлы(OUT2);
СоздатьДеревоПревью(OUT2, ФУП, ФБП, Ложь, "", 25, "variable", "string");
А.СравнитьФормы(ОбъединитьПути(OUT2, "UP"), ОбъединитьПути(OUT2, "BP"), Неопределено, OUT2, Новый Массив, Истина);
Т2 = ТекстФайла(ОбъединитьПути(OUT2, "forms_analysis.json"));
П(СтрНайти(Т2, """programGeneration"":""preview""") > 0, "supported preview");
П(СтрНайти(Т2, "КвалификаторыСтроки(25") > 0 И СтрНайти(Т2, "Переменная") > 0, "qual var 25");
П(СтрНайти(Т2, "КвалификаторыСтроки(100") = 0, "not hardcoded 100");
Найден = Ложь;
КатП = ОбъединитьПути(OUT2, "forms_preview");
Если (Новый Файл(КатП)).Существует() Тогда
	Для Каждого Ф Из НайтиФайлы(КатП, "*.preview.bsl") Цикл
		Найден = Истина;
		П(СтрНайти(ТекстФайла(Ф.ПолноеИмя), "РеквизитФормы") > 0, "API in bsl");
		Прервать;
	КонецЦикла;
КонецЕсли;
П(Найден, "preview file");

OUT3 = ОбъединитьПути(Корень, "tests", "_preview_out3");
УдалитьФайлы(OUT3);
СоздатьДеревоПревью(OUT3, ФУП, ФБП, Истина, "", 25, "variable", "string");
А.СравнитьФормы(ОбъединитьПути(OUT3, "UP"), ОбъединитьПути(OUT3, "BP"), Неопределено, OUT3, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT3, "forms_analysis.json")), "не поддержан") > 0, "type unsupported");

OUT4 = ОбъединитьПути(Корень, "tests", "_preview_out4");
УдалитьФайлы(OUT4);
СоздатьДеревоПревью(OUT4, ФУП, ФБП, Ложь, "РеквизитФормы(""УПДопПоле""", 25, "variable", "string");
А.СравнитьФормы(ОбъединитьПути(OUT4, "UP"), ОбъединитьПути(OUT4, "BP"), Неопределено, OUT4, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT4, "forms_analysis.json")), "дублирующее") > 0, "duplicate dynamic");

OUT5 = ОбъединитьПути(Корень, "tests", "_preview_out5");
УдалитьФайлы(OUT5);
СоздатьДеревоПревью(OUT5, ФУП, ФБП, Ложь, "а = УПДопПоле;", 25, "variable", "string");
А.СравнитьФормы(ОбъединитьПути(OUT5, "UP"), ОбъединитьПути(OUT5, "BP"), Неопределено, OUT5, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT5, "forms_analysis.json")), "обращение к") > 0, "early access");

Х2 = КонтрольнаяСуммаФайла(ОбъединитьПути(OUT2, "forms_analysis.json"));
А.СравнитьФормы(ОбъединитьПути(OUT2, "UP"), ОбъединитьПути(OUT2, "BP"), Неопределено, OUT2, Новый Массив, Истина);
П(Х2 = КонтрольнаяСуммаФайла(ОбъединитьПути(OUT2, "forms_analysis.json")), "idempotent json");

OUT6 = ОбъединитьПути(Корень, "tests", "_preview_out6");
УдалитьФайлы(OUT6);
СоздатьДеревоПревью(OUT6, ФУП, ФБП, Ложь, "", 10, "fixed", "string");
А.СравнитьФормы(ОбъединитьПути(OUT6, "UP"), ОбъединитьПути(OUT6, "BP"), Неопределено, OUT6, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT6, "forms_analysis.json")), "Фиксированная") > 0, "qual fixed");

OUT7 = ОбъединитьПути(Корень, "tests", "_preview_out7");
УдалитьФайлы(OUT7);
СоздатьДеревоПревью(OUT7, ФУП, ФБП, Ложь, "", 0, "any", "string");
А.СравнитьФормы(ОбъединитьПути(OUT7, "UP"), ОбъединитьПути(OUT7, "BP"), Неопределено, OUT7, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT7, "forms_analysis.json")), "Неограниченная") > 0, "qual any");

OUT8 = ОбъединитьПути(Корень, "tests", "_preview_out8");
УдалитьФайлы(OUT8);
СоздатьДеревоПревью(OUT8, ФУП, ФБП, Ложь, "", -1, "", "string");
А.СравнитьФормы(ОбъединитьПути(OUT8, "UP"), ОбъединитьПути(OUT8, "BP"), Неопределено, OUT8, Новый Массив, Истина);
П(СтрНайти(ТекстФайла(ОбъединитьПути(OUT8, "forms_analysis.json")), "квалификаторы строки") > 0, "no qual manual");

OUT9 = ОбъединитьПути(Корень, "tests", "_preview_out9");
УдалитьФайлы(OUT9);
СоздатьДеревоПревью(OUT9, ФУП, ФБП, Ложь, "", 0, "any", "boolean");
А.СравнитьФормы(ОбъединитьПути(OUT9, "UP"), ОбъединитьПути(OUT9, "BP"), Неопределено, OUT9, Новый Массив, Истина);
Т9 = "";
Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(OUT9, "forms_preview"), "*.preview.bsl") Цикл Т9 = ТекстФайла(Ф.ПолноеИмя); Прервать; КонецЦикла;
П(СтрНайти(Т9, "Булево") > 0 И СтрНайти(Т9, "КвалификаторыСтроки") = 0, "boolean no str qual");

П(ХешФикстур = КонтрольнаяСуммаФикстур(), "fixtures unchanged");
УдалитьФайлы(OUT1); УдалитьФайлы(OUT2); УдалитьФайлы(OUT3); УдалитьФайлы(OUT4); УдалитьФайлы(OUT5);
УдалитьФайлы(OUT6); УдалитьФайлы(OUT7); УдалитьФайлы(OUT8); УдалитьФайлы(OUT9);
Если Ошибок = 0 Тогда Сообщить("OK: forms preview"); Иначе ЗавершитьРаботу(1); КонецЕсли;
