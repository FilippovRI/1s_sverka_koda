// Регрессия применимости &ИзменениеИКонтроль (синтетика, без исходников клиента):
// пустые строки типового тела, препроцессор внутри #Удаление, ссылки на общие модули,
// сверка хука с основной конфигурацией (cac_vs_main), режим совместимости.
Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция Т(З) Возврат СтрЗаменить(З, "|", Символы.ПС); КонецФункции
Процедура ЗаписатьФайл(Путь, Текст)
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Раз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Син = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Син.Инициализировать(Раз, ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os")));
Ошибок = 0;

// 1. Пустая строка с табуляцией перед первым #Удаление — строка типового, не удаляется.
Тип = "	|	Если Не Пусто(Т) Тогда|		Д = Ф(Т);|		С = Ложь;|	КонецЕсли;|	";
Уп = "	|		Д = Ф(Т);|	// УП_начало|	Если Д.Количество() = 1 Тогда|		А = Д[0];|	КонецЕсли;|	// УП_конец|		С = Ложь;|	";
Пр = Син.ПредложитьХук(Т(Тип), Т(Уп));
П(Пр.hook = "changeAndControl", "blank: CAC, получено " + Пр.hook);
Если Пр.hook = "changeAndControl" Тогда
	П(Син.ВосстановитьБазовыйТекстТиповогоИзХука(Пр.hookBody) = Т(Тип), "blank: типовое тело байт в байт");
	П(СтрРазделить(Пр.hookBody, Символы.ПС, Истина)[0] = Символы.Таб, "blank: первая строка тела сохранена");
КонецЕсли;

// 2. #Если/#Иначе/#КонецЕсли типового, заменённые в УП на Если — в #Удаление резать нельзя.
Тип = "	П = 0;|	#Если ВебКлиент Тогда|		П = 1;|	#Иначе|		П = 0.1;|	#КонецЕсли|	Возврат П;";
Уп = "	П = 0;|	Если ЭтоВеб() Тогда|		П = 1;|	Иначе|		П = 0.1;|	КонецЕсли;|	Возврат П;";
Пр = Син.ПредложитьХук(Т(Тип), Т(Уп));
П(Пр.hook <> "changeAndControl" Или Син.ПрепроцессорСбалансированВБлокахИк(СтрРазделить(Пр.hookBody, Символы.ПС, Истина)),
	"preproc: несбалансированный CAC не выдаётся");
П(Не Син.ПроверитьЦелостностьТелаИк(Т("	П = 0;|#Удаление|	#Если ВебКлиент Тогда|#КонецУдаления|		П = 1;|#Удаление|	#КонецЕсли|#КонецУдаления")),
	"preproc: #Если разрезан #КонецУдаления");
П(Син.ПроверитьЦелостностьТелаИк(Т("	П = 0;|#Удаление|	#Если ВебКлиент Тогда|		П = 1;|	#КонецЕсли|#КонецУдаления|	Возврат П;")),
	"preproc: сбалансированный #Если внутри #Удаление допустим");
П(Не Син.ПроверитьЦелостностьТелаИк(Т("	#Если Сервер Тогда|#Вставка|	#Иначе|#КонецВставки|	#КонецЕсли")),
	"preproc: ветка внешнего #Если внутри #Вставка");

// 3. Локальные переменные «Имя.» не считаются общими модулями, если известен набор БП.
Пс = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПроверкаСсылокКонфигурации.os"));
НаборУп = Новый Соответствие; НаборУп.Вставить("ОбщийМодульА", Истина);
НаборБп = Новый Соответствие; НаборБп.Вставить("ОбщийМодульА", Истина); НаборБп.Вставить("ТолькоВБп", Истина);
Отс = Пс.ОтсутствующиеОбщиеМодулиПоставщика(Т("	Запрос.Выполнить();|	ОбщийМодульА.М();|	ТолькоВБп.М();|	Форма.Закрыть();"), НаборУп, НаборБп);
П(Отс.Количество() = 1 И Отс[0] = "ТолькоВБп", "refs: только модуль БП, которого нет в УП");

// 4. cac_vs_main: хук сверяется с модулем основной конфигурации.
Сп = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СамопроверкаВыхода.os"));
Сп.Инициализировать(Раз, Неопределено, Син);
Кат = ПолучитьИмяВременногоФайла("cacmain");
СоздатьКаталог(Кат);
Расш = Т("&ИзменениеИКонтроль(""Метод"")|Процедура УП_Метод(Пар) Экспорт|	|	А = 1;|#Вставка|	// УП_начало|	Б = 2;|	// УП_конец|#КонецВставки|	В = 3;|КонецПроцедуры");
Осн = Т("Процедура Метод(Пар) Экспорт|	|	А = 1;|	В = 3;|КонецПроцедуры");
ОснУп = Т("Процедура Метод(Пар) Экспорт|	|	А = 1;|	// УП_начало|	Б = 2;|	// УП_конец|	В = 3;|КонецПроцедуры");
ЗаписатьФайл(ОбъединитьПути(Кат, "ok.bsl"), Осн);
ЗаписатьФайл(ОбъединитьПути(Кат, "up.bsl"), ОснУп);
Р = Сп.СверитьМодульИк(Расш, ОбъединитьПути(Кат, "ok.bsl"));
П(Р.checked = 1 И Р.Имена.Количество() = 0, "cac_vs_main: совпадение с типовым");
Р = Сп.СверитьМодульИк(Расш, ОбъединитьПути(Кат, "up.bsl"));
П(Р.Имена.Количество() = 1, "cac_vs_main: основная с телом УП — несовпадение");
Р = Сп.СверитьМодульИк(Т("&ИзменениеИКонтроль(""Метод"")|Процедура УП_Метод(Пар) Экспорт|	А = 1;|	В = 3;|КонецПроцедуры"), ОбъединитьПути(Кат, "ok.bsl"));
П(Р.Имена.Количество() = 1, "cac_vs_main: потерянная пустая строка — несовпадение");
УдалитьФайлы(Кат);

// 5. Режим совместимости основной конфигурации для Configuration.xml расширения.
Чр = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
П(Чр.РежимСовместимостиВыгрузки(ОбъединитьПути(Корень, "tests", "fixtures", "UP")) = "Version8_3_24", "compat: CompatibilityMode из УП");
П(Чр.РежимСовместимостиВыгрузки("") = "", "compat: без выгрузки — пусто");

Если Ошибок = 0 Тогда
	Сообщить("OK: CAC applicability");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
