// Правило «Недостаточно фактических параметров»: УП-вызовы и УП-метод под префиксом УП_.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Ошибок = 0;
Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));

Восст = "&НаКлиентеНаСервереБезКонтекста" + Символы.ПС
	+ "Процедура УправлениеЗаголовкамиФормы(ЭтотОбъект)" + Символы.ПС
	+ "	ЭтотОбъект.Заголовок = ""T"";" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура ТипТорговойТочкиПриИзмененииНаСервере()" + Символы.ПС
	+ "	УправлениеЗаголовкамиФормы(ЭтотОбъект);" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;
Бп = "&НаСервере" + Символы.ПС
	+ "Процедура УправлениеЗаголовкамиФормы()" + Символы.ПС
	+ "	Заголовок = ""B"";" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура ТипТорговойТочкиПриИзмененииНаСервере()" + Символы.ПС
	+ "	УправлениеЗаголовкамиФормы();" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;
Уп = "&НаКлиентеНаСервереБезКонтекста" + Символы.ПС
	+ "Процедура УправлениеЗаголовкамиФормы(ЭтотОбъект)" + Символы.ПС
	+ "	ЭтотОбъект.Заголовок = ""U"";" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура ТипТорговойТочкиПриИзмененииНаСервере()" + Символы.ПС
	+ "	УправлениеЗаголовкамиФормы(ЭтотОбъект);" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;

РаздВосст = Модуль.РазобратьМодульНаМетоды(Восст);
РаздБп = Модуль.РазобратьМодульНаМетоды(Бп);
МтБпВыз = РаздБп.byName.Получить("ТипТорговойТочкиПриИзмененииНаСервере");
Прич = Модуль.ПричинаКонфликтаВызововТелаБп(МтБпВыз.body, РаздВосст, РаздБп);
Проверить(СтрНайти(Прич, "УправлениеЗаголовкамиФормы") > 0, "конфликт вызова тела БП: " + Прич);

МтСовп = РаздБп.byName.Получить("УправлениеЗаголовкамиФормы");
ПричНет = Модуль.ПричинаКонфликтаВызововТелаБп(МтСовп.body, РаздВосст, РаздБп);
Проверить(ПричНет = "", "тело без чужих вызовов не конфликтует: " + ПричНет);

Расш = "&НаСервере" + Символы.ПС
	+ "&ИзменениеИКонтроль(""ТипТорговойТочкиПриИзмененииНаСервере"")" + Символы.ПС
	+ "Процедура ТипТорговойТочкиПриИзмененииНаСервере()" + Символы.ПС
	+ "#Удаление" + Символы.ПС
	+ "	УправлениеЗаголовкамиФормы(ЭтотОбъект);" + Символы.ПС
	+ "#КонецУдаления" + Символы.ПС
	+ "#Вставка" + Символы.ПС
	+ "	УправлениеЗаголовкамиФормы(ЭтотОбъект);" + Символы.ПС
	+ "#КонецВставки" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;
Р = Модуль.ДополнитьРасшУпПрефиксПоСигнатурам(Расш, Уп, Восст, Бп);
Проверить(СтрНайти(Р, "Процедура УП_УправлениеЗаголовкамиФормы(ЭтотОбъект)") > 0, "УП-версия под префиксом УП_");
Проверить(СтрНайти(Р, "&НаКлиентеНаСервереБезКонтекста") > 0, "директива УП у префиксного метода");
Проверить(СтрНайти(Р, "ЭтотОбъект.Заголовок = ""U"";") > 0, "тело УП у префиксного метода");
Проверить(СтрНайти(Р, "УП_УправлениеЗаголовкамиФормы(ЭтотОбъект)") > 0, "вызов в #Вставка переименован в УП_");
Проверить(СтрЧислоВхождений(Р, "	УправлениеЗаголовкамиФормы(ЭтотОбъект);") = 1, "вызов typovaya в #Удаление не переименован");
Р2 = Модуль.ДополнитьРасшУпПрефиксПоСигнатурам(Р, Уп, Восст, Бп);
Проверить(СтрЧислоВхождений(Р2, "Процедура УП_УправлениеЗаголовкамиФормы(ЭтотОбъект)") = 1, "повтор не дублирует УП-метод");


РасшУжеПреф = "&НаСервере" + Символы.ПС
	+ "Процедура УП_УправлениеЗаголовкамиФормы(ЭтотОбъект)" + Символы.ПС
	+ "	ЭтотОбъект.Заголовок = ""U"";" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ Расш;
Р4 = Модуль.ДополнитьРасшУпПрефиксПоСигнатурам(РасшУжеПреф, Уп, Восст, Бп);
Проверить(СтрЧислоВхождений(Р4, "Процедура УП_УправлениеЗаголовкамиФормы(ЭтотОбъект)") = 1, "не дублирует уже существующий УП_-метод");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_up_prefix");
Иначе
	Сообщить("FAILED test_iik_up_prefix: " + Ошибок);
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));