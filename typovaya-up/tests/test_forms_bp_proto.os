Записать(П(УпЗп, "Catalogs", "СпрЗп.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa61", "СпрЗп"));
Записать(П(БпЗп, "Catalogs", "СпрЗп.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa61", "СпрЗп"));
XmlУпЗп = XmlФормы(Ложь, "СпрЗп");
XmlБпЗп = СтрЗаменить(XmlФормы(Ложь, "СпрЗп"), "</Attributes>",
	"		<Attribute name=""Список"" id=""2"">" + Символы.ПС
	+ "			<Type/>" + Символы.ПС
	+ "			<Settings xsi:nil=""true""/>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "	<ChildItems>" + Символы.ПС
	+ "		<Table name=""Список"" id=""10"">" + Символы.ПС
	+ "			<DataPath>Список</DataPath>" + Символы.ПС
	+ "			<DataSource>" + Символы.ПС
	+ "				<MainTable>Catalog.СпрЗп</MainTable>" + Символы.ПС
	+ "				<ManualQuery>true</ManualQuery>" + Символы.ПС
	+ "				<QueryText>ВЫБРАТЬ СправочникСпрЗп.Ссылка, СправочникСпрЗп.ТабличнаяЧастьТолькоБп ИЗ Справочник.СпрЗп КАК СправочникСпрЗп</QueryText>" + Символы.ПС
	+ "			</DataSource>" + Символы.ПС
	+ "		</Table>" + Символы.ПС
	+ "	</ChildItems>");
ПоложитьФормуВ(УпЗп, "СпрЗп", "ФормаЗп", XmlУпЗп, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa62");
ПоложитьФормуВ(БпЗп, "СпрЗп", "ФормаЗп", XmlБпЗп, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa62");
ОтнЗп = "Catalogs\СпрЗп\Forms\ФормаЗп\Ext\Form.xml";
ФильтрЗп = Новый Массив;
ФильтрЗп.Добавить(ОтнЗп);
СтатЗп = Прот.СгенерироватьСрезФорм(УпЗп, БпЗп, ВыходЗп, ФильтрЗп, "УП_");
Проверить(СтатЗп.forms = 0, "query forms=" + СтатЗп.forms);
Проверить(СтатЗп.skipped = 1, "query skipped=" + СтатЗп.skipped);
Проверить(СтрНайти(СтатЗп.todo[0], "ТабличнаяЧастьТолькоБп") > 0, "todo называет ТабличнаяЧастьТолькоБп");
Проверить(Не (Новый Файл(П(ВыходЗп, "restored", ОтнЗп))).Существует(), "форма с QueryText вне typovaya не в restored среза");

