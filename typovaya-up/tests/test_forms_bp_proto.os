// cfg:EnumRef, которого нет в typovaya.
УпТп = П(Фикст, "up_type");
БпТп = П(Фикст, "bp_type");
ВыходТп = П(Фикст, "out_type");
Записать(П(УпТп, "Catalogs", "СпрТп.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa96", "СпрТп"));
Записать(П(БпТп, "Catalogs", "СпрТп.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa96", "СпрТп"));
XmlУпТп = XmlФормы(Ложь, "СпрТп");
XmlБпТп = СтрЗаменить(XmlФормы(Ложь, "СпрТп"), "</Attributes>",
