// Role, которой нет в typovaya.
УпРл = П(Фикст, "up_role");
БпРл = П(Фикст, "bp_role");
ВыходРл = П(Фикст, "out_role");
Записать(П(УпРл, "Catalogs", "СпрРл.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa93", "СпрРл"));
