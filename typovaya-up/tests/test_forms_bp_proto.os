СтатТп = Прот.СгенерироватьСрезФорм(УпТп, БпТп, ВыходТп, ФильтрТп, "УП_");
Проверить(СтатТп.forms = 0, "type forms=" + СтатТп.forms);
Проверить(СтатТп.skipped = 1, "type skipped=" + СтатТп.skipped);
Проверить(СтрНайти(СтатТп.todo[0], "ПеречислениеТолькоБп") > 0, "todo называет ПеречислениеТолькоБп");
Проверить(СтрНайти(СтатТп.todo[0], "CatalogRef.СпрТп") = 0, "существующий CatalogRef.СпрТп не в todo");
Проверить(Не (Новый Файл(П(ВыходТп, "restored", ОтнТп))).Существует(), "форма с cfg-типом вне typovaya не в restored среза");

// Валидатор ссылок Form.xml против restored: ловит отсутствующий cfg-тип и роль, существующий каталог не ругает.
УпВл = П(Фикст, "up_val");
БпВл = П(Фикст, "bp_val");
Записать(П(УпВл, "Catalogs", "СпрВл.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa98", "СпрВл"));
Записать(П(БпВл, "Catalogs", "СпрВл.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa98", "СпрВл"));
РольВл = "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Role uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa99""><Properties><Name>ПолныеПрава</Name></Properties></Role></MetaDataObject>";
СоздатьКаталог(П(УпВл, "Roles"));
Записать(П(УпВл, "Roles", "ПолныеПрава.xml"), РольВл);
СоздатьКаталог(П(БпВл, "Roles"));
Записать(П(БпВл, "Roles", "ПолныеПрава.xml"), РольВл);
XmlУпВл = XmlФормы(Ложь, "СпрВл");
XmlБпВл = СтрЗаменить(XmlФормы(Ложь, "СпрВл"), "</Form>",
	"	<Attributes/>" + Символы.ПС
	+ "</Form>");
XmlБпВл = СтрЗаменить(XmlФормы(Ложь, "СпрВл"), "</Attributes>",
	"		<Attribute name=""Вид"" id=""8"">" + Символы.ПС
	+ "			<Type><v8:Type>cfg:EnumRef.ПеречислениеТолькоБп</v8:Type></Type>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "	<CommandBar>" + Символы.ПС
	+ "		<xr:Value name=""Role.ПолныеПрава"">true</xr:Value>" + Символы.ПС
	+ "		<xr:Value name=""Role.ЧтениеТолькоБп"">true</xr:Value>" + Символы.ПС
	+ "	</CommandBar>");
ПоложитьФормуВ(УпВл, "СпрВл", "ФормаВл", XmlУпВл, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa9a");
ПоложитьФормуВ(БпВл, "СпрВл", "ФормаВл", XmlБпВл, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa9a");
// Проверяем тело БП, положенное в «restored» фикстуры (как после наложения среза).
ОтнВл = "Catalogs\СпрВл\Forms\ФормаВл\Ext\Form.xml";
ФильтрВл = Новый Массив;
ФильтрВл.Добавить(ОтнВл);
ЗамечанияВл = Прот.ПроверитьСсылкиФорм(БпВл, ФильтрВл);
Проверить(ЗамечанияВл.Количество() = 2, "validator count=" + ЗамечанияВл.Количество() + " " + СтрСоединить(ЗамечанияВл, " | "));
ТекстВл = СтрСоединить(ЗамечанияВл, Символы.ПС);
Проверить(СтрНайти(ТекстВл, "ПеречислениеТолькоБп") > 0, "validator называет EnumRef");
Проверить(СтрНайти(ТекстВл, "ЧтениеТолькоБп") > 0, "validator называет Role");
Проверить(СтрНайти(ТекстВл, "ПолныеПрава") = 0, "validator не ругает существующую роль");
Проверить(СтрНайти(ТекстВл, "CatalogObject.СпрВл") = 0 И СтрНайти(ТекстВл, "cfg:CatalogObject") = 0, "validator не ругает существующий каталог");


Если Ошибок > 0 Тогда
	ВызватьИсключение "test_forms_bp_proto: " + Ошибок + " failures";
КонецЕсли;
Сообщить("OK test_forms_bp_proto");
