// Opt-in шаг формы БП в restored + заимствованная форма в extension. Фикстуры временные.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда
		Р = ОбъединитьПути(Р, П3);
	КонецЕсли;
	Если П4 <> "" Тогда
		Р = ОбъединитьПути(Р, П4);
	КонецЕсли;
	Если П5 <> "" Тогда
		Р = ОбъединитьПути(Р, П5);
	КонецЕсли;
	Если П6 <> "" Тогда
		Р = ОбъединитьПути(Р, П6);
	КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция ТекстФайла(Путь)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), КодировкаТекста.UTF8);
КонецФункции

Функция XmlФормы(ДопАтрибут)
	Т = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:CatalogObject.Спр</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>";
	Если ДопАтрибут Тогда
		Т = Т + Символы.ПС
			+ "		<Attribute name=""ФлагУП"" id=""2"">" + Символы.ПС
			+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
			+ "		</Attribute>";
	КонецЕсли;
	Возврат Т + Символы.ПС + "	</Attributes>" + Символы.ПС + "</Form>" + Символы.ПС;
КонецФункции

Функция МодульБп()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	Б = 1;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Функция МодульУп()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	Б = 1;" + Символы.ПС
		+ "	А = 1;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Функция МетаОбъекта(Уид, Имя, ИдТипа = "")
	Инфо = "";
	Если ИдТипа <> "" Тогда
		Инфо = "		<InternalInfo>" + Символы.ПС
			+ "			<xr:GeneratedType name=""CatalogRef." + Имя + """ category=""Ref"">" + Символы.ПС
			+ "				<xr:TypeId>" + ИдТипа + "</xr:TypeId>" + Символы.ПС
			+ "				<xr:ValueId>bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb</xr:ValueId>" + Символы.ПС
			+ "			</xr:GeneratedType>" + Символы.ПС
			+ "		</InternalInfo>" + Символы.ПС;
	КонецЕсли;
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" version=""2.21"">" + Символы.ПС
		+ "	<Catalog uuid=""" + Уид + """>" + Символы.ПС
		+ Инфо
		+ "		<Properties><Name>" + Имя + "</Name></Properties>" + Символы.ПС
		+ "	</Catalog>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МетаФормы(Уид, Имя)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21"">" + Символы.ПС
		+ "	<Form uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties><Name>" + Имя + "</Name><FormType>Managed</FormType></Properties>" + Символы.ПС
		+ "	</Form>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Процедура ПоложитьФорму(Корень, ИмяФормы, Тело, Модуль, УидФормы)
	База = П(Корень, "Catalogs", "Спр", "Forms", ИмяФормы);
	Записать(П(База, "Ext", "Form.xml"), Тело);
	Если Модуль <> "" Тогда
		Записать(П(База, "Ext", "Form", "Module.bsl"), Модуль);
	КонецЕсли;
	Записать(База + ".xml", МетаФормы(УидФормы, ИмяФормы));
КонецПроцедуры

Ошибок = 0;
КаталогТестов = ТекущийСценарий().Каталог;
КореньСк = П(КаталогТестов, "..", "src");
Прот = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ФормыБпПрототип.os"));
Фикст = ОбъединитьПути(КаталогТестов, "_forms_bp_proto_tmp");
Если (Новый Файл(Фикст)).Существует() Тогда
	УдалитьФайлы(Фикст);
КонецЕсли;
СоздатьКаталог(Фикст);
Уп = ОбъединитьПути(Фикст, "up");
Бп = ОбъединитьПути(Фикст, "bp");
Выход = ОбъединитьПути(Фикст, "out");
Записать(ОбъединитьПути(Уп, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");
Записать(ОбъединитьПути(Бп, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");
Записать(П(Уп, "Catalogs", "Спр.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "Спр", "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"));
Записать(П(Бп, "Catalogs", "Спр.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "Спр", "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"));
Записать(П(Уп, "Catalogs", "ТолькоУпОбъект.xml"), МетаОбъекта("bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", "ТолькоУпОбъект"));

ПоложитьФорму(Уп, "Идент", XmlФормы(Ложь), МодульБп(), "11111111-1111-1111-1111-111111111111");
ПоложитьФорму(Бп, "Идент", XmlФормы(Ложь), МодульБп(), "11111111-1111-1111-1111-111111111111");
ПоложитьФорму(Уп, "ТолькоМодуль", XmlФормы(Ложь), МодульУп(), "22222222-2222-2222-2222-222222222222");
ПоложитьФорму(Бп, "ТолькоМодуль", XmlФормы(Ложь), МодульБп(), "22222222-2222-2222-2222-222222222222");
ПоложитьФорму(Уп, "ТолькоXml", XmlФормы(Истина), МодульБп(), "33333333-3333-3333-3333-333333333333");
ПоложитьФорму(Бп, "ТолькоXml", XmlФормы(Ложь), МодульБп(), "33333333-3333-3333-3333-333333333333");
ПоложитьФорму(Уп, "Оба", XmlФормы(Истина), МодульУп(), "44444444-4444-4444-4444-444444444444");
ПоложитьФорму(Бп, "Оба", XmlФормы(Ложь), МодульБп(), "44444444-4444-4444-4444-444444444444");
ПоложитьФорму(Уп, "ТолькоУп", XmlФормы(Ложь), МодульУп(), "55555555-5555-5555-5555-555555555555");
ПоложитьФорму(Бп, "ТолькоБп", XmlФормы(Ложь), МодульБп(), "66666666-6666-6666-6666-666666666666");
БазаУпТолько = П(Уп, "Catalogs", "ТолькоУпОбъект", "Forms", "Форма");
Записать(П(БазаУпТолько, "Ext", "Form.xml"), XmlФормы(Ложь));
Записать(П(БазаУпТолько, "Ext", "Form", "Module.bsl"), МодульУп());
Записать(БазаУпТолько + ".xml", МетаФормы("77777777-7777-7777-7777-777777777777", "Форма"));

Св = Прот.КлассифицироватьОбщиеФормы(Уп, Бп, Истина);
Проверить(Св.commonObjectForms = 6, "общих форм объекта Спр: " + Св.commonObjectForms);
Проверить(Св.identical = 1, "identical=" + Св.identical);
Проверить(Св.moduleOnly = 1, "moduleOnly=" + Св.moduleOnly);
Проверить(Св.xmlOnly = 1, "xmlOnly=" + Св.xmlOnly);
Проверить(Св.bothDiffer = 1, "bothDiffer=" + Св.bothDiffer);
Проверить(Св.upOnlyForm = 1, "upOnlyForm=" + Св.upOnlyForm);
Проверить(Св.bpOnlyForm = 1, "bpOnlyForm=" + Св.bpOnlyForm);
Проверить(Св.uponlyObjectForms = 1, "uponlyObjectForms=" + Св.uponlyObjectForms);
Проверить(Св.xmlNameDiff = 2, "xmlNameDiff (ТолькоXml+Оба)=" + Св.xmlNameDiff);

Статусы = Новый Соответствие;
Для Каждого Э Из Св.items Цикл
	Если СтрЗаканчиваетсяНа(Э.rel, "\ТолькоМодуль\Ext\Form.xml") Тогда
		Проверить(Э.status = "module_only", "ТолькоМодуль status=" + Э.status);
	КонецЕсли;
	Статусы.Вставить(Э.status, Истина);
КонецЦикла;

ОтнОба = "Catalogs\Спр\Forms\Оба\Ext\Form.xml";
ОтнМод = "Catalogs\Спр\Forms\ТолькоМодуль\Ext\Form.xml";
Фильтр = Новый Массив;
Фильтр.Добавить(ОтнОба);
Фильтр.Добавить(ОтнМод);
Стат = Прот.СгенерироватьСрезФорм(Уп, Бп, Выход, Фильтр, "УП_");
Проверить(Стат.forms = 2, "срез forms=" + Стат.forms);
Проверить(Стат.restoredXml = 2, "restoredXml=" + Стат.restoredXml);
Проверить(Стат.restoredModules = 2, "restoredModules=" + Стат.restoredModules);
Проверить(Стат.borrowed = 2, "borrowed=" + Стат.borrowed);

ТRestXml = ТекстФайла(П(Выход, "restored", ОтнОба));
ТБпXml = ТекстФайла(ОбъединитьПути(Бп, ОтнОба));
Проверить(СокрЛП(ТRestXml) = СокрЛП(ТБпXml), "restored Form.xml = БП");
Проверить(СтрНайти(ТRestXml, "ФлагУП") = 0, "в restored нет реквизита УП");

ТRestМ = ТекстФайла(П(Выход, "restored", "Catalogs\Спр\Forms\Оба\Ext\Form\Module.bsl"));
Проверить(СокрЛП(ТRestМ) = СокрЛП(МодульБп()), "restored Module.bsl = БП");
Проверить(СтрНайти(ТRestМ, "А = 1;") = 0, "в restored модуле нет доработки УП");

ТРасшXml = ТекстФайла(П(Выход, "extension", ОтнОба));
Проверить(СтрНайти(ТРасшXml, "ФлагУП") = 0, "в Form.xml extension нет реквизита УП (программный слой)");
Проверить(СтрНайти(ТекстФайла(П(Выход, "extension", "Catalogs\Спр.xml")), "Adopted") > 0, "объект заимствован");
Проверить(СтрНайти(ТекстФайла(П(Выход, "extension", "Catalogs\Спр.xml")), "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa") > 0, "InternalInfo из УП");
Проверить(СтрНайти(ТекстФайла(П(Выход, "extension", "Catalogs\Спр.xml")), "xmlns:xr=") > 0, "xmlns:xr у заимствованного объекта");
Проверить(СтрНайти(ТекстФайла(П(Выход, "extension", "Catalogs\Спр\Forms\Оба.xml")), "ExtendedConfigurationObject") > 0, "форма заимствована");
Проверить(СтрНайти(ТекстФайла(П(Выход, "extension", "Catalogs\Спр\Forms\Оба.xml")), "44444444-4444-4444-4444-444444444444") > 0, "UUID формы из УП");

ТРасшМ = ТекстФайла(П(Выход, "extension", "Catalogs\Спр\Forms\Оба\Ext\Form\Module.bsl"));
Проверить(СтрНайти(ТРасшМ, "УП_СоздатьЭлементыУП") > 0, "программный слой в модуле");
Проверить(СтрНайти(ТРасшМ, "&После(""ПриСозданииНаСервере"")") > 0 Или СтрНайти(ТРасшМ, "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")") > 0
	Или СтрНайти(ТРасшМ, "&Перед(""ПриСозданииНаСервере"")") > 0 Или СтрНайти(ТРасшМ, "&Вместо(""ПриСозданииНаСервере"")") > 0,
	"есть хук ПриСозданииНаСервере");
Проверить(Стат.programmatic >= 1, "programmatic=" + Стат.programmatic);
Проверить(Стат.hooksAuto + Стат.hooksAdded > 0, "есть авто-хук или новый метод: auto=" + Стат.hooksAuto + " added=" + Стат.hooksAdded);

// исходные выгрузки не изменены
Проверить(СтрНайти(ТекстФайла(ОбъединитьПути(Уп, ОтнОба)), "ФлагУП") > 0, "УП не тронут");
Проверить(СтрНайти(ТекстФайла(ОбъединитьПути(Бп, ОтнОба)), "ФлагУП") = 0, "БП не тронут");

ТОб = ТекстФайла(П(Выход, "extension", "Catalogs\Спр.xml"));
Проверить(СтрНайти(ТОб, "<Form>Оба</Form>") > 0, "ChildObjects содержит Оба");
Проверить(СтрНайти(ТОб, "<Form>ТолькоМодуль</Form>") > 0, "ChildObjects содержит ТолькоМодуль");

Список = П(Фикст, "module_only.txt");
Записать(Список, ОтнМод + Символы.ПС);
Проверить(Прот.ПрочитатьСписокФорм(Список).Количество() = 1, "ПрочитатьСписокФорм");
ВыходМ = П(Фикст, "out_mo");
СтатМ = Прот.СгенерироватьСрезФорм(Уп, Бп, ВыходМ, Прот.ПрочитатьСписокФорм(Список), "УП_");
Проверить(СтатМ.forms = 1, "module_only forms=" + СтатМ.forms);
Проверить(СтатМ.programmatic = 0, "module_only без программного слоя XML: " + СтатМ.programmatic);
Проверить(СтатМ.hooksAuto + СтатМ.hooksAdded > 0, "module_only хуки auto=" + СтатМ.hooksAuto);
Проверить(СтрНайти(ТекстФайла(П(ВыходМ, "extension", "Catalogs\Спр.xml")), "<Form>ТолькоМодуль</Form>") > 0, "module_only ChildObjects");
Проверить(СтрНайти(ТекстФайла(П(ВыходМ, "extension", "Catalogs\Спр.xml")), "<Form>Оба</Form>") = 0, "module_only срез без формы Оба");
Проверить(Не (Новый Файл(П(ВыходМ, "extension", ОтнМод))).Существует(), "module_only: в extension нет тела Form.xml");
Проверить((Новый Файл(П(ВыходМ, "extension", "Catalogs\Спр\Forms\ТолькоМодуль.xml"))).Существует(), "module_only: мета формы есть");
Проверить((Новый Файл(П(ВыходМ, "extension", "Catalogs\Спр\Forms\ТолькоМодуль\Ext\Form\Module.bsl"))).Существует(), "module_only: модуль с хуками есть");

ЦельВосст = П(Фикст, "overlay", "restored");
ЦельРасш = П(Фикст, "overlay", "extension");
Записать(П(ЦельВосст, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");
Записать(П(ЦельРасш, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<MetaDataObject>" + Символы.ПС
	+ "	<Configuration>" + Символы.ПС
	+ "		<ChildObjects>" + Символы.ПС
	+ "			<Language>Русский</Language>" + Символы.ПС
	+ "		</ChildObjects>" + Символы.ПС
	+ "	</Configuration>" + Символы.ПС
	+ "</MetaDataObject>" + Символы.ПС);
Записать(П(ЦельРасш, "Catalogs\Спр.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "Спр"));
СтатН = Прот.НаложитьСрезФорм(ВыходМ, ЦельВосст, ЦельРасш);
Проверить(СтатН.restoredCopied >= 1, "overlay restoredCopied=" + СтатН.restoredCopied);
Проверить(СтатН.objectsMerged = 1, "overlay objectsMerged=" + СтатН.objectsMerged);
Проверить(СтрНайти(ТекстФайла(П(ЦельРасш, "Catalogs\Спр.xml")), "<Form>ТолькоМодуль</Form>") > 0, "overlay дописал Form в существующий объект");
Проверить(СтрНайти(ТекстФайла(П(ЦельРасш, "Catalogs\\Спр.xml")), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa") > 0, "overlay не затёр существующий объект");
Проверить((Новый Файл(П(ЦельВосст, ОтнМод))).Существует(), "overlay скопировал Form.xml в restored");

// новый объект среза: InternalInfo берётся из restored
ОтнНов = "Catalogs\НовыйСпр\Forms\Форма\Ext\Form.xml";
Записать(П(ВыходМ, "restored", ОтнНов), XmlФормы(Ложь));
Записать(П(ВыходМ, "extension", "Catalogs\НовыйСпр.xml"), Прот.МетаЗаимствованногоОбъекта("Catalogs", "НовыйСпр", "cccccccc-cccc-cccc-cccc-cccccccccccc", Неопределено, ""));
Записать(П(ЦельВосст, "Catalogs\НовыйСпр.xml"), МетаОбъекта("cccccccc-cccc-cccc-cccc-cccccccccccc", "НовыйСпр", "22222222-cccc-cccc-cccc-cccccccccccc"));
СтатН2 = Прот.НаложитьСрезФорм(ВыходМ, ЦельВосст, ЦельРасш);
Проверить(СтатН2.objectsNew >= 1, "overlay objectsNew=" + СтатН2.objectsNew);
Проверить(СтрНайти(ТекстФайла(П(ЦельРасш, "Catalogs\НовыйСпр.xml")), "22222222-cccc-cccc-cccc-cccccccccccc") > 0, "overlay InternalInfo из restored");
Проверить(СтрНайти(ТекстФайла(П(ЦельРасш, "Catalogs\НовыйСпр.xml")), "Adopted") > 0, "новый объект заимствован");

Csv = П(Фикст, "mini.csv");
Записать(Csv, "rel,object,status,xmlDiff" + Символы.ПС
	+ """" + ОтнМод + """,""Catalogs\Спр"",module_only,0" + Символы.ПС
	+ """" + ОтнОба + """,""Catalogs\Спр"",both_differ,1" + Символы.ПС);
ПутCsv = Прот.ПутиПоСтатусуИзCsv(Csv, "module_only");
Проверить(ПутCsv.Количество() = 1, "csv module_only count=" + ПутCsv.Количество());
Проверить(ПутCsv[0] = ОтнМод, "csv module_only path");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_forms_bp_proto: " + Ошибок + " failures";
КонецЕсли;
Сообщить("OK test_forms_bp_proto");
