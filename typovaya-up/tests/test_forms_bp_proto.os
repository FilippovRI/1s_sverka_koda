ПоложитьФормуВ(УпТп, "СпрТп", "ФормаТп", XmlУпТп, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa97");
ПоложитьФормуВ(БпТп, "СпрТп", "ФормаТп", XmlБпТп, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa97");
ОтнТп = "Catalogs\СпрТп\Forms\ФормаТп\Ext\Form.xml";
