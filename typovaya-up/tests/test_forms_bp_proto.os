// QueryText на ТЧ только БП, но имя есть в модуле формы БП — шаг метаданных БП добавит ТЧ, форму не вырезаем.
УпКд = П(Фикст, "up_qref");
БпКд = П(Фикст, "bp_qref");
ВыходКд = П(Фикст, "out_qref");
Записать(П(УпКд, "Catalogs", "СпрКд.xml"), МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa81", "СпрКд"));
МетаБпКд = СтрЗаменить(МетаОбъекта("aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa81", "СпрКд"), "</Catalog>",
	"		<ChildObjects>" + Символы.ПС
	+ "			<TabularSection uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa83"">" + Символы.ПС
	+ "				<Properties><Name>ТабличнаяЧастьТолькоБп</Name></Properties>" + Символы.ПС
	+ "			</TabularSection>" + Символы.ПС
	+ "		</ChildObjects>" + Символы.ПС
	+ "	</Catalog>");
Записать(П(БпКд, "Catalogs", "СпрКд.xml"), МетаБпКд);
МодульКд = СтрЗаменить(МодульБп(), "	Б = 1;", "	А = Объект.ТабличнаяЧастьТолькоБп.Количество();");
XmlУпКд = XmlФормы(Ложь, "СпрКд");
XmlБпКд = СтрЗаменить(XmlФормы(Ложь, "СпрКд"), "</Attributes>",
	"		<Attribute name=""Список"" id=""2"">" + Символы.ПС
	+ "			<Type/>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "	<ChildItems>" + Символы.ПС
	+ "		<Table name=""Список"" id=""10"">" + Символы.ПС
	+ "			<DataPath>Список</DataPath>" + Символы.ПС
	+ "			<DataSource>" + Символы.ПС
	+ "				<MainTable>Catalog.СпрКд</MainTable>" + Символы.ПС
	+ "				<ManualQuery>true</ManualQuery>" + Символы.ПС
	+ "				<QueryText>ВЫБРАТЬ СправочникСпрКд.Ссылка, СправочникСпрКд.ТабличнаяЧастьТолькоБп ИЗ Справочник.СпрКд КАК СправочникСпрКд</QueryText>" + Символы.ПС
	+ "			</DataSource>" + Символы.ПС
	+ "		</Table>" + Символы.ПС
	+ "	</ChildItems>");
ПоложитьФормуВ(УпКд, "СпрКд", "ФормаКд", XmlУпКд, МодульБп(), "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa82");
ПоложитьФормуВ(БпКд, "СпрКд", "ФормаКд", XmlБпКд, МодульКд, "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaa82");
ОтнКд = "Catalogs\СпрКд\Forms\ФормаКд\Ext\Form.xml";
ФильтрКд = Новый Массив;
ФильтрКд.Добавить(ОтнКд);
СтатКд = Прот.СгенерироватьСрезФорм(УпКд, БпКд, ВыходКд, ФильтрКд, "УП_");
Проверить(СтатКд.forms = 1, "qref forms=" + СтатКд.forms);
Проверить(СтатКд.skipped = 0, "qref skipped=" + СтатКд.skipped);
Проверить((Новый Файл(П(ВыходКд, "restored", ОтнКд))).Существует(), "форма с ТЧ, на которую есть ссылка из кода, остаётся в срезе");


