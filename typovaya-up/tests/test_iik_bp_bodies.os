// Подмена тел ИиК-методов в restored на тела БП и перестройка ИиК как БП→УП.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда
		Р = ОбъединитьПути(Р, П3);
	КонецЕсли;
	Если П4 <> "" Тогда
		Р = ОбъединитьПути(Р, П4);
	КонецЕсли;
	Если П5 <> "" Тогда
		Р = ОбъединитьПути(Р, П5);
	КонецЕсли;
	Если П6 <> "" Тогда
		Р = ОбъединитьПути(Р, П6);
	КонецЕсли;
	Если П7 <> "" Тогда
		Р = ОбъединитьПути(Р, П7);
	КонецЕсли;
	Если П8 <> "" Тогда
		Р = ОбъединитьПути(Р, П8);
	КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция ТекстФайла(Путь)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), КодировкаТекста.UTF8);
КонецФункции

Функция XmlФормы(Вид)
	// Вид: "typ" — без РеквУп, с командой-обработчиком; "up" — +РеквУп; "bp" — только Объект
	Т = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:CatalogObject.СпрИиК</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>";
	Если Вид = "up" Тогда
		Т = Т + Символы.ПС
			+ "		<Attribute name=""РеквУп"" id=""2"">" + Символы.ПС
			+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
			+ "		</Attribute>";
	КонецЕсли;
	Т = Т + Символы.ПС + "	</Attributes>";
	Если Вид <> "bp" Тогда
		Т = Т + Символы.ПС
			+ "	<Commands>" + Символы.ПС
			+ "		<Command name=""КомандаУп"" id=""20"">" + Символы.ПС
			+ "			<Action>ОбработчикУп</Action>" + Символы.ПС
			+ "		</Command>" + Символы.ПС
			+ "	</Commands>";
	КонецЕсли;
	Возврат Т + Символы.ПС + "</Form>" + Символы.ПС;
КонецФункции

Функция МетаСпр(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">" + Символы.ПС
		+ "	<Catalog uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties><Name>СпрИиК</Name></Properties>" + Символы.ПС
		+ "		<ChildObjects><Form>ФормаЭлемента</Form></ChildObjects>" + Символы.ПС
		+ "	</Catalog>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МетаФормы(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">" + Символы.ПС
		+ "	<Form uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties><Name>ФормаЭлемента</Name></Properties>" + Символы.ПС
		+ "	</Form>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция КонфРасш()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" version=""2.21"">" + Символы.ПС
		+ "	<Configuration uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"">" + Символы.ПС
		+ "		<InternalInfo/>" + Символы.ПС
		+ "		<Properties><Name>УП_Доработки</Name></Properties>" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "		</ChildObjects>" + Символы.ПС
		+ "	</Configuration>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МодульУпТел()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	ОбщегоНазначенияНСК.Вызвать();" + Символы.ПС
		+ "	ВспомогательныйУп();" + Символы.ПС
		+ "	РеквУп = Истина;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ПриЧтенииНаСервере(ТекущийОбъект)" + Символы.ПС
		+ "	ОбщегоНазначенияНСК.Вызвать();" + Символы.ПС
		+ "	ПомощникУп();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ВспомогательныйУп()" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ПомощникУп()" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаКлиенте" + Символы.ПС
		+ "Процедура ОбработчикУп(Команда)" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Функция МодульБп()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	Б = 1;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ПриЧтенииНаСервере(ТекущийОбъект)" + Символы.ПС
		+ "	ТолькоВБп();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ТолькоВБп()" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Процедура ВыложитьДерево(КореньД, ВидФормы, ТекстМодуля)
	Записать(П(КореньД, "Catalogs", "СпрИиК.xml"), МетаСпр("11111111-1111-1111-1111-111111111111"));
	Записать(П(КореньД, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента.xml"), МетаФормы("22222222-2222-2222-2222-222222222222"));
	Записать(П(КореньД, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlФормы(ВидФормы));
	Записать(П(КореньД, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), ТекстМодуля);
КонецПроцедуры

Функция ЕстьВМассивеЛокально(Массив, Значение)
	Для Каждого Э Из Массив Цикл
		Если Э = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Ошибок = 0;
Корень = ОбъединитьПути(КаталогВременныхФайлов(), "tu_iik_bp_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
ТипК = П(Корень, "typovaya");
УпК = П(Корень, "up");
БпК = П(Корень, "bp");
Расш = П(Корень, "extension");
Восст = П(Корень, "restored");
Отн = "Catalogs\СпрИиК\Forms\ФормаЭлемента\Ext\Form.xml";


ВыложитьДерево(ТипК, "typ", "ОбщегоНазначенияНСК.ИнитМодуля();" + Символы.ПС + Символы.ПС + МодульУпТел());
Записать(П(ТипК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
ВыложитьДерево(УпК, "up", МодульУпТел());
Записать(П(УпК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
Записать(П(УпК, "CommonModules", "ОбщегоНазначенияНСК.xml"), "<MetaDataObject/>");
ВыложитьДерево(БпК, "bp", МодульБп());
Записать(П(БпК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
Записать(П(Расш, "Configuration.xml"), КонфРасш());

Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));
Список = Новый Массив;
Список.Добавить(Отн);
Рез0 = Модуль.Применить(ТипК, УпК, Расш, Список, Новый Массив, П(Корень, "report0"));
Проверить(Рез0.closed.Количество() = 2, "Применить: два метода ИиК");

// restored — копия typovaya (УП-тела), как в срезе meta56
ТекстТипМ = ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
ТекстТипФ = ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml"));
ТекстБпМ = ТекстФайла(П(БпК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Записать(П(Восст, "Catalogs", "СпрИиК.xml"), МетаСпр("11111111-1111-1111-1111-111111111111"));
Записать(П(Восст, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента.xml"), МетаФормы("22222222-2222-2222-2222-222222222222"));
Записать(П(Восст, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlФормы("typ"));
Записать(П(Восст, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), ТекстТипМ);
Записать(П(Восст, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Configuration uuid=""bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb""><ChildObjects></ChildObjects></Configuration></MetaDataObject>");
Записать(П(Восст, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");

ИиКДо = ТекстФайла(П(Расш, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Лог = Новый Массив;
Рез = Модуль.ЗаменитьТелаRestoredНаБп(ТипК, УпК, БпК, Восст, Расш, Список, Лог, П(Корень, "report"));

Проверить(ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ТекстТипМ, "источник typovaya не изменён");
Проверить(ТекстФайла(П(БпК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ТекстБпМ, "выгрузка БП не изменена");

МВосст = ТекстФайла(П(Восст, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(СтрНайти(МВосст, "Б = 1;") > 0, "в restored тело БП для ПриСозданииНаСервере");
Проверить(СтрНайти(МВосст, "ОбщегоНазначенияНСК.Вызвать();") > 0, "небезопасный метод ПриЧтенииНаСервере остался с УП-телом");
Проверить(СтрНайти(МВосст, "ВспомогательныйУп();") = 0, "вызов UP-only убран вместе с безопасным телом");
Проверить(СтрНайти(МВосст, "Процедура ВспомогательныйУп()") = 0, "UP-only метод удалён из restored");
Проверить(СтрНайти(МВосст, "Процедура ПомощникУп()") > 0, "UP-only, вызываемый из оставшегося УП-тела, оставлен в restored");
Проверить(СтрНайти(МВосст, "Процедура ОбработчикУп(") > 0, "обработчик Form.xml оставлен в restored");
Проверить(СтрНайти(МВосст, "ТолькоВБп();") = 0, "небезопасное тело БП не записано в restored");

МРасш = ТекстФайла(П(Расш, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(СтрНайти(МРасш, "Б = 1;") > 0, "ИиК #Удаление содержит тело БП");
Проверить(СтрНайти(МРасш, "ВспомогательныйУп();") > 0, "ИиК #Вставка содержит тело УП");
Проверить(СтрНайти(МРасш, "Процедура ВспомогательныйУп()") > 0, "UP-only метод остался в расширении");
Проверить(СтрНайти(МРасш, "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")") > 0, "ИиК ПриСозданииНаСервере");
Проверить(СтрНайти(МРасш, "&ИзменениеИКонтроль(""ПриЧтенииНаСервере"")") > 0, "ИиК ПриЧтенииНаСервере сохранён");
// старый ИиК ПриЧтенииНаСервере (УП→УП) не должен получить тело БП
ПозЧт = СтрНайти(МРасш, "&ИзменениеИКонтроль(""ПриЧтенииНаСервере"")");
ПозСозд = СтрНайти(МРасш, "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")");
Проверить(ПозЧт > 0, "есть ИиК ПриЧтенииНаСервере");
ФрагЧт = Сред(МРасш, ПозЧт, 400);
Проверить(СтрНайти(ФрагЧт, "ТолькоВБп();") = 0, "ИиК небезопасного метода не перестраивался от БП");
Проверить(СтрНайти(ФрагЧт, "ОбщегоНазначенияНСК.Вызвать();") > 0, "ИиК небезопасного метода оставлен прежним");

ТодоНебез = Ложь;
Для Каждого СтрТ Из Рез.todo Цикл
	Если СтрНайти(СтрТ, "ПриЧтенииНаСервере") > 0 Тогда
		ТодоНебез = Истина;
	КонецЕсли;
КонецЦикла;
Проверить(ТодоНебез, "небезопасное тело БП в todo");
Проверить(ЕстьВМассивеЛокально(Рез.replaced, "ПриСозданииНаСервере"), "ПриСозданииНаСервере в replaced");
Проверить(Не ЕстьВМассивеЛокально(Рез.replaced, "ПриЧтенииНаСервере"), "ПриЧтенииНаСервере не в replaced");
Проверить(ЕстьВМассивеЛокально(Рез.removed, "ВспомогательныйУп"), "ВспомогательныйУп удалён");

Рез2 = Модуль.ЗаменитьТелаRestoredНаБп(ТипК, УпК, БпК, Восст, Расш, Список, Новый Массив, "");
М2 = ТекстФайла(П(Восст, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(М2 = МВосст, "повторный запуск идемпотентен (restored)");
Проверить(ТекстФайла(П(Расш, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = МРасш, "повторный запуск идемпотентен (extension)");
Проверить(ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ТекстТипМ, "typovaya не изменён после 2-го запуска");

// отказ писать в защищённый путь
РезЗ = Модуль.ЗаменитьТелаRestoredНаБп(ТипК, УпК, БпК, "D:\выгрузка БП", Расш, Список, Новый Массив, "");
Проверить(РезЗ.replaced.Количество() = 0, "защищённый restored не изменился");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_bp_bodies");
Иначе
	Сообщить("FAILED test_iik_bp_bodies: " + Ошибок);
	Для Каждого С Из Лог Цикл
		Сообщить(С);
	КонецЦикла;
	Сообщить("todo:");
	Для Каждого С Из Рез.todo Цикл
		Сообщить("  " + С);
	КонецЦикла;
	Сообщить("handlers:");
	Для Каждого С Из Рез.handlers Цикл
		Сообщить("  " + С);
	КонецЦикла;
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));
