// Перенос ОМ только УП через &ИзменениеИКонтроль typovaya→УП в расширение. Typovaya не меняется.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда
		Р = ОбъединитьПути(Р, П3);
	КонецЕсли;
	Если П4 <> "" Тогда
		Р = ОбъединитьПути(Р, П4);
	КонецЕсли;
	Если П5 <> "" Тогда
		Р = ОбъединитьПути(Р, П5);
	КонецЕсли;
	Если П6 <> "" Тогда
		Р = ОбъединитьПути(Р, П6);
	КонецЕсли;
	Если П7 <> "" Тогда
		Р = ОбъединитьПути(Р, П7);
	КонецЕсли;
	Если П8 <> "" Тогда
		Р = ОбъединитьПути(Р, П8);
	КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция ТекстФайла(Путь)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), КодировкаТекста.UTF8);
КонецФункции

Функция XmlФормы(СРеквизитомУп)
	Т = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:CatalogObject.СпрИиК</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>";
	Если СРеквизитомУп Тогда
		Т = Т + Символы.ПС
			+ "		<Attribute name=""РеквУп"" id=""2"">" + Символы.ПС
			+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
			+ "		</Attribute>";
	КонецЕсли;
	Возврат Т + Символы.ПС + "	</Attributes>" + Символы.ПС + "</Form>" + Символы.ПС;
КонецФункции

Функция МетаСпр(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">" + Символы.ПС
		+ "	<Catalog uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties>" + Символы.ПС
		+ "			<Name>СпрИиК</Name>" + Символы.ПС
		+ "		</Properties>" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "			<Form>ФормаЭлемента</Form>" + Символы.ПС
		+ "		</ChildObjects>" + Символы.ПС
		+ "	</Catalog>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МетаФормы(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">" + Символы.ПС
		+ "	<Form uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties>" + Символы.ПС
		+ "			<Name>ФормаЭлемента</Name>" + Символы.ПС
		+ "		</Properties>" + Символы.ПС
		+ "	</Form>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция КонфРасш()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" version=""2.21"">" + Символы.ПС
		+ "	<Configuration uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"">" + Символы.ПС
		+ "		<InternalInfo/>" + Символы.ПС
		+ "		<Properties>" + Символы.ПС
		+ "			<Name>УП_Доработки</Name>" + Символы.ПС
		+ "		</Properties>" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "		</ChildObjects>" + Символы.ПС
		+ "	</Configuration>" + Символы.ПС
		+ "</MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МодульТип()
	Возврат "ОбщегоНазначенияНСК.ИнитМодуля();" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	ОбщегоНазначенияНСК.Вызвать();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Функция МодульУп()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	ОбщегоНазначенияНСК.Вызвать();" + Символы.ПС
		+ "	ВспомогательныйУп();" + Символы.ПС
		+ "	РеквУп = Истина;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ВспомогательныйУп()" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Ошибок = 0;
Корень = ОбъединитьПути(КаталогВременныхФайлов(), "tu_iik_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
ТипК = П(Корень, "typovaya");
УпК = П(Корень, "up");
Расш = П(Корень, "extension");
Отн = "Catalogs\СпрИиК\Forms\ФормаЭлемента\Ext\Form.xml";

Записать(П(ТипК, "Catalogs", "СпрИиК.xml"), МетаСпр("11111111-1111-1111-1111-111111111111"));
Записать(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента.xml"), МетаФормы("22222222-2222-2222-2222-222222222222"));
Записать(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlФормы(Ложь));
Записать(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульТип());
Записать(П(ТипК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");

Записать(П(УпК, "Catalogs", "СпрИиК.xml"), МетаСпр("11111111-1111-1111-1111-111111111111"));
Записать(П(УпК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента.xml"), МетаФормы("22222222-2222-2222-2222-222222222222"));
Записать(П(УпК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlФормы(Истина));
Записать(П(УпК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульУп());
Записать(П(УпК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
Записать(П(УпК, "CommonModules", "ОбщегоНазначенияНСК.xml"), "<MetaDataObject/>");

Записать(П(Расш, "Configuration.xml"), КонфРасш());

ХешТипМ = ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
ХешТипФ = ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml"));

Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));
Список = Новый Массив;
Список.Добавить(Отн);
Лог = Новый Массив;
Рез = Модуль.Применить(ТипК, УпК, Расш, Список, Лог, П(Корень, "report"));

Проверить(ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ХешТипМ, "модуль typovaya не изменён");
Проверить(ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml")) = ХешТипФ, "Form.xml typovaya не изменён");

ПутьМетаФ = П(Расш, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента.xml");
Проверить((Новый Файл(ПутьМетаФ)).Существует(), "заимствована мета формы");
МетаФ = ТекстФайла(ПутьМетаФ);
Проверить(СтрНайти(МетаФ, "<ObjectBelonging>Adopted</ObjectBelonging>") > 0, "форма Adopted");
Проверить(СтрНайти(МетаФ, "<ExtendedConfigurationObject>22222222-2222-2222-2222-222222222222</ExtendedConfigurationObject>") > 0, "уид формы typovaya");

ПутьМетаО = П(Расш, "Catalogs", "СпрИиК.xml");
Проверить((Новый Файл(ПутьМетаО)).Существует(), "заимствована мета объекта");
Проверить(СтрНайти(ТекстФайла(ПутьМетаО), "<Form>ФормаЭлемента</Form>") > 0, "форма в ChildObjects");
Проверить(СтрНайти(ТекстФайла(П(Расш, "Configuration.xml")), "<Catalog>СпрИиК</Catalog>") > 0, "узел Catalog в Configuration.xml");

ПутьМРасш = П(Расш, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl");
Проверить((Новый Файл(ПутьМРасш)).Существует(), "модуль формы расширения");
МТекст = ТекстФайла(ПутьМРасш);
Проверить(СтрНайти(МТекст, "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (ОМ только УП)") > 0, "маркер ИиК");
Проверить(СтрНайти(МТекст, "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")") > 0, "директива ИиК с именем typovaya");
Проверить(СтрНайти(МТекст, "#Удаление") > 0 И СтрНайти(МТекст, "#Вставка") > 0, "блоки #Удаление/#Вставка");
Проверить(СтрНайти(МТекст, "ВспомогательныйУп();") > 0, "тело УП в #Вставка");
Проверить(СтрНайти(МТекст, "Процедура ВспомогательныйУп()") > 0, "UP-only метод добавлен без префикса");
Проверить(СтрНайти(МТекст, "Процедура УП_ПриСозданииНаСервере") = 0, "имя typovaya без префикса УП_");

ПутьФРасш = П(Расш, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form.xml");
Проверить((Новый Файл(ПутьФРасш)).Существует(), "Form.xml расширения");
Проверить(СтрНайти(ТекстФайла(ПутьФРасш), "name=""РеквУп""") > 0, "реквизит РеквУп в Form.xml расширения");

ТодоЕсть = Ложь;
Для Каждого СтрТ Из Рез.todo Цикл
	Если СтрНайти(СтрТ, "вне процедур") > 0 Тогда
		ТодоЕсть = Истина;
	КонецЕсли;
КонецЦикла;
Проверить(ТодоЕсть, "код вне процедур в todo");
Проверить(Рез.closed.Количество() = 1, "один метод ИиК");
Проверить(Рез.moved.Количество() = 1, "один UP-only метод");

Рез2 = Модуль.Применить(ТипК, УпК, Расш, Список, Новый Массив, "");
М2 = ТекстФайла(ПутьМРасш);
Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (ОМ только УП)";
Сч = 0;
Поз = 1;
Пока Поз > 0 Цикл
	Н = СтрНайти(М2, Маркер, , Поз);
	Если Н = 0 Тогда
		Прервать;
	КонецЕсли;
	Сч = Сч + 1;
	Поз = Н + СтрДлина(Маркер);
КонецЦикла;
Проверить(Сч = 1, "повторный запуск идемпотентен (один маркер)");
Проверить(СтрЧислоВхождений(М2, "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")") = 1, "нет дубля ИиК");
Проверить(ТекстФайла(П(ТипК, "Catalogs", "СпрИиК", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ХешТипМ, "typovaya не изменён после 2-го запуска");

Если Ошибок = 0 Тогда
	Сообщить("OK test_transfer_iik");
Иначе
	Сообщить("FAILED test_transfer_iik: " + Ошибок);
	Для Каждого С Из Лог Цикл
		Сообщить(С);
	КонецЦикла;
	Сообщить("todo:");
	Для Каждого С Из Рез.todo Цикл
		Сообщить("  " + С);
	КонецЦикла;
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));
