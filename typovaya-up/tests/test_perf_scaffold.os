// Крупная синтетика: массовое копирование каркаса и паритет shell vs рекурсия.

Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Exec(Стр)
	Код = 0;
	ЗапуститьПриложение(Стр, "", Истина, Код);
	Возврат Код;
КонецФункции

Процедура ЗаписатьBom(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Д = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8NoBOM);
	Д.Записать(Путь);
КонецПроцедуры

Каталог = ТекущийСценарий().Каталог;
КореньСк = ОбъединитьПути(Каталог, "..", "src");
Копир = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "КопированиеВыгрузки.os"));
База = ОбъединитьПути(Каталог, "_perf_scaffold_src");
Если (Новый Файл(База)).Существует() Тогда
	УдалитьФайлы(База);
КонецЕсли;
СоздатьКаталог(База);
ЗаписатьBom(ОбъединитьПути(База, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");

N = 120;
Для i = 0 По N - 1 Цикл
	Имя = "Спр" + Формат(i + 1, "ЧЦ=3; ЧВН=");
	Кат = ОбъединитьПути(ОбъединитьПути(База, "Catalogs"), Имя);
	СоздатьКаталог(ОбъединитьПути(Кат, "Ext"));
	ЗаписатьBom(ОбъединитьПути(Кат, Имя + ".xml"), "<Meta/>");
	ЗаписатьBom(ОбъединитьПути(Кат, "Ext", "ObjectModule.bsl"), "// " + Имя);
	КатФ = ОбъединитьПути(ОбъединитьПути(Кат, "Forms"), "Ф");
	СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(КатФ, "Ext"), "Form"));
	ЗаписатьBom(ОбъединитьПути(КатФ, "Ф.xml"), "<Form/>");
КонецЦикла;

КудаА = ОбъединитьПути(Каталог, "_perf_scaffold_a");
КудаБ = ОбъединитьПути(Каталог, "_perf_scaffold_b");
МкКопий = Новый Массив;
МкКопий.Добавить(КудаА);
МкКопий.Добавить(КудаБ);
Для Каждого К Из МкКопий Цикл
	Если (Новый Файл(К)).Существует() Тогда
		УдалитьФайлы(К);
	КонецЕсли;
КонецЦикла;

Лог = Новый Массив;
Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
Сп = Копир.СкопироватьДерево(База, КудаА, Лог);
МсБыстро = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
П(Сп = "shell" Или Сп = "recursive", "способ копирования");

Т1 = ТекущаяУниверсальнаяДатаВМиллисекундах();
Копир.СкопироватьРекурсивно(База, КудаБ);
МсМед = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т1;
Сообщить("perf scaffold: shell/rec " + МсБыстро + " ms, recursive " + МсМед + " ms");

П(Exec("diff -qr " + """" + КудаА + """" + " " + """" + КудаБ + """") = 0, "diff копий A/B");

Если Ошибок > 0 Тогда
	ЗавершитьРаботу(1);
КонецЕсли;
Сообщить("OK test_perf_scaffold");