// Тело БП небезопасно, если использует реквизит, которого в typovaya нет (есть только ChildItem).
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда Р = ОбъединитьПути(Р, П3); КонецЕсли;
	Если П4 <> "" Тогда Р = ОбъединитьПути(Р, П4); КонецЕсли;
	Если П5 <> "" Тогда Р = ОбъединитьПути(Р, П5); КонецЕсли;
	Если П6 <> "" Тогда Р = ОбъединитьПути(Р, П6); КонецЕсли;
	Если П7 <> "" Тогда Р = ОбъединитьПути(Р, П7); КонецЕсли;
	Если П8 <> "" Тогда Р = ОбъединитьПути(Р, П8); КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Ошибок = 0;
Кат = П(ТекущийСценарий().Каталог, "_iik_bp_form_attrs_tmp");
ТипФ = П(Кат, "typ", "Form.xml");
БпФ = П(Кат, "bp", "Form.xml");
XmlТип = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
	+ "	<Attributes/>" + Символы.ПС
	+ "	<Commands/>" + Символы.ПС
	+ "	<ChildItems>" + Символы.ПС
	+ "		<RadioButtonField name=""НалоговаяЛьгота"" id=""31"">" + Символы.ПС
	+ "			<DataPath>ПараметрыТорговыхТочек.КодНалоговойЛьготы</DataPath>" + Символы.ПС
	+ "		</RadioButtonField>" + Символы.ПС
	+ "	</ChildItems>" + Символы.ПС
	+ "</Form>" + Символы.ПС;
XmlБп = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
	+ "	<Attributes>" + Символы.ПС
	+ "		<Attribute name=""НалоговаяЛьгота"" id=""16"">" + Символы.ПС
	+ "			<Type><v8:Type>xs:string</v8:Type></Type>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "	<Commands/>" + Символы.ПС
	+ "	<ChildItems/>" + Символы.ПС
	+ "</Form>" + Символы.ПС;
Записать(ТипФ, XmlТип);
Записать(БпФ, XmlБп);

Прот = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ФормыБпПрототип.os"));
ТелоГолое = "	Код = КодЛьготы(НалоговаяЛьгота);";
Прич = Прот.ПричинаТелоБпНебезопасноДляTypovaya(ТелоГолое, "", ТелоГолое, ТипФ, БпФ, "");
Проверить(СтрНайти(Прич, "НалоговаяЛьгота") > 0, "голое имя typovaya-элемента небезопасно: " + Прич);

ТелоЭл = "	Элементы.НалоговаяЛьгота.СписокВыбора.Очистить();";
ПричЭл = Прот.ПричинаТелоБпНебезопасноДляTypovaya(ТелоЭл, "", ТелоЭл, ТипФ, БпФ, "");
Проверить(ПричЭл = "", "доступ через Элементы.НалоговаяЛьгота безопасен: " + ПричЭл);

ТипФ2 = П(Кат, "typ2", "Form.xml");
БпФ2 = П(Кат, "bp2", "Form.xml");
XmlТип2 = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
	+ "	<Attributes/>" + Символы.ПС
	+ "	<Commands/>" + Символы.ПС
	+ "	<ChildItems>" + Символы.ПС
	+ "		<LabelField name=""Сотрудник"" id=""10""/>" + Символы.ПС
	+ "		<LabelField name=""Организация"" id=""11""/>" + Символы.ПС
	+ "	</ChildItems>" + Символы.ПС
	+ "</Form>" + Символы.ПС;
XmlБп2 = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
	+ "	<Attributes>" + Символы.ПС
	+ "		<Attribute name=""Сотрудник"" id=""20""/>" + Символы.ПС
	+ "		<Attribute name=""Организация"" id=""21""/>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "	<Commands/>" + Символы.ПС
	+ "	<ChildItems>" + Символы.ПС
	+ "		<LabelField name=""Сотрудник"" id=""10""/>" + Символы.ПС
	+ "		<LabelField name=""Организация"" id=""11""/>" + Символы.ПС
	+ "	</ChildItems>" + Символы.ПС
	+ "</Form>" + Символы.ПС;
Записать(ТипФ2, XmlТип2);
Записать(БпФ2, XmlБп2);
ТелоОтбор = "	Если Параметры.Отбор.Свойство(""Организация"") Тогда" + Символы.ПС
	+ "		Запрос.УстановитьПараметр(""Организация"", Параметры.Отбор.Организация);" + Символы.ПС
	+ "	Иначе" + Символы.ПС
	+ "		Запрос.УстановитьПараметр(""Организация"", Справочники.Организации.ПустаяСсылка());" + Символы.ПС
	+ "	КонецЕсли;" + Символы.ПС
	+ "	Если Параметры.Отбор.Свойство(""Сотрудник"") Тогда" + Символы.ПС
	+ "		Запрос.УстановитьПараметр(""Сотрудник"", Параметры.Отбор.Сотрудник);" + Символы.ПС
	+ "	КонецЕсли;";
ПричОтбор = Прот.ПричинаТелоБпНебезопасноДляTypovaya(ТелоОтбор, "", ТелоОтбор, ТипФ2, БпФ2, "");
Проверить(ПричОтбор = "", "Параметры.Отбор.Организация/Сотрудник не реквизит формы: " + ПричОтбор);

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_bp_form_attrs");
Иначе
	Сообщить("FAILED test_iik_bp_form_attrs: " + Ошибок);
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));