Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция Т(З) Возврат СтрЗаменить(З, "|", Символы.ПС); КонецФункции

Функция КаталогТеста()
	К = ОбъединитьПути(КаталогВременныхФайлов(), "typovaya-up-export-added");
	УдалитьКаталогТихо(К);
	СоздатьКаталог(К);
	СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(К, "extension"), "CommonModules"), "Мод"), "Ext"));
	СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(К, "restored"), "CommonModules"), "Мод"), "Ext"));
	Возврат К;
КонецФункции

Процедура УдалитьКаталогТихо(К)
	Ф = Новый Файл(К);
	Если Ф.Существует() Тогда
		УдалитьФайлы(К);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьМодуль(КореньВыхода, Ветка, Текст)
	Путь = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньВыхода, Ветка), "CommonModules"), "Мод"), "Ext"), "Module.bsl");
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8NoBOM);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Функция ПрочитатьМодуль(КореньВыхода, Ветка)
	Путь = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньВыхода, Ветка), "CommonModules"), "Мод"), "Ext"), "Module.bsl");
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Ткст = Ч.Прочитать();
	Ч.Закрыть();
	Возврат Ткст;
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Ошибок = 0;

Восст = Т("Процедура Публичная() Экспорт|	А = 1;|КонецПроцедуры||"
	+ "Процедура Тайная()|	Возврат;|КонецПроцедуры||"
	+ "Процедура Много(|	А,|	Б)|	Возврат;|КонецПроцедуры||"
	+ "Процедура СКомментарием() // хвост|	Возврат;|КонецПроцедуры||"
	+ "Процедура НеВызывают()|	Возврат;|КонецПроцедуры");
Расш = Т("&ИзменениеИКонтроль(""Хук"")|Процедура УП_Хук() Экспорт|"
	+ "	Тайная();|	СКомментарием();|#Удаление|	Публичная();|#КонецУдаления|"
	+ "#Вставка|	Много(1, 2);|#КонецВставки|КонецПроцедуры");

К = КаталогТеста();
ЗаписатьМодуль(К, "restored", Восст);
ЗаписатьМодуль(К, "extension", Расш);
Р = Доз.ОбработатьКаталогВыхода(К);
П(Р.count = 3, "count=3 (Тайная, Много, СКомментарием), got " + Р.count);
Имена = "";
Для Каждого Э Из Р.items Цикл
	Имена = Имена + "," + Э.name;
	П(Э.path = "CommonModules\Мод\Ext\Module.bsl" Или Э.path = "CommonModules/Мод/Ext/Module.bsl", "path " + Э.path);
КонецЦикла;
П(СтрНайти(Имена, "Тайная") > 0, "item Тайная");
П(СтрНайти(Имена, "Много") > 0, "item Много");
П(СтрНайти(Имена, "СКомментарием") > 0, "item СКомментарием");
П(СтрНайти(Имена, "Публичная") = 0, "Публичная already exported");
П(СтрНайти(Имена, "НеВызывают") = 0, "НеВызывают not called");

Н = ПрочитатьМодуль(К, "restored");
П(СтрНайти(Н, "Процедура Публичная() Экспорт") > 0, "Публичная unchanged");
П(СтрНайти(Н, "Процедура Тайная() Экспорт") > 0, "Тайная exported");
П(СтрНайти(Н, "	Возврат;") > 0 И СтрНайти(Н, Т("Процедура Тайная() Экспорт|	Возврат;")) > 0, "Тайная body unchanged");
П(СтрНайти(Н, Т("	Б) Экспорт")) > 0, "multiline ) Экспорт");
П(СтрНайти(Н, "Процедура СКомментарием() Экспорт // хвост") > 0, "comment kept after Экспорт");
П(СтрНайти(Н, "Процедура НеВызывают() Экспорт") = 0, "НеВызывают no export");

П((Новый Файл(ОбъединитьПути(К, "export_added.json"))).Существует(), "json written");
Р2 = Доз.ОбработатьКаталогВыхода(К);
П(Р2.count = 0, "idempotent second run");

УдалитьКаталогТихо(К);
Если Ошибок = 0 Тогда Сообщить("OK: export added"); Иначе ЗавершитьРаботу(1); КонецЕсли;