Shell = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ЗапускShell.os"));
Р = Shell.ИсполнитьCmd("cmd /c exit /b 7");
Если ТипЗнч(Р.exitCode) <> Тип("Число") Тогда
	ВызватьИсключение "exitCode not number";
КонецЕсли;
Если Р.exitCode <> 7 Тогда
	ВызватьИсключение "expected 7 got " + Р.exitCode;
КонецЕсли;
Сообщить("OK test_shell");