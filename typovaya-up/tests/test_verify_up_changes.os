// verify_up_changes.os: независимая сверка доработок УП (restored / extension / todo / ПОТЕРЯНО).
Перем Ошибок;



Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Функция Конф(Объекты)
	Т = "<MetaDataObject>" + Символы.ПС + "	<Configuration>" + Символы.ПС + "		<ChildObjects>" + Символы.ПС;
	Для Каждого О Из СтрРазделить(Объекты, ",", Ложь) Цикл
		Ч = СтрРазделить(СокрЛП(О), ".", Ложь);
		Т = Т + "			<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">" + Символы.ПС;
	КонецЦикла;
	Возврат Т + "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "scripts");
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_verify_" + Строка(Новый УникальныйИдентификатор));
Уп = ОбъединитьПути(Вр, "up");
Бп = ОбъединитьПути(Вр, "bp");
Вых = ОбъединитьПути(Вр, "out");
Осн = ОбъединитьПути(Вых, "restored");
Расш = ОбъединитьПути(Вых, "extension");
ПС = Символы.ПС;
Зап(ОбъединитьПути(Уп, "Configuration.xml"), Конф("CommonModule.Общ,CommonModule.УпОм,DataProcessor.ОбрУп,Report.ОтчУп,Catalog.Спр,Document.ДокУп"));
Зап(ОбъединитьПути(Бп, "Configuration.xml"), Конф("CommonModule.Общ,Catalog.Спр"));
Зап(ОбъединитьПути(Осн, "Configuration.xml"), Конф("CommonModule.Общ,Catalog.Спр,Document.ДокУп"));
Зап(ОбъединитьПути(Расш, "Configuration.xml"), Конф("CommonModule.УпОм,CommonModule.Общ"));
// общий модуль: А — без изменений (только комментарий/отступ), Б — изменён и перехвачен &Вместо, В — изменён без покрытия, Г — новый в УП, в todo
Зап(ОбъединитьПути(Бп, "CommonModules", "Общ/Ext/Module.bsl"), "Процедура А() Экспорт" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Б()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС + "Функция В()" + ПС + "	Возврат 1;" + ПС + "КонецФункции" + ПС);
Зап(ОбъединитьПути(Уп, "CommonModules", "Общ/Ext/Module.bsl"), "Процедура А() Экспорт // УП" + ПС + "Х = 1;   // коммент" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Б()" + ПС + "	Х = 2;" + ПС + "КонецПроцедуры" + ПС + "Функция В()" + ПС + "	Возврат 2;" + ПС + "КонецФункции" + ПС
	+ "Процедура Г()" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура М()" + ПС + "	// УП_начало" + ПС + "	Х = 1;" + ПС + "	// УП_конец" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Н()" + ПС + "КонецПроцедуры" + ПС + "Функция Р(А)" + ПС + "КонецФункции" + ПС + "Процедура К()" + ПС + "КонецПроцедуры" + ПС + "Процедура Ц()" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Уп, "DataProcessors", "ОбрУп/Forms/Ф/Ext/Form/Module.bsl"), "Процедура Ф1()" + ПС + "	Общ.Н();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Осн, "Catalogs", "Спр/Ext/ObjectModule.bsl"), "Процедура Ф2()" + ПС + "	К();" + ПС + "	Общ.Ц();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Осн, "CommonModules", "Общ/Ext/Module.bsl"), "Процедура А() Экспорт" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Расш, "CommonModules", "Общ/Ext/Module.bsl"), "&Вместо(""Б"")" + ПС + "Процедура УП_Б()" + ПС + "КонецПроцедуры" + ПС + "Функция УП_Р(Знач А)" + ПС + "КонецФункции" + ПС);
// ОМ только УП — перенесён в extension; форма справочника из УП — осталась в restored
Зап(ОбъединитьПути(Уп, "CommonModules", "УпОм/Ext/Module.bsl"), "Процедура Х() Экспорт" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Расш, "CommonModules", "УпОм/Ext/Module.bsl"), "Процедура Х() Экспорт" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Уп, "Catalogs", "Спр/Forms/Ф/Ext/Form/Module.bsl"), "&НаКлиенте" + ПС + "Процедура П1()" + ПС + "	УпОм.Х();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Осн, "Catalogs", "Спр/Forms/Ф/Ext/Form/Module.bsl"), "&НаКлиенте" + ПС + "Процедура П1()" + ПС + "	УпОм.Х();" + ПС + "КонецПроцедуры" + ПС);
// модуль отчёта только УП — объект не перенесён, нигде нет → ПОТЕРЯНО (и объект ПОТЕРЯН)
Зап(ОбъединитьПути(Осн, "Documents", "ДокУп/Ext/ObjectModule.bsl"), "Процедура Ч()" + ПС + "	Отчеты.ОтчУп.О ();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Уп, "Reports", "ОтчУп/Ext/ObjectModule.bsl"), "Процедура О()" + ПС + "КонецПроцедуры" + ПС);
// обработка только УП — в todo
Зап(ОбъединитьПути(Уп, "DataProcessors", "ОбрУп/Ext/ObjectModule.bsl"), "Процедура Д()" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Вых, "todo_x.csv"), "Класс;Объект;Модуль" + ПС + "а;DataProcessor.ОбрУп;DataProcessors/ОбрУп/Ext/ObjectModule.bsl" + ПС + "т;CommonModule.Общ.Г;" + ПС);
// реквизиты справочника: Р1 общий, Р2 УП в restored, Р3 УП в extension, Р4 УП потерян
Рек = "<MetaDataObject><Catalog><Properties><Name>Спр</Name></Properties><ChildObjects>";
Зап(ОбъединитьПути(Бп, "Catalogs", "Спр.xml"), Рек + "<Attribute uuid=""1""><Properties><Name>Р1</Name></Properties></Attribute></ChildObjects></Catalog></MetaDataObject>");
Зап(ОбъединитьПути(Уп, "Catalogs", "Спр.xml"), Рек + "<Attribute uuid=""1""><Properties><Name>Р1</Name></Properties></Attribute><Attribute uuid=""2""><Properties><Name>Р2</Name></Properties></Attribute>"
	+ "<Attribute uuid=""3""><Properties><Name>Р3</Name></Properties></Attribute><Attribute uuid=""4""><Properties><Name>Р4</Name></Properties></Attribute><Template>Макет</Template></ChildObjects></Catalog></MetaDataObject>");
Зап(ОбъединитьПути(Осн, "Catalogs", "Спр.xml"), Рек + "<Attribute uuid=""1""><Properties><Name>Р1</Name></Properties></Attribute><Attribute uuid=""2""><Properties><Name>Р2</Name></Properties></Attribute><Template>Макет</Template></ChildObjects></Catalog></MetaDataObject>");
Зап(ОбъединитьПути(Расш, "Catalogs", "Спр.xml"), Рек + "<Attribute uuid=""3""><Properties><Name>Р3</Name></Properties></Attribute></ChildObjects></Catalog></MetaDataObject>");

М = ЗагрузитьСценарий(ОбъединитьПути(Ск, "verify_up_changes.os"));
Лог = Новый Массив;
Р = М.Сверить(Уп, Бп, Вых, Лог);
Csv = Чит(ОбъединитьПути(Вых, "verify_up_changes.csv"));
П(СтрНайти(Csv, ";а;") = 0 И СтрНайти(Csv, "Module.bsl;а;") = 0, "метод без изменений по существу не отличие");
П(СтрНайти(Csv, "метод изменён;CommonModule.Общ;CommonModules/Общ/Ext/Module.bsl;б;extension") > 0, "Б покрыт &Вместо");
П(СтрНайти(Csv, "метод изменён;CommonModule.Общ;CommonModules/Общ/Ext/Module.bsl;в;ПОТЕРЯНО") > 0, "В потерян");
П(СтрНайти(Csv, "метод нет в БП;CommonModule.Общ;CommonModules/Общ/Ext/Module.bsl;г;todo") > 0, "Г в todo");
П(СтрНайти(Csv, "метод нет в БП;CommonModule.УпОм;CommonModules/УпОм/Ext/Module.bsl;х() экспорт;") = 0 И СтрНайти(Csv, "CommonModule.УпОм;CommonModules/УпОм/Ext/Module.bsl;х;extension") > 0, "ОМ УП в extension");
П(СтрНайти(Csv, "Catalog.Спр;Catalogs/Спр/Forms/Ф/Ext/Form/Module.bsl;п1;осталось в restored") > 0, "форма УП осталась в restored");
П(СтрНайти(Csv, "Report.ОтчУп;Reports/ОтчУп/Ext/ObjectModule.bsl;о;ПОТЕРЯНО") > 0, "модуль отчёта потерян");
П(СтрНайти(Csv, "DataProcessor.ОбрУп;DataProcessors/ОбрУп/Ext/ObjectModule.bsl;д;todo") > 0, "модуль обработки в todo");
П(СтрНайти(Csv, "объект нет в БП;Document.ДокУп;Documents/ДокУп.xml;;осталось в restored") > 0, "документ в restored");
П(СтрНайти(Csv, "объект нет в БП;CommonModule.УпОм;CommonModules/УпОм.xml;;extension") > 0, "ОМ в extension");
П(СтрНайти(Csv, "объект нет в БП;Report.ОтчУп;Reports/ОтчУп.xml;;ПОТЕРЯНО") > 0, "отчёт потерян");
П(СтрНайти(Csv, "объект нет в БП;DataProcessor.ОбрУп;DataProcessors/ОбрУп.xml;;todo") > 0, "обработка в todo");
П(СтрНайти(Csv, "элемент нет в БП: Attribute;Catalog.Спр;Catalogs/Спр.xml;Р2;осталось в restored") > 0, "реквизит в restored");
П(СтрНайти(Csv, "элемент нет в БП: Attribute;Catalog.Спр;Catalogs/Спр.xml;Р3;extension") > 0, "реквизит в extension");
П(СтрНайти(Csv, "элемент нет в БП: Attribute;Catalog.Спр;Catalogs/Спр.xml;Р4;ПОТЕРЯНО") > 0, "реквизит потерян");
П(СтрНайти(Csv, "элемент нет в БП: Template;Catalog.Спр;Catalogs/Спр.xml;Макет;осталось в restored") > 0, "макет в restored");
П(СтрНайти(Csv, ";Р1;") = 0, "общий реквизит не отличие");
П(СтрНайти(Csv, "Module.bsl;в;ПОТЕРЯНО;нет;версия: не вызывается") > 0, "В: разница версий, не вызывается");
П(СтрНайти(Csv, "ObjectModule.bsl;о;ПОТЕРЯНО;да;") > 0, "О: точный вызов Отчеты.ОтчУп.О(");
П(СтрНайти(Csv, "Module.bsl;р;extension") > 0, "Р: копия УП_Р в extension покрывает");
П(СтрНайти(Csv, "Module.bsl;м;ПОТЕРЯНО;нет;доработка УП: маркер") > 0, "М: маркер // УП_начало");
П(СтрНайти(Csv, "Module.bsl;н;ПОТЕРЯНО;нет;доработка УП: вызов из объекта только УП") > 0, "Н: вызывается из объекта только УП");
П(СтрНайти(Csv, "Module.bsl;к;ПОТЕРЯНО;нет;версия: не вызывается") > 0, "К: голое имя К( в чужом объекте — не вызов");
П(СтрНайти(Csv, "Module.bsl;ц;ПОТЕРЯНО;да;версия: сломанный вызов") > 0, "Ц: Общ.Ц( в restored — сломанный вызов версии");
П(Р.byStatus.Получить("ПОТЕРЯНО") = 8 И Р.byStatus.Получить("ПОТЕРЯНО, доработка УП: маркер") = 1, "ПОТЕРЯНО: " + Р.byStatus.Получить("ПОТЕРЯНО"));
П(СтрНайти(Чит(ОбъединитьПути(Вых, "verify_up_changes.md")), "| ПОТЕРЯНО | 8 |") > 0, "md: статистика");
УдалитьФайлы(Вр);
Если Ошибок = 0 Тогда
	Сообщить("OK: test_verify_up_changes");
Иначе
	Сообщить("FAILED: " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
