// ВызовыОмБпМодулейПриложения (вариант А): вызовы ОМ только БП в модуле приложения restored убираются (редакция УП),
// в extension — заимствованный модуль приложения с &ИзменениеИКонтроль и #Вставка.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Функция Конф(Объекты)
	Т = "<MetaDataObject>" + Символы.ПС + "	<Configuration>" + Символы.ПС + "		<ChildObjects>" + Символы.ПС;
	Для Каждого О Из СтрРазделить(Объекты, ",", Ложь) Цикл
		Ч = СтрРазделить(СокрЛП(О), ".", Ложь);
		Т = Т + "			<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">" + Символы.ПС;
	КонецЦикла;
	Возврат Т + "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_appbp_" + Строка(Новый УникальныйИдентификатор));
Бп = ОбъединитьПути(Вр, "bp");
Осн = ОбъединитьПути(Вр, "restored");
Расш = ОбъединитьПути(Вр, "ext");
ПС = Символы.ВК + Символы.ПС;
Зап(ОбъединитьПути(Бп, "Configuration.xml"), Конф("CommonModule.Общий,CommonModule.ТолькоБпКлиент"));
Зап(ОбъединитьПути(Осн, "Configuration.xml"), Конф("CommonModule.Общий"));
Зап(ОбъединитьПути(Расш, "Configuration.xml"), Конф(""));
ТБп = "Перем Х;" + ПС + ПС
	+ "Процедура ПриВыбореДействия(Сообщение, Действие)" + ПС
	+ "	" + ПС
	+ "	Общий.А(Сообщение);" + ПС
	+ "	ТолькоБпКлиент.Б(Сообщение," + ПС
	+ "		Действие);" + ПС
	+ "	// ТолькоБпКлиент.В();" + ПС
	+ "	" + ПС
	+ "КонецПроцедуры" + ПС + ПС
	+ "Процедура Условие()" + ПС
	+ "	Если ТолькоБпКлиент.Г() Тогда" + ПС
	+ "		Х = 1;" + ПС
	+ "	КонецЕсли;" + ПС
	+ "КонецПроцедуры" + ПС;
Зап(ОбъединитьПути(Бп, "Ext", "ManagedApplicationModule.bsl"), ТБп);
Зап(ОбъединитьПути(Осн, "Ext", "ManagedApplicationModule.bsl"), ТБп);

М = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ВызовыОмБпМодулейПриложения.os"));
Лог = Новый Массив;
Р = М.Применить(Осн, Расш, Бп, "УП_", Лог, Вр);
ТВ = Чит(ОбъединитьПути(Осн, "Ext", "ManagedApplicationModule.bsl"));
ТР = Чит(ОбъединитьПути(Расш, "Ext", "ManagedApplicationModule.bsl"));
П(Р.statements = 1 И Р.extensionMethods = 1 И Р.restoredFiles = 1, "счётчики: " + Р.statements + "/" + Р.extensionMethods + "/" + Р.restoredFiles);
П(СтрНайти(ТВ, "ТолькоБпКлиент.Б(") = 0 И СтрНайти(ТВ, "Действие);") = 0, "restored: оператор (многострочный) убран");
П(СтрНайти(ТВ, "Общий.А(Сообщение);") > 0 И СтрНайти(ТВ, "// ТолькоБпКлиент.В();") > 0, "restored: прочие строки целы");
П(СтрНайти(ТВ, "Если ТолькоБпКлиент.Г() Тогда") > 0, "restored: условие не трогается");
П(Р.skipped.Количество() = 1, "пропущено (условие): " + Р.skipped.Количество());
П(СтрНайти(ТР, "&ИзменениеИКонтроль(""ПриВыбореДействия"")") > 0, "extension: аннотация");
П(СтрНайти(ТР, "Процедура УП_ПриВыбореДействия(Сообщение, Действие)") > 0, "extension: сигнатура с префиксом");
П(СтрНайти(ТР, "#Вставка" + Символы.ПС + "	ТолькоБпКлиент.Б(Сообщение,") > 0 И СтрНайти(ТР, "Действие);" + Символы.ПС + "#КонецВставки") > 0, "extension: #Вставка");
П(СтрНайти(ТР, "	Общий.А(Сообщение);") > 0 И СтрНайти(ТР, "Условие") = 0, "extension: тело метода, без лишних методов");
// повтор идемпотентен
Р2 = М.Применить(Осн, Расш, Бп, "УП_", Лог, Вр);
ТР2 = Чит(ОбъединитьПути(Расш, "Ext", "ManagedApplicationModule.bsl"));
П(Р2.restoredFiles = 0 И ТР2 = ТР, "повтор: restored не меняется, блок extension один");
П(Чит(ОбъединитьПути(Осн, "Ext", "ManagedApplicationModule.bsl")) = ТВ, "повтор: restored тот же");
УдалитьФайлы(Вр);
Если Ошибок > 0 Тогда ВызватьИсключение "test_app_module_bp_calls"; КонецЕсли;
Сообщить("OK: test_app_module_bp_calls");
