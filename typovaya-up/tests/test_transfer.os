Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Без = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Синтез.Инициализировать(Разбор, Без);
Ч.Инициализировать(Разбор, ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os")));
Ошибок = 0;
ПС = Символы.ПС;
П = Синтез.ПредложитьХук("А = 1;", "Возврат 0;");
П(П.hook = "changeAndControl" И П.decision = "auto"
	И П.hookBody = "#Удаление" + ПС + "А = 1;" + ПС + "#КонецУдаления" + ПС + "#Вставка" + ПС + "Возврат 0;" + ПС + "#КонецВставки", "полная замена через ИиК: " + П.hookBody);
Р = Ч.ОтрисоватьМетод("УП_", Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, insteadAppendContinue",
	"Ф", "Функция", "changed", "Функция Ф()" + ПС + "	А = 1;" + ПС + "КонецФункции", "", "changeAndControl", "auto", П.hookBody, Ложь));
П(СтрНайти(Р, "&Вместо") = 0 И СтрНайти(Р, "&ИзменениеИКонтроль(""Ф"")") = 1 И СтрЧислоВхождений(Р, "Функция УП_Ф()") = 1, "черновик: ИиК, сигнатура один раз: " + Р);
П(СтрНайти(Р, ПС + "#Удаление" + ПС) > 0 И СтрНайти(Р, ПС + "#КонецВставки" + ПС) > 0, "директивы с колонки 0");
П = Синтез.ПредложитьХук("А = 1;", "Х = 1;" + ПС + "ПродолжитьВызов();" + ПС + "У = 2;");
П(П.decision = "manual" И П.hook = "none", "ПродолжитьВызов -> manual");
П = Синтез.ПредложитьХук("А = 1;", "Возврат ПродолжитьВызов(А);");
П(П.decision = "manual", "return continue -> manual");
П = Синтез.ПредложитьХук("А = 1;", "ПродолжитьВызов();" + ПС + "ПродолжитьВызов();");
П(П.decision = "manual", "two continues manual");
П = Синтез.ПредложитьХук("А = 1;", "Если Истина Тогда ПродолжитьВызов(); КонецЕсли;");
П(П.decision = "manual", "conditional manual");
П = Синтез.ПредложитьХук("А = 1;", "А = ""ПродолжитьВызов()"";" + ПС + "Б = 2;");
П(П.hook = "changeAndControl" И СтрНайти(П.reason, "Полная замена") > 0, "string not treated as call " + П.reason);
П = Синтез.ПредложитьХук("	Х = 1;" + ПС + "	#Если Сервер Тогда" + ПС + "	У = 2;" + ПС + "	#КонецЕсли", "	Б = 3;");
П(П.decision = "manual" И П.hook = "none", "#Если в теле БП -> manual " + П.hook);
П = Синтез.ПредложитьХук("	Х = 1;" + ПС + "		Т = 2;" + ПС, "	Б = 3;");
П(СтрНачинаетсяС(П.hookBody, "#Удаление" + ПС + "	Х = 1;" + ПС + "		Т = 2;" + ПС + "#КонецУдаления" + ПС + "#Вставка" + ПС + "	Б = 3;"), "тело БП байт в байт с табами " + П.hookBody);
Ман = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody",
	"М", "Процедура", "changed", "Процедура М()", "", "none", "manual", "");
П(Не Ч.ИдётВРасширение(Ман), "manual not in extension");
П = Синтез.ПредложитьХук("А = 1;", "Выполнить(""Х"");");
П(П.decision = "manual", "Выполнить manual");
П(Без.ДиагностикаВызовов("Рез = Запрос.Выполнить();") = "", "Запрос.Выполнить() — метод объекта, не блокирует");
П(Без.ДиагностикаВызовов("Рез = Запрос" + ПС + "	.Выполнить().Выбрать();") = "", "перенос перед .Выполнить() — метод объекта");
П(Без.ДиагностикаВызовов("ВыполнитьЗапрос(А); Х = ДлительныеОперации.ВыполнитьФункцию(П);") = "", "ВыполнитьЗапрос/ВыполнитьФункцию не оператор");
П(Без.ДиагностикаВызовов("Запрос.Выполнить();" + ПС + "Выполнить (Код);") <> "", "глобальный Выполнить после метода объекта — блок");
П(Без.ДиагностикаВызовов("Х = Вычислить(Выражение);") <> "", "глобальный Вычислить — блок");
П(Без.ДиагностикаВызовов("Выполнить Код;") <> "", "Выполнить без скобок — блок");
П = Синтез.ПредложитьХук("А = 1;", "Р = Запрос.Выполнить();");
П(П.decision = "auto", "тело с Запрос.Выполнить() — авто " + П.decision);
Если Ошибок = 0 Тогда Сообщить("OK: transfer"); Иначе ЗавершитьРаботу(1); КонецЕсли;
