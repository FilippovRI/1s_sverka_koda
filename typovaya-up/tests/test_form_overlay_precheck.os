// Несовместимый Form.xml БП (ValueTable) — оставляем УП
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьBom(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8NoBOM).Записать(Путь);
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Фикст = ОбъединитьПути(ТекущийСценарий().Каталог, "_form_precheck_tmp");
Ошибок = 0;
Если (Новый Файл(Фикст)).Существует() Тогда
	УдалитьФайлы(Фикст);
КонецЕсли;
Ку = ОбъединитьПути(Фикст, "up");
Кб = ОбъединитьПути(Фикст, "bp");
Вс = ОбъединитьПути(Фикст, "restored");
СоздатьКаталог(Ку);
СоздатьКаталог(Кб);
СоздатьКаталог(Вс);
ЗаписатьBom(ОбъединитьПути(Ку, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");
ЗаписатьBom(ОбъединитьПути(Кб, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");
ЗаписатьBom(ОбъединитьПути(Вс, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");

Отн = "CommonForms\Тест\Ext\Form.xml";
ПУп = ОбъединитьПути(Ку, Отн);
ПБп = ОбъединитьПути(Кб, Отн);
ПВс = ОбъединитьПути(Вс, Отн);
ЗаписатьBom(ПУп, "<f><t>cfg:CatalogRef.X</t></f>");
ЗаписатьBom(ПБп, "<f><t>v8:ValueTable</t><col><v8:Type>cfg:ChartOfCalculationTypesRef.Начисления</v8:Type></col></f>");
ЗаписатьBom(ПВс, "<f><up/></f>");

Пров = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПроверкаЗамкнутости.os"));
Р = Пров.ПредчекOverlayFormBp(Вс, Кб, Ку);
П(Р.incompatible = 1, "incompatible=1 got " + Р.incompatible);
П(Р.items[0].reason = "FormBpValueTable", "reason ValueTable");

Мф = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "МодулиИФормыБыстро.os"));
Лог = Новый Массив;
Р2 = Мф.ПрименитьДословноБпКRestored(Вс, Кб, Ку, Лог);
Д = Новый ДвоичныеДанные(ПВс);
П(СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(Д, КодировкаТекста.UTF8)) = "<f><t>cfg:CatalogRef.X</t></f>", "оставлен УП Form.xml");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_form_overlay_precheck";
КонецЕсли;
Сообщить("OK: test_form_overlay_precheck");