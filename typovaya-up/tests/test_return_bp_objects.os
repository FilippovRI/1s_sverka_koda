// ВозвратОбъектовБпВRestored (решение 24.11, t716s2524): ОМ только БП, на которые ссылается restored, и их цепочка ОМ
// возвращаются в restored; прочие объекты БП и класс 3 — в todo (md+csv); заглушки extension убираются; исключения из
// return_bp_exclude.txt; appModuleBpCalls возвращает код БП.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Функция Конф(Объекты)
	Т = "<MetaDataObject>" + Символы.ПС + "	<Configuration>" + Символы.ПС + "		<ChildObjects>" + Символы.ПС;
	Для Каждого О Из СтрРазделить(Объекты, ",", Ложь) Цикл
		Ч = СтрРазделить(СокрЛП(О), ".", Ложь);
		Т = Т + "			<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">" + Символы.ПС;
	КонецЦикла;
	Возврат Т + "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_retbp_" + Строка(Новый УникальныйИдентификатор));
Бп = ОбъединитьПути(Вр, "bp");
Осн = ОбъединитьПути(Вр, "restored");
Расш = ОбъединитьПути(Вр, "ext");
ПС = Символы.ВК + Символы.ПС;
Зап(ОбъединитьПути(Бп, "Configuration.xml"), Конф("CommonModule.Общий,CommonModule.ТолькоБп1,CommonModule.ТолькоБп2,CommonModule.ТолькоБпГлоб,"
	+ "CommonModule.ТолькоБпЛишний,CommonModule.ТолькоБпКлиент,Catalog.Спр,Catalog.Есть,Enum.Пер,CommonPicture.Карт,Role.Рол,Document.Док,Enum.ЕстьПер"));
Зап(ОбъединитьПути(Осн, "Configuration.xml"), Конф("CommonModule.Общий,Catalog.Есть,Enum.ЕстьПер"));
Зап(ОбъединитьПути(Осн, "Enums", "ЕстьПер.xml"), "<MetaDataObject><Enum><Properties><Name>ЕстьПер</Name></Properties><ChildObjects><EnumValue><Properties><Name>А</Name></Properties></EnumValue></ChildObjects></Enum></MetaDataObject>");
Зап(ОбъединитьПути(Расш, "Configuration.xml"), Конф("CommonModule.ТолькоБп1,CommonModule.ТолькоБпКлиент"));
Для Каждого Им Из СтрРазделить("Общий,ТолькоБп1,ТолькоБп2,ТолькоБпЛишний,ТолькоБпКлиент", ",") Цикл
	Зап(ОбъединитьПути(Бп, "CommonModules", Им + ".xml"), "<MetaDataObject><CommonModule><Properties><Name>" + Им + "</Name><Global>false</Global></Properties></CommonModule></MetaDataObject>");
КонецЦикла;
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБпГлоб.xml"), "<MetaDataObject><CommonModule><Properties><Name>ТолькоБпГлоб</Name><Global>true</Global></Properties></CommonModule></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБп1/Ext/Module.bsl"), "Процедура А() Экспорт" + ПС + "	ТолькоБп2.Б();" + ПС + "	ГлобМетод();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБп2/Ext/Module.bsl"), "Процедура Б() Экспорт" + ПС + "	Х = Справочники.Спр.ПустаяСсылка();" + ПС
	+ "	// ТолькоБпЛишний.Ц();" + ПС + "	У = Справочники.Есть.ПустаяСсылка();" + ПС
	+ "	З = Перечисления.ЕстьПер.Б; Ж = Перечисления.ЕстьПер.А; Е = Перечисления.ЕстьПер.ПустаяСсылка();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБпГлоб/Ext/Module.bsl"), "Процедура ГлобМетод() Экспорт" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБпЛишний/Ext/Module.bsl"), "Процедура Ц() Экспорт" + ПС + "	Д = Документы.Док;" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБпКлиент/Ext/Module.bsl"), "Процедура Б() Экспорт" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Бп, "Catalogs", "Спр.xml"), "<MetaDataObject><Catalog><Properties><Name>Спр</Name><Type><v8:Type>cfg:EnumRef.Пер</v8:Type></Type>"
	+ "<Picture><xr:Ref>CommonPicture.Карт</xr:Ref></Picture><Role>Role.Рол</Role></Properties></Catalog></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "Catalogs", "Спр/Ext/ObjectModule.bsl"), "Процедура П()" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Бп, "Catalogs", "Есть.xml"), "<MetaDataObject><Catalog><Properties><Name>Есть</Name></Properties></Catalog></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "Enums", "Пер.xml"), "<MetaDataObject><Enum><Properties><Name>Пер</Name></Properties></Enum></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "CommonPictures", "Карт.xml"), "<MetaDataObject><CommonPicture><Properties><Name>Карт</Name></Properties></CommonPicture></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "CommonPictures", "Карт/Ext/Picture.xml"), "<Picture/>");
Зап(ОбъединитьПути(Бп, "Roles", "Рол.xml"), "<MetaDataObject><Role><Properties><Name>Рол</Name></Properties></Role></MetaDataObject>");
Зап(ОбъединитьПути(Бп, "Documents", "Док.xml"), "<MetaDataObject><Document><Properties><Name>Док</Name></Properties></Document></MetaDataObject>");
// restored: модуль приложения с вырезанным вызовом (вариант А), прочий код ссылается на ТолькоБп1
ТБп = "Процедура ПриНачале()" + ПС + "	Общий.А();" + ПС + "	ТолькоБпКлиент.Б();" + ПС + "КонецПроцедуры" + ПС;
Зап(ОбъединитьПути(Бп, "Ext", "ManagedApplicationModule.bsl"), ТБп);
Зап(ОбъединитьПути(Осн, "Ext", "ManagedApplicationModule.bsl"), ТБп);
Зап(ОбъединитьПути(Осн, "Catalogs", "Есть/Ext/ManagerModule.bsl"), "Процедура Х()" + ПС + "	ТолькоБп1.А(); // ""ТолькоБпЛишний.Ц()""" + ПС + "КонецПроцедуры" + ПС);
// extension: собственная заглушка ТолькоБп1 и ТолькоБпКлиент
Зап(ОбъединитьПути(Расш, "CommonModules", "ТолькоБп1.xml"), "<MetaDataObject><CommonModule><Properties><Name>ТолькоБп1</Name></Properties></CommonModule></MetaDataObject>");
Зап(ОбъединитьПути(Расш, "CommonModules", "ТолькоБп1/Ext/Module.bsl"), "// заглушка");
Зап(ОбъединитьПути(Расш, "CommonModules", "ТолькоБпКлиент.xml"), "<MetaDataObject><CommonModule><Properties><Name>ТолькоБпКлиент</Name></Properties></CommonModule></MetaDataObject>");
Ам = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ВызовыОмБпМодулейПриложения.os"));
Лог = Новый Массив;
Ам.Применить(Осн, Расш, Бп, "УП_", Лог, Вр);
ТВ0 = Чит(ОбъединитьПути(Осн, "Ext", "ManagedApplicationModule.bsl"));
П(СтрНайти(ТВ0, "ТолькоБпКлиент.Б();") = 0 И СтрНайти(Чит(ОбъединитьПути(Расш, "Ext", "ManagedApplicationModule.bsl")), "#Вставка") > 0, "подготовка: вариант А вырезал вызов");

Зап(ОбъединитьПути(Вр, "return_bp_exclude.txt"), "# исключения" + ПС + "CommonModule.ТолькоБпГлоб" + ПС);
Зап(ОбъединитьПути(Бп, "CommonModules", "ТолькоБп2.xml"), "<MetaDataObject><CommonModule><Properties><Name>ТолькоБп2</Name><Privileged>true</Privileged><ServerCall>true</ServerCall></Properties></CommonModule></MetaDataObject>");
М = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ВозвратОбъектовБпВRestored.os"));
Р = М.Вернуть(Осн, Бп, Расш, Лог, Вр);
ТекКонф = Чит(ОбъединитьПути(Осн, "Configuration.xml"));
Для Каждого К Из СтрРазделить("CommonModule.ТолькоБп1,CommonModule.ТолькоБп2,CommonModule.ТолькоБпКлиент", ",") Цикл
	П(Р.added.Получить(К) <> Неопределено, "возвращён " + К);
	Ч = СтрРазделить(К, ".");
	П(СтрНайти(ТекКонф, "<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">") > 0, "Configuration.xml restored: " + К);
КонецЦикла;
П(Р.order.Количество() = 3, "всего возвращено: " + Р.order.Количество());
П(Р.added.Получить("CommonModule.ТолькоБпГлоб") = Неопределено И Р.excluded.Найти("ТолькоБпГлоб") <> Неопределено
	И СтрНайти(ТекКонф, "ТолькоБпГлоб") = 0, "исключение из return_bp_exclude.txt");
П(Р.added.Получить("CommonModule.ТолькоБпЛишний") = Неопределено, "не возвращён (комментарий/строка)");
П(Р.added.Получить("Catalog.Спр") = Неопределено И СтрНайти(ТекКонф, "Спр") = 0 И СтрНайти(ТекКонф, "<Enum>Пер</Enum>") = 0
	И Не (Новый Файл(ОбъединитьПути(Осн, "Catalogs", "Спр.xml"))).Существует(), "прочие объекты БП не возвращаются");
П(СтрЧислоВхождений(ТекКонф, "<Catalog>Есть</Catalog>") = 1, "Есть не дублируется");
П(СтрНайти(ТекКонф, "<CommonModule>Общий</CommonModule>" + Символы.ПС + "			<CommonModule>ТолькоБп1</CommonModule>") > 0, "строки после своего тега");
П(Чит(ОбъединитьПути(Осн, "CommonModules", "ТолькоБп2.xml")) = Чит(ОбъединитьПути(Бп, "CommonModules", "ТолькоБп2.xml")), "XML ОМ (флаги) как есть");
Csv = Чит(ОбъединитьПути(Вр, "todo_bp_modules_returned.csv"));
Md = Чит(ОбъединитьПути(Вр, "todo_bp_modules_returned.md"));
П(СтрНайти(Csv, "CommonModule.ТолькоБп2;2;Catalog.Спр;объект отсутствует в restored") > 0, "todo: отсутствующий объект с номером строки");
П(СтрНайти(Csv, "CommonModule.ТолькоБп2;5;Enum.ЕстьПер.Б;класс 3") > 0, "todo: класс 3 (значение перечисления)");
П(СтрНайти(Csv, "Enum.ЕстьПер.А") = 0 И СтрНайти(Csv, "ПустаяСсылка") = 0 И СтрНайти(Csv, "Catalog.Есть") = 0, "todo: без ложных");
П(СтрНайти(Csv, "CommonModule.ТолькоБпГлоб;ОМ исключён") > 0 Или СтрНайти(Csv, ";CommonModule.ТолькоБпГлоб;ОМ исключён") > 0, "todo: исключённый ОМ");
П(СтрНайти(Md, "| CommonModule.ТолькоБп2 | 2 | Catalog.Спр |") > 0 И СтрНайти(Md, "класс 3") > 0, "todo md");
П(Чит(ОбъединитьПути(Осн, "CommonModules", "ТолькоБп2/Ext/Module.bsl")) = Чит(ОбъединитьПути(Бп, "CommonModules", "ТолькоБп2/Ext/Module.bsl")), "модуль БП как есть");
П(Не (Новый Файл(ОбъединитьПути(Расш, "CommonModules", "ТолькоБп1.xml"))).Существует()
	И Не (Новый Файл(ОбъединитьПути(Расш, "CommonModules", "ТолькоБп1"))).Существует(), "заглушка extension удалена");
КР = Чит(ОбъединитьПути(Расш, "Configuration.xml"));
П(СтрНайти(КР, "ТолькоБп1") = 0 И СтрНайти(КР, "ТолькоБпКлиент") = 0 И Р.extRemoved = 2, "Configuration.xml extension: " + Р.extRemoved);
// вариант А: модуль вернулся — код БП в restored, блок extension убран
Возвр = Новый Соответствие;
Для Каждого К Из Р.order Цикл
	Если СтрНачинаетсяС(К, "CommonModule.") Тогда Возвр.Вставить(НРег(Сред(К, 14)), Сред(К, 14)); КонецЕсли;
КонецЦикла;
Ра = Ам.Применить(Осн, Расш, Бп, "УП_", Лог, Вр, Возвр);
П(Ра.reverted = 1 И Чит(ОбъединитьПути(Осн, "Ext", "ManagedApplicationModule.bsl")) = Чит(ОбъединитьПути(Бп, "Ext", "ManagedApplicationModule.bsl")), "appModuleBpCalls: код БП возвращён");
П(СтрНайти(Чит(ОбъединитьПути(Расш, "Ext", "ManagedApplicationModule.bsl")), "typovaya-up: вызовы ОМ только БП") = 0, "appModuleBpCalls: блок extension убран");
// повтор идемпотентен
Р2 = М.Вернуть(Осн, Бп, Расш, Лог, Вр);
П(Р2.order.Количество() = 0 И Не Р2.cached И Чит(ОбъединитьПути(Осн, "Configuration.xml")) = ТекКонф, "повтор: ничего не добавляет (restored изменён — скан)");
// инкрементность: входы не менялись — шаг пропускается по кэшу
Р3 = М.Вернуть(Осн, Бп, Расш, Лог, Вр);
П(Р3.cached И Р3.order.Количество() = 0, "кэш: шаг пропущен");
// удаление файла restored (подмножество) — кэш действует; новый текст со ссылкой — скан
УдалитьФайлы(ОбъединитьПути(Осн, "Catalogs", "Есть/Ext/ManagerModule.bsl"));
П(М.Вернуть(Осн, Бп, Расш, Лог, Вр).cached, "кэш: удаление файла не сбрасывает");
Зап(ОбъединитьПути(Осн, "Catalogs", "Есть/Ext/ObjectModule.bsl"), "Процедура Н()" + ПС + "	ТолькоБпЛишний.Ц();" + ПС + "КонецПроцедуры" + ПС);
Р4 = М.Вернуть(Осн, Бп, Расш, Лог, Вр);
П(Не Р4.cached И Р4.added.Получить("CommonModule.ТолькоБпЛишний") <> Неопределено, "кэш: новый текст — скан и возврат");
// поздние шаги сборки меняют тексты restored (вырезают вызовы) — кэш обновляется в конце сборки, следующая сборка пропускает шаг
Зап(ОбъединитьПути(Осн, "Catalogs", "Есть/Ext/ObjectModule.bsl"), "Процедура Н()" + ПС + "КонецПроцедуры" + ПС + ПС);
М.ОбновитьКэш(Осн, Бп, Вр);
П(М.Вернуть(Осн, Бп, Расш, Лог, Вр).cached, "кэш: обновлён в конце сборки — шаг пропущен");
УдалитьФайлы(Вр);
Для Каждого С Из Лог Цикл Сообщить(С); КонецЦикла;
Если Ошибок > 0 Тогда ВызватьИсключение "test_return_bp_objects"; КонецЕсли;
Сообщить("OK: test_return_bp_objects");
