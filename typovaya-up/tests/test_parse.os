// Регрессии лексического разбора (не полноценный парсер BSL).
Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Р = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Ошибок = 0;
ПС = Символы.ПС;
П(Р.УбратьКомментарий("A = ""http://x"";") = "A = ""http://x"";", "slash in string");
П(СокрЛП(Р.УбратьКомментарий("A = ""q""""w""; // c")) = "A = ""q""""w"";", "escaped quotes");
П(Р.УбратьКомментарий("// not code") = "", "full line comment");
П(Не Р.ЭтоМаркерКонцаМетода("  Т = ""КонецПроцедуры"";", "конецпроцедуры"), "end in string");
П(Не Р.ЭтоМаркерКонцаМетода("КонецПроцедуры = 1;", "конецпроцедуры"), "end as name");
П(Р.ЭтоМаркерКонцаМетода("КонецПроцедуры;", "конецпроцедуры"), "real end");
Мод = "&НаСервере" + ПС
	+ "Процедура ВЖивую(Знач X = 0) Экспорт" + ПС
	+ "	// ложный КонецПроцедуры в комментарии" + ПС
	+ "	С = ""Процедура в строке"";" + ПС
	+ "КонецПроцедуры;" + ПС
	+ "#Область X" + ПС
	+ "Процедура Вторая()" + ПС
	+ "КонецПроцедуры;";
Разбор = Р.РазобратьМодуль(Мод);
П(Разбор.Методы.Количество() = 2, "two methods");
П(Разбор.Методы[0].Имя = "ВЖивую", "first name");
П(Разбор.Методы[1].Имя = "Вторая", "second name");
Мл = "Процедура Много(" + ПС + "	Знач A = 0) Экспорт" + ПС + "КонецПроцедуры;";
Разбор2 = Р.РазобратьМодуль(Мл);
П(Разбор2.Методы.Количество() = 1 И Разбор2.Методы[0].Имя = "Много", "multiline sig");
Если Ошибок = 0 Тогда Сообщить("OK: parse"); Иначе ЗавершитьРаботу(1); КонецЕсли;
