// Регрессии XML черновика (InternalInfo / ChildObjects).
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Фикстуры = ОбъединитьПути(Корень, "tests", "fixtures", "UP");
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч.Инициализировать(Разбор, Настройки);
Ошибок = 0;

ПутьКаталог = ОбъединитьПути(Фикстуры, "Catalogs", "Банки.xml");
Блок = Ч.ИзвлечьБлокXml(ПутьКаталог, "InternalInfo");
Проверить(СтрНайти(Блок, "xr:GeneratedType") > 0, "InternalInfo из УП");

ДО = Новый Структура("Тип, Имя, СвойUuid, БазовыйUuid, ПутьИсходногоXml, Команды",
	"Catalog", "Банки", "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa", "11111111-1111-1111-1111-111111111111", ПутьКаталог, Неопределено);
XmlО = Ч.XmlОбъекта(ДО);
Проверить(СтрНайти(XmlО, "<InternalInfo>") > 0, "Catalog: есть InternalInfo");
Проверить(СтрНайти(XmlО, "<ChildObjects") = 0, "Catalog без команд: нет ChildObjects");

ПутьСм = ОбъединитьПути(Фикстуры, "CommonModules", "ХукНабор.xml");
ДСм = Новый Структура("Тип, Имя, СвойUuid, БазовыйUuid, ПутьИсходногоXml, Команды",
	"CommonModule", "ХукНабор", "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb", "22222222-2222-2222-2222-222222222222", ПутьСм, Неопределено);
XmlCm = Ч.XmlОбъекта(ДСм);
Проверить(СтрНайти(XmlCm, "<InternalInfo") = 0, "CommonModule: нет InternalInfo");
Проверить(СтрНайти(XmlCm, "<ChildObjects") = 0, "CommonModule: нет ChildObjects");

Скелет = Ч.СкелетInternalInfoКонфигурации();
Проверить(Скелет <> "", "скелет Configuration_InternalInfo");
Проверить(СтрНайти(Скелет, "xr:ContainedObject") > 0, "скелет: ContainedObject");

Если Ошибок = 0 Тогда
	Сообщить("OK: XML черновика");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
