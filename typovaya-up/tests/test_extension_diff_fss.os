// Класс 3 extension: diff БП↔УП (строка в БП, в УП закомментирована) → #Удаление + #Вставка.
// По мотивам ОтветНаЗапросФССДляРасчетаПособия / БольничныйЛист — без эвристики по реквизитам metadata.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Функция НормБезПс(С)
	Возврат СтрЗаменить(СтрЗаменить(С, Символы.ПС, ""), Символы.ВК, "");
КонецФункции

Ошибок = 0;
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
МСин = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
МСин.Инициализировать(Разбор);
МСин.СброситьЗаписиТудо();
ПС = Символы.ПС;

ТелоБп = Т("	Если ТипСообщения = 105 Тогда|" +
	"		РегистрыСведений.РегистрацииОтветовНаЗапросыФССДляРасчетаПособий.ЗагрузитьСообщение105(|" +
	"			Страхователь,|			ИдентификаторСообщения,|			Сообщение.ТекстСообщения,|" +
	"			Результат,|			Кэш);|" +
	"	КонецЕсли;|" +
	"	СсылкаНаОрганизацию = Объект.Организация;|" +
	"	ЗаполнитьРеквизитыПоУмолчанию();");

ТелоУп = Т("	Если ТипСообщения = 105 Или ТипСообщения = 10510 Тогда|" +
	"		РегистрыСведений.РегистрацииОтветовНаЗапросыФССДляРасчетаПособий.ЗагрузитьСообщение(|" +
	"			ТипСообщения,|			Страхователь,|			ИдентификаторСообщения,|" +
	"			Сообщение.ТекстСообщения,|			Результат,|			Кэш);|" +
	"	КонецЕсли;|" +
	"//	СсылкаНаОрганизацию = Объект.Организация;|" +
	"	ЗаполнитьРеквизитыПоУмолчанию();");

П = МСин.ПостроитьТелоИкДляРасширения(ТелоБп, ТелоУп, "Документ.ОтветНаЗапросФССДляРасчетаПособия", "ОбработатьСообщениеСЭДО");
П(П.hook = "changeAndControl" И П.decision = "auto", "hook CAC");
ТелоИк = П.hookBody;
П(СтрНайти(ТелоИк, "#Удаление") > 0 И СтрНайти(ТелоИк, "#КонецУдаления") > 0, "deletion block");
П(СтрНайти(ТелоИк, "Объект.Организация") > 0, "vendor attr in hook");
ПозУд = СтрНайти(ТелоИк, "#Удаление");
ПозОрг = СтрНайти(ТелоИк, "Объект.Организация");
П(ПозОрг > ПозУд, "attr inside deletion region");
П(СтрНайти(ТелоИк, "//") > 0 И СтрНайти(ТелоИк, "#Вставка") > 0, "commented UP in insert");
База = СокрП(МСин.ВосстановитьБазовыйТекстТиповогоИзХука(ТелоИк));
П(База = СокрП(ТелоБп), "vendor body byte-reconstructable from CAC");
П(МСин.ПолучитьЗаписиТудо().Количество() >= 2, "todo entries from diff");

Настр = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настр);
Мт = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody",
	"ОбработатьСообщениеСЭДО", "Процедура", "changed",
	"Процедура ОбработатьСообщениеСЭДО()" + ПС + ТелоБп + ПС + "КонецПроцедуры",
	"Процедура ОбработатьСообщениеСЭДО()" + ПС + ТелоУп + ПС + "КонецПроцедуры",
	"changeAndControl", "auto", ТелоИк);
Р = Ч.ОтрисоватьМетод("УП_", Мт, "Documents\ОтветНаЗапросФССДляРасчетаПособия\Ext\ObjectModule.bsl");
П(СтрНайти(Р, "Объект.Организация") > 0, "rendered hook");
ПозО = СтрНайти(Р, "Объект.Организация");
ПозД = СтрНайти(Р, "#Удаление");
П(ПозД > 0 И ПозД < ПозО, "render: attr after #Удаление");

Если Ошибок > 0 Тогда ВызватьИсключение "test_extension_diff_fss"; КонецЕсли;
Сообщить("OK: test_extension_diff_fss");