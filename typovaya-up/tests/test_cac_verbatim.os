Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция Т(З) Возврат СтрЗаменить(З, "|", Символы.ПС); КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Раз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Син = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Син.Инициализировать(Раз, ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os")));
Ошибок = 0;

Тип = "	Заг = 1;|" + "	|" + "	//выводим в список|" + "	Т = ""ВЫБРАТЬ"" + "" "" + ""Поле"";" + "|" + "	В = 2;";
Уп = "	Заг = 1;|" + "	|" + "	//выводим в список|" + "	// УП_начало|" + "	Х = 9;|" + "	// УП_конец|" + "	Т = ""ВЫБРАТЬ"" + "" "" + ""Поле"";" + "|" + "	В = 2;|";
П = Син.ПредложитьХук(Т(Тип), Т(Уп));
П(П.hook = "changeAndControl", "CAC with cosmetics");
База = Син.ВосстановитьБазовыйТекстТиповогоИзХука(П.hookBody);
П(База = Т(Тип), "vendor byte-equal after strip inserts");
ДирОк = Истина;
Для Каждого Стр Из СтрРазделить(П.hookBody, Символы.ПС, Истина) Цикл
	С = СокрЛП(Стр);
	Если С = "#Вставка" Или С = "#КонецВставки" Или С = "#Удаление" Или С = "#КонецУдаления" Тогда
		Если Стр <> С Тогда
			ДирОк = Ложь;
		КонецЕсли;
	КонецЕсли;
КонецЦикла;
П(ДирОк, "preprocessor at column 0");

Если Ошибок = 0 Тогда
	Сообщить("OK: CAC verbatim");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
