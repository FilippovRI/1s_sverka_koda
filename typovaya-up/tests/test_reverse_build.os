Перем Ошибок;
Перем Обр;

Процедура Проверить(Усл, Т)
	Если Не Усл Тогда
		Сообщить("FAIL: " + Т);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры
Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции
Функция НовР()
	Возврат Новый Структура("summary, mismatches, commentOnly, commentedVendor",
		Новый Структура("modules, methods, ok, mismatches, commentOnly, lost, commentedVendorLines, commentedVendorProblems", 0, 0, 0, 0, 0, 0, 0, 0),
		Новый Массив, Новый Массив, Новый Массив);
КонецФункции


Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "РазборМетодов.os"));
Обр = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОбратнаяСборка.os"));
Обр.Инициализировать(Разбор);
Ошибок = 0;

Бп = Т("Процедура А()|	Х = 1;|	Y = 2;|КонецПроцедуры||Процедура Б()|	З = 1;|КонецПроцедуры||Процедура В()|	Ц = 1;|КонецПроцедуры");
Уп = Т("Процедура А()|	Х = 1;|	//Y = 2;|	Y = 3; // АПК:1-выкл|КонецПроцедуры||Процедура Б()|	До = 1;|	З = 1;|КонецПроцедуры||Процедура В()|	//Ц = 1;|	Ц = 5;|КонецПроцедуры||Процедура Нов()|	Б();|КонецПроцедуры");
Восст = Т("Процедура А()|	Х = 1;|	Y = 2;|КонецПроцедуры||Процедура Б()|	З = 1;|КонецПроцедуры||Процедура В()|	Ц = 1;|КонецПроцедуры");
// Хорошее расширение: строка БП под #Удаление, комментарий УП в #Вставка.
Расш = Т("&ИзменениеИКонтроль(""А"")|Процедура УП_А()|	Х = 1;|#Удаление|	Y = 2;|#КонецУдаления|#Вставка|	//Y = 2;|	Y = 3;|#КонецВставки|КонецПроцедуры||&Перед(""Б"")|Процедура УП_Б()|	До = 1;|КонецПроцедуры||&ИзменениеИКонтроль(""В"")|Процедура УП_В()|#Удаление|	Ц = 1;|#КонецУдаления|#Вставка|	//Ц = 1;|	Ц = 5;|#КонецВставки|КонецПроцедуры||Процедура УП_Нов()|	УП_Б();|КонецПроцедуры");
Р = НовР();
Обр.ПроверитьМодуль("М.bsl", Расш, Уп, Восст, Бп, "УП_", Р);
Проверить(Р.summary.methods = 4 И Р.summary.ok = 4, "все методы собрались: " + Р.summary.ok + " " + ?(Р.mismatches.Количество() > 0, Р.mismatches[0].method + " " + Р.mismatches[0].up + " / " + Р.mismatches[0].built, ""));
Проверить(Р.summary.commentedVendorLines = 2 И Р.summary.commentedVendorProblems = 0, "закомм. строки БП под #Удаление");

// Плохое: в А потеряна вставка, у В нет хука (restored = БП), Нов не перенесён.
Расш2 = Т("&ИзменениеИКонтроль(""А"")|Процедура УП_А()|	Х = 1;|#Удаление|	Y = 2;|#КонецУдаления|КонецПроцедуры||&Перед(""Б"")|Процедура УП_Б()|	До = 1;|КонецПроцедуры");
Р = НовР();
Обр.ПроверитьМодуль("М.bsl", Расш2, Уп, Восст, Бп, "УП_", Р);
Проверить(Р.summary.mismatches = 3 И Р.summary.lost = 1, "расхождения: " + Р.summary.mismatches + " потеряно " + Р.summary.lost);
Проверить(Р.summary.commentedVendorProblems = 1 И Р.commentedVendor[0].method = "В", "В: строка БП выполняется");
Проверить(Обр.ТелоИиКПослеНаложения(Т("а|#Удаление|б|#КонецУдаления|#Вставка|в|#КонецВставки")) = Т("а|в"), "наложение ИиК");
Проверить(Обр.НормСтрока("	Y = 3; // АПК:1-выкл") = "Y=3;", "АПК отбрасывается");

Если Ошибок = 0 Тогда
	Сообщить("OK: обратная сборка");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
