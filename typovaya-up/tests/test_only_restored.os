// --только-restored: compare из кэша, restored байт-в-байт как полный прогон.

Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Exec(Стр)
	Код = 0;
	ЗапуститьПриложение(Стр, "", Истина, Код);
	Возврат Код;
КонецФункции

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Фикст = ОбъединитьПути(Каталог, "fixtures");
OUT = ОбъединитьПути(Каталог, "_only_restored_tmp");
Реф = ОбъединитьПути(Каталог, "_only_restored_ref");
МкОчист = Новый Массив;
МкОчист.Добавить(OUT);
МкОчист.Добавить(Реф);
Для Каждого П Из МкОчист Цикл
	Если (Новый Файл(П)).Существует() Тогда
		УдалитьФайлы(П);
	КонецЕсли;
КонецЦикла;

Гл = ОбъединитьПути(Корень, "src", "Главный.os");
БазАрг = " -и " + """" + ОбъединитьПути(Фикст, "UP") + """"
	+ " -п " + """" + ОбъединитьПути(Фикст, "BP") + """"
	+ " -н " + """" + ОбъединитьПути(Фикст, "merge.xml") + """"
	+ " --без-отчета -в " + """" + OUT + """";

П(Exec("oscript " + """" + Гл + """" + БазАрг) = 0, "полный прогон");

П(Exec("cp -a " + """" + ОбъединитьПути(OUT, "restored") + """" + "/. " + """" + Реф + """") = 0, "сохранить эталон restored");

П(Exec("oscript " + """" + Гл + """" + БазАрг + " --только-restored") = 0, "only-restored run");

П(Exec("diff -qr " + """" + Реф + """" + " " + """" + ОбъединитьПути(OUT, "restored") + """") = 0, "restored parity");

Если Ошибок > 0 Тогда
	ЗавершитьРаботу(1);
КонецЕсли;
Сообщить("OK test_only_restored");