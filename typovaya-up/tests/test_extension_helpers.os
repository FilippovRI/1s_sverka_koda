Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция Т(З) Возврат СтрЗаменить(З, "|", Символы.ПС); КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Ошибок = 0;

Исх = Т("Процедура Хук() Экспорт|	Лок();|КонецПроцедуры||Функция Лок()|	Возврат 1;|КонецФункции||Функция Цеп()|	Возврат Лок();|КонецФункции");
Пост = Т("Процедура Хук() Экспорт|КонецПроцедуры||Функция Лок()|	Возврат 0;|КонецФункции");
М = Новый Структура("sourceText, vendorText", Исх, Пост);
Мт = Новый Структура("name, status, hookBody", "Хук", "changed", "	Лок();");
Выб = Новый Массив;
Выб.Добавить(Мт);
Р = Доз.ДозаполнитьВспомогательные(М, Выб, "УП_");
П(Р.helpersCopied = 1, "one helper");
П(СтрНайти(Р.ДопМетоды[0], "Функция УП_Лок()") > 0, "rename when in vendor");

Исх2 = Т("Процедура Хук()|	Цеп();|КонецПроцедуры||Функция Цеп()|	Возврат Внутр();|КонецФункции||Функция Внутр()|	Возврат 0;|КонецФункции");
М2 = Новый Структура("sourceText, vendorText", Исх2, "");
Мт2 = Новый Структура("name, status, hookBody", "Хук", "changed", "	Цеп();");
Выб2 = Новый Массив;
Выб2.Добавить(Мт2);
Р2 = Доз.ДозаполнитьВспомогательные(М2, Выб2, "УП_");
П(Р2.helpersCopied >= 2, "transitive");

Без = Т("Процедура Хук()|	Нет();|КонецПроцедуры");
П(Доз.ПодсчитатьНеразрешённыеЛокальныеВызовы(Без) > 0, "unresolved before");
С = Т("Процедура Хук()|	Нет();|КонецПроцедуры||Процедура Нет()|КонецПроцедуры");
П(Доз.ПодсчитатьНеразрешённыеЛокальныеВызовы(С) = 0, "resolved after");

Соот = Новый Соответствие;
Соот.Вставить("Лок", "УП_Лок");
Пер = Доз.ПереписатьЛокальныеВызовы("	А = Лок();", Соот);
П(СтрНайти(Пер, "УП_Лок()") > 0, "rewrite call");

// Сканер: аннотации, строки запроса, Новый, объявления и глобальный контекст — не локальные вызовы.
Скан = Т("&НаСервере|Процедура Хук(Парам)|	Запрос = Новый Запрос(""ВЫБРАТЬ|	|	Сумма(Х) КАК С"");|"
	+ "	Ст = Новый Структура(""А"", 1);|	Н = СтрНайти(""а"", ""б"") + Макс(1, 2);|КонецПроцедуры");
Скан = СтрЗаменить(Скан, Символы.ПС + "	" + Символы.ПС + "	Сумма", Символы.ПС + "	|	Сумма");
П(Доз.ПодсчитатьНеразрешённыеЛокальныеВызовы(Скан) = 0, "scanner skips annotations/query/new/global");
Обр = Новый Массив;
П(Доз.ПодсчитатьНеразрешённыеЛокальныеВызовы(Т("Процедура Хук()|	НетТакого();|КонецПроцедуры"), Обр) = 1
	И Обр.Количество() = 1 И СтрНайти(Обр[0], "НетТакого") > 0, "scanner sample");
П(Доз.ИменаГлобальногоКонтекста().Получить("стрнайти") = Истина, "bsparser global scope");

// &ИзменениеИКонтроль (ПодписиДокументов.СведенияОПодписяхДокументов): типовые строки не переименовываются,
// хелперы, нужные только типовым строкам, не копируются.
ВызФЛ = "	ЗаполнитьСведенияПоФизическимЛицамВПодписяхДокументов(ОписаниеПодписей, Организация, ЗначенияПодписей, ДатаСведений, ВидДокумента);";
ВызОП = "	ЗаполнитьСведенияПоОснованиямПолномочийВПодписяхДокументов(ОписаниеПодписей, Организация, ЗначенияПодписей, ДатаСведений);";
Хелперы = "|Процедура ЗаполнитьСведенияПоФизическимЛицамВПодписяхДокументов(О, Орг, З, Д, В)|КонецПроцедуры|"
	+ "|Процедура ЗаполнитьСведенияПоОснованиямПолномочийВПодписяхДокументов(О, Орг, З, Д)|КонецПроцедуры|"
	+ "|Процедура ДопУП()|КонецПроцедуры";
ТелоИк = Т("	СтандартнаяОбработка = Истина;|#Удаление|	ЗарплатаКадры.ЗаполнитьСведенияОПодписяхДокументов(ОписаниеПодписей, Организация, ЗначенияПодписей, СтандартнаяОбработка);|#КонецУдаления|#Вставка|"
	+ "	ЗарплатаКадрыОтчеты.ЗаполнитьСведенияОПодписяхДокументов(ОписаниеПодписей, Организация, ЗначенияПодписей, СтандартнаяОбработка);|#КонецВставки|")
	+ ВызФЛ + Символы.ПС + ВызОП + Символы.ПС + "	Возврат ЗначенияПодписей;";
ИсхИк = Т("Функция СведенияОПодписяхДокументов(ОписаниеПодписей, Организация, ДатаСведений = Неопределено, ВидДокумента = Неопределено) Экспорт|КонецФункции|" + Хелперы);
МИк = Новый Структура("sourceText, vendorText", ИсхИк, ИсхИк);
МтИк = Новый Структура("name, status, hook, hookBody", "СведенияОПодписяхДокументов", "changed", "changeAndControl", ТелоИк);
ВыбИк = Новый Массив;
ВыбИк.Добавить(МтИк);
РИк = Доз.ДозаполнитьВспомогательные(МИк, ВыбИк, "УП_");
П(РИк.helpersCopied = 0, "CAC: no helpers for vendor lines");
Пер2 = Новый Соответствие;
Пер2.Вставить("ЗаполнитьСведенияПоФизическимЛицамВПодписяхДокументов", "УП_ЗаполнитьСведенияПоФизическимЛицамВПодписяхДокументов");
ТИк = Доз.ПереписатьВызовыВоВставках(ТелоИк + Т("|#Вставка|") + ВызФЛ + Т("|#КонецВставки"), Пер2);
П(СтрНайти(ТИк, Символы.ПС + ВызФЛ + Символы.ПС + ВызОП) > 0, "CAC: vendor lines byte-for-byte");
П(СтрЧислоВхождений(ТИк, "УП_ЗаполнитьСведенияПоФизическимЛицам") = 1, "CAC: rename only inside #Вставка");
// Вызов из #Вставка копирует хелпер с префиксом.
МтИк2 = Новый Структура("name, status, hook, hookBody", "СведенияОПодписяхДокументов", "changed", "changeAndControl",
	ТелоИк + Т("|#Вставка|") + ВызФЛ + Т("|#КонецВставки"));
ВыбИк2 = Новый Массив;
ВыбИк2.Добавить(МтИк2);
РИк2 = Доз.ДозаполнитьВспомогательные(МИк, ВыбИк2, "УП_");
П(РИк2.helpersCopied = 1 И РИк2.Переименования.Получить("ЗаполнитьСведенияПоФизическимЛицамВПодписяхДокументов") <> Неопределено,
	"CAC: helper from #Вставка copied");

// Дедуп: новый метод УП не копируется вторично как вспомогательный (УП_ДатаКакМесяцПодобратьДатуПоТексту).
ИсхД = Т("Функция ДатаКакМесяцПодобратьДатуПоТексту(Т) Экспорт|	Возврат Т;|КонецФункции||Процедура Хук()|	ДатаКакМесяцПодобратьДатуПоТексту(1);|КонецПроцедуры");
МД = Новый Структура("sourceText, vendorText", ИсхД, Т("Процедура Хук()|КонецПроцедуры"));
ВыбД = Новый Массив;
ВыбД.Добавить(Новый Структура("name, status, sourceText", "ДатаКакМесяцПодобратьДатуПоТексту", "added", Т("Функция ДатаКакМесяцПодобратьДатуПоТексту(Т) Экспорт|	Возврат Т;|КонецФункции")));
ВыбД.Добавить(Новый Структура("name, status, hook, hookBody", "Хук", "changed", "after", "	ДатаКакМесяцПодобратьДатуПоТексту(1);"));
РД = Доз.ДозаполнитьВспомогательные(МД, ВыбД, "УП_");
П(РД.helpersCopied = 0, "dedup: added method not copied as helper");
П(РД.Переименования.Получить("ДатаКакМесяцПодобратьДатуПоТексту") = "УП_ДатаКакМесяцПодобратьДатуПоТексту", "dedup: calls to added renamed");

Если Ошибок = 0 Тогда Сообщить("OK: extension helpers"); Иначе ЗавершитьРаботу(1); КонецЕсли;
