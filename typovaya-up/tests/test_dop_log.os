#Использовать asserts
Доп = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ДополненияПоЛогуImport.os"));
Т = "[ERROR] Файл - D:/out/restored/Catalogs/Тест/Forms/Ф/Ext/Form.xml: Неверный путь к данным: ""Объект.Реквизит""." + Символы.ПС
	+ "[ERROR] Неверное имя команды элемента формы. - CommonCommand.Тест";
Т = Доп.СклеитьРазорванныеСтрокиЛога(Т);
Пути = Доп.ПутиFormИзТекста(Т);
Команды = Доп.ИменаКомандИзТекста(Т);
Если Пути.Количество() <> 1 Или Команды.Количество() <> 1 Тогда
	ВызватьИсключение "parse fail paths=" + Пути.Количество() + " cmd=" + Команды.Количество();
КонецЕсли;
Сообщить("OK test_dop_log");