Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция Т(З) Возврат СтрЗаменить(З, "|", Символы.ПС); КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Р = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Син = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Раз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Без = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os"));
Син.Инициализировать(Раз, Без);
Ошибок = 0;

Х1 = Р.ХешЛексемСтроки("	Ид = 1; // комментарий");
Х2 = Р.ХешЛексемСтроки("Ид=1;");
П(Х1 <> "" И Х1 = Х2, "indent and comment same token hash");

Х3 = Р.ХешЛексемСтроки("Ид = 2;");
П(Х1 <> Х3, "literal change different hash");

Л = Р.ЛексемыСтроки("Текст = ""ВЫБРАТЬ"";");
П(Л.Количество() >= 3 И Л[2] = "S:ВЫБРАТЬ", "string literal one token");

П(Р.ХешЛексемСтроки("	// только комментарий") = "", "comment-only empty hash");
П(Р.ХешЛексемСтроки("	") = "", "blank line empty hash");

Тип = "	А = 1;|" + "	//выводим в список|" + "	|" + "	Б = 2;";
Уп = "	А = 1;|" + "	Б = 2;";
Пр = Син.ПредложитьХук(Т(Тип), Т(Уп));
П(Пр.decision = "skip", "comment/blank only skip");

Тип2 = "	А = 1;|" + "	Б = 2;";
Уп2 = "	А = 1;|" + "	Б = 3;";
Пр2 = Син.ПредложитьХук(Т(Тип2), Т(Уп2));
П(Пр2.decision = "auto" И Пр2.hook = "changeAndControl", "real change CAC");

ТелоТип = "	Заг = 1;|" + "	|" + "	// В запросе выбираем|" + "	Т = ""ВЫБРАТЬ"" + "" "" + ""Поле"";" + "|" + "	В = 2;";
ТелоУп2 = "	Заг = 1;|" + "	|" + "	// В запросе выбираем|" + "	// УП_начало|" + "	Х = 9;|" + "	// УП_конец|" + "	Т = ""ВЫБРАТЬ"" + "" "" + ""Поле"";" + "|" + "	В = 2;";
П4 = Син.ПредложитьХук(Т(ТелоТип), Т(ТелоУп2));
П(П4.hook = "changeAndControl", "mid insert CAC");
П(Син.ВосстановитьБазовыйТекстТиповогоИзХука(П4.hookBody) = Т(ТелоТип), "mid insert vendor byte-equal");

Если Ошибок = 0 Тогда
	Сообщить("OK: token line");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
