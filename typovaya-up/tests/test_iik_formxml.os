// Form.xml расширения: типовые реквизиты из заимствованной формы, только УП — свои.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда
		Р = ОбъединитьПути(Р, П3);
	КонецЕсли;
	Если П4 <> "" Тогда
		Р = ОбъединитьПути(Р, П4);
	КонецЕсли;
	Если П5 <> "" Тогда
		Р = ОбъединитьПути(Р, П5);
	КонецЕсли;
	Если П6 <> "" Тогда
		Р = ОбъединитьПути(Р, П6);
	КонецЕсли;
	Если П7 <> "" Тогда
		Р = ОбъединитьПути(Р, П7);
	КонецЕсли;
	Если П8 <> "" Тогда
		Р = ОбъединитьПути(Р, П8);
	КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция ТекстФайла(Путь)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), КодировкаТекста.UTF8);
КонецФункции

Функция XmlТип()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
		+ "			<MainAttribute>true</MainAttribute>" + Символы.ПС
		+ "			<Type><v8:Type>cfg:CatalogObject.СпрФорм</v8:Type></Type>" + Символы.ПС
		+ "			<UseAlways>" + Символы.ПС
		+ "				<Field>Объект.ПодразделениеОрганизации</Field>" + Символы.ПС
		+ "			</UseAlways>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""ПараметрыТорговыхТочек"" id=""3"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:InformationRegisterRecordManager.ПараметрыТорговыхТочек</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""НеИспользуется"" id=""9"">" + Символы.ПС
		+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""Список"" id=""20"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:DynamicList</v8:Type></Type>" + Символы.ПС
		+ "			<MainTable>Catalog.СпрФорм</MainTable>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "	</Attributes>" + Символы.ПС
		+ "	<ChildItems>" + Символы.ПС
		+ "		<InputField name=""Организация"" id=""10"">" + Символы.ПС
		+ "			<DataPath>Объект.Организация</DataPath>" + Символы.ПС
		+ "		</InputField>" + Символы.ПС
		+ "	</ChildItems>" + Символы.ПС
		+ "</Form>" + Символы.ПС;
КонецФункции

Функция XmlУп()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
		+ "			<MainAttribute>true</MainAttribute>" + Символы.ПС
		+ "			<Type><v8:Type>cfg:CatalogObject.СпрФорм</v8:Type></Type>" + Символы.ПС
		+ "			<UseAlways>" + Символы.ПС
		+ "				<Field>Объект.ПодразделениеОрганизации</Field>" + Символы.ПС
		+ "			</UseAlways>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""ПараметрыТорговыхТочек"" id=""3"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:InformationRegisterRecordManager.ПараметрыТорговыхТочек</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""Адрес"" id=""2"">" + Символы.ПС
		+ "			<Type><v8:Type>xs:string</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""НеИспользуется"" id=""9"">" + Символы.ПС
		+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "		<Attribute name=""Список"" id=""20"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:DynamicList</v8:Type></Type>" + Символы.ПС
		+ "			<MainTable>Catalog.СпрФорм</MainTable>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "	</Attributes>" + Символы.ПС
		+ "	<ChildItems>" + Символы.ПС
		+ "		<InputField name=""Организация"" id=""10"">" + Символы.ПС
		+ "			<DataPath>Объект.Организация</DataPath>" + Символы.ПС
		+ "		</InputField>" + Символы.ПС
		+ "	</ChildItems>" + Символы.ПС
		+ "</Form>" + Символы.ПС;
КонецФункции

Функция ЗаготовкаРасш()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
		+ "	<AutoCommandBar name=""ФормаКоманднаяПанель"" id=""-1""/>" + Символы.ПС
		+ "	<Attributes/>" + Символы.ПС
		+ "	<Commands/>" + Символы.ПС
		+ "	<ChildItems/>" + Символы.ПС
		+ "</Form>" + Символы.ПС;
КонецФункции

Функция МодульРасш()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере()" + Символы.ПС
		+ "	Объект.Код = """";" + Символы.ПС
		+ "	ПараметрыТорговыхТочек.Период = Дата(1, 1, 1);" + Символы.ПС
		+ "	Адрес = """";" + Символы.ПС
		+ "	Организация = Объект.Организация;" + Символы.ПС
		+ "	Список.КомпоновщикНастроек;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Ошибок = 0;
Кат = П(ТекущийСценарий().Каталог, "_iik_formxml_tmp");
ТипК = П(Кат, "typ");
УпК = П(Кат, "up");
БпК = П(Кат, "bp");
ВосстК = П(Кат, "rest");
ВосстУпК = П(Кат, "rest_up");
РасшК = П(Кат, "ext");
Отн = П("Catalogs", "СпрФорм", "Forms", "ФормаЭлемента", "Ext", "Form.xml");

Записать(П(ТипК, Отн), XmlТип());
Записать(П(УпК, Отн), XmlУп());
Записать(П(БпК, Отн), XmlТип());
Записать(П(ВосстК, Отн), XmlТип());
Записать(П(ВосстУпК, Отн), XmlУп());
Записать(П(РасшК, Отн), ЗаготовкаРасш());

Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));

// 1) restored = typovaya (без Адрес): типовые из заимствованной, Адрес — свой из УП
Н = Модуль.ДополнитьFormXmlРасшПоМодулю(П(ТипК, Отн), П(УпК, Отн), П(БпК, Отн), П(ВосстК, Отн), П(РасшК, Отн), МодульРасш());
Проверить(Н = 3, "добавлено 3 реквизита, получено " + Н);
Т = ТекстФайла(П(РасшК, Отн));
Проверить(СтрНайти(Т, "<Attribute name=""Объект"" id=""1"">") > 0, "Объект из typovaya/заимствованной");
Проверить(СтрНайти(Т, "<MainAttribute>true</MainAttribute>") > 0, "у Объекта MainAttribute typovaya");
Проверить(СтрНайти(Т, "<Attribute name=""ПараметрыТорговыхТочек"" id=""3"">") > 0, "ПараметрыТорговыхТочек из typovaya");
Проверить(СтрНайти(Т, "<Attribute name=""Адрес"" id=""2"">") > 0, "Адрес только УП добавлен как свой");
Проверить(СтрНайти(Т, "<Attribute name=""НеИспользуется"" id=""9"">") = 0, "неупоминаемый реквизит не добавляется");
Проверить(СтрЧислоВхождений(Т, "<Attribute name=""Объект""") = 1, "нет дубля Объект");
Проверить(СтрНайти(Т, "<InputField name=""Организация""") = 0, "типовой элемент не копируется в Form.xml расширения");
Проверить(СтрНайти(Т, "<DataPath>Объект.Организация</DataPath>") = 0, "нет DataPath типового элемента");
Проверить(СтрНайти(Т, "<Attribute name=""Список""") = 0, "динамический список не копируется в Form.xml расширения");
Проверить(СтрНайти(Т, "<MainTable>") = 0, "нет MainTable динамического списка");
Проверить(СтрНайти(Т, "<UseAlways>") = 0, "UseAlways типового Объект не копируется");
Проверить(СтрНайти(Т, "Объект.ПодразделениеОрганизации") = 0, "нет пути UseAlways");

// 2) идемпотентность
Н2 = Модуль.ДополнитьFormXmlРасшПоМодулю(П(ТипК, Отн), П(УпК, Отн), П(БпК, Отн), П(ВосстК, Отн), П(РасшК, Отн), МодульРасш());
Проверить(Н2 = 0, "повторный вызов ничего не добавляет");
Проверить(ТекстФайла(П(РасшК, Отн)) = Т, "Form.xml не меняется при повторе");

// 3) формы из УП: Адрес уже в restored — берём из главной, не как «только УП» с другим id
Расш2 = П(Кат, "ext2", Отн);
Записать(Расш2, ЗаготовкаРасш());
Н3 = Модуль.ДополнитьFormXmlРасшПоМодулю(П(ТипК, Отн), П(УпК, Отн), П(БпК, Отн), П(ВосстУпК, Отн), Расш2, МодульРасш());
Проверить(Н3 = 3, "формы из УП: тоже 3 реквизита, получено " + Н3);
Т3 = ТекстФайла(Расш2);
Проверить(СтрНайти(Т3, "<Attribute name=""Адрес"" id=""2"">") > 0, "Адрес взят из restored (главная форма)");
Проверить(СтрНайти(Т3, "<Attribute name=""Объект"" id=""1"">") > 0, "Объект из restored");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_formxml");
Иначе
	Сообщить("FAILED test_iik_formxml: " + Ошибок);
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));