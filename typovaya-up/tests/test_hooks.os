// Юнит-тесты синтеза хуков.

Перем Ошибок;
Перем Разбор;
Перем Синтез;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция ТелоИз(Знач СПайпами)
	Возврат СтрЗаменить(СПайпами, "|", Символы.ПС);
КонецФункции

Процедура ВыполнитьТесты()
	Каталог = ТекущийСценарий().Каталог;
	Корень = ОбъединитьПути(Каталог, "..");
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
	Без = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os"));
	Синтез = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
	Синтез.Инициализировать(Разбор, Без);
	Ошибок = 0;

	П = Синтез.ПредложитьХук(ТелоИз("А = 1;"), ТелоИз("А = 1;|Б = 2;"));
	Проверить(П.decision = "auto" И П.hook = "after", "After: " + П.decision + "/" + П.hook);
	Проверить(СтрНайти(П.hookBody, "Б = 2;") > 0, "After hookBody");

	П = Синтез.ПредложитьХук(ТелоИз("Б = 1;"), ТелоИз("А = 0;|Б = 1;"));
	Проверить(П.decision = "auto" И П.hook = "before", "Before: " + П.decision + "/" + П.hook);
	Проверить(СтрНайти(П.hookBody, "А = 0;") > 0, "Before hookBody");

	П = Синтез.ПредложитьХук(ТелоИз("Х = 1;|У = 2;"), ТелоИз("Х = 1;|Вставка = 1;|У = 2;"));
	Проверить(П.decision = "auto" И П.hook = "changeAndControl", "Insert CAC: " + П.decision + "/" + П.hook);
	Проверить(СтрНайти(П.hookBody, "#Вставка") > 0 И СтрНайти(П.hookBody, "#КонецВставки") > 0, "Insert markers");

	П = Синтез.ПредложитьХук(ТелоИз("Старое = 1;|Общее = 2;"), ТелоИз("Новое = 1;|Общее = 2;"));
	Проверить(П.decision = "auto" И П.hook = "changeAndControl", "Replace CAC: " + П.decision + "/" + П.hook);
	Проверить(СтрНайти(П.hookBody, "#Удаление") > 0, "Delete marker");

	П = Синтез.ПредложитьХук(ТелоИз("А = 1;|Б = 2;"), ТелоИз("Х = 9;|У = 8;"));
	Проверить(П.decision = "auto" И П.hook = "instead", "Instead: " + П.decision + "/" + П.hook);

	П = Синтез.ПредложитьХук("", "А = 1;");
	Проверить(П.decision = "manual" И П.hook = "none", "Empty typical: " + П.decision + "/" + П.hook);

	П = Синтез.ПредложитьХук("А = 1;", "Х = 1;" + Символы.ПС + "ПродолжитьВызов();" + Символы.ПС + "У = 2;");
	Проверить(П.decision = "auto" И П.hook = "instead", "Proceed Instead");
	Проверить(СтрНайти(П.hookBody, "ПродолжитьВызов") = 0, "Proceed stripped");
	Проверить(Не П.insteadAppendContinue, "no append continue in draft");

	Полный = "Процедура Т()" + Символы.ПС + "	А = 1;" + Символы.ПС + "КонецПроцедуры";
	ТелоМ = Разбор.ИзвлечьТелоМетода(Полный);
	Проверить(СокрЛП(ТелоМ) = "А = 1;", "Body extract: [" + ТелоМ + "]");

	Если Ошибок = 0 Тогда
		Сообщить("OK: синтез хуков");
	Иначе
		Сообщить("FAIL: ошибок " + Ошибок);
		ЗавершитьРаботу(1);
	КонецЕсли;
КонецПроцедуры

ВыполнитьТесты();
