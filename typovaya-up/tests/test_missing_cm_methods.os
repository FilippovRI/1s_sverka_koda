// Перенос методов, которых нет в typovaya, но есть в УП, и перепись вызовов в расширении.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Процедура Писать(Путь, Текст)
	Ф = Новый Файл(Путь);
	Если Ф.Путь <> "" Тогда
		СоздатьКаталог(Ф.Путь);
	КонецЕсли;
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Процедура ОбеспечитьКат(Путь)
	СоздатьКаталог(Путь);
КонецПроцедуры

Процедура УдалитьКатТихо(Путь)
	Попытка
		УдалитьФайлы(Путь);
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция Читать(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

Функция ПутьМЧтен(Корень, Имя)
	Возврат ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "CommonModules"), Имя), "Ext"), "Module.bsl");
КонецФункции

Функция ПутьМ(Корень, Имя)
	К = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "CommonModules"), Имя), "Ext");
	ОбеспечитьКат(К);
	Возврат ОбъединитьПути(К, "Module.bsl");
КонецФункции

Функция ПутьММ(Корень, Папка, Имя)
	К = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, Папка), Имя), "Ext");
	ОбеспечитьКат(К);
	Возврат ОбъединитьПути(К, "ManagerModule.bsl");
КонецФункции

Функция XmlОб(Тег, Имя, Уид)
	Возврат "<MetaDataObject><" + Тег + " uuid=""" + Уид + """><Properties><Name>" + Имя + "</Name></Properties></" + Тег + "></MetaDataObject>";
КонецФункции

Функция XmlКонф()
	Возврат "<MetaDataObject><Configuration uuid=""aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee""><Properties><Name>УП_Доработки</Name></Properties><ChildObjects>"
		+ Символы.ПС + "		</ChildObjects></Configuration></MetaDataObject>";
КонецФункции

КореньРепо = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "РазборМетодов.os"));
Контракт = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "КонтрактМетода.os"));
Сиг = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "ПереносСигнатур.os"));
Сиг.Инициализировать(Разбор, Контракт);
Мод = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "ПереносОтсутствующихМетодов.os"));
Мелкие = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "ПереносМелкихОбъектовУп.os"));
Мод.Инициализировать(Разбор, Сиг, Мелкие);
Ошибок = 0;

База = ОбъединитьПути(КаталогВременныхФайлов(), "tu_missing_cm_methods");
УдалитьКатТихо(База);
КРасш = ОбъединитьПути(База, "extension");
КВосст = ОбъединитьПути(База, "restored");
КУп = ОбъединитьПути(База, "up");
КОтч = ОбъединитьПути(База, "report");
ОбеспечитьКат(КРасш);
ОбеспечитьКат(КВосст);
ОбеспечитьКат(КУп);
Писать(ОбъединитьПути(КРасш, "Configuration.xml"), XmlКонф());

// --- typovaya Lib: метод Foo отсутствует ---
Писать(ПутьМ(КВосст, "ЗарплатаКадрыОтчеты"), Т(
	"Процедура НастроитьВариантыОтчетов(Настройки) Экспорт|	А = 1;|КонецПроцедуры|"));
// есть каталоги, на которые ссылается переносимый метод
ОбеспечитьКат(ОбъединитьПути(ОбъединитьПути(КВосст, "Catalogs"), "ФизическиеЛица"));
З = Новый ЗаписьТекста(ОбъединитьПути(ОбъединитьПути(КВосст, "Catalogs"), "ФизическиеЛица.xml"), КодировкаТекста.UTF8);
З.Записать("<MetaDataObject/>");
З.Закрыть();

// --- УП: есть УправлениеДоступомЗаполнитьСвойстваВидаДоступа и вспомогательный Бар ---
Писать(ПутьМ(КУп, "ЗарплатаКадрыОтчеты"), Т(
	"Процедура НастроитьВариантыОтчетов(Настройки) Экспорт|	А = 1;|КонецПроцедуры||"
	+ "Процедура УправлениеДоступомЗаполнитьСвойстваВидаДоступа(ВидыДоступа) Экспорт|"
	+ "	ВидДоступа = ВидыДоступа.Добавить();|"
	+ "	ВидДоступа.ТипЗначений = Тип(""СправочникСсылка.ФизическиеЛица"");|"
	+ "	Бар();|"
	+ "КонецПроцедуры||"
	+ "Процедура Бар()|"
	+ "	Б = 1;|"
	+ "КонецПроцедуры|"));

// --- расширение: ИиК + вызов в #Вставка, typovaya-вызов в #Удаление не должен переписаться (его нет, но контроль) ---
// Заимствованный модуль уже в расширении (без недостающего метода)
Писать(ПутьМ(КРасш, "ЗарплатаКадрыОтчеты"), Т(
	"#Если Сервер Тогда|"
	+ "Процедура УП_НастроитьВариантыОтчетов(Настройки) Экспорт|	А = 1;|КонецПроцедуры|"
	+ "#КонецЕсли|"));
Писать(ПутьМ(КРасш, "УправлениеДоступомПереопределяемый"), Т(
	"&ИзменениеИКонтроль(""ПриЗаполненииВидовДоступа"")|"
	+ "Процедура УП_ПриЗаполненииВидовДоступа(ВидыДоступа) Экспорт|"
	+ "#Удаление|"
	+ "	ЗарплатаКадры.ПриЗаполненииВидовДоступа(ВидыДоступа);|"
	+ "#КонецУдаления|"
	+ "	РегламентированнаяОтчетность.ПриЗаполненииВидовДоступа(ВидыДоступа);|"
	+ "#Вставка|"
	+ "	ЗарплатаКадрыОтчеты.УправлениеДоступомЗаполнитьСвойстваВидаДоступа(ВидыДоступа);|"
	+ "#КонецВставки|"
	+ "КонецПроцедуры|"));
// собственный (не ИиК) метод тоже должен переписаться
Писать(ПутьМ(КРасш, "УП_Свой"), Т(
	"Процедура УП_Вызвать() Экспорт|"
	+ "	ЗарплатаКадрыОтчеты.УправлениеДоступомЗаполнитьСвойстваВидаДоступа(Неопределено);|"
	+ "КонецПроцедуры|"));

// модуль typovaya ЗарплатаКадры для вызова в #Удаление — не наша дыра, пусть будет в restored
Писать(ПутьМ(КВосст, "ЗарплатаКадры"), Т("Процедура ПриЗаполненииВидовДоступа(ВидыДоступа) Экспорт|КонецПроцедуры|"));
Писать(ПутьМ(КУп, "ЗарплатаКадры"), Т("Процедура ПриЗаполненииВидовДоступа(ВидыДоступа) Экспорт|КонецПроцедуры|"));

Лог = Новый Массив;
Р = Мод.Применить(КРасш, КВосст, КУп, "УП_", Лог, КОтч);
Сообщить("LOG");
Для Каждого С Из Лог Цикл
	Сообщить(С);
КонецЦикла;
П(Р.ok, "применить ok: " + Р.reason);
П(Р.transferred.Количество() >= 1, "есть перенесённые: " + Р.transferred.Количество());

ТекстЛиб = Читать(ПутьМ(КРасш, "ЗарплатаКадрыОтчеты"));
П(СтрНайти(ТекстЛиб, "Процедура УП_УправлениеДоступомЗаполнитьСвойстваВидаДоступа(") > 0, "добавлен УП_ метод: " + ТекстЛиб);
П(СтрНайти(ТекстЛиб, "Процедура УП_Бар(") > 0 Или СтрНайти(ТекстЛиб, "Процедура УП_Бар(") > 0, "транзитивно УП_Бар: " + ТекстЛиб);
П(СтрНайти(ТекстЛиб, "Тип(""СправочникСсылка.ФизическиеЛица"")") > 0, "тело УП сохранено");
П(СтрНайти(ТекстЛиб, "#Если Сервер Тогда") > 0 И СтрНайти(ТекстЛиб, "#КонецЕсли") > 0, "обёртка модуля на месте");
// локальный вызов Бар() в перенесённом теле должен стать УП_Бар()
П(СтрНайти(ТекстЛиб, "УП_Бар()") > 0, "локальный вызов Бар переписан: " + ТекстЛиб);

ТекстПереопр = Читать(ПутьМ(КРасш, "УправлениеДоступомПереопределяемый"));
П(СтрНайти(ТекстПереопр, "ЗарплатаКадрыОтчеты.УП_УправлениеДоступомЗаполнитьСвойстваВидаДоступа(") > 0,
	"вызов в #Вставка переписан: " + ТекстПереопр);
П(СтрНайти(ТекстПереопр, "ЗарплатаКадры.ПриЗаполненииВидовДоступа(") > 0,
	"вызов typovaya в #Удаление не тронут: " + ТекстПереопр);
П(СтрНайти(ТекстПереопр, "#Удаление") > 0 И СтрНайти(ТекстПереопр, "#Вставка") > 0, "директивы ИиК на месте");

ТекстСвой = Читать(ПутьМ(КРасш, "УП_Свой"));
П(СтрНайти(ТекстСвой, "ЗарплатаКадрыОтчеты.УП_УправлениеДоступомЗаполнитьСвойстваВидаДоступа(") > 0,
	"вызов вне ИиК переписан: " + ТекстСвой);

// идемпотентность
Р2 = Мод.Применить(КРасш, КВосст, КУп, "УП_", Новый Массив, "");
П(СтрЧислоВхождений(Читать(ПутьМ(КРасш, "ЗарплатаКадрыОтчеты")), "Процедура УП_УправлениеДоступомЗаполнитьСвойстваВидаДоступа(") = 1,
	"без дубля метода при повторном прогоне");

// метод со ссылкой на документ только УП — не переносим
Писать(ПутьМ(КУп, "УП_ТолькоУпДок"), Т(
	"Процедура ОбработатьДокумент() Экспорт|	А = Метаданные.Документы.УникальныйДокументУп;|КонецПроцедуры|"));
Писать(ПутьМ(КРасш, "УП_КлиентДок"), Т(
	"Процедура УП_К() Экспорт|	УП_ТолькоУпДок.ОбработатьДокумент();|КонецПроцедуры|"));
// модуль есть в restored (заимствовать можно), но документа нет
Писать(ПутьМ(КВосст, "УП_ТолькоУпДок"), Т("Процедура Другая() Экспорт|КонецПроцедуры|"));
Р3 = Мод.Применить(КРасш, КВосст, КУп, "УП_", Новый Массив, КОтч);
НашлиПропуск = Ложь;
Для Каждого Э Из Р3.skipped Цикл
	Если СтрНайти(Э.Цепочка, "ОбработатьДокумент") > 0 Тогда
		НашлиПропуск = Истина;
		П(СтрНайти(Э.Причина, "Документы") > 0 Или СтрНайти(Э.Причина, "нет в restored") > 0,
			"причина пропуска документа: " + Э.Причина);
	КонецЕсли;
КонецЦикла;
П(НашлиПропуск, "метод со ссылкой на отсутствующий документ в пропуске");
П(СтрНайти(Читать(ПутьМЧтен(КРасш, "УП_ТолькоУпДок")), "УП_ОбработатьДокумент") = 0, "документарный метод не перенесён");

// объект есть в restored, метод только в УП ManagerModule — заимствовать + УП_ + перепись
УидКонтр = "11111111-2222-3333-4444-555555555555";
Писать(ОбъединитьПути(ОбъединитьПути(КВосст, "Catalogs"), "Контрагенты.xml"), XmlОб("Catalog", "Контрагенты", УидКонтр));
Писать(ПутьММ(КВосст, "Catalogs", "Контрагенты"), Т("Процедура СуществующийВБп() Экспорт|	А = 1;|КонецПроцедуры|"));
Писать(ОбъединитьПути(ОбъединитьПути(КУп, "Catalogs"), "Контрагенты.xml"), XmlОб("Catalog", "Контрагенты", УидКонтр));
Писать(ПутьММ(КУп, "Catalogs", "Контрагенты"), Т(
	"Процедура ФизическомуЛицуЗаписываетсяСчетИП(Контрагент) Экспорт|"
	+ "	БарМен();|"
	+ "КонецПроцедуры|"
	+ "Процедура БарМен()|"
	+ "	А = 1;|"
	+ "КонецПроцедуры|"
	+ "Процедура СуществующийВБп() Экспорт|"
	+ "	А = 2;|"
	+ "КонецПроцедуры|"
	+ "Процедура СМетаданнымиНетВБп() Экспорт|"
	+ "	А = Метаданные.Документы.НетТакогоДокумента;|"
	+ "КонецПроцедуры|"));
Писать(ПутьМ(КРасш, "УП_КлиентМен"), Т(
	"Процедура УП_М() Экспорт|"
	+ "	Справочники.Контрагенты.ФизическомуЛицуЗаписываетсяСчетИП(Неопределено);|"
	+ "	Справочники.Контрагенты.НайтиПоКоду(""1"");|"
	+ "	Справочники.Контрагенты.СуществующийВБп();|"
	+ "	Справочники.Контрагенты.СМетаданнымиНетВБп();|"
	+ "КонецПроцедуры|"));
Р4 = Мод.Применить(КРасш, КВосст, КУп, "УП_", Новый Массив, "");
ПутьМмРасш = ПутьММ(КРасш, "Catalogs", "Контрагенты");
ТекстМм = Читать(ПутьМмРасш);
П(СтрНайти(ТекстМм, "Процедура УП_ФизическомуЛицуЗаписываетсяСчетИП") > 0, "метод менеджера перенесён как УП_");
П(СтрНайти(ТекстМм, "Процедура УП_БарМен") > 0, "транзитивный метод менеджера перенесён");
П(СтрНайти(ТекстМм, "УП_БарМен()") > 0, "локальный вызов в перенесённом методе менеджера переписан");
П(СтрНайти(ТекстМм, "Процедура УП_СуществующийВБп") = 0, "метод, уже есть в typovaya, не переносим");
П(СтрНайти(ТекстМм, "УП_СМетаданнымиНетВБп") = 0, "метод менеджера со ссылкой на отсутствующие метаданные не перенесён");
ТекстВыз = Читать(ПутьМЧтен(КРасш, "УП_КлиентМен"));
П(СтрНайти(ТекстВыз, "Справочники.Контрагенты.УП_ФизическомуЛицуЗаписываетсяСчетИП") > 0, "вызов менеджера переписан на УП_");
П(СтрНайти(ТекстВыз, "Справочники.Контрагенты.НайтиПоКоду") > 0, "платформенный НайтиПоКоду не трогаем");
П(СтрНайти(ТекстВыз, "Справочники.Контрагенты.СуществующийВБп()") > 0, "вызов typovaya-метода менеджера не префиксируем");
XmlКонтрРасш = Читать(ОбъединитьПути(ОбъединитьПути(КРасш, "Catalogs"), "Контрагенты.xml"));
П(СтрНайти(XmlКонтрРасш, "ObjectBelonging>Adopted") > 0, "объект заимствован как Adopted");
П(СтрНайти(XmlКонтрРасш, УидКонтр) > 0, "ExtendedConfigurationObject = uuid typovaya");
П(Р4.adopted.Количество() >= 1, "в отчёте есть заимствованный объект: " + Р4.adopted.Количество());
НашлиАдопт = Ложь;
Для Каждого ИмяА Из Р4.adopted Цикл
	Если СтрНайти(ИмяА, "Контрагенты") > 0 Тогда
		НашлиАдопт = Истина;
	КонецЕсли;
КонецЦикла;
П(НашлиАдопт, "Catalog.Контрагенты в списке заимствованных");
НашлиМетаМен = Ложь;
НашлиПлатф = Ложь;
Для Каждого Э Из Р4.skipped Цикл
	Если СтрНайти(Э.Цепочка, "СМетаданнымиНетВБп") > 0 Тогда
		НашлиМетаМен = Истина;
	КонецЕсли;
	Если СтрНайти(Э.Цепочка, "НайтиПоКоду") > 0 Тогда
		НашлиПлатф = Истина;
	КонецЕсли;
КонецЦикла;
П(НашлиМетаМен, "менеджерный метод со ссылкой на отсутствующие метаданные в пропуске");
П(Не НашлиПлатф, "платформенный НайтиПоКоду не попадает в пропуск");

// объекта нет в restored, метод есть в УП — пропуск
Писать(ОбъединитьПути(ОбъединитьПути(КУп, "Documents"), "ТолькоУпСчет.xml"), XmlОб("Document", "ТолькоУпСчет", "22222222-2222-3333-4444-555555555555"));
Писать(ПутьММ(КУп, "Documents", "ТолькоУпСчет"), Т(
	"Процедура ПечатьСпец() Экспорт|	А = 1;|КонецПроцедуры|"));
Писать(ПутьМ(КРасш, "УП_КлиентНетОб"), Т(
	"Процедура УП_НетОб() Экспорт|	Документы.ТолькоУпСчет.ПечатьСпец();|КонецПроцедуры|"));
Р5 = Мод.Применить(КРасш, КВосст, КУп, "УП_", Новый Массив, "");
НашлиНетОб = Ложь;
Для Каждого Э Из Р5.skipped Цикл
	Если СтрНайти(Э.Цепочка, "ТолькоУпСчет") > 0 Тогда
		НашлиНетОб = Истина;
		П(СтрНайти(Э.Причина, "нет в restored") > 0, "причина: объекта нет в restored — " + Э.Причина);
	КонецЕсли;
КонецЦикла;
П(НашлиНетОб, "метод менеджера отсутствующего в restored объекта в пропуске");
П(СтрНайти(Читать(ПутьММ(КРасш, "Documents", "ТолькоУпСчет")), "УП_ПечатьСпец") = 0, "метод объекта не из typovaya не перенесён");

// ИиК: только #Вставка
Писать(ПутьММ(КУп, "Catalogs", "Контрагенты"), Читать(ПутьММ(КУп, "Catalogs", "Контрагенты")) + Т(
	"Процедура ОписаниеДляПечати() Экспорт|	Возврат;|КонецПроцедуры|"));
Писать(ПутьМ(КРасш, "УП_КлиентИикМен"), Т(
	"&ИзменениеИКонтроль(""ХукМен"")|"
	+ "Процедура УП_ХукМен()|"
	+ "#Удаление|"
	+ "	Справочники.Контрагенты.ОписаниеДляПечати();|"
	+ "#КонецУдаления|"
	+ "#Вставка|"
	+ "	Справочники.Контрагенты.ОписаниеДляПечати();|"
	+ "#КонецВставки|"
	+ "КонецПроцедуры|"));
Р6 = Мод.Применить(КРасш, КВосст, КУп, "УП_", Новый Массив, "");
ТекстИик = Читать(ПутьМЧтен(КРасш, "УП_КлиентИикМен"));
ПозУд = СтрНайти(ТекстИик, "#Удаление");
ПозВст = СтрНайти(ТекстИик, "#Вставка");
П(ПозУд > 0 И ПозВст > ПозУд, "сохранились маркеры ИиК менеджера");
БлокУд = Сред(ТекстИик, ПозУд, ПозВст - ПозУд);
П(СтрНайти(БлокУд, "Справочники.Контрагенты.ОписаниеДляПечати") > 0, "в #Удаление typovaya-вызов менеджера не префиксируем");
П(СтрНайти(БлокУд, "УП_ОписаниеДляПечати") = 0, "в #Удаление нет УП_ префикса менеджера");
П(СтрНайти(Сред(ТекстИик, ПозВст), "Справочники.Контрагенты.УП_ОписаниеДляПечати") > 0, "в #Вставка вызов менеджера переписан");

// сбор ссылок метаданных
Сс = Мод.СобратьСсылкиМетаданных(Т("Тип(""СправочникСсылка.ФизическиеЛица""); Метаданные.Документы.Акт;"));
П(Сс.Количество() = 2, "собраны 2 ссылки: " + Сс.Количество());

УдалитьКатТихо(База);

Если Ошибок = 0 Тогда
	Сообщить("OK");
	ЗавершитьРаботу(0);
Иначе
	Сообщить("FAILED: " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
