Перем Ошибок;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Без = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os"));
Синтез.Инициализировать(Разбор, Без);
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Сам = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СамопроверкаВыхода.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ошибок = 0;

П(СтрНайти(Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "Тест"), "e1000001-") = 0, "no e1000001 after actualize");
П(СтрНайти(Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "Тест"), "xr:ObjectId") > 0, "InternalInfo kept");

Сам.Инициализировать(Разбор, Доз, Синтез);
М = Новый Массив;
Сводка = Новый Структура("counts", Новый Структура("manual", 1));
Р = Сам.ПроверитьКаталогВыхода(ОбъединитьПути(Корень, "tests/fixtures/UP/out_missing"), М, Сводка);
П(Р.categories.Количество() = 5, "five categories");

Если Ошибок = 0 Тогда Сообщить("OK: self check"); Иначе ЗавершитьРаботу(1); КонецЕсли;
