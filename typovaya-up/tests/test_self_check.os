Перем Ошибок;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтезХуков.os"));
Без = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "БезопасностьПереноса.os"));
Синтез.Инициализировать(Разбор, Без);
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Сам = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СамопроверкаВыхода.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ошибок = 0;

П(СтрНайти(Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "Тест"), "e1000001-") = 0, "no e1000001 after actualize");
П(СтрНайти(Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "Тест"), "xr:ObjectId") > 0, "InternalInfo kept");

Сам.Инициализировать(Разбор, Доз, Синтез);
М = Новый Массив;
Сводка = Новый Структура("counts", Новый Структура("manual", 1));
Р = Сам.ПроверитьКаталогВыхода(ОбъединитьПути(Корень, "tests/fixtures/UP/out_missing"), М, Сводка);
П(Р.categories.Количество() = 9, "nine categories");

// ClassId шаблона InternalInfo — ровно платформенные константы (ObjectId меняются, ClassId — никогда).
Эталон = Новый Соответствие;
Для Каждого Ид Из Сам.ПлатформенныеClassIdКонфигурации() Цикл
	Эталон.Вставить(Ид, Истина);
КонецЦикла;
Вр = ПолучитьИмяВременногоФайла("sc");
СоздатьКаталог(ОбъединитьПути(Вр, "extension"));
Т = Новый ТекстовыйДокумент;
Т.УстановитьТекст(Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "Тест"));
Т.Записать(ОбъединитьПути(Вр, "extension", "Configuration.xml"), КодировкаТекста.UTF8);
Иды = Сам.ClassIdИзФайла(ОбъединитьПути(Вр, "extension", "Configuration.xml"));
П(Иды.Количество() = 7, "seven ClassId");
Для Каждого Ид Из Иды Цикл
	П(Эталон.Получить(Ид) = Истина, "platform ClassId " + Ид);
КонецЦикла;
П(Сам.ПроверитьClassId(ОбъединитьПути(Вр, "extension")).ok, "invalid_class_id ok");
// Эталон — выгрузка УП: ClassId вывода == ClassId исходной.
СоздатьКаталог(ОбъединитьПути(Вр, "src"));
Т.Записать(ОбъединитьПути(Вр, "src", "Configuration.xml"), КодировкаТекста.UTF8);
П(Сам.ПроверитьClassId(ОбъединитьПути(Вр, "extension"), ОбъединитьПути(Вр, "src")).ok, "ClassId == source");
Т.УстановитьТекст(СтрЗаменить(Т.ПолучитьТекст(), "008048da11f9", "008048da11f3"));
Т.Записать(ОбъединитьПути(Вр, "extension", "Configuration.xml"), КодировкаТекста.UTF8);
Ркл = Сам.ПроверитьClassId(ОбъединитьПути(Вр, "extension"), ОбъединитьПути(Вр, "src"));
П(Не Ркл.ok И Ркл.count = 1 И Ркл.samples[0] = "9fcd25a0-4822-11d4-9414-008048da11f3", "broken ClassId detected");

// Повтор метода и синтаксис.
Кат = ОбъединитьПути(ОбъединитьПути(Вр, "extension"), "CommonModules", "М", "Ext");
СоздатьКаталог(Кат);
Т.УстановитьТекст("Процедура А()" + Символы.ПС + "КонецПроцедуры" + Символы.ПС + "Процедура а()" + Символы.ПС
	+ "	Б(1)" + Символы.ПС + "	В = 1;" + Символы.ПС + "КонецПроцедуры");
Т.Записать(ОбъединитьПути(Кат, "Module.bsl"), КодировкаТекста.UTF8);
Рдп = Сам.ПроверитьПовторыМетодов(ОбъединитьПути(Вр, "extension"), ОбъединитьПути(Вр, "restored"));
П(Рдп.count = 1 И Не Рдп.ok, "duplicate_method_definitions");
Рсн = Сам.ПроверитьСинтаксис(ОбъединитьПути(Вр, "extension"), ОбъединитьПути(Вр, "restored"), Неопределено);
ЕстьСтрока5 = Ложь;
Для Каждого Обр Из Рсн.samples Цикл
	ЕстьСтрока5 = ЕстьСтрока5 Или Обр.line = 5;
КонецЦикла;
П(Рсн.count >= 2 И ЕстьСтрока5, "syntax_errors: duplicate + missing semicolon (line 5)");
Выкл = Сам.ПроверитьСинтаксис(ОбъединитьПути(Вр, "extension"), "", Новый Структура("enabled, limit", Ложь, 0));
П(Выкл.ok И Выкл.count = 0, "syntax disabled");
Лим = Сам.ПроверитьСинтаксис(ОбъединитьПути(Вр, "extension"), "", Новый Структура("enabled, limit", Истина, 1));
П(СтрНайти(Лим.detail, "проверено 1") > 0, "syntax limit");
УдалитьФайлы(Вр);

Если Ошибок = 0 Тогда Сообщить("OK: self check"); Иначе ЗавершитьРаботу(1); КонецЕсли;
