// Юнит-тесты задачи 6: запросы динамических списков в Form.xml (УП против БП).
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция ФормаXml(Руч, Текст, Осн)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
		+ "	<AutoCommandBar name=""ФормаКоманднаяПанель"" id=""-1""/>" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Список"" id=""1"">" + Символы.ПС
		+ "			<Settings xsi:type=""DynamicList"">" + Символы.ПС
		+ "				<ManualQuery>" + Руч + "</ManualQuery>" + Символы.ПС
		+ "				<DynamicDataRead>true</DynamicDataRead>" + Символы.ПС
		+ ?(Текст = "", "", "				<QueryText>" + Текст + "</QueryText>" + Символы.ПС)
		+ "				<MainTable>" + Осн + "</MainTable>" + Символы.ПС
		+ "				<ListSettings><dcsset:filter/></ListSettings>" + Символы.ПС
		+ "			</Settings>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "	</Attributes>" + Символы.ПС
		+ "</Form>" + Символы.ПС;
КонецФункции

Процедура Записать(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Ошибок = 0;
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ДС = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЗапросыДинСписков.os"));
Синтаксис = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "СинтаксисBsl.os"));

// хеш: SHA256 нормализованного текста (без пробелов/табуляций/переводов строк), hex в нижнем регистре
Проверить(ДС.Хеш("ВЫБРАТЬ 1") = "b53df32f0fbc1be1552a378705830ccccedce81b2784edf1e8b0bf8728f27519", "SHA256 нормализованного текста");
Проверить(ДС.Хеш("ВЫБРАТЬ" + Символы.ПС + Символы.Таб + "1") = ДС.Хеш("ВЫБРАТЬ 1"), "хеш не зависит от пробелов/переводов строк");

Тмп = ПолучитьИмяВременногоФайла("dl");
УП = ОбъединитьПути(Тмп, "UP"); БП = ОбъединитьПути(Тмп, "BP");
ТекстБп = "ВЫБРАТЬ Т.Ссылка ИЗ Справочник.Х КАК Т";
ТекстУп = "ВЫБРАТЬ Т.Ссылка, Т.УП_Реквизит ИЗ Справочник.Х КАК Т ГДЕ Т.Код &lt;&gt; """"";
Отн = СтрЗаменить("Catalogs/Х/Forms/ФормаСписка/Ext/Form.xml", "/", ПолучитьРазделительПути());
Записать(ОбъединитьПути(УП, Отн), ФормаXml("true", ТекстУп, "Catalog.Х"));
Записать(ОбъединитьПути(БП, Отн), ФормаXml("true", ТекстБп, "Catalog.Х"));
// одинаковая форма — не попадает
Отн2 = СтрЗаменить("Catalogs/Х/Forms/ФормаВыбора/Ext/Form.xml", "/", ПолучитьРазделительПути());
Записать(ОбъединитьПути(УП, Отн2), ФормаXml("false", "", "Catalog.Х"));
Записать(ОбъединитьПути(БП, Отн2), ФормаXml("false", "", "Catalog.Х"));

П = ДС.Сравнить(УП, БП);
Проверить(П.Количество() = 1, "один отличающийся список: " + П.Количество());
Если П.Количество() = 1 Тогда
	Э = П[0];
	Проверить(Э.list = "Список" И Э.bpHash = ДС.Хеш(ТекстБп), "хеш БП");
	Проверить(СтрНайти(Э.upText, "Т.Код <> """"") > 0, "текст УП раскодирован из XML: " + Э.upText);
	Проверить(Э.module = "Catalogs\Х\Forms\ФормаСписка\Ext\Form\Module.bsl", "путь модуля формы: " + Э.module);

	// restored: Form.xml УП, но запрос — БП
	РУ = ДС.ПрочитатьСырой(ОбъединитьПути(УП, Отн)); РБ = ДС.ПрочитатьСырой(ОбъединитьПути(БП, Отн));
	Итог = ДС.FormXmlСЗапросамиБп(РУ.Текст, РБ.Текст);
	Проверить(Итог = РБ.Текст, "Form.xml restored: запрос как в БП");
	Проверить(РУ.BOM, "BOM исходного Form.xml определён");

	// заимствованная форма: событие Before только в части расширения
	Заим = "<Form>" + Символы.ПС + "	<AutoCommandBar name=""П"" id=""-1"">" + Символы.ПС + "	</AutoCommandBar>" + Символы.ПС + "	<Attributes/>" + Символы.ПС
		+ "	<BaseForm>" + Символы.ПС + "		<AutoCommandBar name=""П"" id=""-1"">" + Символы.ПС + "		</AutoCommandBar>" + Символы.ПС + "	</BaseForm>" + Символы.ПС + "</Form>";
	СС = ДС.ДобавитьСобытиеВFormXml(Заим);
	Проверить(СтрНайти(СС, "<Event name=""OnCreateAtServer"" callType=""Before"">" + ДС.ИмяОбработчика() + "</Event>") > 0, "событие Before");
	Проверить(СтрНайти(СС, "<Events>") < СтрНайти(СС, "<BaseForm>"), "Events вне BaseForm");
	Проверить(ДС.ДобавитьСобытиеВFormXml(СС) = СС, "повторно не добавляется");

	// код обработчика: синтаксис, хеш БП зашит, ЖР-предупреждение, текст УП
	Код = ДС.ТекстОбработчика(П, "ФормаСписка");
	Проверить(СтрНайти(Код, Э.bpHash) > 0, "хеш БП зашит в код");
	Проверить(СтрНайти(Код, "УровеньЖурналаРегистрации.Предупреждение") > 0 И СтрНайти(Код, "УП_Доработки.ИзменилсяТиповойЗапрос") > 0, "предупреждение в ЖР");
	Проверить(СтрНайти(Код, "Т.Код <> """"""""") > 0, "кавычки в литерале удвоены");
	Проверить(СтрНайти(Код, "&ИзменениеИКонтроль") = 0 И СтрНайти(Код, "&После") = 0, "собственный обработчик, без &После");
	Если Синтаксис.ПутьПарсера() <> "" Тогда
		Ош = Синтаксис.ОшибкиТекста(Код);
		Проверить(Ош.Количество() = 0, "синтаксис обработчика: " + СтрСоединить(Ош, "; "));
	КонецЕсли;

	// отчёт и отметка «хеш БП изменился» при следующем обновлении
	Вых = ОбъединитьПути(Тмп, "out"); СоздатьКаталог(Вых);
	Л = Новый Массив;
	ДС.ЗаписатьОтчёт(П, Вых, Л);
	Записать(ОбъединитьПути(БП, Отн), ФормаXml("true", ТекстБп + " ГДЕ ИСТИНА", "Catalog.Х"));
	П2 = ДС.Сравнить(УП, БП);
	ДС.ЗаписатьОтчёт(П2, Вых, Л);
	Ч = Новый ЧтениеJSON; Ч.ОткрытьФайл(ОбъединитьПути(Вых, "dynlist_queries.json"), "UTF-8");
	Д = ПрочитатьJSON(Ч, Ложь); Ч.Закрыть();
	Проверить(Д.count = 1 И Д.bpHashChanged = 1 И Д.items[0].bpHashChanged = Истина, "отметка смены хеша БП");
	Проверить(Д.items[0].previousBpHash = Э.bpHash, "прежний хеш БП");
КонецЕсли;
// поле УП в элементах формы, которого нет в запросе БП → ручной разбор (в основной остаётся запрос УП)
Отн3 = СтрЗаменить("Catalogs/Х/Forms/ФормаПоля/Ext/Form.xml", "/", ПолучитьРазделительПути());
Записать(ОбъединитьПути(УП, Отн3), СтрЗаменить(ФормаXml("true", "ВЫБРАТЬ Т.Ссылка, Т.УП_Реквизит КАК УП_Реквизит ИЗ Справочник.Х КАК Т", "Catalog.Х"),
	"<Attributes>", "<ChildItems><InputField><DataPath>Список.УП_Реквизит</DataPath></InputField><InputField><DataPath>Список.Ref</DataPath></InputField></ChildItems>" + Символы.ПС + "	<Attributes>"));
Записать(ОбъединитьПути(БП, Отн3), ФормаXml("true", ТекстБп, "Catalog.Х"));
П3 = ДС.Сравнить(УП, БП);
Найден = Ложь;
Для Каждого Э3 Из П3 Цикл
	Если СтрНайти(Э3.form, "ФормаПоля") > 0 Тогда
		Найден = Истина;
		Проверить(Э3.decision = "manual_up_fields_in_form" И Э3.missingFields.Количество() = 1 И Э3.missingFields[0] = "УП_Реквизит",
			"поле УП без поддержки в БП → ручной разбор (Ref = Ссылка есть в БП): " + СтрСоединить(Э3.missingFields, ","));
	КонецЕсли;
КонецЦикла;
Проверить(Найден, "форма с полем УП найдена");

УдалитьФайлы(Тмп);

Если Ошибок = 0 Тогда
	Сообщить("OK test_dynlist");
Иначе
	Сообщить("FAILED test_dynlist: " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
