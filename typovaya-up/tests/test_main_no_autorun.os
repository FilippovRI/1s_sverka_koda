// Подключение Главный.os из другого сценария не запускает Выполнить_.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Ошибок = 0;
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "Главный.os"));
П(Истина, "Главный.os загружен без исключения при oscript test_main_no_autorun.os");

Если Ошибок = 0 Тогда
	Сообщить("OK: test_main_no_autorun");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;