// Обёртка #Если…#КонецЕсли непосредственно вокруг метода: разбор, restored, хук, &Вместо.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Процедура УдалитьКаталогТихо(Путь)
	Попытка
		УдалитьФайлы(Путь);
	Исключение
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьМодуль(Путь, Текст)
	Ф = Новый Файл(Путь);
	Если Не (Новый Файл(Ф.Путь)).Существует() Тогда
		СоздатьКаталог(Ф.Путь);
	КонецЕсли;
	Д = ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8NoBOM);
	Д.Записать(Путь);
КонецПроцедуры

Функция ПрочитатьМодуль(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Доз.Инициализировать(Разбор);
Ошибок = 0;
ПС = Символы.ПС;

// 1. Случай модуля приложения: #Если сразу вокруг метода.
Мод = Т("#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда|Процедура ОбработкаФормированияКомандВходящегоЗапросаПоделиться(ДанныеЗапросаПоделиться, Команды)|	Команда = Новый ОписаниеКомандыВходящегоЗапросаПоделиться(ОбработчикКоманды, ""Загрузить выписку"");|КонецПроцедуры|#КонецЕсли|");
Раз = Разбор.РазобратьМодуль(Мод);
П(Раз.Методы.Количество() = 1, "один метод");
М = Раз.Методы[0];
П(М.Имя = "ОбработкаФормированияКомандВходящегоЗапросаПоделиться", "имя метода");
П(СтрНайти(М.ОбёрткаНачало, "МобильноеПриложениеКлиент Или МобильныйКлиент") > 0, "префикс #Если: " + М.ОбёрткаНачало);
П(СокрЛП(М.ОбёрткаКонец) = "#КонецЕсли", "суффикс #КонецЕсли: " + М.ОбёрткаКонец);
П(СтрНайти(М.Текст, "#Если") = 0 И СтрНайти(М.Текст, "#КонецЕсли") = 0, "текст метода без обёртки");
П(СтрНайти(Раз.ВнеМетодов, "МобильноеПриложениеКлиент") = 0, "обёртка не во вне методов");
Собр = Разбор.ОбернутьТекстПрепроцессором(М.Текст, М.ОбёрткаНачало, М.ОбёрткаКонец);
П(Собр = СокрП(Мод), "байт в байт с обёрткой: [" + Собр + "]");

// 2. Пустые строки и аннотация между #Если и методом — всё ещё «непосредственно вокруг».
Мод2 = Т("#Если Сервер Тогда||&НаСервере|Процедура А()|КонецПроцедуры||#КонецЕсли");
Раз2 = Разбор.РазобратьМодуль(Мод2);
П(Раз2.Методы.Количество() = 1 И СтрНайти(Раз2.Методы[0].ОбёрткаНачало, "#Если Сервер Тогда") > 0, "аннотация внутри обёртки");
П(СокрЛП(Раз2.Методы[0].ОбёрткаКонец) = "#КонецЕсли", "суффикс с пустыми строками");

// 3. Общий #Если на два метода — не переносится на каждый отдельно.
Мод3 = Т("#Если Сервер Тогда|Процедура А()|КонецПроцедуры||Процедура Б()|КонецПроцедуры|#КонецЕсли");
Раз3 = Разбор.РазобратьМодуль(Мод3);
П(Раз3.Методы.Количество() = 2, "два метода в общем #Если");
П(Раз3.Методы[0].ОбёрткаНачало = "" И Раз3.Методы[1].ОбёрткаНачало = "", "нет индивидуальной обёртки");
П(СтрНайти(Раз3.ВнеМетодов, "#Если Сервер Тогда") > 0 И СтрНайти(Раз3.ВнеМетодов, "#КонецЕсли") > 0, "общий #Если остаётся во вне");

// 4. #Если/#Иначе вокруг разных методов.
Мод4 = Т("#Если Сервер Тогда|Процедура А()|	С = 1;|КонецПроцедуры|#Иначе|Процедура Б()|	К = 1;|КонецПроцедуры|#КонецЕсли");
Раз4 = Разбор.РазобратьМодуль(Мод4);
П(Раз4.Методы.Количество() = 2, "если/иначе: два метода");
П(СокрЛП(Раз4.Методы[0].ОбёрткаНачало) = "#Если Сервер Тогда" И СокрЛП(Раз4.Методы[0].ОбёрткаКонец) = "#КонецЕсли", "ветка #Если: " + Раз4.Методы[0].ОбёрткаНачало);
П(СтрНайти(Раз4.Методы[1].ОбёрткаНачало, "#Если Сервер Тогда") > 0 И СтрНайти(Раз4.Методы[1].ОбёрткаНачало, "#Иначе") > 0, "ветка #Иначе содержит цепочку: " + Раз4.Методы[1].ОбёрткаНачало);
П(СокрЛП(Раз4.Методы[1].ОбёрткаКонец) = "#КонецЕсли", "ветка #Иначе закрыта #КонецЕсли");

// 5. restored: метод «нет в УП» возвращается вместе с обёрткой.
М5 = Новый Структура("path, methods, sourceText",
	"Ext\\ManagedApplicationModule.bsl", Новый Массив,
	Т("Процедура Рабочая()|КонецПроцедуры|"));
МтРаб = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"Рабочая", "Процедура", "same", "", "", "none", "skip", "", "");
МтНет = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain, preprocPrefix, preprocSuffix",
	"ОбработкаФормированияКомандВходящегоЗапросаПоделиться", "Процедура", "removed",
	Т("Процедура ОбработкаФормированияКомандВходящегоЗапросаПоделиться(ДанныеЗапросаПоделиться, Команды)|	Команда = Новый ОписаниеКомандыВходящегоЗапросаПоделиться(ОбработчикКоманды, ""Загрузить выписку"");|КонецПроцедуры"),
	"", "none", "manual", "", "",
	"#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда", "#КонецЕсли");
М5.methods.Добавить(МтРаб);
М5.methods.Добавить(МтНет);
В5 = Ч.ВосстановитьТекст(М5);
П(СтрНайти(В5, "#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда") > 0, "restored: есть #Если");
П(СтрНайти(В5, "КонецПроцедуры" + ПС + "#КонецЕсли") > 0 Или СтрНайти(В5, "КонецПроцедуры" + ПС + ПС + "#КонецЕсли") > 0, "restored: #КонецЕсли сразу после метода: " + В5);
П1 = СтрНайти(В5, "#Если МобильноеПриложениеКлиент");
П2 = СтрНайти(В5, "Процедура ОбработкаФормированияКомандВходящегоЗапросаПоделиться");
П3 = СтрНайти(В5, "#КонецЕсли");
П(П1 > 0 И П1 < П2 И П2 < П3, "restored: порядок обёртки");

// 6. Хук &ИзменениеИКонтроль в расширении окружён той же #Если.
МтХ = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, insteadAppendContinue, preprocPrefix, preprocSuffix",
	"ОбработкаФормированияКомандВходящегоЗапросаПоделиться", "Процедура", "changed",
	Т("Процедура ОбработкаФормированияКомандВходящегоЗапросаПоделиться(ДанныеЗапросаПоделиться, Команды)|	Команда = 1;|КонецПроцедуры"),
	"", "changeAndControl", "auto", "#Вставка|	Команда = 2;|#КонецВставки|#Удаление|	Команда = 1;|#КонецУдаления", Ложь,
	"#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда", "#КонецЕсли");
Рх = Ч.ОтрисоватьМетод("УП_", МтХ);
П(СтрНачинаетсяС(Рх, "#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда" + ПС + "&ИзменениеИКонтроль"), "хук начинается с #Если: " + Рх);
П(СтрЗаканчиваетсяНа(СокрП(Рх), "КонецПроцедуры" + ПС + "#КонецЕсли"), "хук заканчивается #КонецЕсли: " + Рх);

// 7. Новый метод УП с обёрткой.
МтД = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, preprocPrefix, preprocSuffix",
	"Нов", "Процедура", "added", "", Т("&НаКлиенте|Процедура Нов()|	Н = 1;|КонецПроцедуры"), "newMethod", "auto", "",
	"#Если Клиент Тогда", "#КонецЕсли");
Рд = Ч.ОтрисоватьМетод("УП_", МтД);
П(СтрНачинаетсяС(Рд, "#Если Клиент Тогда") И СтрЗаканчиваетсяНа(СокрП(Рд), "#КонецЕсли"), "новый метод с обёрткой: " + Рд);

// 8. Обёртка &Вместо с ПродолжитьВызов тоже окружается #Если из restored.
К = ПолучитьИмяВременногоФайла();
УдалитьКаталогТихо(К);
СоздатьКаталог(К);
ПутьВосст = ОбъединитьПути(К, "restored", "Ext", "ManagedApplicationModule.bsl");
ПутьРасш = ОбъединитьПути(К, "extension", "Ext", "ManagedApplicationModule.bsl");
ЗаписатьМодуль(ПутьВосст, Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры||#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда|Процедура Тайная()|КонецПроцедуры|#КонецЕсли|"));
ЗаписатьМодуль(ПутьРасш, Т("&ИзменениеИКонтроль(""Рабочая"")|Процедура УП_Рабочая()|#Удаление|	Типовой = 1;|#КонецУдаления|#Вставка|	Тайная();|#КонецВставки|КонецПроцедуры|"));
РезОб = Доз.ОбработатьОбёрткиВместо(К, "УП_");
П(РезОб.count = 1, "добавлена одна обёртка &Вместо, получили " + РезОб.count);
Н = ПрочитатьМодуль(ПутьРасш);
П(СтрНайти(Н, "#Если МобильноеПриложениеКлиент Или МобильныйКлиент Тогда") > 0, "&Вместо обёрнут #Если: " + Н);
П1 = СтрНайти(Н, "#Если МобильноеПриложениеКлиент");
П2 = СтрНайти(Н, "&Вместо(""Тайная"")");
П3 = СтрНайти(Н, "Процедура УП_Тайная()");
П4 = СтрНайти(Н, "ПродолжитьВызов()");
П5 = СтрНайти(Н, "#КонецЕсли", НаправлениеПоиска.СКонца);
П(П1 > 0 И П1 < П2 И П2 < П3 И П3 < П4 И П4 < П5, "&Вместо порядок обёртки: " + Н);
УдалитьКаталогТихо(К);

Если Ошибок = 0 Тогда
	Сообщить("OK: preproc wrap");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
