Перем Ошибок;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ошибок = 0;

А = Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "УП_Доработки");
П(А <> "", "skeleton read");
П(СтрНайти(А, "e1000001-") = 0, "replaced synthetic");
Б = Ч.АктуализироватьUuidInternalInfo(Ч.СкелетInternalInfoКонфигурации(), "Другая");
П(А <> Б, "extension name affects uuids");

Если Ошибок = 0 Тогда Сообщить("OK: internalinfo uuid"); Иначе ЗавершитьРаботу(1); КонецЕсли;
