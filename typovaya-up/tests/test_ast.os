// Модуль РазборAST (bsparser): позиции, отпечатки, отбор изменённых, контроль хуков.
Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Ошибок = 0;
ПС = Символы.ПС;
А = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "РазборAST.os"));
П(А.Доступен(), "bsparser доступен");

// многострочная сигнатура, директива, аннотация, позиции
Т = "#Область Р" + ПС
	+ "&НаСервере" + ПС
	+ "&ИзменениеИКонтроль(""Типовая"")" + ПС
	+ "Процедура УП_Типовая(А," + ПС
	+ "	Знач Б = 0) Экспорт" + ПС
	+ "	С = ""КонецПроцедуры // Процедура Х()""; // КонецПроцедуры" + ПС
	+ "КонецПроцедуры" + ПС
	+ "#КонецОбласти" + ПС
	+ "&Перед(""Б"")" + ПС + "Процедура УП_Б() КонецПроцедуры" + ПС
	+ "&После(""В"")" + ПС + "Процедура УП_В() КонецПроцедуры" + ПС
	+ "&Вместо(""Г"")" + ПС + "Функция УП_Г() Возврат 1; КонецФункции" + ПС;
Р = А.РазобратьМодульAST(Т);
П(Р.ok, "разбор без ошибок " + СтрСоединить(Р.errors, "; "));
П(Р.methods.Количество() = 4, "4 метода (ключевые слова в строке/комментарии не мешают)");
М = Р.methods[0];
П(М.name = "УП_Типовая" И М.kind = "Процедура" И М.export, "имя/вид/экспорт");
П(М.directives.Количество() = 1 И М.directives[0] = "НаСервере", "директива");
П(М.annotations.Количество() = 1 И М.annotations[0].name = "ИзменениеИКонтроль" И М.annotations[0].target = "Типовая", "аннотация ИиК");
П(М.declStart.line = 2 И М.declStart.column = 1, "declStart");
П(М.sigStart.line = 4 И М.sigStart.column = 1 И М.sigStart.pos = СтрНайти(Т, "Процедура УП_Типовая"), "sigStart");
П(М.sigEnd.line = 5 И Сред(Т, М.sigEnd.pos - 6, 7) = "Экспорт", "sigEnd");
П(М.signatureText = "Процедура УП_Типовая(А," + ПС + "	Знач Б = 0) Экспорт", "signatureText байт в байт");
П(Сред(Т, М.bodyStart, М.bodyEnd - М.bodyStart + 1) = М.bodyText И СтрНачинаетсяС(М.bodyText, ПС + "	С = "), "bodyText по позициям");
П(М.end.line = 7 И Сред(Т, М.end.pos - 13, 14) = "КонецПроцедуры", "end");
П(Р.methods[1].annotations[0].name = "Перед" И Р.methods[2].annotations[0].name = "После"
	И Р.methods[3].annotations[0].name = "Вместо" И Р.methods[3].kind = "Функция", "Перед/После/Вместо");

// отпечаток: пробелы, переносы, регистр и // АПК: не важны; строки важны
Т1 = "Процедура Х()" + ПС + "	А = 1; // АПК:565-выкл" + ПС + "КонецПроцедуры";
Т2 = "Процедура Х()" + ПС + "	// АПК:565-вкл" + ПС + "а   =" + ПС + "  1;" + ПС + ПС + "КонецПроцедуры";
Т3 = "Процедура Х()" + ПС + "	А = ""1"";" + ПС + "КонецПроцедуры";
F1 = А.РазобратьМодульAST(Т1).methods[0].fingerprint;
П(F1 = А.РазобратьМодульAST(Т2).methods[0].fingerprint, "косметика и АПК не меняют отпечаток");
П(F1 <> А.РазобратьМодульAST(Т3).methods[0].fingerprint, "изменение кода меняет отпечаток");

// отбор изменённых
УП = "Процедура Одинаковый()" + ПС + "	// АПК:1" + ПС + "	А=1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Изменен()" + ПС + "	А = 2;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Сиг(А) Экспорт" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура ТолькоУП()" + ПС + "КонецПроцедуры";
БП = "Процедура Одинаковый()" + ПС + "	А = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Изменен()" + ПС + "	А = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура Сиг(А)" + ПС + "КонецПроцедуры";
Изм = А.ИзмененныеМетоды(УП, БП);
П(Изм.ok И Изм.same = 1 И Изм.changed.Количество() = 3, "изменённых 3, одинаковых 1");
Причины = Новый Соответствие;
Для Каждого Ч Из Изм.changed Цикл Причины.Вставить(Ч.name, Ч.reason); КонецЦикла;
П(Причины["Изменен"] = "body" И Причины["Сиг"] = "signature" И Причины["ТолькоУП"] = "onlySource", "причины");
П(Не А.ИзмененныеМетоды("Процедура Х(" + ПС, БП).ok, "ошибка разбора -> ok=Ложь");

// контроль хука
Хук = "&ИзменениеИКонтроль(""Х"")" + ПС + "Процедура УП_Х(А)" + ПС
	+ "	Б = А" + ПС
	+ "#Удаление" + ПС + "	+ 1" + ПС + "#КонецУдаления" + ПС
	+ "#Вставка" + ПС + "	// УП_начало" + ПС + "	+ 2" + ПС + "	// УП_конец" + ПС + "#КонецВставки" + ПС
	+ "	;" + ПС + "КонецПроцедуры" + ПС;
Х = А.ПроверитьХук(Хук);
П(Х.ok, "корректный хук разбирается " + СтрСоединить(Х.problems, "; "));
Х = А.ПроверитьХук(СтрЗаменить(Хук, "#КонецВставки", ""));
П(Не Х.ok, "непарная #Вставка");
Х = А.ПроверитьХук(СтрЗаменить(Хук, ПС + "#Удаление", ПС + "	#Удаление"));
П(Не Х.ok, "директива не с колонки 0");
Плохой = "&ИзменениеИКонтроль(""Х"")" + ПС + "#Удаление" + ПС + "Процедура УП_Х(А)" + ПС + "#КонецУдаления" + ПС
	+ "#Вставка" + ПС + "Процедура УП_Х(А, Б)" + ПС + "#КонецВставки" + ПС + "КонецПроцедуры" + ПС;
Х = А.ПроверитьХук(Плохой);
П(Не Х.ok И СтрНайти(СтрСоединить(Х.problems, ";"), "внутри #Удаление") > 0, "сигнатура внутри #Удаление");
Х = А.ПроверитьХук(Хук + Хук);
П(Не Х.ok И СтрНайти(СтрСоединить(Х.problems, ";"), "более одного раза") > 0, "сигнатура дважды");

Если Ошибок = 0 Тогда Сообщить("OK: ast"); Иначе ЗавершитьРаботу(1); КонецЕсли;