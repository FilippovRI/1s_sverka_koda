// Фильтр несуществующих модулей в typovaya ПриДобавленииПодсистем: вставка, идемпотентность.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Ф = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ФильтрМодулейПодсистем.os"));
Ошибок = 0;

Исх = Т("// шапка||Процедура ПриДобавленииПодсистем(МодулиПодсистем) Экспорт||	МодулиПодсистем.Добавить(""ОбновлениеИнформационнойБазыБП"");|"
	+ "	МодулиПодсистем.Добавить(""ОбновлениеИнформационнойБазыЗарплатаКадрыРасширенный"");||КонецПроцедуры||"
	+ "Процедура Другая() Экспорт|КонецПроцедуры|");

Р1 = Ф.ВставитьФильтрВТекст(Исх);
П(Р1.Статус = "applied", "первая вставка: " + Р1.Статус);
П(СтрНайти(Р1.Текст, Ф.МаркерФильтра()) > 0, "маркер после вставки");
П(СтрНайти(Р1.Текст, "ОбновлениеИнформационнойБазыЗарплатаКадрыРасширенный") > 0, "typovaya Добавить на месте");
П(СтрНайти(Р1.Текст, "Процедура Другая()") > 0, "следующая процедура на месте");
// фильтр стоит до КонецПроцедуры первой процедуры
ПозКонца = СтрНайти(Р1.Текст, "КонецПроцедуры");
ПозМаркера = СтрНайти(Р1.Текст, Ф.МаркерФильтра());
П(ПозМаркера > 0 И ПозМаркера < ПозКонца, "фильтр внутри первой процедуры");

Р2 = Ф.ВставитьФильтрВТекст(Р1.Текст);
П(Р2.Статус = "already", "повтор: " + Р2.Статус);
П(СтрЧислоВхождений(Р2.Текст, Ф.МаркерФильтра()) = 1, "без дубля маркера");

Р0 = Ф.ВставитьФильтрВТекст(Т("Процедура Другая()|КонецПроцедуры|"));
П(Р0.Статус = "no_proc", "нет целевой процедуры: " + Р0.Статус);

// Применить к каталогу-заглушке
Кат = ОбъединитьПути(КаталогВременныхФайлов(), "tu_filter_subsys_test");
КатМ = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Кат, "CommonModules"), "ПодсистемыКонфигурацииПереопределяемый"), "Ext");
ПутьМ = ОбъединитьПути(КатМ, "Module.bsl");
СоздатьКаталог(КатМ);
З = Новый ЗаписьТекста(ПутьМ, КодировкаТекста.UTF8);
З.Записать(Исх);
З.Закрыть();
Лог = Новый Массив;
А1 = Ф.Применить(Кат, Лог);
П(А1.changed = Истина И А1.status = "applied", "Применить: " + А1.status);
А2 = Ф.Применить(Кат, Лог);
П(А2.changed = Ложь И А2.status = "already", "Применить повтор: " + А2.status);
А3 = Ф.Применить(ОбъединитьПути(Кат, "нет_такого"), Лог);
П(А3.changed = Ложь И А3.status = "missing", "нет файла: " + А3.status);

Попытка
	УдалитьФайлы(Кат);
Исключение
КонецПопытки;

Если Ошибок = 0 Тогда
	Сообщить("OK");
	ЗавершитьРаботу(0);
Иначе
	Сообщить("FAILED: " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
