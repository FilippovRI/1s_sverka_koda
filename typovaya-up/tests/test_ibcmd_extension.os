Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Функция ТекстФ(Имя)
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(ОбъединитьПути(Корень, "tests", "fixtures", Имя));
	Возврат Т.ПолучитьТекст();
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
М = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "IbcmdРасширения.os"));
Ошибок = 0;
Цель = "УП_Доработки";
Пи = Новый Структура("ibcmdPath, dbPath, dbms, dbServer, dbName, dataPath, user, password",
	"ibcmd", "C:\base", "", "", "", "", "", "");

С = М.РазобратьСписокРасширений(ТекстФ("ibcmd_list_empty.txt"));
П(С.Количество() = 0, "parse empty list");

С2 = М.РазобратьСписокРасширений(ТекстФ("ibcmd_list_exact.txt"));
П(С2.Количество() = 2, "parse names");
П(С2[0] = "УП_Доработки", "first name");

Р1 = М.РешитьСтратегиюЗагрузки(Цель, С2);
П(Р1.mode = "update", "exact -> update");

Р2 = М.РешитьСтратегиюЗагрузки(Цель, С);
П(Р2.mode = "create", "empty -> create");

Р3 = М.РешитьСтратегиюЗагрузки(Цель, М.РазобратьСписокРасширений(ТекстФ("ibcmd_list_similar.txt")));
П(Р3.mode = "abort", "similar -> abort");
П(Р3.similar.Количество() = 2, "similar count");

Сп = М.СпланироватьЗагрузку(Пи, Цель, "C:\out\extension", ТекстФ("ibcmd_list_exact.txt"));
П(Сп.ok, "plan ok");
П(Сп.plan.steps.Количество() = 4, "update plan without create step");
Д = 0;
Для Каждого Ш Из Сп.plan.steps Цикл
	Если Ш.step = "extension create" Тогда Д = Д + 1; КонецЕсли;
КонецЦикла;
П(Д = 0, "no create on update");

Сп2 = М.СпланироватьЗагрузку(Пи, Цель, "C:\out\extension", ТекстФ("ibcmd_list_empty.txt"));
П(Сп2.ok И Сп2.plan.mode = "create", "create plan");
П(Сп2.plan.steps.Количество() = 5, "create plan steps");

К = Сп2.plan.steps[1].argv;
П(К[К.ВГраница()] = "--purpose=customization", "create purpose");

КатБ = ОбъединитьПути(Корень, "tests", "_ibcmd_busy_mock");
УдалитьФайлы(КатБ); СоздатьКаталог(КатБ);
З = Новый ЗаписьТекста(ОбъединитьПути(КатБ, "1Cv8.1CD.cfl"), "UTF-8"); З.ЗаписатьСтроку("mock"); З.Закрыть();
Бл = М.ПризнакиБлокировкиФайловойБазы(КатБ);
П(Бл.busy И Бл.lockFiles.Количество() > 0, "cfl lock -> busy");
КатЧ = ОбъединитьПути(Корень, "tests", "_ibcmd_free_mock");
УдалитьФайлы(КатЧ); СоздатьКаталог(КатЧ);
З2 = Новый ЗаписьТекста(ОбъединитьПути(КатЧ, "1Cv8.1CD"), "UTF-8"); З2.ЗаписатьСтроку("mock"); З2.Закрыть();
П(Не М.ПризнакиБлокировкиФайловойБазы(КатЧ).busy, "no cfl -> free");

Зан1 = М.ВыводIbcmdУказываетБазуЗанята(ТекстФ("ibcmd_busy_file_ru.txt"));
П(Зан1.busy, "parse busy ru");
Зан2 = М.ВыводIbcmdУказываетБазуЗанята(ТекстФ("ibcmd_busy_server_en.txt"));
П(Зан2.busy, "parse busy en");
П(Не М.ВыводIbcmdУказываетБазуЗанята("ok").busy, "plain ok output");

Пм = Новый Структура("ibcmdPath, dbPath, dbms, dbServer, dbName, dataPath, user, password",
	"ibcmd", КатБ, "", "", "", "", "", "");
Пр = М.ПроверитьБазаСвободнаПередЗагрузкой(Пм);
П(Пр.busy, "pre-check blocks file base");
УдалитьФайлы(КатБ);
УдалитьФайлы(КатЧ);

Если Ошибок = 0 Тогда
	Сообщить("OK: ibcmd extension");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
