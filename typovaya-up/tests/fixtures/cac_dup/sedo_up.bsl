	УстановитьПривилегированныйРежим(Истина); // Загружаются все входящие документы.
	
	Кэш = Новый Соответствие;
	
	ТипСообщения = Число(Сообщение.Тип);
	ИдентификаторСообщения = НРег(СокрЛП(Сообщение.Идентификатор));
	ТребуетсяПодтверждение = ОбщегоНазначенияБЗК.ЗначениеСвойства(Сообщение, "ТребуетсяПодтверждение");
	Если ТипЗнч(ТребуетсяПодтверждение) <> Тип("Булево") Тогда
		ВходящееСообщение = ВходящееСообщение(ИдентификаторСообщения);
		ТребуетсяПодтверждение = ВходящееСообщение.ТребуетсяПодтверждение;
	КонецЕсли;
	
	Если ТипСообщения = 10 Тогда
		// Извещение из системы "Прямые выплаты страхового обеспечения".
		Документы.ИзвещениеФСС.ЗагрузитьСообщение10(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат);
	ИначеЕсли ТипСообщения = 1010 Тогда
		// Извещение о запросе недостающих сведений для назначения пособий.
		Документы.ЗапросНедостающихСведенийПособияСФР.ЗагрузитьСообщение1010(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 32 Тогда
		// Извещение о запросе недостающих сведений для назначения пособий.
		Документы.ЗапросРеквизитовДляВыплатыПособия.ЗагрузитьСообщение32(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 34 Тогда
		// Результат обработки ответа на запрос уточненных сведений для выплаты пособий.
		РегистрыСведений.РегистрацииОтветовНаЗапросыРеквизитовДляВыплатыПособий.ЗагрузитьСообщение34(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 85 Или ТипСообщения = 8510 Тогда
		// Ответ на получение статусы выплаты.
		РегистрыСведений.РегистрацииЗапросовСтатусовВыплатыПособий.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 87 Тогда
		// Результат регистрации сведений о застрахованном лице.
		Документы.РегистрацияСведенийОЗастрахованномЛицеФСС.ЗагрузитьСообщение87(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 88 Тогда
		// Информация о несоответствии сведений о застрахованном лице.
		Документы.НесоответствиеСведенийОЗастрахованномЛицеСЭДО.ЗагрузитьСообщение88(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 95 Тогда
		// Результат обработки сведений для оплаты отпуска.
		РегистрыСведений.РегистрацииСведенийДляОплатыОтпускаСФР.ЗагрузитьСообщение95(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат);
	ИначеЕсли ТипСообщения = 97 Тогда
		// Результат рассмотрения сведений для оплаты отпуска застрахованного лица.
		РегистрыСведений.РегистрацииСведенийДляОплатыОтпускаСФР.ЗагрузитьСообщение97(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат);
	ИначеЕсли ТипСообщения = 100 Или ТипСообщения = 10010 Тогда
		// Запрос на проверку, подтверждение, корретировку сведений проактивной выплаты страхового обеспечения.
		Документы.ВходящийЗапросФССДляРасчетаПособия.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 105 Или ТипСообщения = 10510 Тогда
		// Результат ответа на запрос сведений для расчета и выплаты пособия СФР.
		РегистрыСведений.РегистрацииОтветовНаЗапросыФССДляРасчетаПособий.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 106 Или ТипСообщения = 10610 Тогда
		// Результат уведомления о прекращении отпуска по уходу за ребенком до полутора лет.
		РегистрыСведений.РегистрацииУведомленийОПрекращенииОтпускаПоУходуЗаРебенком.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 107 Или ТипСообщения = 10710 Тогда
		// Уведомление об изменении расчета пособия.
		Документы.УведомлениеОбИзмененииРасчетаПособия.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 110 Или ТипСообщения = 11000 Или ТипСообщения = 11010 Тогда
		// Уведомление об изменении статусов выплат.
		Документы.УведомлениеОСтатусеВыплатыПособия.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 111 Тогда
		// Уведомление об изменении ЭЛН.
		РегистрыСведений.СведенияОбЭЛН.ЗагрузитьСообщение111(
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 112 Или ТипСообщения = 11210 Тогда
		// Результат обработки сообщения о информировании Фонда о жизненных событиях.
		РегистрыСведений.РегистрацииИсходящихСообщенийОСтраховыхСлучаяхФСС.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 121 Или ТипСообщения = 12110 Тогда
		// Результат обработки заявления о возмещении выплат родителям детей-инвалидов.
		РегистрыСведений.РегистрацииЗаявленийОВозмещенииВыплатРодителямДетейИнвалидов.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 122 Или ТипСообщения = 12210 Тогда
		// Отказ в возмещении выплат родителям детей инвалидов.
		Документы.ОтказВВозмещенииВыплатРодителямДетейИнвалидов.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 124 Или ТипСообщения = 12410 Тогда
		// С появлением документа не требуется информировать пользователя о 124 сообщении через список ошибок.
		Результат.ОшибкаОбработки = Ложь;
		Результат.ОписаниеОшибки = "";
		// Уведомление об отсутствии ответа на входящий запрос.
		Документы.УведомлениеОбОтсутствииОтветаСЭДО.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 321 Или ТипСообщения = 32110 Тогда
		// Результат обработки запроса страхователя о получении от Фонда сведений о заработной плате застрахованного лица.
		РегистрыСведений.РегистрацииЗапросовСреднегоЗаработкаСЭДО.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			Результат,
			Кэш);
	ИначеЕсли ТипСообщения = 322 Или ТипСообщения = 32210 Тогда
		// Сведения, необходимые для исчисления страхователем первых трех дней пособия по временной нетрудоспособности.
		Документы.ДанныеСФРДляРасчетаПособия.ЗагрузитьСообщение(
			ТипСообщения,
			Страхователь,
			ИдентификаторСообщения,
			Сообщение.ТекстСообщения,
			ТребуетсяПодтверждение,
			Результат,
			Кэш);
	КонецЕсли;
	
	МодульРасширеннойРеализации = МодульРасширеннойРеализации();
	Если МодульРасширеннойРеализации <> Неопределено Тогда
		МодульРасширеннойРеализации.ПослеРасшифровкиСообщенияСЭДО(Страхователь, Сообщение, Результат, Кэш);
	КонецЕсли;
	
	СНИЛСВФорматеФСС = ОбщегоНазначенияБЗК.ЗначениеСвойства(Сообщение, "СНИЛС");
	Если ЗначениеЗаполнено(СНИЛСВФорматеФСС) Тогда
		СНИЛС = УчетПособийСоциальногоСтрахованияКлиентСервер.СНИЛСВФорматеИБ(СНИЛСВФорматеФСС);
		// Результат обработки сообщения о информировании СФР о жизненных событиях.
		РегистрыСведений.СНИЛСВходящихСообщенийСЭДО.ПослеРасшифровкиСообщенияСЭДОСоСНИЛС(
			Страхователь,
			ТипСообщения,
			ИдентификаторСообщения,
			СНИЛС,
			Кэш);
	КонецЕсли;
	
	// Добавление шапки и подвала в текст ошибки для более полного анализа.
	Если Результат.ОшибкаОбработки И ЗначениеЗаполнено(Результат.ОписаниеОшибки) Тогда
		Отступ = Символы.ПС + "    ";
		ТелоОшибкиСОтступом = СтрЗаменить(Результат.ОписаниеОшибки, Символы.ПС, Отступ);
		ТекстXMLСОтступом = СтрЗаменить(СтрЗаменить(Сообщение.ТекстСообщения, "<", Отступ + "<"), Отступ + "</", "</");
		Результат.ОписаниеОшибки = СтрШаблон(
			НСтр("ru = 'Ошибка обработки сообщения %1 с идентификатором %2:
			|    %3
			|XML-текст сообщения:%4
			|
			|'"),
			ТипСообщения,
			ИдентификаторСообщения,
			СокрП(ТелоОшибкиСОтступом),
			ТекстXMLСОтступом);
	КонецЕсли;