// TodoMissingMetadata: планы видов расчёта (и прочие типы) попадают в todo_missing_metadata.
Перем Ошибок;
Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Функция Объект(Тег, Имя, Реквизиты)
	Т = "<MetaDataObject><" + Тег + "><Properties><Name>" + Имя + "</Name></Properties><ChildObjects>";
	Для Каждого Р Из СтрРазделить(Реквизиты, ",", Ложь) Цикл
		Т = Т + "<Attribute uuid=""1""><Properties><Name>" + Р + "</Name></Properties></Attribute>";
	КонецЦикла;
	Возврат Т + "</ChildObjects></" + Тег + "></MetaDataObject>";
КонецФункции

Ошибок = 0;
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_tmm_" + Строка(Новый УникальныйИдентификатор));
Уп = ОбъединитьПути(Вр, "up");
Бп = ОбъединитьПути(Вр, "bp");
Осн = ОбъединитьПути(Вр, "out", "restored");
Вых = ОбъединитьПути(Вр, "out");
Зап(ОбъединитьПути(Уп, "ChartsOfCalculationTypes", "Начисления.xml"), Объект("ChartOfCalculationType", "Начисления", "Общий"));
Зап(ОбъединитьПути(Бп, "ChartsOfCalculationTypes", "Начисления.xml"), Объект("ChartOfCalculationType", "Начисления", "Общий,ТолькоБп"));
Зап(ОбъединитьПути(Уп, "CalculationRegisters", "Рр.xml"), Объект("CalculationRegister", "Рр", ""));
Зап(ОбъединитьПути(Бп, "CalculationRegisters", "Рр.xml"), Объект("CalculationRegister", "Рр", "РеквБп"));
Зап(ОбъединитьПути(Осн, "ChartsOfCalculationTypes", "Начисления/Ext/ObjectModule.bsl"), "Процедура А()" + Символы.ВК + Символы.ПС + "	Х = ТолькоБп;" + Символы.ВК + Символы.ПС + "КонецПроцедуры" + Символы.ВК + Символы.ПС);
М = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "TodoMissingMetadata.os"));
Р = М.Сформировать(Осн, Уп, Бп, Вых, ОбъединитьПути(Вр, "нет.txt"));
Csv = Чит(Р.csv);
П(СтрНайти(Csv, "ПланВидовРасчета.Начисления") > 0 И СтрНайти(Csv, "ТолькоБп") > 0, "план видов расчёта в todo: " + Csv);
П(СтрЧислоВхождений(Csv, "ТолькоБп") >= 2, "строка модуля плана видов расчёта");
П(СтрНайти(Csv, "РегистрРасчета.Рр") > 0 И СтрНайти(Csv, "РеквБп") > 0, "регистр расчёта в todo");
П(СтрНайти(Csv, ";Общий;") = 0, "общий реквизит не в todo");
УдалитьФайлы(Вр);
Если Ошибок = 0 Тогда Сообщить("OK: test_todo_missing_calc_types"); Иначе ВызватьИсключение "test_todo_missing_calc_types: " + Ошибок; КонецЕсли;
