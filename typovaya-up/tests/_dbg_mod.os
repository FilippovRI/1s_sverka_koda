Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
П = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "АнализФорм.os"));
Путь = ОбъединитьПути(Корень, "tests", "fixtures", "UP", "Documents", "Счет", "Forms", "ФормаДокумента", "Ext", "Form.xml");
М = ОбъединитьПути((Новый Файл(Путь)).Путь, "Form", "Module.bsl");
Сообщить(М);
Сообщить((Новый Файл(М)).Существует());
Тд = Новый ТекстовыйДокумент; Тд.Прочитать(М); Т = Тд.ПолучитьТекст();
Сообщить("len=" + СтрДлина(Т) + " find=" + (СтрНайти(Т, "УПФлаг") > 0));
OUT = "/tmp/fdbg"; УдалитьФайлы(OUT); СоздатьКаталог(OUT);
П.СравнитьФормы(ОбъединитьПути(Корень, "tests", "fixtures", "UP"), ОбъединитьПути(Корень, "tests", "fixtures", "BP"), Неопределено, OUT, Новый Массив, Новый Структура("program", Ложь));
Тж = Новый ТекстовыйДокумент; Тж.Прочитать(ОбъединитьПути(OUT, "forms_analysis.json"));
Сообщить(Лев(Тж.ПолучитьТекст(), 400));
