// &Перед с безусловным Возврат должен стать &Вместо без ПродолжитьВызов.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Процедура Писать(Путь, Текст)
	Ф = Новый Файл(Путь);
	Если Ф.Путь <> "" Тогда
		СоздатьКаталог(Ф.Путь);
	КонецЕсли;
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

Функция Читать(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

КореньРепо = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "РазборМетодов.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "СинтезХуков.os"));
Синтез.Инициализировать(Разбор);
Перев = ЗагрузитьСценарий(ОбъединитьПути(КореньРепо, "src", "ПереводПередВВместо.os"));
Перев.Инициализировать(Разбор, Синтез);
Ошибок = 0;

// --- синтез: префикс «Возврат;» + типовое тело → &Вместо без ПродолжитьВызов ---
ТипТ = Т("	А = 1;|	Б = 2;");
УпТ = Т("	// УП_начало|	Возврат;|	// УП_конец|	А = 1;|	Б = 2;");
Пр = Синтез.ПредложитьХук(ТипТ, УпТ);
П(Пр.decision = "auto" И Пр.hook = "instead", "синтез prefix Возврат → instead: " + Пр.hook + "/" + Пр.decision);
П(СтрНайти(Пр.hookBody, "Возврат;") > 0, "в теле хука есть Возврат");
П(СтрНайти(Пр.hookBody, "А = 1;") = 0, "типовое тело не входит в хук &Вместо");
П(Пр.insteadAppendContinue = Ложь, "без ПродолжитьВызов");

// единственный оператор в теле УП
Пр2 = Синтез.ПредложитьХук(ТипТ, Т("	// УП_начало|	Возврат;|	// УП_конец"));
П(Пр2.hook = "instead" И Пр2.decision = "auto", "синтез только Возврат → instead: " + Пр2.hook);
П(Пр2.insteadAppendContinue = Ложь, "только Возврат: без ПродолжитьВызов");

// функция: Возврат с значением из УП
Пр3 = Синтез.ПредложитьХук(Т("	Возврат Истина;"), Т("	Возврат Ложь;"));
П(Пр3.hook = "instead", "функция: тело только Возврат Ложь → instead: " + Пр3.hook);
П(СтрНайти(Пр3.hookBody, "Возврат Ложь;") > 0, "сохранено значение Возврат из УП");

// код + безусловный Возврат в префиксе (отключение после подготовки)
Пр4 = Синтез.ПредложитьХук(ТипТ, Т("	УстановитьПараметр();|	Возврат;|	А = 1;|	Б = 2;"));
П(Пр4.hook = "instead", "префикс setup+Возврат → instead: " + Пр4.hook);
П(СтрНайти(Пр4.hookBody, "УстановитьПараметр();") > 0, "setup остаётся в теле &Вместо");

// обычный &Перед без Возврат — не трогаем
Пр5 = Синтез.ПредложитьХук(Т("	Б = 1;"), Т("	А = 0;|	Б = 1;"));
П(Пр5.hook = "before", "обычный префикс остаётся before: " + Пр5.hook);

// условный Возврат в префиксе — остаётся &Перед
Пр6 = Синтез.ПредложитьХук(ТипТ, Т("	Если Не Готово Тогда|		Возврат;|	КонецЕсли;|	А = 1;|	Б = 2;"));
П(Пр6.hook = "before", "условный Возврат остаётся before: " + Пр6.hook);
П(Синтез.КлассВозвратаВТеле(Пр6.hookBody) = "conditional", "класс префикса = conditional");

// голый Возврат в функции нормализуется
Нрм = Синтез.НормализоватьВозвратФункции(Т("	// УП_начало|	Возврат;|	// УП_конец"), Истина);
П(СтрНайти(Нрм, "Возврат Неопределено;") > 0, "функция: Возврат; → Возврат Неопределено;");
Нрм2 = Синтез.НормализоватьВозвратФункции(Т("	Возврат Ложь;"), Истина);
П(СтрНайти(Нрм2, "Возврат Ложь;") > 0 И СтрНайти(Нрм2, "Неопределено") = 0, "функция: значение из УП не затираем");
Нрм3 = Синтез.НормализоватьВозвратФункции(Т("	Возврат;"), Ложь);
П(СтрНайти(Нрм3, "Неопределено") = 0, "процедура: голый Возврат не трогаем");

// --- проход по уже сгенерированному расширению ---
База = ОбъединитьПути(КаталогВременныхФайлов(), "tu_before_return_instead");
Попытка
	УдалитьФайлы(База);
Исключение
КонецПопытки;
КРасш = ОбъединитьПути(База, "extension");
КОтч = ОбъединитьПути(База, "report");
Писать(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КРасш, "InformationRegisters"), "СкрытыеРегламентированныеОтчеты"), "Ext"), "ManagerModule.bsl"), Т(
	"&Перед(""ДобавитьСкрытыеОтчетыВРегистрСведений"")|"
	+ "Процедура УП_ДобавитьСкрытыеОтчетыВРегистрСведений() Экспорт|"
	+ "	// УП_начало|"
	+ "	Возврат;|"
	+ "	// УП_конец|"
	+ "КонецПроцедуры|"
	+ "|"
	+ "&Перед(""ДругойМетод"")|"
	+ "Процедура УП_ДругойМетод() Экспорт|"
	+ "	Если Параметры.Свойство(""АвтоТест"") Тогда|"
	+ "		Возврат;|"
	+ "	КонецЕсли;|"
	+ "КонецПроцедуры|"
	+ "|"
	+ "&Перед(""БезВозврата"")|"
	+ "Процедура УП_БезВозврата() Экспорт|"
	+ "	А = 1;|"
	+ "КонецПроцедуры|"));

Писать(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КРасш, "CommonModules"), "ТестФункций"), "Ext"), "Module.bsl"), Т(
	"&Перед(""ПолучитьФлаг"")|"
	+ "Функция УП_ПолучитьФлаг() Экспорт|"
	+ "	Возврат;|"
	+ "КонецФункции|"));

Лог = Новый Массив;
Р = Перев.Применить(КРасш, КОтч, Лог);
П(Р.ok, "проход ok: " + Р.reason);
П(Р.converted.Количество() = 2, "переведено 2: " + Р.converted.Количество());
П(Р.check.Количество() = 1, "проверить 1: " + Р.check.Количество());

ТекстМен = Читать(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КРасш, "InformationRegisters"), "СкрытыеРегламентированныеОтчеты"), "Ext"), "ManagerModule.bsl"));
П(СтрНайти(ТекстМен, "&Вместо(""ДобавитьСкрытыеОтчетыВРегистрСведений"")") > 0, "ДобавитьСкрытые… стало &Вместо");
П(СтрНайти(ТекстМен, "ПродолжитьВызов") = 0, "нет ПродолжитьВызов");
П(СтрНайти(ТекстМен, "&Перед(""ДругойМетод"")") > 0, "условный Возврат остался &Перед");
П(СтрНайти(ТекстМен, "&Перед(""БезВозврата"")") > 0, "без Возврат остался &Перед");

ТекстФн = Читать(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КРасш, "CommonModules"), "ТестФункций"), "Ext"), "Module.bsl"));
П(СтрНайти(ТекстФн, "&Вместо(""ПолучитьФлаг"")") > 0, "функция стала &Вместо");
П(СтрНайти(ТекстФн, "Возврат Неопределено;") > 0, "функция: Возврат Неопределено");

НашлиСкрыт = Ложь;
Для Каждого Имя Из Р.converted Цикл
	Если СтрНайти(Имя, "ДобавитьСкрытыеОтчетыВРегистрСведений") > 0 Тогда
		НашлиСкрыт = Истина;
	КонецЕсли;
КонецЦикла;
П(НашлиСкрыт, "в списке переведённых есть модуль.метод скрытых отчётов: " + СтрСоединить(Р.converted, ", "));

НашлиУсл = Ложь;
Для Каждого Имя Из Р.check Цикл
	Если СтрНайти(Имя, "ДругойМетод") > 0 Тогда
		НашлиУсл = Истина;
	КонецЕсли;
КонецЦикла;
П(НашлиУсл, "в «проверить» есть условный хук");

Попытка
	УдалитьФайлы(База);
Исключение
КонецПопытки;

Если Ошибок = 0 Тогда
	Сообщить("OK");
	ЗавершитьРаботу(0);
Иначе
	Сообщить("FAILED: " + Ошибок);
	ЗавершитьРаботу(1);
КонецЕсли;
