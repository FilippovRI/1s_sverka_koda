Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = П1;
	Для Каждого С Из ОбщийМассив(П2, П3, П4, П5, П6, П7, П8) Цикл
		Если С <> "" Тогда
			Р = ОбъединитьПути(Р, С);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОбщийМассив(П2, П3, П4, П5, П6, П7, П8)
	М = Новый Массив;
	М.Добавить(П2); М.Добавить(П3); М.Добавить(П4); М.Добавить(П5); М.Добавить(П6); М.Добавить(П7); М.Добавить(П8);
	Возврат М;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Ч = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Ч.Записать(Текст);
	Ч.Закрыть();
КонецПроцедуры

Функция ТекстФайла(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Если Т = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Т, 1) = Символ(65279) Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	Возврат СтрЗаменить(Т, Символы.ВК, "");
КонецФункции

Функция КонфРасш()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21"">" + Символы.ПС
		+ "	<Configuration uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"">" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "		<Catalog>СпрРучн</Catalog>" + Символы.ПС
		+ "		<CommonForm>ОбщРучн</CommonForm>" + Символы.ПС
		+ "		</ChildObjects>" + Символы.ПС
		+ "	</Configuration>" + Символы.ПС
		+ "</MetaDataObject>";
КонецФункции

Функция МетаСпр()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21"">" + Символы.ПС
		+ "	<Catalog uuid=""bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb"">" + Символы.ПС
		+ "		<Properties><Name>СпрРучн</Name><ObjectBelonging>Adopted</ObjectBelonging></Properties>" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "			<Form>ФормаЭлемента</Form>" + Символы.ПС
		+ "			<Form>ФормаСписка</Form>" + Символы.ПС
		+ "		</ChildObjects>" + Символы.ПС
		+ "	</Catalog>" + Символы.ПС
		+ "</MetaDataObject>";
КонецФункции

Функция МетаФормы(Имя)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21"">" + Символы.ПС
		+ "	<Form uuid=""cccccccc-cccc-cccc-cccc-cccccccccccc"">" + Символы.ПС
		+ "		<Properties><Name>" + Имя + "</Name><ObjectBelonging>Adopted</ObjectBelonging></Properties>" + Символы.ПС
		+ "	</Form>" + Символы.ПС
		+ "</MetaDataObject>";
КонецФункции

К = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));
Корень = ОбъединитьПути(КаталогВременныхФайлов(), "tu_manual_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
Уп = П(Корень, "up");
ТипК = П(Корень, "typ");
Бп = П(Корень, "bp");
Восст = П(Корень, "restored");
Расш = П(Корень, "extension");

ОтнКат = "Catalogs\СпрРучн\Forms\ФормаЭлемента\Ext\Form.xml";
ОтнОбщ = "CommonForms\ОбщРучн\Ext\Form.xml";
ОтнСписка = "Catalogs\СпрРучн\Forms\ФормаСписка\Ext\Form.xml";

МодульУпКат = "&НаСервере" + Символы.ПС + "Процедура УП_ТолькоУп()" + Символы.ПС + "	Возврат;" + Символы.ПС + "КонецПроцедуры" + Символы.ПС;
МодульТипКат = "&НаСервере" + Символы.ПС + "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС + "	ТиповойКод = 1;" + Символы.ПС + "КонецПроцедуры" + Символы.ПС;
МодульРасшКат = "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")" + Символы.ПС + "Процедура УП_ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС + "КонецПроцедуры" + Символы.ПС;
XmlУпКат = "<Form>UP-CAT-XML</Form>";
XmlТипКат = "<Form>TYP-CAT-XML</Form>";
МодульУпОбщ = "&НаКлиенте" + Символы.ПС + "Процедура УП_ОбщийКлиент()" + Символы.ПС + "	Возврат;" + Символы.ПС + "КонецПроцедуры" + Символы.ПС;
МодульТипОбщ = "&НаКлиенте" + Символы.ПС + "Процедура ПриОткрытии(Отказ)" + Символы.ПС + "КонецПроцедуры" + Символы.ПС;
XmlУпОбщ = "<Form>UP-CF-XML</Form>";
XmlТипОбщ = "<Form>TYP-CF-XML</Form>";

Записать(П(Уп, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlУпКат);
Записать(П(Уп, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульУпКат);
Записать(П(Уп, "CommonForms", "ОбщРучн", "Ext", "Form.xml"), XmlУпОбщ);
Записать(П(Уп, "CommonForms", "ОбщРучн", "Ext", "Form", "Module.bsl"), МодульУпОбщ);

Записать(П(Восст, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Configuration uuid=""dddddddd-dddd-dddd-dddd-dddddddddddd""><ChildObjects></ChildObjects></Configuration></MetaDataObject>");
Записать(П(Восст, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlТипКат);
Записать(П(Восст, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульТипКат);
Записать(П(Восст, "CommonForms", "ОбщРучн", "Ext", "Form.xml"), XmlТипОбщ);
Записать(П(Восст, "CommonForms", "ОбщРучн", "Ext", "Form", "Module.bsl"), МодульТипОбщ);

Записать(П(Расш, "Configuration.xml"), КонфРасш());
Записать(П(Расш, "Catalogs", "СпрРучн.xml"), МетаСпр());
Записать(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента.xml"), МетаФормы("ФормаЭлемента"));
Записать(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульРасшКат);
Записать(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаСписка.xml"), МетаФормы("ФормаСписка"));
Записать(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаСписка", "Ext", "Form", "Module.bsl"), "остаётся");
Записать(П(Расш, "CommonForms", "ОбщРучн.xml"), МетаФормы("ОбщРучн"));
Записать(П(Расш, "CommonForms", "ОбщРучн", "Ext", "Form.xml"), "<Form>EXT-CF</Form>");
Записать(П(Расш, "CommonForms", "ОбщРучн", "Ext", "Form", "Module.bsl"), "расш-общий");

Список = Новый Массив;
Список.Добавить(ОтнКат);
Список.Добавить(ОтнОбщ);
Лог = Новый Массив;
Рез = К.ПрименитьРучныеФормыУп(Уп, Восст, Расш, Список, Лог);
Проверить(Рез.forms = 2, "скопированы 2 формы, было " + Рез.forms);
Проверить(ТекстФайла(П(Восст, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = МодульУпКат, "модуль каталога в restored из УП");
Проверить(ТекстФайла(П(Восст, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form.xml")) = XmlУпКат, "Form.xml каталога в restored из УП");
Проверить(ТекстФайла(П(Восст, "CommonForms", "ОбщРучн", "Ext", "Form", "Module.bsl")) = МодульУпОбщ, "модуль общей формы в restored из УП");
Проверить(ТекстФайла(П(Восст, "CommonForms", "ОбщРучн", "Ext", "Form.xml")) = XmlУпОбщ, "Form.xml общей формы в restored из УП");

Проверить(Не (Новый Файл(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"))).Существует(), "модуль формы убран из расширения");
Проверить(Не (Новый Файл(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента.xml"))).Существует(), "мета формы убрана из расширения");
Проверить((Новый Файл(П(Расш, "Catalogs", "СпрРучн", "Forms", "ФормаСписка", "Ext", "Form", "Module.bsl"))).Существует(), "другая форма объекта в расширении осталась");
МетаОб = ТекстФайла(П(Расш, "Catalogs", "СпрРучн.xml"));
Проверить(СтрНайти(МетаОб, "<Form>ФормаЭлемента</Form>") = 0, "ФормаЭлемента убрана из ChildObjects");
Проверить(СтрНайти(МетаОб, "<Form>ФормаСписка</Form>") > 0, "ФормаСписка осталась в ChildObjects");
Конф = ТекстФайла(П(Расш, "Configuration.xml"));
Проверить(СтрНайти(Конф, "<CommonForm>ОбщРучн</CommonForm>") = 0, "общая форма убрана из Configuration.xml");
Проверить(СтрНайти(Конф, "<Catalog>СпрРучн</Catalog>") > 0, "каталог в Configuration.xml остался");
Проверить(Не (Новый Файл(П(Расш, "CommonForms", "ОбщРучн", "Ext", "Form", "Module.bsl"))).Существует(), "модуль общей формы убран из расширения");

// pack1 с manual-списком не должен подменять restored на БП
Записать(П(Бп, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), "&НаСервере" + Символы.ПС + "Процедура УП_ТолькоУп()" + Символы.ПС + "	ТелоБп = 1;" + Символы.ПС + "КонецПроцедуры" + Символы.ПС);
Записать(П(ТипК, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульТипКат);
Записать(П(ТипК, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Configuration uuid=""eeeeeeee-eeee-eeee-eeee-eeeeeeeeeeee""><ChildObjects></ChildObjects></Configuration></MetaDataObject>");
Лог2 = Новый Массив;
ВсеФормы = Новый Массив;
ВсеФормы.Добавить(ОтнКат);
К.ЗаменитьТелаRestoredНаБп(ТипК, Уп, Бп, Восст, Расш, ВсеФормы, Лог2, "", Список);
Проверить(ТекстФайла(П(Восст, "Catalogs", "СпрРучн", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = МодульУпКат, "pack1 пропускает ручную форму");

// нет файлов УП — в todo, restored не портят другую форму
ОтнНет = "Catalogs\НетФормы\Forms\ФормаЭлемента\Ext\Form.xml";
Лог3 = Новый Массив;
СпНет = Новый Массив;
СпНет.Добавить(ОтнНет);
РезНет = К.ПрименитьРучныеФормыУп(Уп, Восст, Расш, СпНет, Лог3);
Проверить(РезНет.forms = 0, "пустая УП-форма не копируется");
Проверить(РезНет.todo.Количество() = 1, "нет файлов УП — запись в todo");

Сообщить("OK test_iik_manual_forms");

// Списки keep-up / &Вместо после p2m3
КатСкр = ОбъединитьПути(ТекущийКаталог(), "typovaya-up", "scripts");
Если Не (Новый Файл(ОбъединитьПути(КатСкр, "iik_manual_keepup_forms.txt"))).Существует() Тогда
	КатСкр = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "scripts");
КонецЕсли;
ПротСп = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ФормыБпПрототип.os"));
Ку = ПротСп.ПрочитатьСписокФорм(ОбъединитьПути(КатСкр, "iik_manual_keepup_forms.txt"));
Вм = ПротСп.ПрочитатьСписокФорм(ОбъединитьПути(КатСкр, "iik_manual_vmesto_forms.txt"));
Проверить(Ку.Количество() = 19, "keep-up 19 форм, было " + Ку.Количество());
Проверить(Вм.Количество() = 9, "vmesto 9 форм, было " + Вм.Количество());
ЕстьРо = Ложь;
Пересечение = 0;
Для Каждого Ф Из Ку Цикл
	Если К.ЭтоФормаОставляемаяЦеликомВRestored(Ф) Тогда
		ЕстьРо = Истина;
	КонецЕсли;
	Для Каждого Ф2 Из Вм Цикл
		Если НРег(СтрЗаменить(Строка(Ф), "/", "\")) = НРег(СтрЗаменить(Строка(Ф2), "/", "\")) Тогда
			Пересечение = Пересечение + 1;
		КонецЕсли;
	КонецЦикла;
	Проверить(К.ЭтоФормаОставляемаяЦеликомВRestored(Ф, Ку), "keep-up форма узнаётся по списку: " + Ф);
КонецЦикла;
Проверить(ЕстьРо, "РегламентированнаяОтчетность в keep-up");
Проверить(Пересечение = 0, "списки keep-up и vmesto не пересекаются");
Для Каждого Ф Из Вм Цикл
	Проверить(Не К.ЭтоФормаОставляемаяЦеликомВRestored(Ф, Ку), "vmesto-форма не keep-up: " + Ф);
КонецЦикла;

