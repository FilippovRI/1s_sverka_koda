Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		ВызватьИсключение Сообщение;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = П1;
	Для Каждого С Из ОбщийМассив(П2, П3, П4, П5, П6, П7, П8) Цикл
		Если С <> "" Тогда
			Р = ОбъединитьПути(Р, С);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОбщийМассив(П2, П3, П4, П5, П6, П7, П8)
	М = Новый Массив;
	М.Добавить(П2); М.Добавить(П3); М.Добавить(П4); М.Добавить(П5); М.Добавить(П6); М.Добавить(П7); М.Добавить(П8);
	Возврат М;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Ч = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Ч.Записать(Текст);
	Ч.Закрыть();
КонецПроцедуры

Функция ТекстФайла(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Если Т = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Т, 1) = Символ(65279) Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	Возврат СтрЗаменить(Т, Символы.ВК, "");
КонецФункции

Функция КонфМин(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Configuration uuid=""" + Уид + """><ChildObjects></ChildObjects></Configuration></MetaDataObject>";
КонецФункции

Функция МетаФормыТип()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21""><Form uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa""><Properties><Name>ФормаЭлемента</Name></Properties></Form></MetaDataObject>";
КонецФункции

Функция МетаСпрТип()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" version=""2.21""><Catalog uuid=""bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb""><Properties><Name>СпрВместо</Name></Properties><ChildObjects><Form>ФормаЭлемента</Form></ChildObjects></Catalog></MetaDataObject>";
КонецФункции

Функция XmlТипФормы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
		+ "	<Events>" + Символы.ПС
		+ "		<Event name=""OnCreateAtServer"">ПриСозданииНаСервере</Event>" + Символы.ПС
		+ "		<Event name=""OnOpen"">ТолькоУпОбработчик</Event>" + Символы.ПС
		+ "	</Events>" + Символы.ПС
		+ "	<Commands/>" + Символы.ПС
		+ "	<Attributes/>" + Символы.ПС
		+ "	<ChildItems/>" + Символы.ПС
		+ "</Form>";
КонецФункции

Функция XmlУпФормы()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">" + Символы.ПС
		+ "	<Events>" + Символы.ПС
		+ "		<Event name=""OnCreateAtServer"">ПриСозданииНаСервере</Event>" + Символы.ПС
		+ "		<Event name=""OnOpen"">ТолькоУпОбработчик</Event>" + Символы.ПС
		+ "	</Events>" + Символы.ПС
		+ "	<Commands>" + Символы.ПС
		+ "		<Command name=""КомандаТолькоУп"" id=""1"">" + Символы.ПС
		+ "			<Action>ТолькоУпОбработчик</Action>" + Символы.ПС
		+ "		</Command>" + Символы.ПС
		+ "	</Commands>" + Символы.ПС
		+ "	<Attributes/>" + Символы.ПС
		+ "	<ChildItems/>" + Символы.ПС
		+ "</Form>";
КонецФункции

К = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));
Корень = ОбъединитьПути(КаталогВременныхФайлов(), "tu_vmesto_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
Уп = П(Корень, "up");
ТипК = П(Корень, "typ");
Бп = П(Корень, "bp");
Восст = П(Корень, "restored");
Расш = П(Корень, "extension");
Отн = "Catalogs\СпрВместо\Forms\ФормаЭлемента\Ext\Form.xml";
ОтнРо = "CommonForms\РегламентированнаяОтчетность\Ext\Form.xml";

МодульТип = "&НаСервере" + Символы.ПС
	+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
	+ "	ТиповойКод = 1;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура БезВызововУп()" + Символы.ПС
	+ "	Возврат;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Процедура ТолькоУпОбработчик()" + Символы.ПС
	+ "	Сообщить(1);" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура СРазнойСигнатурой(П1)" + Символы.ПС
	+ "	ТипСиг = 1;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;
МодульБп = "&НаСервере" + Символы.ПС
	+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
	+ "	ТелоБп = 1;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура БезВызововУп()" + Символы.ПС
	+ "	Возврат;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура СРазнойСигнатурой(П1)" + Символы.ПС
	+ "	ТелоБпСиг = 1;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;
МодульУп = "&НаСервере" + Символы.ПС
	+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
	+ "	Если ОбщегоНазначенияНСКВызовСервера.Доступно() Тогда" + Символы.ПС
	+ "		Возврат;" + Символы.ПС
	+ "	КонецЕсли;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура БезВызововУп()" + Символы.ПС
	+ "	УпКодБезМодуля = 1;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Процедура ТолькоУпОбработчик()" + Символы.ПС
	+ "	Сообщить(2);" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
	+ "&НаСервере" + Символы.ПС
	+ "Процедура СРазнойСигнатурой(П1, П2)" + Символы.ПС
	+ "	УпСиг = П2;" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;

Записать(П(ТипК, "Configuration.xml"), КонфМин("11111111-1111-1111-1111-111111111111"));
Записать(П(ТипК, "Catalogs", "СпрВместо.xml"), МетаСпрТип());
Записать(П(ТипК, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента.xml"), МетаФормыТип());
Записать(П(ТипК, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlТипФормы());
Записать(П(ТипК, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульТип);

Записать(П(Бп, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульБп);

Записать(П(Уп, "Configuration.xml"), КонфМин("22222222-2222-2222-2222-222222222222"));
Записать(П(Уп, "CommonModules", "ОбщегоНазначенияНСКВызовСервера.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><CommonModule uuid=""33333333-3333-3333-3333-333333333333""><Properties><Name>ОбщегоНазначенияНСКВызовСервера</Name></Properties></CommonModule></MetaDataObject>");
Записать(П(Уп, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlУпФормы());
Записать(П(Уп, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульУп);

// в restored сначала лежит УП (как после ошибочного полного копирования)
Записать(П(Восст, "Configuration.xml"), КонфМин("44444444-4444-4444-4444-444444444444"));
Записать(П(Восст, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlУпФормы());
Записать(П(Восст, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), МодульУп);
Записать(П(Расш, "Configuration.xml"), КонфМин("55555555-5555-5555-5555-555555555555"));

// форма, которая должна остаться УП-шной
Записать(П(Уп, "CommonForms", "РегламентированнаяОтчетность", "Ext", "Form.xml"), "<Form>UP-RO</Form>");
Записать(П(Уп, "CommonForms", "РегламентированнаяОтчетность", "Ext", "Form", "Module.bsl"), "МодульУпРо");
Записать(П(Восст, "CommonForms", "РегламентированнаяОтчетность", "Ext", "Form.xml"), "<Form>UP-RO</Form>");
Записать(П(Восст, "CommonForms", "РегламентированнаяОтчетность", "Ext", "Form", "Module.bsl"), "МодульУпРо");

Проверить(К.ЭтоФормаОставляемаяЦеликомВRestored(ОтнРо), "РО остаётся в restored");
Проверить(Не К.ЭтоФормаОставляемаяЦеликомВRestored(Отн), "обычная форма идёт в &Вместо");

Список = Новый Массив;
Список.Добавить(Отн);
Список.Добавить(ОтнРо);
Лог = Новый Массив;
Рез = К.ПрименитьРучныеФормыВместо(ТипК, Уп, Бп, Восст, Расш, Список, Лог);
Проверить(Рез.forms = 1, "обработана 1 форма, было " + Рез.forms);
Проверить(Рез.moved = 1, "перенесён 1 метод без БП, было " + Рез.moved);
Проверить(Рез.prefixed = 1, "1 метод с другой сигнатурой, было " + Рез.prefixed);
Проверить(Рез.hooks = 1, "один хук &Вместо, было " + Рез.hooks);

ТекстВосст = ТекстФайла(П(Восст, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(СтрНайти(ТекстВосст, "ТелоБп = 1;") > 0, "в restored тело БП");
Проверить(СтрНайти(ТекстВосст, "ОбщегоНазначенияНСКВызовСервера") = 0, "в restored нет вызова УП-модуля");
Проверить(СтрНайти(ТекстВосст, "УпКодБезМодуля = 1;") = 0, "метод без вызовов УП остался typovaya/не УП-тело");
Проверить(СтрНайти(ТекстФайла(П(Восст, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form.xml")), "ТолькоУпОбработчик") = 0, "привязка убранного метода снята в restored Form.xml");
Проверить(СтрНайти(ТекстВосст, "Процедура ТолькоУпОбработчик(") = 0, "метода нет в БП — убран из restored");
Проверить(СтрНайти(ТекстВосст, "ТелоБпСиг = 1;") > 0, "разная сигнатура: в restored тело БП");
Проверить(СтрНайти(ТекстВосст, "УпСиг = П2;") = 0, "разная сигнатура: тело УП не в restored");

ТекстРасш = ТекстФайла(П(Расш, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(СтрНайти(ТекстРасш, "&Вместо(""ПриСозданииНаСервере"")") > 0, "в расширении &Вместо");
Проверить(СтрНайти(ТекстРасш, "Процедура УП_ПриСозданииНаСервере(") > 0, "префикс УП_");
Проверить(СтрНайти(ТекстРасш, "ОбщегоНазначенияНСКВызовСервера.Доступно()") > 0, "тело УП в хуке");
Проверить(СтрНайти(ТекстРасш, "БезВызововУп") = 0, "метод без вызовов УП в расширение не уходил");
Проверить(СтрНайти(ТекстРасш, "Процедура ТолькоУпОбработчик(") > 0, "метод без БП перенесён в расширение как свой");
Проверить(СтрНайти(ТекстРасш, "Сообщить(2);") > 0, "тело УП у собственного метода");
Проверить(СтрНайти(ТекстРасш, "&НаКлиенте") > 0, "директива своего метода сохранена");
Проверить(СтрНайти(ТекстРасш, "Процедура УП_СРазнойСигнатурой(П1, П2)") > 0, "разная сигнатура: префикс УП_");
Проверить(СтрНайти(ТекстРасш, "УпСиг = П2;") > 0, "разная сигнатура: тело УП в расширении");
ТекстРасшФ = ТекстФайла(П(Расш, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента", "Ext", "Form.xml"));
Проверить(СтрНайти(ТекстРасшФ, "<Event name=""OnOpen"">ТолькоУпОбработчик</Event>") > 0, "событие ушедшего метода в Form.xml расширения");
Проверить(СтрНайти(ТекстРасшФ, "<Action>ТолькоУпОбработчик</Action>") > 0, "команда ушедшего метода в Form.xml расширения");
Проверить((Новый Файл(П(Расш, "Catalogs", "СпрВместо", "Forms", "ФормаЭлемента.xml"))).Существует(), "форма заимствована");

Проверить(ТекстФайла(П(Восст, "CommonForms", "РегламентированнаяОтчетность", "Ext", "Form", "Module.bsl")) = "МодульУпРо", "РО в restored не трогали");
Проверить(Не (Новый Файл(П(Расш, "CommonForms", "РегламентированнаяОтчетность", "Ext", "Form", "Module.bsl"))).Существует(), "РО в расширение не писали");

Сообщить("OK test_iik_manual_vmesto");
