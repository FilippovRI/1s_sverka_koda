// Юнит-тесты задачи 11: возврат в основную общих модулей «только БП», на которые ссылается код restored.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Записать(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция Конф(Объекты)
	Т = "<MetaDataObject>" + Символы.ПС + "	<Configuration>" + Символы.ПС + "		<ChildObjects>" + Символы.ПС;
	Для Каждого О Из СтрРазделить(Объекты, ",") Цикл
		Ч = СтрРазделить(О, ".");
		Т = Т + "			<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">" + Символы.ПС;
	КонецЦикла;
	Возврат Т + "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции

Процедура Модуль(Корень, Имя, Текст, Глоб = Ложь)
	Записать(ОбъединитьПути(Корень, "CommonModules", Имя + ".xml"), "<CommonModule><Global>" + ?(Глоб, "true", "false") + "</Global></CommonModule>");
	Записать(ОбъединитьПути(Корень, "CommonModules", Имя, "Ext/Module.bsl"), Текст);
КонецПроцедуры

Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Ошибок = 0;
В = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ВозвратОбщихМодулейБп.os"));

Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t11_" + Строка(Новый УникальныйИдентификатор));
Осн = ОбъединитьПути(Вр, "main");
Бп = ОбъединитьПути(Вр, "bp");
Записать(ОбъединитьПути(Осн, "Configuration.xml"), Конф("CommonModule.ОбщегоНазначения,Catalog.Организации"));
Записать(ОбъединитьПути(Бп, "Configuration.xml"), Конф("CommonModule.ОбщегоНазначения,CommonModule.БухУчет,CommonModule.БухУчетПовт,CommonModule.Хозрасчет,CommonModule.ГлобБп,Catalog.Организации,ChartOfAccounts.Хозрасчетный"));
Модуль(Бп, "ОбщегоНазначения", "");
Модуль(Бп, "БухУчет", "Функция Ф() Экспорт
|	Возврат БухУчетПовт.Г(Справочники.Организации.ПустаяСсылка());
|КонецФункции");
Модуль(Бп, "БухУчетПовт", "Функция Г(А) Экспорт
|	Возврат А;
|КонецФункции");
Модуль(Бп, "Хозрасчет", "Функция Сч() Экспорт
|	Возврат ПланыСчетов.Хозрасчетный.Касса;
|КонецФункции");
Модуль(Бп, "ГлобБп", "Процедура ОповеститьБп() Экспорт
|КонецПроцедуры", Истина);
Записать(ОбъединитьПути(Осн, "Documents", "Д", "Ext/ObjectModule.bsl"), "Процедура П()
|	А = БухУчет.Ф(); // Хозрасчет.Сч() в комментарии не считается
|	Б = Хозрасчет.Сч();
|	ОповеститьБп();
|	С = ""ГлобБп.Х"";
|КонецПроцедуры");

Р = В.Анализ(Осн, Бп);
Проверить(Р.modules.Количество() = 4, "замыкание: 4 модуля, получено " + Р.modules.Количество());
Проверить(Р.clean.Найти("БухУчет") <> Неопределено И Р.clean.Найти("БухУчетПовт") <> Неопределено
	И Р.clean.Найти("ГлобБп") <> Неопределено, "чистые: прямой, транзитивный, глобальный");
Проверить(Р.clean.Найти("Хозрасчет") = Неопределено И Р.blocked.Получить("Хозрасчет") = "Хозрасчет: ChartOfAccounts.Хозрасчетный",
	"блокирован модуль с отсутствующим объектом: " + Р.blocked.Получить("Хозрасчет"));
Проверить(Р.objects.Количество() = 1, "список объектов на решение");

Доб = В.Вернуть(Р.clean, Бп, Осн);
Проверить(Доб = 3, "в Configuration.xml добавлено 3");
Т = В.ПрочитатьТекст(ОбъединитьПути(Осн, "Configuration.xml"));
Проверить(СтрНайти(Т, "			<CommonModule>БухУчетПовт</CommonModule>") > 0 И СтрНайти(Т, "<CommonModule>Хозрасчет<") = 0, "состав конфигурации");
Проверить((Новый Файл(ОбъединитьПути(Осн, "CommonModules", "БухУчет", "Ext/Module.bsl"))).Существует(), "файлы модуля скопированы");
Проверить(В.Вернуть(Р.clean, Бп, Осн) = 0, "повторный возврат не дублирует");
Р2 = В.Анализ(Осн, Бп);
Проверить(Р2.clean.Количество() = 0 И Р2.blocked.Количество() = 1, "после возврата остались только заблокированные");

УдалитьФайлы(Вр);
Если Ошибок > 0 Тогда
	ЗавершитьРаботу(1);
КонецЕсли;
Сообщить("OK: test_task11");
