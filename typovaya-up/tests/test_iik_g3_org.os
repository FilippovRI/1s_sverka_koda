// Группа 3: обрывок вне процедур, баланс ИиК при «Конецфункции», заимствованный Список.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция ПС()
	Возврат Символы.ПС;
КонецФункции

Ошибок = 0;
Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));

// 1) исполняемый хвост typovaya вне процедур убирается, Перем и области остаются
ТекстВосст = "&НаКлиенте" + ПС()
	+ "Перем ЗаполнятьРеквизитыПоИНН;" + ПС() + ПС()
	+ "&НаСервере" + ПС()
	+ "Функция ТекстОшибкиЗаполненияНомераСФР(РегистрационныйНомер)" + ПС()
	+ "	Возврат ПроверкиБЗК.ТекстОшибкиЗаполненияНомераСФР(РегистрационныйНомер);" + ПС()
	+ "КонецФункции" + ПС() + ПС()
	+ "#Область Хвост" + ПС()
	+ "#КонецОбласти" + ПС() + ПС()
	+ "ЗаполнятьРеквизитыПоИНН = Истина;" + ПС();
Оч = Модуль.УбратьИсполняемыйКодВнеМетодов(ТекстВосст);
Проверить(СтрНайти(Оч, "ЗаполнятьРеквизитыПоИНН = Истина;") = 0, "обрывок вне процедур убран");
Проверить(СтрНайти(Оч, "Перем ЗаполнятьРеквизитыПоИНН;") > 0, "Перем сохранён");
Проверить(СтрНайти(Оч, "#Область Хвост") > 0, "область сохранена");
Проверить(СтрНайти(Оч, "КонецФункции") > 0, "метод на месте");

// 2) «Конецфункции» внутри #Удаление не ломает хук; следующий метод не проглатывается
Сырой = "&НаСервере" + ПС()
	+ "&ИзменениеИКонтроль(""ПолучитьЭлементСоответствия"")" + ПС()
	+ "Функция ПолучитьЭлементСоответствия(Соответствие)" + ПС()
	+ "#Удаление" + ПС()
	+ "	Для Каждого Эл Из Соответствие Цикл" + ПС()
	+ "		ТекЭлем = Эл;" + ПС()
	+ "	КонецЦикла;" + ПС()
	+ "	Возврат ТекЭлем;" + ПС()
	+ "Конецфункции" + ПС() + ПС()
	+ "&НаСервереБезКонтекста" + ПС()
	+ "Функция ПолучитьСоответствиеДомов()" + ПС()
	+ "	Возврат НСКОбщегоНазначенияПовтИсп.ПолучитьСоответствиеДомов();" + ПС()
	+ "#КонецУдаления" + ПС()
	+ "#Вставка" + ПС()
	+ "	Для Каждого Эл Из Соответствие Цикл" + ПС()
	+ "		ТекЭлем = Эл;" + ПС()
	+ "	КонецЦикла;" + ПС()
	+ "	Возврат ТекЭлем;" + ПС()
	+ "Конецфункции" + ПС()
	+ "#КонецВставки" + ПС();
Испр = Модуль.ОчиститьМаркерыКонцаВТелахИиК(Сырой);
Проверить(СтрЧислоВхождений(Испр, "#Вставка") = СтрЧислоВхождений(Испр, "#КонецВставки"), "баланс #Вставка");
Проверить(СтрЧислоВхождений(Испр, "#Удаление") = СтрЧислоВхождений(Испр, "#КонецУдаления"), "баланс #Удаление");
Проверить(СтрНайти(Испр, "&ИзменениеИКонтроль(""ПолучитьЭлементСоответствия"")") > 0, "хук на месте");
Проверить(СтрНайти(Испр, "Функция ПолучитьСоответствиеДомов()") > 0, "следующий метод не потерян");
// в #Удаление/#Вставка не должно остаться маркера конца метода
Разд = СтрРазделить(СтрЗаменить(Испр, Символы.ВК, ""), ПС(), Истина);
ВУд = Ложь; ВВст = Ложь; ВнутриКонец = Ложь;
Для Каждого С Из Разд Цикл
	Сп = СокрЛП(С); Сн = НРег(Сп);
	Если СтрНачинаетсяС(Сн, "#удаление") Тогда ВУд = Истина;
	ИначеЕсли СтрНачинаетсяС(Сн, "#конецудаления") Тогда ВУд = Ложь;
	ИначеЕсли СтрНачинаетсяС(Сн, "#вставка") Тогда ВВст = Истина;
	ИначеЕсли СтрНачинаетсяС(Сн, "#конецвставки") Тогда ВВст = Ложь;
	ИначеЕсли (ВУд Или ВВст) И (СтрНачинаетсяС(Сн, "конецфункции") Или СтрНачинаетсяС(Сн, "конецпроцедуры")) Тогда
		ВнутриКонец = Истина;
	КонецЕсли;
КонецЦикла;
Проверить(Не ВнутриКонец, "в телах ИиК нет КонецФункции/Конецфункции");
Проверить(СтрНайти(Испр, "КонецФункции") > 0, "есть нормальное закрытие хука");

// 3) СобратьТекстИиКБезИзменений не кладёт Конецфункции в #Удаление
РаздМ = Модуль.РазобратьМодульНаМетоды(
	"&НаСервере" + ПС()
	+ "Функция ПолучитьЭлементСоответствия(Соответствие)" + ПС()
	+ "	Возврат ТекЭлем;" + ПС()
	+ "Конецфункции" + ПС());
Хук = Модуль.СобратьТекстИиКБезИзменений(РаздМ.byName.Получить("ПолучитьЭлементСоответствия"));
Проверить(СтрНайти(Хук, "#КонецВставки") > 0, "хук закрыт #КонецВставки");
Проверить(СтрНайти(НРег(Хук), НРег("#Удаление") + ПС() + "Конецфункции") = 0, "Конецфункции не сразу после #Удаление");
// тело без маркера конца
ПУд = СтрНайти(Хук, "#Удаление");
ПКу = СтрНайти(Хук, "#КонецУдаления");
ТелоУд = Сред(Хук, ПУд, ПКу - ПУд);
Проверить(СтрНайти(НРег(ТелоУд), "конецфункции") = 0, "в #Удаление нет конецфункции");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_g3_org");
Иначе
	Сообщить("FAILED test_iik_g3_org: " + Ошибок);
КонецЕсли;
