// Возврат CommonPicture из БП и очистка RowsPicture в Form.xml.
Перем Ошибок;

Процедура Проверить(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Зап(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "_form_meta_tmp");
Если (Новый Файл(Корень)).Существует() Тогда
	УдалитьФайлы(Корень);
КонецЕсли;
Бп = ОбъединитьПути(Корень, "bp");
Осн = ОбъединитьПути(Корень, "main");
Уп = ОбъединитьПути(Корень, "up");
СоздатьКаталог(Бп);
СоздатьКаталог(Осн);
СоздатьКаталог(Уп);

КонфШаб = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Configuration><ChildObjects>" + Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "</ChildObjects></Configuration>";
Зап(ОбъединитьПути(Осн, "Configuration.xml"), КонфШаб);
Зап(ОбъединитьПути(Уп, "Configuration.xml"), КонфШаб);
Зап(ОбъединитьПути(Бп, "Configuration.xml"), СтрЗаменить(КонфШаб, Символы.Таб + Символы.Таб + Символы.Таб + "</ChildObjects>",
	Символы.Таб + Символы.Таб + Символы.Таб + "<CommonPicture>КартТест</CommonPicture>" + Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "</ChildObjects>"));
Зап(ОбъединитьПути(Бп, "CommonPictures\КартТест.xml"), "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses""><CommonPicture uuid=""a""><Properties><Name>КартТест</Name></Properties></CommonPicture></MetaDataObject>");

Форм = ОбъединитьПути(Осн, "CommonForms\Тест\Ext\Form.xml");
СоздатьКаталог((Новый Файл(Форм)).Путь);
Зап(Форм, "<?xml version=""1.0""?><Form><RowsPicture><xr:Ref>CommonPicture.КартТест</xr:Ref></RowsPicture></Form>");

Ошибок = 0;
Вм = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ВозвратМетаданныхФормБп.os"));
Лог = Новый Массив;
Р = Вм.Исправить(Осн, Бп, Уп, Лог);
Проверить((Новый Файл(ОбъединитьПути(Осн, "CommonPictures\КартТест.xml"))).Существует(), "picture copied");
Проверить(Р.full >= 1, "one full return");
Т = Новый ЧтениеТекста(Форм, КодировкаТекста.UTF8);
Тело = Т.Прочитать();
Т.Закрыть();
Проверить(СтрНайти(Тело, "RowsPicture") > 0, "RowsPicture not stripped");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_form_meta: " + Ошибок;
КонецЕсли;
Сообщить("OK test_form_meta");