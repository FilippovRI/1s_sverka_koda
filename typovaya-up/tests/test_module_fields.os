// РеквизитыМодулейЗаимствованных: реквизиты основной (restored), используемые в модуле заимствованного объекта
// расширения, заимствуются; отсутствующие в основной не добавляются; повтор ничего не меняет.
Перем Ошибок;
Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Ошибок = 0;
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_module_fields_" + Строка(Новый УникальныйИдентификатор));
Восст = ОбъединитьПути(Вр, "restored");
Расш = ОбъединитьПути(Вр, "extension");
Зап(ОбъединитьПути(Восст, "Documents", "Док.xml"), "<MetaDataObject><Document uuid=""d0000000-0000-0000-0000-000000000001""><Properties><Name>Док</Name></Properties>
|<ChildObjects>
|			<Attribute uuid=""a0000000-0000-0000-0000-000000000001""><Properties><Name>Организация</Name><Type><v8:Type>xs:string</v8:Type></Type></Properties></Attribute>
|			<Attribute uuid=""a0000000-0000-0000-0000-000000000002""><Properties><Name>Лишний</Name><Type><v8:Type>xs:string</v8:Type></Type></Properties></Attribute>
|</ChildObjects></Document></MetaDataObject>");
Зап(ОбъединитьПути(Расш, "Documents", "Док.xml"), "<MetaDataObject>
|	<Document uuid=""11111111-0000-0000-0000-000000000001"">
|		<Properties>
|			<ObjectBelonging>Adopted</ObjectBelonging>
|			<Name>Док</Name>
|		</Properties>
|		<ChildObjects/>
|	</Document>
|</MetaDataObject>");
Зап(ОбъединитьПути(Расш, "Documents/Док/Ext", "ObjectModule.bsl"), "&ИзменениеИКонтроль(""ПередЗаписью"")
|Процедура УП_ПередЗаписью(Отказ)
|	Местная = Организация;
|	Если ТолькоВУп = 1 Тогда
|	КонецЕсли;
|КонецПроцедуры");
Зап(ОбъединитьПути(Расш, "Configuration.xml"), "<MetaDataObject><Configuration><ChildObjects>
|			<Document>Док</Document>
|</ChildObjects></Configuration></MetaDataObject>");
М = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "РеквизитыМодулейЗаимствованных.os"));
Лог = Новый Массив;
Р = М.Применить(Расш, Восст, "УП_Доработки", Лог, Вр);
ХД = Чит(ОбъединитьПути(Расш, "Documents", "Док.xml"));
П(Р.children = 1, "заимствован 1 реквизит: " + Р.children);
П(СтрНайти(ХД, "<ExtendedConfigurationObject>a0000000-0000-0000-0000-000000000001<") > 0, "Организация заимствована");
П(СтрНайти(ХД, "<Name>Лишний</Name>") = 0, "неиспользуемый реквизит не заимствуется");
П(СтрНайти(ХД, "ТолькоВУп") = 0 И СтрНайти(ХД, "<Name>Местная</Name>") = 0, "отсутствующие в основной / локальные не добавляются");
П(СтрНайти(Чит(ОбъединитьПути(Вр, "extension_module_fields_adopted.csv")), "child;Document.Док.Организация") > 0, "отчёт csv");
Р2 = М.Применить(Расш, Восст, "УП_Доработки", Лог, "");
П(Р2.children = 0 И Чит(ОбъединитьПути(Расш, "Documents", "Док.xml")) = ХД, "повтор идемпотентен");
УдалитьФайлы(Вр);
Для Каждого С Из Лог Цикл Сообщить(С); КонецЦикла;
Если Ошибок > 0 Тогда ВызватьИсключение "test_module_fields"; КонецЕсли;
Сообщить("OK: test_module_fields");
