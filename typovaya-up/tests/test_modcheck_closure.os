// Юнит-тесты ПроверкаЗамкнутости.os по фикстурам tests/fixtures/modcheck/*.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция ЕстьКласс(Р, Класс)
	Для Каждого Э Из Р.unresolved Цикл
		Если Э.class = Класс Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция Счетчик(Р, Класс)
	Если Р.counts.Получить(Класс) = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Р.counts[Класс];
КонецФункции

КореньСк = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Пров = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "src", "ПроверкаЗамкнутости.os"));
Фикс = ОбъединитьПути(ТекущийСценарий().Каталог, "fixtures", "modcheck");
Ошибок = 0;

РСт = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "style"));
П(Не РСт.ok И ЕстьКласс(РСт, "StyleItem"), "style: StyleItem");

РДп = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "datapath"));
П(Не РДп.ok И ЕстьКласс(РДп, "DataPath"), "datapath");
РНд = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "ndfl_path"));
П(ЕстьКласс(РНд, "DataPath") И СтрНайти(РНд.unresolved[0].ref, "СпособФормирования") > 0, "ndfl СпособФормирования");

РCfg = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "cfg"));
П(Не РCfg.ok И ЕстьКласс(РCfg, "CfgType"), "cfg missing");

РВт = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "form_vt"));
П(Счетчик(РВт, "FormValueTableCfgType") >= 1, "form ValueTable cfg column");

РКонф = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "config_child"));
П(ЕстьКласс(РКонф, "ConfigChildMissing"), "config child missing file");

РДт = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "defined_type"));
П(ЕстьКласс(РДт, "DefinedTypeDuplicateUuid"), "defined type dup uuid");

ПутьБп = ОбъединитьПути(Фикс, "bp_only");
РБп = Пров.ВыполнитьПроверку(ПутьБп, ОбъединитьПути(ПутьБп, "bp"), ОбъединитьПути(ПутьБп, "up"));
П(РБп.bpOnly.Количество() >= 1, "DocumentRef bp-only hint");
П(РБп.ok, "bp-only still closed in restored");

РОк = Пров.ВыполнитьПроверку(ОбъединитьПути(Фикс, "style"));
Пустая = ОбъединитьПути(Фикс, "style");
// негативный style уже проверен; позитив: только ЕстьСтиль в конфиге — всё ещё ошибка из-за НетТакогоСтиля
П(РСт.unresolved.Количество() = 1, "style single unresolved");

Если Ошибок = 0 Тогда
	Сообщить("OK: test_modcheck_closure");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;