Перем Ошибок, Корень;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Функция ТекстФайла(П)
	Т = Новый ТекстовыйДокумент; Т.Прочитать(П); Возврат Т.ПолучитьТекст();
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
В = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПроверкаСкелетаРасширения.os"));
ФСин = ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_synthetic");
Ошибок = 0;
Х0 = ТекстФайла(ОбъединитьПути(ФСин, "Configuration.xml"));

Р = В.ПроверитьКаталогСкелета(ФСин);
П(Р.ОК, "synthetic ok");
П(Р.containedCount = 7, "count 7");
П(Р.objectIds.Количество() = 7, "7 objectIds");

Р2 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_bad_uuid"));
П(Не Р2.ОК, "bad uuid");

Р3 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_dup"));
П(Не Р3.ОК, "dup");

Р4 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_malformed"));
П(Не Р4.ОК, "malformed");

Р5 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_alt_prefix"));
П(Р5.ОК И Р5.containedCount = 1, "alt prefix uri");

OUT = ОбъединитьПути(Корень, "tests", "_sk_out");
УдалитьФайлы(OUT); СоздатьКаталог(OUT);
В.ЗаписатьОтчетВалидации(Р, OUT);
П((Новый Файл(ОбъединитьПути(OUT, "skeleton_validation.json"))).Существует(), "report json");

Р6 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_outside_internal"));
П(Не Р6.ОК, "outside internal");
Р7 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_missing_pair"));
П(Не Р7.ОК, "missing pair");
Р8 = В.ПроверитьКаталогСкелета(ОбъединитьПути(Корень, "tests", "fixtures", "skeleton_bad_dump"));
П(Не Р8.ОК, "bad dump");

П(Х0 = ТекстФайла(ОбъединитьПути(ФСин, "Configuration.xml")), "read-only sources");
УдалитьФайлы(OUT);

Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
П(СтрНайти(Ч.СкелетInternalInfoКонфигурации(), "e1000001-0000-4000-8000-000000000001") > 0, "extension_meta identity kept");

Если Ошибок = 0 Тогда Сообщить("OK: skeleton"); Иначе ЗавершитьРаботу(1); КонецЕсли;
