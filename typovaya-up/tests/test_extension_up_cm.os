// ДополнитьОбщиеМодулиПоСсылкам: модуль УП переносится в extension по ссылке из кода, restored не трогаем.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры
Функция Конф(Объекты)
	Т = "<MetaDataObject>" + Символы.ПС + "	<Configuration>" + Символы.ПС + "		<ChildObjects>" + Символы.ПС;
	Для Каждого О Из СтрРазделить(Объекты, ",", Ложь) Цикл
		О = СокрЛП(О);
		Если О = "" Тогда Продолжить; КонецЕсли;
		Ч = СтрРазделить(О, ".", Ложь);
		Если Ч.Количество() < 2 Тогда Продолжить; КонецЕсли;
		Т = Т + "			<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">" + Символы.ПС;
	КонецЦикла;
	Возврат Т + "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_extup_" + Строка(Новый УникальныйИдентификатор));
Уп = ОбъединитьПути(Вр, "up");
Бп = ОбъединитьПути(Вр, "bp");
Осн = ОбъединитьПути(Вр, "main");
Расш = ОбъединитьПути(Вр, "ext");
НСК = "НСК_ТестКлиент";
Зап(ОбъединитьПути(Уп, "Configuration.xml"), Конф("CommonModule.Целевой,CommonModule." + НСК));
Зап(ОбъединитьПути(Бп, "Configuration.xml"), Конф("CommonModule.Целевой"));
Зап(ОбъединитьПути(Осн, "Configuration.xml"), Конф("CommonModule.Целевой"));
Зап(ОбъединитьПути(Расш, "Configuration.xml"), Конф(""));
Зап(ОбъединитьПути(Уп, "CommonModules", НСК + ".xml"), "<CommonModule><Global>false</Global></CommonModule>");
ТНСК = "Процедура Ожидать() Экспорт" + Символы.ПС + "КонецПроцедуры" + Символы.ПС;
Зап(ОбъединитьПути(Уп, "CommonModules", НСК, "Ext/Module.bsl"), ТНСК);
СоздатьКаталог(ОбъединитьПути(Расш, "CommonModules", "Целевой", "Ext"));
Зап(ОбъединитьПути(Расш, "CommonModules", "Целевой", "Ext/Module.bsl"), НСК + ".Ожидать();" + Символы.ПС);
Чр = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ЧерновикРасширения.os"));
Пер = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ПереносОбъектовУп.os"));
ОТУ = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ОбъектыТолькоУп.os"));
Пер.Инициализировать(Чр, ОТУ);
Лог = Новый Массив;
Р = Пер.ДополнитьОбщиеМодулиПоСсылкам(Расш, Осн, Уп, Бп, Новый Соответствие, "УП_Тест", Лог, Вр);
П(Р.added >= 1, "added");
П((Новый Файл(ОбъединитьПути(Расш, "CommonModules", НСК, "Ext/Module.bsl"))).Существует(), "module bsl");
П(Р.scanAfter.refs = 0, "dangling refs");
УдалитьФайлы(Вр);
Если Ошибок > 0 Тогда ВызватьИсключение "test_extension_up_cm"; КонецЕсли;
Сообщить("OK: test_extension_up_cm");