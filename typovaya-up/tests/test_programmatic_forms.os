Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Записать(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Ошибок = 0;
КореньСк = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Псл = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ФормыПрограммныйСлойУп.os"));
Кат = КаталогВременныхФайлов() + "typovaya_up_prog_forms";
СоздатьКаталог(Кат);
Бп = Кат + "/bp.xml";
Уп = Кат + "/up.xml";
Записать(Бп, "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
	+ "	<Attributes>" + Символы.ПС
	+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
	+ "			<Type><v8:Type>cfg:DocumentObject.Тест</v8:Type></Type>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "</Form>");
Записать(Уп, "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
	+ "	<Attributes>" + Символы.ПС
	+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
	+ "			<Type><v8:Type>cfg:DocumentObject.Тест</v8:Type></Type>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "		<Attribute name=""ФлагУП"" id=""2"">" + Символы.ПС
	+ "			<Type><v8:Type>xs:boolean</v8:Type></Type>" + Символы.ПС
	+ "		</Attribute>" + Символы.ПС
	+ "	</Attributes>" + Символы.ПС
	+ "</Form>");
Т = Псл.FormXmlЗаимствованнаяТолькоБп(Бп);
Проверить(СокрЛП(Т) = СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Бп), "UTF-8")), "Form = копия БП");
Пак = Псл.СобратьПакетУп(Уп, Бп, "УП_");
Проверить(Пак.hasWork, "есть отличия УП");
Проверить(Пак.attrsOk >= 1, "сгенерирован реквизит ФлагУП");
Проверить(СтрНайти(Пак.code, "УП_СоздатьЭлементыУП") > 0, "процедура слоя");
Проверить(СтрНайти(Пак.code, "&После(""ПриСозданииНаСервере"")") > 0, "хук ПриСоздании");
Расш = Кат + "/extension";
Отн = "Documents/Тест/Forms/Форма/Ext/Form.xml";
ПутьТела = ОбъединитьПути(Расш, Отн);
Стат = Новый Структура("forms, programmatic, unsupportedNotes", 0, 0, Новый Массив);
Псл.ОбновитьФормуЗаимствованную(Расш, Отн, Уп, Бп, Бп, "УП_", Стат);
Мод = ОбъединитьПути(Расш, "Documents/Тест/Forms/Форма/Ext/Form/Module.bsl");
Проверить((Новый Файл(Мод)).Существует(), "записан Module.bsl");
Проверить(СтрНайти(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Мод), "UTF-8"), "УП_СоздатьЭлементыУП") > 0, "код в модуле");
Проверить(СтрНайти(ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(ПутьТела), "UTF-8"), "ФлагУП") = 0, "в Form.xml нет реквизита УП");
Если Ошибок > 0 Тогда
	ВызватьИсключение "test_programmatic_forms: " + Ошибок + " failures";
КонецЕсли;
Сообщить("OK test_programmatic_forms");