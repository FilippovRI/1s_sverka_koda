// Режим --формы-из-уп: .bsl из БП, Form.xml и модуль формы — из УП.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция ТекстФайла(Путь)
	Д = Новый ДвоичныеДанные(Путь);
	Возврат СокрЛП(ПолучитьСтрокуИзДвоичныхДанных(Д, КодировкаТекста.UTF8));
КонецФункции

Процедура ЗаписатьСтрокуBom(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Д = ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8NoBOM);
	Д.Записать(Путь);
КонецПроцедуры

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Фикст = ОбъединитьПути(Каталог, "_forms_from_up_tmp");
Ошибок = 0;
Если (Новый Файл(Фикст)).Существует() Тогда
	УдалитьФайлы(Фикст);
КонецЕсли;
СоздатьКаталог(Фикст);
КореньУп = ОбъединитьПути(Фикст, "up");
КореньБп = ОбъединитьПути(Фикст, "bp");
КореньВс = ОбъединитьПути(Фикст, "restored");
КореньВыход = ОбъединитьПути(Фикст, "out");
СоздатьКаталог(КореньУп);
СоздатьКаталог(КореньБп);
СоздатьКаталог(КореньВс);
СоздатьКаталог(КореньВыход);
СоздатьКаталог(ОбъединитьПути(КореньВыход, "extension"));
ЗаписатьСтрокуBom(ОбъединитьПути(КореньУп, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");
ЗаписатьСтрокуBom(ОбъединитьПути(КореньБп, "Configuration.xml"), "<?xml version=""1.0""?><MetaDataObject/>");

ПутьУпСпр = ОбъединитьПути(ОбъединитьПути(КореньУп, "Catalogs"), "Спр");
ПутьБпСпр = ОбъединитьПути(ОбъединитьПути(КореньБп, "Catalogs"), "Спр");
СоздатьКаталог(ОбъединитьПути(ПутьУпСпр, "Ext"));
ПутьУпФормы = ОбъединитьПути(ОбъединитьПути(ПутьУпСпр, "Forms"), "Форма");
ПутьБпФормы = ОбъединитьПути(ОбъединитьПути(ПутьБпСпр, "Forms"), "Форма");
СоздатьКаталог(ОбъединитьПути(ПутьУпФормы, "Ext", "Form"));
СоздатьКаталог(ОбъединитьПути(ПутьБпФормы, "Ext", "Form"));
ЗаписатьСтрокуBom(ОбъединитьПути(ОбъединитьПути(ПутьУпСпр, "Ext"), "ObjectModule.bsl"), "УП_ТЕКСТ");
ЗаписатьСтрокуBom(ОбъединитьПути(ОбъединитьПути(ПутьБпСпр, "Ext"), "ObjectModule.bsl"), "БП_ТЕКСТ");
ПутьУпМодФ = ОбъединитьПути(ОбъединитьПути(ПутьУпФормы, "Ext"), "Form");
ПутьБпМодФ = ОбъединитьПути(ОбъединитьПути(ПутьБпФормы, "Ext"), "Form");
ЗаписатьСтрокуBom(ОбъединитьПути(ПутьУпМодФ, "Module.bsl"), "УП_ФОРМА");
ЗаписатьСтрокуBom(ОбъединитьПути(ПутьБпМодФ, "Module.bsl"), "БП_ФОРМА");
ЗаписатьСтрокуBom(ОбъединитьПути(ОбъединитьПути(ПутьУпФормы, "Ext"), "Form.xml"), "<up/>");
ЗаписатьСтрокуBom(ОбъединитьПути(ОбъединитьПути(ПутьБпФормы, "Ext"), "Form.xml"), "<bp/>");
ОтнФормы = "Catalogs\Спр\Forms\Форма\Ext\Form.xml";
ЗаписатьСтрокуBom(ОбъединитьПути(КореньВыход, "extension", ОтнФормы), "<ext-borrowed/>");

Для Каждого Ф Из НайтиФайлы(КореньУп, "*", Истина) Цикл
	Если Ф.ЭтоКаталог() Тогда
		Продолжить;
	КонецЕсли;
	Отн = Сред(Ф.ПолноеИмя, СтрДлина(КореньУп) + 2);
	Назн = ОбъединитьПути(КореньВс, Отн);
	СоздатьКаталог((Новый Файл(Назн)).Путь);
	КопироватьФайл(Ф.ПолноеИмя, Назн);
КонецЦикла;
// имитация прежнего overlay Form.xml из БП
КопироватьФайл(ОбъединитьПути(КореньБп, ОтнФормы), ОбъединитьПути(КореньВс, ОтнФормы));
ПутьВсМодФ = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньВс, "Catalogs"), "Спр"), "Forms"), "Форма");
ПутьВсМодФ = ОбъединитьПути(ОбъединитьПути(ПутьВсМодФ, "Ext"), "Form");
КопироватьФайл(ОбъединитьПути(ПутьБпМодФ, "Module.bsl"), ОбъединитьПути(ПутьВсМодФ, "Module.bsl"));

Мф = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "МодулиИФормыБыстро.os"));
Лог = Новый Массив;
Р = Мф.ПрименитьМодулиБпФормыИзУп(КореньВс, КореньБп, КореньУп, Лог, КореньВыход);
ПутьФ = ОбъединитьПути(ОбъединитьПути(ПутьВсМодФ, ".."), "Form.xml");
ПутьМ = ОбъединитьПути(ПутьВсМодФ, "Module.bsl");
Проверить(Р.formsFromUp, "formsFromUp");
Проверить(Р.modulesBsl = 1, "object module bp, got " + Р.modulesBsl);
Проверить(Р.formsXml = 0, "no bp Form.xml");
Проверить(ТекстФайла(ПутьФ) = "<up/>", "Form.xml из УП");
Проверить(ТекстФайла(ПутьМ) = "УП_ФОРМА", "модуль формы из УП");
ПутьОбм = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньВс, "Catalogs"), "Спр"), "Ext"), "ObjectModule.bsl");
Проверить(ТекстФайла(ПутьОбм) = "БП_ТЕКСТ", "ObjectModule из БП");
Проверить(Не (Новый Файл(ОбъединитьПути(КореньВыход, "extension", ОтнФормы))).Существует(), "заимствование Form.xml снято");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_forms_from_up";
КонецЕсли;
Сообщить("OK: test_forms_from_up");