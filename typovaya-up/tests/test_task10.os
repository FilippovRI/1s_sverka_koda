// Юнит-тесты задачи 10 (CheckConfig расширения): копии методов основной, &Перед/&После с локальными
// переменными типового тела, заимствование реквизитов/ТЧ/значений по модулям объекта/менеджера.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Записать(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция Прочитать(Путь)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), "UTF-8");
КонецФункции

Функция Т(Массив)
	Возврат СтрСоединить(Массив, Символы.ПС);
КонецФункции

Каталог = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Ошибок = 0;
Дубли = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ДублиМетодовОсновной.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "СинтезХуков.os"));
Синтез.Инициализировать(ЗагрузитьСценарий(ОбъединитьПути(Каталог, "РазборМетодов.os")));
ПП = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ПередПослеВИиК.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ЧерновикРасширения.os"));
З = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ЗаимствованиеПолейСписков.os"));
З.УстановитьЧерновик(Ч);

// 1. Копии методов основной
Осн = "Функция Ф(А) Экспорт
|	Возврат А + 1;
|КонецФункции
|
|Процедура П2()
|	Сообщить(1);
|КонецПроцедуры
|
|Процедура Хук()
|КонецПроцедуры";
Расш = "&После(""Хук"")
|Процедура Хук()
|	Сообщить(2);
|КонецПроцедуры
|
|Функция Ф(А) Экспорт
|	// копия
|	Возврат   А + 1;
|КонецФункции
|
|Процедура П2()
|	Сообщить(3);
|КонецПроцедуры
|
|Процедура Своя()
|	Ф(1);
|КонецПроцедуры";
Р = Дубли.ОчиститьТекст(Расш, Осн);
Проверить(Р.Удалены.Количество() = 1 И Р.Удалены[0] = "Ф", "дубль: удалена одинаковая копия Ф");
Проверить(Р.Отличаются.Количество() = 1 И Р.Отличаются[0] = "П2", "дубль: отличающийся П2 в отчёт");
Проверить(СтрНайти(Р.Текст, "Функция Ф(") = 0, "дубль: Ф удалена из текста");
Проверить(СтрНайти(Р.Текст, "&После(""Хук"")") > 0 И СтрНайти(Р.Текст, "Процедура Своя()") > 0, "дубль: хук и свой метод на месте");

// директивы компиляции удаляются вместе с копией; иная директива — не копия; осиротевшие директивы убираются
ОснД = "&НаСервере
|Процедура С1()
|	А = 1;
|КонецПроцедуры
|
|&НаКлиенте
|Процедура С2()
|	Б = 1;
|КонецПроцедуры";
РасшД = "&НаСервере
|Процедура С1()
|	А = 1;
|КонецПроцедуры
|
|&НаСервере
|Процедура С2()
|	Б = 1;
|КонецПроцедуры
|
|&НаСервере
|
|&НаСервере
|&Вместо(""Х"")
|Процедура УП_Х()
|	ПродолжитьВызов();
|КонецПроцедуры";
РД = Дубли.ОчиститьТекст(РасшД, ОснД);
Проверить(РД.Удалены.Найти("С1") <> Неопределено И РД.Отличаются.Найти("С2") <> Неопределено, "директивы: С1 удалена, С2 с другой директивой — в отчёт");
Проверить(СтрНачинаетсяС(РД.Текст, Символы.ПС + "&НаСервере" + Символы.ПС + "Процедура С2()"), "директивы: &НаСервере С1 удалена вместе с методом" + Символы.ПС + РД.Текст);
Проверить(СтрЧислоВхождений(РД.Текст, "&НаСервере") = 2 И СтрНайти(РД.Текст, "&НаСервере" + Символы.ПС + "&Вместо(""Х"")") > 0, "директивы: осиротевшая &НаСервере убрана" + Символы.ПС + РД.Текст);

// вспомогательный метод УП, вызванный с «(» на следующей строке, переносится в расширение
Доз = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ДозаполнениеМодуля.os"));
Доз.Инициализировать(ЗагрузитьСценарий(ОбъединитьПути(Каталог, "РазборМетодов.os")));
ИсхД = "Процедура Хук()
|	Помощник
|		(1);
|КонецПроцедуры
|
|Процедура Помощник(А)
|КонецПроцедуры";
МД = Новый Структура("sourceText, vendorText", ИсхД, "Процедура Хук()
|КонецПроцедуры");
ВыбД = Новый Массив;
ВыбД.Добавить(Новый Структура("name, status, hookBody", "Хук", "changed", "	Помощник
|		(1);"));
РДоз = Доз.ДозаполнитьВспомогательные(МД, ВыбД, "УП_");
Проверить(РДоз.helpersCopied = 1, "дозаполнение: вызов с «(» на следующей строке");

// 2. Синтез: вставка в конец с локальной типового -> ИиК, без локальной -> &После
Тип = Т(СтрРазделить("	Элементы = Форма.Элементы;|	Элементы.А.Видимость = Истина;", "|"));
Доп1 = Тип + Символы.ПС + "	Элементы.Б.Видимость = Ложь;";
П1 = Синтез.ПредложитьХук(Тип, Доп1);
Проверить(П1.hook = "changeAndControl", "синтез: локальная Элементы во вставке в конец -> ИиК, а не " + П1.hook);
Проверить(СтрНайти(П1.hookBody, "#Вставка") > 0, "синтез: тело ИиК со вставкой");
Доп2 = Тип + Символы.ПС + "	Сообщить(Форма.Имя);";
П2 = Синтез.ПредложитьХук(Тип, Доп2);
Проверить(П2.hook = "after", "синтез: вставка без локальных -> &После, а не " + П2.hook);
Доп3 = Тип + Символы.ПС + "	Обр = Новый Массив;" + Символы.ПС + "	Обр.Добавить(1);";
Проверить(Синтез.ОбщиеЛокальные(Тип, "	Обр = 1;" + Символы.ПС + "	Элементы = 2;", Истина).Количество() = 0, "синтез: своя переменная вставки не считается");
Проверить(Синтез.ОбщиеЛокальные(Тип, "	Элементы = Неопределено;", Ложь).Количество() = 1, "синтез: вставка в начало, присваивающая локальную");
Проверить(Синтез.ОбщиеЛокальные(Тип, "	Сообщить(""Элементы""); // Элементы", Истина).Количество() = 0, "синтез: строки и комментарии не считаются");

// 3. Перепись готового &После в ИиК
ОснМ = "&НаСервере
|Процедура Упр(Форма) Экспорт
|	Элементы = Форма.Элементы;
|	Элементы.А.Видимость = Истина;
|КонецПроцедуры";
РасшМ = "// шапка
|&НаСервере
|&После(""Упр"")
|Процедура УП_Упр(Форма) Экспорт
|	Элементы.Б.Видимость = Ложь;
|КонецПроцедуры
|
|&После(""Другой"")
|Процедура УП_Другой()
|КонецПроцедуры";
РП = ПП.ПереписатьТекст(РасшМ, ОснМ);
Ожид = "// шапка
|&НаСервере
|&ИзменениеИКонтроль(""Упр"")
|Процедура УП_Упр(Форма) Экспорт
|	Элементы = Форма.Элементы;
|	Элементы.А.Видимость = Истина;
|#Вставка
|	Элементы.Б.Видимость = Ложь;
|#КонецВставки
|КонецПроцедуры
|
|&После(""Другой"")
|Процедура УП_Другой()
|КонецПроцедуры";
Проверить(РП.Текст = Ожид, "перепись: &После -> ИиК" + Символы.ПС + РП.Текст);
Проверить(РП.Переписаны.Количество() = 1, "перепись: один хук");
РГ = ПП.ПереписатьТекст(РасшМ, ОснМ, Истина);
Проверить(РГ.Переписаны.Количество() = 0 И РГ.Пропущены.Количество() = 1, "перепись: глобальный модуль пропущен");
РПер = ПП.ПереписатьТекст("&Перед(""Упр"")
|Процедура УП_Упр(Форма) Экспорт
|	Элементы = Неопределено;
|КонецПроцедуры", ОснМ);
Проверить(СтрНайти(РПер.Текст, "&ИзменениеИКонтроль(""Упр"")" + Символы.ПС + "Процедура УП_Упр(Форма) Экспорт" + Символы.ПС + "#Вставка") > 0, "перепись: &Перед -> вставка в начало");

// 4. Идентификаторы модуля и заимствование по модулям
Ид = З.ИдентификаторыМодуля("Процедура А()
|	Сумма = 1; // Комментарий
|	Строка = ""Текст"";
|	Объект.Поле = Товары.Количество();
|#Удаление
|	Удалённое = 1;
|#КонецУдаления
|КонецПроцедуры");
Проверить(Ид.Получить("сумма") <> Неопределено И Ид.Получить("товары") <> Неопределено, "ид: Сумма, Товары");
Проверить(Ид.Получить("комментарий") = Неопределено И Ид.Получить("текст") = Неопределено, "ид: без комментариев и строк");
Проверить(Ид.Получить("поле") = Неопределено И Ид.Получить("количество") = Неопределено, "ид: без квалифицированных и вызовов");
Проверить(Ид.Получить("удалённое") = Неопределено, "ид: без #Удаление");

Корень = ПолучитьИмяВременногоФайла("t10");
Осн1 = ОбъединитьПути(Корень, "main");
Ext = ОбъединитьПути(Корень, "ext");
Записать(ОбъединитьПути(Осн1, "Documents", "Док.xml"), "<MetaDataObject><Document uuid=""d0000000-0000-0000-0000-000000000001""><Properties><Name>Док</Name></Properties>
|<ChildObjects>
|			<Attribute uuid=""a0000000-0000-0000-0000-000000000001""><Properties><Name>Сумма</Name><Type><v8:Type>xs:decimal</v8:Type></Type></Properties></Attribute>
|			<Attribute uuid=""a0000000-0000-0000-0000-000000000002""><Properties><Name>Лишний</Name><Type><v8:Type>xs:string</v8:Type></Type></Properties></Attribute>
|			<TabularSection uuid=""t0000000-0000-0000-0000-000000000001""><InternalInfo/><Properties><Name>Товары</Name></Properties><ChildObjects>
|				<Attribute uuid=""a0000000-0000-0000-0000-000000000003""><Properties><Name>Цена</Name><Type><v8:Type>xs:decimal</v8:Type></Type></Properties></Attribute>
|			</ChildObjects></TabularSection>
|</ChildObjects></Document></MetaDataObject>");
Записать(ОбъединитьПути(Осн1, "Enums", "Вид.xml"), "<MetaDataObject><Enum uuid=""e0000000-0000-0000-0000-000000000001""><Properties><Name>Вид</Name></Properties>
|<ChildObjects>
|			<EnumValue uuid=""v0000000-0000-0000-0000-000000000001""><Properties><Name>Первый</Name></Properties></EnumValue>
|			<EnumValue uuid=""v0000000-0000-0000-0000-000000000002""><Properties><Name>Второй</Name></Properties></EnumValue>
|</ChildObjects></Enum></MetaDataObject>");
ОбёрткаАд = "<MetaDataObject>
|	<%1 uuid=""%2"">
|		<Properties>
|			<ObjectBelonging>Adopted</ObjectBelonging>
|			<Name>%3</Name>
|		</Properties>
|		<ChildObjects/>
|	</%1>
|</MetaDataObject>";
Записать(ОбъединитьПути(Ext, "Documents", "Док.xml"), СтрШаблон(ОбёрткаАд, "Document", "11111111-0000-0000-0000-000000000001", "Док"));
Записать(ОбъединитьПути(Ext, "Documents/Док/Ext", "ObjectModule.bsl"), "Процедура ОбработкаПроведения(Отказ)
|	Если Сумма = 0 Тогда
|		Товары.Очистить();
|	КонецЕсли;
|	Первый = 1;
|КонецПроцедуры");
Записать(ОбъединитьПути(Ext, "Enums", "Вид.xml"), СтрШаблон(ОбёрткаАд, "Enum", "11111111-0000-0000-0000-000000000002", "Вид"));
Записать(ОбъединитьПути(Ext, "Enums/Вид/Ext", "ManagerModule.bsl"), "Функция Список() Экспорт
|	Возврат Первый;
|КонецФункции");
Записать(ОбъединитьПути(Ext, "Configuration.xml"), "<MetaDataObject><Configuration><ChildObjects>
|			<Enum>Вид</Enum>
|			<Document>Док</Document>
|</ChildObjects></Configuration></MetaDataObject>");
Корни = Новый Массив;
Корни.Добавить(ОбъединитьПути(Корень, "restored_нет"));
Корни.Добавить(Осн1);
РЗ = З.Применить(Ext, "", "Тест", Истина, Корни);
ХД = Прочитать(ОбъединитьПути(Ext, "Documents", "Док.xml"));
Проверить(СтрНайти(ХД, "<ExtendedConfigurationObject>a0000000-0000-0000-0000-000000000001<") > 0, "модули: реквизит Сумма заимствован");
Проверить(СтрНайти(ХД, "<v8:Type>xs:decimal</v8:Type>") > 0, "модули: тип реквизита");
Проверить(СтрНайти(ХД, "<Name>Лишний</Name>") = 0, "модули: неиспользуемый реквизит не заимствуется");
Проверить(СтрНайти(ХД, "<TabularSection uuid=") > 0 И СтрНайти(ХД, "<ExtendedConfigurationObject>t0000000-0000-0000-0000-000000000001<") > 0, "модули: ТЧ Товары заимствована");
Проверить(СтрНайти(ХД, "DocumentTabularSection.Док.Товары") > 0 И СтрНайти(ХД, "DocumentTabularSectionRow.Док.Товары") > 0, "модули: типы ТЧ");
Проверить(СтрНайти(ХД, "<Name>Цена</Name>") = 0, "модули: ТЧ без реквизитов");
ХЕ = Прочитать(ОбъединитьПути(Ext, "Enums", "Вид.xml"));
Проверить(СтрНайти(ХЕ, "<ExtendedConfigurationObject>v0000000-0000-0000-0000-000000000001<") > 0, "модули: значение Первый из модуля менеджера");
Проверить(СтрНайти(ХЕ, "<Name>Второй</Name>") = 0, "модули: лишнее значение не заимствуется");
// дочерние вставляются в ChildObjects объекта, а не во вложенные ChildObjects ТЧ
Записать(ОбъединитьПути(Ext, "Documents", "Док.xml"), "<MetaDataObject>
|	<Document uuid=""11111111-0000-0000-0000-000000000001"">
|		<Properties>
|			<ObjectBelonging>Adopted</ObjectBelonging>
|			<Name>Док</Name>
|		</Properties>
|		<ChildObjects>
|			<TabularSection uuid=""22222222-0000-0000-0000-000000000001"">
|				<Properties>
|					<ObjectBelonging>Adopted</ObjectBelonging>
|					<Name>Товары</Name>
|				</Properties>
|				<ChildObjects>
|					<Attribute uuid=""22222222-0000-0000-0000-000000000002"">
|						<Properties><Name>Цена</Name></Properties>
|					</Attribute>
|				</ChildObjects>
|			</TabularSection>
|			<TabularSection uuid=""22222222-0000-0000-0000-000000000003"">
|				<Properties><Name>Пустая</Name></Properties>
|				<ChildObjects/>
|			</TabularSection>
|		</ChildObjects>
|	</Document>
|</MetaDataObject>");
РЗ1 = З.Применить(Ext, "", "Тест", Истина, Корни);
ХД = Прочитать(ОбъединитьПути(Ext, "Documents", "Док.xml"));
ПозА = СтрНайти(ХД, "<Name>Сумма</Name>");
ПозТЧ = СтрНайти(ХД, "<TabularSection uuid=""22222222-0000-0000-0000-000000000001"">");
Проверить(ПозА > 0 И ПозА < ПозТЧ, "вставка: реквизит перед ТЧ на уровне объекта" + Символы.ПС + ХД);
Проверить(СтрНайти(ХД, "				<ChildObjects/>") > 0, "вставка: пустые ChildObjects ТЧ не тронуты");
Проверить(СтрЧислоВхождений(ХД, "<TabularSection uuid=") = 2, "вставка: ТЧ Товары уже есть — не дублируется");
// повторный прогон — без изменений
РЗ2 = З.Применить(Ext, "", "Тест", Истина, Корни);
Проверить(РЗ2.addedChildren.Количество() = 0, "модули: идемпотентно");
УдалитьФайлы(Корень);

Если Ошибок = 0 Тогда
	Сообщить("OK: test_task10");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;
