// ДобавлениеМетаданныхБп: реквизиты/ТЧ/колонки/значения перечислений БП со ссылками из кода restored добавляются
// в XML restored с UUID БП; без ссылок, с типом на отсутствующий тяжёлый объект, с занятым UUID — todo. Недостающие перечисления копируются из БП в restored и в Configuration.xml. Определяемый тип БП с TypeId/ValueId уже занятыми в restored под другим именем не копируется: ссылка в реквизите подменяется. У копируемого справочника узлы Form/Template и Default*Form очищаются.
Перем Ошибок;
Процедура П(У, С)
	Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли;
КонецПроцедуры
Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ПС, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
Функция Чит(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда Возврат ""; КонецЕсли;
	Т = Новый ТекстовыйДокумент; Т.Прочитать(Путь, КодировкаТекста.UTF8); Возврат Т.ПолучитьТекст();
КонецФункции
Функция Т(Н)
	Р = ""; Для Й = 1 По Н Цикл Р = Р + Символы.Таб; КонецЦикла; Возврат Р;
КонецФункции
Функция Рекв(Имя, Уид, Тип, Отступ = 3)
	О = Т(Отступ);
	Возврат О + "<Attribute uuid=""" + Уид + """>" + Символы.ПС + О + Символы.Таб + "<Properties>" + Символы.ПС
		+ О + Т(2) + "<Name>" + Имя + "</Name>" + Символы.ПС + О + Т(2) + "<Type>" + Символы.ПС + О + Т(3) + "<v8:Type>" + Тип + "</v8:Type>" + Символы.ПС
		+ О + Т(2) + "</Type>" + Символы.ПС + О + Символы.Таб + "</Properties>" + Символы.ПС + О + "</Attribute>";
КонецФункции
Функция Тч(Имя, Уид, Колонки)
	Возврат Т(3) + "<TabularSection uuid=""" + Уид + """>" + Символы.ПС + Т(4) + "<InternalInfo>" + Символы.ПС
		+ Т(5) + "<xr:GeneratedType name=""CatalogTabularSection.Ном." + Имя + """ category=""TabularSection""/>" + Символы.ПС + Т(4) + "</InternalInfo>" + Символы.ПС
		+ Т(4) + "<Properties>" + Символы.ПС + Т(5) + "<Name>" + Имя + "</Name>" + Символы.ПС + Т(4) + "</Properties>" + Символы.ПС
		+ ?(Колонки = "", Т(4) + "<ChildObjects/>", Т(4) + "<ChildObjects>" + Символы.ПС + Колонки + Символы.ПС + Т(4) + "</ChildObjects>") + Символы.ПС + Т(3) + "</TabularSection>";
КонецФункции
Функция Объект(Тег, Имя, Дети, Знач Уид = "")
	Если Уид = "" Тогда Уид = Строка(Новый УникальныйИдентификатор()); КонецЕсли;
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС + "<MetaDataObject>" + Символы.ПС + Символы.Таб + "<" + Тег + " uuid=""" + Уид + """>" + Символы.ПС
		+ Т(2) + "<Properties>" + Символы.ПС + Т(3) + "<Name>" + Имя + "</Name>" + Символы.ПС + Т(2) + "</Properties>" + Символы.ПС
		+ ?(Дети = "", Т(2) + "<ChildObjects/>", Т(2) + "<ChildObjects>" + Символы.ПС + Дети + Символы.ПС + Т(2) + "</ChildObjects>") + Символы.ПС
		+ Символы.Таб + "</" + Тег + ">" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции
Функция Знач_(Имя, Уид)
	Возврат Т(3) + "<EnumValue uuid=""" + Уид + """>" + Символы.ПС + Т(4) + "<Properties>" + Символы.ПС + Т(5) + "<Name>" + Имя + "</Name>" + Символы.ПС
		+ Т(4) + "</Properties>" + Символы.ПС + Т(3) + "</EnumValue>";
КонецФункции
Функция ОпрТип(Имя, УидОб, TypeId, ValueId)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС + "<MetaDataObject>" + Символы.ПС
		+ Символы.Таб + "<DefinedType uuid=""" + УидОб + """>" + Символы.ПС
		+ Т(2) + "<InternalInfo>" + Символы.ПС
		+ Т(3) + "<xr:GeneratedType name=""DefinedType." + Имя + """ category=""DefinedType"">" + Символы.ПС
		+ Т(4) + "<xr:TypeId>" + TypeId + "</xr:TypeId>" + Символы.ПС
		+ Т(4) + "<xr:ValueId>" + ValueId + "</xr:ValueId>" + Символы.ПС
		+ Т(3) + "</xr:GeneratedType>" + Символы.ПС + Т(2) + "</InternalInfo>" + Символы.ПС
		+ Т(2) + "<Properties>" + Символы.ПС + Т(3) + "<Name>" + Имя + "</Name>" + Символы.ПС + Т(2) + "</Properties>" + Символы.ПС
		+ Символы.Таб + "</DefinedType>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции


Ошибок = 0;
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_mdbp_" + Строка(Новый УникальныйИдентификатор));
Бп = ОбъединитьПути(Вр, "bp");
Вых = ОбъединитьПути(Вр, "out");
Осн = ОбъединитьПути(Вых, "restored");
ПС = Символы.ПС;
У1 = "aaaaaaaa-0000-0000-0000-000000000001";
// БП
Зап(ОбъединитьПути(Бп, "Catalogs", "Ном.xml"), Объект("Catalog", "Ном",
	Рекв("Общий", "aaaaaaaa-0000-0000-0000-000000000000", "xs:string") + ПС
	+ Рекв("ВидСтавки", У1, "cfg:EnumRef.Ставки") + ПС
	+ Рекв("БезСсылок", "aaaaaaaa-0000-0000-0000-000000000002", "xs:string") + ПС
	+ Рекв("НаНет", "aaaaaaaa-0000-0000-0000-000000000003", "cfg:CatalogRef.НетВОсновной") + ПС
	+ Рекв("Занятый", "aaaaaaaa-0000-0000-0000-000000000004", "xs:string") + ПС
	+ Рекв("ИзЗапроса", "aaaaaaaa-0000-0000-0000-000000000009", "xs:string") + ПС
	+ Тч("Товары", "bbbbbbbb-0000-0000-0000-000000000001", Рекв("Цена", "bbbbbbbb-0000-0000-0000-000000000002", "xs:decimal", 5) + ПС + Рекв("Колонка", "bbbbbbbb-0000-0000-0000-000000000003", "xs:string", 5)) + ПС
	+ Тч("НоваяТч", "bbbbbbbb-0000-0000-0000-000000000004", Рекв("Кол", "bbbbbbbb-0000-0000-0000-000000000005", "xs:string", 5))));
Зап(ОбъединитьПути(Бп, "Enums", "Ставки.xml"), Объект("Enum", "Ставки", Знач_("Общая", "cccccccc-0000-0000-0000-000000000001") + ПС
	+ Знач_("Новая", "cccccccc-0000-0000-0000-000000000002") + ПС + Знач_("Лишняя", "cccccccc-0000-0000-0000-000000000003")));
// restored (УП)
Зап(ОбъединитьПути(Осн, "Catalogs", "Ном.xml"), Объект("Catalog", "Ном",
	Рекв("Общий", "aaaaaaaa-0000-0000-0000-000000000000", "xs:string") + ПС
	+ Рекв("СвойУп", "aaaaaaaa-0000-0000-0000-000000000004", "xs:string") + ПС
	+ Тч("Товары", "bbbbbbbb-0000-0000-0000-000000000001", Рекв("Цена", "bbbbbbbb-0000-0000-0000-000000000002", "xs:decimal", 5))));
Зап(ОбъединитьПути(Осн, "Enums", "Ставки.xml"), Объект("Enum", "Ставки", Знач_("Общая", "cccccccc-0000-0000-0000-000000000001")));
Зап(ОбъединитьПути(Осн, "Catalogs", "Ном/Ext/ObjectModule.bsl"), "Процедура А()" + ПС + "	Х = ВидСтавки; Н = НаНет; З = Занятый;" + ПС
	+ "	// БезСсылок — только в комментарии" + ПС + "	Для Каждого С Из Товары Цикл С.Колонка = 1; КонецЦикла;" + ПС + "	НоваяТч.Очистить();" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Осн, "CommonModules", "Общ/Ext/Module.bsl"), "Процедура Б()" + ПС + "	В = Перечисления.Ставки.Новая;" + ПС
	+ "	Т = ""ВЫБРАТЬ Ном.ИзЗапроса ИЗ Справочник.Ном КАК Ном"";" + ПС + "	Л = Лишняя;" + ПС + "КонецПроцедуры" + ПС);

Уп = ОбъединитьПути(Вр, "up");
Для Каждого Ф Из СтрРазделить("Catalogs/Ном.xml,Enums/Ставки.xml", ",") Цикл
	Зап(ОбъединитьПути(Уп, Ф), Чит(ОбъединитьПути(Осн, Ф)));
КонецЦикла;
М = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ДобавлениеМетаданныхБп.os"));
Лог = Новый Массив;
Р = М.Применить(Осн, Бп, Лог, Вых);
ХН = Чит(ОбъединитьПути(Осн, "Catalogs", "Ном.xml"));
ХП = Чит(ОбъединитьПути(Осн, "Enums", "Ставки.xml"));
Csv = Чит(ОбъединитьПути(Вых, "metadata_bp_added.csv"));
П(СтрНайти(ХН, "<Attribute uuid=""" + У1 + """>") > 0 И СтрНайти(ХН, "<Name>ВидСтавки</Name>") > 0, "реквизит со ссылкой из модуля объекта добавлен с UUID БП");
П(СтрНайти(ХН, "<Name>ИзЗапроса</Name>") = 0 И СтрНайти(Csv, "ИзЗапроса;todo;нет ссылок") > 0, "реквизит только в запросе чужого модуля — todo");
П(СтрНайти(ХН, "<Name>БезСсылок</Name>") = 0 И СтрНайти(Csv, "Справочник.Ном;реквизит;БезСсылок;todo;нет ссылок из кода restored") > 0, "без ссылок — todo");
П(СтрНайти(ХН, "<Name>НаНет</Name>") = 0 И СтрНайти(Csv, "НаНет;todo;тип/ссылка: нет в restored: Catalog.НетВОсновной") > 0, "тип на отсутствующий объект — todo");
П(СтрНайти(ХН, "<Name>Занятый</Name>") = 0 И СтрНайти(Csv, "Занятый;todo;UUID уже есть") > 0, "занятый UUID — todo");
П(СтрНайти(ХН, "<Name>Колонка</Name>") > 0 И СтрНайти(ХН, "<Name>Колонка</Name>") < СтрНайти(ХН, "</TabularSection>"), "колонка ТЧ добавлена внутрь ТЧ");
П(СтрНайти(ХН, "<Name>НоваяТч</Name>") > 0 И СтрНайти(ХН, "<Name>Кол</Name>") > 0, "ТЧ добавлена целиком");
П(СтрНайти(ХН, "<Name>ВидСтавки</Name>") < СтрНайти(ХН, "<TabularSection"), "реквизит — перед ТЧ");
П(СтрНайти(ХП, "<Name>Новая</Name>") > 0 И СтрНайти(ХП, "<Name>Лишняя</Name>") = 0, "значение перечисления: Перечисления.Имя.Значение — добавлено, без квалификации — нет");
П(СтрНайти(ХН, Символы.ВК + Символы.ПС) > 0 Или СтрНайти(ХН, Символы.ПС) > 0, "текст записан");
П(Р.added = 4 И Р.skipped = 5, "счётчики: " + Р.added + "/" + Р.skipped + Символы.ПС + Csv);
// TodoMissingMetadata не показывает добавленное
Тмм = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "TodoMissingMetadata.os"));
Рт = Тмм.Сформировать(Осн, Уп, Бп, Вых, ОбъединитьПути(Вр, "нет.txt"));
CsvT = Чит(Рт.csv);
П(СтрНайти(CsvT, "БезСсылок") > 0 И СтрНайти(CsvT, ";ВидСтавки;") = 0, "todo_missing_metadata: только недобавленное");
// повтор ничего не меняет
Р2 = М.Применить(Осн, Бп, Лог, Вых);
П(Р2.added = 0 И Чит(ОбъединитьПути(Осн, "Catalogs", "Ном.xml")) = ХН, "повтор идемпотентен");
// недостающий тип-перечисление копируется из БП, регистрируется в Configuration.xml, реквизит добавляется;
// план счетов Хозрасчетный не переносится — реквизит остаётся в todo.
Зап(ОбъединитьПути(Бп, "Enums", "ТолькоБп.xml"), Объект("Enum", "ТолькоБп", Знач_("Первое", "dddddddd-0000-0000-0000-000000000001")));
Зап(ОбъединитьПути(Бп, "ChartsOfAccounts", "Хозрасчетный.xml"), Объект("ChartOfAccounts", "Хозрасчетный", ""));
Зап(ОбъединитьПути(Бп, "Catalogs", "СпрТип.xml"), Объект("Catalog", "СпрТип",
	Рекв("ВидТолькоБп", "eeeeeeee-0000-0000-0000-000000000001", "cfg:EnumRef.ТолькоБп") + ПС
	+ Рекв("СчетБанк", "eeeeeeee-0000-0000-0000-000000000002", "cfg:ChartOfAccountsRef.Хозрасчетный")));
Зап(ОбъединитьПути(Осн, "Catalogs", "СпрТип.xml"), Объект("Catalog", "СпрТип", ""));
Зап(ОбъединитьПути(Осн, "Catalogs", "СпрТип/Ext/ObjectModule.bsl"), "Процедура А()" + ПС + "	А = ВидТолькоБп; Б = СчетБанк;" + ПС + "КонецПроцедуры" + ПС);
Зап(ОбъединитьПути(Осн, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?>" + ПС
	+ "<MetaDataObject>" + ПС + Символы.Таб + "<Configuration uuid=""00000000-0000-0000-0000-000000000099"">" + ПС
	+ Т(2) + "<ChildObjects>" + ПС + Т(2) + "</ChildObjects>" + ПС + Символы.Таб + "</Configuration>" + ПС + "</MetaDataObject>" + ПС);
Лог3 = Новый Массив;
Р3 = М.Применить(Осн, Бп, Лог3, Вых);
ХС = Чит(ОбъединитьПути(Осн, "Catalogs", "СпрТип.xml"));
ХЕ = Чит(ОбъединитьПути(Осн, "Enums", "ТолькоБп.xml"));
ХК = Чит(ОбъединитьПути(Осн, "Configuration.xml"));
Csv3 = Чит(ОбъединитьПути(Вых, "metadata_bp_added.csv"));
П((Новый Файл(ОбъединитьПути(Осн, "Enums", "ТолькоБп.xml"))).Существует() И СтрНайти(ХЕ, "<Name>ТолькоБп</Name>") > 0, "перечисление только БП скопировано в restored");
П(СтрНайти(ХК, "<Enum>ТолькоБп</Enum>") > 0, "перечисление зарегистрировано в Configuration.xml");
П(СтрНайти(ХС, "<Name>ВидТолькоБп</Name>") > 0, "реквизит с типом добавленного перечисления добавлен");
П(СтрНайти(ХС, "<Name>СчетБанк</Name>") = 0, "реквизит с типом плана счетов не добавлен");
П(СтрНайти(Csv3, "СчетБанк;todo;тип/ссылка:") > 0 Или СтрНайти(Csv3, "Хозрасчетный;todo;") > 0, "план счетов / СчетБанк в todo");
П(Р3.typesAdded >= 1, "typesAdded=" + Р3.typesAdded);
П(Не (Новый Файл(ОбъединитьПути(Осн, "ChartsOfAccounts", "Хозрасчетный.xml"))).Существует(), "план счетов Хозрасчетный в restored не появился");
// тот же определяемый тип в typovaya уже есть под другим именем (общий TypeId/ValueId) — не копировать, подменить ссылку в реквизите
УидОпр = "d7a82608-8721-4f3f-93ad-93be535939ed";
ТипИдОпр = "a22d096d-429d-42ab-959d-59213ea31ca0";
ЗначИдОпр = "2556aa7d-5520-4f05-b8b6-a8b81c6a724c";
Зап(ОбъединитьПути(Осн, "DefinedTypes", "ТерриторииВыполненияРаботВОрганизации.xml"), ОпрТип("ТерриторииВыполненияРаботВОрганизации", УидОпр, ТипИдОпр, ЗначИдОпр));
Зап(ОбъединитьПути(Бп, "DefinedTypes", "ТерриторияВыполненияРаботВОрганизации.xml"), ОпрТип("ТерриторияВыполненияРаботВОрганизации", УидОпр, ТипИдОпр, ЗначИдОпр));
Зап(ОбъединитьПути(Бп, "Catalogs", "СпрАлиас.xml"), Объект("Catalog", "СпрАлиас", Рекв("РеквизитТерритория", "ffffffff-0000-0000-0000-000000000001", "cfg:DefinedType.ТерриторияВыполненияРаботВОрганизации")));
Зап(ОбъединитьПути(Осн, "Catalogs", "СпрАлиас.xml"), Объект("Catalog", "СпрАлиас", ""));
Зап(ОбъединитьПути(Осн, "Catalogs", "СпрАлиас/Ext/ObjectModule.bsl"), "Процедура А()" + ПС + "	А = РеквизитТерритория;" + ПС + "КонецПроцедуры" + ПС);
Лог4 = Новый Массив;
Р4 = М.Применить(Осн, Бп, Лог4, Вых);
ХА = Чит(ОбъединитьПути(Осн, "Catalogs", "СпрАлиас.xml"));
ХК4 = Чит(ОбъединитьПути(Осн, "Configuration.xml"));
Csv4 = Чит(ОбъединитьПути(Вых, "metadata_bp_added.csv"));
П(Не (Новый Файл(ОбъединитьПути(Осн, "DefinedTypes", "ТерриторияВыполненияРаботВОрганизации.xml"))).Существует(), "одноимённый определяемый тип БП не скопирован");
П(СтрНайти(ХК4, "<DefinedType>ТерриторияВыполненияРаботВОрганизации</DefinedType>") = 0, "алиас не регистрируется в Configuration.xml");
П(СтрНайти(ХА, "<Name>РеквизитТерритория</Name>") > 0, "реквизит с алиасом типа добавлен");
П(СтрНайти(ХА, "DefinedType.ТерриторииВыполненияРаботВОрганизации") > 0, "ссылка типа подменена на имя typovaya");
П(СтрНайти(ХА, "DefinedType.ТерриторияВыполненияРаботВОрганизации") = 0, "старое имя типа БП в реквизите не осталось");
П(СтрНайти(Csv4, "ТерриторияВыполненияРаботВОрганизации;сопоставлен;") > 0, "в отчёте тип сопоставлен, не скопирован");
// копируемый справочник: Form/Template и Default*Form вычищаются, файл форм не переносится
Зап(ОбъединитьПути(Бп, "Catalogs", "СпрСФормой.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?>" + ПС
	+ "<MetaDataObject>" + ПС + Символы.Таб + "<Catalog uuid=""aaaaaaaa-bbbb-cccc-dddd-000000000010"">" + ПС
	+ Т(2) + "<Properties>" + ПС + Т(3) + "<Name>СпрСФормой</Name>" + ПС
	+ Т(3) + "<DefaultListForm>Catalog.СпрСФормой.Form.ФормаСписка</DefaultListForm>" + ПС
	+ Т(2) + "</Properties>" + ПС + Т(2) + "<ChildObjects>" + ПС
	+ Т(3) + "<Form>ФормаСписка</Form>" + ПС + Т(3) + "<Template>Макет1</Template>" + ПС
	+ Т(2) + "</ChildObjects>" + ПС + Символы.Таб + "</Catalog>" + ПС + "</MetaDataObject>" + ПС);
Зап(ОбъединитьПути(Бп, "Catalogs", "СпрНуженТип.xml"), Объект("Catalog", "СпрНуженТип", Рекв("СсылкаНаСпр", "ffffffff-0000-0000-0000-000000000002", "cfg:CatalogRef.СпрСФормой")));
Зап(ОбъединитьПути(Осн, "Catalogs", "СпрНуженТип.xml"), Объект("Catalog", "СпрНуженТип", ""));
Зап(ОбъединитьПути(Осн, "Catalogs", "СпрНуженТип/Ext/ObjectModule.bsl"), "Процедура А()" + ПС + "	А = СсылкаНаСпр;" + ПС + "КонецПроцедуры" + ПС);
Лог5 = Новый Массив;
Р5 = М.Применить(Осн, Бп, Лог5, Вых);
ХФ = Чит(ОбъединитьПути(Осн, "Catalogs", "СпрСФормой.xml"));
ХНт = Чит(ОбъединитьПути(Осн, "Catalogs", "СпрНуженТип.xml"));
П((Новый Файл(ОбъединитьПути(Осн, "Catalogs", "СпрСФормой.xml"))).Существует(), "справочник-тип скопирован");
П(СтрНайти(ХФ, "<Form>") = 0 И СтрНайти(ХФ, "<Template>") = 0, "Form/Template из ChildObjects удалены");
П(СтрНайти(ХФ, "Form.ФормаСписка") = 0, "DefaultListForm очищен");
П(Не (Новый Файл(ОбъединитьПути(ОбъединитьПути(Осн, "Catalogs", "СпрСФормой"), "Forms", "ФормаСписка.xml"))).Существует(), "файл формы не перенесён");
П(СтрНайти(ХНт, "<Name>СсылкаНаСпр</Name>") > 0, "реквизит с типом очищенного справочника добавлен");
УдалитьФайлы(Вр);
Если Ошибок = 0 Тогда Сообщить("OK: test_metadata_bp_added"); Иначе ВызватьИсключение "test_metadata_bp_added: " + Ошибок; КонецЕсли;
