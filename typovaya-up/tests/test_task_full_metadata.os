// Task / IR: полный возврат метаданных УП→БП; AddressingAttribute — не заготовка.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Зап(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "_task_full_tmp");
Если (Новый Файл(Корень)).Существует() Тогда
	УдалитьФайлы(Корень);
КонецЕсли;
Бп = ОбъединитьПути(Корень, "bp");
Осн = ОбъединитьПути(Корень, "main");
Уп = ОбъединитьПути(Корень, "up");
СоздатьКаталог(Бп);
СоздатьКаталог(Осн);
СоздатьКаталог(Уп);

ЗаглTask = "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">"
	+ "<Task uuid=""ta-0000-0000-0000-000000000001""><InternalInfo></InternalInfo>"
	+ "<Properties><Name>ЗадачаТест</Name></Properties><ChildObjects/></Task></MetaDataObject>";
ПолнTask = "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"">"
	+ "<Task uuid=""ta-0000-0000-0000-000000000001""><InternalInfo></InternalInfo>"
	+ "<Properties><Name>ЗадачаТест</Name></Properties><ChildObjects>"
	+ "<AddressingAttribute uuid=""aa-1111""><Properties><Name>Исполнитель</Name>"
	+ "<Type><v8:Type>cfg:CatalogRef.Пользователи</v8:Type></Type></Properties></AddressingAttribute>"
	+ "</ChildObjects></Task></MetaDataObject>";

КонфШаб = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Configuration><ChildObjects>" + Символы.ПС + Символы.Таб + Символы.Таб + Символы.Таб + "</ChildObjects></Configuration>";
Зап(ОбъединитьПути(Осн, "Configuration.xml"), КонфШаб);
Зап(ОбъединитьПути(Бп, "Configuration.xml"), КонфШаб);
Зап(ОбъединитьПути(Уп, "Configuration.xml"), КонфШаб);
Зап(ОбъединитьПути(ОбъединитьПути(Осн, "Tasks"), "ЗадачаТест.xml"), ЗаглTask);
Зап(ОбъединитьПути(ОбъединитьПути(Бп, "Tasks"), "ЗадачаТест.xml"), ПолнTask);
ПутьФ1 = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Осн, "Tasks"), "ЗадачаТест"), "Forms"), "Форма1"), "Ext");
Зап(ОбъединитьПути(ПутьФ1, "Form.xml"), "<?xml version=""1.0""?><Form><was>keep</was></Form>");
ПутьФБп = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Бп, "Tasks"), "ЗадачаТест"), "Forms"), "ФормаБП");
СоздатьКаталог(ОбъединитьПути(ПутьФБп, "Ext"));
Зап(ОбъединитьПути(ПутьФБп, "Ext", "Form.xml"), "<?xml version=""1.0""?><Form><Attributes><Attribute name=""X""/></Attributes></Form>");

Ошибок = 0;
Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ЗаготовкиОбъектовБп.os"));
Заг.Инициализировать();
П(Заг.ПолныйВозвратМетаданныхУпБп("Task"), "Task — полный возврат");
П(Заг.ПутьЛогаТребуетПолногоМетаданных("Task.ЗадачаТест.AddressingAttribute.Исполнитель"), "AddressingAttribute в логе");
Кор = Заг.КорневойОбъектИзПутиЛога("Task.ЗадачаТест.AddressingAttribute.Исполнитель");
П(Кор <> Неопределено И Кор.name = "ЗадачаТест", "корень из пути лога");

Лог = Новый Массив;
ФайлДогр = ОбъединитьПути(Осн, "dogruzka.txt");
ПолучитьДвоичныеДанныеИзСтроки("Task.ЗадачаТест" + Символы.ПС, КодировкаТекста.UTF8, Ложь).Записать(ФайлДогр);
Р = Заг.ДополнитьЗаготовки(Осн, Бп, Лог, Уп, ФайлДогр, Истина);
Путь = ОбъединитьПути(ОбъединитьПути(Осн, "Tasks"), "ЗадачаТест.xml");
П((Новый Файл(Путь)).Существует(), "файл задачи");
Т = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
Тело = Т.Прочитать();
Т.Закрыть();
П(СтрНайти(Тело, "AddressingAttribute") > 0, "полное метаданные из БП");
П(СтрНайти(Тело, "Исполнитель") > 0, "адресация Исполнитель");
ПутьФормы = ОбъединитьПути(ПутьФ1, "Form.xml");
Тф = Новый ЧтениеТекста(ПутьФормы, КодировкаТекста.UTF8);
П(СтрНайти(Тф.Прочитать(), "<was>keep</was>") > 0, "Ext/Form.xml restored не перетёрт");
Тф.Закрыть();

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_task_full_metadata: " + Ошибок + " failures";
КонецЕсли;
Сообщить("test_task_full_metadata: OK");