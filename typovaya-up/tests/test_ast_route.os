// Маршрут bsparser в Сравнение: отбор изменённых по АСД, сигнатура и тело по позициям, откат на старый маршрут.
Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Функция З(Имя) Возврат ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", Имя + ".os")); КонецФункции
Функция Файл(Текст)
	Путь = ПолучитьИмяВременногоФайла("bsl");
	Зп = Новый ЗаписьТекста(Путь, "UTF-8", , , Символы.ПС);
	Зп.Записать(Текст);
	Зп.Закрыть();
	Возврат Путь;
КонецФункции
Функция Метод(М, Имя)
	Для Каждого Мт Из М.methods Цикл
		Если Мт.name = Имя Тогда
			Возврат Мт;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Ошибок = 0;
ПС = Символы.ПС;
Разбор = З("РазборМетодов");
Без = З("БезопасностьПереноса");
Синтез = З("СинтезХуков");
Синтез.Инициализировать(Разбор, Без);
Настройки = З("НастройкиСравнения");
Ср = З("Сравнение");
Ср.Инициализировать(Разбор, З("ЧтениеВыгрузки"), Настройки, Синтез, З("КонтрактМетода"), Без);
Черн = З("ЧерновикРасширения");
Черн.Инициализировать(Разбор, Настройки);
Аст = З("РазборAST");
Путь = "CommonModules\Тест\Ext\Module.bsl";

Сиг = "Процедура Многострочная(Парам1," + ПС + "	Знач Парам2 = 0) Экспорт";
Тип = "	Х = 1;" + ПС + "	Если Х = 1 Тогда" + ПС + "		Х = 2;" + ПС;
Хв = "	КонецЕсли;" + ПС + "	Сообщить(Х);" + ПС + "КонецПроцедуры" + ПС + ПС;
БП = "Перем А;" + ПС + ПС + Сиг + ПС + Тип + Хв
	+ "Процедура ТолькоКомментарии()" + ПС + "	Б = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура СменаСигнатуры()" + ПС + "	Б = 1;" + ПС + "КонецПроцедуры" + ПС;
УП = "// комментарий вне методов" + ПС + "Перем А;" + ПС + ПС + Сиг + ПС + Тип
	+ "		// УП_начало" + ПС + "		Х = 3;" + ПС + "		// УП_конец" + ПС + Хв
	+ "Процедура ТолькоКомментарии()" + ПС + "	// АПК:565-выкл" + ПС + "	Б   =" + ПС + "  1; // коммент" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура СменаСигнатуры(ПарамУП) Экспорт" + ПС + "	Б = 1;" + ПС + "КонецПроцедуры" + ПС
	+ "Процедура НоваяУП()" + ПС + "КонецПроцедуры" + ПС;
ФБ = Файл(БП);
ФУ = Файл(УП);

// старый маршрут — без пометок bsparser
М0 = Ср.СравнитьМодуль(Путь, ФУ, ФБ);
П(Не М0.Свойство("parser"), "старый маршрут не помечен parser");

Ср.ВключитьBsparser(Аст);
М = Ср.СравнитьМодуль(Путь, ФУ, ФБ);
П(М.parser = "bsparser", "модуль сравнён по АСД " + ?(М.Свойство("parserErrors"), СтрСоединить(М.parserErrors, "; "), ""));
П(Не М.outsideDiffers, "комментарий вне методов не отличие");
Мт = Метод(М, "Многострочная");
П(Мт <> Неопределено И Мт.status = "changed" И Мт.hook = "changeAndControl" И Мт.hookDecision = "auto", "ИиК для вставки внутри тела");
П(Мт <> Неопределено И Мт.signatureText = Сиг, "сигнатура типовой байт в байт из АСД");
П(Метод(М, "ТолькоКомментарии").status = "same", "комментарии/АПК/переносы — не изменение");
Мс = Метод(М, "СменаСигнатуры");
П(Мс.status = "changed" И Мс.hookDecision = "manual" И Мс.changeReason = "signature", "смена сигнатуры -> ручной разбор");
П(Метод(М, "НоваяУП").status = "added", "новый метод УП");
П(М.counts.same = 1 И М.counts.changed = 2 И М.counts.added = 1 И М.counts.removed = 0, "счётчики");
П(М.bucket = "manual", "корзина manual из-за смены сигнатуры");

П(Мт.vendorText = Сиг + ПС + Тип + "	КонецЕсли;" + ПС + "	Сообщить(Х);" + ПС + "КонецПроцедуры", "текст типового метода по позициям модуля байт в байт");

// только изменённые/новые методы идут в bsparser
До = Ср.СтатистикаBsparser().fragments;
Ср.СравнитьМодуль(Путь, Файл("Процедура А()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС + "Процедура Б()" + ПС + "	Х = 2;" + ПС + "КонецПроцедуры"),
	Файл("Процедура А()" + ПС + "	Х = 1;" + ПС + "КонецПроцедуры" + ПС + "Процедура Б()" + ПС + "	Х = 3;" + ПС + "КонецПроцедуры"));
П(Ср.СтатистикаBsparser().fragments - До = 2, "в bsparser только фрагменты изменённого метода");
П(Ср.ОтчетBsparser().Количество() >= 2, "строки отчёта времени");
ТФ = "Перем А;" + ПС + "Процедура Х()" + ПС + "	А = 1;" + ПС + "КонецПроцедуры";
ПозФ = СтрНайти(ТФ, "Процедура");
РФ = Аст.РазобратьМетодФрагмента(Сред(ТФ, ПозФ), 2, ПозФ);
МФ = РФ.method;
П(РФ.ok И МФ.sigStart.line = 2 И Сред(ТФ, МФ.declStart.pos, МФ.end.pos - МФ.declStart.pos + 1) = Сред(ТФ, ПозФ)
	И Сред(ТФ, МФ.bodyStart, МФ.bodyEnd - МФ.bodyStart + 1) = МФ.bodyText, "позиции фрагмента в координатах модуля");
П(Не Аст.РазобратьМетодФрагмента("Процедура Х()" + ПС + "КонецПроцедуры" + ПС + "Процедура Y()" + ПС + "КонецПроцедуры", 1, 1).ok, "фрагмент с двумя методами -> ошибка");

Т = Черн.ОтрисоватьМетод("УП_", Мт);
П(СтрНачинаетсяС(Т, "&ИзменениеИКонтроль(""Многострочная"")" + ПС + "Процедура УП_Многострочная(Парам1," + ПС + "	Знач Парам2 = 0) Экспорт" + ПС), "заголовок хука: сигнатура типовой один раз " + Т);
П(СтрЧислоВхождений(Т, "Процедура УП_Многострочная") = 1, "сигнатура ровно одна");
П(СтрНайти(Т, ПС + "#Вставка" + ПС + "		// УП_начало" + ПС + "		Х = 3;" + ПС + "		// УП_конец" + ПС + "#КонецВставки" + ПС) > 0, "#Вставка охватывает УП_начало…УП_конец, директивы с колонки 0");
П(СтрНайти(Т, ПС + "	Если Х = 1 Тогда" + ПС + "		Х = 2;" + ПС) > 0, "типовой текст с табами байт в байт");
Пр = Аст.ПроверитьХук(Т);
П(Пр.ok, "хук проходит контроль bsparser " + СтрСоединить(Пр.problems, "; "));

// только косметика по АСД -> cosmetic
М2 = Ср.СравнитьМодуль(Путь, Файл("Перем А;" + ПС + "Процедура Х()" + ПС + "	А = 1; // АПК:1" + ПС + "КонецПроцедуры"),
	Файл("Перем А;" + ПС + "Процедура Х()" + ПС + "	А" + ПС + "	= 1;" + ПС + "КонецПроцедуры"));
П(М2.bucket = "cosmetic", "только форматирование -> cosmetic " + М2.bucket);
М4 = Ср.СравнитьМодуль(Путь, Файл("Перем А, Б;" + ПС + "Процедура Х()" + ПС + "КонецПроцедуры"), Файл("Перем А;" + ПС + "Процедура Х()" + ПС + "КонецПроцедуры"));
П(М4.outsideDiffers И М4.bucket = "manual", "код вне методов отличается");
// только #Область/#КонецОбласти вне методов — не отличие
ОбБП = "#Область ПрограммныйИнтерфейс" + ПС + "Перем А;" + ПС + "Процедура Х()" + ПС + "	А = 1;" + ПС + "КонецПроцедуры" + ПС + "#КонецОбласти";
ОбУП = "#Область СлужебныйПрограммныйИнтерфейс" + ПС + "#Область Вложенная" + ПС + "Перем А;" + ПС + "#КонецОбласти" + ПС + "Процедура Х()" + ПС + "	А = 1;" + ПС
	+ "	// УП_начало" + ПС + "	А = 2;" + ПС + "	// УП_конец" + ПС + "КонецПроцедуры" + ПС + "#КонецОбласти";
М5 = Ср.СравнитьМодуль(Путь, Файл(ОбУП), Файл(ОбБП));
П(Не М5.outsideDiffers И М5.bucket = "auto", "только области вне методов -> не отличие, auto " + М5.bucket + " " + М5.reason);
М6 = Ср.СравнитьМодуль(Путь, Файл("#Область А" + ПС + "Процедура Х()" + ПС + "КонецПроцедуры" + ПС + "#КонецОбласти"), Файл("Процедура Х()" + ПС + "КонецПроцедуры"));
П(М6.bucket = "cosmetic", "только области -> cosmetic " + М6.bucket);
М7 = Ср.СравнитьМодуль(Путь, Файл("#Если Сервер Тогда" + ПС + "Процедура Х()" + ПС + "КонецПроцедуры" + ПС + "#КонецЕсли"), Файл("Процедура Х()" + ПС + "КонецПроцедуры"));
П(М7.outsideDiffers И М7.bucket = "manual", "#Если вне методов — отличие");
П(Ср.ВнеМетодовБезОбластей("#Область А" + ПС + "Перем Б;" + ПС + "#КонецОбласти") = "Перем Б;", "ВнеМетодовБезОбластей");
// удалённые в УП методы БП: не блокируют без новых методов УП и обработчиков
БПУ = "Процедура Х()" + ПС + "	А = 1;" + ПС + "КонецПроцедуры" + ПС + "Процедура ТолькоБП()" + ПС + "	Б = 1;" + ПС + "КонецПроцедуры";
УПВ = "Процедура Х()" + ПС + "	А = 1;" + ПС + "	// УП_начало" + ПС + "	А = 2;" + ПС + "	// УП_конец" + ПС + "КонецПроцедуры";
М9 = Ср.СравнитьМодуль(Путь, Файл(УПВ), Файл(БПУ));
П(М9.counts.removed = 1 И М9.bucket = "auto" И СтрНайти(М9.reason, "только в БП") > 0, "удалённый не обработчик -> auto " + М9.bucket + " " + М9.reason);
М10 = Ср.СравнитьМодуль(Путь, Файл(УПВ + ПС + "Процедура НоваяУП()" + ПС + "КонецПроцедуры"), Файл(БПУ));
П(М10.bucket = "manual" И СтрНайти(М10.reason, "переименование") > 0, "удалённый + новый метод УП -> manual " + М10.reason);
М11 = Ср.СравнитьМодуль("Catalogs\Т\Ext\ObjectModule.bsl", Файл(УПВ), Файл(БПУ + ПС + "Процедура ПередЗаписью(Отказ)" + ПС + "	Б = 2;" + ПС + "КонецПроцедуры"));
П(М11.bucket = "manual" И СтрНайти(М11.reason, "ПередЗаписью") > 0, "удалён обработчик события -> manual " + М11.reason);
М12 = Ср.СравнитьМодуль("Catalogs\Т\Forms\Ф\Ext\Form\Module.bsl", Файл(УПВ), Файл(БПУ));
П(М12.bucket = "manual", "удалённый метод модуля формы -> manual " + М12.bucket);
М13 = Ср.СравнитьМодуль(Путь, Файл("Процедура Х()" + ПС + "	А = 1;" + ПС + "КонецПроцедуры"), Файл(БПУ));
П(М13.bucket = "cosmetic" И СтрНайти(М13.reason, "Доработок УП нет") > 0, "только удалённые -> без ручного разбора " + М13.bucket);
КатМ = ОбъединитьПути(КаталогВременныхФайлов(), "tu_meta_" + Строка(Новый УникальныйИдентификатор));
СоздатьКаталог(ОбъединитьПути(КатМ, "EventSubscriptions"));
Зп = Новый ЗаписьТекста(ОбъединитьПути(КатМ, "EventSubscriptions", "П.xml"), "UTF-8");
Зп.Записать("<MetaDataObject><EventSubscription><Properties><Handler>CommonModule.Тест.ТолькоБП</Handler></Properties></EventSubscription></MetaDataObject>");
Зп.Закрыть();
Обр = Ср.СобратьОбработчикиМетаданных(КатМ);
П(Обр.Получить(НРег("CommonModules\Тест\Ext\Module.bsl|ТолькоБП")) <> Неопределено, "обработчик подписки из метаданных");
П(Ср.СобратьОбработчикиМетаданных(ОбъединитьПути(КатМ, "нет")).Количество() = 0, "нет каталога -> пусто");
П(Ср.МаркерВнутриСтроки("Т = ""ВЫБРАТЬ" + ПС + "#Вставка" + ПС + "	|	А," + ПС + "#КонецВставки" + ПС + "	|	Б"";") , "маркер внутри текста запроса");
П(Не Ср.МаркерВнутриСтроки("Т = ""ВЫБРАТЬ"" + """"""""; // ""не строка" + ПС + "#Вставка" + ПС + "	А = 1;" + ПС + "#КонецВставки"), "маркер вне строки, кавычки и комментарий");
ЗБП = "Функция Т()" + ПС + "	Т = ""ВЫБРАТЬ" + ПС + "	|	А," + ПС + "	|	Б"";" + ПС + "	Возврат Т;" + ПС + "КонецФункции";
ЗУП = "Функция Т()" + ПС + "	Т = ""ВЫБРАТЬ" + ПС + "	|	А," + ПС + "	|	В," + ПС + "	|	Б"";" + ПС + "	Возврат Т;" + ПС + "КонецФункции";
М8 = Ср.СравнитьМодуль(Путь, Файл(ЗУП), Файл(ЗБП));
П(Метод(М8, "Т").hookDecision = "manual" И СтрНайти(Метод(М8, "Т").explain, "многострочной") > 0 И М8.bucket = "manual", "ИиК с маркером в тексте запроса -> manual " + Метод(М8, "Т").hookDecision + " " + Метод(М8, "Т").explain);

// ошибка разбора -> откат на старый маршрут
М3 = Ср.СравнитьМодуль(Путь, Файл(УП + "Процедура Сломанная(" + ПС), ФБ);
П(М3.parser = "fallback" И М3.parserErrors.Количество() > 0 И М3.bucket <> "", "откат на старый маршрут с ошибками разбора");

// тело по позициям
П(Ср.СтрокиТелаAST(ПС + "	А = 1;" + ПС + "	Б = 2;" + ПС + "	") = "	А = 1;" + ПС + "	Б = 2;", "СтрокиТелаAST: строки между сигнатурой и концом");
П(Ср.СтрокиТелаAST(" ") = "", "СтрокиТелаAST: пустое тело");

Если Ошибок = 0 Тогда Сообщить("OK: ast route"); Иначе ЗавершитьРаботу(1); КонецЕсли;