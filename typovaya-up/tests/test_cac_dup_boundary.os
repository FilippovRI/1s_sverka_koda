Перем Ошибок, Корень, Син;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Функция БезХвоста(Знач С)
	Пока СтрДлина(С) > 0 Цикл
		Посл = КодСимвола(Прав(С, 1));
		Если Посл = 10 Или Посл = 13 Тогда
			С = Лев(С, СтрДлина(С) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат С;
КонецФункции

Функция Норм(Знач С)
	С = СтрЗаменить(С, Символ(13) + Символ(10), Символы.ПС);
	С = СтрЗаменить(С, Символ(13), Символы.ПС);
	Возврат БезХвоста(С);
КонецФункции

Функция ПрочитатьФикстуру(Имя)
	Путь = ОбъединитьПути(ОбъединитьПути(Корень, "tests"), "fixtures");
	Путь = ОбъединитьПути(ОбъединитьПути(Путь, "cac_dup"), Имя);
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Если С = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Норм(С);
КонецФункции

Процедура ПроверитьСлучай(Имя, Тип, Уп)
	Пр = Син.ПредложитьХук(Тип, Уп);
	П(Пр.hook = "changeAndControl" Или Пр.hook = "changeAndControlFull", Имя + " hook=" + Пр.hook);
	Если Пр.hook <> "changeAndControl" И Пр.hook <> "changeAndControlFull" Тогда
		Возврат;
	КонецЕсли;
	База = Норм(Син.ВосстановитьБазовыйТекстТиповогоИзХука(Пр.hookBody));
	Если База <> Тип Тогда
		Сообщить("FAIL: " + Имя + " vendor != typovaya");
		Ошибок = Ошибок + 1;
		ЛТ = СтрРазделить(Тип, Символы.ПС, Истина);
		ЛБ = СтрРазделить(База, Символы.ПС, Истина);
		М = ЛТ.Количество();
		Если ЛБ.Количество() < М Тогда
			М = ЛБ.Количество();
		КонецЕсли;
		Й = 0;
		Пока Й < М Цикл
			Если ЛТ[Й] <> ЛБ[Й] Тогда
				Сообщить("  first diff line " + (Й + 1) + " typ=[" + ЛТ[Й] + "] recon=[" + ЛБ[Й] + "]");
				Возврат;
			КонецЕсли;
			Й = Й + 1;
		КонецЦикла;
		Сообщить("  lengths typ=" + ЛТ.Количество() + " recon=" + ЛБ.Количество());
	КонецЕсли;
	ДирОк = Истина;
	Для Каждого Стр Из СтрРазделить(Пр.hookBody, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если С = "#Вставка" Или С = "#КонецВставки" Или С = "#Удаление" Или С = "#КонецУдаления" Тогда
			Если Стр <> С Тогда
				ДирОк = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	П(ДирОк, Имя + " preprocessor at column 0");
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Раз = ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "РазборМетодов.os"));
Син = ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "СинтезХуков.os"));
Син.Инициализировать(Раз, ЗагрузитьСценарий(ОбъединитьПути(ОбъединитьПути(Корень, "src"), "БезопасностьПереноса.os")));
Ошибок = 0;

Тип = Т("	Результат = Новый Структура(|		""Первое"",|		""Второе"");|	След = 1;");
Уп = Т("	Результат = Новый Структура(|		""ПервоеУП"",|		""ВтороеУП"");|	След = 1;");
ПроверитьСлучай("synthetic", Тип, Уп);

ПроверитьСлучай("edo", ПрочитатьФикстуру("edo_bp.bsl"), ПрочитатьФикстуру("edo_up.bsl"));
ПроверитьСлучай("insure", ПрочитатьФикстуру("insure_bp.bsl"), ПрочитатьФикстуру("insure_up.bsl"));
ПроверитьСлучай("sedo", ПрочитатьФикстуру("sedo_bp.bsl"), ПрочитатьФикстуру("sedo_up.bsl"));

Если Ошибок = 0 Тогда
	Сообщить("OK: CAC dup boundary");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;