Перем Ошибок, Корень;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Пр = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ПроверкаСсылокКонфигурации.os"));
Ошибок = 0;
Уп = Пр.ИменаОбщихМодулейВыгрузки(ОбъединитьПути(Корень, "tests", "fixtures", "UP"));
Тело = "ЗарплатаКадрыКлиентВнутренний.М();";
П(Пр.ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Тело, Уп) > 0, "missing ref");
Тело2 = "ХукНабор.М();";
П(Пр.ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Тело2, Уп) = 0, "existing ref");

Если Ошибок = 0 Тогда Сообщить("OK: restored refs"); Иначе ЗавершитьРаботу(1); КонецЕсли;
