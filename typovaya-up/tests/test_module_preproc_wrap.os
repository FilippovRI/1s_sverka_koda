// Обёртка #Если…#КонецЕсли на весь модуль: разбор, restored, расширение, отчёт, без дубля.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Процедура УдалитьКаталогТихо(Путь)
	Попытка
		УдалитьФайлы(Путь);
	Исключение
	КонецПопытки;
КонецПроцедуры

Функция ПрочитатьМодуль(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Ошибок = 0;
Дир = "#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда";

// 1. Целый модуль обёрнут — обёртка находится.
Мод = Т(Дир + "|Процедура ЗаписатьНачисление(Описание)|	А = 1;|КонецПроцедуры|#КонецЕсли|");
Об = Разбор.НайтиОбёрткуМодуля(Мод);
П(Об.Есть, "модуль: обёртка найдена");
П(СокрЛП(Об.Начало) = Дир, "модуль: директива: " + Об.Начало);
П(СокрЛП(Об.Конец) = "#КонецЕсли", "модуль: #КонецЕсли");

// 2. Комментарий перед #Если — всё ещё обёртка модуля.
Мод2 = Т("// заголовок||" + Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|");
П(Разбор.НайтиОбёрткуМодуля(Мод2).Есть, "комментарий до #Если");

// 3. Два метода внутри одной обёртки модуля — это обёртка модуля, не индивидуальная.
Мод3 = Т(Дир + "|Процедура А()|КонецПроцедуры||Процедура Б()|КонецПроцедуры|#КонецЕсли");
Раз3 = Разбор.РазобратьМодуль(Мод3);
П(Раз3.Методы.Количество() = 2, "два метода");
П(Раз3.Методы[0].ОбёрткаНачало = "" И Раз3.Методы[1].ОбёрткаНачало = "", "нет индивидуальной обёртки");
П(Разбор.НайтиОбёрткуМодуля(Мод3).Есть, "обёртка модуля на два метода");

// 4. Код после #КонецЕсли — не обёртка всего модуля.
Мод4 = Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли||Процедура Б()|КонецПроцедуры|");
П(Не Разбор.НайтиОбёрткуМодуля(Мод4).Есть, "код после #КонецЕсли");

// 5. Два отдельных блока #Если — не обёртка модуля.
Мод5 = Т("#Если Сервер Тогда|Процедура А()|КонецПроцедуры|#КонецЕсли||#Если Клиент Тогда|Процедура Б()|КонецПроцедуры|#КонецЕсли|");
П(Не Разбор.НайтиОбёрткуМодуля(Мод5).Есть, "два отдельных #Если");

// 6. Наложение на модуль без обёртки.
Тело = Т("Процедура ЗаписатьНачисление(Описание)|	А = 1;|КонецПроцедуры|");
Собр = Разбор.ПрименитьОбёрткуМодуля(Тело, Дир, "#КонецЕсли");
П(СтрНачинаетсяС(Собр, Дир + Символы.ПС), "наложение: префикс");
П(СтрНайти(Собр, "Процедура ЗаписатьНачисление") > 0, "наложение: тело");
П(СтрНайти(Собр, "#КонецЕсли") > 0, "наложение: суффикс");

// 7. Повторно ту же обёртку не дублировать.
Собр2 = Разбор.ПрименитьОбёрткуМодуля(Собр, Дир, "#КонецЕсли");
П(Собр2 = Собр, "без дубля");
П(СтрЧислоВхождений(Собр2, Дир) = 1 И СтрЧислоВхождений(Собр2, "#КонецЕсли") = 1, "ровно одна пара");

// 8. Другую внешнюю обёртку заменить на типовую, внутреннюю не трогать.
Мод8 = Т("#Если Сервер Тогда|Процедура А()|#Если Клиент Тогда|	К = 1;|#КонецЕсли|КонецПроцедуры|#КонецЕсли|");
Зам8 = Разбор.ПрименитьОбёрткуМодуля(Мод8, Дир, "#КонецЕсли");
П(СтрНачинаетсяС(СокрЛ(Зам8), Дир), "замена внешней: новая директива");
П(СтрНайти(Зам8, "#Если Сервер Тогда") = 0, "замена внешней: старая убрана");
П(СтрНайти(Зам8, "#Если Клиент Тогда") > 0, "замена внешней: внутренняя на месте");
П(СтрЧислоВхождений(Зам8, "#КонецЕсли") = 2, "замена внешней: два #КонецЕсли");

// 9. Черновик: restored и extension получают обёртку, отчёт пишется, дубля нет.
К = ПолучитьИмяВременногоФайла();
УдалитьКаталогТихо(К);
СоздатьКаталог(К);
КореньУп = ОбъединитьПути(К, "up");
Выход = ОбъединитьПути(К, "out");
СоздатьКаталог(КореньУп);
ПутьМ = "ChartsOfCalculationTypes\Начисления\Ext\ManagerModule.bsl";
ТелоУп = Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры||Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры|");
ТелоБп = Т(Дир + "|Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры||Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры|#КонецЕсли|");
МтРаб = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, insteadAppendContinue, explain",
	"Рабочая", "Процедура", "changed",
	Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры"),
	Т("Процедура Рабочая()|	Типовой = 1;|КонецПроцедуры"),
	"changeAndControl", "auto",
	Т("#Удаление|	Типовой = 1;|#КонецУдаления|#Вставка|	Типовой = 2;|#КонецВставки"),
	Ложь, "");
МтНач = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"ЗаписатьНачисление", "Процедура", "same",
	Т("Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры"),
	Т("Процедура ЗаписатьНачисление(Описание)|	Н = 1;|КонецПроцедуры"),
	"none", "skip", "", "");
М = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
	ПутьМ, "ChartOfCalculationTypes", "ChartOfCalculationTypes.Начисления", "manual", "",
	ТелоБп, ТелоУп, Истина, Новый Массив, Новый Структура("same, changed, added, removed", 1, 1, 0, 0));
М.methods.Добавить(МтРаб);
М.methods.Добавить(МтНач);
Модули = Новый Массив;
Модули.Добавить(М);
Лог = Новый Массив;
Ч.Записать(Модули, КореньУп, Выход, "УП_Доработки", "УП_", Лог);
ПутьВосст = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход, "restored", "ChartsOfCalculationTypes"), "Начисления", "Ext"), "ManagerModule.bsl");
ПутьРасш = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход, "extension", "ChartsOfCalculationTypes"), "Начисления", "Ext"), "ManagerModule.bsl");
ПутьОтч = ОбъединитьПути(Выход, "module_preproc_wrap.json");
П((Новый Файл(ПутьВосст)).Существует(), "есть restored");
П((Новый Файл(ПутьРасш)).Существует(), "есть extension");
П((Новый Файл(ПутьОтч)).Существует(), "есть module_preproc_wrap.json");
ТВосст = ПрочитатьМодуль(ПутьВосст);
ТРасш = ПрочитатьМодуль(ПутьРасш);
Отч = ПрочитатьМодуль(ПутьОтч);
П(Разбор.НайтиОбёрткуМодуля(ТВосст).Есть, "restored: обёртка модуля");
П(СтрНачинаетсяС(СокрЛ(ТВосст), Дир), "restored: директива в начале");
П(СтрНайти(ТВосст, "Процедура ЗаписатьНачисление") > 0, "restored: метод на месте");
П(СтрЧислоВхождений(ТВосст, Дир) = 1, "restored: без дубля");
П(Разбор.НайтиОбёрткуМодуля(ТРасш).Есть, "extension: обёртка модуля");
П(СтрНайти(ТРасш, Дир) > 0, "extension: директива");
П(СтрНайти(ТРасш, "&ИзменениеИКонтроль(""Рабочая"")") > 0, "extension: хук внутри обёртки");
П1 = СтрНайти(ТРасш, Дир);
П2 = СтрНайти(ТРасш, "&ИзменениеИКонтроль(""Рабочая"")");
П3 = СтрНайти(ТРасш, "#КонецЕсли", НаправлениеПоиска.СКонца);
П(П1 > 0 И П1 < П2 И П2 < П3, "extension: хук внутри #Если");
П(СтрНайти(Отч, """count"":") > 0, "отчёт count: " + Отч);
П(СтрНайти(Отч, "Начисления") > 0, "отчёт path");
П(СтрНайти(Отч, "restored") > 0 И СтрНайти(Отч, "extension") > 0, "отчёт targets");
П(СтрНайти(Отч, "Сервер Или ТолстыйКлиентОбычноеПриложение") > 0, "отчёт directive");

// 10. Повторная запись того же restored не дублирует; модуль только с обёрткой тоже пишется.
МТолько = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
	"Catalogs\Банки\Ext\ObjectModule.bsl", "Catalog", "Catalog.Банки", "manual", "",
	Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|"),
	Т("Процедура А()|КонецПроцедуры|"),
	Истина, Новый Массив, Новый Структура("same, changed, added, removed", 1, 0, 0, 0));
МТолько.methods.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"А", "Процедура", "same", Т("Процедура А()|КонецПроцедуры"), Т("Процедура А()|КонецПроцедуры"), "none", "skip", "", ""));
Модули2 = Новый Массив;
Модули2.Добавить(МТолько);
Выход2 = ОбъединитьПути(К, "out2");
Ч.Записать(Модули2, КореньУп, Выход2, "УП_Доработки", "УП_", Новый Массив);
ПутьТолько = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход2, "restored", "Catalogs"), "Банки", "Ext"), "ObjectModule.bsl");
П((Новый Файл(ПутьТолько)).Существует(), "wrap-only: restored записан");
ТТолько = ПрочитатьМодуль(ПутьТолько);
П(Разбор.НайтиОбёрткуМодуля(ТТолько).Есть И СтрЧислоВхождений(ТТолько, Дир) = 1, "wrap-only: одна обёртка");
П(Не (Новый Файл(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход2, "extension", "Catalogs"), "Банки", "Ext"), "ObjectModule.bsl"))).Существует(), "wrap-only: без пустого extension");
Отч2 = ПрочитатьМодуль(ОбъединитьПути(Выход2, "module_preproc_wrap.json"));
П(СтрНайти(Отч2, "restored") > 0 И СтрНайти(Отч2, "Банки") > 0, "wrap-only: отчёт");

// 11. Уже обёрнутый УП — restored не получает вторую обёртку, в отчёт не попадает как добавление, если текст не менялся.
МУже = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
	"Catalogs\Уже\Ext\ObjectModule.bsl", "Catalog", "Catalog.Уже", "manual", "",
	Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|"),
	Т(Дир + "|Процедура А()|КонецПроцедуры|#КонецЕсли|"),
	Ложь, Новый Массив, Новый Структура("same, changed, added, removed", 1, 0, 0, 0));
МУже.methods.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"А", "Процедура", "same", "", "", "none", "skip", "", ""));
Модули3 = Новый Массив;
Модули3.Добавить(МУже);
Выход3 = ОбъединитьПути(К, "out3");
Ч.Записать(Модули3, КореньУп, Выход3, "УП_Доработки", "УП_", Новый Массив);
П(Не (Новый Файл(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Выход3, "restored", "Catalogs"), "Уже", "Ext"), "ObjectModule.bsl"))).Существует(), "уже есть обёртка: restored не пишется зря");
Отч3 = ПрочитатьМодуль(ОбъединитьПути(Выход3, "module_preproc_wrap.json"));
П(СтрНайти(Отч3, """count"": 0") > 0 Или СтрНайти(Отч3, """count"":0") > 0, "уже есть обёртка: count=0: " + Отч3);

УдалитьКаталогТихо(К);

Если Ошибок = 0 Тогда
	Сообщить("OK: module preproc wrap");
Иначе
	ЗавершитьРаботу(1);
КонецЕсли;