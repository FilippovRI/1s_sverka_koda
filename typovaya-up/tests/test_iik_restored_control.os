// Регрессия: &ИзменениеИКонтроль — имя метода в расширении с префиксом УП_
// (иначе «уже определена»), типовые вызовы в теле вне #Вставка без префикса.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция Т(З)
	Возврат СтрЗаменить(З, "|", Символы.ПС);
КонецФункции

Каталог = ТекущийСценарий().Каталог;
Корень = ОбъединитьПути(Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Настройки = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ч.Инициализировать(Разбор, Настройки);
Доз = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ДозаполнениеМодуля.os"));
Ошибок = 0;

Мт = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody, explain",
	"П", "Процедура", "changed",
	"Процедура П()" + Символы.ПС + "	Хелпер();" + Символы.ПС + "КонецПроцедуры",
	"", "changeAndControl", "auto",
	"#Удаление" + Символы.ПС + "	Хелпер();" + Символы.ПС + "#КонецУдаления" + Символы.ПС
	+ "#Вставка" + Символы.ПС + "	Хелпер();" + Символы.ПС + "	Доп = 1;" + Символы.ПС + "#КонецВставки",
	"");
Р = Ч.ОтрисоватьМетод("УП_", Мт);
Проверить(СтрНайти(Р, "&ИзменениеИКонтроль(""П"")") > 0, "есть аннотация ИиК");
Проверить(СтрНайти(Р, "Процедура УП_П()") > 0, "ИиК ставит префикс УП_ (уникальное имя в расширении)");
Проверить(СтрНайти(Р, "&ИзменениеИКонтроль(""П"")") > 0, "аннотация ссылается на typovaya-имя");

Переим = Новый Соответствие;
Переим.Вставить("Хелпер", "УП_Хелпер");
Модуль = Т("&ИзменениеИКонтроль(""П"")|Процедура П()|#Удаление|	Хелпер();|#КонецУдаления|#Вставка|	Хелпер();|	Доп = 1;|#КонецВставки|КонецПроцедуры||&Вместо(""Хелпер"")|Процедура УП_Хелпер()|	ПродолжитьВызов();|КонецПроцедуры");
Нов = Доз.ПереписатьЛокальныеВызовыСУчетомИиК(Модуль, Переим);
Проверить(СтрНайти(Нов, "#Удаление" + Символы.ПС + "	Хелпер();") > 0, "в типовом теле ИиК вызов Хелпер не префиксируется");
Проверить(СтрНайти(Нов, "#Вставка" + Символы.ПС + "	УП_Хелпер();") > 0, "в #Вставка вызов хелпера &Вместо можно префиксировать");
Проверить(СтрНайти(Нов, "Процедура П()") > 0 И СтрНайти(Нов, "Процедура УП_П()") = 0, "переписчик не меняет имя метода ИиК");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_restored_control");
Иначе
	Сообщить("FAILED test_iik_restored_control: " + Ошибок);
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));