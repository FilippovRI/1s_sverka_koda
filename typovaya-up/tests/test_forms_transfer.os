Перем Ошибок, Корень;

Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры

Функция ТекстФайла(П)
	Т = Новый ТекстовыйДокумент; Т.Прочитать(П); Возврат Т.ПолучитьТекст();
КонецФункции

Функция КонтрольнаяСуммаФикстур()
	Ф = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "tests"), "fixtures"), "UP"), "Documents"), "Счет");
	Ф = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Ф, "Forms"), "ФормаДокумента"), "Ext");
	Возврат ТекстФайла(ОбъединитьПути(Ф, "Form.xml"));
КонецФункции

Процедура ЗаписатьТ(Путь, Текст)
	Тд = Новый ТекстовыйДокумент; Тд.УстановитьТекст(Текст); Тд.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

Процедура Скопировать(Откуда, Куда)
	Кат = Новый Файл(Куда).Путь;
	Если Не (Новый Файл(Кат)).Существует() Тогда СоздатьКаталог(Кат); КонецЕсли;
	КопироватьФайл(Откуда, Куда);
КонецПроцедуры

Функция БлокУПДопПоле(КвДлина, КвДоп)
	Б = "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>xs:string</v8:Type>";
	Д = "Variable";
	Если КвДоп = "fixed" Тогда Д = "Fixed"; ИначеЕсли КвДоп = "any" Тогда Д = "Any"; КонецЕсли;
	Б = Б + "<v8:StringQualifiers><v8:Length>" + КвДлина + "</v8:Length><v8:AllowedLength>" + Д + "</v8:AllowedLength></v8:StringQualifiers>";
	Б = Б + "</Type><DataPath>Объект.УПДопПоле</DataPath></Attribute>";
	Возврат Б;
КонецФункции

Процедура СоздатьДеревоПереноса(База, ИсхКорень, ПостКорень, СтрокаВМодуль, КвДлина, КвДоп, ChildUi)
	Рел = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути("Documents", "Счет"), "Forms"), "ФормаДокумента"), "Ext");
	ПУП = ОбъединитьПути(ОбъединитьПути(База, "UP"), Рел);
	ПБП = ОбъединитьПути(ОбъединитьПути(База, "BP"), Рел);
	СоздатьКаталог(ОбъединитьПути(ПУП, "Form"));
	СоздатьКаталог(ОбъединитьПути(ПБП, "Form"));
	Скопировать(ОбъединитьПути(ОбъединитьПути(ИсхКорень, Рел), "Form.xml"), ОбъединитьПути(ПУП, "Form.xml"));
	Скопировать(ОбъединитьПути(ОбъединитьПути(ПостКорень, Рел), "Form.xml"), ОбъединитьПути(ПБП, "Form.xml"));
	Т = ТекстФайла(ОбъединитьПути(ПУП, "Form.xml"));
	ТБ = ТекстФайла(ОбъединитьПути(ПБП, "Form.xml"));
	ТБ = СтрЗаменить(ТБ, "xs:decimal", "xs:string");
	ЗаписатьТ(ОбъединитьПути(ПБП, "Form.xml"), ТБ);
	Старый = "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>xs:string</v8:Type></Type><DataPath>Объект.УПДопПоле</DataPath></Attribute>";
	Если СтрНайти(Т, Старый) = 0 Тогда
		Старый = "<Attribute name=""УПДопПоле""><Name>УПДопПоле</Name><Type><v8:Type>xs:string</v8:Type></Type></Attribute>";
	КонецЕсли;
	Т = СтрЗаменить(Т, Старый, БлокУПДопПоле(КвДлина, КвДоп));
	Если ChildUi Тогда
		Т = СтрЗаменить(Т, "<ChildItems/>", "<ChildItems><InputField name=""УПДопПолеПоле""><DataPath>УПДопПоле</DataPath></InputField></ChildItems>");
	КонецЕсли;
	ЗаписатьТ(ОбъединитьПути(ПУП, "Form.xml"), Т);
	М = "Процедура Ф()" + Символы.ПС;
	Если СтрокаВМодуль <> "" Тогда М = М + "	" + СтрокаВМодуль + Символы.ПС; КонецЕсли;
	М = М + "КонецПроцедуры";
	ЗаписатьТ(ОбъединитьПути(ОбъединитьПути(ПУП, "Form"), "Module.bsl"), М);
	ЗаписатьТ(ОбъединитьПути(ОбъединитьПути(ПБП, "Form"), "Module.bsl"), "Процедура Ф() КонецПроцедуры");
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
ФУП = ОбъединитьПути(Корень, "tests", "fixtures", "UP");
ФБП = ОбъединитьПути(Корень, "tests", "fixtures", "BP");
А = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "АнализФорм.os"));
Ошибок = 0;
ХешФикстур = КонтрольнаяСуммаФикстур();

OUT = ОбъединитьПути(Корень, "tests", "_transfer_out");
УдалитьФайлы(OUT);
СоздатьДеревоПереноса(OUT, ФУП, ФБП, "", 25, "variable", Истина);
А.СравнитьФормы(ОбъединитьПути(OUT, "UP"), ОбъединитьПути(OUT, "BP"), Неопределено, OUT, Новый Массив, Ложь, Истина);

Кат = ОбъединитьПути(OUT, "forms_transfer");
Дж = ТекстФайла(ОбъединитьПути(Кат, "forms_transfer.json"));
П(СтрНайти(Дж, """status"":""transferred""") > 0, "transferred status");
П(СтрНайти(Дж, "УПДопПоле") > 0, "attribute name");
КатФ = ОбъединитьПути(Корень, "tests", "_transfer_fixture");
УдалитьФайлы(КатФ); СоздатьКаталог(КатФ);
А.СравнитьФормы(ФУП, ФБП, Неопределено, КатФ, Новый Массив, Ложь, Истина);
ДжФ = ТекстФайла(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "tests", "_transfer_fixture"), "forms_transfer"), "forms_transfer.json"));
П(СтрНайти(ДжФ, """status"":""manual""") > 0, "manual on real fixture diff");
УдалитьФайлы(ОбъединитьПути(Корень, "tests", "_transfer_fixture"));

Найден = Ложь;
Для Каждого Ф Из НайтиФайлы(Кат, "*.transfer.bsl") Цикл
	Т = ТекстФайла(Ф.ПолноеИмя);
	П(СтрНайти(Т, "КвалификаторыСтроки(25") > 0 Или СтрНайти(Т, "КвалификаторыСтроки( 25") > 0, "qualifiers in code");
	П(СтрНайти(Т, "Переменная") > 0, "variable length");
	П(СтрНайти(Т, "REMOVE_STATIC_ATTRIBUTE") > 0, "remove static hint");
	П(СтрНайти(Т, "DataPath") > 0, "ui datapath comment");
	П(СтрНайти(Т, "ИзменитьРеквизиты") > 0, "change attributes");
	Найден = Истина;
КонецЦикла;
П(Найден, "transfer bsl file");

А.СравнитьФормы(ОбъединитьПути(OUT, "UP"), ОбъединитьПути(OUT, "BP"), Неопределено, OUT, Новый Массив, Ложь, Истина);
П(ТекстФайла(ОбъединитьПути(Кат, "forms_transfer.json")) = Дж, "idempotent json");
П(ТекстФайла(Ф.ПолноеИмя) = Т, "idempotent bsl");

OUT2 = ОбъединитьПути(Корень, "tests", "_transfer_out2");
УдалитьФайлы(OUT2);
СоздатьДеревоПереноса(OUT2, ФУП, ФБП, "РеквизитФормы(""УПДопПоле""", 25, "variable", Ложь);
А.СравнитьФормы(ОбъединитьПути(OUT2, "UP"), ОбъединитьПути(OUT2, "BP"), Неопределено, OUT2, Новый Массив, Ложь, Истина);
Дж2 = ТекстФайла(ОбъединитьПути(OUT2, "forms_transfer", "forms_transfer.json"));
П(СтрНайти(Дж2, "дублирующее runtime") > 0, "manual duplicate runtime");

OUT3 = ОбъединитьПути(Корень, "tests", "_transfer_out3");
УдалитьФайлы(OUT3); СоздатьКаталог(OUT3);
А.СравнитьФормы(ФУП, ФБП, Неопределено, OUT3, Новый Массив, Ложь, Ложь);
П(Не (Новый Файл(ОбъединитьПути(OUT3, "forms_transfer"))).Существует(), "no transfer without flag");

П(КонтрольнаяСуммаФикстур() = ХешФикстур, "fixtures unchanged");

УдалитьФайлы(OUT);
УдалитьФайлы(OUT2);
УдалитьФайлы(OUT3);

Если Ошибок = 0 Тогда Сообщить("OK: forms transfer"); Иначе ЗавершитьРаботу(1); КонецЕсли;
