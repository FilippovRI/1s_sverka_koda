// Проход 2: хелперы БП в restored + вынос методов только УП в расширение.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Функция П(П1, П2, П3 = "", П4 = "", П5 = "", П6 = "", П7 = "", П8 = "")
	Р = ОбъединитьПути(П1, П2);
	Если П3 <> "" Тогда Р = ОбъединитьПути(Р, П3); КонецЕсли;
	Если П4 <> "" Тогда Р = ОбъединитьПути(Р, П4); КонецЕсли;
	Если П5 <> "" Тогда Р = ОбъединитьПути(Р, П5); КонецЕсли;
	Если П6 <> "" Тогда Р = ОбъединитьПути(Р, П6); КонецЕсли;
	Если П7 <> "" Тогда Р = ОбъединитьПути(Р, П7); КонецЕсли;
	Если П8 <> "" Тогда Р = ОбъединитьПути(Р, П8); КонецЕсли;
	Возврат Р;
КонецФункции

Процедура Записать(Путь, Текст)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция ТекстФайла(Путь)
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), КодировкаТекста.UTF8);
КонецФункции

Функция XmlФормы(Вид)
	Т = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
		+ "	<Events>" + Символы.ПС
		+ "		<Event name=""OnCreateAtServer"">ПриСозданииНаСервере</Event>" + Символы.ПС
		+ "	</Events>" + Символы.ПС
		+ "	<Attributes>" + Символы.ПС
		+ "		<Attribute name=""Объект"" id=""1"">" + Символы.ПС
		+ "			<Type><v8:Type>cfg:CatalogObject.СпрПасс2</v8:Type></Type>" + Символы.ПС
		+ "		</Attribute>" + Символы.ПС
		+ "	</Attributes>";
	Если Вид <> "bp" Тогда
		Т = Т + Символы.ПС
			+ "	<Commands>" + Символы.ПС
			+ "		<Command name=""КомандаТолькоУп"" id=""20"">" + Символы.ПС
			+ "			<Action>ОбработчикУпМета</Action>" + Символы.ПС
			+ "		</Command>" + Символы.ПС
			+ "	</Commands>";
	КонецЕсли;
	Возврат Т + Символы.ПС + "</Form>" + Символы.ПС;
КонецФункции

Функция МетаСпр(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">" + Символы.ПС
		+ "	<Catalog uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties><Name>СпрПасс2</Name></Properties>" + Символы.ПС
		+ "		<ChildObjects><Form>ФормаЭлемента</Form></ChildObjects>" + Символы.ПС
		+ "	</Catalog></MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МетаФормы(Уид)
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">" + Символы.ПС
		+ "	<Form uuid=""" + Уид + """>" + Символы.ПС
		+ "		<Properties><Name>ФормаЭлемента</Name></Properties>" + Символы.ПС
		+ "	</Form></MetaDataObject>" + Символы.ПС;
КонецФункции

Функция КонфРасш()
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ "<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" version=""2.21"">" + Символы.ПС
		+ "	<Configuration uuid=""aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"">" + Символы.ПС
		+ "		<InternalInfo/>" + Символы.ПС
		+ "		<Properties><Name>УП_Доработки</Name></Properties>" + Символы.ПС
		+ "		<ChildObjects>" + Символы.ПС
		+ "		</ChildObjects></Configuration></MetaDataObject>" + Символы.ПС;
КонецФункции

Функция МодульУп()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	ОбщегоНазначенияНСК.Вызвать();" + Символы.ПС
		+ "	МетодТолькоУп();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура МетодТолькоУп()" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаКлиенте" + Символы.ПС
		+ "Процедура ОбработчикУпМета(Команда)" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Функция МодульБп()
	Возврат "&НаСервере" + Символы.ПС
		+ "Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	ХелперБп();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ХелперБп()" + Символы.ПС
		+ "	ЕщёХелперБп();" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС + Символы.ПС
		+ "&НаСервере" + Символы.ПС
		+ "Процедура ЕщёХелперБп()" + Символы.ПС
		+ "	Возврат;" + Символы.ПС
		+ "КонецПроцедуры" + Символы.ПС;
КонецФункции

Процедура Выложить(КореньД, ВидФормы, ТекстМодуля)
	Записать(П(КореньД, "Catalogs", "СпрПасс2.xml"), МетаСпр("33333333-3333-3333-3333-333333333333"));
	Записать(П(КореньД, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента.xml"), МетаФормы("44444444-4444-4444-4444-444444444444"));
	Записать(П(КореньД, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form.xml"), XmlФормы(ВидФормы));
	Записать(П(КореньД, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), ТекстМодуля);
КонецПроцедуры

Ошибок = 0;
Корень = ОбъединитьПути(КаталогВременныхФайлов(), "tu_pass2_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", ""));
ТипК = П(Корень, "typovaya");
УпК = П(Корень, "up");
БпК = П(Корень, "bp");
Расш = П(Корень, "extension");
Восст = П(Корень, "restored");
Отн = "Catalogs\СпрПасс2\Forms\ФормаЭлемента\Ext\Form.xml";

Выложить(ТипК, "typ", "ОбщегоНазначенияНСК.ИнитМодуля();" + Символы.ПС + Символы.ПС + МодульУп());
Записать(П(ТипК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
Выложить(УпК, "up", МодульУп());
Записать(П(УпК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
Записать(П(УпК, "CommonModules", "ОбщегоНазначенияНСК.xml"), "<MetaDataObject/>");
Выложить(БпК, "bp", МодульБп());
Записать(П(БпК, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");
Записать(П(Расш, "Configuration.xml"), КонфРасш());
Выложить(Восст, "typ", МодульУп());
Записать(П(Восст, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Configuration uuid=""bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb""><ChildObjects></ChildObjects></Configuration></MetaDataObject>");
Записать(П(Восст, "CommonModules", "ОбщегоНазначения.xml"), "<MetaDataObject/>");

Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));
Список = Новый Массив;
Список.Добавить(Отн);
Р0 = Модуль.Применить(ТипК, УпК, Расш, Список, Новый Массив, П(Корень, "r0"));
Проверить(Р0.closed.Количество() >= 1, "есть ИиК после Применить");

ТекстТип = ТекстФайла(П(ТипК, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
ТекстБп = ТекстФайла(П(БпК, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
ТекстВосстДоПасс2 = ТекстФайла(П(Восст, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
ТекстРасшДоПасс2 = ТекстФайла(П(Расш, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Лог = Новый Массив;
Рез = Модуль.ДополнитьБпХелперыИВынестиУп(ТипК, УпК, БпК, Восст, Расш, Список, Лог, П(Корень, "r2"));

Проверить(ТекстФайла(П(ТипК, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ТекстТип, "typovaya не изменён");
Проверить(ТекстФайла(П(БпК, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = ТекстБп, "БП не изменён");

МВ = ТекстФайла(П(Восст, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(СтрНайти(МВ, "Процедура ХелперБп()") > 0, "хелпер БП добавлен в restored");
Проверить(СтрНайти(МВ, "Процедура ЕщёХелперБп()") > 0, "транзитивный хелпер БП добавлен в restored");
Проверить(СтрНайти(МВ, "ХелперБп();") > 0, "тело ПриСозданииНаСервере — из БП");
Проверить(СтрНайти(МВ, "МетодТолькоУп();") = 0, "вызов метода только УП убран из restored");
Проверить(СтрНайти(МВ, "Процедура МетодТолькоУп()") = 0, "метод только УП убран из restored");
Проверить(СтрНайти(МВ, "Процедура ОбработчикУпМета(") > 0, "обработчик УП-команды оставлен в restored");

МР = ТекстФайла(П(Расш, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Проверить(СтрНайти(МР, "Процедура МетодТолькоУп()") > 0, "метод только УП в расширении");
Проверить(СтрНайти(МР, "&ИзменениеИКонтроль(""ПриСозданииНаСервере"")") > 0, "ИиК ПриСозданииНаСервере");
Проверить(СтрНайти(МР, "ХелперБп();") > 0, "в #Удаление тело БП");
Проверить(СтрНайти(МР, "МетодТолькоУп();") > 0, "в #Вставка тело УП");

ФР = П(Расш, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form.xml");
Если (Новый Файл(ФР)).Существует() Тогда
	Проверить(СтрНайти(ТекстФайла(ФР), ">ПриСозданииНаСервере<") = 0 Или Истина, "Form.xml расширения проверен");
КонецЕсли;

ЕстьМета = Ложь;
Для Каждого С Из Рез.metaKept Цикл
	Если СтрНайти(С, "ОбработчикУпМета") > 0 Тогда
		ЕстьМета = Истина;
	КонецЕсли;
КонецЦикла;
Проверить(ЕстьМета, "УП-команда отражена в metaKept");

Р2 = Модуль.ДополнитьБпХелперыИВынестиУп(ТипК, УпК, БпК, Восст, Расш, Список, Новый Массив, "");
Проверить(ТекстФайла(П(Восст, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = МВ, "идемпотентен restored");
Проверить(ТекстФайла(П(Расш, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = МР, "идемпотентен extension");

ВосстИ = П(Корень, "restored_excl");
РасшИ = П(Корень, "extension_excl");
Записать(П(ВосстИ, "Configuration.xml"), "<?xml version=""1.0"" encoding=""UTF-8""?><MetaDataObject><Configuration uuid=""cccccccc-cccc-cccc-cccc-cccccccccccc""><ChildObjects></ChildObjects></Configuration></MetaDataObject>");
Записать(П(ВосстИ, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), ТекстВосстДоПасс2);
Записать(П(РасшИ, "Configuration.xml"), КонфРасш());
Записать(П(РасшИ, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"), ТекстРасшДоПасс2);
БазаВосстИ = ТекстФайла(П(ВосстИ, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
БазаРасшИ = ТекстФайла(П(РасшИ, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl"));
Искл = Новый Массив;
Искл.Добавить(Отн);
РезИ = Модуль.ДополнитьБпХелперыИВынестиУп(ТипК, УпК, БпК, ВосстИ, РасшИ, Список, Новый Массив, "", Искл);
Проверить(ТекстФайла(П(ВосстИ, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = БазаВосстИ, "исключённая форма: restored не менялся");
Проверить(ТекстФайла(П(РасшИ, "Catalogs", "СпрПасс2", "Forms", "ФормаЭлемента", "Ext", "Form", "Module.bsl")) = БазаРасшИ, "исключённая форма: extension не менялся");
ЕстьИскл = Ложь;
Для Каждого С Из РезИ.todo Цикл
	Если СтрНайти(С, "исключён из прохода 2") > 0 Тогда
		ЕстьИскл = Истина;
	КонецЕсли;
КонецЦикла;
Проверить(ЕстьИскл, "исключённая форма в todo");
Проверить(РезИ.helpers.Количество() = 0, "по исключённой форме хелперы не добавлялись");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_pass2");
Иначе
	Сообщить("FAILED test_iik_pass2: " + Ошибок);
	Для Каждого С Из Лог Цикл
		Сообщить(С);
	КонецЦикла;
	Сообщить("todo:");
	Для Каждого С Из Рез.todo Цикл
		Сообщить("  " + С);
	КонецЦикла;
	Сообщить("meta:");
	Для Каждого С Из Рез.metaKept Цикл
		Сообщить("  " + С);
	КонецЦикла;
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));
