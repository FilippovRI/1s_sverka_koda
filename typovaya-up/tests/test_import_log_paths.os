Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Ошибок = 0;
Разбор = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "РазборЛогаИмпорта.os"));
Т = "[ERROR] Неизвестный объект метаданных - Document.ПриемНаРаботу.TabularSection.ДополнительныеРеквизиты" + Символы.ПС
	+ "[ERROR] Неизвестный объект метаданных - ChartOfCharacteristicTypes.ВидыСубконтоХозрасчетные" + Символы.ПС
	+ "[ERROR] Неизвестный объект метаданных - Document.ПриемНаРаботу.TabularSection.ДополнительныеРеквизиты";
Пути = Разбор.ПутиНеизвестныхМетаданныхИзТекста(Т);
П(Пути.Количество() = 2, "две уникальные строки");
П(Пути.Найти("Document.ПриемНаРаботу.TabularSection.ДополнительныеРеквизиты") <> Неопределено, "ТЧ документа");
П(Пути.Найти("ChartOfCharacteristicTypes.ВидыСубконтоХозрасчетные") <> Неопределено, "ПВХ");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_import_log_paths: " + Ошибок;
КонецЕсли;
Сообщить("OK test_import_log_paths");