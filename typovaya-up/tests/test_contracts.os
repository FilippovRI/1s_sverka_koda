Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "РазборМетодов.os"));
Конт = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "КонтрактМетода.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ЧерновикРасширения.os"));
Ошибок = 0;
ПС = Символы.ПС;
ФП = "Функция Ф(А) Экспорт" + ПС + "КонецФункции";
ФИ = "Функция Ф(А) Экспорт" + ПС + "КонецФункции";
П(Конт.ПроверитьПередАвтоПереносом(ФП, ФИ, Разбор).ОК, "same contract");
П(Не Конт.ПроверитьПередАвтоПереносом("Процедура П()|" + ПС + "КонецПроцедуры", "Функция Ф()|" + ПС + "КонецФункции", Разбор).ОК, "kind mismatch");
П(Не Конт.ПроверитьПередАвтоПереносом("Функция Ф(А, Б) Экспорт|" + ПС + "КонецФункции", ФИ, Разбор).ОК, "extra param");
П(Не Конт.ПроверитьПередАвтоПереносом("Функция Ф(Знач А = 1) Экспорт|" + ПС + "КонецФункции", ФИ, Разбор).ОК, "default mismatch");
П(Не Конт.ПроверитьПередАвтоПереносом("Функция Ф(Знач А) Экспорт|" + ПС + "КонецФункции", ФИ, Разбор).ОК, "Знач mismatch");
П(Не Конт.ПроверитьПередАвтоПереносом("Функция Ф(А) Экспорт|" + ПС + "КонецФункции", "Функция Ф(А)|" + ПС + "КонецФункции", Разбор).ОК, "export mismatch");
Ман = Новый Структура("name, kind, status, vendorText, sourceText, hook, hookDecision, hookBody",
	"М", "Процедура", "changed", "Процедура М()", "Процедура М(А, Б)", "none", "manual", "");
П(Не Ч.ИдётВРасширение(Ман), "blocked not in extension");
П(СтрНайти(Конт.ПроверитьПередАвтоПереносом(ФП, ФИ, Разбор).callRewritePreview, "не выполнялся") > 0, "preview honest");
Если Ошибок = 0 Тогда Сообщить("OK: contracts"); Иначе ЗавершитьРаботу(1); КонецЕсли;
