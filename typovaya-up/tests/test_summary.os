Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Отч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ОтчетHTML.os"));
Ошибок = 0;
М = Новый Массив;
М.Добавить(Новый Структура("bucket, path, methods", "auto", "A", Новый Массив));
Мт = Новый Структура("status, hook", "changed", "after");
М[0].methods.Добавить(Мт);
М.Добавить(Новый Структура("bucket, path", "identical", "B"));
Св = Отч.СобратьСводку(М, Новый Структура("t", 1));
П(Св.total = 2, "total");
П(Св.counts.auto = 1, "auto count");
П(Св.hooks.after = 1, "hook after");
П(Св.paths.identical.Количество() = 1, "paths list");
Если Ошибок = 0 Тогда Сообщить("OK: сводка"); Иначе ЗавершитьРаботу(1); КонецЕсли;
