Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Отч = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ОтчетHTML.os"));
Ошибок = 0;
М = Новый Массив;
М.Добавить(Новый Структура("bucket, path, methods", "auto", "A", Новый Массив));
Мт = Новый Структура("status, hook", "changed", "after");
М[0].methods.Добавить(Мт);
М.Добавить(Новый Структура("bucket, path", "identical", "B"));
Св = Отч.СобратьСводку(М, Новый Структура("t", 1));
П(Св.total = 2, "total");
П(Св.counts.auto = 1, "auto count");
П(Св.hooks.after = 1, "hook after");
П(Св.paths.identical.Количество() = 1, "paths list");
// Раздел «Ручной разбор (bsparser)» — отдельная свёрнутая полоса между шапкой и деревом, не внутри flex-шапки
Т = Новый ТекстовыйДокумент;
Т.Прочитать(ОбъединитьПути(Корень, "src", "шаблон.html"), КодировкаТекста.UTF8);
Шаб = Т.ПолучитьТекст();
П(СтрНайти(Шаб, "getElementById(""main"").insertAdjacentHTML(""beforebegin""") > 0, "bsparser-раздел перед #main");
П(СтрНайти(Шаб, "getElementById(""meta"").insertAdjacentHTML") = 0, "bsparser-раздел не в шапке");
П(СтрНайти(Шаб, "#bsparser{flex:none") > 0 И СтрНайти(Шаб, "max-height:35vh;overflow:auto") > 0, "bsparser-раздел ограничен по высоте");
П(СтрНайти(Шаб, "<details id=""bsparser""><summary>") > 0, "bsparser-раздел свёрнут по умолчанию");
П(СтрНайти(Шаб, "<script type=""application/json"" id=""report-data"">") > 0, "данные в script application/json");
П(СтрНайти(Шаб, "/*__DATA__*/null") > 0, "плейсхолдер JSON");
П(СтрНайти(Шаб, "table-layout:fixed") > 0 И СтрНайти(Шаб, "word-break:break-all") > 0, "PR #30: перенос длинных строк");
П(СтрНайти(Шаб, "возвращён в типовой (есть в restored)") > 0, "пометка возврата в типовой");

// Компактный отчёт: только фрагменты отличий, рядом report.json, исходные тексты не портятся
Выход = ОбъединитьПути(КаталогВременныхФайлов(), "typovaya-up-report-test");
СоздатьКаталог(Выход);
БП = "А" + Символы.ПС + "Б" + Символы.ПС + "Втиповая" + Символы.ПС + "Г" + Символы.ПС + "Д";
УП = "А" + Символы.ПС + "Б" + Символы.ПС + "Вдоработка" + Символы.ПС + "Г" + Символы.ПС + "Д";
Методы = Новый Массив;
Методы.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, explain, hook, hookBody",
	"Изменённый", "Процедура", "changed", БП, УП, "небольшое отличие", "none", ""));
Методы.Добавить(Новый Структура("name, kind, status, vendorText, sourceText, hook, hookBody, returned",
	"Удалённый", "Процедура", "removed", "Процедура Удалённый()" + Символы.ПС + "КонецПроцедуры", "", "none", "", Истина));
Методы.Добавить(Новый Структура("name, kind, status, hook, hookBody, vendorText, sourceText",
	"СХуком", "Процедура", "changed", "after", "&После(""СХуком"")" + Символы.ПС + "КонецПроцедуры", "полныйБП", "полныйУП"));
Мод = Новый Массив;
Мод.Добавить(Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
	"CommonModules\Тест\Ext\Module.bsl", "CommonModule", "CommonModule.Тест", "manual",
	"есть отличия", "МОДУЛЬ-БП-ОЧЕНЬ-ДЛИННЫЙ-ТЕКСТ", "МОДУЛЬ-УП-ОЧЕНЬ-ДЛИННЫЙ-ТЕКСТ", Ложь, Методы,
	Новый Структура("same, changed, added, removed", 0, 2, 0, 1)));
Мета = Новый Структура("source, vendor, sourceName, vendorName, settings, settingsInfo, generated",
	"src", "vnd", "УП", "БП", "", "", "2026-01-01");
Сводка = Отч.СобратьСводку(Мод, Мета);
Сводка.Вставить("returnedToVendor", 1);
Отч.ЗаписатьОтчет(Мод, Сводка, Выход, ОбъединитьПути(Корень, "src"));
П((Новый Файл(ОбъединитьПути(Выход, "report.json"))).Существует(), "есть report.json");
П((Новый Файл(ОбъединитьПути(Выход, "razbor_moduley.html"))).Существует(), "есть html");
Чт = Новый ЧтениеJSON;
Чт.ОткрытьФайл(ОбъединитьПути(Выход, "report.json"), "UTF-8");
Отчет = ПрочитатьJSON(Чт);
Чт.Закрыть();
П(Отчет.modules.Количество() = 1, "в отчёте один модуль");
П(Не Отчет.modules[0].Свойство("vendorText") И Не Отчет.modules[0].Свойство("sourceText"), "нет полных текстов модуля");
П(Отчет.modules[0].methods[0].Свойство("diff") И Отчет.modules[0].methods[0].diff.Количество() = 1, "есть хунк отличия");
П(Не Отчет.modules[0].methods[0].Свойство("vendorText"), "у метода нет полного текста");
П(Отчет.modules[0].methods[1].returned = Истина, "удалённый помечен как возвращённый");
П(Не Отчет.modules[0].methods[1].Свойство("diff") И Не Отчет.modules[0].methods[1].Свойство("vendorText"), "возвращённый без полного текста");
П(Отчет.modules[0].methods[2].hookBody <> "" И Не Отчет.modules[0].methods[2].Свойство("diff"), "у авто-хука только hookBody");
П(Отчет.returnedToVendor = 1, "returnedToVendor в данных");
П(Мод[0].vendorText = "МОДУЛЬ-БП-ОЧЕНЬ-ДЛИННЫЙ-ТЕКСТ", "исходный модуль не изменён");
Html = Новый ЧтениеТекста(ОбъединитьПути(Выход, "razbor_moduley.html"), "UTF-8");
ТекстHtml = Html.Прочитать();
Html.Закрыть();
П(СтрНайти(ТекстHtml, "МОДУЛЬ-БП-ОЧЕНЬ-ДЛИННЫЙ-ТЕКСТ") = 0, "полный текст модуля не попал в html");
П(СтрНайти(ТекстHtml, "Втиповая") > 0 И СтрНайти(ТекстHtml, "Вдоработка") > 0, "в html есть изменённый фрагмент");
П(СтрНайти(ТекстHtml, "<script type=""application/json"" id=""report-data"">") > 0, "json встроен в html");
П(СтрНайти(ТекстHtml, "полныйБП") = 0, "текст метода с hookBody не дублируется");
Фр = Отч.ФрагментыОтличий("раз" + Символы.ПС + "два" + Символы.ПС + "три", "раз" + Символы.ПС + "два+" + Символы.ПС + "три");
П(Фр.Количество() = 1 И Фр[0].l.Количество() = 4 И Фр[0].l[0][0] = " " И Фр[0].l[1][0] = "-" И Фр[0].l[2][0] = "+", "хунк с контекстом");

Если Ошибок = 0 Тогда Сообщить("OK: сводка"); Иначе ЗавершитьРаботу(1); КонецЕсли;
