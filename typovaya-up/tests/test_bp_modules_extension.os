// МодулиБпВРасширении: собственный общий модуль БП попадает в extension, restored не трогаем.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь).Записать(Путь);
КонецПроцедуры

Функция Конф(Объекты)
	Т = "<MetaDataObject>" + Символы.ПС + "	<Configuration>" + Символы.ПС + "		<ChildObjects>" + Символы.ПС;
	Если СокрЛП(Объекты) <> "" Тогда
		Для Каждого О Из СтрРазделить(Объекты, ",") Цикл
			Ч = СтрРазделить(О, ".");
			Т = Т + "			<" + Ч[0] + ">" + Ч[1] + "</" + Ч[0] + ">" + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Возврат Т + "		</ChildObjects>" + Символы.ПС + "	</Configuration>" + Символы.ПС + "</MetaDataObject>" + Символы.ПС;
КонецФункции

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Вб = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ВозвратОбщихМодулейБп.os"));
Мб = ЗагрузитьСценарий(ОбъединитьПути(Ск, "МодулиБпВРасширении.os"));
Мб.Инициализировать(Вб);
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_extbp_" + Строка(Новый УникальныйИдентификатор));
Осн = ОбъединитьПути(Вр, "main");
Бп = ОбъединитьПути(Вр, "bp");
Расш = ОбъединитьПути(Вр, "ext");
МодБп = "МодульБпТест";
Зап(ОбъединитьПути(Осн, "Configuration.xml"), Конф("CommonModule.ОбщегоНазначения"));
Зап(ОбъединитьПути(Бп, "Configuration.xml"), Конф("CommonModule.ОбщегоНазначения,CommonModule." + МодБп));
Зап(ОбъединитьПути(Расш, "Configuration.xml"), Конф(""));
Зап(ОбъединитьПути(Бп, "CommonModules", МодБп + ".xml"), "<CommonModule><Global>false</Global></CommonModule>");
Зап(ОбъединитьПути(Бп, "CommonModules", МодБп, "Ext/Module.bsl"), "Функция ВызовТест() Экспорт" + Символы.ПС + "	Возврат 1;" + Символы.ПС + "КонецФункции" + Символы.ПС);
Зап(ОбъединитьПути(Осн, "Documents", "Д", "Ext/ObjectModule.bsl"), МодБп + ".ВызовТест();" + Символы.ПС);
Лог = Новый Массив;
Р = Мб.Обеспечить(Осн, Расш, Бп, Лог, Вр);
П(Р.stubs >= 1, "stub module in extension");
П((Новый Файл(ОбъединитьПути(Расш, "CommonModules", МодБп + ".xml"))).Существует(), "extension CM xml");
П(Р.scanRestoredAfter.refs = 0, "restored refs after union metadata: " + Р.scanRestoredAfter.refs);
УдалитьФайлы(Вр);
Если Ошибок > 0 Тогда
	ВызватьИсключение "test_bp_modules_extension";
КонецЕсли;
Сообщить("OK: test_bp_modules_extension");