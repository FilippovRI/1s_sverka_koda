// Наличие подключённых правил OneScript (этап 1), без проверки содержимого.
Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Репо = ОбъединитьПути(Корень, "..");
Ошибок = 0;
П((Новый Файл(ОбъединитьПути(ОбъединитьПути(Корень, "docs"), "ONESCRIPT_SKILLS.md"))).Существует(), "ONESCRIPT_SKILLS");
Лиц = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "docs"), "third-party"), "skills-onescript-LICENSE.txt");
П((Новый Файл(Лиц)).Существует(), "MIT license");
Скилл = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Репо, ".cursor"), "skills"), "onescript"), "SKILL.md");
П((Новый Файл(Скилл)).Существует(), "skill onescript");
Прав = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Репо, ".cursor"), "rules"), "typovaya-up-os-code-style.mdc");
П((Новый Файл(Прав)).Существует(), "rule style");
Если Ошибок = 0 Тогда Сообщить("OK: meta"); Иначе ЗавершитьРаботу(1); КонецЕсли;
