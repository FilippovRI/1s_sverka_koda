// Удаление недопустимых стандартных команд из Form.xml заимствованных форм расширения.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Ошибок = 0;
Фр = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ФормыRestored.os"));
Исх = "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
	+ "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.17"">" + Символы.ПС
	+ "	<CommandSet><ExcludedCommand>Form.Item.Список.StandardCommand.Copy</ExcludedCommand></CommandSet>" + Символы.ПС
	+ "	<ChildItems>" + Символы.ПС
	+ "		<Button name=""КнCopy"" id=""1""><CommandName>Form.StandardCommand.Copy</CommandName></Button>" + Символы.ПС
	+ "		<Button name=""КнFind"" id=""2""><CommandName>Form.Command.Find</CommandName></Button>" + Символы.ПС
	+ "		<Button name=""КнОк"" id=""3""><CommandName>Form.Command.Моя</CommandName></Button>" + Символы.ПС
	+ "	</ChildItems>" + Символы.ПС
	+ "	<Commands>" + Символы.ПС
	+ "		<Command name=""Catalog.Тест.StandardCommand.OpenList""><Action>Open</Action></Command>" + Символы.ПС
	+ "		<Command name=""Моя""><Action>МояДействие</Action></Command>" + Символы.ПС
	+ "	</Commands>" + Символы.ПС
	+ "</Form>";
Нов = Фр.УбратьНедопустимыеСтандартныеКомандыФормы(Исх);
П(СтрНайти(Нов, "StandardCommand") = 0, "нет StandardCommand");
П(СтрНайти(Нов, "Form.Command.Find") = 0, "убрана Find");
П(СтрНайти(Нов, "КнОк") > 0 И СтрНайти(Нов, "Моя") > 0, "свои команды остались");
П(Фр.ЗапрещенаСтандартнаяКомандаРасширения("Form.Item.X.StandardCommand.Copy"), "детектор StandardCommand");

Тмп = ОбъединитьПути(ТекущийСценарий().Каталог, "_stdcmd_tmp");
Если (Новый Файл(Тмп)).Существует() Тогда
	УдалитьФайлы(Тмп);
КонецЕсли;
СоздатьКаталог(Тмп);
Записать = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Тмп, "Catalogs"), "Т"), "Forms"), "Ф"), "Ext"), "Form.xml");
СоздатьКаталог((Новый Файл(Записать)).Путь);
ПолучитьДвоичныеДанныеИзСтроки(Исх, КодировкаТекста.UTF8, Ложь).Записать(Записать);
Лог = Новый Массив;
Р = Фр.ОчиститьСтандартныеКомандыВКаталоге(Тмп, Лог);
П(Р.forms = 1, "каталог: одна форма");
ТП = Новый ЧтениеТекста(Записать, КодировкаТекста.UTF8);
Пр = ТП.Прочитать();
ТП.Закрыть();
П(СтрНайти(Пр, "StandardCommand") = 0, "на диске чисто");

Если Ошибок > 0 Тогда
	ВызватьИсключение "test_standard_commands_ext: " + Ошибок;
КонецЕсли;
Сообщить("OK test_standard_commands_ext");