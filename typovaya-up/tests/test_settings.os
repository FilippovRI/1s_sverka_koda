Перем Ошибок;
Процедура П(У, С) Если Не У Тогда Сообщить("FAIL: " + С); Ошибок = Ошибок + 1; КонецЕсли; КонецПроцедуры
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Н = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "НастройкиСравнения.os"));
Ошибок = 0;
Лог = Новый Массив;
Р = Н.ПрочитатьНастройки(ОбъединитьПути(Корень, "tests", "fixtures", "merge.xml"), Лог);
П(Р.Пути.Количество() > 0, "пути периметра");
П(Р.Пути.Получить("CommonModules\ХукНабор\Ext\Module.bsl") <> Неопределено, "ХукНабор");
П(Н.ПутьМодуля("Catalog.Банки", "ObjectModule") = "Catalogs\Банки\Ext\ObjectModule.bsl", "ПутьМодуля catalog");
П(Н.ПутьМодуля("Document.Счет.Command.Печать", "CommandModule")
	= "Documents\Счет\Commands\Печать\Ext\CommandModule.bsl", "ПутьМодуля command");
П(Н.ТипПоКаталогу("Catalogs") = "Catalog", "ТипПоКаталогу");
Если Ошибок = 0 Тогда Сообщить("OK: настройки"); Иначе ЗавершитьРаботу(1); КонецЕсли;
