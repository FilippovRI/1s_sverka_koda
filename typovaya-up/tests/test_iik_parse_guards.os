// Разбор методов: КонецПроцедуры //комментарий не должен захватывать соседа и #КонецОбласти.
Перем Ошибок;

Процедура Проверить(Условие, Сообщение)
	Если Не Условие Тогда
		Сообщить("FAIL: " + Сообщение);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Ошибок = 0;
Модуль = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносОмУпИиК.os"));

Текст = "#Область ВызовПодключения" + Символы.ПС
	+ Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Процедура УП_ПодключениеК1СОтчетности()" + Символы.ПС
	+ "	УП_ОткрытьСоздание();" + Символы.ПС
	+ "КонецПроцедуры //УП_Конец  " + Символы.ПС
	+ Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Функция УП_ОткрытьСоздание()" + Символы.ПС
	+ "	Возврат 1;" + Символы.ПС
	+ "КонецФункции	" + Символы.ПС
	+ "#КонецОбласти //УП_Конец" + Символы.ПС
	+ Символы.ПС
	+ "&НаКлиенте" + Символы.ПС
	+ "Процедура Сосед(Элемент)" + Символы.ПС
	+ "	УП_ПодключениеК1СОтчетности();" + Символы.ПС
	+ "КонецПроцедуры" + Символы.ПС;

Разд = Модуль.РазобратьМодульНаМетоды(Текст);
Проверить(Разд.methods.Количество() = 3, "разобрано 3 метода, факт " + Разд.methods.Количество());
Проверить(Разд.byName.Получить("УП_ПодключениеК1СОтчетности") <> Неопределено, "есть УП_ПодключениеК1СОтчетности");
Проверить(Разд.byName.Получить("УП_ОткрытьСоздание") <> Неопределено, "есть УП_ОткрытьСоздание");
Проверить(Разд.byName.Получить("Сосед") <> Неопределено, "есть Сосед");

М1 = Разд.byName.Получить("УП_ПодключениеК1СОтчетности");
Если М1 <> Неопределено Тогда
	Проверить(СтрНайти(М1.text, "Функция УП_ОткрытьСоздание") = 0, "УП_Подключение не захватывает следующую функцию");
	Проверить(СтрНайти(М1.text, "#КонецОбласти") = 0, "УП_Подключение не захватывает #КонецОбласти");
	Проверить(СтрНайти(М1.directives, "&НаКлиенте") > 0, "у УП_Подключение директива &НаКлиенте");
КонецЕсли;

М2 = Разд.byName.Получить("УП_ОткрытьСоздание");
Если М2 <> Неопределено Тогда
	Проверить(СтрНайти(М2.text, "#КонецОбласти") = 0, "УП_ОткрытьСоздание не захватывает #КонецОбласти");
	Проверить(СтрНайти(М2.directives, "&НаКлиенте") > 0, "у УП_ОткрытьСоздание директива &НаКлиенте");
КонецЕсли;

М3 = Разд.byName.Получить("Сосед");
Если М3 <> Неопределено Тогда
	Проверить(СтрНайти(М3.directives, "&НаКлиенте") > 0, "у Соседа директива &НаКлиенте");
	Проверить(СтрНайти(М3.text, "УП_ПодключениеК1СОтчетности();") > 0, "вызов в Соседе на месте");
КонецЕсли;

Проверить(СтрНайти(Разд.outside, "#Область ВызовПодключения") > 0, "#Область во внепроцедурном тексте");
Проверить(СтрНайти(Разд.outside, "#КонецОбласти") > 0, "#КонецОбласти во внепроцедурном тексте");

Если Ошибок = 0 Тогда
	Сообщить("OK test_iik_parse_guards");
Иначе
	Сообщить("FAILED test_iik_parse_guards: " + Ошибок);
КонецЕсли;
ЗавершитьРаботу(?(Ошибок = 0, 0, 1));
