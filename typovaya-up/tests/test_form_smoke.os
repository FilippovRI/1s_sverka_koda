// ДымовыеФормы: список, создание, открытие и запись основных справочников.
Перем Ошибок;

Процедура П(У, С)
	Если Не У Тогда
		Сообщить("FAIL: " + С);
		Ошибок = Ошибок + 1;
	КонецЕсли;
КонецПроцедуры

Процедура Зап(Путь, Текст)
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

Функция Читать(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

Ошибок = 0;
Ск = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
Вр = ОбъединитьПути(КаталогВременныхФайлов(), "t_formsmoke_" + Строка(Новый УникальныйИдентификатор));
Расш = ОбъединитьПути(Вр, "ext");
Вывод = ОбъединитьПути(Вр, "out");
КаталогБанки = ОбъединитьПути(Расш, "Catalogs", "Банки", "Forms");
Зап(ОбъединитьПути(КаталогБанки, "ФормаСписка.xml"), "<Form/>");
Зап(ОбъединитьПути(КаталогБанки, "ФормаЭлемента.xml"), "<Form/>");
Зап(ОбъединитьПути(КаталогБанки, "ФормаЭлемента", "Ext", "Form.xml"), "<Form/>");
КаталогАрхив = ОбъединитьПути(Расш, "DataProcessors", "Архив", "Forms");
Зап(ОбъединитьПути(КаталогАрхив, "Основная.xml"), "<Form/>");
КаталогШаблоны = ОбъединитьПути(Расш, "Catalogs", "ШаблоныАнкет", "Forms");
Зап(ОбъединитьПути(КаталогШаблоны, "ФормаСписка.xml"), "<Form/>");
КаталогГражданство = ОбъединитьПути(Расш, "InformationRegisters", "ГражданствоФизическихЛиц", "Forms");
Зап(ОбъединитьПути(КаталогГражданство, "ФормаСписка.xml"), "<Form/>");
Модуль = ЗагрузитьСценарий(ОбъединитьПути(Ск, "ДымовыеФормы.os"));
Р = Модуль.Собрать(Расш, Вывод, "D:\typovaya-up-work\ib");
Фича = Читать(ОбъединитьПути(Вывод, "дымовые_формы.feature"));
Имена = Читать(ОбъединитьПути(Вывод, "формы_по_имени.txt"));
Искл = Читать(ОбъединитьПути(Вывод, "исключения", "Справочники.txt"));
Клиент = Читать(ОбъединитьПути(Вывод, "клиент.json"));
П(Р.сценарии = 18, "сценариев " + Р.сценарии);
П(Р.создание = 1, "созданий " + Р.создание);
П(Р.открытие = 3, "открытий " + Р.открытие);
П(Р.запись = 10, "записей " + Р.запись);
П(СтрНайти(Фича, "e1cib/list/Справочник.Банки") > 0, "нет списка банков");
П(СтрНайти(Фича, "e1cib/app/Обработка.Архив") > 0, "нет обработки");
П(СтрНайти(Фича, "Сценарий: Создание Справочник.Банки") > 0, "нет создания банков");
П(СтрНайти(Фича, "Если поле ""Создать"" существует тогда") > 0, "нет пропуска создания");
П(СтрНайти(Фича, "Сценарий: Создание Справочник.ШаблоныАнкет") = 0, "создание шаблонов анкет не пропущено");
П(СтрНайти(Фича, "Сценарий: Создание РегистрСведений.ГражданствоФизическихЛиц") = 0, "создание гражданства не пропущено");
П(СтрНайти(Фича, "закрываю текущее окно") = 0, "сценарий закрывает текущее окно");
П(СтрНайти(Фича, "закрываю все окна клиентского приложения") > 0, "нет закрытия окон форм");
П(СтрНайти(Фича, "Сценарий: Открытие Справочник.Банки") > 0, "нет открытия банков");
П(СтрНайти(Фича, "Сценарий: Запись Справочник.Должности") > 0, "нет записи должностей");
П(СтрНайти(Фича, "Дым Должности") > 0, "нет заполнения должности");
П(СтрНайти(Фича, "ФормаЭлемента") = 0, "форма элемента попала в feature");
П(СтрНайти(Имена, "Справочник.Банки.Форма.ФормаЭлемента") > 0, "нет формы элемента в списке имён");
П(СтрНайти(Искл, "Банки.Запись") > 0, "нет исключения записи");
П(СтрНайти(Искл, "Банки.Печать") > 0, "нет исключения печати");
П(СтрНайти(Клиент, "D:\\typovaya-up-work\\ib") > 0, "нет пути базы");
Если Ошибок = 0 Тогда
	Сообщить("OK: test_form_smoke");
Иначе
	ВызватьИсключение "FAIL: test_form_smoke " + Ошибок;
КонецЕсли;
