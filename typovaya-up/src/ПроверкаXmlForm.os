// Проверка структуры Form.xml (стек тегов) до ibcmd.
Функция ОчиститьДляСканXml(Текст)
	Т = СтрЗаменить(Текст, Символы.ВК, "");
	Рв = Новый РегулярноеВыражение("(?s)<!--.*?-->");
	Т = Рв.Заменить(Т, "");
	Возврат Т;
КонецФункции

// Пустая строка — валидно; иначе текст ошибки (mismatch / unclosed).
Функция ОшибкаСтруктурыXml(Текст) Экспорт
	Т = ОчиститьДляСканXml(Текст);
	Проп = Новый Соответствие;
	Для Каждого Тег Из СтрРазделить("Form,BaseForm,ChildItems,Attributes,Commands,Type,Columns,Column", ",") Цикл
		Проп.Вставить(Тег, Истина);
	КонецЦикла;
	Стек = Новый Массив;
	Рв = Новый РегулярноеВыражение("<(/?)([A-Za-z][\w:]*)\b([^>]*)>");
	Поз = 1;
	Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
		Закр = С.Группы[1].Значение = "/";
		Имя = С.Группы[2].Значение;
		Хв = С.Группы[3].Значение;
		Если Имя = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Закр Тогда
			Если Стек.Количество() = 0 Тогда
				Возврат "лишний </" + Имя + ">";
			КонецЕсли;
			Верх = Стек[Стек.ВГраница()];
			Если Верх <> Имя Тогда
				Возврат "ожидался </" + Верх + ">, получен </" + Имя + ">";
			КонецЕсли;
			Стек.Удалить(Стек.ВГраница());
		Иначе
			Самоз = Прав(СокрП(Хв), 1) = "/" Или СтрНайти(С.Значение, "/>") > 0;
			Если Не Самоз Тогда
				Стек.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Стек.Количество() > 0 Тогда
		Возврат "не закрыт <" + Стек[Стек.ВГраница()] + ">";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция XmlСтруктураВалидна(Текст) Экспорт
	Возврат ОшибкаСтруктурыXml(Текст) = "";
КонецФункции

Функция СканироватьСтруктуруКаталога(Корень) Экспорт
	Ошибки = Новый Массив;
	Файлов = 0;
	Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Forms\") = 0 И СтрНайти(Ф.ПолноеИмя, "\Ext\") = 0
			И СтрНайти(Ф.ПолноеИмя, "\CommonForms\") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Т = "";
		Попытка
			Т = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Ф.ПолноеИмя), "UTF-8");
		Исключение
			Ошибки.Добавить("READ	" + Ф.ПолноеИмя);
			Продолжить;
		КонецПопытки;
		Файлов = Файлов + 1;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(Корень) + 2);
		Ош = ОшибкаСтруктурыXml(Т);
		Если Ош <> "" Тогда
			Ошибки.Добавить("XML_STRUCTURE	" + Отн + "	" + Ош);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("files, errors, count", Файлов, Ошибки, Ошибки.Количество());
КонецФункции

Функция ВывестиИПровалить(Рез) Экспорт
	Сообщить("--- xml structure gate ---");
	Сообщить("form files: " + Рез.files + ", errors: " + Рез.count);
	Для Каждого Стр Из Рез.errors Цикл
		Сообщить(Стр);
	КонецЦикла;
	Если Рез.count > 0 Тогда
		ВызватьИсключение "xml_structure_gate: " + Рез.count;
	КонецЕсли;
	Сообщить("OK xml_structure_gate");
КонецФункции
