// oscript ЗапускTodoMissing.os <outRoot> <upRoot> <bpRoot> [check_modules.txt]
Корень = АргументыКоманднойСтроки[0];
Уп = АргументыКоманднойСтроки[1];
Бп = АргументыКоманднойСтроки[2];
Чм = "";
Если АргументыКоманднойСтроки.Количество() > 3 Тогда
	Чм = АргументыКоманднойСтроки[3];
КонецЕсли;
З = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "TodoMissingMetadata.os"));
Р = З.Сформировать(ОбъединитьПути(Корень, "restored"), Уп, Бп, Корень, Чм);
Сообщить("todo: " + Р.count + " -> " + Р.md);