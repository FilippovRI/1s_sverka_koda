// Пути метаданных из лога ibcmd import (stderr/stdout в файл).

Функция ПрочитатьЛог(Путь) Экспорт
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Тм = Новый ТекстовыйДокумент;
	Тм.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Тм.ПолучитьТекст();
КонецФункции

// Уникальные пути Document.X.TabularSection.Y, ChartOfCharacteristicTypes.X, …
Функция ПутьИзRefТипа(Преф, Имя)
	Если Преф = "CatalogRef" Тогда
		Возврат "Catalog." + Имя;
	ИначеЕсли Преф = "DocumentRef" Тогда
		Возврат "Document." + Имя;
	ИначеЕсли Преф = "DataProcessorRef" Тогда
		Возврат "DataProcessor." + Имя;
	ИначеЕсли Преф = "ReportRef" Тогда
		Возврат "Report." + Имя;
	ИначеЕсли Преф = "EnumRef" Тогда
		Возврат "Enum." + Имя;
	КонецЕсли;
	Возврат "";
КонецФункции

Процедура ДобПутьВСписок(Уник, Список, П)
	П = СокрЛП(П);
	Если П = "" Или Уник.Получить(П) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Уник.Вставить(П, Истина);
	Список.Добавить(П);
КонецПроцедуры

Функция ПутиНеизвестныхМетаданныхИзТекста(Текст) Экспорт
	Уник = Новый Соответствие;
	Список = Новый Массив;
	Рв = Новый РегулярноеВыражение("Неизвестный объект метаданных\s*-\s*([A-Za-zА-Яа-яЁё\w\.]+)");
	РвТип = Новый РегулярноеВыражение("Неизвестное имя типа\s*-\s*(CatalogRef|DocumentRef|DataProcessorRef|ReportRef|EnumRef)\.([\wЁёА-Яа-яA-Za-z0-9_]+)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			ДобПутьВСписок(Уник, Список, С.Группы[1].Значение);
		КонецЦикла;
		Для Каждого С Из РвТип.НайтиСовпадения(Стр) Цикл
			ДобПутьВСписок(Уник, Список, ПутьИзRefТипа(С.Группы[1].Значение, С.Группы[2].Значение));
		КонецЦикла;
	КонецЦикла;
	Возврат Список;
КонецФункции

Функция ПутиНеизвестныхМетаданных(ПутьЛога) Экспорт
	Возврат ПутиНеизвестныхМетаданныхИзТекста(ПрочитатьЛог(ПутьЛога));
КонецФункции

Функция ЗаписатьСписокДогрузки(Пути, ПутьФайла) Экспорт
	Т = "";
	Для Каждого П Из Пути Цикл
		Т = Т + П + Символы.ПС;
	КонецЦикла;
	СоздатьКаталог((Новый Файл(ПутьФайла)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, Ложь).Записать(ПутьФайла);
	Возврат Пути.Количество();
КонецФункции

// Дополнение restored по ibcmd import (основная или расширение).
Функция ДополнитьЗаготовкиПоЛогу(Корень, КореньБп, КореньУп, ПутьЛога, Лог) Экспорт
	Пути = ПутиНеизвестныхМетаданных(ПутьЛога);
	Если Пути.Количество() = 0 Тогда
		Возврат Новый Структура("paths, stubs, fragments", 0, 0, 0);
	КонецЕсли;
	ФайлСписка = ОбъединитьПути(Корень, "import_dogruzka.txt");
	ЗаписатьСписокДогрузки(Пути, ФайлСписка);
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Р = Заг.ДополнитьЗаготовки(Корень, КореньБп, Лог, КореньУп, ФайлСписка);
	Р.Вставить("paths", Пути.Количество());
	Р.Вставить("dogruzka", ФайлСписка);
	Возврат Р;
КонецФункции

Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Путь = АргументыКоманднойСтроки[0];
	Для Каждого П Из ПутиНеизвестныхМетаданных(Путь) Цикл
		Сообщить(П);
	КонецЦикла;
КонецЕсли;