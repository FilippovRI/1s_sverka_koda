// Пересборка всех заимствованных Form.xml расширения (BaseForm=load-e + слой УП).
КореньСк = ТекущийСценарий().Каталог;
Фр = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ФормыRestored.os"));
Черн = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ЧерновикРасширения.os"));
КореньУп = "D:\Выгрузка УП";
КореньОсн = "D:\Dtypovaya-up-load-e";
КореньБп = "D:\выгрузка БП";
КореньРасш = "D:\typovaya-up-out-20261118u\extension";
Пара = Новый Массив;
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Для Каждого А Из АргументыКоманднойСтроки Цикл
		Пара.Добавить(СокрЛП(А));
	КонецЦикла;
Иначе
	Пара.Добавить("");
КонецЕсли;
Список = Пара[0];
Н = 0;
Ош = 0;
Для Каждого Фм Из НайтиФайлы(КореньРасш, "*.xml", Истина) Цикл
	Если СтрНайти(Фм.ПолноеИмя, "\Forms\") = 0 Или СтрНайти(Фм.ПолноеИмя, "\Ext\") > 0 Тогда
		Продолжить;
	КонецЕсли;
	Мета = Фм.ПолноеИмя;
	Тм = Новый ТекстовыйДокумент;
	Попытка
		Тм.Прочитать(Мета, КодировкаТекста.UTF8);
	Исключение
		Продолжить;
	КонецПопытки;
	Если СтрНайти(Тм.ПолучитьТекст(), "Adopted") = 0 Тогда
		Продолжить;
	КонецЕсли;
	Отн = Сред(Мета, СтрДлина(КореньРасш) + 2);
	ПутьТела = ОбъединитьПути(КореньРасш, СтрЗаменить(Отн, ".xml", "") + "\Ext\Form.xml");
	Если Не (Новый Файл(ПутьТела)).Существует() Тогда
		Продолжить;
	КонецЕсли;
	Если Список <> "" И СтрНайти(Список, ПутьТела) = 0 И СтрНайти(Список, Отн) = 0 Тогда
		Продолжить;
	КонецЕсли;
	ПутьУп = ОбъединитьПути(КореньУп, Сред(ПутьТела, СтрДлина(КореньРасш) + 2));
	ПутьОсн = ОбъединитьПути(КореньОсн, Сред(ПутьТела, СтрДлина(КореньРасш) + 2));
	Если Не (Новый Файл(ПутьОсн)).Существует() Тогда
		ПутьОсн = ОбъединитьПути(КореньБп, Сред(ПутьТела, СтрДлина(КореньРасш) + 2));
	КонецЕсли;
	Если Не (Новый Файл(ПутьУп)).Существует() Или Не (Новый Файл(ПутьОсн)).Существует() Тогда
		Сообщить("SKIP нет УП/осн: " + Отн);
		Ош = Ош + 1;
		Продолжить;
	КонецЕсли;
	Т = Фр.XmlТелаЗаимствованнойФормыБпУп(ПутьУп, ПутьОсн, "УП_");
	Если Т <> "" Тогда
		ТОсн = Фр.ПрочитатьТекстUtf8(ПутьОсн);
		Т = Черн.ОчиститьКомандыСпискаЗаимствованной(Т, ТОсн).Текст;
		Т = Черн.УдалитьСсылкиНаРеквизитыЗаимствованной(Т).Текст;
	КонецЕсли;
	Если Т = "" Тогда
		Сообщить("FAIL пусто: " + Отн);
		Ош = Ош + 1;
		Продолжить;
	КонецЕсли;
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, Истина).Записать(ПутьТела);
	Н = Н + 1;
КонецЦикла;
Сообщить("Пересобрано: " + Н + ", пропусков/ошибок: " + Ош);