// Заимствованные Form.xml = копия БП; отличия УП — в Module.bsl (УП_СоздатьЭлементыУП).
КореньСк = ТекущийСценарий().Каталог;
Псл = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ФормыПрограммныйСлойУп.os"));
КореньУп = "D:\Выгрузка УП";
КореньОсн = "D:\Dtypovaya-up-load-e";
КореньБп = "D:\выгрузка БП";
КореньРасш = "D:\typovaya-up-out-20261118u\extension";
Префикс = "УП_";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	КореньРасш = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Стат = Новый Структура("forms, programmatic, unsupportedNotes", 0, 0, Новый Массив);
Н = 0;
Ош = 0;
Для Каждого Фм Из НайтиФайлы(КореньРасш, "Form.xml", Истина) Цикл
	Если СтрНайти(Фм.ПолноеИмя, "\Ext\Form.xml") = 0 Тогда
		Продолжить;
	КонецЕсли;
	ПутьТела = Фм.ПолноеИмя;
	ОтнТела = Сред(ПутьТела, СтрДлина(КореньРасш) + 2);
	Если СтрНайти(ОтнТела, "\Forms\") = 0 И СтрНайти(ОтнТела, "\CommonForms\") = 0 Тогда
		Продолжить;
	КонецЕсли;
	КаталогМета = СтрЗаменить(ОтнТела, "\Ext\Form.xml", ".xml");
	Мета = ОбъединитьПути(КореньРасш, КаталогМета);
	Если Не (Новый Файл(Мета)).Существует() Тогда
		Продолжить;
	КонецЕсли;
	Тм = Новый ТекстовыйДокумент;
	Попытка
		Тм.Прочитать(Мета, КодировкаТекста.UTF8);
	Исключение
		Продолжить;
	КонецПопытки;
	Заимств = СтрНайти(Тм.ПолучитьТекст(), "ObjectBelonging>Adopted") > 0 Или СтрНайти(Тм.ПолучитьТекст(), "<Adopted>") > 0;
	Если Не Заимств Тогда
		Продолжить;
	КонецЕсли;
	ПутьУп = ОбъединитьПути(КореньУп, ОтнТела);
	Если Не (Новый Файл(ПутьУп)).Существует() Тогда
		Сообщить("SKIP нет УП: " + ОтнТела);
		Ош = Ош + 1;
		Продолжить;
	КонецЕсли;
	ПутьОсн = ОбъединитьПути(КореньОсн, ОтнТела);
	ПутьБп = ОбъединитьПути(КореньБп, ОтнТела);
	Псл.ОбновитьФормуЗаимствованную(КореньРасш, ОтнТела, ПутьУп, ПутьОсн, ПутьБп, Префикс, Стат);
	Н = Н + 1;
КонецЦикла;
Отч = Новый ЗаписьJSON;
Отч.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
ЗаписатьJSON(Отч, Новый Структура("formsRebuilt, formsWithProgrammaticLayer, unsupported", Н, Стат.programmatic, Стат.unsupportedNotes));
ТекстОтч = Отч.Закрыть();
ПутьОтч = ОбъединитьПути(КореньРасш, "forms_programmatic.json");
ПолучитьДвоичныеДанныеИзСтроки(ТекстОтч, КодировкаТекста.UTF8, Истина).Записать(ПутьОтч);
Сообщить("Пересобрано: " + Н + ", программный слой: " + Стат.programmatic + ", пропусков: " + Ош);
Сообщить("Отчёт: " + ПутьОтч);