// Консервативная оценка переноса (&Вместо, CallRewrite). Только генератор отчёта/черновика, не runtime 1С.

// Добавлять ли «ПродолжитьВызов();» в конец тела &Вместо в черновике.
// Сейчас всегда Ложь: безусловный хвост давал бы лишний вызов типового метода.
Функция НуженПродолжитьВызовВЧерновике(Знач ТелоДоработанного) Экспорт
	Возврат Ложь;
КонецФункции

// Текстовая диагностика: что блокирует авто CallRewrite / перенаправление вызовов.
Функция ДиагностикаВызовов(Знач Тело) Экспорт
	Если СокрЛП(Тело) = "" Тогда
		Возврат "";
	КонецЕсли;
	Н = НРег(Тело);
	Заметки = Новый Массив;
	Если ЕстьГлобальныйВызов(Н, "выполнить") Тогда
		Заметки.Добавить("Выполнить() — динамический вызов, CallRewrite manual");
	КонецЕсли;
	Если ЕстьГлобальныйВызов(Н, "вычислить") Тогда
		Заметки.Добавить("Вычислить() — динамический вызов, CallRewrite manual");
	КонецЕсли;
	Если Заметки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрСоединить(Заметки, "; ");
КонецФункции

// Глобальный оператор Выполнить/Вычислить: перед именем нет «.» (с учётом переноса строки) и символа имени,
// после — не символ имени. Запрос.Выполнить(), Построитель.Выполнить(), ВыполнитьЧтоТо() — обычные вызовы.
// Н — текст в нижнем регистре.
Функция ЕстьГлобальныйВызов(Знач Н, Знач Имя) Экспорт
	Дл = СтрДлина(Имя);
	Всего = СтрДлина(Н);
	Поз = 1;
	Пока Поз <= Всего Цикл
		Найд = СтрНайти(Н, Имя, , Поз);
		Если Найд = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Поз = Найд + Дл;
		Если Найд > 1 И ЭтоСимволИмени(Сред(Н, Найд - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоСимволИмени(Сред(Н, Поз, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Пр = Найд - 1;
		Пока Пр >= 1 И ПустаяСтрока(Сред(Н, Пр, 1)) Цикл
			Пр = Пр - 1;
		КонецЦикла;
		Если Пр >= 1 И Сред(Н, Пр, 1) = "." Тогда
			Продолжить;
		КонецЕсли;
		Возврат Истина;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоСимволИмени(Знач С)
	Возврат С <> "" И СтрНайти("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_", С) > 0;
КонецФункции

// Ранний Возврат/Продолжить в теле (лексика, без анализа всех веток).
Функция ЕстьРаннийВыход(Знач Тело) Экспорт
	Н = НРег(РазборНорм(Тело));
	Возврат СтрНайти(Н, "возврат ") > 0 Или СтрНайти(Н, "продолжить;") > 0;
КонецФункции

Функция РазборНорм(Тело)
	Ч = Новый Массив;
	Для Каждого С Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		С2 = СокрЛП(С);
		Если С2 <> "" Тогда
			Ч.Добавить(С2);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Ч, " ");
КонецФункции

// Можно ли auto &Вместо с полным телом доработки (без доп. ПродолжитьВызов в черновике).
Функция ДопустимоАвтоВместо(Знач ТелоДоработанного) Экспорт
	Д = ДиагностикаВызовов(ТелоДоработанного);
	Возврат Д = "";
КонецФункции
