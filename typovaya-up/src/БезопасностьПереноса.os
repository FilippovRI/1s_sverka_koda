// Консервативная оценка переноса (&Вместо, CallRewrite). Только генератор отчёта/черновика, не runtime 1С.

// Добавлять ли «ПродолжитьВызов();» в конец тела &Вместо в черновике.
// Сейчас всегда Ложь: безусловный хвост давал бы лишний вызов типового метода.
Функция НуженПродолжитьВызовВЧерновике(Знач ТелоДоработанного) Экспорт
	Возврат Ложь;
КонецФункции

// Текстовая диагностика: что блокирует авто CallRewrite / перенаправление вызовов.
Функция ДиагностикаВызовов(Знач Тело) Экспорт
	Если СокрЛП(Тело) = "" Тогда
		Возврат "";
	КонецЕсли;
	Н = НРег(Тело);
	Заметки = Новый Массив;
	Если СтрНайти(Н, "выполнить(") > 0 Тогда
		Заметки.Добавить("Выполнить() — динамический вызов, CallRewrite manual");
	КонецЕсли;
	Если СтрНайти(Н, "вычислить(") > 0 Тогда
		Заметки.Добавить("Вычислить() — динамический вызов, CallRewrite manual");
	КонецЕсли;
	Если Заметки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрСоединить(Заметки, "; ");
КонецФункции

// Ранний Возврат/Продолжить в теле (лексика, без анализа всех веток).
Функция ЕстьРаннийВыход(Знач Тело) Экспорт
	Н = НРег(РазборНорм(Тело));
	Возврат СтрНайти(Н, "возврат ") > 0 Или СтрНайти(Н, "продолжить;") > 0;
КонецФункции

Функция РазборНорм(Тело)
	Ч = Новый Массив;
	Для Каждого С Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		С2 = СокрЛП(С);
		Если С2 <> "" Тогда
			Ч.Добавить(С2);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Ч, " ");
КонецФункции

// Можно ли auto &Вместо с полным телом доработки (без доп. ПродолжитьВызов в черновике).
Функция ДопустимоАвтоВместо(Знач ТелоДоработанного) Экспорт
	Д = ДиагностикаВызовов(ТелоДоработанного);
	Возврат Д = "";
КонецФункции
