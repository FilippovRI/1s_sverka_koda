// Перенос в расширение методов общих модулей (и простых вызовов менеджеров),
// на которые ссылается код расширения, которых нет в typovaya (restored), но есть в УП.
// Метод добавляется как УП_<Имя> в заимствованный общий модуль, вызовы переписываются
// на Модуль.УП_<Имя>. В телах ИиК переписываются только вызовы в #Вставка
// (неизменённая часть и #Удаление не трогаются — контроль «текст метода не соответствует»).

Перем Разбор;
Перем ПереносСигнатур;
Перем Мелкие;
Перем ПрефиксПоУмолчанию;

Процедура Инициализировать(МодульРазбора, МодульПереносаСигнатур = Неопределено, МодульМелких = Неопределено) Экспорт
	Разбор = МодульРазбора;
	ПереносСигнатур = МодульПереносаСигнатур;
	Мелкие = МодульМелких;
	ПрефиксПоУмолчанию = "УП_";
КонецПроцедуры

Функция ПрефиксИлиУмолчание(Префикс)
	Если СокрЛП(Строка(Префикс)) = "" Тогда
		Возврат ПрефиксПоУмолчанию;
	КонецЕсли;
	Возврат Префикс;
КонецФункции

// Применить к готовому расширению. КаталогУп — выгрузка УП (только чтение).
// Возвращает структуру отчёта: calls, transferred, skipped, rewritten, reportPath, ok.
Функция Применить(КаталогРасш, КаталогВосст, КаталогУп, Префикс = "УП_", Лог = Неопределено, КаталогОтчёта = "", ИмяРасширения = "УП_Доработки") Экспорт
	Пр = ПрефиксИлиУмолчание(Префикс);
	Отчёт = ПустойОтчёт();
	Если Не (Новый Файл(КаталогРасш)).Существует() Или Не (Новый Файл(КаталогВосст)).Существует() Или Не (Новый Файл(КаталогУп)).Существует() Тогда
		Отчёт.ok = Ложь;
		Отчёт.reason = "нет каталога extension/restored/УП";
		ДобавитьЛог(Лог, "ПереносОтсутствующихМетодов: " + Отчёт.reason);
		Возврат Отчёт;
	КонецЕсли;
	Индекс = Новый Структура("Расш, Восст, Уп, Корни, КэшПапок",
		ИндексОбщихМодулей(КаталогРасш), ИндексОбщихМодулей(КаталогВосст), ИндексОбщихМодулей(КаталогУп),
		Новый Структура("Расш, Восст, Уп", КаталогРасш, КаталогВосст, КаталогУп),
		Новый Соответствие);
	КэшМетодов = Новый Структура("Расш, Восст, Уп", Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Очередь = Новый Массив;
	Виден = Новый Соответствие;
	СобратьВызовыКаталога(КаталогРасш, Индекс, КэшМетодов, Очередь, Виден, Отчёт, Истина);
	// транзитивно: методы, которые переносим, тоже анализируем
	Й = 0;
	Пока Й < Очередь.Количество() Цикл
		Э = Очередь[Й];
		Если Э.Действие <> "перенести" Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		ТекстУп = ТекстМетодаУп(Э, Индекс, КэшМетодов);
		Если ТекстУп <> "" Тогда
			СобратьВызовыИзТекстаВОчередь(ТекстУп, Индекс, КэшМетодов, Очередь, Виден, Отчёт, Ложь, "plain", Э.Модуль);
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	// перенос
	Для Каждого Э Из Очередь Цикл
		Если Э.Действие = "перенести" Тогда
			Р = ПеренестиМетод(Э, КаталогРасш, КаталогВосст, КаталогУп, Пр, ИмяРасширения, Индекс, КэшМетодов, Лог);
			Если Р.ok Тогда
				Э.Куда = Р.куда;
				Отчёт.transferred.Добавить(Э);
				Если Р.Свойство("adopted") И Р.adopted И Р.Свойство("adoptedName") Тогда
					Если Отчёт.adopted.Найти(Р.adoptedName) = Неопределено Тогда
						Отчёт.adopted.Добавить(Р.adoptedName);
					КонецЕсли;
				КонецЕсли;
				Индекс.Расш = ИндексОбщихМодулей(КаталогРасш);
				КэшМетодов.Расш.Удалить(НРег(Э.Модуль));
				КэшМетодов.Расш.Удалить(КлючКэшаМенеджера(Э));
			Иначе
				Э.Действие = "пропуск";
				Э.Причина = Р.reason;
				Отчёт.skipped.Добавить(Э);
			КонецЕсли;
		ИначеЕсли Э.Действие = "уже_в_расширении" Тогда
			Э.Куда = Э.Модуль + "." + ИмяВРасширении(Э, Пр, Индекс, КэшМетодов);
			Отчёт.transferred.Добавить(Э);
		Иначе
			Отчёт.skipped.Добавить(Э);
		КонецЕсли;
	КонецЦикла;
	// перепись вызовов во всех bsl расширения
	Карты = СобратьКартыПереписи(Отчёт.transferred, Пр);
	Если Карты.Квалифицированные.Количество() > 0 Или Карты.ЛокальныеПоМодулю.Количество() > 0 Тогда
		Файлы = НайтиФайлы(КаталогРасш, "*.bsl", Истина);
		Для Каждого Ф Из Файлы Цикл
			Текст = ПрочитатьФайл(Ф.ПолноеИмя);
			Лок = ЛокальнаяКартаДляФайла(Ф.ПолноеИмя, КаталогРасш, Карты.ЛокальныеПоМодулю);
			НовыйТекст = ПереписатьВызовыВРасширении(Текст, Лок, Карты.Квалифицированные);
			Если НовыйТекст.Текст <> Текст Тогда
				ЗаписатьФайл(Ф.ПолноеИмя, НовыйТекст.Текст);
				Отчёт.rewritten = Отчёт.rewritten + НовыйТекст.count;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Отчёт.calls = Отчёт.transferred.Количество() + Отчёт.skipped.Количество();
	Отчёт.ok = Истина;
	Если КаталогОтчёта <> "" Тогда
		Отчёт.reportPath = ЗаписатьОтчёт(КаталогОтчёта, Отчёт);
	КонецЕсли;
	ДобавитьЛог(Лог, "ПереносОтсутствующихМетодов: вызовов/методов " + Отчёт.calls
		+ ", перенесено " + Отчёт.transferred.Количество() + ", заимствовано объектов " + Отчёт.adopted.Количество()
		+ ", пропуск " + Отчёт.skipped.Количество() + ", переписано вызовов " + Отчёт.rewritten);
	Возврат Отчёт;
КонецФункции

Функция ПустойОтчёт()
	Возврат Новый Структура("ok, reason, calls, rewritten, transferred, skipped, adopted, reportPath",
		Ложь, "", 0, 0, Новый Массив, Новый Массив, Новый Массив, "");
КонецФункции

Процедура ДобавитьЛог(Лог, Текст)
	Если Лог <> Неопределено Тогда
		Лог.Добавить(Текст);
	КонецЕсли;
КонецПроцедуры

Функция ИндексОбщихМодулей(Корень) Экспорт
	Рез = Новый Соответствие;
	Кат = ОбъединитьПути(Корень, "CommonModules");
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Каталоги = НайтиФайлы(Кат, "*");
	Для Каждого Д Из Каталоги Цикл
		Если Не Д.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Путь = ОбъединитьПути(ОбъединитьПути(Д.ПолноеИмя, "Ext"), "Module.bsl");
		Рез.Вставить(НРег(Д.Имя), Новый Структура("Имя, Путь, Есть", Д.Имя, Путь, (Новый Файл(Путь)).Существует()));
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция МетодыФайла(Путь, Кэш, КлючКэша)
	Если Кэш.Получить(КлючКэша) <> Неопределено Тогда
		Возврат Кэш.Получить(КлючКэша);
	КонецЕсли;
	Карта = Новый Соответствие;
	Если Путь <> "" И (Новый Файл(Путь)).Существует() Тогда
		Текст = ПрочитатьФайл(Путь);
		Разобр = Разбор.РазобратьМодуль(Текст);
		Для Каждого Мт Из Разобр.Методы Цикл
			Карта.Вставить(НРег(Мт.Имя), Мт);
		КонецЦикла;
	КонецЕсли;
	Кэш.Вставить(КлючКэша, Карта);
	Возврат Карта;
КонецФункции

Функция МетодыКорня(ИндексКорня, КэшКорня, ИмяМодуля)
	Опис = ИндексКорня.Получить(НРег(ИмяМодуля));
	Если Опис = Неопределено Или Не Опис.Есть Тогда
		Возврат МетодыФайла("", КэшКорня, НРег(ИмяМодуля));
	КонецЕсли;
	Возврат МетодыФайла(Опис.Путь, КэшКорня, НРег(ИмяМодуля));
КонецФункции

Функция ЕстьМетод(Карта, Имя)
	Возврат Карта.Получить(НРег(Имя)) <> Неопределено;
КонецФункции

Функция ИмяСПрефиксом(Префикс, Имя)
	Если СтрНачинаетсяС(НРег(Имя), НРег(Префикс)) Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат Префикс + Имя;
КонецФункции

Процедура СобратьВызовыКаталога(КаталогРасш, Индекс, КэшМетодов, Очередь, Виден, Отчёт, УчитыватьОбласть)
	Файлы = НайтиФайлы(КаталогРасш, "*.bsl", Истина);
	Для Каждого Ф Из Файлы Цикл
		Текст = ПрочитатьФайл(Ф.ПолноеИмя);
		СобратьВызовыИзТекстаВОчередь(Текст, Индекс, КэшМетодов, Очередь, Виден, Отчёт, УчитыватьОбласть, "", "");
	КонецЦикла;
КонецПроцедуры

Процедура СобратьВызовыИзТекстаВОчередь(Текст, Индекс, КэшМетодов, Очередь, Виден, Отчёт, УчитыватьОбласть, ОбластьПоУмолчанию, МодульКонтекста = "")
	Вызовы = СобратьКвалифицированныеВызовы(Текст, УчитыватьОбласть, ОбластьПоУмолчанию);
	Для Каждого В Из Вызовы Цикл
		КлассифицироватьИПоставитьВОчередь(В, Индекс, КэшМетодов, Очередь, Виден, МодульКонтекста);
	КонецЦикла;
КонецПроцедуры

Процедура КлассифицироватьИПоставитьВОчередь(Вызов, Индекс, КэшМетодов, Очередь, Виден, МодульКонтекста = "")
	Части = Вызов.Части;
	Если Части.Количество() = 1 И МодульКонтекста <> "" И СтрНайти(МодульКонтекста, ".") = 0 Тогда
		Если ЭтоСлужебноеИмяВызова(Части[0]) Тогда
			Возврат;
		КонецЕсли;
		Вызов.Части = Новый Массив;
		Вызов.Части.Добавить(МодульКонтекста);
		Вызов.Части.Добавить(Части[0]);
		Части = Вызов.Части;
	КонецЕсли;
	Если Части.Количество() = 2 Тогда
		Модуль = Части[0];
		Метод = Части[1];
		Если СтрНачинаетсяС(НРег(Метод), "уп_") Тогда
			Возврат; // уже переписанный вызов
		КонецЕсли;
		Если Индекс.Расш.Получить(НРег(Модуль)) = Неопределено
			И Индекс.Восст.Получить(НРег(Модуль)) = Неопределено
			И Индекс.Уп.Получить(НРег(Модуль)) = Неопределено Тогда
			Возврат; // не общий модуль
		КонецЕсли;
		Ключ = НРег(Модуль) + "." + НРег(Метод);
		Если Виден.Получить(Ключ) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		Виден.Вставить(Ключ, Истина);
		Э = Новый Структура("Модуль, Метод, Цепочка, Действие, Причина, Куда, Область, Источники",
			Модуль, Метод, Модуль + "." + Метод, "", "", "", Вызов.Область, 1);
		МВосст = МетодыКорня(Индекс.Восст, КэшМетодов.Восст, Модуль);
		Если ЕстьМетод(МВосст, Метод) Тогда
			Возврат; // есть в typovaya — не наша дыра
		КонецЕсли;
		МРасш = МетодыКорня(Индекс.Расш, КэшМетодов.Расш, Модуль);
		МУп = МетодыКорня(Индекс.Уп, КэшМетодов.Уп, Модуль);
		Если ЕстьМетод(МРасш, "УП_" + Метод) Тогда
			Э.Действие = "уже_в_расширении";
			Э.Причина = "уже есть УП_" + Метод;
			Очередь.Добавить(Э);
			Возврат;
		КонецЕсли;
		Если ЕстьМетод(МРасш, Метод) Тогда
			Э.Действие = "уже_в_расширении";
			Э.Причина = "уже есть в расширении под исходным именем";
			Очередь.Добавить(Э);
			Возврат;
		КонецЕсли;
		Если Не ЕстьМетод(МУп, Метод) Тогда
			Э.Действие = "пропуск";
			Э.Причина = "метода нет в выгрузке УП и нет в restored";
			Очередь.Добавить(Э);
			Возврат;
		КонецЕсли;
		Э.Действие = "перенести";
		Очередь.Добавить(Э);
		Возврат;
	КонецЕсли;
	Если Части.Количество() = 1 И СтрНайти(МодульКонтекста, ".") > 0 Тогда
		// локальный вызов внутри перенесённого метода менеджера: Справочники.Объект + Метод
		Чк = СтрРазделить(МодульКонтекста, ".");
		Если Чк.Количество() = 2 Тогда
			Новые = Новый Массив;
			Новые.Добавить(Чк[0]);
			Новые.Добавить(Чк[1]);
			Новые.Добавить(Части[0]);
			Части = Новые;
			Вызов.Части = Части;
		КонецЕсли;
	КонецЕсли;
	Если Части.Количество() = 3 Тогда
		ВидМен = ОписаниеВидаМенеджера(Части[0]);
		Если ВидМен = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если СтрНачинаетсяС(НРег(Части[2]), "уп_") Тогда
			Возврат;
		КонецЕсли;
		Ключ = НРег(ВидМен.Папка) + "." + НРег(Части[1]) + "." + НРег(Части[2]);
		Если Виден.Получить(Ключ) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		Виден.Вставить(Ключ, Истина);
		Э = Новый Структура("Модуль, Метод, Цепочка, Действие, Причина, Куда, Область, Источники, Вид, Тег, Папка, ИмяОбъекта",
			Части[0] + "." + Части[1], Части[2], Части[0] + "." + Части[1] + "." + Части[2],
			"", "", "", Вызов.Область, 1, "mgr", ВидМен.Тег, ВидМен.Папка, Части[1]);
		Если Не ОбъектЕстьВКаталоге(Индекс.Корни.Восст, ВидМен.Папка, Части[1]) Тогда
			МУпНет = МетодыМенеджера(Индекс, КэшМетодов, "Уп", Э);
			Если Не ЕстьМетод(МУпНет, Части[2]) Тогда
				Возврат; // платформенный метод менеджера у объекта, которого нет в typovaya
			КонецЕсли;
			Э.Действие = "пропуск";
			Э.Причина = "объекта " + ВидМен.Папка + "." + Части[1] + " нет в restored";
			Очередь.Добавить(Э);
			Возврат;
		КонецЕсли;
		МВосст = МетодыМенеджера(Индекс, КэшМетодов, "Восст", Э);
		Если ЕстьМетод(МВосст, Части[2]) Тогда
			Возврат; // метод есть в typovaya
		КонецЕсли;
		МРасш = МетодыМенеджера(Индекс, КэшМетодов, "Расш", Э);
		Если ЕстьМетод(МРасш, "УП_" + Части[2]) Тогда
			Э.Действие = "уже_в_расширении";
			Э.Причина = "уже есть УП_" + Части[2];
			Очередь.Добавить(Э);
			Возврат;
		КонецЕсли;
		Если ЕстьМетод(МРасш, Части[2]) Тогда
			Э.Действие = "уже_в_расширении";
			Э.Причина = "уже есть в расширении под исходным именем";
			Очередь.Добавить(Э);
			Возврат;
		КонецЕсли;
		МУп = МетодыМенеджера(Индекс, КэшМетодов, "Уп", Э);
		Если Не ЕстьМетод(МУп, Части[2]) Тогда
			Возврат; // платформенный метод менеджера (СоздатьЭлемент, НайтиПоКоду, …)
		КонецЕсли;
		Э.Действие = "перенести";
		Очередь.Добавить(Э);
	КонецЕсли;
КонецПроцедуры

Функция ОписаниеВидаМенеджера(Имя) Экспорт
	Н = НРег(Имя);
	Пары = "документы:Document:Documents,documents:Document:Documents,"
		+ "справочники:Catalog:Catalogs,catalogs:Catalog:Catalogs,"
		+ "регистрысведений:InformationRegister:InformationRegisters,informationregisters:InformationRegister:InformationRegisters,"
		+ "регистрынакопления:AccumulationRegister:AccumulationRegisters,accumulationregisters:AccumulationRegister:AccumulationRegisters,"
		+ "регистрыбухгалтерии:AccountingRegister:AccountingRegisters,accountingregisters:AccountingRegister:AccountingRegisters,"
		+ "регистрырасчета:CalculationRegister:CalculationRegisters,calculationregisters:CalculationRegister:CalculationRegisters,"
		+ "отчеты:Report:Reports,reports:Report:Reports,"
		+ "обработки:DataProcessor:DataProcessors,dataprocessors:DataProcessor:DataProcessors,"
		+ "планывидовхарактеристик:ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,chartsofcharacteristictypes:ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,"
		+ "планысчетов:ChartOfAccounts:ChartsOfAccounts,chartsofaccounts:ChartOfAccounts:ChartsOfAccounts,"
		+ "планывидоврасчета:ChartOfCalculationTypes:ChartsOfCalculationTypes,chartsofcalculationtypes:ChartOfCalculationTypes:ChartsOfCalculationTypes,"
		+ "бизнеспроцессы:BusinessProcess:BusinessProcesses,businessprocesses:BusinessProcess:BusinessProcesses,"
		+ "задачи:Task:Tasks,tasks:Task:Tasks,"
		+ "планыобмена:ExchangePlan:ExchangePlans,exchangeplans:ExchangePlan:ExchangePlans,"
		+ "журналыдокументов:DocumentJournal:DocumentJournals,documentjournals:DocumentJournal:DocumentJournals,"
		+ "перечисления:Enum:Enums,enums:Enum:Enums,"
		+ "константы:Constant:Constants,constants:Constant:Constants";
	Для Каждого П Из СтрРазделить(Пары, ",") Цикл
		Ч = СтрРазделить(П, ":");
		Если Ч.Количество() = 3 И Ч[0] = Н Тогда
			Возврат Новый Структура("Тег, Папка", Ч[1], Ч[2]);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция КлючКэшаМенеджера(Э)
	Если Э = Неопределено Или Не Э.Свойство("Вид") Или Э.Вид <> "mgr" Тогда
		Возврат "";
	КонецЕсли;
	Возврат "mgr:" + НРег(Э.Папка) + "/" + НРег(Э.ИмяОбъекта);
КонецФункции

Функция ИмяВПапке(Корень, Папка, Имя, КэшПапок)
	Ключ = НРег(Корень) + "|" + НРег(Папка);
	Карта = КэшПапок.Получить(Ключ);
	Если Карта = Неопределено Тогда
		Карта = Новый Соответствие;
		Кат = ОбъединитьПути(Корень, Папка);
		Если (Новый Файл(Кат)).Существует() Тогда
			Для Каждого Ф Из НайтиФайлы(Кат, "*") Цикл
				ИмяФ = Ф.Имя;
				Если СтрЗаканчиваетсяНа(НРег(ИмяФ), ".xml") Тогда
					ИмяФ = Лев(ИмяФ, СтрДлина(ИмяФ) - 4);
				ИначеЕсли Не Ф.ЭтоКаталог() Тогда
					Продолжить;
				КонецЕсли;
				Карта.Вставить(НРег(ИмяФ), ИмяФ);
			КонецЦикла;
		КонецЕсли;
		КэшПапок.Вставить(Ключ, Карта);
	КонецЕсли;
	Возврат Карта.Получить(НРег(Имя));
КонецФункции

Функция ПутьМодуляМенеджера(Корень, Папка, Имя, КэшПапок)
	ИмяФакт = ИмяВПапке(Корень, Папка, Имя, КэшПапок);
	Если ИмяФакт = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, Папка), ИмяФакт), "Ext"), "ManagerModule.bsl");
КонецФункции

Функция МетодыМенеджера(Индекс, КэшМетодов, ИмяКорня, Э)
	Ключ = КлючКэшаМенеджера(Э);
	Кэш = ?(ИмяКорня = "Расш", КэшМетодов.Расш, ?(ИмяКорня = "Восст", КэшМетодов.Восст, КэшМетодов.Уп));
	Если Ключ <> "" И Кэш.Получить(Ключ) <> Неопределено Тогда
		Возврат Кэш.Получить(Ключ);
	КонецЕсли;
	Корень = ?(ИмяКорня = "Расш", Индекс.Корни.Расш, ?(ИмяКорня = "Восст", Индекс.Корни.Восст, Индекс.Корни.Уп));
	Путь = ПутьМодуляМенеджера(Корень, Э.Папка, Э.ИмяОбъекта, Индекс.КэшПапок);
	Карта = МетодыФайла(Путь, Кэш, ?(Ключ = "", НРег(Путь), Ключ));
	Возврат Карта;
КонецФункции

Функция ТекстМетодаУп(Э, Индекс, КэшМетодов)
	Если Э.Свойство("Вид") И Э.Вид = "mgr" Тогда
		М = МетодыМенеджера(Индекс, КэшМетодов, "Уп", Э);
	Иначе
		М = МетодыКорня(Индекс.Уп, КэшМетодов.Уп, Э.Модуль);
	КонецЕсли;
	Мт = М.Получить(НРег(Э.Метод));
	Если Мт = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Мт.Текст;
КонецФункции

Функция ИмяВРасширении(Э, Префикс, Индекс, КэшМетодов)
	Если Э.Свойство("Вид") И Э.Вид = "mgr" Тогда
		М = МетодыМенеджера(Индекс, КэшМетодов, "Расш", Э);
	Иначе
		М = МетодыКорня(Индекс.Расш, КэшМетодов.Расш, Э.Модуль);
	КонецЕсли;
	Если ЕстьМетод(М, "УП_" + Э.Метод) Или Э.Действие = "перенести" Тогда
		Возврат ИмяСПрефиксом(Префикс, Э.Метод);
	КонецЕсли;
	Если ЕстьМетод(М, Э.Метод) Тогда
		Возврат Э.Метод;
	КонецЕсли;
	Возврат ИмяСПрефиксом(Префикс, Э.Метод);
КонецФункции

Функция ПеренестиМетод(Э, КаталогРасш, КаталогВосст, КаталогУп, Префикс, ИмяРасширения, Индекс, КэшМетодов, Лог)
	Р = Новый Структура("ok, reason, куда, adopted, adoptedName", Ложь, "", "", Ложь, "");
	ТекстУп = ТекстМетодаУп(Э, Индекс, КэшМетодов);
	Если ТекстУп = "" Тогда
		Р.reason = "не удалось прочитать тело метода в УП";
		Возврат Р;
	КонецЕсли;
	ПроблемаМета = МетаданныеОтсутствуютВБп(ТекстУп, КаталогВосст);
	Если ПроблемаМета <> "" Тогда
		Р.reason = ПроблемаМета;
		Возврат Р;
	КонецЕсли;
	ЭтоМен = Э.Свойство("Вид") И Э.Вид = "mgr";
	Если ЭтоМен Тогда
		ИмяФакт = ИмяВПапке(КаталогВосст, Э.Папка, Э.ИмяОбъекта, Индекс.КэшПапок);
		Если ИмяФакт = Неопределено Тогда
			Р.reason = "объекта " + Э.Папка + "." + Э.ИмяОбъекта + " нет в restored";
			Возврат Р;
		КонецЕсли;
		ПутьXmlРасш = ОбъединитьПути(ОбъединитьПути(КаталогРасш, Э.Папка), ИмяФакт + ".xml");
		Если Не (Новый Файл(ПутьXmlРасш)).Существует() Тогда
			Если Мелкие = Неопределено Тогда
				Р.reason = "объект не заимствован в расширении, нет механизма заимствования";
				Возврат Р;
			КонецЕсли;
			Созд = Мелкие.ЗаимствоватьОбъект(КаталогРасш, КаталогВосст, ИмяРасширения, Э.Тег, ИмяФакт);
			Если Не (Новый Файл(ПутьXmlРасш)).Существует() Тогда
				Р.reason = "не удалось заимствовать " + Э.Тег + "." + ИмяФакт;
				Возврат Р;
			КонецЕсли;
			Если Созд > 0 Тогда
				Р.adopted = Истина;
				Р.adoptedName = Э.Тег + "." + ИмяФакт;
			КонецЕсли;
		КонецЕсли;
		КатExt = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КаталогРасш, Э.Папка), ИмяФакт), "Ext");
		СоздатьКаталог(КатExt);
		Путь = ОбъединитьПути(КатExt, "ManagerModule.bsl");
		НовоеИмя = ИмяСПрефиксом(Префикс, Э.Метод);
		Копия = ТекстКопииУп(Э.Метод, НовоеИмя, ТекстУп);
		ВставитьМетодВМодуль(Путь, НовоеИмя, Копия);
		Р.ok = Истина;
		Р.куда = Э.Модуль + "." + НовоеИмя + " (" + Э.Папка + "/" + ИмяФакт + "/Ext/ManagerModule.bsl)";
		Возврат Р;
	КонецЕсли;
	Если Индекс.Расш.Получить(НРег(Э.Модуль)) = Неопределено Тогда
		Если Индекс.Восст.Получить(НРег(Э.Модуль)) = Неопределено Тогда
			Р.reason = "общего модуля нет в restored, заимствовать нечего (не переносим целый отсутствующий модуль здесь)";
			Возврат Р;
		КонецЕсли;
		Если Мелкие = Неопределено Тогда
			Р.reason = "модуль не заимствован в расширении, нет механизма заимствования";
			Возврат Р;
		КонецЕсли;
		ИмяФакт = Индекс.Восст.Получить(НРег(Э.Модуль)).Имя;
		Созд = Мелкие.ЗаимствоватьОбъект(КаталогРасш, КаталогВосст, ИмяРасширения, "CommonModule", ИмяФакт);
		Если Созд > 0 Тогда
			Р.adopted = Истина;
			Р.adoptedName = "CommonModule." + ИмяФакт;
		КонецЕсли;
	КонецЕсли;
	Индекс.Расш = ИндексОбщихМодулей(КаталогРасш);
	ОписРасш = Индекс.Расш.Получить(НРег(Э.Модуль));
	Если ОписРасш = Неопределено Тогда
		Р.reason = "не удалось заимствовать общий модуль " + Э.Модуль;
		Возврат Р;
	КонецЕсли;
	КатExt = ОбъединитьПути(ОбъединитьПути(КаталогРасш, "CommonModules"), ОписРасш.Имя);
	КатExt = ОбъединитьПути(КатExt, "Ext");
	СоздатьКаталог(КатExt);
	Путь = ОбъединитьПути(КатExt, "Module.bsl");
	НовоеИмя = ИмяСПрефиксом(Префикс, Э.Метод);
	Копия = ТекстКопииУп(Э.Метод, НовоеИмя, ТекстУп);
	Если Не ВставитьМетодВМодуль(Путь, НовоеИмя, Копия) Тогда
		Р.reason = "метод " + НовоеИмя + " уже был в модуле расширения";
		Р.ok = Истина;
		Р.куда = Э.Модуль + "." + НовоеИмя;
		Возврат Р;
	КонецЕсли;
	Р.ok = Истина;
	Р.куда = Э.Модуль + "." + НовоеИмя + " (CommonModules/" + ОписРасш.Имя + "/Ext/Module.bsl)";
	Возврат Р;
КонецФункции

Функция ТекстКопииУп(Имя, НовоеИмя, ТекстМетода)
	Если ПереносСигнатур <> Неопределено Тогда
		Мт = Новый Структура("name, kind, sourceText, preprocPrefixSource, preprocSuffixSource",
			Имя, ВидМетодаИзТекста(ТекстМетода), ТекстМетода, "", "");
		Коп = ПереносСигнатур.ТекстКопииУп(Мт, ""); // переименуем сами — префикс уже в НовоеИмя
		// ТекстКопииУп делает Префикс+Имя; если Префикс="", имя не изменится. Переименуем явно.
	КонецЕсли;
	Текст = ПереименоватьОбъявлениеПросто(ТекстМетода, Имя, НовоеИмя);
	Текст = ОбеспечитьЭкспортПросто(Текст, НовоеИмя);
	Возврат Текст;
КонецФункции

Функция ВидМетодаИзТекста(Текст)
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Объ = Разбор.РазобратьОбъявление(Стр);
		Если Объ <> Неопределено Тогда
			Возврат Объ.Вид;
		КонецЕсли;
	КонецЦикла;
	Возврат "Процедура";
КонецФункции

Функция ПереименоватьОбъявлениеПросто(Знач Текст, Имя, НовоеИмя)
	Если ПереносСигнатур <> Неопределено Тогда
		Мт = Новый Структура("name, kind, sourceText", Имя, ВидМетодаИзТекста(Текст), Текст);
		// используем публичный ТекстКопииУп с искусственным префиксом равным НовоеИмя без Имя? Нет: он делает Префикс+Имя.
		// Если НовоеИмя = УП_+Имя и Префикс=УП_, это то что нужно, плюс ОбеспечитьЭкспорт.
		Если СтрНачинаетсяС(НРег(НовоеИмя), "уп_") И НРег(НовоеИмя) = НРег("УП_" + Имя) Тогда
			Возврат ПереносСигнатур.ТекстКопииУп(Мт, "УП_");
		КонецЕсли;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Объ = Разбор.РазобратьОбъявление(Строки[Й]);
		Если Объ = Неопределено Или НРег(Объ.Имя) <> НРег(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Строки[Й] = СтрЗаменитьИмяВОбъявлении(Строки[Й], Имя, НовоеИмя);
		Прервать;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция СтрЗаменитьИмяВОбъявлении(Стр, Имя, НовоеИмя)
	Н = НРег(Стр);
	Ни = НРег(Имя);
	Поз = СтрНайти(Н, Ни);
	Пока Поз > 0 Цикл
		Перед = ?(Поз = 1, "", Сред(Стр, Поз - 1, 1));
		После = Сред(Стр, Поз + СтрДлина(Имя), 1);
		Если Не ЭтоСимволИдентификатора(Перед) И Не ЭтоСимволИдентификатора(После) Тогда
			Возврат Лев(Стр, Поз - 1) + НовоеИмя + Сред(Стр, Поз + СтрДлина(Имя));
		КонецЕсли;
		ДальшеОтн = СтрНайти(Сред(Н, Поз + 1), Ни);
		Дальше = ?(ДальшеОтн = 0, 0, Поз + ДальшеОтн);
		Если Дальше = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = Дальше;
	КонецЦикла;
	Возврат Стр;
КонецФункции

Функция ЭтоСимволИдентификатора(С)
	Если С = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	К = КодСимвола(С);
	Возврат (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или (К >= 48 И К <= 57)
		Или (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105 Или С = "_";
КонецФункции

Функция ОбеспечитьЭкспортПросто(Знач Текст, Имя)
	Если ПереносСигнатур <> Неопределено И СтрНайти(НРег(Текст), "процедура уп_") + СтрНайти(НРег(Текст), "функция уп_") > 0 Тогда
		// ТекстКопииУп уже добавил Экспорт
		Если СтрНайти(НРег(Текст), "экспорт") > 0 Тогда
			Возврат Текст;
		КонецЕсли;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Объ = Разбор.РазобратьОбъявление(Строки[Й]);
		Если Объ = Неопределено Или НРег(Объ.Имя) <> НРег(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(НРег(Разбор.УбратьКомментарий(Строки[Й])), "экспорт") > 0 Тогда
			Возврат Текст;
		КонецЕсли;
		Стр = Строки[Й];
		Ком = СтрНайти(Стр, "//");
		Если Ком > 0 Тогда
			Строки[Й] = СокрП(Лев(Стр, Ком - 1)) + " Экспорт " + Сред(Стр, Ком);
		Иначе
			Строки[Й] = СокрП(Стр) + " Экспорт";
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ВставитьМетодВМодуль(Путь, ИмяМетода, ТекстМетода) Экспорт
	Если (Новый Файл(Путь)).Существует() Тогда
		Текст = ПрочитатьФайл(Путь);
	Иначе
		Текст = "";
	КонецЕсли;
	Если СтрНайти(НРег(Текст), НРег("Процедура " + ИмяМетода + "(")) > 0
		Или СтрНайти(НРег(Текст), НРег("Функция " + ИмяМетода + "(")) > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	НЛ = Символы.ПС;
	Если СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0 Тогда
		НЛ = Символы.ВК + Символы.ПС;
	КонецЕсли;
	Обёртка = Разбор.НайтиОбёрткуМодуля(Текст);
	Если Обёртка.Есть Тогда
		Строки = СтрРазделить(Текст, Символы.ПС, Истина);
		Вст = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
		Новые = Новый Массив;
		Для Й = 0 По Обёртка.ИндексКонца - 1 Цикл
			Новые.Добавить(Строки[Й]);
		КонецЦикла;
		Если Новые.Количество() > 0 И СокрЛП(Новые[Новые.ВГраница()]) <> "" Тогда
			Новые.Добавить("");
		КонецЕсли;
		Для Каждого С Из Вст Цикл
			Новые.Добавить(С);
		КонецЦикла;
		Новые.Добавить("");
		Для Й = Обёртка.ИндексКонца По Строки.ВГраница() Цикл
			Новые.Добавить(Строки[Й]);
		КонецЦикла;
		ЗаписатьФайл(Путь, СтрСоединить(Новые, НЛ));
		Возврат Истина;
	КонецЕсли;
	Хвост = ?(Текст = "" Или Прав(Текст, СтрДлина(НЛ)) = НЛ, "", НЛ);
	ЗаписатьФайл(Путь, Текст + Хвост + НЛ + ТекстМетода + НЛ);
	Возврат Истина;
КонецФункции

// Ссылки на метаданные, которых нет в restored (документы/регистры не переносим).
Функция МетаданныеОтсутствуютВБп(Текст, КаталогВосст) Экспорт
	Найденные = СобратьСсылкиМетаданных(Текст);
	Для Каждого Сс Из Найденные Цикл
		Если Не ОбъектЕстьВКаталоге(КаталогВосст, Сс.Тег, Сс.Имя) Тогда
			Возврат "ссылка на " + Сс.Тег + "." + Сс.Имя + ", которого нет в restored (документы/регистры не переносим)";
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция СобратьСсылкиМетаданных(Текст) Экспорт
	Рез = Новый Массив;
	Виден = Новый Соответствие;
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.Документы.", "Documents", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.РегистрыСведений.", "InformationRegisters", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.РегистрыНакопления.", "AccumulationRegisters", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.РегистрыБухгалтерии.", "AccountingRegisters", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.РегистрыРасчета.", "CalculationRegisters", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.Справочники.", "Catalogs", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.Отчеты.", "Reports", Рез, Виден);
	ДобавитьСсылкиПоПрефиксу(Текст, "Метаданные.Обработки.", "DataProcessors", Рез, Виден);
	ДобавитьТипСсылки(Текст, "ДокументСсылка.", "Documents", Рез, Виден);
	ДобавитьТипСсылки(Текст, "ДокументОбъект.", "Documents", Рез, Виден);
	ДобавитьТипСсылки(Текст, "СправочникСсылка.", "Catalogs", Рез, Виден);
	ДобавитьТипСсылки(Текст, "СправочникОбъект.", "Catalogs", Рез, Виден);
	ДобавитьТипСсылки(Текст, "РегистрСведенийКлючЗаписи.", "InformationRegisters", Рез, Виден);
	ДобавитьТипСсылки(Текст, "РегистрСведенийНаборЗаписей.", "InformationRegisters", Рез, Виден);
	ДобавитьТипСсылки(Текст, "РегистрНакопленияНаборЗаписей.", "AccumulationRegisters", Рез, Виден);
	Возврат Рез;
КонецФункции

Процедура ДобавитьСсылкиПоПрефиксу(Текст, Префикс, Тег, Рез, Виден)
	Н = Текст;
	Иск = Префикс;
	Старт = 1;
	Пока Истина Цикл
		ПозОтн = СтрНайти(Сред(Н, Старт), Иск);
		Если ПозОтн = 0 Тогда
			Поз = 0;
		Иначе
			Поз = Старт + ПозОтн - 1;
		КонецЕсли;
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ИмяНач = Поз + СтрДлина(Иск);
		Й = ИмяНач;
		Пока Й <= СтрДлина(Н) И ЭтоСимволИдентификатора(Сред(Н, Й, 1)) Цикл
			Й = Й + 1;
		КонецЦикла;
		Имя = Сред(Н, ИмяНач, Й - ИмяНач);
		Ключ = Тег + "." + Имя;
		Если Имя <> "" И Виден.Получить(НРег(Ключ)) = Неопределено Тогда
			Виден.Вставить(НРег(Ключ), Истина);
			Рез.Добавить(Новый Структура("Тег, Имя", Тег, Имя));
		КонецЕсли;
		Старт = Й;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьТипСсылки(Текст, ПрефиксТипа, Тег, Рез, Виден)
	// Тип("СправочникСсылка.Имя")
	Иск = ПрефиксТипа;
	Старт = 1;
	Пока Истина Цикл
		ПозОтн = СтрНайти(Сред(Текст, Старт), Иск);
		Если ПозОтн = 0 Тогда
			Поз = 0;
		Иначе
			Поз = Старт + ПозОтн - 1;
		КонецЕсли;
		Если Поз = 0 Тогда
			Прервать;
		КонецЕсли;
		ИмяНач = Поз + СтрДлина(Иск);
		Й = ИмяНач;
		Пока Й <= СтрДлина(Текст) И ЭтоСимволИдентификатора(Сред(Текст, Й, 1)) Цикл
			Й = Й + 1;
		КонецЦикла;
		Имя = Сред(Текст, ИмяНач, Й - ИмяНач);
		Ключ = Тег + "." + Имя;
		Если Имя <> "" И Виден.Получить(НРег(Ключ)) = Неопределено Тогда
			Виден.Вставить(НРег(Ключ), Истина);
			Рез.Добавить(Новый Структура("Тег, Имя", Тег, Имя));
		КонецЕсли;
		Старт = Й;
	КонецЦикла;
КонецПроцедуры

Функция ОбъектЕстьВКаталоге(Корень, Тег, Имя)
	Кат = ОбъединитьПути(Корень, Тег);
	Если (Новый Файл(ОбъединитьПути(Кат, Имя + ".xml"))).Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	Если (Новый Файл(ОбъединитьПути(Кат, Имя))).Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция СобратьКартыПереписи(Перенесённые, Префикс)
	Квал = Новый Соответствие;
	ЛокПоМодулю = Новый Соответствие;
	Для Каждого Э Из Перенесённые Цикл
		НовоеИмя = ИмяСПрефиксом(Префикс, Э.Метод);
		Если Э.Куда <> "" И СтрНайти(Э.Куда, ".") > 0 Тогда
			// если уже в расширении под исходным именем — не переписывать
			Если Э.Причина = "уже есть в расширении под исходным именем" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если Э.Действие <> "перенести" И Э.Действие <> "уже_в_расширении" Тогда
			Продолжить;
		КонецЕсли;
		Если Э.Причина = "уже есть в расширении под исходным именем" Тогда
			Продолжить;
		КонецЕсли;
		СигУп = Новый Структура("required, total", 0, 99);
		Инфо = Новый Структура("name, newName, sigUp, sigBp", Э.Метод, НовоеИмя, СигУп, Неопределено);
		Квал.Вставить(НРег(Э.Модуль) + "." + НРег(Э.Метод), Инфо);
		Если Э.Свойство("Вид") И Э.Вид = "mgr" Тогда
			Квал.Вставить(НРег(Э.Папка) + "." + НРег(Э.ИмяОбъекта) + "." + НРег(Э.Метод), Инфо);
			ВидМен = ОписаниеВидаМенеджера(Э.Папка);
			Если ВидМен <> Неопределено Тогда
				Квал.Вставить(НРег(ВидМен.Папка) + "." + НРег(Э.ИмяОбъекта) + "." + НРег(Э.Метод), Инфо);
			КонецЕсли;
		КонецЕсли;
		КлючЛок = ?(Э.Свойство("Вид") И Э.Вид = "mgr", НРег(Э.Папка) + "." + НРег(Э.ИмяОбъекта), НРег(Э.Модуль));
		Лок = ЛокПоМодулю.Получить(КлючЛок);
		Если Лок = Неопределено Тогда
			Лок = Новый Соответствие;
			ЛокПоМодулю.Вставить(КлючЛок, Лок);
		КонецЕсли;
		Лок.Вставить(НРег(Э.Метод), Инфо);
	КонецЦикла;
	Возврат Новый Структура("Квалифицированные, ЛокальныеПоМодулю", Квал, ЛокПоМодулю);
КонецФункции

Функция ЛокальнаяКартаДляФайла(ПолноеИмя, КаталогРасш, ЛокПоМодулю)
	Норм = НРег(СтрЗаменить(ПолноеИмя, "/", "\"));
	Если СтрЗаканчиваетсяНа(Норм, "\managermodule.bsl") Тогда
		Части = СтрРазделить(Норм, "\");
		// ...\Папка\Имя\Ext\ManagerModule.bsl
		Если Части.Количество() >= 4 Тогда
			ИмяОб = Части[Части.Количество() - 3];
			Папка = Части[Части.Количество() - 4];
			Карта = ЛокПоМодулю.Получить(Папка + "." + ИмяОб);
			Если Карта <> Неопределено Тогда
				Возврат Карта;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Маркер = "\commonmodules\";
	Поз = СтрНайти(Норм, Маркер);
	Если Поз = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ост = Сред(Норм, Поз + СтрДлина(Маркер));
	Части = СтрРазделить(Ост, "\");
	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЛокПоМодулю.Получить(НРег(Части[0]));
КонецФункции

// Сбор квалифицированных вызовов (без строк и комментариев).
Функция СобратьКвалифицированныеВызовы(Знач Текст, УчитыватьОбласть, ОбластьПоУмолчанию) Экспорт
	Рез = Новый Массив;
	Длина = СтрДлина(Текст);
	Й = 1;
	ВСтроке = Ложь;
	Область = ?(ОбластьПоУмолчанию = "", "plain", ОбластьПоУмолчанию);
	ВИиК = Ложь;
	Глубина = 0;
	Пока Й <= Длина Цикл
		С = Сред(Текст, Й, 1);
		Если ВСтроке Тогда
			Если С = """" Тогда
				Если Сред(Текст, Й + 1, 1) = """" Тогда
					Й = Й + 2;
					Продолжить;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ВСтроке = Истина;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = "/" И Сред(Текст, Й + 1, 1) = "/" Тогда
			Пока Й <= Длина И Сред(Текст, Й, 1) <> Символы.ПС Цикл
				Й = Й + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если С = "#" И УчитыватьОбласть Тогда
			НачСтр = Й;
			Пока НачСтр > 1 И Сред(Текст, НачСтр - 1, 1) <> Символы.ПС Цикл
				НачСтр = НачСтр - 1;
			КонецЦикла;
			Если НачСтр = Й Или СокрЛП(Сред(Текст, НачСтр, Й - НачСтр)) = "" Тогда
				КонСтр = Й;
				Пока КонСтр <= Длина И Сред(Текст, КонСтр, 1) <> Символы.ПС Цикл
					КонСтр = КонСтр + 1;
				КонецЦикла;
				Дир = НРег(СокрЛП(Разбор.УбратьКомментарий(Сред(Текст, Й, КонСтр - Й))));
				Если Дир = "#вставка" Или Дир = "#insert" Тогда
					Область = "insert";
				ИначеЕсли Дир = "#конецвставки" Или Дир = "#endinsert" Тогда
					Область = ?(ВИиК, "plain_iik", "plain");
				ИначеЕсли Дир = "#удаление" Или Дир = "#delete" Тогда
					Область = "delete";
				ИначеЕсли Дир = "#конецудаления" Или Дир = "#enddelete" Тогда
					Область = ?(ВИиК, "plain_iik", "plain");
				КонецЕсли;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = "&" И УчитыватьОбласть Тогда
			КонСтр = Й;
			Пока КонСтр <= Длина И Сред(Текст, КонСтр, 1) <> Символы.ПС Цикл
				КонСтр = КонСтр + 1;
			КонецЦикла;
			Ан = НРег(СокрЛП(Сред(Текст, Й, КонСтр - Й)));
			Если СтрНачинаетсяС(Ан, "&изменениеиконтроль") Или СтрНачинаетсяС(Ан, "&измененияиконтроль") Тогда
				ВИиК = Истина;
				Область = "plain_iik";
			КонецЕсли;
			Й = КонСтр;
			Продолжить;
		КонецЕсли;
		Если Не ЭтоНачалоИдентификатора(С) Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		НачЦеп = Й;
		Иденты = Новый Массив;
		Поз = Й;
		Пока Истина Цикл
			Ид = ПрочитатьИдентификатор(Текст, Поз, Длина);
			Иденты.Добавить(Ид.name);
			Поз = ПропуститьПробелы(Текст, Ид.finish, Длина);
			Если Поз <= Длина И Сред(Текст, Поз, 1) = "." Тогда
				Поз = ПропуститьПробелы(Текст, Поз + 1, Длина);
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Если Поз <= Длина И Сред(Текст, Поз, 1) = "(" Тогда
			Если Иденты.Количество() >= 1 Тогда
				ЭтоОбъяв = ЭтоКлючевоеСловоОбъявления(Иденты[0]);
				Если Не ЭтоОбъяв Тогда
					Рез.Добавить(Новый Структура("Части, Область, Начало", Иденты, Область, НачЦеп));
				КонецЕсли;
			КонецЕсли;
			Если УчитыватьОбласть И Иденты.Количество() = 1 Тогда
				Н = НРег(Иденты[0]);
				Если Н = "процедура" Или Н = "функция" Тогда
					Глубина = Глубина + 1;
				ИначеЕсли Н = "конецпроцедуры" Или Н = "конецфункции" Тогда
					Если Глубина > 0 Тогда
						Глубина = Глубина - 1;
					КонецЕсли;
					Если Глубина = 0 Тогда
						ВИиК = Ложь;
						Область = "plain";
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли УчитыватьОбласть И Иденты.Количество() = 1 Тогда
			Н = НРег(Иденты[0]);
			Если Н = "конецпроцедуры" Или Н = "конецфункции" Тогда
				Если Глубина > 0 Тогда
					Глубина = Глубина - 1;
				КонецЕсли;
				Если Глубина = 0 Тогда
					ВИиК = Ложь;
					Область = "plain";
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Й = Поз;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ЭтоКлючевоеСловоОбъявления(Имя)
	Н = НРег(Имя);
	Возврат Н = "процедура" Или Н = "функция" Или Н = "новый" Или Н = "new";
КонецФункции

Функция ЭтоСлужебноеИмяВызова(Имя)
	Н = НРег(Имя);
	Если ЭтоКлючевоеСловоОбъявления(Имя) Тогда
		Возврат Истина;
	КонецЕсли;
	Служеб = "если,иначеесли,пока,для,возврат,вызов,прервать,продолжить,попытка,вызватьисключение,выполнить,перейти,добавитьобработчик,удалитьобработчик,ждать,новый,тип,нстр,стршаблон,стрзаменить,стрдлина,стрнайти,сокрлп,сокрл,сокрп,формат,xmlзначение,xmlстрока,значениезаполнено,мин,макс,цел,окр,число,строка,булево,дата,лев,прав,сред,кодсимвола,символ";
	Возврат СтрНайти("," + Служеб + ",", "," + Н + ",") > 0;
КонецФункции

Функция ПереписатьВызовыВРасширении(Знач Текст, ЛокальнаяКарта, Квалифицированные) Экспорт
	Если (ЛокальнаяКарта = Неопределено Или ЛокальнаяКарта.Количество() = 0)
		И (Квалифицированные = Неопределено Или Квалифицированные.Количество() = 0) Тогда
		Возврат Новый Структура("Текст, count", Текст, 0);
	КонецЕсли;
	Если ПереносСигнатур = Неопределено Тогда
		Возврат Новый Структура("Текст, count", Текст, 0);
	КонецЕсли;
	// Разбиваем модуль: в ИиК — только #Вставка, вне ИиК — весь текст.
	Возврат ПереписатьСУчётомИиК(Текст, ЛокальнаяКарта, Квалифицированные);
КонецФункции

Функция ПереписатьСУчётомИиК(Текст, ЛокальнаяКарта, Квалифицированные)
	// Используем карту областей из сборщика: переписываем куски, где область insert или plain (не ИиК).
	// Проще: вызвать ПереписатьВызовы с ТолькоВставки=Истина (вставки ИиК) и отдельно обработать
	// фрагменты вне ИиК-методов, временно обернув... Надёжнее свой проход с той же заменой имени.
	Замен = 0;
	Длина = СтрДлина(Текст);
	Части = Новый Массив;
	ПозКопии = 1;
	Й = 1;
	ВСтроке = Ложь;
	Можно = Истина; // вне ИиК
	ВИиК = Ложь;
	Глубина = 0;
	Пока Й <= Длина Цикл
		С = Сред(Текст, Й, 1);
		Если ВСтроке Тогда
			Если С = """" Тогда
				Если Сред(Текст, Й + 1, 1) = """" Тогда
					Й = Й + 2;
					Продолжить;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ВСтроке = Истина;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = "/" И Сред(Текст, Й + 1, 1) = "/" Тогда
			Пока Й <= Длина И Сред(Текст, Й, 1) <> Символы.ПС Цикл
				Й = Й + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если С = "#" Тогда
			НачСтр = Й;
			Пока НачСтр > 1 И Сред(Текст, НачСтр - 1, 1) <> Символы.ПС Цикл
				НачСтр = НачСтр - 1;
			КонецЦикла;
			Если НачСтр = Й Или СокрЛП(Сред(Текст, НачСтр, Й - НачСтр)) = "" Тогда
				КонСтр = Й;
				Пока КонСтр <= Длина И Сред(Текст, КонСтр, 1) <> Символы.ПС Цикл
					КонСтр = КонСтр + 1;
				КонецЦикла;
				Дир = НРег(СокрЛП(Разбор.УбратьКомментарий(Сред(Текст, Й, КонСтр - Й))));
				Если Дир = "#вставка" Или Дир = "#insert" Тогда
					Можно = Истина;
				ИначеЕсли Дир = "#конецвставки" Или Дир = "#endinsert" Тогда
					Можно = Не ВИиК;
				ИначеЕсли Дир = "#удаление" Или Дир = "#delete" Тогда
					Можно = Ложь;
				ИначеЕсли Дир = "#конецудаления" Или Дир = "#enddelete" Тогда
					Можно = Не ВИиК;
				КонецЕсли;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = "&" Тогда
			КонСтр = Й;
			Пока КонСтр <= Длина И Сред(Текст, КонСтр, 1) <> Символы.ПС Цикл
				КонСтр = КонСтр + 1;
			КонецЦикла;
			Ан = НРег(СокрЛП(Сред(Текст, Й, КонСтр - Й)));
			Если СтрНачинаетсяС(Ан, "&изменениеиконтроль") Тогда
				ВИиК = Истина;
				Можно = Ложь; // typovaya-часть до #Вставка
			КонецЕсли;
			Й = КонСтр;
			Продолжить;
		КонецЕсли;
		Если Не ЭтоНачалоИдентификатора(С) Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		НачЦеп = Й;
		Иденты = Новый Массив;
		Поз = Й;
		Пока Истина Цикл
			Ид = ПрочитатьИдентификаторЛок(Текст, Поз, Длина);
			Иденты.Добавить(Ид);
			Поз = ПропуститьПробелыЛок(Текст, Ид.finish, Длина);
			Если Поз <= Длина И Сред(Текст, Поз, 1) = "." Тогда
				Поз = ПропуститьПробелыЛок(Текст, Поз + 1, Длина);
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Если Поз <= Длина И Сред(Текст, Поз, 1) = "(" Тогда
			Если Можно И Не ЭтоКлючевоеСловоОбъявления(Иденты[0].name) Тогда
				Инфо = НайтиИнфо(Иденты, ЛокальнаяКарта, Квалифицированные);
				Если Инфо <> Неопределено Тогда
					Посл = Иденты[Иденты.Количество() - 1];
					Части.Добавить(Сред(Текст, ПозКопии, Посл.start - ПозКопии));
					Части.Добавить(Инфо.newName);
					ПозКопии = Посл.finish;
					Замен = Замен + 1;
				КонецЕсли;
			КонецЕсли;
			Если Иденты.Количество() = 1 Тогда
				Н = НРег(Иденты[0].name);
				Если Н = "процедура" Или Н = "функция" Тогда
					Глубина = Глубина + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Иденты.Количество() = 1 Тогда
			Н = НРег(Иденты[0].name);
			Если Н = "конецпроцедуры" Или Н = "конецфункции" Тогда
				Если Глубина > 0 Тогда
					Глубина = Глубина - 1;
				КонецЕсли;
				Если Глубина = 0 И ВИиК Тогда
					ВИиК = Ложь;
					Можно = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Й = Поз;
	КонецЦикла;
	Если Замен = 0 Тогда
		Возврат Новый Структура("Текст, count", Текст, 0);
	КонецЕсли;
	Части.Добавить(Сред(Текст, ПозКопии));
	Возврат Новый Структура("Текст, count", СтрСоединить(Части, ""), Замен);
КонецФункции

Функция НайтиИнфо(Иденты, ЛокальнаяКарта, Квалифицированные)
	Если Иденты.Количество() = 1 Тогда
		Если ЛокальнаяКарта = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЛокальнаяКарта.Получить(НРег(Иденты[0].name));
	КонецЕсли;
	Если Квалифицированные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Иденты.Количество() = 2 Тогда
		Возврат Квалифицированные.Получить(НРег(Иденты[0].name) + "." + НРег(Иденты[1].name));
	КонецЕсли;
	Если Иденты.Количество() = 3 Тогда
		Ключ = НРег(Иденты[0].name) + "." + НРег(Иденты[1].name) + "." + НРег(Иденты[2].name);
		Возврат Квалифицированные.Получить(Ключ);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЭтоНачалоИдентификатора(С)
	К = КодСимвола(С);
	Возврат (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105 Или С = "_";
КонецФункции

Функция ПрочитатьИдентификаторЛок(Текст, Нач, Длина)
	Й = Нач;
	Пока Й <= Длина И ЭтоСимволИдентификатора(Сред(Текст, Й, 1)) Цикл
		Й = Й + 1;
	КонецЦикла;
	Возврат Новый Структура("name, start, finish", Сред(Текст, Нач, Й - Нач), Нач, Й);
КонецФункции

Функция ПрочитатьИдентификатор(Текст, Нач, Длина)
	Возврат ПрочитатьИдентификаторЛок(Текст, Нач, Длина);
КонецФункции

Функция ПропуститьПробелыЛок(Текст, Нач, Длина)
	Й = Нач;
	Пока Й <= Длина Цикл
		С = Сред(Текст, Й, 1);
		Если С = " " Или С = Символы.Таб Или С = Символы.ВК Или С = Символы.ПС Тогда
			Й = Й + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Й;
КонецФункции

Функция ПропуститьПробелы(Текст, Нач, Длина)
	Возврат ПропуститьПробелыЛок(Текст, Нач, Длина);
КонецФункции

Функция ПрочитатьФайл(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

Процедура ЗаписатьФайл(Путь, Текст)
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

Функция ЗаписатьОтчёт(КаталогОтчёта, Отчёт)
	СоздатьКаталог(КаталогОтчёта);
	Путь = ОбъединитьПути(КаталогОтчёта, "missing_cm_methods.json");
	Стр = "{""calls"":" + XMLСтрока(Отчёт.calls)
		+ ",""rewritten"":" + XMLСтрока(Отчёт.rewritten)
		+ ",""adoptedCount"":" + XMLСтрока(Отчёт.adopted.Количество())
		+ ",""adopted"":[";
	ПервА = Истина;
	Для Каждого ИмяА Из Отчёт.adopted Цикл
		Если Не ПервА Тогда
			Стр = Стр + ",";
		КонецЕсли;
		ПервА = Ложь;
		Стр = Стр + JsonStr(ИмяА);
	КонецЦикла;
	Стр = Стр + "],""transferred"":[";
	Перв = Истина;
	Для Каждого Э Из Отчёт.transferred Цикл
		Если Не Перв Тогда
			Стр = Стр + ",";
		КонецЕсли;
		Перв = Ложь;
		Стр = Стр + "{""from"":" + JsonStr(Э.Цепочка) + ",""to"":" + JsonStr(Э.Куда) + "}";
	КонецЦикла;
	Стр = Стр + "],""skipped"":[";
	Перв = Истина;
	Для Каждого Э Из Отчёт.skipped Цикл
		Если Не Перв Тогда
			Стр = Стр + ",";
		КонецЕсли;
		Перв = Ложь;
		Стр = Стр + "{""from"":" + JsonStr(Э.Цепочка) + ",""reason"":" + JsonStr(Э.Причина) + "}";
	КонецЦикла;
	Стр = Стр + "]}";
	ЗаписатьФайл(Путь, Стр);
	// человекочитаемый md
	Мд = ОбъединитьПути(КаталогОтчёта, "missing_cm_methods.md");
	Т = Новый Массив;
	Т.Добавить("# Отсутствующие в typovaya методы, на которые ссылается расширение");
	Т.Добавить("");
	Т.Добавить("Вызовов/методов: " + Отчёт.calls + ", перенесено: " + Отчёт.transferred.Количество()
		+ ", заимствовано объектов: " + Отчёт.adopted.Количество()
		+ ", пропуск: " + Отчёт.skipped.Количество() + ", переписано вызовов: " + Отчёт.rewritten);
	Т.Добавить("");
	Т.Добавить("## Заимствованные объекты");
	Для Каждого ИмяА Из Отчёт.adopted Цикл
		Т.Добавить("- " + ИмяА);
	КонецЦикла;
	Т.Добавить("");
	Т.Добавить("## Перенесено");
	Для Каждого Э Из Отчёт.transferred Цикл
		Т.Добавить("- " + Э.Цепочка + " → " + Э.Куда);
	КонецЦикла;
	Т.Добавить("");
	Т.Добавить("## Не перенесено");
	Для Каждого Э Из Отчёт.skipped Цикл
		Т.Добавить("- " + Э.Цепочка + " — " + Э.Причина);
	КонецЦикла;
	ЗаписатьФайл(Мд, СтрСоединить(Т, Символы.ПС));
	Возврат Путь;
КонецФункции

Функция JsonStr(С)
	В = СтрЗаменить(Строка(С), "\", "\\");
	В = СтрЗаменить(В, """", "\""");
	В = СтрЗаменить(В, Символы.ПС, "\n");
	Возврат """" + В + """";
КонецФункции
