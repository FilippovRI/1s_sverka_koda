// Задача 11: общие модули БП, которых нет в основной конфигурации (метаданные УП + тексты restored из БП).
// restored несёт текст модулей БП, а состав общих модулей — УП: модули «только БП» (БухгалтерскийУчет,
// УчетнаяПолитика, УведомленияОтФНСАУСНКлиент…) в основной отсутствуют и код БП не компилируется.
// Модуль находит такие модули транзитивно (ссылки «Имя.» и вызовы методов глобальных модулей) и возвращает
// их как есть из выгрузки БП: XML + Ext, строка <CommonModule> в Configuration.xml. Немодульные объекты
// (справочники, документы, регистры…), на которые ссылаются возвращаемые модули и которых нет в основной,
// не добавляются — только список на решение. Возвращаются только «чистые» модули: в их замыкании нет модулей,
// ссылающихся на отсутствующие в основной объекты (иначе модуль не скомпилируется) — остальные в blocked.
// Выгрузка БП только читается.

Перем КэшТекстов;

Функция ПрочитатьТекст(Путь) Экспорт
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

// Код без комментариев и строковых литералов (в т.ч. многострочных с «|»).
Функция КодБезЛитералов(Знач Т) Экспорт
	Т = (Новый РегулярноеВыражение("""[^""\n]*(""|$)")).Заменить(Т, """""");
	Т = (Новый РегулярноеВыражение("(?m)^[ \t]*\|[^\n]*")).Заменить(Т, "");
	Возврат (Новый РегулярноеВыражение("//[^\n]*")).Заменить(Т, "");
КонецФункции

// Имена объектов вида <Тег>Имя</Тег> из ChildObjects Configuration.xml. Соответствие Тег -> Соответствие(нрег имя -> Имя).
Функция СоставКонфигурации(ПутьКонф) Экспорт
	Р = Новый Соответствие;
	Т = ПрочитатьТекст(ПутьКонф);
	Если Т = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого С Из (Новый РегулярноеВыражение("(?m)^\t\t\t<(\w+)>([^<]+)</\1>")).НайтиСовпадения(Т) Цикл
		Тег = С.Группы[1].Значение;
		Если Р.Получить(Тег) = Неопределено Тогда
			Р.Вставить(Тег, Новый Соответствие);
		КонецЕсли;
		Р.Получить(Тег).Вставить(НРег(С.Группы[2].Значение), С.Группы[2].Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИменаТега(Состав, Тег) Экспорт
	Р = Состав.Получить(Тег);
	Возврат ?(Р = Неопределено, Новый Соответствие, Р);
КонецФункции

// Квалификаторы «Имя.» в коде. Соответствие нрег -> Истина.
Функция Квалификаторы(Код) Экспорт
	Р = Новый Соответствие;
	Для Каждого С Из (Новый РегулярноеВыражение("(?<![\wЁё.&#])([\wЁё]+)[ \t]*\.")).НайтиСовпадения(Код) Цикл
		Р.Вставить(НРег(С.Группы[1].Значение), Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Неквалифицированные вызовы «Имя(». Соответствие нрег -> Истина.
Функция Вызовы(Код) Экспорт
	Р = Новый Соответствие;
	Для Каждого С Из (Новый РегулярноеВыражение("(?<![\wЁё.&#])([\wЁё]+)[ \t]*\(")).НайтиСовпадения(Код) Цикл
		Р.Вставить(НРег(С.Группы[1].Значение), Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОбъявленныеМетоды(Код, ТолькоЭкспорт = Ложь) Экспорт
	Р = Новый Соответствие;
	Для Каждого С Из (Новый РегулярноеВыражение("(?im)^[ \t]*(?:Асинх[ \t]+)?(?:Процедура|Функция)[ \t]+([\wЁё]+)[ \t]*\(([^)]*)\)[ \t]*(Экспорт)?")).НайтиСовпадения(Код) Цикл
		Если Не ТолькоЭкспорт Или С.Группы[3].Значение <> "" Тогда
			Р.Вставить(НРег(С.Группы[1].Значение), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Ссылки на немодульные объекты: Справочники.X, Документы.X, Метаданные.Справочники.X, Тип("СправочникСсылка.X"),
// ПредопределенноеЗначение("Справочник.X.Y"). Массив Структура(Тег, Имя, Как).
Функция СсылкиНаОбъекты(ТекстИсх) Экспорт
	Р = Новый Массив;
	Пары = "Справочники=Catalog,Документы=Document,ЖурналыДокументов=DocumentJournal,Перечисления=Enum,Константы=Constant,"
		+ "РегистрыСведений=InformationRegister,РегистрыНакопления=AccumulationRegister,РегистрыБухгалтерии=AccountingRegister,"
		+ "РегистрыРасчета=CalculationRegister,ПланыСчетов=ChartOfAccounts,ПланыВидовХарактеристик=ChartOfCharacteristicTypes,"
		+ "ПланыВидовРасчета=ChartOfCalculationTypes,ПланыОбмена=ExchangePlan,БизнесПроцессы=BusinessProcess,Задачи=Task,"
		+ "Обработки=DataProcessor,Отчеты=Report,ПараметрыСеанса=SessionParameter,ХранилищаНастроек=SettingsStorage,"
		+ "ОбщиеФормы=CommonForm,ОбщиеМакеты=CommonTemplate,ОбщиеКартинки=CommonPicture,ФункциональныеОпции=FunctionalOption,"
		+ "ОпределяемыеТипы=DefinedType,ОбщиеКоманды=CommonCommand,РегламентныеЗадания=ScheduledJob,Подсистемы=Subsystem,"
		+ "ПодпискиНаСобытия=EventSubscription,ЭлементыСтиля=StyleItem,БиблиотекаКартинок=CommonPicture,WebСервисы=WebService,HTTPСервисы=HTTPService";
	Ед = "Справочник=Catalog,Документ=Document,Перечисление=Enum,ПланСчетов=ChartOfAccounts,ПланВидовХарактеристик=ChartOfCharacteristicTypes,"
		+ "ПланВидовРасчета=ChartOfCalculationTypes,ПланОбмена=ExchangePlan,БизнесПроцесс=BusinessProcess,Задача=Task,"
		+ "РегистрСведений=InformationRegister,РегистрНакопления=AccumulationRegister,РегистрБухгалтерии=AccountingRegister,"
		+ "Обработка=DataProcessor,Отчет=Report,Константа=Constant";
	Карта = Новый Соответствие;
	Для Каждого П Из СтрРазделить(Пары, ",") Цикл
		Ч2 = СтрРазделить(П, "=");
		Карта.Вставить(НРег(Ч2[0]), Ч2[1]);
	КонецЦикла;
	КартаЕд = Новый Соответствие;
	Для Каждого П Из СтрРазделить(Ед, ",") Цикл
		Ч2 = СтрРазделить(П, "=");
		КартаЕд.Вставить(НРег(Ч2[0]), Ч2[1]);
	КонецЦикла;
	Код = КодБезЛитералов(ТекстИсх);
	Для Каждого С Из (Новый РегулярноеВыражение("(?<![\wЁё])(?:Метаданные\.)?([\wЁё]+)\.([\wЁё]+)")).НайтиСовпадения(Код) Цикл
		Тег = Карта.Получить(НРег(С.Группы[1].Значение));
		Если Тег <> Неопределено И Сред(Код, С.Индекс, 1) <> "." Тогда
			Р.Добавить(Новый Структура("Тег, Имя, Как", Тег, С.Группы[2].Значение, С.Значение));
		КонецЕсли;
	КонецЦикла;
	// в строках: Тип("СправочникСсылка.X"), ПредопределенноеЗначение("Справочник.X.Y")
	Для Каждого С Из (Новый РегулярноеВыражение("""([\wЁё]+?)(?:Ссылка|Объект|Менеджер|Выборка|Список)?\.([\wЁё]+)[.""]")).НайтиСовпадения(ТекстИсх) Цикл
		Тег = КартаЕд.Получить(НРег(С.Группы[1].Значение));
		Если Тег <> Неопределено Тогда
			Р.Добавить(Новый Структура("Тег, Имя, Как", Тег, С.Группы[2].Значение, С.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстМодуляБп(КореньБп, Имя)
	Т = КэшТекстов.Получить(Имя);
	Если Т = Неопределено Тогда
		Т = ПрочитатьТекст(ОбъединитьПути(КореньБп, "CommonModules", Имя, "Ext") + ПолучитьРазделительПути() + "Module.bsl");
		Если Т = Неопределено Тогда
			Т = "";
		КонецЕсли;
		КэшТекстов.Вставить(Имя, Т);
	КонецЕсли;
	Возврат Т;
КонецФункции

// Анализ. КореньОсн — каталог основной (load-e или restored) с Configuration.xml; КореньБп — выгрузка БП.
// Тексты — каталоги, *.bsl которых сканируются (по умолчанию КореньОсн).
// Структура(modules — Массив имён к возврату (в порядке обнаружения), reasons — Соответствие имя -> откуда,
//   objects — Массив строк «Тег.Имя ← модуль» (немодульные объекты, которых нет в основной), scanned).
Функция Анализ(КореньОсн, КореньБп, КаталогиТекстов = Неопределено) Экспорт
	КэшТекстов = Новый Соответствие;
	Осн = СоставКонфигурации(ОбъединитьПути(КореньОсн, "Configuration.xml"));
	Бп = СоставКонфигурации(ОбъединитьПути(КореньБп, "Configuration.xml"));
	ОснМ = ИменаТега(Осн, "CommonModule");
	БпМ = ИменаТега(Бп, "CommonModule");
	Кандидаты = Новый Соответствие; // нрег -> Имя (есть в БП, нет в основной)
	Для Каждого КЗ Из БпМ Цикл
		Если ОснМ.Получить(КЗ.Ключ) = Неопределено Тогда
			Кандидаты.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	// экспортные методы глобальных модулей-кандидатов: метод -> модуль
	ГлобМетоды = Новый Соответствие;
	Для Каждого КЗ Из Кандидаты Цикл
		Х = ПрочитатьТекст(ОбъединитьПути(КореньБп, "CommonModules", КЗ.Значение + ".xml"));
		Если Х <> Неопределено И СтрНайти(Х, "<Global>true</Global>") > 0 Тогда
			Для Каждого М Из ОбъявленныеМетоды(КодБезЛитералов(ТекстМодуляБп(КореньБп, КЗ.Значение)), Истина) Цикл
				ГлобМетоды.Вставить(М.Ключ, КЗ.Значение);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Рез = Новый Структура("modules, reasons, objects, scanned, clean, blocked, deps, missing", Новый Массив, Новый Соответствие,
		Новый Массив, 0, Новый Массив, Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Очередь = Новый Массив;
	Если КаталогиТекстов = Неопределено Тогда
		КаталогиТекстов = Новый Массив;
		КаталогиТекстов.Добавить(КореньОсн);
	КонецЕсли;
	Для Каждого Кат Из КаталогиТекстов Цикл
		Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
			Т = ПрочитатьТекст(Ф.ПолноеИмя);
			Рез.scanned = Рез.scanned + 1;
			Откуда = Сред(Ф.ПолноеИмя, СтрДлина(Кат) + 2);
			ДобавитьСсылки(КодБезЛитералов(Т), Кандидаты, ГлобМетоды, Очередь, Рез, Откуда);
		КонецЦикла;
	КонецЦикла;
	Й = 0;
	Пока Й < Очередь.Количество() Цикл
		Имя = Очередь[Й];
		Й = Й + 1;
		Т = ТекстМодуляБп(КореньБп, Имя);
		Зав = Новый Соответствие;
		ДобавитьСсылки(КодБезЛитералов(Т), Кандидаты, ГлобМетоды, Очередь, Рез, "CommonModules/" + Имя, Зав);
		Рез.deps.Вставить(Имя, Зав);
	КонецЦикла;
	// немодульные объекты, на которые ссылаются возвращаемые модули
	Было = Новый Соответствие;
	Для Каждого Имя Из Рез.modules Цикл
		Для Каждого С Из СсылкиНаОбъекты(ТекстМодуляБп(КореньБп, Имя)) Цикл
			Если ИменаТега(Осн, С.Тег).Получить(НРег(С.Имя)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ИменаТега(Бп, С.Тег).Получить(НРег(С.Имя)) = Неопределено Тогда
				Продолжить; // нет и в БП — не объект (напр. свойство) или имя из строки
			КонецЕсли;
			Ключ = С.Тег + "." + С.Имя;
			Если Рез.missing.Получить(Имя) = Неопределено Тогда
				Рез.missing.Вставить(Имя, Ключ);
			КонецЕсли;
			Если Было.Получить(Ключ) = Неопределено Тогда
				Было.Вставить(Ключ, Истина);
				Рез.objects.Добавить(Ключ + " ← " + Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// к возврату (clean): модули, на которые прямо ссылается основная и в замыкании которых нет модулей
	// с отсутствующими объектами, + их замыкание; прямые с такими модулями — blocked: имя -> «модуль: объект»
	Чистые = Новый Соответствие;
	Для Каждого Имя Из Рез.modules Цикл
		Если СтрНачинаетсяС(Рез.reasons.Получить(Имя), "CommonModules/") Тогда
			Продолжить;
		КонецЕсли;
		Причина = ПричинаБлокировки(Имя, Рез);
		Если Причина <> "" Тогда
			Рез.blocked.Вставить(Имя, Причина);
			Продолжить;
		КонецЕсли;
		Оч = Новый Массив;
		Оч.Добавить(Имя);
		Пока Оч.Количество() > 0 Цикл
			Х = Оч[0];
			Оч.Удалить(0);
			Если Чистые.Получить(Х) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Чистые.Вставить(Х, Истина);
			Зав = Рез.deps.Получить(Х);
			Если Зав <> Неопределено Тогда
				Для Каждого КЗ Из Зав Цикл
					Оч.Добавить(КЗ.Ключ);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Имя Из Рез.modules Цикл
		Если Чистые.Получить(Имя) <> Неопределено Тогда
			Рез.clean.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Первый (обход в ширину) модуль замыкания со ссылкой на отсутствующий объект: «Модуль: Тег.Имя» или "".
Функция ПричинаБлокировки(Имя, Рез) Экспорт
	Видел = Новый Соответствие;
	Оч = Новый Массив;
	Оч.Добавить(Имя);
	Й = 0;
	Пока Й < Оч.Количество() Цикл
		Х = Оч[Й];
		Й = Й + 1;
		Если Видел.Получить(Х) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Видел.Вставить(Х, Истина);
		Об = Рез.missing.Получить(Х);
		Если Об <> Неопределено Тогда
			Возврат Х + ": " + Об;
		КонецЕсли;
		Зав = Рез.deps.Получить(Х);
		Если Зав <> Неопределено Тогда
			Для Каждого КЗ Из Зав Цикл
				Оч.Добавить(КЗ.Ключ);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ДобавитьСсылки(Код, Кандидаты, ГлобМетоды, Очередь, Рез, Откуда, Зав = Неопределено)
	Для Каждого КЗ Из Квалификаторы(Код) Цикл
		Имя = Кандидаты.Получить(КЗ.Ключ);
		Если Имя <> Неопределено И Зав <> Неопределено Тогда
			Зав.Вставить(Имя, Истина);
		КонецЕсли;
		Если Имя <> Неопределено И Рез.reasons.Получить(Имя) = Неопределено Тогда
			Рез.reasons.Вставить(Имя, Откуда);
			Рез.modules.Добавить(Имя);
			Очередь.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Если ГлобМетоды.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Свои = ОбъявленныеМетоды(Код);
	Для Каждого КЗ Из Вызовы(Код) Цикл
		Имя = ГлобМетоды.Получить(КЗ.Ключ);
		Если Имя <> Неопределено И Свои.Получить(КЗ.Ключ) = Неопределено И Зав <> Неопределено Тогда
			Зав.Вставить(Имя, Истина);
		КонецЕсли;
		Если Имя <> Неопределено И Свои.Получить(КЗ.Ключ) = Неопределено И Рез.reasons.Получить(Имя) = Неопределено Тогда
			Рез.reasons.Вставить(Имя, Откуда + " (вызов " + КЗ.Ключ + ")");
			Рез.modules.Добавить(Имя);
			Очередь.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура КопироватьКаталог(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Ложь) Цикл
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталог(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		Иначе
			КопироватьФайл(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Вставляет строки <CommonModule>Имя</CommonModule> после последней такой строки Configuration.xml (байты файла
// кроме вставки не меняются: BOM и переводы строк как были).
Функция ДобавитьВКонфигурацию(ПутьКонф, Имена) Экспорт
	Дв = Новый ДвоичныеДанные(ПутьКонф);
	Т = ПолучитьСтрокуИзДвоичныхДанных(Дв, "UTF-8");
	БОМ = СтрДлина(Т) > 0 И КодСимвола(Т, 1) = 65279; // не СтрНачинаетсяС: культурное сравнение игнорирует U+FEFF и всегда даёт Истина
	Если БОМ Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	ПС = ?(СтрНайти(Т, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Есть = ИменаТега(СоставКонфигурации(ПутьКонф), "CommonModule");
	Вставка = "";
	Добавлено = 0;
	Для Каждого Имя Из Имена Цикл
		Если Есть.Получить(НРег(Имя)) = Неопределено Тогда
			Вставка = Вставка + Символы.Таб + Символы.Таб + Символы.Таб + "<CommonModule>" + Имя + "</CommonModule>" + ПС;
			Добавлено = Добавлено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Добавлено = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Поз = 0;
	Метка = "</CommonModule>" + ПС;
	Н = СтрНайти(Т, Метка, НаправлениеПоиска.СКонца);
	Если Н > 0 Тогда
		Поз = Н + СтрДлина(Метка);
	Иначе
		Н = СтрНайти(Т, "</ChildObjects>");
		Поз = СтрНайти(Сред(Т, 1, Н), ПС, НаправлениеПоиска.СКонца) + СтрДлина(ПС);
	КонецЕсли;
	Т = Лев(Т, Поз - 1) + Вставка + Сред(Т, Поз);
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, БОМ).Записать(ПутьКонф);
	Возврат Добавлено;
КонецФункции

// Копирует модули из БП в Куда (XML + каталог модуля) и добавляет их в Куда/Configuration.xml.
Функция Вернуть(Имена, КореньБп, Куда) Экспорт
	Если Имена.Количество() > 0 Тогда
		СоздатьКаталог(ОбъединитьПути(Куда, "CommonModules"));
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		КопироватьФайл(ОбъединитьПути(КореньБп, "CommonModules", Имя + ".xml"), ОбъединитьПути(Куда, "CommonModules", Имя + ".xml"));
		Кат = ОбъединитьПути(КореньБп, "CommonModules", Имя);
		Если (Новый Файл(Кат)).Существует() Тогда
			КопироватьКаталог(Кат, ОбъединитьПути(Куда, "CommonModules", Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат ДобавитьВКонфигурацию(ОбъединитьПути(Куда, "Configuration.xml"), Имена);
КонецФункции

КэшТекстов = Новый Соответствие;
