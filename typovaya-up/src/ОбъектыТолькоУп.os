// Объекты, которые есть только в УП (нет в БП): инвентаризация для переноса в расширение собственными объектами.
// Пишет uponly_objects.json (код: общие модули, обработки, отчёты, общие формы/команды, формы УП у типовых объектов)
// и uponly_data_objects.json (объекты с данными — НЕ переносятся, нужно решение).
// Отметки безопасного режима и разделения данных — информационные (свой Fresh, расширение на уровне конфигурации).

Перем ТипыКода;
Перем ТипыДанных;
Перем ТипыРесурсов;
Перем ОпасныеВызовы;

Функция Проверить(КореньУп, КореньБп, КаталогВыхода, Лог) Экспорт
	Код = Новый Массив;
	Данные = Новый Массив;
	Ресурсы = Новый Массив;
	Имена = Новый Соответствие; // НРег(имя) -> описание (для поиска ссылок)
	Разделённые = РазделённыеОбъекты(КореньУп);
	Для Каждого Кат Из НайтиФайлы(КореньУп, "*", Ложь) Цикл
		Если Не Кат.ЭтоКаталог() Или Кат.Имя = "Ext" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Кат.ПолноеИмя, "*.xml", Ложь) Цикл
			Если (Новый Файл(ОбъединитьПути(КореньБп, Кат.Имя, Ф.Имя))).Существует() Тогда
				Продолжить;
			КонецЕсли;
			Тип = Кат.Имя;
			Оп = Новый Структура("type, name, kind, referencedFrom, safeMode, separation, modules, decision, note",
				Тип, Ф.ИмяБезРасширения, "", Новый Массив, Новый Массив, "", 0, "", "");
			Если ТипыКода.Получить(Тип) <> Неопределено Тогда
				Оп.kind = "code";
				ОписатьМодули(Оп, ОбъединитьПути(Кат.ПолноеИмя, Ф.ИмяБезРасширения));
				Код.Добавить(Оп);
				Имена.Вставить(НРег(Оп.name), Оп);
			ИначеЕсли ТипыДанных.Получить(Тип) <> Неопределено Тогда
				Оп.kind = "data";
				Оп.separation = ?(Разделённые.Получить(НРег(ИмяМетаданных(Тип) + "." + Оп.name)) = Ложь, "shared", "separated");
				Оп.decision = "keep_main";
				Оп.note = "Объект с данными — в расширение не переносится; нужно решение (оставить в основной/перенести вручную).";
				Данные.Добавить(Оп);
			Иначе
				Оп.kind = "resource";
				Ресурсы.Добавить(Оп);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ФормыУп = ФормыТолькоУпУТиповых(КореньУп, КореньБп);
	Для Каждого Оп Из ФормыУп Цикл
		Код.Добавить(Оп);
	КонецЦикла;
	НайтиСсылки(КореньУп, Имена);
	Для Каждого Оп Из Код Цикл
		Если Оп.decision <> "" Тогда
			Продолжить;
		КонецЕсли;
		Если Оп.referencedFrom.Количество() = 0 Тогда
			Оп.decision = "move";
			Оп.note = "Ссылок из кода/метаданных основной конфигурации нет — можно переносить собственным объектом расширения.";
		Иначе
			Оп.decision = "move_keep_main";
			Оп.note = "На объект ссылается основная конфигурация — при переносе в расширение объект нельзя удалять из основной (оставить и отметить).";
		КонецЕсли;
	КонецЦикла;
	СохранитьJson(ОбъединитьПути(КаталогВыхода, "uponly_objects.json"), Новый Структура("code, resources", Код, Ресурсы));
	СохранитьJson(ОбъединитьПути(КаталогВыхода, "uponly_data_objects.json"), Данные);
	Опасных = 0;
	Свободных = 0;
	Для Каждого Оп Из Код Цикл
		Опасных = Опасных + ?(Оп.safeMode.Количество() > 0, 1, 0);
		Свободных = Свободных + ?(Оп.decision = "move", 1, 0);
	КонецЦикла;
	Итог = Новый Структура("code, free, referenced, data, resources, safeModeMarked, formsOnVendorObjects",
		Код.Количество(), Свободных, Код.Количество() - Свободных, Данные.Количество(), Ресурсы.Количество(), Опасных, ФормыУп.Количество());
	Лог.Добавить("Объекты только в УП: кода " + Итог.code + " (без ссылок из основной " + Итог.free + ", форм УП у типовых объектов "
		+ Итог.formsOnVendorObjects + ", с вызовами, опасными в безопасном режиме " + Итог.safeModeMarked + "), объектов с данными "
		+ Итог.data + " (не переносятся), ресурсов " + Итог.resources + " — uponly_objects.json, uponly_data_objects.json");
	Возврат Итог;
КонецФункции

Процедура ОписатьМодули(Оп, КаталогОбъекта)
	Если Не (Новый Файл(КаталогОбъекта)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Метки = Новый Соответствие;
	Для Каждого М Из НайтиФайлы(КаталогОбъекта, "*.bsl", Истина) Цикл
		Оп.modules = Оп.modules + 1;
		Текст = НРег(ПрочитатьТекст(М.ПолноеИмя));
		Для Каждого КЗ Из ОпасныеВызовы Цикл
			Если Метки.Получить(КЗ.Ключ) = Неопределено И СтрНайти(Текст, КЗ.Ключ) > 0 Тогда
				Метки.Вставить(КЗ.Ключ, Истина);
				Оп.safeMode.Добавить(КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Формы, которых нет в БП, у объектов, которые есть в обеих конфигурациях.
Функция ФормыТолькоУпУТиповых(КореньУп, КореньБп)
	Рез = Новый Массив;
	Для Каждого Кат Из НайтиФайлы(КореньУп, "*", Ложь) Цикл
		Если Не Кат.ЭтоКаталог() Или ТипыДанных.Получить(Кат.Имя) = Неопределено И ТипыКода.Получить(Кат.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Об Из НайтиФайлы(Кат.ПолноеИмя, "*", Ложь) Цикл
			Если Не Об.ЭтоКаталог() Или Не (Новый Файл(ОбъединитьПути(КореньБп, Кат.Имя, Об.Имя + ".xml"))).Существует() Тогда
				Продолжить;
			КонецЕсли;
			КатФорм = ОбъединитьПути(Об.ПолноеИмя, "Forms");
			Если Не (Новый Файл(КатФорм)).Существует() Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Ф Из НайтиФайлы(КатФорм, "*.xml", Ложь) Цикл
				Если (Новый Файл(ОбъединитьПути(ОбъединитьПути(КореньБп, Кат.Имя, Об.Имя), "Forms", Ф.Имя))).Существует() Тогда
					Продолжить;
				КонецЕсли;
				Оп = Новый Структура("type, name, kind, referencedFrom, safeMode, separation, modules, decision, note",
					Кат.Имя + "\" + Об.Имя + "\Forms", Ф.ИмяБезРасширения, "form", Новый Массив, Новый Массив, "", 0,
					"own_form_in_adopted_object", "Форма УП у типового объекта — собственная форма расширения внутри заимствованного объекта;"
					+ " если форма использует реквизиты объекта, которых нет в БП, — ручной разбор.");
				ОписатьМодули(Оп, ОбъединитьПути(КатФорм, Ф.ИмяБезРасширения));
				Рез.Добавить(Оп);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Ссылки на имена объектов только УП из модулей и XML основной (УП) вне самих объектов.
Процедура НайтиСсылки(КореньУп, Имена)
	Если Имена.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Ч = Новый Массив;
	Для Каждого КЗ Из Имена Цикл
		Ч.Добавить(КЗ.Значение.name);
	КонецЦикла;
	Рв = Новый РегулярноеВыражение("(?<![A-Za-zА-яЁё0-9_])(" + СтрСоединить(Ч, "|") + ")(?![A-Za-zА-яЁё0-9_])");
	Для Каждого Ф Из НайтиФайлы(КореньУп, "*", Истина) Цикл
		Если Ф.ЭтоКаталог() Или (Ф.Расширение <> ".bsl" И Ф.Расширение <> ".xml") Тогда
			Продолжить;
		КонецЕсли;
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, СтрДлина(КореньУп) + 2), "/", "\");
		Если СтрНачинаетсяС(Отн, "Subsystems\") Или СтрНачинаетсяС(Отн, "Roles\") Или Отн = "Configuration.xml" Или Отн = "ConfigDumpInfo.xml" Тогда
			Продолжить; // состав подсистем/ролей и конфигурации — чистятся отдельно
		КонецЕсли;
		Части = СтрРазделить(Отн, "\");
		Свой = НРег(?(Части.Количество() > 1, СтрЗаменить(Части[1], ".xml", ""), ""));
		Совп = Рв.НайтиСовпадения(ПрочитатьТекст(Ф.ПолноеИмя));
		Уже = Новый Соответствие;
		Для Каждого С Из Совп Цикл
			Ключ = НРег(С.Значение);
			Если Ключ = Свой Или Уже.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уже.Вставить(Ключ, Истина);
			Оп = Имена.Получить(Ключ);
			Если Оп <> Неопределено И Оп.referencedFrom.Количество() < 20 Тогда
				Оп.referencedFrom.Добавить(Отн);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// "Тип.Имя" (нрег) -> Ложь, если объект не разделён (DontUse в общем реквизите-разделителе).
Функция РазделённыеОбъекты(КореньУп)
	Р = Новый Соответствие;
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(КореньУп, "CommonAttributes"), "*.xml", Ложь) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если СтрНайти(Т, "<DataSeparation>Separate</DataSeparation>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Рв = Новый РегулярноеВыражение("<xr:Metadata>([^<]+)</xr:Metadata>\s*<xr:Use>([A-Za-z]+)</xr:Use>");
		Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
			Ключ = НРег(С.Группы[1].Значение);
			Если С.Группы[2].Значение = "DontUse" И Р.Получить(Ключ) = Неопределено Тогда
				Р.Вставить(Ключ, Ложь);
			ИначеЕсли С.Группы[2].Значение = "Use" Тогда
				Р.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИмяМетаданных(Каталог)
	Соотв = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Catalogs:Catalog,Documents:Document,InformationRegisters:InformationRegister,AccumulationRegisters:AccumulationRegister,"
		+ "AccountingRegisters:AccountingRegister,CalculationRegisters:CalculationRegister,ChartsOfCharacteristicTypes:ChartOfCharacteristicTypes,"
		+ "ChartsOfAccounts:ChartOfAccounts,ChartsOfCalculationTypes:ChartOfCalculationTypes,ExchangePlans:ExchangePlan,BusinessProcesses:BusinessProcess,"
		+ "Tasks:Task,Constants:Constant,SessionParameters:SessionParameter,ScheduledJobs:ScheduledJob,DocumentJournals:DocumentJournal,Sequences:Sequence", ",") Цикл
		К = СтрРазделить(П, ":");
		Соотв.Вставить(К[0], К[1]);
	КонецЦикла;
	Р = Соотв.Получить(Каталог);
	Возврат ?(Р = Неопределено, Каталог, Р);
КонецФункции

Функция ПрочитатьТекст(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

Процедура СохранитьJson(Путь, Значение)
	З = Новый ЗаписьJSON;
	З.УстановитьСтроку();
	ЗаписатьJSON(З, Значение);
	Зп = Новый ЗаписьТекста(Путь, "UTF-8");
	Зп.Записать(З.Закрыть());
	Зп.Закрыть();
КонецПроцедуры

ТипыКода = Новый Соответствие;
Для Каждого Т Из СтрРазделить("CommonModules,DataProcessors,Reports,CommonForms,CommonCommands", ",") Цикл
	ТипыКода.Вставить(Т, Истина);
КонецЦикла;
ТипыДанных = Новый Соответствие;
Для Каждого Т Из СтрРазделить("Catalogs,Documents,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,"
	+ "ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,ExchangePlans,BusinessProcesses,Tasks,Constants,"
	+ "SessionParameters,DocumentJournals,Sequences,ScheduledJobs", ",") Цикл
	ТипыДанных.Вставить(Т, Истина);
КонецЦикла;
ОпасныеВызовы = Новый Соответствие;
Для Каждого П Из СтрРазделить("новый comобъект:COM;новый comобject:COM;выполнить(:Выполнить;вычислить(:Вычислить;"
	+ "подключитьвнешнююкомпоненту:внешняя компонента;установитьвнешнююкомпоненту:внешняя компонента;"
	+ "новый записьтекста:файлы;новый чтениетекста:файлы;новый файл(:файлы;копироватьфайл(:файлы;удалитьфайлы(:файлы;"
	+ "переместитьфайл(:файлы;создатькаталог(:файлы;найтифайлы(:файлы;запуститьприложение(:запуск приложения;"
	+ "новый ftpсоединение:сеть;новый httpсоединение:сеть;новый интернетпочта:сеть;установитьпривилегированныйрежим(:привилегированный режим", ";") Цикл
	К = СтрРазделить(П, ":");
	ОпасныеВызовы.Вставить(К[0], К[1]);
КонецЦикла;
