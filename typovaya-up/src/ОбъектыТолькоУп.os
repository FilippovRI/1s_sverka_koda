// Объекты, которые есть только в УП (нет в БП): инвентаризация и решение о переносе в расширение.
// Переносятся собственными объектами расширения (имена как в УП): общие модули, обработки, отчёты
// и формы УП у типовых объектов. Объекты с данными (uponly_data_objects.json) НЕ переносятся.
// Ссылки ищутся в ИТОГОВОЙ основной конфигурации: выгрузка УП с наложенными модулями restored, без файлов
// переносимых объектов, без подсистем/ролей/командных интерфейсов (они чистятся) и без макетов.
// Неподвижная точка: объект, на который ссылается оставшийся в основной объект, тоже остаётся.
// Отметки безопасного режима и разделения данных — информационные (свой Fresh, расширение на уровне конфигурации).

Перем ТипыКода;
Перем ТипыДанных;
Перем ТипыПереноса;
Перем ОпасныеВызовы;
Перем КаталогКласса;      // Class -> папка выгрузки
Перем ЗаимствуемыеКлассы; // Class -> Истина: можно заимствовать объект целиком (ссылка на тип/объект)
Перем КлассыСКомандами;
Перем СтандартныеПоля;    // нрег имя стандартного реквизита (рус/англ)
Перем Символ;             // класс символов идентификатора для регулярных выражений

// ---------- Инвентаризация ----------

Функция Инвентаризация(КореньУп, КореньБп) Экспорт
	Код = Новый Массив;
	Данные = Новый Массив;
	Ресурсы = Новый Массив;
	Разделённые = РазделённыеОбъекты(КореньУп);
	Для Каждого Кат Из НайтиФайлы(КореньУп, "*", Ложь) Цикл
		Если Не Кат.ЭтоКаталог() Или Кат.Имя = "Ext" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Кат.ПолноеИмя, "*.xml", Ложь) Цикл
			Если (Новый Файл(ОбъединитьПути(КореньБп, Кат.Имя, Ф.Имя))).Существует()
				Или (Новый Файл(ОбъединитьПути(КореньБп, Кат.Имя, Ф.ИмяБезРасширения))).Существует() Тогда
				Продолжить; // объект есть в БП (XML или каталог модулей)
			КонецЕсли;
			Тип = Кат.Имя;
			Оп = НовоеОписание(Тип, Ф.ИмяБезРасширения, "", Тип + "\" + Ф.ИмяБезРасширения);
			Если ТипыКода.Получить(Тип) <> Неопределено Тогда
				Оп.kind = "code";
				ОписатьМодули(Оп, ОбъединитьПути(Кат.ПолноеИмя, Ф.ИмяБезРасширения));
				Код.Добавить(Оп);
			ИначеЕсли ТипыДанных.Получить(Тип) <> Неопределено Тогда
				Оп.kind = "data";
				Оп.separation = ?(Разделённые.Получить(НРег(ИмяМетаданных(Тип) + "." + Оп.name)) = Ложь, "shared", "separated");
				Оп.decision = "keep_main";
				Оп.note = "Объект с данными — в расширение не переносится; нужно решение (оставить в основной/перенести вручную).";
				Данные.Добавить(Оп);
			Иначе
				Оп.kind = "resource";
				Ресурсы.Добавить(Оп);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ФормыУп = ФормыТолькоУпУТиповых(КореньУп, КореньБп);
	Для Каждого Оп Из ФормыУп Цикл
		Код.Добавить(Оп);
	КонецЦикла;
	Возврат Новый Структура("Код, Данные, Ресурсы, ФормыУп", Код, Данные, Ресурсы, ФормыУп);
КонецФункции

Функция НовоеОписание(Тип, Имя, Вид, Ключ)
	Возврат Новый Структура("type, name, kind, key, referencedFrom, safeMode, separation, modules, decision, note, adopt",
		Тип, Имя, Вид, Ключ, Новый Массив, Новый Массив, "", 0, "", "", Новый Массив);
КонецФункции

Процедура ОписатьМодули(Оп, КаталогОбъекта)
	Если Не (Новый Файл(КаталогОбъекта)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Метки = Новый Соответствие;
	Для Каждого М Из НайтиФайлы(КаталогОбъекта, "*.bsl", Истина) Цикл
		Оп.modules = Оп.modules + 1;
		Текст = НРег(ПрочитатьТекст(М.ПолноеИмя));
		Для Каждого КЗ Из ОпасныеВызовы Цикл
			Если Метки.Получить(КЗ.Ключ) = Неопределено И СтрНайти(Текст, КЗ.Ключ) > 0 Тогда
				Метки.Вставить(КЗ.Ключ, Истина);
				Оп.safeMode.Добавить(КЗ.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Формы, которых нет в БП, у объектов, которые есть в обеих конфигурациях.
Функция ФормыТолькоУпУТиповых(КореньУп, КореньБп)
	Рез = Новый Массив;
	Для Каждого Кат Из НайтиФайлы(КореньУп, "*", Ложь) Цикл
		Если Не Кат.ЭтоКаталог() Или ТипыДанных.Получить(Кат.Имя) = Неопределено И ТипыКода.Получить(Кат.Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Об Из НайтиФайлы(Кат.ПолноеИмя, "*", Ложь) Цикл
			Если Не Об.ЭтоКаталог() Или Не (Новый Файл(ОбъединитьПути(КореньБп, Кат.Имя, Об.Имя + ".xml"))).Существует() Тогда
				Продолжить;
			КонецЕсли;
			КатФорм = ОбъединитьПути(Об.ПолноеИмя, "Forms");
			Если Не (Новый Файл(КатФорм)).Существует() Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Ф Из НайтиФайлы(КатФорм, "*.xml", Ложь) Цикл
				Если (Новый Файл(ОбъединитьПути(ОбъединитьПути(КореньБп, Кат.Имя, Об.Имя), "Forms", Ф.Имя))).Существует() Тогда
					Продолжить;
				КонецЕсли;
				Тип = Кат.Имя + "\" + Об.Имя + "\Forms";
				Оп = НовоеОписание(Тип, Ф.ИмяБезРасширения, "form", Тип + "\" + Ф.ИмяБезРасширения);
				ОписатьМодули(Оп, ОбъединитьПути(КатФорм, Ф.ИмяБезРасширения));
				Рез.Добавить(Оп);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ---------- Анализ переноса ----------

// Возвращает Структура(Инв, Кандидаты (ключ -> Оп), Перенос (массив Оп), Оставлено (ключ -> причина), Уиды (uuid -> ключ)).
// КаталогВосст — каталог restored (модули .bsl оттуда подменяют модули УП); может быть "".
// УжеВРасширении — Соответствие "Класс.Имя" объектов, которые черновик уже заимствовал (хуки): их не переносить.
Функция Анализ(КореньУп, КореньБп, КаталогВосст, Лог, УжеВРасширении = Неопределено) Экспорт
	Инв = Инвентаризация(КореньУп, КореньБп);
	Кандидаты = Новый Соответствие;
	Для Каждого Оп Из Инв.Код Цикл
		Если Оп.kind <> "form" И УжеВРасширении <> Неопределено
			И УжеВРасширении.Получить(КлассПоКаталогу(Оп.type) + "." + Оп.name) <> Неопределено Тогда
			Оп.decision = "keep_main";
			Оп.note = "Объект уже заимствован расширением (хуки модулей) — остаётся в основной.";
		ИначеЕсли Оп.kind = "form" Или ТипыПереноса.Получить(Оп.type) <> Неопределено Тогда
			Кандидаты.Вставить(Оп.key, Оп);
		Иначе
			Оп.decision = "keep_main";
			Оп.note = "Тип не входит в перечень переноса (общие модули, обработки, отчёты, формы УП у типовых объектов) — остаётся в основной.";
		КонецЕсли;
	КонецЦикла;
	Сырые = Новый Соответствие;
	Уиды = Новый Соответствие;
	Для Каждого КЗ Из Кандидаты Цикл
		С = СырыеСсылкиОбъекта(КореньУп, КЗ.Значение);
		Сырые.Вставить(КЗ.Ключ, С);
		Для Каждого У Из С.Определённые Цикл
			Уиды.Вставить(У, КЗ.Ключ);
		КонецЦикла;
	КонецЦикла;
	СсылкиУпМета = Новый Соответствие;
	Ссылки = НайтиСсылкиОсновной(КореньУп, КаталогВосст, Кандидаты, Уиды, КореньБп, СсылкиУпМета);
	Оставлено = Новый Соответствие;
	Повтор = Истина;
	Пока Повтор Цикл
		Повтор = Ложь;
		Для Каждого КЗ Из Кандидаты Цикл
			Если Оставлено.Получить(КЗ.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Причина = ПричинаОставить(КЗ.Ключ, КЗ.Значение, Ссылки, Сырые, Кандидаты, Оставлено, КореньУп, КореньБп, СсылкиУпМета);
			Если Причина <> "" Тогда
				Оставлено.Вставить(КЗ.Ключ, Причина);
				Повтор = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Перенос = Новый Массив;
	Для Каждого КЗ Из Кандидаты Цикл
		Оп = КЗ.Значение;
		Владельцы = Ссылки.Получить(КЗ.Ключ);
		Если Владельцы <> Неопределено Тогда
			Для Каждого В Из Владельцы Цикл
				Если Оп.referencedFrom.Количество() < 20 Тогда
					Оп.referencedFrom.Добавить(В.Ключ);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Причина = Оставлено.Получить(КЗ.Ключ);
		Если Причина = Неопределено Тогда
			Оп.decision = "moved";
			Оп.note = "Перенесён в расширение собственным объектом; из основной (restored) удалён.";
			Оп.adopt = ТребуемыеЗаимствования(КЗ.Ключ, Оп, Сырые.Получить(КЗ.Ключ), Кандидаты, Оставлено, КореньУп);
			Перенос.Добавить(Оп);
		Иначе
			Оп.decision = "keep_main";
			Оп.note = Причина;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Инв, Кандидаты, Перенос, Оставлено, Уиды", Инв, Кандидаты, Перенос, Оставлено, Уиды);
КонецФункции

// Совместимость: только инвентаризация и решение (без записи файлов переноса).
Функция Проверить(КореньУп, КореньБп, КаталогВыхода, Лог, КаталогВосст = "") Экспорт
	Ан = Анализ(КореньУп, КореньБп, КаталогВосст, Лог);
	Возврат ЗаписатьОтчёт(Ан, КаталогВыхода, Лог, Неопределено);
КонецФункции

Функция ЗаписатьОтчёт(Ан, КаталогВыхода, Лог, ИтогПереноса) Экспорт
	Инв = Ан.Инв;
	СохранитьJson(ОбъединитьПути(КаталогВыхода, "uponly_objects.json"), Новый Структура("code, resources", Инв.Код, Инв.Ресурсы));
	СохранитьJson(ОбъединитьПути(КаталогВыхода, "uponly_data_objects.json"), Инв.Данные);
	Опасных = 0;
	ОпасныхПеренесено = 0;
	ПоПричинам = Новый Структура("referencedByMain, referencedByUpMain, referencedByKept, needsManualAdoption, typeNotMoved", 0, 0, 0, 0, 0);
	ПоТипам = Новый Соответствие;
	Для Каждого Оп Из Инв.Код Цикл
		Опасных = Опасных + ?(Оп.safeMode.Количество() > 0, 1, 0);
		Т = ?(Оп.kind = "form", "FormsOnVendorObjects", Оп.type);
		Счёт = ПоТипам.Получить(Т);
		Если Счёт = Неопределено Тогда
			Счёт = Новый Структура("moved, kept", 0, 0);
			ПоТипам.Вставить(Т, Счёт);
		КонецЕсли;
		Если Оп.decision = "moved" Тогда
			Счёт.moved = Счёт.moved + 1;
			ОпасныхПеренесено = ОпасныхПеренесено + ?(Оп.safeMode.Количество() > 0, 1, 0);
		Иначе
			Счёт.kept = Счёт.kept + 1;
			Если СтрНачинаетсяС(Оп.note, "Тип не входит") Или СтрНачинаетсяС(Оп.note, "Объект уже заимствован") Тогда
				ПоПричинам.typeNotMoved = ПоПричинам.typeNotMoved + 1;
			ИначеЕсли СтрНачинаетсяС(Оп.note, "Нужно заимствование") Тогда
				ПоПричинам.needsManualAdoption = ПоПричинам.needsManualAdoption + 1;
			ИначеЕсли СтрНачинаетсяС(Оп.note, "Ссылка из объекта УП") Тогда
				ПоПричинам.referencedByUpMain = ПоПричинам.referencedByUpMain + 1;
			ИначеЕсли СтрНачинаетсяС(Оп.note, "Ссылается объект, оставленный") Тогда
				ПоПричинам.referencedByKept = ПоПричинам.referencedByKept + 1;
			Иначе
				ПоПричинам.referencedByMain = ПоПричинам.referencedByMain + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Типы = Новый Структура;
	Для Каждого КЗ Из ПоТипам Цикл
		Типы.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Итог = Новый Структура("code, moved, kept, keptReasons, byType, data, resources, safeModeMarked, safeModeMovedMarked, formsOnVendorObjects, transfer",
		Инв.Код.Количество(), Ан.Перенос.Количество(), Инв.Код.Количество() - Ан.Перенос.Количество(), ПоПричинам, Типы,
		Инв.Данные.Количество(), Инв.Ресурсы.Количество(), Опасных, ОпасныхПеренесено, Инв.ФормыУп.Количество(), ИтогПереноса);
	Лог.Добавить("Объекты только в УП: кода " + Итог.code + ", перенесено в расширение " + Итог.moved + ", оставлено в основной " + Итог.kept
		+ " (ссылки из типового БП " + ПоПричинам.referencedByMain + ", из объектов УП с данными/ресурсов " + ПоПричинам.referencedByUpMain + ", ссылки из оставленных " + ПоПричинам.referencedByKept
		+ ", нужно ручное заимствование " + ПоПричинам.needsManualAdoption + ", тип не переносится " + ПоПричинам.typeNotMoved
		+ "); с вызовами, опасными в безопасном режиме, " + Опасных + " (из них перенесено " + ОпасныхПеренесено + "); объектов с данными "
		+ Итог.data + " (не переносятся), ресурсов " + Итог.resources + " — uponly_objects.json, uponly_data_objects.json");
	Возврат Итог;
КонецФункции

// ---------- Ссылки из итоговой основной конфигурации ----------

// Ключ -> Соответствие(владелец -> Истина). Владелец — ключ объекта (Папка\Имя) или формы (Папка\Имя\Forms\Форма).
// СсылкиУпМета — то же для ссылок из XML объектов БП, которых нет в XML БП (доработка УП в метаданных, XML остаётся в основной).
Функция НайтиСсылкиОсновной(КореньУп, КаталогВосст, Кандидаты, Уиды, КореньБп = "", СсылкиУпМета = Неопределено) Экспорт
	Если СсылкиУпМета = Неопределено Тогда
		СсылкиУпМета = Новый Соответствие;
	КонецЕсли;
	Ссылки = Новый Соответствие;
	ПоИмени = Новый Соответствие;
	// формы у типовых объектов: имя формы (ФормаВыбора, ФормаСписка…) неуникально, поэтому ссылкой считается
	// «Объект.Форма.Имя» / «Объект.Form.Имя» где угодно, а голое имя — только в файлах самого объекта-владельца
	ПоФорме = Новый Соответствие;      // "нрег объект.нрег форма" -> массив ключей
	ФормыВладельца = Новый Соответствие; // Папка\Объект -> Соответствие(нрег форма -> ключ)
	ИменаОбъектов = Новый Соответствие;
	ИменаФорм = Новый Соответствие;
	Для Каждого КЗ Из Кандидаты Цикл
		Оп = КЗ.Значение;
		Если Оп.kind = "form" Тогда
			Ч = СтрРазделить(КЗ.Ключ, "\");
			ДобавитьВСписок(ПоФорме, НРег(Ч[1]) + "." + НРег(Оп.name), КЗ.Ключ);
			ИменаОбъектов.Вставить(НРег(Ч[1]), Истина);
			ИменаФорм.Вставить(НРег(Оп.name), Истина);
			Ф = ФормыВладельца.Получить(Ч[0] + "\" + Ч[1]);
			Если Ф = Неопределено Тогда
				Ф = Новый Соответствие;
				ФормыВладельца.Вставить(Ч[0] + "\" + Ч[1], Ф);
			КонецЕсли;
			Ф.Вставить(НРег(Оп.name), КЗ.Ключ);
		Иначе
			ДобавитьВСписок(ПоИмени, НРег(Оп.name), КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Кандидаты.Количество() = 0 Тогда
		Возврат Ссылки;
	КонецЕсли;
	// текст приводится к нижнему регистру один раз, выражения — без игнорирования регистра (быстрее)
	Рв = Новый РегулярноеВыражение("(?<!" + Символ + ")(" + СтрСоединить(Ключи(ПоИмени, "zzzнетимени"), "|") + ")(?!" + Символ + ")");
	Рв.ИгнорироватьРегистр = Ложь;
	РвФ = Новый РегулярноеВыражение("(?<!" + Символ + ")(" + СтрСоединить(Ключи(ИменаОбъектов, "zzzнетимени"), "|") + ")\.(?:форма|form)\.("
		+ СтрСоединить(Ключи(ИменаФорм, "zzzнетимени"), "|") + ")(?!" + Символ + ")");
	РвФ.ИгнорироватьРегистр = Ложь;
	РвГолых = Новый Соответствие;
	РвУид = Новый РегулярноеВыражение("\d:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})");
	РвУид.ИгнорироватьРегистр = Ложь;
	РвФорм = Новый РегулярноеВыражение("<form>[^<]*</form>");
	РвФорм.ИгнорироватьРегистр = Ложь;
	К = Новый Структура("Рв, РвФ, РвУид, ПоИмени, ПоФорме, ФормыВладельца, РвГолых, Уиды", Рв, РвФ, РвУид, ПоИмени, ПоФорме, ФормыВладельца, РвГолых, Уиды);
	Длина = СтрДлина(КореньУп);
	Для Каждого Ф Из НайтиФайлы(КореньУп, "*", Истина) Цикл
		Расш = НРег(Ф.Расширение);
		Если Расш <> ".bsl" И Расш <> ".xml" Тогда
			Продолжить;
		КонецЕсли;
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, Длина + 2), "/", "\");
		Части = СтрРазделить(Отн, "\");
		Если Не ФайлОсновнойДляСсылок(Отн, Части) Тогда
			Продолжить;
		КонецЕсли;
		Владелец = ВладелецФайла(Части, Кандидаты);
		// итоговая основная = УП + restored: модуль из restored — типовой вид; иначе остаётся файл УП
		ВерхО = ?(Части.Количество() >= 2, ВерхКлюч(Владелец), Владелец);
		ВБп = ОбъектЕстьВБп(КореньБп, ВерхО);
		ОтнОС = СтрЗаменить(Отн, "\", ПолучитьРазделительПути());
		ПутьБп = ?(КореньБп = "", "", ОбъединитьПути(КореньБп, ОтнОС));
		ЕстьБп = ПутьБп <> "" И (Новый Файл(ПутьБп)).Существует();
		Если Расш = ".bsl" Тогда
			ПутьВ = ?(КаталогВосст = "", "", ОбъединитьПути(КаталогВосст, ОтнОС));
			Если ПутьВ <> "" И (Новый Файл(ПутьВ)).Существует() Тогда
				// модуль в типовом виде (restored) — все его ссылки типовые/остающиеся
				Для Каждого КЗ Из КлючиВТексте(ТекстДляСсылок(ПутьВ, Отн, Части, Расш, РвФорм), Расш, Части, Владелец, К) Цикл
					ДобавитьСсылку(Ссылки, КЗ.Ключ, Владелец);
				КонецЦикла;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		// модуль не в restored / метаданные: в основной остаётся файл УП; ссылка «типовая», только если она есть и в файле БП
		КлУп = КлючиВТексте(ТекстДляСсылок(Ф.ПолноеИмя, Отн, Части, Расш, РвФорм), Расш, Части, Владелец, К);
		Если КлУп.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		КлБп = Неопределено;
		Если ВБп И ЕстьБп Тогда
			КлБп = КлючиВТексте(ТекстДляСсылок(ПутьБп, Отн, Части, Расш, РвФорм), Расш, Части, Владелец, К);
		КонецЕсли;
		Для Каждого КЗ Из КлУп Цикл
			Если Не ВБп Или КлБп <> Неопределено И КлБп.Получить(КЗ.Ключ) <> Неопределено Тогда
				ДобавитьСсылку(Ссылки, КЗ.Ключ, Владелец);
			Иначе
				ДобавитьСсылку(СсылкиУпМета, КЗ.Ключ, Владелец);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Ссылки;
КонецФункции

// Ключи кандидатов, на которые ссылается текст (нрег) файла.
Функция КлючиВТексте(Текст, Расш, Части, Владелец, К)
	Найдено = Новый Соответствие;
	Рв = К.Рв; РвФ = К.РвФ; РвУид = К.РвУид; ПоИмени = К.ПоИмени; ПоФорме = К.ПоФорме;
	ФормыВладельца = К.ФормыВладельца; РвГолых = К.РвГолых; Уиды = К.Уиды;
	Уже = Новый Соответствие;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Н = С.Значение;
		Если Уже.Получить(Н) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Н, Истина);
		Сп = ПоИмени.Получить(Н);
		Если Сп <> Неопределено Тогда
			Для Каждого Ключ Из Сп Цикл
				Найдено.Вставить(Ключ, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(Текст, ".форма.") > 0 Или СтрНайти(Текст, ".form.") > 0 Тогда
		Для Каждого С Из РвФ.НайтиСовпадения(Текст) Цикл
			Сп = ПоФорме.Получить(С.Группы[1].Значение + "." + С.Группы[2].Значение);
			Если Сп <> Неопределено Тогда
				Для Каждого Ключ Из Сп Цикл
					Найдено.Вставить(Ключ, Истина);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Верх = ?(Части.Количество() >= 2, ВерхКлюч(Владелец), "");
	ФормыОб = ?(Верх = "", Неопределено, ФормыВладельца.Получить(Верх));
	Если ФормыОб <> Неопределено Тогда
		РвГ = РвГолых.Получить(Верх);
		Если РвГ = Неопределено Тогда
			РвГ = Новый РегулярноеВыражение("(?<!" + Символ + ")(" + СтрСоединить(Ключи(ФормыОб, "zzzнетимени"), "|") + ")(?!" + Символ + ")");
			РвГ.ИгнорироватьРегистр = Ложь;
			РвГолых.Вставить(Верх, РвГ);
		КонецЕсли;
		Для Каждого С Из РвГ.НайтиСовпадения(Текст) Цикл
			Найдено.Вставить(ФормыОб.Получить(С.Значение), Истина);
		КонецЦикла;
	КонецЕсли;
	Если Расш = ".xml" И СтрНайти(Текст, ":") > 0 Тогда
		Для Каждого С Из РвУид.НайтиСовпадения(Текст) Цикл
			Ключ = Уиды.Получить(С.Группы[1].Значение);
			Если Ключ <> Неопределено Тогда
				Найдено.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Найдено;
КонецФункции

Функция ТекстДляСсылок(Путь, Отн, Части, Расш, РвФорм)
	Текст = НРег(ПрочитатьТекст(Путь));
	Если Отн = "Configuration.xml" Тогда
		Поз = СтрНайти(Текст, "<childobjects>");
		Если Поз > 0 Тогда
			Текст = Лев(Текст, Поз - 1);
		КонецЕсли;
	ИначеЕсли Части.Количество() = 2 И Расш = ".xml" Тогда
		Текст = РвФорм.Заменить(Текст, ""); // состав форм объекта чистится отдельно
	КонецЕсли;
	Возврат Текст;
КонецФункции

Процедура ДобавитьВСписок(Соотв, Ключ, Значение)
	Сп = Соотв.Получить(Ключ);
	Если Сп = Неопределено Тогда
		Сп = Новый Массив;
		Соотв.Вставить(Ключ, Сп);
	КонецЕсли;
	Сп.Добавить(Значение);
КонецПроцедуры

Функция Ключи(Соотв, ЕслиПусто)
	Рез = Новый Массив;
	Для Каждого КЗ Из Соотв Цикл
		Рез.Добавить(КЗ.Ключ);
	КонецЦикла;
	Если Рез.Количество() = 0 Тогда
		Рез.Добавить(ЕслиПусто);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Процедура ДобавитьСсылку(Ссылки, Ключ, Владелец)
	Если Ключ = Владелец Тогда
		Возврат;
	КонецЕсли;
	В = Ссылки.Получить(Ключ);
	Если В = Неопределено Тогда
		В = Новый Соответствие;
		Ссылки.Вставить(Ключ, В);
	КонецЕсли;
	В.Вставить(Владелец, Истина);
КонецПроцедуры

// Подсистемы, роли, командные интерфейсы и состав конфигурации чистятся при переносе; макеты не содержат ссылок на код.
Функция ФайлОсновнойДляСсылок(Отн, Части) Экспорт
	Если Части[0] = "Subsystems" Или Части[0] = "Roles" Или Отн = "ConfigDumpInfo.xml" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Отн = "Ext\CommandInterface.xml" Или Отн = "Ext\MainSectionCommandInterface.xml" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Части.Количество() > 2 И (Части[2] = "Templates" Или Части[0] = "CommonTemplates" И Части[2] = "Ext") Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ВладелецФайла(Части, Кандидаты) Экспорт
	Если Части.Количество() < 2 Тогда
		Возврат Части[0];
	КонецЕсли;
	Имя = Части[1];
	Если Части.Количество() = 2 И НРег(Прав(Имя, 4)) = ".xml" Тогда
		Имя = Лев(Имя, СтрДлина(Имя) - 4);
	КонецЕсли;
	Верх = Части[0] + "\" + Имя;
	Если Части.Количество() >= 4 И Части[2] = "Forms" Тогда
		ИмяФ = Части[3];
		Если Части.Количество() = 4 И НРег(Прав(ИмяФ, 4)) = ".xml" Тогда
			ИмяФ = Лев(ИмяФ, СтрДлина(ИмяФ) - 4);
		КонецЕсли;
		КлючФ = Верх + "\Forms\" + ИмяФ;
		Если Кандидаты.Получить(КлючФ) <> Неопределено Тогда
			Возврат КлючФ;
		КонецЕсли;
	КонецЕсли;
	Возврат Верх;
КонецФункции

// ---------- Метаданные переносимого объекта: что придётся заимствовать ----------

// Файлы XML объекта (без макетов): объект и всё в его каталоге, либо метаданные и тело формы.
Функция ФайлыОбъекта(КореньУп, Оп, ТолькоXml = Истина) Экспорт
	Рез = Новый Массив;
	Если Оп.kind = "form" Тогда
		Кат = ОбъединитьПути(КореньУп, СтрЗаменить(Оп.type, "\", ПолучитьРазделительПути()));
	Иначе
		Кат = ОбъединитьПути(КореньУп, Оп.type);
	КонецЕсли;
	Мета = ОбъединитьПути(Кат, Оп.name + ".xml");
	Если (Новый Файл(Мета)).Существует() Тогда
		Рез.Добавить(Мета);
	КонецЕсли;
	Папка = ОбъединитьПути(Кат, Оп.name);
	Если (Новый Файл(Папка)).Существует() Тогда
		Для Каждого Ф Из НайтиФайлы(Папка, "*", Истина) Цикл
			Если Ф.ЭтоКаталог() Тогда
				Продолжить;
			КонецЕсли;
			Если ТолькоXml И (НРег(Ф.Расширение) <> ".xml" Или СтрНайти(Ф.ПолноеИмя, ПолучитьРазделительПути() + "Templates" + ПолучитьРазделительПути()) > 0) Тогда
				Продолжить;
			КонецЕсли;
			Рез.Добавить(Ф.ПолноеИмя);
		КонецЦикла;
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция СырыеСсылкиОбъекта(КореньУп, Оп) Экспорт
	Мета = Новый Массив;
	Стили = Новый Соответствие;
	ПоУиду = Новый Соответствие;
	Определённые = Новый Массив;
	Поля = Новый Соответствие;
	РвМ = РегВыражениеМетаСсылки();
	РвС = Новый РегулярноеВыражение("style:(" + Символ + "+)");
	РвС.ИгнорироватьРегистр = Ложь;
	РвУ = Новый РегулярноеВыражение("\d:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})");
	РвО = Новый РегулярноеВыражение("uuid=""([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})""");
	Уже = Новый Соответствие;
	Для Каждого Путь Из ФайлыОбъекта(КореньУп, Оп) Цикл
		Текст = ПрочитатьТекст(Путь);
		Для Каждого С Из РвО.НайтиСовпадения(Текст) Цикл
			Определённые.Добавить(НРег(С.Группы[1].Значение));
		КонецЦикла;
		Для Каждого С Из РвМ.НайтиСовпадения(Текст) Цикл
			Кл = С.Значение;
			Если Уже.Получить(Кл) = Неопределено Тогда
				Уже.Вставить(Кл, Истина);
				Мета.Добавить(Новый Структура("Класс, Суффикс, Имя, Под, ПодИмя", С.Группы[1].Значение, С.Группы[2].Значение,
					С.Группы[3].Значение, С.Группы[5].Значение, С.Группы[6].Значение));
			КонецЕсли;
		КонецЦикла;
		Для Каждого С Из РвС.НайтиСовпадения(Текст) Цикл
			Стили.Вставить(С.Группы[1].Значение, Истина);
		КонецЦикла;
		Для Каждого С Из РвУ.НайтиСовпадения(Текст) Цикл
			ПоУиду.Вставить(НРег(С.Группы[1].Значение), Истина);
		КонецЦикла;
		Если Оп.kind = "form" И НРег(Прав(Путь, 8)) = "form.xml" Тогда
			Для Каждого П Из ПоляОбъектаФормы(Текст) Цикл
				Поля.Вставить(П, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Мета, Стили, ПоУиду, Определённые, Поля", Мета, Стили, ПоУиду, Определённые, Поля);
КонецФункции

Функция РегВыражениеМетаСсылки()
	Классы = "DocumentJournal|DocumentNumerator|Document|ChartOfCharacteristicTypes|ChartOfCalculationTypes|ChartOfAccounts"
		+ "|InformationRegister|AccumulationRegister|AccountingRegister|CalculationRegister|ExchangePlan|BusinessProcess|Task"
		+ "|Catalog|Enum|Report|DataProcessor|CommonPicture|StyleItem|CommonCommand|CommonForm|CommonModule|CommonTemplate"
		+ "|CommonAttribute|DefinedType|Constant|SettingsStorage|FunctionalOptionsParameter|FunctionalOption|CommandGroup|Subsystem"
		+ "|SessionParameter|FilterCriterion|Role|Style|Sequence|XDTOPackage|WebService|HTTPService|EventSubscription|ScheduledJob";
	Суффиксы = "TabularSectionRow|TabularSection|RecordManager|RecordSet|RecordKey|Ref|Object|Selection|List|Manager|ValueManager|ValueKey";
	Р = Новый РегулярноеВыражение("(?<![A-Za-z0-9_.])(" + Классы + ")(" + Суффиксы + ")?\.(" + Символ + "+)(\.([A-Za-z]+)\.(" + Символ + "+))?");
	Р.ИгнорироватьРегистр = Ложь;
	Возврат Р;
КонецФункции

// Нестандартные реквизиты основного реквизита формы объекта (Объект.Х / Запись.Х): их нужно заимствовать.
Функция ПоляОбъектаФормы(Текст) Экспорт
	Рез = Новый Массив;
	РвА = Новый РегулярноеВыражение("<Attribute name=""(" + Символ + "+)""[^>]*>\s*<Type>\s*<v8:Type>cfg:[A-Za-z]+(Object|RecordManager|RecordSet)\.");
	РвА.ИгнорироватьРегистр = Ложь;
	Для Каждого А Из РвА.НайтиСовпадения(Текст) Цикл
		Имя = А.Группы[1].Значение;
		РвП = Новый РегулярноеВыражение("(?<!" + Символ + "|\.)" + Имя + "\.(" + Символ + "+)");
		РвП.ИгнорироватьРегистр = Ложь;
		Для Каждого П Из РвП.НайтиСовпадения(Текст) Цикл
			Поле = П.Группы[1].Значение;
			Если СтандартныеПоля.Получить(НРег(Поле)) = Неопределено И Рез.Найти(Поле) = Неопределено Тогда
				Рез.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ОбъектЕстьВБп(КореньБп, Верх) Экспорт
	Если КореньБп = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Ч = СтрРазделить(Верх, "\");
	Если Ч.Количество() < 2 Тогда
		Возврат (Новый Файл(ОбъединитьПути(КореньБп, Ч[0]))).Существует();
	КонецЕсли;
	Кат = ОбъединитьПути(КореньБп, Ч[0]);
	Возврат (Новый Файл(ОбъединитьПути(Кат, Ч[1] + ".xml"))).Существует() Или (Новый Файл(ОбъединитьПути(Кат, Ч[1]))).Существует();
КонецФункции

Функция СуществуетВУп(КореньУп, Папка, Имя)
	Возврат (Новый Файл(ОбъединитьПути(ОбъединитьПути(КореньУп, Папка), Имя + ".xml"))).Существует();
КонецФункции

Функция ВерхКлюч(Ключ)
	Части = СтрРазделить(Ключ, "\");
	Возврат Части[0] + "\" + Части[1];
КонецФункции

Функция СвойПеренос(Ключ, Кандидаты, Оставлено)
	Возврат Кандидаты.Получить(Ключ) <> Неопределено И Оставлено.Получить(Ключ) = Неопределено;
КонецФункции

Функция ПричинаОставить(Ключ, Оп, Ссылки, Сырые, Кандидаты, Оставлено, КореньУп, КореньБп, СсылкиУпМета)
	Владельцы = Ссылки.Получить(Ключ);
	Если Владельцы <> Неопределено Тогда
		Для Каждого В Из Владельцы Цикл
			Если Кандидаты.Получить(В.Ключ) = Неопределено Тогда
				Если ОбъектЕстьВБп(КореньБп, ВерхКлюч(В.Ключ)) Тогда
					Возврат "Ссылка из типового кода/метаданных БП (" + В.Ключ + ") — объект оставлен в основной (не удалён), отмечен.";
				КонецЕсли;
				Возврат "Ссылка из объекта УП, остающегося в основной (данные/ресурсы: " + В.Ключ + ") — объект оставлен в основной, отмечен.";
			ИначеЕсли Оставлено.Получить(В.Ключ) <> Неопределено Тогда
				Возврат "Ссылается объект, оставленный в основной (" + В.Ключ + ") — объект тоже оставлен в основной.";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Владельцы = СсылкиУпМета.Получить(Ключ);
	Если Владельцы <> Неопределено Тогда
		Для Каждого В Из Владельцы Цикл
			Если Кандидаты.Получить(В.Ключ) = Неопределено Или Оставлено.Получить(В.Ключ) <> Неопределено Тогда
				Возврат "Нужно заимствование: ссылка из доработки УП в объекте БП (" + В.Ключ
					+ "; модуль/XML не в restored — остаётся в основной как в УП) — объект оставлен в основной, отмечен (ручной разбор).";
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Р = РазобратьЗаимствования(Ключ, Оп, Сырые.Получить(Ключ), Кандидаты, Оставлено, КореньУп);
	Если Р.Ручные.Количество() > 0 Тогда
		Возврат "Нужно заимствование, которое не делается автоматически: " + СтрСоединить(Р.Ручные, "; ") + " — объект оставлен в основной.";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ТребуемыеЗаимствования(Ключ, Оп, С, Кандидаты, Оставлено, КореньУп)
	Возврат РазобратьЗаимствования(Ключ, Оп, С, Кандидаты, Оставлено, КореньУп).Нужно;
КонецФункции

// Нужно — массив строк "Класс|Папка|Имя" или "Класс|Папка|Имя|Команда"; Ручные — причины.
Функция РазобратьЗаимствования(Ключ, Оп, С, Кандидаты, Оставлено, КореньУп)
	Нужно = Новый Массив;
	Ручные = Новый Массив;
	СвойВерх = ВерхКлюч(Ключ);
	Если Оп.kind = "form" Тогда
		Для Каждого КЗ Из С.Поля Цикл
			ДобавитьУник(Ручные, "реквизит объекта " + КЗ.Ключ + " в форме");
		КонецЦикла;
	КонецЕсли;
	Для Каждого М Из С.Мета Цикл
		Папка = КаталогКласса.Получить(М.Класс);
		Если Папка = Неопределено Или Не СуществуетВУп(КореньУп, Папка, М.Имя) Тогда
			Продолжить; // имя платформы/не объект метаданных УП
		КонецЕсли;
		Верх = Папка + "\" + М.Имя;
		Если Верх = СвойВерх И Оп.kind <> "form" Тогда
			Продолжить;
		КонецЕсли;
		Если СвойПеренос(Верх, Кандидаты, Оставлено) Тогда
			Продолжить; // собственный объект расширения
		КонецЕсли;
		Полное = М.Класс + "." + М.Имя;
		Если СтрНайти(М.Суффикс, "TabularSection") > 0 Тогда
			ДобавитьУник(Ручные, "табличная часть " + Полное);
			Продолжить;
		КонецЕсли;
		Если М.Под = "Form" Тогда
			Если СвойПеренос(Верх + "\Forms\" + М.ПодИмя, Кандидаты, Оставлено) Тогда
				ДобавитьУник(Нужно, М.Класс + "|" + Папка + "|" + М.Имя);
			Иначе
				ДобавитьУник(Ручные, "форма " + Полное + ".Form." + М.ПодИмя);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ЗаимствуемыеКлассы.Получить(М.Класс) = Неопределено Тогда
			ДобавитьУник(Ручные, "объект " + Полное);
			Продолжить;
		КонецЕсли;
		Если М.Под = "" Или М.Под = "StandardCommand" Или М.Под = "StandardAttribute" Тогда
			ДобавитьУник(Нужно, М.Класс + "|" + Папка + "|" + М.Имя);
		ИначеЕсли М.Под = "Command" И КлассыСКомандами.Получить(М.Класс) <> Неопределено Тогда
			ДобавитьУник(Нужно, М.Класс + "|" + Папка + "|" + М.Имя);
			ДобавитьУник(Нужно, М.Класс + "|" + Папка + "|" + М.Имя + "|" + М.ПодИмя);
		Иначе
			ДобавитьУник(Ручные, М.Под + " " + Полное + "." + М.Под + "." + М.ПодИмя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из С.Стили Цикл
		Если СуществуетВУп(КореньУп, "StyleItems", КЗ.Ключ) Тогда
			ДобавитьУник(Нужно, "StyleItem|StyleItems|" + КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из С.ПоУиду Цикл
		Если С.Определённые.Найти(КЗ.Ключ) = Неопределено Тогда
			ДобавитьУник(Ручные, "ссылка по uuid " + КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Оп.kind = "form" Тогда
		Ч = СтрРазделить(Ключ, "\");
		Класс = КлассПоКаталогу(Ч[0]);
		Если Класс = "" Тогда
			ДобавитьУник(Ручные, "владелец формы " + Ч[0] + "\" + Ч[1]);
		Иначе
			ДобавитьУник(Нужно, Класс + "|" + Ч[0] + "|" + Ч[1]);
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("Нужно, Ручные", Нужно, Ручные);
КонецФункции

Функция КлассПоКаталогу(Папка) Экспорт
	Для Каждого КЗ Из КаталогКласса Цикл
		Если КЗ.Значение = Папка Тогда
			Возврат КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция КаталогПоКлассу(Класс) Экспорт
	Р = КаталогКласса.Получить(Класс);
	Возврат ?(Р = Неопределено, "", Р);
КонецФункции

Процедура ДобавитьУник(Массив, Значение)
	Если Массив.Найти(Значение) = Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// ---------- Служебное ----------

// "Тип.Имя" (нрег) -> Ложь, если объект не разделён (DontUse в общем реквизите-разделителе).
Функция РазделённыеОбъекты(КореньУп)
	Р = Новый Соответствие;
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(КореньУп, "CommonAttributes"), "*.xml", Ложь) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если СтрНайти(Т, "<DataSeparation>Separate</DataSeparation>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Рв = Новый РегулярноеВыражение("<xr:Metadata>([^<]+)</xr:Metadata>\s*<xr:Use>([A-Za-z]+)</xr:Use>");
		Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
			Ключ = НРег(С.Группы[1].Значение);
			Если С.Группы[2].Значение = "DontUse" И Р.Получить(Ключ) = Неопределено Тогда
				Р.Вставить(Ключ, Ложь);
			ИначеЕсли С.Группы[2].Значение = "Use" Тогда
				Р.Вставить(Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИмяМетаданных(Каталог)
	Р = КлассПоКаталогу(Каталог);
	Возврат ?(Р = "", Каталог, Р);
КонецФункции


Функция ПрочитатьТекст(Путь) Экспорт
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

Процедура СохранитьJson(Путь, Значение)
	З = Новый ЗаписьJSON;
	З.УстановитьСтроку();
	ЗаписатьJSON(З, Значение);
	Зп = Новый ЗаписьТекста(Путь, "UTF-8");
	Зп.Записать(З.Закрыть());
	Зп.Закрыть();
КонецПроцедуры

Символ = "[A-Za-zА-Яа-яЁё0-9_]";
