// Ручные перехваты доработок УП (typovaya-up/manual_hooks/*.bsl): готовые &ИзменениеИКонтроль с #Вставка/#Удаление,
// построенные по диффу метода БП → УП для модулей ручного разбора (нет безопасного автоматического хука).
// Файл: шапка «// path: <модуль>», «// method: <метод>», затем код перехвата. Строки перехвата вне #Вставка (с учётом
// строк внутри #Удаление) — ожидаемое тело метода БП. Генератор сверяет его с выгрузкой БП: совпало — перехват
// добавляется в модуль extension (объект основной заимствуется, документы/регистры не переносятся), иначе —
// todo_manual_hooks.md/.csv. Повторный запуск идемпотентен.

Перем Мелкие;
Перем ОТУ;

Функция Прочитать(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", СтрЗаменить(Т, Символы.ВК, ""));
КонецФункции

Процедура Записать(Путь, Строки)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

Функция ЭтоОбъявление(Стр, Имя)
	Рв = Новый РегулярноеВыражение("^\s*(Асинх\s+)?(Процедура|Функция)\s+" + Имя + "\s*\(");
	Рв.ИгнорироватьРегистр = Истина;
	Возврат Рв.Совпадает(Стр);
КонецФункции

Функция ЭтоКонец(Стр)
	Н = НРег(СокрЛП(Стр));
	Возврат СтрНачинаетсяС(Н, "конецпроцедуры") Или СтрНачинаетсяС(Н, "конецфункции");
КонецФункции

// Метод модуля: Структура(Объявление, Тело — Массив строк без объявления и конца) или Неопределено.
Функция МетодМодуля(Текст, Имя)
	Если Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Н = 0 По Строки.ВГраница() Цикл
		Если ЭтоОбъявление(Строки[Н], Имя) Тогда
			Тело = Новый Массив;
			Для К = Н + 1 По Строки.ВГраница() Цикл
				Если ЭтоКонец(Строки[К]) И Лев(Строки[К], 1) <> Символы.Таб И Лев(Строки[К], 1) <> " " Тогда
					Возврат Новый Структура("Объявление, Тело", Строки[Н], Тело);
				КонецЕсли;
				Тело.Добавить(Строки[К]);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция Сжать(Строки)
	М = Новый Массив;
	Для Каждого С Из Строки Цикл
		М.Добавить(СокрП(С));
	КонецЦикла;
	Возврат СтрСоединить(М, Символы.ПС);
КонецФункции

// Разбор файла перехвата: Структура(Путь, Метод, Код — Массив строк перехвата, Объявление, ОжидаемоеТело) или Неопределено.
Функция РазобратьПерехват(Текст)
	Р = Новый Структура("Путь, Метод, Код, Объявление, ОжидаемоеТело", "", "", Новый Массив, "", Новый Массив);
	Шапка = Истина;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Если Шапка Тогда
			Если СтрНачинаетсяС(Стр, "// path:") Тогда
				Р.Путь = СокрЛП(Сред(Стр, 9));
			ИначеЕсли СтрНачинаетсяС(Стр, "// method:") Тогда
				Р.Метод = СокрЛП(Сред(Стр, 11));
			ИначеЕсли СокрЛП(Стр) = "" Тогда
				Шапка = Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Р.Код.Добавить(Стр);
	КонецЦикла;
	Пока Р.Код.Количество() > 0 И СокрЛП(Р.Код[Р.Код.ВГраница()]) = "" Цикл
		Р.Код.Удалить(Р.Код.ВГраница());
	КонецЦикла;
	Если Р.Путь = "" Или Р.Метод = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Внутри = Ложь;
	ВВставке = Ложь;
	Для Каждого Стр Из Р.Код Цикл
		Если Не Внутри Тогда
			Если ЭтоОбъявление(Стр, "[\wЁё]+") И Не СтрНачинаетсяС(СокрЛП(Стр), "&") Тогда
				Р.Объявление = Стр;
				Внутри = Истина;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Т = НРег(СокрЛП(Стр));
		Если Т = "#вставка" Тогда
			ВВставке = Истина;
		ИначеЕсли Т = "#конецвставки" Тогда
			ВВставке = Ложь;
		ИначеЕсли Т = "#удаление" Или Т = "#конецудаления" Тогда
			// маркер — тело БП внутри сохраняется
		ИначеЕсли Не ВВставке Тогда
			Р.ОжидаемоеТело.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	// последняя строка — КонецПроцедуры/КонецФункции
	Если Р.ОжидаемоеТело.Количество() > 0 И ЭтоКонец(Р.ОжидаемоеТело[Р.ОжидаемоеТело.ВГраница()]) Тогда
		Р.ОжидаемоеТело.Удалить(Р.ОжидаемоеТело.ВГраница());
	КонецЕсли;
	Возврат Р;
КонецФункции

Функция ТегИИмя(Путь)
	Ч_ = СтрРазделить(Путь, "/");
	Если Ч_.Количество() < 2 Или Ч_[0] = "Ext" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Тег = ОТУ.КлассПоКаталогу(Ч_[0]);
	Возврат ?(Тег = "" Или Тег = Неопределено, Неопределено, Новый Структура("Тег, Имя", Тег, Ч_[1]));
КонецФункции

// Вставка кода перехвата в модуль extension (перед завершающим #КонецЕсли, если модуль им обёрнут).
Процедура ДобавитьВМодуль(ПутьМодуля, ТекстБп, Код)
	Т = Прочитать(ПутьМодуля);
	Если Т = Неопределено Тогда
		Строки = Новый Массив;
		Первая = "";
		Если ТекстБп <> Неопределено Тогда
			Для Каждого С Из СтрРазделить(ТекстБп, Символы.ПС, Ложь) Цикл
				Если СокрЛП(С) <> "" Тогда
					Первая = СокрЛП(С);
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Обёртка = СтрНачинаетсяС(НРег(Первая), "#если");
		Если Обёртка Тогда
			Строки.Добавить(Первая);
		КонецЕсли;
		Для Каждого С Из Код Цикл
			Строки.Добавить(С);
		КонецЦикла;
		Если Обёртка Тогда
			Строки.Добавить("");
			Строки.Добавить("#КонецЕсли");
		КонецЕсли;
		Записать(ПутьМодуля, Строки);
		Возврат;
	КонецЕсли;
	Строки = СтрРазделить(Т, Символы.ПС, Истина);
	Пока Строки.Количество() > 0 И СокрЛП(Строки[Строки.ВГраница()]) = "" Цикл
		Строки.Удалить(Строки.ВГраница());
	КонецЦикла;
	Хвост = Неопределено;
	Если Строки.Количество() > 0 И НРег(СокрЛП(Строки[Строки.ВГраница()])) = "#конецесли" Тогда
		Хвост = Строки[Строки.ВГраница()];
		Строки.Удалить(Строки.ВГраница());
	КонецЕсли;
	Строки.Добавить("");
	Для Каждого С Из Код Цикл
		Строки.Добавить(С);
	КонецЦикла;
	Если Хвост <> Неопределено Тогда
		Строки.Добавить("");
		Строки.Добавить(Хвост);
	КонецЕсли;
	Записать(ПутьМодуля, Строки);
КонецПроцедуры

Функция Применить(КаталогПерехватов, КореньБп, КаталогРас, КаталогВосст, ИмяРасширения, Лог, КаталогОтчёта = "") Экспорт
	Кат = ТекущийСценарий().Каталог;
	ОТУ = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ОбъектыТолькоУп.os"));
	Мелкие = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ПереносМелкихОбъектовУп.os"));
	Рез = Новый Структура("applied, already, rejected, adopted, rows", 0, 0, 0, 0, Новый Массив);
	Если Не (Новый Файл(КаталогПерехватов)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Метки = Новый Массив;
	Файлы = НайтиФайлы(КаталогПерехватов, "*.bsl", Ложь);
	Для Каждого Ф Из Файлы Цикл
		П = РазобратьПерехват(Прочитать(Ф.ПолноеИмя));
		Если П = Неопределено Тогда
			Рез.rows.Добавить(Новый Структура("file, module, method, reason", Ф.Имя, "", "", "нет шапки // path / // method"));
			Рез.rejected = Рез.rejected + 1;
			Продолжить;
		КонецЕсли;
		ТекстБп = Прочитать(ОбъединитьПути(КореньБп, П.Путь));
		МБп = МетодМодуля(ТекстБп, П.Метод);
		Причина = "";
		ТИ = ТегИИмя(П.Путь);
		Если ТИ = Неопределено Тогда
			Причина = "модуль не объекта (уровень конфигурации) — не поддерживается";
		ИначеЕсли МБп = Неопределено Тогда
			Причина = "метода нет в выгрузке БП";
		ИначеЕсли Сжать(МБп.Тело) <> Сжать(П.ОжидаемоеТело) Тогда
			Причина = "тело метода в БП не совпадает с ожидаемым в перехвате (БП обновилась?)";
		КонецЕсли;
		ПутьМодуля = ОбъединитьПути(КаталогРас, П.Путь);
		ТекРас = Прочитать(ПутьМодуля);
		Если Причина = "" И ТекРас <> Неопределено Тогда
			РвА = Новый РегулярноеВыражение("&ИзменениеИКонтроль\s*\(\s*""" + П.Метод + """\s*\)");
			РвА.ИгнорироватьРегистр = Истина;
			Если РвА.Совпадает(ТекРас) Тогда
				Если СтрНайти(ТекРас, СокрЛП(П.Объявление)) > 0 Тогда
					Рез.already = Рез.already + 1;
					ДобавитьМетку(Метки, П.Путь);
					Продолжить;
				КонецЕсли;
				Причина = "в extension уже есть другой перехват метода";
			КонецЕсли;
		КонецЕсли;
		Если Причина <> "" Тогда
			Рез.rows.Добавить(Новый Структура("file, module, method, reason", Ф.Имя, П.Путь, П.Метод, Причина));
			Рез.rejected = Рез.rejected + 1;
			Продолжить;
		КонецЕсли;
		Рез.adopted = Рез.adopted + Мелкие.ЗаимствоватьОбъект(КаталогРас, КаталогВосст, ИмяРасширения, ТИ.Тег, ТИ.Имя);
		ДобавитьВМодуль(ПутьМодуля, ТекстБп, П.Код);
		ДобавитьМетку(Метки, П.Путь);
		Рез.applied = Рез.applied + 1;
	КонецЦикла;
	// модуль объекта/менеджера заимствованного объекта видит только заимствованные реквизиты/ТЧ/значения:
	// заимствуем те, на которые ссылается код модулей с перехватами (общий механизм ЗаимствованиеПолейСписков)
	Рез.Вставить("adoptedChildren", 0);
	Если Метки.Количество() > 0 Тогда
		Зп = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЗаимствованиеПолейСписков.os"));
		Зп.УстановитьЧерновик(ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЧерновикРасширения.os")));
		Корни = Новый Массив;
		Корни.Добавить(КаталогВосст);
		Рп = Зп.Применить(КаталогРас, КаталогВосст, ИмяРасширения, Истина, Корни, Метки);
		Рез.adoptedChildren = Рп.addedChildren.Количество();
		Рез.adopted = Рез.adopted + Рп.addedObjects.Количество();
	КонецЕсли;
	Если КаталогОтчёта <> "" Тогда
		ЗаписатьTodo(КаталогОтчёта, Рез);
	КонецЕсли;
	Лог.Добавить("Ручные перехваты (manual_hooks): применено " + Рез.applied + ", уже были " + Рез.already + ", отклонено (todo) " + Рез.rejected
		+ ", заимствовано объектов " + Рез.adopted + ", реквизитов/значений " + Рез.adoptedChildren);
	Возврат Рез;
КонецФункции

Процедура ДобавитьМетку(Метки, Путь)
	Ч_ = СтрРазделить(Путь, "/");
	Если Ч_.Количество() = 4 И (Ч_[3] = "ObjectModule.bsl" Или Ч_[3] = "ManagerModule.bsl") Тогда
		Метки.Добавить(Ч_[0] + "/" + Ч_[1] + "/" + Лев(Ч_[3], СтрДлина(Ч_[3]) - 4));
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьTodo(Каталог, Рез)
	Csv = Новый Массив;
	Csv.Добавить("Файл;Модуль;Метод;Причина");
	Md = Новый Массив;
	Md.Добавить("# Ручные перехваты (manual_hooks), не применённые генератором");
	Md.Добавить("");
	Md.Добавить("Отклонено: " + Рез.rejected + ". Обновите перехват по новому телу метода БП.");
	Md.Добавить("");
	Md.Добавить("| Файл | Модуль | Метод | Причина |");
	Md.Добавить("|---|---|---|---|");
	Для Каждого С Из Рез.rows Цикл
		Csv.Добавить(С.file + ";" + С.module + ";" + С.method + ";" + С.reason);
		Md.Добавить("| " + С.file + " | " + С.module + " | " + С.method + " | " + С.reason + " |");
	КонецЦикла;
	Записать(ОбъединитьПути(Каталог, "todo_manual_hooks.csv"), Csv);
	Записать(ОбъединитьПути(Каталог, "todo_manual_hooks.md"), Md);
КонецПроцедуры
