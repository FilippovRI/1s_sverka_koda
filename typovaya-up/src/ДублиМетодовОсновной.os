// Задача 10: собственный (без аннотации) метод модуля расширения с тем же именем, что метод модуля
// основной конфигурации, даёт «Процедура или функция с указанным именем уже определена». Такие копии
// появляются, когда вспомогательный метод УП дозаполнен в расширение, а в основной (restored/БП) он уже есть.
// Одинаковые по тексту копии удаляются (вызовы расширения уходят в метод основной), отличающиеся — в отчёт.

Функция ПрочитатьТекст(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Функция Нормализовать(Знач Т) Экспорт
	Т = (Новый РегулярноеВыражение("//[^\n]*")).Заменить(Т, "");
	Т = (Новый РегулярноеВыражение("\s+")).Заменить(Т, " ");
	Возврат НРег(СокрЛП(Т));
КонецФункции

// Методы модуля: Массив Структура(Имя, Начало, Конец, Аннотация, Текст, Директивы, НачалоБлока).
// Начало/Конец — номера строк (с 1); НачалоБлока — первая строка директив/аннотаций над объявлением;
// Директивы — директивы компиляции (&НаСервере…) через «;», нрег.
Функция МетодыМодуля(Текст) Экспорт
	Р = Новый Массив;
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	РвНач = Новый РегулярноеВыражение("^\s*(?:Асинх\s+)?(?:Процедура|Функция)\s+([\wЁё]+)\s*\(");
	РвКон = Новый РегулярноеВыражение("^\s*Конец(?:Процедуры|Функции)\b");
	РвАнн = Новый РегулярноеВыражение("^\s*&([\wЁё]+)");
	Тек = Неопределено;
	Для Н = 0 По Строки.ВГраница() Цикл
		С = Строки[Н];
		Если Тек = Неопределено Тогда
			М = РвНач.НайтиСовпадения(С);
			Если М.Количество() > 0 Тогда
				Анн = "";
				Дир = Новый Массив;
				НачБл = Н + 1;
				Й = Н - 1;
				Пока Й >= 0 И СтрНачинаетсяС(СокрЛ(Строки[Й]), "&") Цикл
					МА = РвАнн.НайтиСовпадения(Строки[Й]);
					Если МА.Количество() > 0 И НРег(Лев(МА[0].Группы[1].Значение, 2)) <> "на" Тогда
						Анн = МА[0].Группы[1].Значение;
					ИначеЕсли МА.Количество() > 0 Тогда
						Дир.Вставить(0, НРег(МА[0].Группы[1].Значение));
					КонецЕсли;
					НачБл = Й + 1;
					Й = Й - 1;
				КонецЦикла;
				Тек = Новый Структура("Имя, Начало, Конец, Аннотация, Текст, Директивы, НачалоБлока", М[0].Группы[1].Значение,
					Н + 1, 0, Анн, "", СтрСоединить(Дир, ";"), НачБл);
			КонецЕсли;
		КонецЕсли;
		Если Тек <> Неопределено И РвКон.НайтиСовпадения(С).Количество() > 0 Тогда
			Тек.Конец = Н + 1;
			Ч = Новый Массив;
			Для Й = Тек.Начало - 1 По Н Цикл
				Ч.Добавить(Строки[Й]);
			КонецЦикла;
			Тек.Текст = СтрСоединить(Ч, Символы.ПС);
			Р.Добавить(Тек);
			Тек = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Убирает из текста модуля расширения собственные копии методов основной. Структура(Текст, Удалены, Отличаются).
Функция ОчиститьТекст(ТекстРасш, ТекстОсн) Экспорт
	Рез = Новый Структура("Текст, Удалены, Отличаются", ТекстРасш, Новый Массив, Новый Массив);
	Осн = Новый Соответствие;
	Для Каждого М Из МетодыМодуля(ТекстОсн) Цикл
		Осн.Вставить(НРег(М.Имя), М);
	КонецЦикла;
	Удалить = Новый Соответствие;
	Для Каждого М Из МетодыМодуля(ТекстРасш) Цикл
		Если М.Аннотация <> "" Тогда
			Продолжить;
		КонецЕсли;
		МО = Осн.Получить(НРег(М.Имя));
		Если МО = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Нормализовать(М.Текст) = Нормализовать(МО.Текст) И М.Директивы = МО.Директивы Тогда
			Для Й = М.НачалоБлока По М.Конец Цикл
				Удалить.Вставить(Й, Истина);
			КонецЦикла;
			Рез.Удалены.Добавить(М.Имя);
		Иначе
			Рез.Отличаются.Добавить(М.Имя);
		КонецЕсли;
	КонецЦикла;
	Строки = СтрРазделить(СтрЗаменить(ТекстРасш, Символы.ВК, ""), Символы.ПС, Истина);
	// директивы компиляции, оставшиеся без метода (следующая непустая строка — снова директива компиляции)
	РвДир = Новый РегулярноеВыражение("^\s*&(?:НаКлиенте|НаСервере|НаСервереБезКонтекста|НаКлиентеНаСервереБезКонтекста|НаКлиентеНаСервере|AtClient|AtServer|AtServerNoContext|AtClientAtServerNoContext|AtClientAtServer)\s*$");
	Для Н = 1 По Строки.Количество() Цикл
		Если Удалить.Получить(Н) <> Неопределено Или РвДир.НайтиСовпадения(Строки[Н - 1]).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сл = Н + 1;
		Пока Сл <= Строки.Количество() И (СокрЛП(Строки[Сл - 1]) = "" Или Удалить.Получить(Сл) <> Неопределено) Цикл
			Сл = Сл + 1;
		КонецЦикла;
		Если Сл > Н + 1 И (Сл > Строки.Количество() Или РвДир.НайтиСовпадения(Строки[Сл - 1]).Количество() > 0) Тогда
			Удалить.Вставить(Н, Истина);
			Рез.Удалены.Добавить("(директива без метода, строка " + Н + ")");
		КонецЕсли;
	КонецЦикла;
	Если Удалить.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Новые = Новый Массив;
	Для Н = 1 По Строки.Количество() Цикл
		Если Удалить.Получить(Н) = Неопределено Тогда
			Новые.Добавить(Строки[Н - 1]);
		КонецЕсли;
	КонецЦикла;
	Рез.Текст = СтрСоединить(Новые, Символы.ПС);
	Возврат Рез;
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
	// UTF-8 с BOM и CRLF, как остальные модули выхода
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Ложь, Символы.ВК + Символы.ПС);
	З.Записать(СтрЗаменить(Текст, Символы.ВК, ""));
	З.Закрыть();
КонецПроцедуры

// Обходит *.bsl каталога расширения; основной модуль — первый существующий файл с тем же относительным путём
// в КорниОсновной (restored, затем БП). Структура(files, removed, differs) — массивы строк "путь: метод".
Функция Очистить(КаталогРасш, КорниОсновной, Записывать = Истина) Экспорт
	Рез = Новый Структура("files, removed, differs", 0, Новый Массив, Новый Массив);
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "*.bsl", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		ТекстОсн = Неопределено;
		Для Каждого Кор Из КорниОсновной Цикл
			ТекстОсн = ПрочитатьТекст(ОбъединитьПути(Кор, Отн));
			Если ТекстОсн <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТекстОсн = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Р = ОчиститьТекст(Т, ТекстОсн);
		Для Каждого ИмяМ Из Р.Отличаются Цикл
			Рез.differs.Добавить(Отн + ": " + ИмяМ);
		КонецЦикла;
		Если Р.Удалены.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Рез.files = Рез.files + 1;
		Для Каждого ИмяМ Из Р.Удалены Цикл
			Рез.removed.Добавить(Отн + ": " + ИмяМ);
		КонецЦикла;
		Если Записывать Тогда
			ЗаписатьТекст(Ф.ПолноеИмя, Р.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции
