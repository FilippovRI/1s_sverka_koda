// Модули bucket = manual (сравнение: «есть изменённые методы без безопасного хука») — методы УП, которые отличаются от БП и
// не попали ни в extension (метод, «УП_Имя» или аннотация на него), ни в restored (тот же текст), пишутся в todo:
// todo_manual_methods.md/.csv. Признак «маркер УП» — в тексте метода есть «// УП_начало», «// УП», идентификатор УП_….
// Только перечисление: перехват вручную (&ИзменениеИКонтроль/&Вместо) или в todo; код не генерируется.

Перем РвМаркер;
Перем РвАннот;

Процедура Инициализировать()
	РвМаркер = Новый РегулярноеВыражение("(?<![\wЁё])уп_|//\s*уп(?![\wЁё])");
	РвМаркер.ИгнорироватьРегистр = Истина;
	РвАннот = Новый РегулярноеВыражение("&(Перед|После|Вместо|ИзменениеИКонтроль|Before|After|Around|ChangeAndValidate)\s*\(\s*""([^""]+)""");
	РвАннот.ИгнорироватьРегистр = Истина;
КонецПроцедуры

Функция Поле(Эл, Имя)
	Если ТипЗнч(Эл) = Тип("Соответствие") Тогда
		Возврат Эл.Получить(Имя);
	КонецЕсли;
	Попытка
		Возврат Эл[Имя];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция Прочитать(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

Функция Норм(Знач Стр)
	Поз = СтрНайти(Стр, "//");
	Если Поз > 0 И СтрНайти(Лев(Стр, Поз), """") = 0 Тогда
		Стр = Лев(Стр, Поз - 1);
	КонецЕсли;
	Возврат НРег(СокрЛП(СтрЗаменить(Стр, Символы.Таб, " ")));
КонецФункции

// Соответствие НРег(имя) → Структура(Имя, Текст — нормализованный, Маркер, Строка).
Функция Методы(Текст)
	Р = Новый Соответствие;
	Если Текст = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Тело = Неопределено;
	Н = 0;
	Для Каждого Стр Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина) Цикл
		Н = Н + 1;
		Нс = Норм(Стр);
		Если Тело = Неопределено Тогда
			Сл = СтрЗаменить(СтрЗаменить(Нс, "асинх ", ""), "async ", "");
			Для Каждого Кл Из СтрРазделить("процедура ,функция ,procedure ,function ", ",") Цикл
				Если СтрНачинаетсяС(Сл, Кл) Тогда
					Ост = СокрЛП(Сред(Стр, СтрНайти(НРег(Стр), СокрЛП(Кл)) + СтрДлина(СокрЛП(Кл))));
					Поз = СтрНайти(Ост, "(");
					Тело = Новый Массив;
					Тек = Новый Структура("Имя, Текст, Маркер, Строка", СокрЛП(?(Поз > 0, Лев(Ост, Поз - 1), Ост)), "", РвМаркер.Совпадает(Стр), Н);
					Тело.Добавить(Нс);
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если Нс <> "" Тогда
			Тело.Добавить(Нс);
		КонецЕсли;
		Если Не Тек.Маркер И РвМаркер.Совпадает(Стр) Тогда
			Тек.Маркер = Истина;
		КонецЕсли;
		Если СтрНачинаетсяС(Нс, "конецпроцедуры") Или СтрНачинаетсяС(Нс, "конецфункции") Или СтрНачинаетсяС(Нс, "endprocedure") Или СтрНачинаетсяС(Нс, "endfunction") Тогда
			Тек.Текст = СтрСоединить(Тело, Символы.ПС);
			Тек.Маркер = Тек.Маркер Или СтрНачинаетсяС(НРег(Тек.Имя), "уп_");
			Р.Вставить(НРег(Тек.Имя), Тек);
			Тело = Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Модули — результат сравнения (массив; поля path, bucket, sourceText, vendorText, object).
Функция Записать(Модули, КаталогРас, КаталогВосст, КаталогОтчёта, Лог) Экспорт
	Инициализировать();
	Рез = Новый Структура("modules, methods, marked, rows", 0, 0, 0, Новый Массив);
	Для Каждого М Из Модули Цикл
		Если Поле(М, "bucket") <> "manual" Тогда
			Продолжить;
		КонецЕсли;
		Путь = СтрЗаменить(Поле(М, "path"), "\", "/");
		МУп = Методы(Поле(М, "sourceText"));
		МБп = Методы(Поле(М, "vendorText"));
		ТР = Прочитать(ОбъединитьПути(КаталогРас, Путь));
		МР = Методы(ТР);
		Цели = Новый Соответствие;
		Если ТР <> Неопределено Тогда
			Для Каждого С Из РвАннот.НайтиСовпадения(ТР) Цикл
				Цели.Вставить(НРег(С.Группы[2].Значение), Истина);
			КонецЦикла;
		КонецЕсли;
		МВ = Неопределено;
		Было = Рез.rows.Количество();
		Для Каждого КЗ Из МУп Цикл
			Б = МБп.Получить(КЗ.Ключ);
			Если Б <> Неопределено И Б.Текст = КЗ.Значение.Текст Тогда
				Продолжить;
			КонецЕсли;
			Если МР.Получить(КЗ.Ключ) <> Неопределено Или МР.Получить("уп_" + КЗ.Ключ) <> Неопределено Или Цели.Получить(КЗ.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если МВ = Неопределено Тогда
				МВ = Методы(Прочитать(ОбъединитьПути(КаталогВосст, Путь)));
			КонецЕсли;
			В = МВ.Получить(КЗ.Ключ);
			Если В <> Неопределено И В.Текст = КЗ.Значение.Текст Тогда
				Продолжить;
			КонецЕсли;
			Рез.rows.Добавить(Новый Структура("object, module, method, line, kind, marker", Поле(М, "object"), Путь, КЗ.Значение.Имя,
				КЗ.Значение.Строка, ?(Б = Неопределено, "нет в БП", "изменён"), КЗ.Значение.Маркер));
			Рез.methods = Рез.methods + 1;
			Рез.marked = Рез.marked + ?(КЗ.Значение.Маркер, 1, 0);
		КонецЦикла;
		Если Рез.rows.Количество() > Было Тогда
			Рез.modules = Рез.modules + 1;
		КонецЕсли;
	КонецЦикла;
	Если КаталогОтчёта <> "" Тогда
		ЗаписатьФайлы(КаталогОтчёта, Рез);
	КонецЕсли;
	Лог.Добавить("todo ручного разбора (модули manual без хука): методов " + Рез.methods + " в " + Рез.modules + " модулях, из них с маркером УП " + Рез.marked);
	Возврат Рез;
КонецФункции

Процедура ЗаписатьФайлы(Каталог, Рез)
	Csv = Новый Массив;
	Csv.Добавить("Объект;Модуль;Метод;Строка УП;Вид;Маркер УП");
	Md = Новый Массив;
	Md.Добавить("# Методы УП в модулях ручного разбора (нет безопасного хука) — не перенесены");
	Md.Добавить("");
	Md.Добавить("Сначала с маркером доработки УП (// УП_начало, // УП, УП_…): их нужно перенести вручную (&ИзменениеИКонтроль / &Вместо) или осознанно отказаться.");
	Md.Добавить("Без маркера — как правило, разница версий типовых библиотек.");
	Md.Добавить("");
	Md.Добавить("Методов " + Рез.methods + ", модулей " + Рез.modules + ", с маркером УП " + Рез.marked + ".");
	Md.Добавить("");
	Md.Добавить("| Объект | Модуль | Метод | Строка УП | Вид | Маркер УП |");
	Md.Добавить("|---|---|---|---|---|---|");
	Для Проход = 1 По 2 Цикл
		Для Каждого С Из Рез.rows Цикл
			Если С.marker <> (Проход = 1) Тогда
				Продолжить;
			КонецЕсли;
			Если Проход = 1 Тогда
				Csv.Добавить(С.object + ";" + С.module + ";" + С.method + ";" + С.line + ";" + С.kind + ";да");
			Иначе
				Csv.Добавить(С.object + ";" + С.module + ";" + С.method + ";" + С.line + ";" + С.kind + ";нет");
			КонецЕсли;
			Md.Добавить("| " + С.object + " | " + С.module + " | " + С.method + " | " + С.line + " | " + С.kind + " | " + ?(С.marker, "да", "нет") + " |");
		КонецЦикла;
	КонецЦикла;
	ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Csv, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8, Истина).Записать(ОбъединитьПути(Каталог, "todo_manual_methods.csv"));
	ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Md, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8, Истина).Записать(ОбъединитьПути(Каталог, "todo_manual_methods.md"));
КонецПроцедуры
