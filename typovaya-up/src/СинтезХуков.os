// Синтез хуков расширения по diff тел методов (порт HookSynthesizer.ForBodyChange).
// &ИзменениеИКонтроль: сигнатура один раз как в типовой и вне #Удаление; блоки охватывают
// // УП_начало…// УП_конец; // АПК: не УП-доработки; типовое тело байт в байт; директивы с кол. 0.

Перем Разбор;
Перем Безопасность;

// Подключает разбор методов и опционально БезопасностьПереноса.
Процедура Инициализировать(МодульРазбора, МодульБезопасности = Неопределено) Экспорт
	Разбор = МодульРазбора;
	Безопасность = МодульБезопасности;
КонецПроцедуры

// Подбирает хук по diff тел (без объявлений Процедура/КонецПроцедуры).
//
// Параметры:
//   ТекстТиповогоТела, ТекстДоработанногоТела — только тело метода.
//
// Возвращаемое значение:
//   Структура decision (skip|auto|manual), hook (none|before|after|changeAndControl|instead),
//   reason, hookBody.
Функция ПредложитьХук(Знач ТекстТиповогоТела, Знач ТекстДоработанногоТела) Экспорт

	ПарыТип = ЗначимыеПары(ТекстТиповогоТела);
	ПарыДоп = ЗначимыеПары(ТекстДоработанногоТела);
	СтрокиТип = НормыИзПар(ПарыТип);
	СтрокиДоп = НормыИзПар(ПарыДоп);

	Если НормыИдентичны(СтрокиТип, СтрокиДоп) Тогда
		Возврат Предложение("skip", "none",
			"Значимое тело совпадает — отличия только в комментариях, пустых строках или АПК (не для &ИзменениеИКонтроль)", "");
	КонецЕсли;

	Если СтрокиТип.Количество() = 0 И СтрокиДоп.Количество() = 0 Тогда
		Возврат Предложение("skip", "none", "Тело пустое с обеих сторон", "");
	КонецЕсли;

	Если СтрокиТип.Количество() = 0 Тогда
		Возврат Предложение("manual", "none", "В типовой версии тело пустое — нужен ручной разбор", "");
	КонецЕсли;

	Если ЭтоПрефикс(СтрокиТип, СтрокиДоп) Тогда
		Суффикс = СрезОригинала(ТекстДоработанногоТела, СтрокиТип.Количество(), Истина);
		Возврат Предложение("auto", "after", "Доработка добавлена после типового тела", Суффикс);
	КонецЕсли;

	Если ЭтоСуффикс(СтрокиТип, СтрокиДоп) Тогда
		Префикс = СрезОригинала(ТекстДоработанногоТела, СтрокиДоп.Количество() - СтрокиТип.Количество(), Ложь);
		Возврат Предложение("auto", "before", "Доработка добавлена перед типовым телом", Префикс);
	КонецЕсли;

	Анализ = АнализВставок(СтрокиТип, СтрокиДоп);
	Если (Анализ.Вид = "single" ИЛИ Анализ.Вид = "multiple") И Анализ.Пробелы.Количество() > 0 Тогда
		Аннот = ПостроитьТелоСВставкамиИзТипового(ТекстТиповогоТела, ТекстДоработанногоТела, Анализ.Пробелы);
		Если СокрЛП(Аннот) <> "" И ПроверитьЦелостностьТелаИк(Аннот) Тогда
			Если Анализ.Пробелы.Количество() = 1 Тогда
				Причина = "Доработка — одна вставка внутри типового тела (&ИзменениеИКонтроль)";
			Иначе
				Причина = "Доработка — " + Анализ.Пробелы.Количество() + " вставки внутри типового тела (&ИзменениеИКонтроль)";
			КонецЕсли;
			Аннот = ДополнитьАпкТипового(ТекстТиповогоТела, Аннот);
			Возврат Предложение("auto", "changeAndControl", Причина, Аннот);
		КонецЕсли;
	КонецЕсли;

	ОцПв = ОценитьВместоПродолжитьВызов(ТекстДоработанногоТела);
	Если ОцПв <> Неопределено Тогда
		Если ОцПв.decision = "manual" Тогда
			Возврат Предложение("manual", "none", ОцПв.reason, "");
		КонецЕсли;
		Возврат Предложение("auto", "instead", ОцПв.reason, ОцПв.hookBody,
			ВместоДопПродолжить(ТекстДоработанногоТела));
	КонецЕсли;

	Лкс = ПопробоватьЛксИзменениеИКонтроль(ПарыТип, ПарыДоп, ТекстТиповогоТела, ТекстДоработанногоТела);
	Если Лкс <> Неопределено Тогда
		Возврат Лкс;
	КонецЕсли;

	Если ПарыДоп.Количество() > 0 Тогда
		Диаг = ДиагностикаПереноса(ТекстДоработанногоТела);
		Если Диаг <> "" Тогда
			Возврат Предложение("manual", "none", Диаг, "");
		КонецЕсли;
		Причина = "Полная замена тела — &Вместо без ПродолжитьВызов() в конце черновика";
		Если ЕстьРаннийВыход(ТекстДоработанногоТела) Тогда
			Причина = Причина + " (ранний Возврат/Продолжить в теле УП)";
		КонецЕсли;
		Возврат Предложение("auto", "instead", Причина, СокрП(ТекстДоработанногоТела),
			ВместоДопПродолжить(ТекстДоработанногоТела));
	КонецЕсли;

	Возврат Предложение("manual", "none",
		"Тело изменено так, что безопасный хук не выводится автоматически — смотрите diff", "");

КонецФункции

// &Перед/&После для функций платформой не поддерживаются — CAC или &Вместо.
Функция СкорректироватьХукДляФункции(Предл, ТекстТиповогоТела, ТекстДоработанногоТела) Экспорт
	Если Предл.hook <> "before" И Предл.hook <> "after" Тогда
		Возврат Предл;
	КонецЕсли;
	ПарыТип = ЗначимыеПары(ТекстТиповогоТела);
	ПарыДоп = ЗначимыеПары(ТекстДоработанногоТела);
	Лкс = ПопробоватьЛксИзменениеИКонтроль(ПарыТип, ПарыДоп, ТекстТиповогоТела, ТекстДоработанногоТела);
	Если Лкс <> Неопределено Тогда
		Возврат Лкс;
	КонецЕсли;
	Возврат Предложение("auto", "instead", "Функция: &Перед/&После недопустимы — &Вместо",
		СокрП(ТекстДоработанногоТела), ВместоДопПродолжить(ТекстДоработанногоТела));
КонецФункции

Функция Предложение(Решение, Хук, Причина, ТелоХука, ВместоДопПродолжить = Ложь)
	Возврат Новый Структура("decision, hook, reason, hookBody, insteadAppendContinue",
		Решение, Хук, Причина, ТелоХука, ВместоДопПродолжить);
КонецФункции

Функция ВместоДопПродолжить(ТелоДоработанного)
	Если Безопасность = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Безопасность.НуженПродолжитьВызовВЧерновике(ТелоДоработанного);
КонецФункции

Функция ДиагностикаПереноса(Тело)
	Если Безопасность = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат Безопасность.ДиагностикаВызовов(Тело);
КонецФункции

Функция ЕстьРаннийВыход(Тело)
	Если Безопасность = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Безопасность.ЕстьРаннийВыход(Тело);
КонецФункции

Функция ЗначимыеПары(Знач Текст)
	Результат = Новый Массив;
	Для Каждого Сырая Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Норм = НормСтроки(Сырая);
		Если Норм <> "" Тогда
			Результат.Добавить(Новый Структура("Норм, Оригинал", Норм, Сырая));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НормыИзПар(Пары)
	Р = Новый Массив;
	Для Каждого П Из Пары Цикл
		Р.Добавить(П.Норм);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция НормыИдентичны(А, Б)
	Если А.Количество() <> Б.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Й = 0 По А.Количество() - 1 Цикл
		Если А[Й] <> Б[Й] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция НормСтроки(Знач Стр)
	Если ЭтоКомментарийАпк(Стр) Тогда
		Возврат "";
	КонецЕсли;
	Возврат Разбор.ХешЛексемСтроки(Стр);
КонецФункции

Функция ЭтоПрефикс(Типовые, Доработанные)
	Если Типовые.Количество() > Доработанные.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Й = 0 По Типовые.Количество() - 1 Цикл
		Если Типовые[Й] <> Доработанные[Й] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Типовые.Количество() < Доработанные.Количество();
КонецФункции

Функция ЭтоСуффикс(Типовые, Доработанные)
	Если Типовые.Количество() > Доработанные.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Сдвиг = Доработанные.Количество() - Типовые.Количество();
	Если Сдвиг = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Й = 0 По Типовые.Количество() - 1 Цикл
		Если Типовые[Й] <> Доработанные[Сдвиг + Й] Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СрезОригинала(Знач ТекстТела, Знач ЧислоЗначимых, Знач Хвост)
	Сырые = СтрРазделить(ТекстТела, Символы.ПС, Истина);
	Индексы = Новый Массив;
	Для Й = 0 По Сырые.Количество() - 1 Цикл
		Если НормСтроки(Сырые[Й]) <> "" Тогда
			Индексы.Добавить(Й);
		КонецЕсли;
	КонецЦикла;
	Если ЧислоЗначимых <= 0 ИЛИ ЧислоЗначимых >= Индексы.Количество() Тогда
		Возврат СокрП(ТекстТела);
	КонецЕсли;
	Если Хвост Тогда
		От = Индексы[ЧислоЗначимых];
		ДоИскл = Сырые.Количество();
	Иначе
		От = 0;
		ДоИскл = Индексы[ЧислоЗначимых];
	КонецЕсли;
	Возврат СоединитьСырые(Сырые, От, ДоИскл);
КонецФункции

Функция СоединитьСырые(Сырые, От, ДоИскл)
	Если От >= ДоИскл Тогда
		Возврат "";
	КонецЕсли;
	Кусок = Новый Массив;
	Для Й = От По ДоИскл - 1 Цикл
		Кусок.Добавить(Сырые[Й]);
	КонецЦикла;
	Пока Кусок.Количество() > 0 И СокрЛП(Кусок[0]) = "" Цикл
		Кусок.Удалить(0);
	КонецЦикла;
	Пока Кусок.Количество() > 0 И СокрЛП(Кусок[Кусок.Количество() - 1]) = "" Цикл
		Кусок.Удалить(Кусок.Количество() - 1);
	КонецЦикла;
	Возврат СтрСоединить(Кусок, Символы.ПС);
КонецФункции

Функция АнализВставок(Типовые, Доработанные)
	Пусто = Новый Структура("Вид, Пробелы", "none", Новый Массив);
	Если Типовые.Количество() = 0 ИЛИ Доработанные.Количество() <= Типовые.Количество() Тогда
		Возврат Пусто;
	КонецЕсли;
	Совпадения = Новый Массив;
	Для Й = 1 По Типовые.Количество() Цикл
		Совпадения.Добавить(-1);
	КонецЦикла;
	ИндексДоп = 0;
	Для Т = 0 По Типовые.Количество() - 1 Цикл
		Пока ИндексДоп < Доработанные.Количество() И Типовые[Т] <> Доработанные[ИндексДоп] Цикл
			ИндексДоп = ИндексДоп + 1;
		КонецЦикла;
		Если ИндексДоп >= Доработанные.Количество() Тогда
			Возврат Пусто;
		КонецЕсли;
		Совпадения[Т] = ИндексДоп;
		ИндексДоп = ИндексДоп + 1;
	КонецЦикла;

	Пробелы = Новый Массив;
	Если Совпадения[0] > 0 Тогда
		Пробелы.Добавить(Новый Структура("От, До", 0, Совпадения[0]));
	КонецЕсли;
	Для Т = 0 По Типовые.Количество() - 2 Цикл
		От = Совпадения[Т] + 1;
		До_ = Совпадения[Т + 1];
		Если От < До_ Тогда
			Пробелы.Добавить(Новый Структура("От, До", От, До_));
		КонецЕсли;
	КонецЦикла;
	ПослеПоследнего = Совпадения[Типовые.Количество() - 1] + 1;
	Если ПослеПоследнего < Доработанные.Количество() Тогда
		Пробелы.Добавить(Новый Структура("От, До", ПослеПоследнего, Доработанные.Количество()));
	КонецЕсли;

	Если Пробелы.Количество() = 0 Тогда
		Возврат Пусто;
	КонецЕсли;
	Вид = ?(Пробелы.Количество() = 1, "single", "multiple");
	Возврат Новый Структура("Вид, Пробелы", Вид, Пробелы);
КонецФункции

// --- Границы операторов для #Вставка/#Удаление (&ИзменениеИКонтроль) ---

Функция КодСтрокиБезКомментария(Строка)
	Если Разбор = Неопределено Тогда
		Возврат СокрП(Строка);
	КонецЕсли;
	Возврат СокрП(Разбор.УбратьКомментарий(Строка));
КонецФункции

Функция БалансСкобокВКоде(Код)
	Круг = 0;
	Кв = 0;
	ВСтроке = Ложь;
	Дл = СтрДлина(Код);
	Для П = 1 По Дл Цикл
		С = Сред(Код, П, 1);
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			Продолжить;
		КонецЕсли;
		Если С = "(" Тогда
			Круг = Круг + 1;
		ИначеЕсли С = ")" Тогда
			Круг = Круг - 1;
		ИначеЕсли С = "[" Тогда
			Кв = Кв + 1;
		ИначеЕсли С = "]" Тогда
			Кв = Кв - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Круг, Кв", Круг, Кв);
КонецФункции

Функция ПоследнийЗначимыйСимвол(Код)
	Дл = СтрДлина(Код);
	Пока Дл > 0 Цикл
		С = Сред(Код, Дл, 1);
		Если С <> " " И С <> Символы.Таб Тогда
			Возврат С;
		КонецЕсли;
		Дл = Дл - 1;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция СтрокаПродолжаетОператор(Строка)
	Код = КодСтрокиБезКомментария(Строка);
	Если Код = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Б = БалансСкобокВКоде(Код);
	Если Б.Круг > 0 Или Б.Кв > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Хвост = ПоследнийЗначимыйСимвол(Код);
	Если Хвост = "," Или Хвост = "+" Или Хвост = "-" Или Хвост = "*" Или Хвост = "/" Или Хвост = "." Или Хвост = "=" Тогда
		Возврат Истина;
	КонецЕсли;
	НР = НРег(Код);
	Если СтрЗаканчиваетсяНа(НР, " и") Или СтрЗаканчиваетсяНа(НР, " или") Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция СтрокаЯвляетсяПродолжением(Сырые, Инд)
	Если Инд <= 0 Или Инд >= Сырые.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не СтрокаПродолжаетОператор(Сырые[Инд - 1]) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСтрокиБезКомментария(Сырые[Инд]);
	Если Код = "" Тогда
		Возврат Истина;
	КонецЕсли;
	Л = Лев(СокрЛ(Сырые[Инд]), 1);
	Если Л = Символы.Таб Или Л = " " Тогда
		Возврат Истина;
	КонецЕсли;
	НР = НРег(Лев(Код, 12));
	Если НР = "и" Или НР = "или" Или НР = "тогда" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не ЭтоНачалоОператора(Код);
КонецФункции

Функция ЭтоНачалоОператора(Код)
	НР = НРег(СокрЛ(Код));
	Для Каждого К Из СтрРазделить("если,для,пока,возврат,попытка,конецесли,конеццикла,конецпопытки,перем,процедура,функция,иначе", ",") Цикл
		Если СтрНачинаетсяС(НР, К + " ") Или НР = К Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура РасширитьДиапазонСырых(Сырые, Нач, Кон)
	Пока Нач > 0 И (СтрокаПродолжаетОператор(Сырые[Нач - 1]) Или СтрокаЯвляетсяПродолжением(Сырые, Нач)) Цикл
		Нач = Нач - 1;
	КонецЦикла;
	Пока Кон < Сырые.Количество() - 1 И СтрокаПродолжаетОператор(Сырые[Кон]) Цикл
		Кон = Кон + 1;
	КонецЦикла;
КонецПроцедуры

Функция ИндексНачалаБлокаИк(Строки, ИндКонца)
	Глубина = 1;
	Й = ИндКонца - 1;
	Пока Й >= 0 Цикл
		С = СокрЛП(Строки[Й]);
		Если С = "#КонецВставки" Или С = "#КонецУдаления" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли С = "#Вставка" Или С = "#Удаление" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Й;
			КонецЕсли;
		КонецЕсли;
		Й = Й - 1;
	КонецЦикла;
	Возврат -1;
КонецФункции

// Маркеры #Вставка/#Удаление не должны резать многострочный оператор.
Функция ПроверитьЦелостностьТелаИк(Тело) Экспорт
	Если СокрЛП(Тело) = "" Тогда
		Возврат Истина;
	КонецЕсли;
	Строки = СтрРазделить(Тело, Символы.ПС, Истина);
	Для Й = 1 По Строки.Количество() - 1 Цикл
		С = СокрЛП(Строки[Й]);
		Если С = "#Вставка" Или С = "#Удаление" Тогда
			Пред = ПредыдущаяСтрокаКода(Строки, Й - 1);
			Если Пред <> "" И СтрокаПродолжаетОператор(Пред) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли С = "#КонецВставки" Или С = "#КонецУдаления" Тогда
			Пред = ПредыдущаяСтрокаКода(Строки, Й - 1);
			Если Пред <> "" И СтрокаПродолжаетОператор(Пред) Тогда
				Возврат Ложь;
			КонецЕсли;
			НачБлока = ИндексНачалаБлокаИк(Строки, Й);
			Если НачБлока >= 0 Тогда
				ДоБлока = ПредыдущаяСтрокаКода(Строки, НачБлока - 1);
				Если Й + 1 < Строки.Количество() Тогда
					СледКод = СледующаяСтрокаКода(Строки, Й + 1);
					Если ДоБлока <> "" И СтрокаПродолжаетОператор(ДоБлока) И СледКод <> "" Тогда
						Если СтрокаЯвляетсяПродолжениемМежду(ДоБлока, СледКод) Тогда
							Возврат Ложь;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СледующаяСтрокаКода(Строки, Инд)
	Й = Инд;
	Пока Й < Строки.Количество() Цикл
		С = СокрЛП(Строки[Й]);
		Если С = "" Или ЭтоДирективаИк(Строки[Й]) Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Возврат Строки[Й];
	КонецЦикла;
	Возврат "";
КонецФункции

Функция СтрокаЯвляетсяПродолжениемМежду(СтрокаДо, СтрокаПосле)
	Если Не СтрокаПродолжаетОператор(СтрокаДо) Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСтрокиБезКомментария(СтрокаПосле);
	Если Код = "" Тогда
		Возврат Истина;
	КонецЕсли;
	Л = Лев(СокрЛ(СтрокаПосле), 1);
	Если Л = Символы.Таб Или Л = " " Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Не ЭтоНачалоОператора(Код);
КонецФункции

Функция ПредыдущаяСтрокаКода(Строки, Инд)
	Й = Инд;
	Пока Й >= 0 Цикл
		С = СокрЛП(Строки[Й]);
		Если С = "" Или ЭтоДирективаИк(Строки[Й]) Тогда
			Й = Й - 1;
			Продолжить;
		КонецЕсли;
		Возврат Строки[Й];
	КонецЦикла;
	Возврат "";
КонецФункции

// Сдвигает #Вставка/#Удаление, если маркер режет многострочный оператор.
Процедура СкорректироватьГраницыМаркеровВМассиве(Результат)
	Й = 0;
	Пока Й < Результат.Количество() Цикл
		Маркер = СокрЛП(Результат[Й]);
		Если Маркер = "#Вставка" Или Маркер = "#Удаление" Тогда
			Пока Й > 0 Цикл
				СН = СокрЛП(Результат[Й - 1]);
				Если СН = "" Тогда
					Результат.Удалить(Й - 1);
					Й = Й - 1;
					Продолжить;
				КонецЕсли;
				Если Не СтрокаПродолжаетОператор(Результат[Й - 1]) Тогда
					Прервать;
				КонецЕсли;
				Стр = Результат[Й - 1];
				Результат.Удалить(Й - 1);
				Й = Й - 1;
				Результат.Вставить(Й + 1, Стр);
				Й = Й + 1;
			КонецЦикла;
		ИначеЕсли Маркер = "#КонецВставки" Или Маркер = "#КонецУдаления" Тогда
			Пока Й + 1 < Результат.Количество() Цикл
				СН = СокрЛП(Результат[Й + 1]);
				Если СН = "" Тогда
					Й = Й + 1;
					Продолжить;
				КонецЕсли;
				Если Не СтрокаЯвляетсяПродолжением(Результат, Й + 1) Тогда
					Прервать;
				КонецЕсли;
				Стр = Результат[Й + 1];
				Результат.Удалить(Й + 1);
				Результат.Вставить(Й, Стр);
			КонецЦикла;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
КонецПроцедуры

Функция СырыеСтрокиТела(Знач Текст)
	Возврат СтрРазделить(Текст, Символы.ПС, Истина);
КонецФункции

Функция ИндексыЗначимыхСырых(Сырые)
	Инд = Новый Массив;
	Для Й = 0 По Сырые.Количество() - 1 Цикл
		Если НормСтроки(Сырые[Й]) <> "" Тогда
			Инд.Добавить(Й);
		КонецЕсли;
	КонецЦикла;
	Возврат Инд;
КонецФункции

Процедура ДобавитьСрезСтрок(Приемник, Сырые, От, ДоВкл)
	Если От > ДоВкл Тогда
		Возврат;
	КонецЕсли;
	Для Й = От По ДоВкл Цикл
		Приемник.Добавить(Сырые[Й]);
	КонецЦикла;
КонецПроцедуры

Функция ЭтоДирективаИк(Стр)
	С = СокрЛП(Стр);
	Возврат С = "#Вставка" Или С = "#КонецВставки" Или С = "#Удаление" Или С = "#КонецУдаления";
КонецФункции

// Для тестов: тело хука без #Вставка и без директив → должно совпасть с типовым телом.
Функция ВосстановитьБазовыйТекстТиповогоИзХука(ТелоХука) Экспорт
	Р = Новый Массив;
	Вставка = Ложь;
	Для Каждого Стр Из СтрРазделить(ТелоХука, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если С = "#Вставка" Тогда
			Вставка = Истина;
			Продолжить;
		КонецЕсли;
		Если С = "#КонецВставки" Тогда
			Вставка = Ложь;
			Продолжить;
		КонецЕсли;
		Если С = "#Удаление" Или С = "#КонецУдаления" Тогда
			Продолжить;
		КонецЕсли;
		Если Вставка Тогда
			Продолжить;
		КонецЕсли;
		Р.Добавить(Стр);
	КонецЦикла;
	Возврат СтрСоединить(Р, Символы.ПС);
КонецФункции

Функция ПостроитьТелоСВставкамиИзТипового(Знач ТекстТип, Знач ТекстДоп, Пробелы)
	СырыеТ = СырыеСтрокиТела(ТекстТип);
	СырыеД = СырыеСтрокиТела(ТекстДоп);
	ИндТ = ИндексыЗначимыхСырых(СырыеТ);
	ИндД = ИндексыЗначимыхСырых(СырыеД);
	Результат = Новый Массив;
	ПоследняяСтрокаТип = 0;
	ТипИ = 0;
	Для Каждого П Из Пробелы Цикл
		Пока ТипИ < П.От Цикл
			Если ТипИ >= ИндТ.Количество() Тогда
				Прервать;
			КонецЕсли;
			КонецСыр = ИндТ[ТипИ];
			ДобавитьСрезСтрок(Результат, СырыеТ, ПоследняяСтрокаТип, КонецСыр);
			ПоследняяСтрокаТип = КонецСыр + 1;
			ТипИ = ТипИ + 1;
		КонецЦикла;
		Если П.От < 0 ИЛИ П.До > ИндД.Количество() ИЛИ П.От >= П.До Тогда
			Продолжить;
		КонецЕсли;
		Если П.От > 0 Тогда
			ОтСыр = ИндД[П.От - 1] + 1;
		Иначе
			ОтСыр = 0;
		КонецЕсли;
		Если П.До < ИндД.Количество() Тогда
			ДоСыр = ИндД[П.До] - 1;
		Иначе
			ДоСыр = СырыеД.Количество() - 1;
		КонецЕсли;
		РасширитьДиапазонСырых(СырыеД, ОтСыр, ДоСыр);
		Результат.Добавить("#Вставка");
		ДобавитьСрезСтрок(Результат, СырыеД, ОтСыр, ДоСыр);
		Результат.Добавить("#КонецВставки");
	КонецЦикла;
	ДобавитьСрезСтрок(Результат, СырыеТ, ПоследняяСтрокаТип, СырыеТ.Количество() - 1);
	СкорректироватьГраницыМаркеровВМассиве(Результат);
	Результат = ВыровнятьМаркерыУпВБлоках(Результат);
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция ПостроитьТелоСВставками(Знач ТекстДоп, Пробелы)
	Сырые = СтрРазделить(ТекстДоп, Символы.ПС, Истина);
	ЗначимыеИндексы = Новый Массив;
	Для Й = 0 По Сырые.Количество() - 1 Цикл
		Если НормСтроки(Сырые[Й]) <> "" Тогда
			ЗначимыеИндексы.Добавить(Й);
		КонецЕсли;
	КонецЦикла;

	Диапазоны = Новый Массив;
	Для Каждого П Из Пробелы Цикл
		Если П.От < 0 ИЛИ П.До > ЗначимыеИндексы.Количество() ИЛИ П.От >= П.До Тогда
			Продолжить;
		КонецЕсли;
		ОтСыр = ЗначимыеИндексы[П.От];
		Если П.До < ЗначимыеИндексы.Количество() Тогда
			ДоСырИскл = ЗначимыеИндексы[П.До];
		Иначе
			ДоСырИскл = Сырые.Количество();
		КонецЕсли;
		Диапазоны.Добавить(Новый Структура("От, До", ОтСыр, ДоСырИскл));
	КонецЦикла;
	Если Диапазоны.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;

	Результат = Новый Массив;
	ИндексДиапазона = 0;
	Для Й = 0 По Сырые.Количество() - 1 Цикл
		Если ИндексДиапазона < Диапазоны.Количество() И Й = Диапазоны[ИндексДиапазона].От Тогда
			Если Результат.Количество() > 0 И ЭтоМаркерУпНачало(Результат[Результат.Количество() - 1]) Тогда
				М = Результат[Результат.Количество() - 1];
				Результат.Удалить(Результат.Количество() - 1);
				Результат.Добавить("#Вставка");
				Результат.Добавить(М);
			Иначе
				Результат.Добавить("#Вставка");
			КонецЕсли;
		КонецЕсли;
		Результат.Добавить(Сырые[Й]);
		Если ИндексДиапазона < Диапазоны.Количество() И Й = Диапазоны[ИндексДиапазона].До - 1 Тогда
			Результат.Добавить("#КонецВставки");
			ИндексДиапазона = ИндексДиапазона + 1;
		КонецЕсли;
	КонецЦикла;

	Пока Результат.Количество() > 0 И СокрЛП(Результат[0]) = "" Цикл
		Результат.Удалить(0);
	КонецЦикла;
	Пока Результат.Количество() > 0 И СокрЛП(Результат[Результат.Количество() - 1]) = "" Цикл
		Результат.Удалить(Результат.Количество() - 1);
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

// Оценка &Вместо при ПродолжитьВызов в УП: тело хука = исходное (без снятия вызова), либо manual.
// Неопределено — в теле нет вызова вне строк/комментариев.
Функция ОценитьВместоПродолжитьВызов(Знач Тело)
	СтрокиВызова = СтрокиСПродолжитьВызовВКоде(Тело);
	Если СтрокиВызова.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрокиВызова.Количество() > 1 Тогда
		Возврат Новый Структура("decision, hookBody, reason", "manual", "",
			"Несколько ПродолжитьВызов в теле — auto &Вместо не выводится");
	КонецЕсли;
	СтрВызова = СтрокиВызова[0];
	Если Не СтрокаТолькоПродолжитьВызов(СтрВызова) Тогда
		Возврат Новый Структура("decision, hookBody, reason", "manual", "",
			"ПродолжитьВызов в составе оператора/условия — сохранить позицию нельзя");
	КонецЕсли;
	Возврат Новый Структура("decision, hookBody, reason", "auto", СокрП(Тело),
		"&Вместо: тело УП с ПродолжитьВызов без снятия и без доп. вызова в конце черновика");
КонецФункции

Функция СтрокиСПродолжитьВызовВКоде(Тело)
	Рез = Новый Массив;
	Для Каждого Стр Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		Если СтрокаСодержитПродолжитьВызовВКоде(Стр) Тогда
			Рез.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция СтрокаСодержитПродолжитьВызовВКоде(Стр)
	БезКомм = Разбор.УбратьКомментарий(Стр);
	Н = НРег(БезКомм);
	Хвост = Н;
	Пока Истина Цикл
		ПозВх = СтрНайти(Хвост, "продолжитьвызов(");
		Маркер = "продолжитьвызов(";
		Если ПозВх = 0 Тогда
			ПозВх = СтрНайти(Хвост, "proceedwithcall(");
			Маркер = "proceedwithcall(";
		КонецЕсли;
		Если ПозВх = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Абс = СтрДлина(Н) - СтрДлина(Хвост) + ПозВх;
		Если Не СимволВнутриСтроки(БезКомм, Абс) Тогда
			Возврат Истина;
		КонецЕсли;
		Хвост = Сред(Хвост, ПозВх + СтрДлина(Маркер));
	КонецЦикла;
КонецФункции

Функция СимволВнутриСтроки(Стр, Позиция)
	ВСтроке = Ложь;
	Для Й = 1 По Мин(Позиция, СтрДлина(Стр)) Цикл
		С = Сред(Стр, Й, 1);
		Если Не ВСтроке Тогда
			Если С = """" Тогда
				ВСтроке = Истина;
			КонецЕсли;
		Иначе
			Если С = """" Тогда
				Если Й < СтрДлина(Стр) И Сред(Стр, Й + 1, 1) = """" Тогда
					Й = Й + 1;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат ВСтроке;
КонецФункции

// Одна строка — только ПродолжитьВызов(...); или Возврат ПродолжитьВызов(...);
Функция СтрокаТолькоПродолжитьВызов(Стр)
	Код = СокрЛП(Разбор.УбратьКомментарий(Стр));
	Если Код = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Н = НРег(Код);
	Если СтрНайти(Н, "если ") = 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНачинаетсяС(Н, "продолжитьвызов(") Или СтрНачинаетсяС(Н, "proceedwithcall(") Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНачинаетсяС(Н, "возврат ") Тогда
		Хвост = СокрЛП(Сред(Н, 9));
		Возврат СтрНачинаетсяС(Хвост, "продолжитьвызов(") Или СтрНачинаетсяС(Хвост, "proceedwithcall(");
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция УбратьВызовыПродолжитьВызов(Знач Тело)
	Оставшиеся = Новый Массив;
	Для Каждого Стр Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		Н = НРег(НормСтроки(Стр));
		Если СтрНайти(Н, "продолжитьвызов") > 0 ИЛИ СтрНайти(Н, "proceedwithcall") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Оставшиеся.Добавить(Стр);
	КонецЦикла;
	Пока Оставшиеся.Количество() > 0 И СокрЛП(Оставшиеся[0]) = "" Цикл
		Оставшиеся.Удалить(0);
	КонецЦикла;
	Пока Оставшиеся.Количество() > 0 И СокрЛП(Оставшиеся[Оставшиеся.Количество() - 1]) = "" Цикл
		Оставшиеся.Удалить(Оставшиеся.Количество() - 1);
	КонецЦикла;
	Возврат СтрСоединить(Оставшиеся, Символы.ПС);
КонецФункции

Функция ПопробоватьЛксИзменениеИКонтроль(ПарыТип, ПарыДоп, ТекстТиповогоТела = "", ТекстДоработанногоТела = "")
	Если ПарыТип.Количество() = 0 ИЛИ ПарыДоп.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Операции = DiffСтрок(ПарыТип, ПарыДоп);
	Равных = 0;
	Удалений = 0;
	Вставок = 0;
	Для Каждого Оп Из Операции Цикл
		Если Оп.Вид = "equal" Тогда
			Равных = Равных + 1;
		ИначеЕсли Оп.Вид = "delete" Тогда
			Удалений = Удалений + 1;
		ИначеЕсли Оп.Вид = "insert" Тогда
			Вставок = Вставок + 1;
		КонецЕсли;
	КонецЦикла;
	Если Равных = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДоляОбщих = Равных / ПарыТип.Количество();
	Если ДоляОбщих < 0.12 И Равных < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Удалений = 0 И Вставок = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ТекстТиповогоТела <> "" И ТекстДоработанногоТела <> "" Тогда
		Аннот = ОтрисоватьИзменениеИКонтрольДословно(ТекстТиповогоТела, ТекстДоработанногоТела, Операции);
	Иначе
		Аннот = ОтрисоватьЛксТело(Операции);
	КонецЕсли;
	Если ТекстТиповогоТела <> "" Тогда
		Аннот = ДополнитьАпкТипового(ТекстТиповогоТела, Аннот);
	КонецЕсли;
	Если СокрЛП(Аннот) = "" Или Не ПроверитьЦелостностьТелаИк(Аннот) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Причина = "Доработка — правки внутри типового тела (#Вставка/#Удаление), общих строк "
		+ Равных + "/" + ПарыТип.Количество();
	Возврат Предложение("auto", "changeAndControl", Причина, Аннот);
КонецФункции

Функция DiffСтрок(А, Б)
	СчетА = ПосчитатьНормы(А);
	СчетБ = ПосчитатьНормы(Б);
	Якоря = Новый Массив;
	ИспользованныеБ = Новый Соответствие;
	Для И_ = 0 По А.Количество() - 1 Цикл
		Норм = А[И_].Норм;
		Если СчетА.Получить(Норм) <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Если СчетБ.Получить(Норм) <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Для Ж = 0 По Б.Количество() - 1 Цикл
			Если ИспользованныеБ.Получить(Ж) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если А[И_].Норм <> Б[Ж].Норм Тогда
				Продолжить;
			КонецЕсли;
			Якоря.Добавить(Новый Структура("Аи, Би", И_, Ж));
			ИспользованныеБ.Вставить(Ж, Истина);
			Прервать;
		КонецЦикла;
	КонецЦикла;

	Если Якоря.Количество() = 0 Тогда
		Возврат DiffЛксОкно(А, Б, 0, А.Количество(), 0, Б.Количество());
	КонецЕсли;

	// Якоря уже в порядке возрастания Аи (обход А слева направо).
	Моно = Новый Массив;
	ПоследнийБи = -1;
	Для Каждого Я Из Якоря Цикл
		Если Я.Би <= ПоследнийБи Тогда
			Продолжить;
		КонецЕсли;
		Моно.Добавить(Я);
		ПоследнийБи = Я.Би;
	КонецЦикла;

	Операции = Новый Массив;
	Аи = 0;
	Би = 0;
	Для Каждого Я Из Моно Цикл
		ДобавитьДиапазон(Операции, DiffЛксОкно(А, Б, Аи, Я.Аи, Би, Я.Би));
		Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "equal", А[Я.Аи].Оригинал, Б[Я.Би].Оригинал));
		Аи = Я.Аи + 1;
		Би = Я.Би + 1;
	КонецЦикла;
	ДобавитьДиапазон(Операции, DiffЛксОкно(А, Б, Аи, А.Количество(), Би, Б.Количество()));
	Возврат Операции;
КонецФункции

Процедура ДобавитьДиапазон(Приемник, Источник)
	Для Каждого Э Из Источник Цикл
		Приемник.Добавить(Э);
	КонецЦикла;
КонецПроцедуры

Функция ПосчитатьНормы(Пары)
	Карта = Новый Соответствие;
	Для Каждого П Из Пары Цикл
		Было = Карта.Получить(П.Норм);
		Карта.Вставить(П.Норм, ?(Было = Неопределено, 0, Было) + 1);
	КонецЦикла;
	Возврат Карта;
КонецФункции

Функция DiffЛксОкно(А, Б, АОт, АДо, БОт, БДо)
	Н = АДо - АОт;
	М = БДо - БОт;
	Операции = Новый Массив;
	Если Н = 0 И М = 0 Тогда
		Возврат Операции;
	КонецЕсли;
	Если Н = 0 Тогда
		Для Ж = БОт По БДо - 1 Цикл
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "insert", "", Б[Ж].Оригинал));
		КонецЦикла;
		Возврат Операции;
	КонецЕсли;
	Если М = 0 Тогда
		Для И_ = АОт По АДо - 1 Цикл
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "delete", А[И_].Оригинал, ""));
		КонецЦикла;
		Возврат Операции;
	КонецЕсли;

	// Лимит ячеек LCS — иначе OneScript зависает на огромных методах.
	Если (Н + 1) * (М + 1) > 400000 Тогда
		Для И_ = АОт По АДо - 1 Цикл
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "delete", А[И_].Оригинал, ""));
		КонецЦикла;
		Для Ж = БОт По БДо - 1 Цикл
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "insert", "", Б[Ж].Оригинал));
		КонецЦикла;
		Возврат Операции;
	КонецЕсли;

	Шаг = М + 1;
	Размер = (Н + 1) * Шаг;
	Лкс = Новый Массив;
	Для Й = 1 По Размер Цикл
		Лкс.Добавить(0);
	КонецЦикла;

	И_ = Н - 1;
	Пока И_ >= 0 Цикл
		Ж = М - 1;
		Пока Ж >= 0 Цикл
			Если А[АОт + И_].Норм = Б[БОт + Ж].Норм Тогда
				Лкс[И_ * Шаг + Ж] = Лкс[(И_ + 1) * Шаг + (Ж + 1)] + 1;
			Иначе
				Лкс[И_ * Шаг + Ж] = Макс(Лкс[(И_ + 1) * Шаг + Ж], Лкс[И_ * Шаг + (Ж + 1)]);
			КонецЕсли;
			Ж = Ж - 1;
		КонецЦикла;
		И_ = И_ - 1;
	КонецЦикла;

	Х = 0;
	У = 0;
	Пока Х < Н И У < М Цикл
		Если А[АОт + Х].Норм = Б[БОт + У].Норм Тогда
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "equal", А[АОт + Х].Оригинал, Б[БОт + У].Оригинал));
			Х = Х + 1;
			У = У + 1;
		ИначеЕсли Лкс[(Х + 1) * Шаг + У] >= Лкс[Х * Шаг + (У + 1)] Тогда
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "delete", А[АОт + Х].Оригинал, ""));
			Х = Х + 1;
		Иначе
			Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "insert", "", Б[БОт + У].Оригинал));
			У = У + 1;
		КонецЕсли;
	КонецЦикла;
	Пока Х < Н Цикл
		Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "delete", А[АОт + Х].Оригинал, ""));
		Х = Х + 1;
	КонецЦикла;
	Пока У < М Цикл
		Операции.Добавить(Новый Структура("Вид, Типовой, Доработанный", "insert", "", Б[БОт + У].Оригинал));
		У = У + 1;
	КонецЦикла;
	Возврат Операции;
КонецФункции

Функция ОтрисоватьИзменениеИКонтрольДословно(ТекстТип, ТекстДоп, Операции)
	СырыеТ = СырыеСтрокиТела(ТекстТип);
	СырыеД = СырыеСтрокиТела(ТекстДоп);
	ИндТ = ИндексыЗначимыхСырых(СырыеТ);
	ИндД = ИндексыЗначимыхСырых(СырыеД);
	Результат = Новый Массив;
	ПоследняяСтрокаТип = 0;
	ТипИ = 0;
	ДопИ = 0;
	Й = 0;
	Пока Й < Операции.Количество() Цикл
		Вид = Операции[Й].Вид;
		Нач = Й;
		Пока Й < Операции.Количество() И Операции[Й].Вид = Вид Цикл
			Й = Й + 1;
		КонецЦикла;
		Кол = Й - Нач;
		Если Вид = "equal" Тогда
			Если ТипИ + Кол - 1 >= ИндТ.Количество() Тогда
				Прервать;
			КонецЕсли;
			КонецСыр = ИндТ[ТипИ + Кол - 1];
			ДобавитьСрезСтрок(Результат, СырыеТ, ПоследняяСтрокаТип, КонецСыр);
			ПоследняяСтрокаТип = КонецСыр + 1;
			ТипИ = ТипИ + Кол;
			ДопИ = ДопИ + Кол;
		ИначеЕсли Вид = "delete" Тогда
			НачСыр = ИндТ[ТипИ];
			КонецСыр = ИндТ[ТипИ + Кол - 1];
			РасширитьДиапазонСырых(СырыеТ, НачСыр, КонецСыр);
			ДобавитьСрезСтрок(Результат, СырыеТ, ПоследняяСтрокаТип, НачСыр - 1);
			Результат.Добавить("#Удаление");
			ДобавитьСрезСтрок(Результат, СырыеТ, НачСыр, КонецСыр);
			Результат.Добавить("#КонецУдаления");
			ПоследняяСтрокаТип = КонецСыр + 1;
			ТипИ = ТипИ + Кол;
		Иначе
			Если ДопИ > 0 Тогда
				НачСыр = ИндД[ДопИ - 1] + 1;
			Иначе
				НачСыр = 0;
			КонецЕсли;
			Если ДопИ + Кол < ИндД.Количество() Тогда
				КонецСыр = ИндД[ДопИ + Кол] - 1;
			Иначе
				КонецСыр = СырыеД.Количество() - 1;
			КонецЕсли;
			РасширитьДиапазонСырых(СырыеД, НачСыр, КонецСыр);
			Результат.Добавить("#Вставка");
			ДобавитьСрезСтрок(Результат, СырыеД, НачСыр, КонецСыр);
			Результат.Добавить("#КонецВставки");
			ДопИ = ДопИ + Кол;
		КонецЕсли;
	КонецЦикла;
	ДобавитьСрезСтрок(Результат, СырыеТ, ПоследняяСтрокаТип, СырыеТ.Количество() - 1);
	СкорректироватьГраницыМаркеровВМассиве(Результат);
	Результат = ВыровнятьМаркерыУпВБлоках(Результат);
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция ОтрисоватьЛксТело(Операции)
	Результат = Новый Массив;
	ОтложенныйМаркерНачало = "";
	ОтложенныйМаркерКонец = "";
	Й = 0;
	Пока Й < Операции.Количество() Цикл
		Вид = Операции[Й].Вид;
		Если Вид = "equal" Тогда
			Текст = Операции[Й].Типовой;
			Если Текст = "" Тогда
				Текст = Операции[Й].Доработанный;
			КонецЕсли;
			Если ЭтоКомментарийАпк(Текст) Тогда
				СтрАпк = Текст;
				Если Операции[Й].Типовой <> "" Тогда
					СтрАпк = Операции[Й].Типовой;
				КонецЕсли;
				Результат.Добавить(СтрАпк);
			ИначеЕсли ЭтоМаркерУпНачало(Текст) Тогда
				ОтложенныйМаркерНачало = Текст;
			ИначеЕсли ЭтоМаркерУпКонец(Текст) Тогда
				ОтложенныйМаркерКонец = Текст;
			Иначе
				Результат.Добавить(Текст);
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Блок = Новый Массив;
		Если ОтложенныйМаркерНачало <> "" Тогда
			Блок.Добавить(ОтложенныйМаркерНачало);
			ОтложенныйМаркерНачало = "";
		КонецЕсли;
		Пока Й < Операции.Количество() И Операции[Й].Вид = Вид Цикл
			Если Вид = "delete" Тогда
				Блок.Добавить(Операции[Й].Типовой);
			Иначе
				Блок.Добавить(Операции[Й].Доработанный);
			КонецЕсли;
			Й = Й + 1;
		КонецЦикла;
		Если Вид = "delete" Тогда
			Если Результат.Количество() > 0 И ЭтоМаркерУпНачало(Результат[Результат.Количество() - 1]) Тогда
				Блок.Вставить(0, Результат[Результат.Количество() - 1]);
				Результат.Удалить(Результат.Количество() - 1);
			КонецЕсли;
			Пока Й < Операции.Количество() И Операции[Й].Вид = "equal"
				И ЭтоМаркерУпКонец(ТекстСтрокиОперации(Операции[Й])) Цикл
				Блок.Добавить(ТекстСтрокиОперации(Операции[Й]));
				Й = Й + 1;
			КонецЦикла;
			Результат.Добавить("#Удаление");
			Для Каждого С Из Блок Цикл
				Результат.Добавить(С);
			КонецЦикла;
			Результат.Добавить("#КонецУдаления");
		Иначе
			Если Результат.Количество() > 0 И ЭтоМаркерУпНачало(Результат[Результат.Количество() - 1]) Тогда
				Блок.Вставить(0, Результат[Результат.Количество() - 1]);
				Результат.Удалить(Результат.Количество() - 1);
			КонецЕсли;
			Пока Й < Операции.Количество() И Операции[Й].Вид = "equal"
				И ЭтоМаркерУпКонец(ТекстСтрокиОперации(Операции[Й])) Цикл
				Блок.Добавить(ТекстСтрокиОперации(Операции[Й]));
				Й = Й + 1;
			КонецЦикла;
			Результат.Добавить("#Вставка");
			Если ОтложенныйМаркерКонец <> "" Тогда
				Блок.Добавить(ОтложенныйМаркерКонец);
				ОтложенныйМаркерКонец = "";
			КонецЕсли;
			Для Каждого С Из Блок Цикл
				Результат.Добавить(С);
			КонецЦикла;
			Результат.Добавить("#КонецВставки");
		КонецЕсли;
	КонецЦикла;
	Пока Результат.Количество() > 0 И СокрЛП(Результат[0]) = "" Цикл
		Результат.Удалить(0);
	КонецЦикла;
	Пока Результат.Количество() > 0 И СокрЛП(Результат[Результат.Количество() - 1]) = "" Цикл
		Результат.Удалить(Результат.Количество() - 1);
	КонецЦикла;
	Результат = ВыровнятьМаркерыУпВБлоках(Результат);
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция ВыровнятьМаркерыУпВБлоках(Строки)
	Р = Новый Массив;
	Для Каждого С Из Строки Цикл
		Р.Добавить(С);
	КонецЦикла;
	Й = 0;
	Пока Й < Р.Количество() - 1 Цикл
		Если ЭтоМаркерУпНачало(Р[Й]) И Р[Й + 1] = "#Вставка" Тогда
			М = Р[Й];
			Р.Удалить(Й);
			Р.Вставить(Й + 1, М);
			Й = Й + 2;
			Продолжить;
		ИначеЕсли ЭтоМаркерУпНачало(Р[Й]) И Р[Й + 1] = "#Удаление" Тогда
			М = Р[Й];
			Р.Удалить(Й);
			Р.Вставить(Й + 1, М);
			Й = Й + 2;
			Продолжить;
		ИначеЕсли ЭтоМаркерУпКонец(Р[Й]) И Й > 0 И Р[Й - 1] = "#КонецВставки" Тогда
			М = Р[Й];
			Р.Удалить(Й);
			Р.Вставить(Й - 1, М);
			Й = Й + 1;
			Продолжить;
		ИначеЕсли ЭтоМаркерУпКонец(Р[Й]) И Й > 0 И Р[Й - 1] = "#КонецУдаления" Тогда
			М = Р[Й];
			Р.Удалить(Й);
			Р.Вставить(Й - 1, М);
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстСтрокиОперации(Оп)
	Текст = Оп.Доработанный;
	Если Текст = "" Тогда
		Текст = Оп.Типовой;
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ЭтоКомментарийАпк(Стр)
	С = НРег(СокрЛП(Стр));
	Возврат СтрНачинаетсяС(С, "//") И СтрНайти(С, "апк:") > 0;
КонецФункции

Функция ЭтоМаркерУпНачало(Стр)
	С = НРег(СокрЛП(Стр));
	Возврат СтрНачинаетсяС(С, "//") И СтрНайти(С, "уп_начало") > 0;
КонецФункции

Функция ЭтоМаркерУпКонец(Стр)
	С = НРег(СокрЛП(Стр));
	Возврат СтрНачинаетсяС(С, "//") И СтрНайти(С, "уп_конец") > 0;
КонецФункции

Функция ДополнитьАпкТипового(ТекстТиповогоТела, Аннотация)
	ВТип = СтрРазделить(ТекстТиповогоТела, Символы.ПС, Истина);
	Рез = СтрРазделить(Аннотация, Символы.ПС, Истина);
	Для ИндАпк = 0 По ВТип.Количество() - 1 Цикл
		СтрАпк = ВТип[ИндАпк];
		Если Не ЭтоКомментарийАпк(СтрАпк) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Аннотация, СокрЛП(СтрАпк)) > 0 Тогда
			Продолжить;
		КонецЕсли;
		Поз = НайтиПозициюВставкиАпк(ВТип, ИндАпк, Рез);
		Рез.Вставить(Поз, СтрАпк);
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция НайтиПозициюВставкиАпк(ВТип, ИндексАпк, Рез)
	ЯкорьНорм = "";
	Й = ИндексАпк - 1;
	Пока Й >= 0 Цикл
		Если Не ЭтоКомментарийАпк(ВТип[Й]) И НормСтроки(ВТип[Й]) <> "" Тогда
			ЯкорьНорм = НормСтроки(ВТип[Й]);
			Прервать;
		КонецЕсли;
		Й = Й - 1;
	КонецЦикла;
	Если ЯкорьНорм = "" Тогда
		Возврат 0;
	КонецЕсли;
	Для К = 0 По Рез.Количество() - 1 Цикл
		Если СтрокаЯкоряСовпадает(Рез[К], ЯкорьНорм) Тогда
			Возврат К + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез.Количество();
КонецФункции

Функция СтрокаЯкоряСовпадает(Стр, ЯкорьНорм)
	Если Лев(СокрЛП(Стр), 1) = "#" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НормСтроки(Стр) = ЯкорьНорм;
КонецФункции
