// Кэш между прогонами в <выход>\cache (каталоги extension/restored при прогоне очищаются, cache — нет).
// 1) compare.json — результат шага compare (Модули + строки отчёта bsparser). Ключ: пути, размеры и время
//    изменения файлов модулей обеих выгрузок, содержимое файла настроек, текст src\*.os (версия кода), парсер.
//    Отключение — --без-кэша.
// 2) syntax.json / ast.json — результаты bsparser по каждому .bsl: ключ — SHA256 текста модуля и версии
//    проверяющего кода; проверяются только модули с новым хешем. Полная проверка — --полная-проверка.

Функция Хеш(Знач Текст) Экспорт
	Х = Новый ХешированиеДанных(ХешФункция.SHA256);
	Х.Добавить(?(Текст = Неопределено, "", Строка(Текст)));
	Возврат НРег(Строка(Х.ХешСумма));
КонецФункции

Функция ТекстФайла(Путь) Экспорт
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

// Версия кода: хеш текстов всех *.os каталога исходников.
Функция ВерсияКода(КаталогИсходников) Экспорт
	Имена = Новый Массив;
	Для Каждого Ф Из НайтиФайлы(КаталогИсходников, "*.os", Ложь) Цикл
		Имена.Добавить(Ф.ПолноеИмя);
	КонецЦикла;
	Сп = Новый СписокЗначений;
	Сп.ЗагрузитьЗначения(Имена);
	Сп.СортироватьПоЗначению();
	Ч = Новый Массив;
	Для Каждого Э Из Сп Цикл
		Ч.Добавить((Новый Файл(Э.Значение)).Имя + "=" + Хеш(ТекстФайла(Э.Значение)));
	КонецЦикла;
	Возврат Хеш(СтрСоединить(Ч, Символы.ПС));
КонецФункции

Функция ОписаниеВыгрузки(Выгрузка)
	Ключи = Новый Массив;
	Для Каждого КЗ Из Выгрузка.Модули Цикл
		Ключи.Добавить(КЗ.Ключ);
	КонецЦикла;
	Сп = Новый СписокЗначений;
	Сп.ЗагрузитьЗначения(Ключи);
	Сп.СортироватьПоЗначению();
	Ч = Новый Массив;
	Ч.Добавить(Выгрузка.Имя + "|" + Выгрузка.Версия + "|" + Выгрузка.Модули.Количество());
	Для Каждого Э Из Сп Цикл
		Ф = Новый Файл(Выгрузка.Модули.Получить(Э.Значение));
		Ч.Добавить(Э.Значение + "|" + Формат(Ф.Размер(), "ЧГ=0") + "|" + Формат(Ф.ПолучитьВремяИзменения(), "ДФ=yyyyMMddHHmmss"));
	КонецЦикла;
	Возврат Хеш(СтрСоединить(Ч, Символы.ПС));
КонецФункции

// Ключ кэша compare.
Функция КлючСравнения(Исходная, Поставщик, ФайлНастроек, КаталогИсходников, Парсер) Экспорт
	Ч = Новый Массив;
	Ч.Добавить("compare-v1");
	Ч.Добавить(ОписаниеВыгрузки(Исходная));
	Ч.Добавить(ОписаниеВыгрузки(Поставщик));
	Ч.Добавить(Хеш(?(ФайлНастроек = "", "", ТекстФайла(ФайлНастроек))));
	Ч.Добавить(ВерсияКода(КаталогИсходников));
	Ч.Добавить(Строка(Парсер));
	Возврат Хеш(СтрСоединить(Ч, Символы.ПС));
КонецФункции

Процедура ЗаписатьJSONВФайл(Путь, Данные)
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(Путь, "UTF-8");
	ЗаписатьJSON(Запись, Данные);
	Запись.Закрыть();
КонецПроцедуры

Функция ПрочитатьJSONИзФайла(Путь, ВСоответствие = Ложь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.ОткрытьФайл(Путь, "UTF-8");
		Д = ПрочитатьJSON(Чт, ВСоответствие);
		Чт.Закрыть();
		Возврат Д;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// modules из compare.json без проверки ключа (для --только-extension/--только-restored при смене версии typovaya-up).
Функция ПрочитатьСравнениеЛюбой(Путь) Экспорт
	Д = ПрочитатьJSONИзФайла(Путь);
	Если Д = Неопределено Или Не Д.Свойство("modules") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("modules, bsparserReport", Д.modules, Д.bsparserReport);
КонецФункции

// Структура(modules, bsparserReport) или Неопределено, если ключ не совпал / кэша нет.
Функция ПрочитатьСравнение(Путь, Ключ) Экспорт
	Д = ПрочитатьJSONИзФайла(Путь);
	Если Д = Неопределено Или Не Д.Свойство("key") Или Д.key <> Ключ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("modules, bsparserReport", Д.modules, Д.bsparserReport);
КонецФункции

Процедура ЗаписатьСравнение(Путь, Ключ, Модули, ОтчетBsparser) Экспорт
	ЗаписатьJSONВФайл(Путь, Новый Структура("key, modules, bsparserReport", Ключ, Модули, ОтчетBsparser));
КонецПроцедуры

// ---------- кэш результатов по файлам (bsparser) ----------

// Соответствие хеш -> результат; Версия — хеш проверяющего кода (при смене кэш пуст).
Функция ОткрытьКэшФайлов(Путь, Версия) Экспорт
	К = Новый Структура("path, version, items, hits, misses", Путь, Версия, Новый Соответствие, 0, 0);
	Д = ПрочитатьJSONИзФайла(Путь, Истина);
	Если Д <> Неопределено И Д.Получить("version") = Версия И ТипЗнч(Д.Получить("items")) = Тип("Соответствие") Тогда
		К.items = Д.Получить("items");
	КонецЕсли;
	Возврат К;
КонецФункции

// Ключ файла по тексту; результат или Неопределено.
Функция НайтиВКэше(Кэш, ХешТекста) Экспорт
	Если Кэш = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Р = Кэш.items.Получить(ХешТекста);
	Если Р = Неопределено Тогда
		Кэш.misses = Кэш.misses + 1;
	Иначе
		Кэш.hits = Кэш.hits + 1;
	КонецЕсли;
	Возврат Р;
КонецФункции

// Сохраняет только использованные в этом прогоне записи (Новые: хеш -> результат), чтобы кэш не рос.
Процедура Сохранить(Кэш, Новые) Экспорт
	Если Кэш = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьJSONВФайл(Кэш.path, Новый Структура("version, items", Кэш.version, Новые));
КонецПроцедуры
