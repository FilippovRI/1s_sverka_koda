// Замыкание локальных вспомогательных методов для модулей расширения.

Перем Разбор;
Перем ГлобальныеИмена;

// Подключает РазборМетодов для карты методов модуля.
Процедура Инициализировать(МодульРазбора) Экспорт
	Разбор = МодульРазбора;
КонецПроцедуры

Функция КлючевыеСлова() Экспорт
	Возврат Новый Соответствие;
КонецФункции

Функция СловарьКлючевыхСлов()
	Р = КлючевыеСлова();
	Если Р.Количество() > 0 Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого К Из СтрРазделить(
		"если,тогда,иначе,иначеесли,конецесли,для,каждого,из,по,цикл,конеццикла,пока,возврат,новый,не,и,или,"
		+ "попытка,исключение,конецпопытки,перем,знач,процедура,функция,конецпроцедуры,конецфункции,экспорт,"
		+ "прервать,продолжить,вызватьисключение,асинх,ждать,перейти,сообщить,описаниетипов,тип,неопределено,истина,ложь", ",") Цикл
		Р.Вставить(К, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КартаМетодов(ТекстМодуля)
	Р = Новый Соответствие;
	Если СокрЛП(ТекстМодуля) = "" Тогда
		Возврат Р;
	КонецЕсли;
	Раз = Разбор.РазобратьМодуль(ТекстМодуля);
	Для Каждого М Из Раз.Методы Цикл
		Р.Вставить(М.Имя, М);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЛокальныеВызовыИзТекста(Текст, ИменаМодуля)
	Рез = Новый Соответствие;
	Ключ = СловарьКлючевыхСлов();
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Код = Разбор.УбратьКомментарий(Стр);
		ДобавитьВызовыИзСтроки(Код, ИменаМодуля, Ключ, Рез);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ДобавитьВызовыИзСтроки(Код, ИменаМодуля, Ключ, Рез)
	Если ПропуститьСтрокуПриПоискеВызовов(Код) Тогда
		Возврат;
	КонецЕсли;
	Дл = СтрДлина(Код);
	П = 1;
	ВСтроке = СтрНачинаетсяС(СокрЛ(Код), "|");
	ПредИмя = "";
	Пока П <= Дл Цикл
		С = Сред(Код, П, 1);
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ЭтоНачалоИдентификатора(С) Тогда
			Имя = ПрочитатьИдентификатор(Код, П);
			ПозПослеИмени = П + СтрДлина(Имя);
			ПСлед = ПозПослеИмени;
			Пока ПСлед <= Дл И (Сред(Код, ПСлед, 1) = " " Или Сред(Код, ПСлед, 1) = Символы.Таб) Цикл
				ПСлед = ПСлед + 1;
			КонецЦикла;
			Если ПСлед <= Дл И Сред(Код, ПСлед, 1) = "(" Тогда
				Пред = ?(П - 1 < 1, "", Сред(Код, П - 1, 1));
				Если Пред <> "." И Не Ключ.Получить(НРег(Имя)) = Истина И Не ЭтоИмяПослеОбъявления(ПредИмя) Тогда
					Если ИменаМодуля.Получить(Имя) <> Неопределено Тогда
						Рез.Вставить(Имя, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			ПредИмя = НРег(Имя);
			П = ПозПослеИмени;
			Продолжить;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
КонецПроцедуры

// Аннотации (&), инструкции препроцессора (#) и пустые строки вызовов не содержат.
Функция ПропуститьСтрокуПриПоискеВызовов(Код)
	Ч = СокрЛП(Код);
	Возврат Ч = "" Или СтрНачинаетсяС(Ч, "&") Или СтрНачинаетсяС(Ч, "#");
КонецФункции

// Имя сразу после Процедура/Функция/Новый — объявление или конструктор, не вызов метода модуля.
Функция ЭтоИмяПослеОбъявления(ПредИмя)
	Возврат ПредИмя = "процедура" Или ПредИмя = "функция" Или ПредИмя = "новый"
		Или ПредИмя = "procedure" Или ПредИмя = "function" Или ПредИмя = "new";
КонецФункции

Функция ЭтоНачалоИдентификатора(С)
	К = КодСимвола(С);
	Возврат (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105 Или (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или С = "_";
КонецФункции

Функция ПрочитатьИдентификатор(Код, Поз)
	Дл = СтрДлина(Код);
	Р = "";
	Для Й = Поз По Дл Цикл
		С = Сред(Код, Й, 1);
		Если ЭтоНачалоИдентификатора(С) Или (С >= "0" И С <= "9") Тогда
			Р = Р + С;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Выбранные методы уже есть в модуле расширения: хук (вызов исходного имени уходит в основную
// конфигурацию через перехват) или новый метод с префиксом. Повторно их не копируем.
Функция ИменаУжеЭмитированы(Выбранные, Префикс)
	Р = Новый Соответствие;
	Для Каждого Мт Из Выбранные Цикл
		Р.Вставить(Мт.name, Истина);
		Р.Вставить(Префикс + Мт.name, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстыТелДляАнализа(Выбранные)
	Ч = Новый Массив;
	Для Каждого Мт Из Выбранные Цикл
		Если Мт.status = "added" Тогда
			Ч.Добавить(Мт.sourceText);
		ИначеЕсли ЭтоИзменениеИКонтроль(Мт) Тогда
			Ч.Добавить(СтрокиВставок(Мт.hookBody));
		Иначе
			Ч.Добавить(Мт.hookBody);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

// Признак метода с хуком &ИзменениеИКонтроль.
//
// Параметры:
//   Мт — структура метода (поле hook).
//
// Возвращаемое значение:
//   Булево.
Функция ЭтоИзменениеИКонтроль(Мт) Экспорт
	Возврат Мт.Свойство("hook") И Мт.hook = "changeAndControl";
КонецФункции

// Строки кода УП внутри #Вставка … #КонецВставки (типовые и #Удаление не берутся).
//
// Параметры:
//   Текст — тело хука &ИзменениеИКонтроль.
//
// Возвращаемое значение:
//   Массив строк внутри вставок.
Функция СтрокиВставок(Текст) Экспорт
	Рез = Новый Массив;
	ВоВставке = Ложь;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Ч = НРег(СокрЛП(Стр));
		Если СтрНачинаетсяС(Ч, "#вставка") Тогда
			ВоВставке = Истина;
		ИначеЕсли СтрНачинаетсяС(Ч, "#конецвставки") Тогда
			ВоВставке = Ложь;
		ИначеЕсли ВоВставке Тогда
			Рез.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

// Переименовывает локальные вызовы только внутри #Вставка; типовые/#Удаление — байт в байт.
//
// Параметры:
//   Текст — тело ИК; Переименования — Соответствие староеИмя → УП_имя.
//
// Возвращаемое значение:
//   Текст с переписанными вставками.
Функция ПереписатьВызовыВоВставках(Текст, Переименования) Экспорт
	Если Переименования.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	ВоВставке = Ложь;
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Ч = НРег(СокрЛП(Строки[Й]));
		Если СтрНачинаетсяС(Ч, "#вставка") Тогда
			ВоВставке = Истина;
		ИначеЕсли СтрНачинаетсяС(Ч, "#конецвставки") Тогда
			ВоВставке = Ложь;
		ИначеЕсли ВоВставке Тогда
			Строки[Й] = ПереписатьЛокальныеВызовы(Строки[Й], Переименования);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Замыкание локальных хелперов для выбранных методов расширения.
// Для ИК анализ вызовов и rename — только по #Вставка.
//
// Параметры:
//   М — описание модуля; Выбранные — методы в черновик; Префикс — например УП_.
//
// Возвращаемое значение:
//   Структура ДопМетоды, Переименования, СписокЛога, helpersCopied.
Функция ДозаполнитьВспомогательные(М, Выбранные, Префикс, ДопТексты = "") Экспорт
	Рез = Новый Структура("ДопМетоды, Переименования, СписокЛога, helpersCopied",
		Новый Массив, Новый Соответствие, Новый Массив, 0);
	КартаИ = КартаМетодов(М.sourceText);
	КартаП = КартаМетодов(М.vendorText);
	Если КартаИ.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Уже = ИменаУжеЭмитированы(Выбранные, Префикс);
	Для Каждого Мт Из Выбранные Цикл
		Если Мт.status = "added" И Не СтрНачинаетсяС(Мт.name, Префикс) Тогда
			Рез.Переименования.Вставить(Мт.name, Префикс + Мт.name);
		КонецЕсли;
	КонецЦикла;
	Очередь = Новый Массив;
	// ДопТексты — тексты копий УП_<Имя> (сигнатура УП отличается): их хелперы тоже нужны в расширении.
	ДобавитьВОчередь(ЛокальныеВызовыИзТекста(ТекстыТелДляАнализа(Выбранные) + Символы.ПС + ДопТексты, КартаИ), Очередь, Уже);
	Пока Очередь.Количество() > 0 Цикл
		Имя = Очередь[0];
		Очередь.Удалить(0);
		Если Уже.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Мет = КартаИ.Получить(Имя);
		Если Мет = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НовоеИмя = Имя;
		Если КартаП.Получить(Имя) <> Неопределено И Не СтрНачинаетсяС(Имя, Префикс) Тогда
			НовоеИмя = Префикс + Имя;
			// В УП уже есть свой метод с таким именем (УП_<Имя>) — берём свободное имя, иначе дубль объявления.
			Н = 2;
			Пока КартаИ.Получить(НовоеИмя) <> Неопределено Или (Уже.Получить(НовоеИмя) = Истина И КартаИ.Получить(НовоеИмя) <> Неопределено) Цикл
				НовоеИмя = Префикс + Имя + "_" + Н;
				Н = Н + 1;
			КонецЦикла;
			Рез.Переименования.Вставить(Имя, НовоеИмя);
		КонецЕсли;
		Переим = Новый Соответствие;
		Если НовоеИмя <> Имя Тогда
			Переим.Вставить(Имя, НовоеИмя);
		КонецЕсли;
		ТекстМ = Мет.Текст;
		Если НовоеИмя <> Имя Тогда
			ТекстМ = ПереименоватьМетодВТексте(ТекстМ, Имя, НовоеИмя);
		КонецЕсли;
		Рез.ДопМетоды.Добавить(ТекстМ);
		Уже.Вставить(Имя, Истина);
		Уже.Вставить(НовоеИмя, Истина);
		Рез.СписокЛога.Добавить(?(НовоеИмя = Имя, Имя, Имя + "→" + НовоеИмя));
		Рез.helpersCopied = Рез.helpersCopied + 1;
		ДобавитьВОчередь(ЛокальныеВызовыИзТекста(Мет.Текст, КартаИ), Очередь, Уже);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ДобавитьВОчередь(Вызовы, Очередь, Уже)
	Для Каждого КЗ Из Вызовы Цикл
		Имя = КЗ.Ключ;
		Если Уже.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Очередь.Добавить(Имя);
	КонецЦикла;
КонецПроцедуры

Функция ПереименоватьМетодВТексте(Текст, Имя, НовоеИмя)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Если Разбор.РазобратьОбъявление(Строки[Й]) <> Неопределено Тогда
			Строки[Й] = ЗаменитьИмяВОбъявлении(Строки[Й], Имя, НовоеИмя);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Текст = СтрСоединить(Строки, Символы.ПС);
	П = Новый Соответствие;
	П.Вставить(Имя, НовоеИмя);
	Возврат ПереписатьЛокальныеВызовы(Текст, П);
КонецФункции

Функция ЗаменитьИмяВОбъявлении(Стр, Имя, НовоеИмя)
	Скобка = СтрНайти(Стр, "(");
	Если Скобка = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	До = Лев(Стр, Скобка - 1);
	Поз = СтрНайти(НРег(До), НРег(Имя), НаправлениеПоиска.СКонца);
	Если Поз > 0 Тогда
		Возврат Лев(До, Поз - 1) + НовоеИмя + Сред(До, Поз + СтрДлина(Имя)) + Сред(Стр, Скобка);
	КонецЕсли;
	Возврат Стр;
КонецФункции

// Переписывает локальные вызовы во всём тексте (не только во вставках).
//
// Параметры:
//   Текст — модуль/тело; Переименования — Соответствие имён.
//
// Возвращаемое значение:
//   Текст после замен.
Функция ПереписатьЛокальныеВызовы(Текст, Переименования) Экспорт
	Если Переименования.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		// Строка-продолжение многострочного литерала ("|...") начинается внутри строки;
		// комментарий «//» ищется только вне строковых литералов (в ПереписатьВызовыВСтроке).
		Строки[Й] = ПереписатьВызовыВСтроке(Строки[Й], Переименования, СтрНачинаетсяС(СокрЛ(Строки[Й]), "|"));
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ПереписатьВызовыВСтроке(Код, Переименования, НачатьВСтроке = Ложь)
	Дл = СтрДлина(Код);
	Если Дл = 0 Тогда
		Возврат Код;
	КонецЕсли;
	Рез = "";
	П = 1;
	ВСтроке = НачатьВСтроке;
	Пока П <= Дл Цикл
		С = Сред(Код, П, 1);
		Если Не ВСтроке И С = "/" И Сред(Код, П + 1, 1) = "/" Тогда
			Возврат Рез + Сред(Код, П);
		КонецЕсли;
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
			Рез = Рез + С;
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			Рез = Рез + С;
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ЭтоНачалоИдентификатора(С) Тогда
			Имя = ПрочитатьИдентификатор(Код, П);
			Хвост = П + СтрДлина(Имя) - 1;
			ПСлед = Хвост + 1;
			Пока ПСлед <= Дл И (Сред(Код, ПСлед, 1) = " " Или Сред(Код, ПСлед, 1) = Символы.Таб) Цикл
				ПСлед = ПСлед + 1;
			КонецЦикла;
			Нов = Переименования.Получить(Имя);
			Если Нов <> Неопределено И ПСлед <= Дл И Сред(Код, ПСлед, 1) = "(" Тогда
				Пред = ?(П - 1 < 1, "", Сред(Код, П - 1, 1));
				Если Пред <> "." Тогда
					Рез = Рез + Нов;
					П = П + СтрДлина(Имя);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Рез = Рез + Имя;
			П = П + СтрДлина(Имя);
			Продолжить;
		КонецЕсли;
		Рез = Рез + С;
		П = П + 1;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Все идентификаторы-вызовы из текста (без фильтра по именам модуля).
//
// Параметры:
//   Текст — фрагмент .bsl.
//
// Возвращаемое значение:
//   Соответствие имя → Истина.
Функция ВсеВызовыИзТекста(Текст) Экспорт
	Ключ = СловарьКлючевыхСлов();
	Рез = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		ДобавитьВсеВызовыИзСтроки(Разбор.УбратьКомментарий(Стр), Ключ, Рез);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ДобавитьВсеВызовыИзСтроки(Код, Ключ, Рез)
	Если ПропуститьСтрокуПриПоискеВызовов(Код) Тогда
		Возврат;
	КонецЕсли;
	Дл = СтрДлина(Код);
	П = 1;
	ВСтроке = СтрНачинаетсяС(СокрЛ(Код), "|");
	ПредИмя = "";
	Пока П <= Дл Цикл
		С = Сред(Код, П, 1);
		Если С = """" Тогда ВСтроке = Не ВСтроке; П = П + 1; Продолжить; КонецЕсли;
		Если ВСтроке Тогда П = П + 1; Продолжить; КонецЕсли;
		Если ЭтоНачалоИдентификатора(С) Тогда
			Имя = ПрочитатьИдентификатор(Код, П);
			ПозПослеИмени = П + СтрДлина(Имя);
			ПСлед = ПозПослеИмени;
			Пока ПСлед <= Дл И (Сред(Код, ПСлед, 1) = " " Или Сред(Код, ПСлед, 1) = Символы.Таб) Цикл ПСлед = ПСлед + 1; КонецЦикла;
			Если ПСлед <= Дл И Сред(Код, ПСлед, 1) = "(" Тогда
				Пред = ?(П - 1 < 1, "", Сред(Код, П - 1, 1));
				Если Пред <> "." И Не Ключ.Получить(НРег(Имя)) = Истина И Не ЭтоИмяПослеОбъявления(ПредИмя) Тогда
					Рез.Вставить(Имя, Истина);
				КонецЕсли;
			КонецЕсли;
			ПредИмя = НРег(Имя);
			П = ПозПослеИмени;
			Продолжить;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
КонецПроцедуры

// Whitelist методов глобального контекста платформы (vendor/bsparser/scope/global).
//
// Возвращаемое значение:
//   Соответствие нрег(имя) → Истина.
Функция ИменаГлобальногоКонтекста() Экспорт
	Если ГлобальныеИмена <> Неопределено Тогда
		Возврат ГлобальныеИмена;
	КонецЕсли;
	ГлобальныеИмена = Новый Соответствие;
	Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "vendor", "bsparser");
	Путь = ОбъединитьПути(Корень, "scope", "global", "src");
	Путь = ОбъединитьПути(Путь, "ГлобальноеОкружение", "Ext", "ObjectModule.bsl");
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат ГлобальныеИмена;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Маркер = "ВставитьМетод(""";
	Для Каждого Стр Из СтрРазделить(Т.ПолучитьТекст(), Символы.ПС, Ложь) Цикл
		Поз = СтрНайти(Стр, Маркер);
		Если Поз = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Стр, Поз + СтрДлина(Маркер));
		Кон = СтрНайти(Хвост, """");
		Если Кон > 1 Тогда
			ГлобальныеИмена.Вставить(НРег(Лев(Хвост, Кон - 1)), Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат ГлобальныеИмена;
КонецФункции

// Скан модуля: вызовы без определения в этом же файле (без методов глобального контекста).
// Образцы (необязательно) — массив, дополняется именами неразрешённых вызовов.
Функция ПодсчитатьНеразрешённыеЛокальныеВызовы(ТекстМодуля, Образцы = Неопределено) Экспорт
	Карта = КартаМетодов(ТекстМодуля);
	Глоб = ИменаГлобальногоКонтекста();
	Всего = 0;
	Для Каждого КЗ Из Карта Цикл
		Выз = ВсеВызовыИзТекста(КЗ.Значение.Текст);
		Для Каждого В Из Выз Цикл
			Если Карта.Получить(В.Ключ) = Неопределено И Глоб.Получить(НРег(В.Ключ)) = Неопределено Тогда
				Всего = Всего + 1;
				Если Образцы <> Неопределено Тогда
					Образцы.Добавить(КЗ.Ключ + " → " + В.Ключ);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Всего;
КонецФункции

// Число неразрешённых локальных вызовов по всем .bsl каталога расширения.
//
// Параметры:
//   Корень — каталог extension.
//
// Возвращаемое значение:
//   Число (сумма по файлам).
Функция СканироватьКаталогРасширения(Корень) Экспорт
	Возврат СканироватьКаталогРасширенияПодробно(Корень).count;
КонецФункции

// Результат: Структура(count, samples) — образцы "файл: метод → вызов" (до МаксОбразцов).
Функция СканироватьКаталогРасширенияПодробно(Корень, МаксОбразцов = 20) Экспорт
	Р = Новый Структура("count, samples", 0, Новый Массив);
	Для Каждого Ф Из НайтиФайлы(Корень, "*.bsl", Истина) Цикл
		Т = Новый ТекстовыйДокумент;
		Т.Прочитать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
		Образцы = Новый Массив;
		Р.count = Р.count + ПодсчитатьНеразрешённыеЛокальныеВызовы(Т.ПолучитьТекст(), Образцы);
		Для Каждого О Из Образцы Цикл
			Если Р.samples.Количество() < МаксОбразцов Тогда
				Р.samples.Добавить(Сред(Ф.ПолноеИмя, СтрДлина(Корень) + 2) + ": " + О);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции
// Методы платформенных объектов/менеджеров/наборов записей, вызываемые в их модулях без квалификатора.
Функция МетодыКонтекстаОбъекта()
	Р = Новый Соответствие;
	Для Каждого ИмяМ Из СтрРазделить("ПолучитьМакет,ПолучитьФорму,Количество,ЭтоНовый,СоздатьДокумент,СоздатьЭлемент,СоздатьГруппу,"
		+ "НайтиПоРеквизиту,НайтиПоКоду,НайтиПоНаименованию,НайтиПоНомеру,Выбрать,ВыбратьИерархически,Записать,Прочитать,"
		+ "Заполнить,ПроверитьЗаполнение,Модифицированность,УстановитьНовыйНомер,УстановитьНовыйКод,Очистить,Добавить,Вставить,"
		+ "Выгрузить,Загрузить,Удалить,УстановитьПометкуУдаления,ПолучитьОбъект,ПустаяСсылка,Скопировать,СоздатьНаборЗаписей,"
		+ "СоздатьМенеджерЗаписи,СрезПоследних,СрезПервых,Получить,Индекс,Найти,НайтиСтроки,Сдвинуть,Итог,Свернуть,"
		+ "ВыгрузитьКолонку,ЗагрузитьКолонку,ЗаполнитьЗначения,Сортировать,Заблокировать,Разблокировать,Заблокирован,"
		+ "СкомпоноватьРезультат,ПолучитьСсылку,ПолучитьПредставлениеНомера,ПолучитьПредставлениеКода,ПолучитьСсылкуНового,"
		+ "УстановитьСсылкуНового,ВыбратьИзменения,ЗарегистрироватьИзменения,УдалитьРегистрациюИзменений,Отбор,"
		+ "ПолучитьДанныеВыбора,ПолучитьОбластьМакета,УстановитьВремя,ПолучитьВремя,ВыполнитьНастройку,ПолучитьЗначение", ",") Цикл
		Р.Вставить(НРег(ИмяМ), Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Экспортные методы глобальных общих модулей (<Global>true</Global>), имя (нрег) → Истина.
Функция МетодыГлобальныхОбщихМодулей(КореньУп)
	Р = Новый Соответствие;
	Кат = ОбъединитьПути(КореньУп, "CommonModules");
	Если КореньУп = "" Или Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Кат, "*.xml", Ложь) Цикл
		Если СтрНайти(ТекстМодуля(Ф.ПолноеИмя), "<Global>true</Global>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПутьМ = ОбъединитьПути(Кат, Ф.ИмяБезРасширения, "Ext", "Module.bsl");
		Если Не (Новый Файл(ПутьМ)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого КЗ Из КартаМетодовНРег(ТекстМодуля(ПутьМ)) Цикл
			Если ЗаголовокСЭкспортом(КЗ.Значение.Текст) Тогда
				Р.Вставить(КЗ.Ключ, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Неразрешённые вызовы без квалификатора в extension с учётом контекста, видимого расширению.
// Ложные (не считаются): метод расширения, глобальный контекст платформы, метод основного модуля
// (restored, иначе УП) — экспортный, перехваченный или с обёрткой &Вместо УП_<Имя>, экспортный метод
// глобального общего модуля, метод платформенного объекта/менеджера.
// Настоящие (count): метод есть только в модуле УП (не перенесён), неэкспортный метод основного
// модуля без обёртки &Вместо. Не найден нигде — unknown (ручной разбор, в count не входит).
//
// Возвращаемое значение:
//   Структура count, unknown, falsePositive, samples, unknownSamples, kinds (Структура счётчиков).
Функция СканироватьКаталогРасширенияСКонтекстом(КатРасш, КатВосст, КореньУп, МаксОбразцов = 50) Экспорт
	Р = Новый Структура("count, unknown, falsePositive, samples, unknownSamples, kinds", 0, 0, 0, Новый Массив, Новый Массив,
		Новый Структура("upOnlyNotTransferred, nonExportNoWrapper", 0, 0));
	Если Не (Новый Файл(КатРасш)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Глоб = ИменаГлобальногоКонтекста();
	ГлобМод = МетодыГлобальныхОбщихМодулей(КореньУп);
	Объектные = МетодыКонтекстаОбъекта();
	Для Каждого Ф Из НайтиФайлы(КатРасш, "*.bsl", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КатРасш) + 2);
		ТекстРасш = ТекстМодуля(Ф.ПолноеИмя);
		ПутьВ = ОбъединитьПути(КатВосст, Отн);
		ПутьУ = ?(КореньУп = "", "", ОбъединитьПути(КореньУп, Отн));
		ТекстОсн = "";
		ТекстУп = "";
		Если (Новый Файл(ПутьВ)).Существует() Тогда
			ТекстОсн = ТекстМодуля(ПутьВ);
		ИначеЕсли ПутьУ <> "" И (Новый Файл(ПутьУ)).Существует() Тогда
			ТекстОсн = ТекстМодуля(ПутьУ);
		КонецЕсли;
		Если ПутьУ <> "" И (Новый Файл(ПутьУ)).Существует() Тогда
			ТекстУп = ТекстМодуля(ПутьУ);
		КонецЕсли;
		КартаР = КартаМетодовНРег(ТекстРасш);
		КартаО = КартаМетодовНРег(ТекстОсн);
		КартаУ = КартаМетодовНРег(ТекстУп);
		Хуки = КартаХуковТиповых(Разбор.РазобратьМодуль(ТекстРасш));
		Для Каждого КЗ Из КартаР Цикл
			Для Каждого В Из ВсеВызовыИзТекста(КЗ.Значение.Текст) Цикл
				Ключ = НРег(В.Ключ);
				Если КартаР.Получить(Ключ) <> Неопределено Или Глоб.Получить(Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				МО = КартаО.Получить(Ключ);
				Вид = "";
				Если МО <> Неопределено Тогда
					Если ЗаголовокСЭкспортом(МО.Текст) Или Хуки.Получить(Ключ) <> Неопределено
						Или КартаР.Получить("уп_" + Ключ) <> Неопределено Тогда
						Р.falsePositive = Р.falsePositive + 1;
						Продолжить;
					КонецЕсли;
					Вид = "nonExportNoWrapper";
				ИначеЕсли ГлобМод.Получить(Ключ) <> Неопределено Или Объектные.Получить(Ключ) <> Неопределено Тогда
					Р.falsePositive = Р.falsePositive + 1;
					Продолжить;
				ИначеЕсли КартаУ.Получить(Ключ) <> Неопределено Или КартаУ.Получить(Сред(Ключ, 4)) <> Неопределено И СтрНачинаетсяС(Ключ, "уп_") Тогда
					Вид = "upOnlyNotTransferred";
				КонецЕсли;
				Образец = Отн + ": " + КЗ.Значение.Имя + " → " + В.Ключ;
				Если Вид = "" Тогда
					Р.unknown = Р.unknown + 1;
					Если Р.unknownSamples.Количество() < МаксОбразцов Тогда
						Р.unknownSamples.Добавить(Образец);
					КонецЕсли;
					Продолжить;
				КонецЕсли;
				Р.count = Р.count + 1;
				Р.kinds[Вид] = Р.kinds[Вид] + 1;
				Если Р.samples.Количество() < МаксОбразцов Тогда
					Р.samples.Добавить(Образец + " [" + Вид + "]");
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

// После сборки расширения: методы restored того же модуля, которые вызываются
// из расширения (типовая часть хуков и прочий код) и не имеют Экспорт,
// получают Экспорт только в строке сигнатуры. Пишет <выход>\export_added.json.
//
// Параметры:
//   КаталогВыхода — папка с подкаталогами extension и restored.
//
// Возвращаемое значение:
//   Структура(count, items) — items: массив Структур(path, name).
Функция ОбработатьКаталогВыхода(КаталогВыхода) Экспорт
	КРасш = ОбъединитьПути(КаталогВыхода, "extension");
	КВосст = ОбъединитьПути(КаталогВыхода, "restored");
	Рез = ДобавитьЭкспортПоВызовамРасширения(КРасш, КВосст);
	ЗаписатьJsonЭкспорта(ОбъединитьПути(КаталогВыхода, "export_added.json"), Рез);
	Возврат Рез;
КонецФункции

// Параметры:
//   КаталогРасш, КаталогВосст — каталоги модулей расширения и restored.
// Возвращаемое значение: Структура(count, items).
Функция ДобавитьЭкспортПоВызовамРасширения(КаталогРасш, КаталогВосст) Экспорт
	Рез = Новый Структура("count, items", 0, Новый Массив);
	Если Не (Новый Файл(КаталогРасш)).Существует() Или Не (Новый Файл(КаталогВосст)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Глоб = ИменаГлобальногоКонтекста();
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "*.bsl", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		ПутьВосст = ОбъединитьПути(КаталогВосст, Отн);
		Если Не (Новый Файл(ПутьВосст)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		ТекстРасш = ТекстМодуля(Ф.ПолноеИмя);
		ТекстВосст = ТекстМодуля(ПутьВосст);
		КартаРасш = КартаМетодовНРег(ТекстРасш);
		КартаВосст = КартаМетодовНРег(ТекстВосст);
		Если КартаВосст.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нужные = Новый Соответствие;
		РазМ = Разбор.РазобратьМодуль(ТекстРасш);
		Для Каждого М Из РазМ.Методы Цикл
			Вызовы = ВсеВызовыИзТекста(М.Текст);
			Для Каждого КЗ Из Вызовы Цикл
				Ключ = НРег(КЗ.Ключ);
				Если Глоб.Получить(Ключ) = Истина Тогда
					Продолжить;
				КонецЕсли;
				Если КартаРасш.Получить(Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				МВосст = КартаВосст.Получить(Ключ);
				Если МВосст = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ЗаголовокСЭкспортом(МВосст.Текст) Тогда
					Продолжить;
				КонецЕсли;
				Нужные.Вставить(Ключ, МВосст.Имя);
			КонецЦикла;
		КонецЦикла;
		Если Нужные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		НовыйТекст = ВставитьЭкспортВТекстМодуля(ТекстВосст, Нужные);
		Если НовыйТекст = ТекстВосст Тогда
			Продолжить;
		КонецЕсли;
		ЗаписатьТекстБезBOM(ПутьВосст, НовыйТекст);
		Для Каждого КЗ Из Нужные Цикл
			Рез.items.Добавить(Новый Структура("path, name", Отн, КЗ.Значение));
			Рез.count = Рез.count + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ТекстМодуля(Путь)
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Процедура ЗаписатьТекстБезBOM(Путь, Текст)
	Д = ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8NoBOM);
	Д.Записать(Путь);
КонецПроцедуры

Процедура ЗаписатьJsonЭкспорта(Путь, Рез)
	Ч = Новый Массив;
	Ч.Добавить("{");
	Ч.Добавить("	""count"": " + XMLСтрока(Рез.count) + ",");
	Ч.Добавить("	""items"": [");
	Для Й = 0 По Рез.items.Количество() - 1 Цикл
		Э = Рез.items[Й];
		Хвост = ?(Й < Рез.items.Количество() - 1, ",", "");
		Ч.Добавить("		{""path"": " + JsonСтрока(Э.path) + ", ""name"": " + JsonСтрока(Э.name) + "}" + Хвост);
	КонецЦикла;
	Ч.Добавить("	]");
	Ч.Добавить("}");
	ЗаписатьТекстБезBOM(Путь, СтрСоединить(Ч, Символы.ПС) + Символы.ПС);
КонецПроцедуры

Функция JsonСтрока(Знач С)
	С = СтрЗаменить(С, "\", "\\");
	С = СтрЗаменить(С, """", "\""");
	С = СтрЗаменить(С, Символы.ПС, "\n");
	С = СтрЗаменить(С, Символы.ВК, "");
	Возврат """" + С + """";
КонецФункции

Функция ЗаголовокСЭкспортом(ТекстМетода)
	Индекс = ИндексКонцаЗаголовка(СтрРазделить(ТекстМетода, Символы.ПС, Истина));
	Если Индекс.Конец < 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрокаЗаголовкаСЭкспортом(Индекс.Строки[Индекс.Конец], Индекс.ПозСкобки);
КонецФункции

Функция ВставитьЭкспортВТекстМодуля(ТекстМодуля, Нужные)
	Строки = СтрРазделить(ТекстМодуля, Символы.ПС, Истина);
	Раз = Разбор.РазобратьМодуль(ТекстМодуля);
	Для Каждого М Из Раз.Методы Цикл
		Если Нужные.Получить(М.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗаголовокСЭкспортом(М.Текст) Тогда
			Продолжить;
		КонецЕсли;
		// Начало — 1-based, может указывать на аннотацию.
		Н0 = М.Начало - 1;
		Если Н0 < 0 Тогда
			Н0 = 0;
		КонецЕсли;
		Кусок = Новый Массив;
		МаксК = Мин(Н0 + 12, Строки.Количество() - 1);
		Для Й = Н0 По МаксК Цикл
			Кусок.Добавить(Строки[Й]);
		КонецЦикла;
		Индекс = ИндексКонцаЗаголовка(Кусок);
		Если Индекс.Конец < 0 Или СтрокаЗаголовкаСЭкспортом(Кусок[Индекс.Конец], Индекс.ПозСкобки) Тогда
			Продолжить;
		КонецЕсли;
		Абсолют = Н0 + Индекс.Конец;
		Строки[Абсолют] = ВставитьЭкспортВСтроку(Строки[Абсолют], Индекс.ПозСкобки);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Ищет строку с закрывающей «)» заголовка. Возвращает Структура(Строки, Конец, ПозСкобки).
Функция ИндексКонцаЗаголовка(Строки)
	Р = Новый Структура("Строки, Конец, ПозСкобки", Строки, -1, 0);
	Старт = -1;
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Код = СокрЛП(Разбор.УбратьКомментарий(Строки[Й]));
		Н = НРег(Код);
		Если СтрНачинаетсяС(Н, "процедура ") Или СтрНачинаетсяС(Н, "функция ") Или СтрНачинаетсяС(Н, "асинх ") Тогда
			Старт = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Старт < 0 Тогда
		Возврат Р;
	КонецЕсли;
	Глубина = 0;
	БылаСкобка = Ложь;
	Для Й = Старт По Строки.Количество() - 1 Цикл
		Стр = Строки[Й];
		ВСтроке = Ложь;
		Дл = СтрДлина(Стр);
		К = 1;
		Пока К <= Дл Цикл
			Сим = Сред(Стр, К, 1);
			Если Не ВСтроке Тогда
				Если Сим = "/" И К < Дл И Сред(Стр, К + 1, 1) = "/" Тогда
					Прервать;
				ИначеЕсли Сим = """" Тогда
					ВСтроке = Истина;
				ИначеЕсли Сим = "(" Тогда
					Глубина = Глубина + 1;
					БылаСкобка = Истина;
				ИначеЕсли Сим = ")" Тогда
					Глубина = Глубина - 1;
					Если БылаСкобка И Глубина = 0 Тогда
						Р.Конец = Й;
						Р.ПозСкобки = К;
						Возврат Р;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если Сим = """" Тогда
					Если К < Дл И Сред(Стр, К + 1, 1) = """" Тогда
						К = К + 1;
					Иначе
						ВСтроке = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			К = К + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СтрокаЗаголовкаСЭкспортом(Стр, ПозСкобки)
	Хвост = СокрЛ(Сред(Стр, ПозСкобки + 1));
	Возврат СтрНачинаетсяС(НРег(Хвост), "экспорт");
КонецФункции

Функция ВставитьЭкспортВСтроку(Стр, ПозСкобки)
	Левая = Лев(Стр, ПозСкобки);
	Правая = Сред(Стр, ПозСкобки + 1);
	Если СтрНачинаетсяС(НРег(СокрЛ(Правая)), "экспорт") Тогда
		Возврат Стр;
	КонецЕсли;
	Возврат Левая + " Экспорт" + Правая;
КонецФункции
Функция КартаМетодовНРег(ТекстМодуля)
	Р = Новый Соответствие;
	Для Каждого КЗ Из КартаМетодов(ТекстМодуля) Цикл
		Р.Вставить(НРег(КЗ.Ключ), КЗ.Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции
// После сборки расширения: для неэкспортных методов restored, вызываемых
// из того же модуля расширения и ещё не унесённых хуком, добавляет обёртку
// &Вместо("Имя") с ПродолжитьВызов. Restored не меняет. Пишет wrappers_added.json.
//
// Параметры:
//   КаталогВыхода — папка с extension и restored; Префикс — префикс имён (УП_).
// Возвращаемое значение: Структура(count, items) — items: path, name.
Функция ОбработатьОбёрткиВместо(КаталогВыхода, Префикс = "УП_") Экспорт
	КРасш = ОбъединитьПути(КаталогВыхода, "extension");
	КВосст = ОбъединитьПути(КаталогВыхода, "restored");
	Рез = ДобавитьОбёрткиВместоПоВызовам(КРасш, КВосст, Префикс);
	ЗаписатьJsonЭкспорта(ОбъединитьПути(КаталогВыхода, "wrappers_added.json"), Рез);
	Возврат Рез;
КонецФункции

Функция ДобавитьОбёрткиВместоПоВызовам(КаталогРасш, КаталогВосст, Префикс)
	Рез = Новый Структура("count, items", 0, Новый Массив);
	Если Не (Новый Файл(КаталогРасш)).Существует() Или Не (Новый Файл(КаталогВосст)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Если Не СтрЗаканчиваетсяНа(Префикс, "_") И Префикс <> "" Тогда
		Префикс = Префикс + "_";
	КонецЕсли;
	Глоб = ИменаГлобальногоКонтекста();
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "*.bsl", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		ПутьВосст = ОбъединитьПути(КаталогВосст, Отн);
		Если Не (Новый Файл(ПутьВосст)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		ТекстРасш = ТекстМодуля(Ф.ПолноеИмя);
		ТекстВосст = ТекстМодуля(ПутьВосст);
		КартаРасш = КартаМетодовНРег(ТекстРасш);
		КартаВосст = КартаМетодовНРег(ТекстВосст);
		Если КартаВосст.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		РазМ = Разбор.РазобратьМодуль(ТекстРасш);
		Хуки = КартаХуковТиповых(РазМ);
		Нужные = Новый Соответствие;
		Для Каждого М Из РазМ.Методы Цикл
			Вызовы = ВсеВызовыИзТекста(М.Текст);
			Для Каждого КЗ Из Вызовы Цикл
				Ключ = НРег(КЗ.Ключ);
				Если Глоб.Получить(Ключ) = Истина Тогда
					Продолжить;
				КонецЕсли;
				Если КартаРасш.Получить(Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				МВосст = КартаВосст.Получить(Ключ);
				Если МВосст = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ЗаголовокСЭкспортом(МВосст.Текст) Тогда
					Продолжить;
				КонецЕсли;
				Если Хуки.Получить(Ключ) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если КартаРасш.Получить(НРег(Префикс + МВосст.Имя)) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Нужные.Вставить(Ключ, МВосст);
			КонецЦикла;
		КонецЦикла;
		Если Нужные.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Блоки = Новый Массив;
		Для Каждого КЗ Из Нужные Цикл
			МВосст = КЗ.Значение;
			ТекстОб = ТекстОбёрткиВместо(МВосст.Текст, МВосст.Имя, МВосст.Вид, Префикс);
			Если МВосст.Свойство("ОбёрткаНачало") И МВосст.ОбёрткаНачало <> "" Тогда
				ТекстОб = Разбор.ОбернутьТекстПрепроцессором(ТекстОб, МВосст.ОбёрткаНачало, МВосст.ОбёрткаКонец);
			КонецЕсли;
			Блоки.Добавить(ТекстОб);
			Рез.items.Добавить(Новый Структура("path, name", Отн, МВосст.Имя));
			Рез.count = Рез.count + 1;
		КонецЦикла;
		НовыйТекст = СокрП(ТекстРасш) + Символы.ПС + Символы.ПС + СтрСоединить(Блоки, Символы.ПС + Символы.ПС) + Символы.ПС;
		ЗаписатьТекстБезBOM(Ф.ПолноеИмя, НовыйТекст);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция КартаХуковТиповых(РазМ)
	Р = Новый Соответствие;
	Для Каждого М Из РазМ.Методы Цикл
		ИмяТип = ИмяТиповогоИзДирективыХука(М.Текст);
		Если ИмяТип <> "" Тогда
			Р.Вставить(НРег(ИмяТип), ИмяТип);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИмяТиповогоИзДирективыХука(ТекстМетода)
	Для Каждого Стр Из СтрРазделить(ТекстМетода, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Н = НРег(С);
		Если Не (СтрНачинаетсяС(Н, "&изменениеиконтроль") Или СтрНачинаетсяС(Н, "&перед")
			Или СтрНачинаетсяС(Н, "&после") Или СтрНачинаетсяС(Н, "&вместо")) Тогда
			Продолжить;
		КонецЕсли;
		П1 = СтрНайти(С, """");
		Если П1 = 0 Тогда
			Продолжить;
		КонецЕсли;
		П2 = СтрНайти(С, """", НаправлениеПоиска.СНачала, П1 + 1);
		Если П2 = 0 Тогда
			Продолжить;
		КонецЕсли;
		Возврат Сред(С, П1 + 1, П2 - П1 - 1);
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ТекстОбёрткиВместо(ТекстМетодаВосст, ИмяТип, Вид, Префикс)
	Дир = ДирективыВендора(ТекстМетодаВосст);
	Заг = ПереименоватьИмяВЗаголовке(ИзвлечьЗаголовокМетода(ТекстМетодаВосст, Вид, ИмяТип), ИмяТип, Префикс + ИмяТип);
	Имена = ИменаПараметровЗаголовка(Заг);
	Вызов = "ПродолжитьВызов(" + СтрСоединить(Имена, ", ") + ")";
	ЭтоФункция = (Вид = "Функция") Или СтрНачинаетсяС(НРег(СокрЛ(Заг)), "асинх функция") Или СтрНачинаетсяС(НРег(СокрЛ(Заг)), "функция ");
	Если ЭтоФункция Тогда
		Тело = Символы.Таб + "Возврат " + Вызов + ";";
		Конец = "КонецФункции";
	Иначе
		Тело = Символы.Таб + Вызов + ";";
		Конец = "КонецПроцедуры";
	КонецЕсли;
	Части = Новый Массив;
	Если Дир <> "" Тогда
		Части.Добавить(Дир);
	КонецЕсли;
	Части.Добавить("&Вместо(""" + ИмяТип + """)");
	Части.Добавить(Заг);
	Части.Добавить(Тело);
	Части.Добавить(Конец);
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

Функция ДирективыВендора(ТекстМетода)
	Рез = Новый Массив;
	Для Каждого Стр Из СтрРазделить(ТекстМетода, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если СтрНачинаетсяС(С, "&") Тогда
			Рез.Добавить(Стр);
		ИначеЕсли С = "" Тогда
			Если Рез.Количество() > 0 Тогда
				Рез.Добавить(Стр);
			КонецЕсли;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Пока Рез.Количество() > 0 И СокрЛП(Рез[Рез.Количество() - 1]) = "" Цикл
		Рез.Удалить(Рез.Количество() - 1);
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция ИзвлечьЗаголовокМетода(ТекстМетода, Вид, Имя)
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Если Разбор.РазобратьОбъявление(Строки[Й]) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Рез = Новый Массив;
		Глубина = 0;
		Для К = Й По Строки.Количество() - 1 Цикл
			Стр = Строки[К];
			Рез.Добавить(Стр);
			Чистая = Разбор.УбратьКомментарий(Стр);
			Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
			Если Глубина <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат СтрСоединить(Рез, Символы.ПС);
	КонецЦикла;
	Возврат Вид + " " + Имя + "()";
КонецФункции

Функция ПереименоватьИмяВЗаголовке(Знач Заголовок, Имя, НовоеИмя)
	Строки = СтрРазделить(Заголовок, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Если Разбор.РазобратьОбъявление(Строки[Й]) <> Неопределено Тогда
			Стр = Строки[Й];
			Скобка = СтрНайти(Стр, "(");
			Если Скобка = 0 Тогда
				Прервать;
			КонецЕсли;
			ДоСкобки = Лев(Стр, Скобка - 1);
			Поз = СтрНайти(НРег(ДоСкобки), НРег(Имя), НаправлениеПоиска.СКонца);
			Если Поз > 0 Тогда
				Строки[Й] = Лев(ДоСкобки, Поз - 1) + НовоеИмя + Сред(ДоСкобки, Поз + СтрДлина(Имя)) + Сред(Стр, Скобка);
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ИменаПараметровЗаголовка(Заголовок)
	Имена = Новый Массив;
	Склей = СтрЗаменить(Заголовок, Символы.ПС, " ");
	Индекс = ИндексКонцаЗаголовка(СтрРазделить(Заголовок, Символы.ПС, Истина));
	Если Индекс.Конец < 0 Тогда
		Возврат Имена;
	КонецЕсли;
	// Параметры между первой «(» заголовка и закрывающей.
	ПОткр = 0;
	Глубина = 0;
	ВСтроке = Ложь;
	Дл = СтрДлина(Склей);
	К = 1;
	Пока К <= Дл Цикл
		Сим = Сред(Склей, К, 1);
		Если Не ВСтроке Тогда
			Если Сим = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли Сим = "(" Тогда
				Глубина = Глубина + 1;
				Если Глубина = 1 И ПОткр = 0 Тогда
					ПОткр = К + 1;
				КонецЕсли;
			ИначеЕсли Сим = ")" Тогда
				Глубина = Глубина - 1;
				Если Глубина = 0 И ПОткр > 0 Тогда
					Внутри = Сред(Склей, ПОткр, К - ПОткр);
					РазбитьПараметрыВИмена(Внутри, Имена);
					Возврат Имена;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Сим = """" Тогда
			Если К < Дл И Сред(Склей, К + 1, 1) = """" Тогда
				К = К + 1;
			Иначе
				ВСтроке = Ложь;
			КонецЕсли;
		КонецЕсли;
		К = К + 1;
	КонецЦикла;
	Возврат Имена;
КонецФункции

Процедура РазбитьПараметрыВИмена(Внутри, Имена)
	Если СокрЛП(Внутри) = "" Тогда
		Возврат;
	КонецЕсли;
	Тек = "";
	Глубина = 0;
	ВСтроке = Ложь;
	Дл = СтрДлина(Внутри);
	К = 1;
	Пока К <= Дл Цикл
		Сим = Сред(Внутри, К, 1);
		Если Не ВСтроке Тогда
			Если Сим = """" Тогда
				ВСтроке = Истина;
				Тек = Тек + Сим;
			ИначеЕсли Сим = "(" Или Сим = "[" Тогда
				Глубина = Глубина + 1;
				Тек = Тек + Сим;
			ИначеЕсли Сим = ")" Или Сим = "]" Тогда
				Глубина = Глубина - 1;
				Тек = Тек + Сим;
			ИначеЕсли Сим = "," И Глубина = 0 Тогда
				ДобавитьИмяПараметра(Тек, Имена);
				Тек = "";
			Иначе
				Тек = Тек + Сим;
			КонецЕсли;
		Иначе
			Тек = Тек + Сим;
			Если Сим = """" Тогда
				Если К < Дл И Сред(Внутри, К + 1, 1) = """" Тогда
					К = К + 1;
					Тек = Тек + """";
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		К = К + 1;
	КонецЦикла;
	ДобавитьИмяПараметра(Тек, Имена);
КонецПроцедуры

Процедура ДобавитьИмяПараметра(Знач Фрагмент, Имена)
	Фрагмент = СокрЛП(Разбор.УбратьКомментарий(Фрагмент));
	Если Фрагмент = "" Тогда
		Возврат;
	КонецЕсли;
	ПозРавн = 0;
	ВСтроке = Ложь;
	Дл = СтрДлина(Фрагмент);
	К = 1;
	Пока К <= Дл Цикл
		Сим = Сред(Фрагмент, К, 1);
		Если Не ВСтроке Тогда
			Если Сим = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли Сим = "=" Тогда
				ПозРавн = К;
				Прервать;
			КонецЕсли;
		ИначеЕсли Сим = """" Тогда
			Если К < Дл И Сред(Фрагмент, К + 1, 1) = """" Тогда
				К = К + 1;
			Иначе
				ВСтроке = Ложь;
			КонецЕсли;
		КонецЕсли;
		К = К + 1;
	КонецЦикла;
	Если ПозРавн > 0 Тогда
		Фрагмент = СокрЛП(Лев(Фрагмент, ПозРавн - 1));
	КонецЕсли;
	Н = НРег(Фрагмент);
	Если СтрНачинаетсяС(Н, "знач ") Тогда
		Фрагмент = СокрЛП(Сред(Фрагмент, 6));
	КонецЕсли;
	// Имя — последнее слово (перед ним мог остаться тип/проход).
	Имя = Фрагмент;
	Пробел = 0;
	К = СтрДлина(Имя);
	Пока К > 0 Цикл
		Сим = Сред(Имя, К, 1);
		Если Сим = " " Или Сим = Символы.Таб Тогда
			Пробел = К;
			Прервать;
		КонецЕсли;
		К = К - 1;
	КонецЦикла;
	Если Пробел > 0 Тогда
		Имя = СокрЛП(Сред(Имя, Пробел + 1));
	КонецЕсли;
	Если Имя <> "" Тогда
		Имена.Добавить(Имя);
	КонецЕсли;
КонецПроцедуры