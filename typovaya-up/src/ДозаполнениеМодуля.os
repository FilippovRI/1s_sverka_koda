// Замыкание локальных вспомогательных методов для модулей расширения.

Перем Разбор;

Процедура Инициализировать(МодульРазбора) Экспорт
	Разбор = МодульРазбора;
КонецПроцедуры

Функция КлючевыеСлова() Экспорт
	Возврат Новый Соответствие;
КонецФункции

Функция СловарьКлючевыхСлов()
	Р = КлючевыеСлова();
	Если Р.Количество() > 0 Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого К Из СтрРазделить(
		"если,тогда,иначе,иначеесли,конецесли,для,каждого,из,по,цикл,конеццикла,пока,возврат,новый,не,и,или,"
		+ "попытка,исключение,конецпопытки,перем,знач,процедура,функция,конецпроцедуры,конецфункции,экспорт,"
		+ "прервать,продолжить,вызватьисключение,асинх,ждать,перейти,сообщить,описаниетипов,тип,неопределено,истина,ложь", ",") Цикл
		Р.Вставить(К, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КартаМетодов(ТекстМодуля)
	Р = Новый Соответствие;
	Если СокрЛП(ТекстМодуля) = "" Тогда
		Возврат Р;
	КонецЕсли;
	Раз = Разбор.РазобратьМодуль(ТекстМодуля);
	Для Каждого М Из Раз.Методы Цикл
		Р.Вставить(М.Имя, М);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЛокальныеВызовыИзТекста(Текст, ИменаМодуля)
	Рез = Новый Соответствие;
	Ключ = СловарьКлючевыхСлов();
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Код = Разбор.УбратьКомментарий(Стр);
		ДобавитьВызовыИзСтроки(Код, ИменаМодуля, Ключ, Рез);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ДобавитьВызовыИзСтроки(Код, ИменаМодуля, Ключ, Рез)
	Если СокрЛП(Код) = "" Тогда
		Возврат;
	КонецЕсли;
	Дл = СтрДлина(Код);
	П = 1;
	ВСтроке = Ложь;
	Пока П <= Дл Цикл
		С = Сред(Код, П, 1);
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ЭтоНачалоИдентификатора(С) Тогда
			Имя = ПрочитатьИдентификатор(Код, П);
			ПозПослеИмени = П + СтрДлина(Имя);
			ПСлед = ПозПослеИмени;
			Пока ПСлед <= Дл И (Сред(Код, ПСлед, 1) = " " Или Сред(Код, ПСлед, 1) = Символы.Таб) Цикл
				ПСлед = ПСлед + 1;
			КонецЦикла;
			Если ПСлед <= Дл И Сред(Код, ПСлед, 1) = "(" Тогда
				Пред = ?(П - СтрДлина(Имя) - 1 < 1, "", Сред(Код, П - СтрДлина(Имя) - 1, 1));
				Если Пред <> "." И Не Ключ.Получить(НРег(Имя)) = Истина Тогда
					Если ИменаМодуля.Получить(Имя) <> Неопределено Тогда
						Рез.Вставить(Имя, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			П = ПозПослеИмени;
			Продолжить;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоНачалоИдентификатора(С)
	К = КодСимвола(С);
	Возврат (К >= 1040 И К <= 1103) Или (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или С = "_";
КонецФункции

Функция ПрочитатьИдентификатор(Код, Поз)
	Дл = СтрДлина(Код);
	Р = "";
	Для Й = Поз По Дл Цикл
		С = Сред(Код, Й, 1);
		Если ЭтоНачалоИдентификатора(С) Или (С >= "0" И С <= "9") Тогда
			Р = Р + С;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИменаУжеЭмитированы(Выбранные, Префикс)
	Р = Новый Соответствие;
	Для Каждого Мт Из Выбранные Цикл
		Р.Вставить(Префикс + Мт.name, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстыТелДляАнализа(Выбранные)
	Ч = Новый Массив;
	Для Каждого Мт Из Выбранные Цикл
		Если Мт.status = "added" Тогда
			Ч.Добавить(Мт.sourceText);
		Иначе
			Ч.Добавить(Мт.hookBody);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

// Возвращает Структура(ДопМетоды, Переименования, СписокЛога, helpersCopied)
Функция ДозаполнитьВспомогательные(М, Выбранные, Префикс) Экспорт
	Рез = Новый Структура("ДопМетоды, Переименования, СписокЛога, helpersCopied",
		Новый Массив, Новый Соответствие, Новый Массив, 0);
	КартаИ = КартаМетодов(М.sourceText);
	КартаП = КартаМетодов(М.vendorText);
	Если КартаИ.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Уже = ИменаУжеЭмитированы(Выбранные, Префикс);
	Очередь = Новый Массив;
	ДобавитьВОчередь(ЛокальныеВызовыИзТекста(ТекстыТелДляАнализа(Выбранные), КартаИ), Очередь, Уже);
	Пока Очередь.Количество() > 0 Цикл
		Имя = Очередь[0];
		Очередь.Удалить(0);
		Если Уже.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Мет = КартаИ.Получить(Имя);
		Если Мет = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НовоеИмя = Имя;
		Если КартаП.Получить(Имя) <> Неопределено И Не СтрНачинаетсяС(Имя, Префикс) Тогда
			НовоеИмя = Префикс + Имя;
			Рез.Переименования.Вставить(Имя, НовоеИмя);
		КонецЕсли;
		Переим = Новый Соответствие;
		Если НовоеИмя <> Имя Тогда
			Переим.Вставить(Имя, НовоеИмя);
		КонецЕсли;
		ТекстМ = Мет.Текст;
		Если НовоеИмя <> Имя Тогда
			ТекстМ = ПереименоватьМетодВТексте(ТекстМ, Имя, НовоеИмя);
		КонецЕсли;
		Рез.ДопМетоды.Добавить(ТекстМ);
		Уже.Вставить(Имя, Истина);
		Уже.Вставить(НовоеИмя, Истина);
		Рез.СписокЛога.Добавить(?(НовоеИмя = Имя, Имя, Имя + "→" + НовоеИмя));
		Рез.helpersCopied = Рез.helpersCopied + 1;
		ДобавитьВОчередь(ЛокальныеВызовыИзТекста(Мет.Текст, КартаИ), Очередь, Уже);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ДобавитьВОчередь(Вызовы, Очередь, Уже)
	Для Каждого КЗ Из Вызовы Цикл
		Имя = КЗ.Ключ;
		Если Уже.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Очередь.Добавить(Имя);
	КонецЦикла;
КонецПроцедуры

Функция ПереименоватьМетодВТексте(Текст, Имя, НовоеИмя)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Если Разбор.РазобратьОбъявление(Строки[Й]) <> Неопределено Тогда
			Строки[Й] = ЗаменитьИмяВОбъявлении(Строки[Й], Имя, НовоеИмя);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Текст = СтрСоединить(Строки, Символы.ПС);
	П = Новый Соответствие;
	П.Вставить(Имя, НовоеИмя);
	Возврат ПереписатьЛокальныеВызовы(Текст, П);
КонецФункции

Функция ЗаменитьИмяВОбъявлении(Стр, Имя, НовоеИмя)
	Скобка = СтрНайти(Стр, "(");
	Если Скобка = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	До = Лев(Стр, Скобка - 1);
	Поз = СтрНайти(НРег(До), НРег(Имя), НаправлениеПоиска.СКонца);
	Если Поз > 0 Тогда
		Возврат Лев(До, Поз - 1) + НовоеИмя + Сред(До, Поз + СтрДлина(Имя)) + Сред(Стр, Скобка);
	КонецЕсли;
	Возврат Стр;
КонецФункции

Функция ПереписатьЛокальныеВызовы(Текст, Переименования) Экспорт
	Если Переименования.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Код = Разбор.УбратьКомментарий(Строки[Й]);
		Комм = "";
		П = СтрНайти(Строки[Й], "//");
		Если П > 0 Тогда
			Комм = Сред(Строки[Й], П);
			Код = Лев(Строки[Й], П - 1);
		КонецЕсли;
		Строки[Й] = ПереписатьВызовыВСтроке(Код, Переименования) + Комм;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ПереписатьВызовыВСтроке(Код, Переименования)
	Дл = СтрДлина(Код);
	Если Дл = 0 Тогда
		Возврат Код;
	КонецЕсли;
	Рез = "";
	П = 1;
	ВСтроке = Ложь;
	Пока П <= Дл Цикл
		С = Сред(Код, П, 1);
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
			Рез = Рез + С;
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ВСтроке Тогда
			Рез = Рез + С;
			П = П + 1;
			Продолжить;
		КонецЕсли;
		Если ЭтоНачалоИдентификатора(С) Тогда
			Имя = ПрочитатьИдентификатор(Код, П);
			Хвост = П + СтрДлина(Имя) - 1;
			ПСлед = Хвост + 1;
			Пока ПСлед <= Дл И (Сред(Код, ПСлед, 1) = " " Или Сред(Код, ПСлед, 1) = Символы.Таб) Цикл
				ПСлед = ПСлед + 1;
			КонецЦикла;
			Нов = Переименования.Получить(Имя);
			Если Нов <> Неопределено И ПСлед <= Дл И Сред(Код, ПСлед, 1) = "(" Тогда
				Пред = ?(П - 1 < 1, "", Сред(Код, П - 1, 1));
				Если Пред <> "." Тогда
					Рез = Рез + Нов;
					П = П + СтрДлина(Имя);
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Рез = Рез + Имя;
			П = П + СтрДлина(Имя);
			Продолжить;
		КонецЕсли;
		Рез = Рез + С;
		П = П + 1;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ВсеВызовыИзТекста(Текст) Экспорт
	Ключ = СловарьКлючевыхСлов();
	Рез = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		ДобавитьВсеВызовыИзСтроки(Разбор.УбратьКомментарий(Стр), Ключ, Рез);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ДобавитьВсеВызовыИзСтроки(Код, Ключ, Рез)
	Если СокрЛП(Код) = "" Тогда Возврат; КонецЕсли;
	Дл = СтрДлина(Код);
	П = 1;
	ВСтроке = Ложь;
	Пока П <= Дл Цикл
		С = Сред(Код, П, 1);
		Если С = """" Тогда ВСтроке = Не ВСтроке; П = П + 1; Продолжить; КонецЕсли;
		Если ВСтроке Тогда П = П + 1; Продолжить; КонецЕсли;
		Если ЭтоНачалоИдентификатора(С) Тогда
			Имя = ПрочитатьИдентификатор(Код, П);
			ПозПослеИмени = П + СтрДлина(Имя);
			ПСлед = ПозПослеИмени;
			Пока ПСлед <= Дл И (Сред(Код, ПСлед, 1) = " " Или Сред(Код, ПСлед, 1) = Символы.Таб) Цикл ПСлед = ПСлед + 1; КонецЦикла;
			Если ПСлед <= Дл И Сред(Код, ПСлед, 1) = "(" Тогда
				Пред = ?(П - 1 < 1, "", Сред(Код, П - 1, 1));
				Если Пред <> "." И Не Ключ.Получить(НРег(Имя)) = Истина Тогда
					Рез.Вставить(Имя, Истина);
				КонецЕсли;
			КонецЕсли;
			П = ПозПослеИмени;
			Продолжить;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
КонецПроцедуры

// Скан модуля: неэкспортные вызовы без определения в этом же файле.
Функция ПодсчитатьНеразрешённыеЛокальныеВызовы(ТекстМодуля) Экспорт
	Карта = КартаМетодов(ТекстМодуля);
	Всего = 0;
	Для Каждого КЗ Из Карта Цикл
		Выз = ВсеВызовыИзТекста(КЗ.Значение.Текст);
		Для Каждого В Из Выз Цикл
			Если Карта.Получить(В.Ключ) = Неопределено Тогда
				Всего = Всего + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Всего;
КонецФункции

Функция СканироватьКаталогРасширения(Корень) Экспорт
	Сумма = 0;
	Для Каждого Ф Из НайтиФайлы(Корень, "Module.bsl", Истина) Цикл
		Т = Новый ТекстовыйДокумент;
		Т.Прочитать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
		Сумма = Сумма + ПодсчитатьНеразрешённыеЛокальныеВызовы(Т.ПолучитьТекст());
	КонецЦикла;
	Возврат Сумма;
КонецФункции
