// Заимствованные формы: Form.xml = копия БП; отличия УП — программно в Module.bsl (ПриСозданииНаСервере).
// Собственные формы УП (нет в БП) в этот сценарий не попадают.

Перем Аф;
Перем Фр;
Перем Пер;

Функция ПодключитьМодули()
	К = ТекущийСценарий().Каталог;
	Если Аф = Неопределено Тогда
		Аф = ЗагрузитьСценарий(ОбъединитьПути(К, "АнализФорм.os"));
	КонецЕсли;
	Если Фр = Неопределено Тогда
		Фр = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыRestored.os"));
	КонецЕсли;
	Если Пер = Неопределено Тогда
		Пер = ЗагрузитьСценарий(ОбъединитьПути(К, "ПереносРеквизитовФормы.os"));
	КонецЕсли;
КонецФункции

// Тело заимствованной формы без слоёв УП — побайтово Form.xml БП/load-e.
Функция FormXmlЗаимствованнаяТолькоБп(ПутьБп) Экспорт
	ПодключитьМодули();
	Если ПутьБп = "" Или Не (Новый Файл(ПутьБп)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Фр.ПрочитатьТекстUtf8(ПутьБп);
КонецФункции

// Собственные формы УП (нет в БП) — полный Form.xml УП; иначе — валидная копия основания.
Функция ВыбратьТелоFormЗаимствованной(ПутьУп, ПутьОсн, ПутьБп) Экспорт
	ПодключитьМодули();
	Пв = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ПроверкаXmlForm.os"));
	ЕстьБп = ПутьБп <> "" И (Новый Файл(ПутьБп)).Существует();
	Если Не ЕстьБп И (Новый Файл(ПутьУп)).Существует() Тогда
		Возврат Фр.ПрочитатьТекстUtf8(ПутьУп);
	КонецЕсли;
	Канд = Новый Массив;
	Если ПутьОсн <> "" И (Новый Файл(ПутьОсн)).Существует() Тогда
		Канд.Добавить(ПутьОсн);
	КонецЕсли;
	Если ЕстьБп Тогда
		Канд.Добавить(ПутьБп);
	КонецЕсли;
	Для Каждого П Из Канд Цикл
		Т = Фр.ПрочитатьТекстUtf8(П);
		Если Т <> "" И Пв.ОшибкаСтруктурыXml(Т) = "" Тогда
			Возврат Т;
		КонецЕсли;
	КонецЦикла;
	Если (Новый Файл(ПутьУп)).Существует() Тогда
		Возврат Фр.ПрочитатьТекстUtf8(ПутьУп);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ИменаКомандВТексте(Текст)
	Рез = Новый Массив;
	Рв = Новый РегулярноеВыражение("<Command\s+name=""([^""]+)""");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Имя = С.Группы[1].Значение;
		Если Не СодержитСтроку(Рез, Имя) Тогда
			Рез.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция СодержитСтроку(М, З)
	Для Каждого Э Из М Цикл
		Если Э = З Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СписокV8Типов(Фраг)
	Рв = Новый РегулярноеВыражение("<v8:Type>\s*([^<]+)\s*</v8:Type>");
	Р = Новый Массив;
	Для Каждого С Из Рв.НайтиСовпадения(Фраг) Цикл
		Р.Добавить(СокрЛП(С.Группы[1].Значение));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОписаниеТиповИзФрагментаАтрибута(Фраг, Инфо)
	Типы = СписокV8Типов(Фраг);
	Если Типы.Количество() = 0 И Инфо <> Неопределено Тогда
		Типы.Добавить(Инфо.type);
	КонецЕсли;
	Если Типы.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Если Типы.Количество() > 1 Тогда
		Части = Новый Массив;
		Для Каждого Т Из Типы Цикл
			О = ОписаниеТиповИзОдногоТипа(Т, Фраг, Инфо);
			Если О <> "" Тогда
				Части.Добавить(О);
			КонецЕсли;
		КонецЦикла;
		Если Части.Количество() = 0 Тогда
			Возврат "";
		КонецЕсли;
		Возврат "Новый ОписаниеТипов(" + СтрСоединить(Части, ", ") + ")";
	КонецЕсли;
	Возврат ОписаниеТиповИзОдногоТипа(Типы[0], Фраг, Инфо);
КонецФункции

Функция ОписаниеТиповИзОдногоТипа(Т, Фраг, Инфо)
	Нт = НРег(Т);
	Если Нт = "xs:string" Или Нт = "xs:boolean" Тогда
		Возврат Пер.ФрагментОписаниеТипов(Инфо);
	ИначеЕсли Нт = "xs:decimal" Или Нт = "xs:double" Тогда
		Возврат "Новый ОписаниеТипов(""Число"")";
	ИначеЕсли Нт = "xs:dateTime" Тогда
		Возврат "Новый ОписаниеТипов(""Дата"")";
	ИначеЕсли Нт = "v8:uuid" Тогда
		Возврат "Новый ОписаниеТипов(""УникальныйИдентификатор"")";
	ИначеЕсли СтрНачинаетсяС(Нт, "cfg:") Тогда
		Возврат ОписаниеТиповИзCfg(Т);
	ИначеЕсли СтрНайти(Фраг, "ValueTable") > 0 Тогда
		Возврат "Новый ОписаниеТипов(""ТаблицаЗначений"")";
	ИначеЕсли СтрНайти(Фраг, "ValueList") > 0 Тогда
		Возврат "Новый ОписаниеТипов(""СписокЗначений"")";
	ИначеЕсли Нт = "cfg:dynamiclist" Тогда
		Возврат "Новый ОписаниеТипов(""ДинамическийСписок"")";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОписаниеТиповИзАтрибутаУп(ПутьУп, Имя) Экспорт
	ПодключитьМодули();
	ТУ = Фр.ПрочитатьТекстUtf8(ПутьУп);
	Фраг = ВырезатьАтрибут(ТУ, Имя);
	Если Фраг = "" Тогда
		Возврат Новый Структура("ok, expr, reason", Ложь, "", "нет блока Attribute в УП");
	КонецЕсли;
	Карта = Аф.КартаРеквизитовFormXml(ПутьУп);
	Инфо = Карта.Получить(Имя);
	Выраж = ОписаниеТиповИзФрагментаАтрибута(Фраг, Инфо);
	Если Выраж <> "" Тогда
		Возврат Новый Структура("ok, expr, reason", Истина, Выраж, "");
	КонецЕсли;
	Возврат Новый Структура("ok, expr, reason", Ложь, "", "тип не сопоставлен");
КонецФункции

Функция ОписаниеТиповИзCfg(ТипCfg)
	Т = Сред(ТипCfg, 5);
	Если СтрНачинаетсяС(Т, "CatalogRef.") Тогда
		Возврат "Новый ОписаниеТипов(""СправочникСсылка." + Сред(Т, 12) + """)";
	ИначеЕсли СтрНачинаетсяС(Т, "DocumentRef.") Тогда
		Возврат "Новый ОписаниеТипов(""ДокументСсылка." + Сред(Т, 13) + """)";
	ИначеЕсли СтрНачинаетсяС(Т, "EnumRef.") Тогда
		Возврат "Новый ОписаниеТипов(""ПеречислениеСсылка." + Сред(Т, 9) + """)";
	ИначеЕсли СтрНачинаетсяС(Т, "ChartOfAccountsRef.") Тогда
		Возврат "Новый ОписаниеТипов(""ПланСчетовСсылка." + Сред(Т, 18) + """)";
	ИначеЕсли Т = "DynamicList" Тогда
		Возврат "";
	ИначеЕсли Т = "boolean" Тогда
		Возврат "Новый ОписаниеТипов(""Булево"")";
	ИначеЕсли Т = "string" Тогда
		Возврат "Новый ОписаниеТипов(""Строка"")";
	КонецЕсли;
	Возврат "Новый ОписаниеТипов(""" + СтрЗаменить(Т, ".", "") + """)";
КонецФункции

Функция ВырезатьАтрибут(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Attribute>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция ЭкранРв(С)
	Возврат СтрЗаменить(С, ".", "\.");
КонецФункции

Функция ИменаЭлементовForm(Текст)
	Р = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("<([A-Za-z][\w]*)\s+[^>]*\bname=""([^""]+)""");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Р.Вставить(С.Группы[2].Значение, С.Группы[1].Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЭлементыТолькоВУп(ТУ, ТБ)
	У = ИменаЭлементовForm(ТУ);
	Б = ИменаЭлементовForm(ТБ);
	Р = Новый Массив;
	Для Каждого КЗ Из У Цикл
		Если Б.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Добавить(Новый Структура("name, tag", КЗ.Ключ, КЗ.Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТипЭлементаBsl(ИмяТега)
	Т = НРег(ИмяТега);
	Если Т = "table" Тогда
		Возврат "ТаблицаФормы";
	ИначеЕсли Т = "button" Тогда
		Возврат "КнопкаФормы";
	ИначеЕсли Т = "labelfield" Или Т = "labeldecoration" Тогда
		Возврат "ДекорацияФормы";
	ИначеЕсли Т = "usualgroup" Или Т = "formgroup" Или Т = "page" Или Т = "pages" Тогда
		Возврат "ГруппаФормы";
	КонецЕсли;
	Возврат "ПолеФормы";
КонецФункции

Функция ЭлементПередВУп(Текст, ИмяЭл)
	РвРод = Новый РегулярноеВыражение("(?s)<(UsualGroup|Table|FormGroup|Pages|Page|ChildItems)\b[^>]*>[\s\S]*?name=""" + ЭкранРв(ИмяЭл) + """");
	С = РвРод.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Поз = СтрНайти(Текст, С[0].Значение);
	Если Поз <= 1 Тогда
		Возврат "";
	КонецЕсли;
	До = Лев(Текст, Поз - 1);
	РвИм = Новый РегулярноеВыражение("\bname=""([^""]+)""");
	М = РвИм.НайтиСовпадения(До);
	Если М.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	ИмяПред = М[М.Количество() - 1].Группы[1].Значение;
	Если ИмяПред = ИмяЭл Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИмяПред;
КонецФункции

Функция РодительЭлементаИзУп(Текст, ИмяЭл)
	Рв = Новый РегулярноеВыражение("(?s)<(UsualGroup|Table|FormGroup|Pages|Page)\s+name=""([^""]+)""[^>]*>[\s\S]*?name=""" + ЭкранРв(ИмяЭл) + """");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() > 0 Тогда
		Возврат С[0].Группы[2].Значение;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция DataPathЭлемента(Текст, ИмяЭл)
	Рв = Новый РегулярноеВыражение("(?s)name=""" + ЭкранРв(ИмяЭл) + """[^>]*>[\s\S]*?<DataPath>([^<]*)</DataPath>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() > 0 Тогда
		Возврат СокрЛП(С[0].Группы[1].Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция БлокКоманды(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Command\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Command>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция ДействиеКоманды(Фраг)
	Рв = Новый РегулярноеВыражение("<Action>([^<]*)</Action>");
	С = Рв.НайтиСовпадения(Фраг);
	Если С.Количество() > 0 Тогда
		Возврат СокрЛП(С[0].Группы[1].Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЗаголовокКоманды(Фраг)
	Рв = Новый РегулярноеВыражение("<Title>[\s\S]*?<v8:content>([^<]*)</v8:content>");
	С = Рв.НайтиСовпадения(Фраг);
	Если С.Количество() > 0 Тогда
		Возврат СокрЛП(С[0].Группы[1].Значение);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СобратьПакетУп(ПутьУп, ПутьБп, Префикс = "УП_") Экспорт
	ПодключитьМодули();
	Пустой = Новый Структура("hasWork, code, unsupported, attrsOk, attrsFail, commands, ui", Ложь, "", Новый Массив, 0, 0, 0, Ложь);
	Если ПутьУп = "" Или Не (Новый Файл(ПутьУп)).Существует() Тогда
		Возврат Пустой;
	КонецЕсли;
	ТУ = Фр.ПрочитатьТекстUtf8(ПутьУп);
	ТБ = ?((Новый Файл(ПутьБп)).Существует(), Фр.ПрочитатьТекстUtf8(ПутьБп), "");
	КУ = Аф.КартаРеквизитовFormXml(ПутьУп);
	КБ = Аф.КартаРеквизитовFormXml(ПутьБп);
	ДобАтр = Аф.ИменаТолькоВПервой(КУ, КБ);
	КомУ = ИменаКомандВТексте(ТУ);
	КомБ = ИменаКомандВТексте(ТБ);
	ДобКом = Аф.РазницаСписков(КомУ, КомБ);
	УдАтр = Аф.ИменаТолькоВПервой(КБ, КУ);
	Изм = Аф.ОтличияОбщихРеквизитов(КУ, КБ);
	Ч = Новый Массив;
	Неподд = Новый Массив;
	Ч.Добавить("// typovaya-up: программный слой УП (diff UP vs BP Form.xml)");
	Ч.Добавить("");
	Ч.Добавить("&НаСервере");
	Ч.Добавить("Процедура " + Префикс + "СоздатьЭлементыУП()");
	Ч.Добавить("	ДобавляемыеРеквизиты = Новый Массив;");
	АтрОк = 0;
	АтрНет = 0;
	Для Каждого Имя Из ДобАтр Цикл
		ИмяРасш = ?(Префикс <> "" И Не СтрНачинаетсяС(Имя, Префикс), Префикс + Имя, Имя);
		Оц = ОписаниеТиповИзАтрибутаУп(ПутьУп, Имя);
		Если Оц.ok Тогда
			Ч.Добавить("	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(""" + ИмяРасш + """, " + Оц.expr + "));");
			АтрОк = АтрОк + 1;
		Иначе
			Неподд.Добавить("Attribute " + Имя + ": " + Оц.reason);
			АтрНет = АтрНет + 1;
		КонецЕсли;
	КонецЦикла;
	Если АтрОк > 0 Тогда
		Ч.Добавить("	Если ДобавляемыеРеквизиты.Количество() > 0 Тогда");
		Ч.Добавить("		ИзменитьРеквизиты(ДобавляемыеРеквизиты);");
		Ч.Добавить("	КонецЕсли;");
	КонецЕсли;
	Для Каждого ИмяКом Из ДобКом Цикл
		ФрК = БлокКоманды(ТУ, ИмяКом);
		ИмяРасшКом = ?(Префикс <> "" И Не СтрНачинаетсяС(ИмяКом, Префикс), Префикс + ИмяКом, ИмяКом);
		Действие = ДействиеКоманды(ФрК);
		Заг = ЗаголовокКоманды(ФрК);
		Ч.Добавить("	КомандаУп = Команды.Добавить(""" + ИмяРасшКом + """);");
		Если Заг <> "" Тогда
			Ч.Добавить("	КомандаУп.Заголовок = """ + СтрЗаменить(Заг, """", """""") + """;");
		КонецЕсли;
		Если Действие <> "" Тогда
			Ч.Добавить("	КомандаУп.УстановитьДействие(""" + Действие + """);");
		Иначе
			Ч.Добавить("	КомандаУп.УстановитьДействие(""" + Префикс + "ОбработкаКоманды_" + ИмяКом + """);");
			Неподд.Добавить("Command action " + ИмяКом);
		КонецЕсли;
	КонецЦикла;
	ЭлУп = ЭлементыТолькоВУп(ТУ, ТБ);
	UiDiff = ЭлУп.Количество() > 0;
	Для Каждого Э Из ЭлУп Цикл
		ИмяРасшЭ = ?(Префикс <> "" И Не СтрНачинаетсяС(Э.name, Префикс), Префикс + Э.name, Э.name);
		Род = РодительЭлементаИзУп(ТУ, Э.name);
		Дп = DataPathЭлемента(ТУ, Э.name);
		ТипЭ = ТипЭлементаBsl(Э.tag);
		Если Род = "" Тогда
			Ч.Добавить("	ЭлементУп = Элементы.Добавить(""" + ИмяРасшЭ + """, Тип(""" + ТипЭ + """));");
		Иначе
			Ч.Добавить("	ЭлементУп = Элементы.Добавить(""" + ИмяРасшЭ + """, Тип(""" + ТипЭ + """), Элементы." + Род + ");");
		КонецЕсли;
		Если Дп <> "" Тогда
			Ч.Добавить("	ЭлементУп.ПутьКДанным = """ + Дп + """;");
		КонецЕсли;
		Перед = ЭлементПередВУп(ТУ, Э.name);
		Если Род <> "" И Перед <> "" Тогда
			Ч.Добавить("	Элементы.Вставить(Элементы." + Род + ", Элементы." + Перед + ", """ + ИмяРасшЭ + """);");
		ИначеЕсли Род <> "" Тогда
			Ч.Добавить("	// ЭлементУп в конце группы " + Род);
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(ТУ, "ConditionalAppearance") > 0 И СтрНайти(ТБ, "ConditionalAppearance") = 0 Тогда
		Ч.Добавить("	" + Префикс + "ПрименитьУсловноеОформлениеУП();");
		Неподд.Добавить("ConditionalAppearance: см. " + Префикс + "ПрименитьУсловноеОформлениеУП");
	КонецЕсли;
	Для Каждого Имя Из УдАтр Цикл
		Неподд.Добавить("removed attribute " + Имя);
	КонецЦикла;
	Для Каждого Стр Из Изм Цикл
		Неподд.Добавить("changed " + Стр);
	КонецЦикла;
	Ч.Добавить("КонецПроцедуры");
	Если СтрНайти(ТУ, "ConditionalAppearance") > 0 И СтрНайти(ТБ, "ConditionalAppearance") = 0 Тогда
		Ч.Добавить("");
		Ч.Добавить("&НаСервере");
		Ч.Добавить("Процедура " + Префикс + "ПрименитьУсловноеОформлениеУП()");
		Ч.Добавить("	// TODO: перенести элементы ConditionalAppearance из Form.xml УП (макет dcscor/settings)");
		Ч.Добавить("	// ЭлементУО = УсловноеОформление.Элементы.Добавить();");
		Ч.Добавить("КонецПроцедуры");
	КонецЕсли;
	КодХук = Символы.ПС + "&НаСервере" + Символы.ПС
		+ "&После(""ПриСозданииНаСервере"")" + Символы.ПС
		+ "Процедура " + Префикс + "ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	" + Префикс + "СоздатьЭлементыУП();" + Символы.ПС
		+ "КонецПроцедуры";
	ЕстьРабота = ДобАтр.Количество() > 0 Или ДобКом.Количество() > 0 Или UiDiff Или Неподд.Количество() > 0;
	Код = ?(ЕстьРабота, СтрСоединить(Ч, Символы.ПС) + КодХук, "");
	Возврат Новый Структура("hasWork, code, unsupported, attrsOk, attrsFail, commands, ui",
		ЕстьРабота, Код, Неподд, АтрОк, АтрНет, ДобКом.Количество(), UiDiff);
КонецФункции

Функция ПутьМодуляФормыРасширения(КаталогРасш, ОтнFormXml)
	База = Лев(ОтнFormXml, СтрДлина(ОтнFormXml) - СтрДлина("Form.xml") - 1);
	Возврат ОбъединитьПути(КаталогРасш, База, "Form", "Module.bsl");
КонецФункции

Процедура ВшитьПрограммныйСлойВМодуль(ПутьМодуля, Пакет, Префикс) Экспорт
	ПодключитьМодули();
	Если Не Пакет.hasWork Или СокрЛП(Пакет.code) = "" Тогда
		Возврат;
	КонецЕсли;
	Текст = "";
	Если (Новый Файл(ПутьМодуля)).Существует() Тогда
		Текст = Фр.ПрочитатьТекстUtf8(ПутьМодуля);
	КонецЕсли;
	Маркер = "typovaya-up: программный слой УП";
	Если СтрНайти(Текст, Маркер) > 0 Тогда
		Рв = Новый РегулярноеВыражение("(?s)// typovaya-up: программный слой УП.*?КонецПроцедуры\r?\n&НаСервере\r?\n&После\(""ПриСозданииНаСервере""\).*?КонецПроцедуры");
		Текст = Рв.Заменить(Текст, "");
	КонецЕсли;
	Если СокрЛП(Текст) = "" Тогда
		Текст = "&НаСервере" + Символы.ПС + Символы.ПС;
	КонецЕсли;
	Текст = СокрП(Текст) + Символы.ПС + Символы.ПС + Пакет.code + Символы.ПС;
	СоздатьКаталог((Новый Файл(ПутьМодуля)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(ПутьМодуля);
КонецПроцедуры

Процедура ОбновитьФормуЗаимствованную(КаталогРасш, ОтнТела, ПутьУп, ПутьОсн, ПутьБп, Префикс, Стат) Экспорт
	ПодключитьМодули();
	Тело = ВыбратьТелоFormЗаимствованной(ПутьУп, ПутьОсн, ПутьБп);
	Если Тело = "" Тогда
		Возврат;
	КонецЕсли;
	Тело = Фр.ПодготовитьFormXmlКIbcmd(Тело);
	ЗаписатьПуть = ОбъединитьПути(КаталогРасш, ОтнТела);
	СоздатьКаталог((Новый Файл(ЗаписатьПуть)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Истина).Записать(ЗаписатьПуть);
	Стат.forms = Стат.forms + 1;
	ПбДифф = ?((Новый Файл(ПутьБп)).Существует(), ПутьБп, ПутьОсн);
	Пакет = СобратьПакетУп(ПутьУп, ПбДифф, Префикс);
	Если Пакет.hasWork Тогда
		Стат.programmatic = Стат.programmatic + 1;
		ВшитьПрограммныйСлойВМодуль(ПутьМодуляФормыРасширения(КаталогРасш, ОтнТела), Пакет, Префикс);
	КонецЕсли;
	Если Пакет.unsupported.Количество() > 0 Тогда
		Стат.unsupportedNotes.Добавить(Новый Структура("form, items", ОтнТела, Пакет.unsupported));
	КонецЕсли;
КонецПроцедуры