// Заимствованные формы: Form.xml = копия БП; отличия УП — программно в Module.bsl (ПриСозданииНаСервере).
// Собственные формы УП (нет в БП) в этот сценарий не попадают.

Перем Аф;
Перем Фр;
Перем Пер;

Функция ПодключитьМодули()
	К = ТекущийСценарий().Каталог;
	Если Аф = Неопределено Тогда
		Аф = ЗагрузитьСценарий(ОбъединитьПути(К, "АнализФорм.os"));
	КонецЕсли;
	Если Фр = Неопределено Тогда
		Фр = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыRestored.os"));
	КонецЕсли;
	Если Пер = Неопределено Тогда
		Пер = ЗагрузитьСценарий(ОбъединитьПути(К, "ПереносРеквизитовФормы.os"));
	КонецЕсли;
КонецФункции

// Тело заимствованной формы без слоёв УП — побайтово Form.xml БП/load-e.
Функция FormXmlЗаимствованнаяТолькоБп(ПутьБп) Экспорт
	ПодключитьМодули();
	Если ПутьБп = "" Или Не (Новый Файл(ПутьБп)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Возврат Фр.ПрочитатьТекстUtf8(ПутьБп);
КонецФункции

// Собственные формы УП (нет в БП) — полный Form.xml УП; иначе — валидная копия основания.
Функция ВыбратьТелоFormЗаимствованной(ПутьУп, ПутьОсн, ПутьБп) Экспорт
	ПодключитьМодули();
	Пв = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ПроверкаXmlForm.os"));
	ЕстьБп = ПутьБп <> "" И (Новый Файл(ПутьБп)).Существует();
	Если Не ЕстьБп И (Новый Файл(ПутьУп)).Существует() Тогда
		Возврат Фр.ПрочитатьТекстUtf8(ПутьУп);
	КонецЕсли;
	Канд = Новый Массив;
	Если ПутьОсн <> "" И (Новый Файл(ПутьОсн)).Существует() Тогда
		Канд.Добавить(ПутьОсн);
	КонецЕсли;
	Если ЕстьБп Тогда
		Канд.Добавить(ПутьБп);
	КонецЕсли;
	Для Каждого П Из Канд Цикл
		Т = Фр.ПрочитатьТекстUtf8(П);
		Если Т <> "" И Пв.ОшибкаСтруктурыXml(Т) = "" Тогда
			Возврат Т;
		КонецЕсли;
	КонецЦикла;
	Если (Новый Файл(ПутьУп)).Существует() Тогда
		Возврат Фр.ПрочитатьТекстUtf8(ПутьУп);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ИменаКомандВТексте(Текст)
	Рез = Новый Массив;
	Рв = Новый РегулярноеВыражение("<Command\s+name=""([^""]+)""");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Имя = С.Группы[1].Значение;
		Если Не СодержитСтроку(Рез, Имя) Тогда
			Рез.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция СодержитСтроку(М, З)
	Для Каждого Э Из М Цикл
		Если Э = З Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ОписаниеТиповИзАтрибутаУп(ПутьУп, Имя) Экспорт
	ПодключитьМодули();
	ТУ = Фр.ПрочитатьТекстUtf8(ПутьУп);
	Фраг = ВырезатьАтрибут(ТУ, Имя);
	Если Фраг = "" Тогда
		Возврат Новый Структура("ok, expr, reason", Ложь, "", "нет блока Attribute в УП");
	КонецЕсли;
	Карта = Аф.КартаРеквизитовFormXml(ПутьУп);
	Инфо = Карта.Получить(Имя);
	Если Инфо = Неопределено Тогда
		Возврат Новый Структура("ok, expr, reason", Ложь, "", "нет в карте реквизитов");
	КонецЕсли;
	Т = НРег(Инфо.type);
	Если Т = "xs:string" Или Т = "xs:boolean" Тогда
		Возврат Новый Структура("ok, expr, reason", Истина, Пер.ФрагментОписаниеТипов(Инфо), "");
	КонецЕсли;
	Если СтрНачинаетсяС(Т, "cfg:") Тогда
		Выраж = ОписаниеТиповИзCfg(Т);
		Если Выраж <> "" Тогда
			Возврат Новый Структура("ok, expr, reason", Истина, Выраж, "");
		КонецЕсли;
	КонецЕсли;
	Если СтрНайти(Фраг, "ValueTable") > 0 Или СтрНайти(Фраг, "DynamicList") > 0 Или СтрНайти(Фраг, "ValueList") > 0 Тогда
		Возврат Новый Структура("ok, expr, reason", Ложь, "", "сложный тип " + Инфо.type);
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("(?s)<v8:Type>\s*([^<]+)\s*</v8:Type>");
	Если Рв.НайтиСовпадения(Фраг).Количество() > 1 Тогда
		Возврат Новый Структура("ok, expr, reason", Ложь, "", "составной Type");
	КонецЕсли;
	Возврат Новый Структура("ok, expr, reason", Ложь, "", "тип " + Инфо.type);
КонецФункции

Функция ОписаниеТиповИзCfg(ТипCfg)
	Т = Сред(ТипCfg, 5);
	Если СтрНачинаетсяС(Т, "CatalogRef.") Тогда
		Возврат "Новый ОписаниеТипов(""СправочникСсылка." + Сред(Т, 12) + """)";
	ИначеЕсли СтрНачинаетсяС(Т, "DocumentRef.") Тогда
		Возврат "Новый ОписаниеТипов(""ДокументСсылка." + Сред(Т, 13) + """)";
	ИначеЕсли СтрНачинаетсяС(Т, "EnumRef.") Тогда
		Возврат "Новый ОписаниеТипов(""ПеречислениеСсылка." + Сред(Т, 9) + """)";
	ИначеЕсли СтрНачинаетсяС(Т, "ChartOfAccountsRef.") Тогда
		Возврат "Новый ОписаниеТипов(""ПланСчетовСсылка." + Сред(Т, 18) + """)";
	ИначеЕсли Т = "DynamicList" Тогда
		Возврат "";
	ИначеЕсли Т = "boolean" Тогда
		Возврат "Новый ОписаниеТипов(""Булево"")";
	ИначеЕсли Т = "string" Тогда
		Возврат "Новый ОписаниеТипов(""Строка"")";
	КонецЕсли;
	Возврат "Новый ОписаниеТипов(""" + СтрЗаменить(Т, ".", "") + """)";
КонецФункции

Функция ВырезатьАтрибут(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Attribute>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция ЭкранРв(С)
	Возврат СтрЗаменить(С, ".", "\.");
КонецФункции

Функция СобратьПакетУп(ПутьУп, ПутьБп, Префикс = "УП_") Экспорт
	ПодключитьМодули();
	Пустой = Новый Структура("hasWork, code, unsupported, attrsOk, attrsFail, commands, ui", Ложь, "", Новый Массив, 0, 0, 0, Ложь);
	Если ПутьУп = "" Или ПутьБп = "" Тогда
		Возврат Пустой;
	КонецЕсли;
	ТУ = Фр.ПрочитатьТекстUtf8(ПутьУп);
	ТБ = Фр.ПрочитатьТекстUtf8(ПутьБп);
	КУ = Аф.КартаРеквизитовFormXml(ПутьУп);
	КБ = Аф.КартаРеквизитовFormXml(ПутьБп);
	ДобАтр = Аф.ИменаТолькоВПервой(КУ, КБ);
	КомУ = ИменаКомандВТексте(ТУ);
	КомБ = ИменаКомандВТексте(ТБ);
	ДобКом = Аф.РазницаСписков(КомУ, КомБ);
	УдАтр = Аф.ИменаТолькоВПервой(КБ, КУ);
	Изм = Аф.ОтличияОбщихРеквизитов(КУ, КБ);
	Ч = Новый Массив;
	Неподд = Новый Массив;
	Ч.Добавить("// typovaya-up: программный слой УП (diff UP vs BP Form.xml)");
	Ч.Добавить("");
	Ч.Добавить("&НаСервере");
	Ч.Добавить("Процедура " + Префикс + "СоздатьЭлементыУП()");
	Ч.Добавить("	// Реквизиты, команды и элементы УП, отсутствующие в Form.xml БП.");
	АтрОк = 0;
	АтрНет = 0;
	Для Каждого Имя Из ДобАтр Цикл
		ИмяРасш = ?(Префикс <> "" И Не СтрНачинаетсяС(Имя, Префикс), Префикс + Имя, Имя);
		Оц = ОписаниеТиповИзАтрибутаУп(ПутьУп, Имя);
		Если Оц.ok Тогда
			Ч.Добавить("	НовРек = Новый РеквизитФормы(""" + ИмяРасш + """, " + Оц.expr + ");");
			Ч.Добавить("	ДобавляемыеРеквизиты = Новый Массив;");
			Ч.Добавить("	ДобавляемыеРеквизиты.Добавить(НовРек);");
			Ч.Добавить("	ИзменитьРеквизиты(ДобавляемыеРеквизиты);");
			АтрОк = АтрОк + 1;
		Иначе
			Неподд.Добавить("Attribute " + Имя + ": " + Оц.reason);
			АтрНет = АтрНет + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяКом Из ДобКом Цикл
		Ч.Добавить("	// Команда УП: " + ИмяКом + " — требуется Commands.Add и SetAction (не сгенерировано)");
		Неподд.Добавить("Command " + ИмяКом);
	КонецЦикла;
	Если ДобКом.Количество() > 0 Тогда
		Ч.Добавить("	// TODO: ThisForm.Commands.Add(...);");
	КонецЕсли;
	БлокУ = СтрНайти(ТУ, "<ChildItems>");
	БлокБ = СтрНайти(ТБ, "<ChildItems>");
	UiDiff = Ложь;
	Если БлокУ > 0 Или БлокБ > 0 Тогда
		ФУ = ?(БлокУ > 0, Сред(ТУ, БлокУ, 5000), "");
		ФБ = ?(БлокБ > 0, Сред(ТБ, БлокБ, 5000), "");
		UiDiff = ФУ <> ФБ;
	КонецЕсли;
	Если UiDiff Тогда
		Ч.Добавить("	// TODO: Items.Add для элементов УП (раскладка ChildItems) — см. forms_programmatic.json");
		Неподд.Добавить("ChildItems/layout");
	КонецЕсли;
	Если СтрНайти(ТУ, "ConditionalAppearance") > 0 И СтрНайти(ТБ, "ConditionalAppearance") = 0 Тогда
		Неподд.Добавить("ConditionalAppearance");
	КонецЕсли;
	Для Каждого Имя Из УдАтр Цикл
		Неподд.Добавить("removed attribute " + Имя);
	КонецЦикла;
	Для Каждого Стр Из Изм Цикл
		Неподд.Добавить("changed " + Стр);
	КонецЦикла;
	Ч.Добавить("КонецПроцедуры");
	КодХук = Символы.ПС + "&НаСервере" + Символы.ПС
		+ "&После(""ПриСозданииНаСервере"")" + Символы.ПС
		+ "Процедура " + Префикс + "ПослеПриСозданииНаСервере(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	" + Префикс + "СоздатьЭлементыУП();" + Символы.ПС
		+ "КонецПроцедуры";
	ЕстьРабота = ДобАтр.Количество() > 0 Или ДобКом.Количество() > 0 Или UiDiff Или Неподд.Количество() > 0;
	Код = ?(ЕстьРабота, СтрСоединить(Ч, Символы.ПС) + КодХук, "");
	Возврат Новый Структура("hasWork, code, unsupported, attrsOk, attrsFail, commands, ui",
		ЕстьРабота, Код, Неподд, АтрОк, АтрНет, ДобКом.Количество(), UiDiff);
КонецФункции

Функция ПутьМодуляФормыРасширения(КаталогРасш, ОтнFormXml)
	База = Лев(ОтнFormXml, СтрДлина(ОтнFormXml) - СтрДлина("Form.xml") - 1);
	Возврат ОбъединитьПути(КаталогРасш, База, "Form", "Module.bsl");
КонецФункции

Процедура ВшитьПрограммныйСлойВМодуль(ПутьМодуля, Пакет, Префикс) Экспорт
	ПодключитьМодули();
	Если Не Пакет.hasWork Или СокрЛП(Пакет.code) = "" Тогда
		Возврат;
	КонецЕсли;
	Текст = "";
	Если (Новый Файл(ПутьМодуля)).Существует() Тогда
		Текст = Фр.ПрочитатьТекстUtf8(ПутьМодуля);
	КонецЕсли;
	Маркер = "typovaya-up: программный слой УП";
	Если СтрНайти(Текст, Маркер) > 0 Тогда
		Рв = Новый РегулярноеВыражение("(?s)// typovaya-up: программный слой УП.*?КонецПроцедуры\r?\n&НаСервере\r?\n&После\(""ПриСозданииНаСервере""\).*?КонецПроцедуры");
		Текст = Рв.Заменить(Текст, "");
	КонецЕсли;
	Если СокрЛП(Текст) = "" Тогда
		Текст = "&НаСервере" + Символы.ПС + Символы.ПС;
	КонецЕсли;
	Текст = СокрП(Текст) + Символы.ПС + Символы.ПС + Пакет.code + Символы.ПС;
	СоздатьКаталог((Новый Файл(ПутьМодуля)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(ПутьМодуля);
КонецПроцедуры

Процедура ОбновитьФормуЗаимствованную(КаталогРасш, ОтнТела, ПутьУп, ПутьОсн, ПутьБп, Префикс, Стат) Экспорт
	ПодключитьМодули();
	Тело = ВыбратьТелоFormЗаимствованной(ПутьУп, ПутьОсн, ПутьБп);
	Если Тело = "" Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьПуть = ОбъединитьПути(КаталогРасш, ОтнТела);
	СоздатьКаталог((Новый Файл(ЗаписатьПуть)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Тело, КодировкаТекста.UTF8, Истина).Записать(ЗаписатьПуть);
	Стат.forms = Стат.forms + 1;
	Пакет = СобратьПакетУп(ПутьУп, ПутьБп, Префикс);
	Если Пакет.hasWork Тогда
		Стат.programmatic = Стат.programmatic + 1;
		ВшитьПрограммныйСлойВМодуль(ПутьМодуляФормыРасширения(КаталогРасш, ОтнТела), Пакет, Префикс);
	КонецЕсли;
	Если Пакет.unsupported.Количество() > 0 Тогда
		Стат.unsupportedNotes.Добавить(Новый Структура("form, items", ОтнТела, Пакет.unsupported));
	КонецЕсли;
КонецПроцедуры