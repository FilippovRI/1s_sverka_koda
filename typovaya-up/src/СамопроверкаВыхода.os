// Офлайн-самопроверка каталога результата (категории как при разборе типичных ошибок ibcmd/Конфигуратор).

Перем Разбор;
Перем Дозаполнение;
Перем Синтез;
Перем МсСинтаксиса; // замер последней проверки bsparser, мс

// Подключает зависимости самопроверки (разбор методов, дозаполнение, синтез ИК).
Процедура Инициализировать(МодульРазбора, МодульДозаполнения, МодульСинтеза) Экспорт
	Разбор = МодульРазбора;
	Дозаполнение = МодульДозаполнения;
	Синтез = МодульСинтеза;
КонецПроцедуры

// Офлайн-проверка каталога результата; пишет категории как при типичных ошибках загрузки.
//
// Параметры:
//   КаталогВыхода — папка с extension/ и restored/;
//   Модули, Сводка — результат сравнения и сводка отчёта;
//   КореньИсходной — выгрузка УП (эталон ClassId); пустая строка → платформенный набор;
//   ПараметрыСинтаксиса — Структура(enabled, limit) или Неопределено (синтаксис включён, лимит 0).
//
// Возвращаемое значение:
//   Структура ok, categories[] (id, ok, count, detail, samples) — в т.ч. invalid_class_id,
//   duplicate_method_definitions, syntax_errors, cac_vs_main.
Функция ПроверитьКаталогВыхода(КаталогВыхода, Модули, Сводка, КореньИсходной = "", ПараметрыСинтаксиса = Неопределено) Экспорт
	КатРасш = ОбъединитьПути(КаталогВыхода, "extension");
	КатВосст = ОбъединитьПути(КаталогВыхода, "restored");
	Р = Новый Структура("ok, categories", Истина, Новый Массив);
	ДобавитьКатегорию(Р, ПроверитьЛокальныеВызовы(КатРасш));
	ДобавитьКатегорию(Р, ПроверитьЦелостностьИк(Модули));
	ДобавитьКатегорию(Р, ПроверитьИкПротивОсновной(КаталогВыхода));
	ДобавитьКатегорию(Р, ПроверитьСинтетическиеUuid(КатРасш));
	ДобавитьКатегорию(Р, ПроверитьClassId(КатРасш, КореньИсходной));
	ДобавитьКатегорию(Р, ПроверитьПовторыМетодов(КатРасш, КатВосст));
	ДобавитьКатегорию(Р, ПроверитьСинтаксис(КатРасш, КатВосст, ПараметрыСинтаксиса));
	ДобавитьКатегорию(Р, ПроверитьВосстановленныеВызовы(Модули, КатВосст));
	ДобавитьКатегорию(Р, ПроверитьКорзины(Сводка));
	Возврат Р;
КонецФункции

Процедура ДобавитьКатегорию(Р, Кат)
	Р.categories.Добавить(Кат);
	Если Не Кат.ok Тогда
		Р.ok = Ложь;
	КонецЕсли;
КонецПроцедуры

Функция ПроверитьЛокальныеВызовы(КатРасш)
	Ск = Новый Структура("count, samples", 0, Новый Массив);
	Если (Новый Файл(КатРасш)).Существует() И Дозаполнение <> Неопределено Тогда
		Ск = Дозаполнение.СканироватьКаталогРасширенияПодробно(КатРасш);
	КонецЕсли;
	Возврат Новый Структура("id, ok, count, detail, samples",
		"extension_unresolved_local_calls", Ск.count = 0, Ск.count,
		"Неразрешённые локальные вызовы в extension/*.bsl (без глобального контекста bsparser)", Ск.samples);
КонецФункции

// Эталон ClassId корневой Configuration (платформенные константы; ObjectId менять можно, ClassId — нет).
//
// Возвращаемое значение:
//   Массив строк UUID (нижний регистр не нормализуется здесь — сравнение идёт через ClassIdИзФайла).
Функция ПлатформенныеClassIdКонфигурации() Экспорт
	Возврат СтрРазделить("9cd510cd-abfc-11d4-9434-004095e12fc7,9fcd25a0-4822-11d4-9414-008048da11f9,"
		+ "e3687481-0a87-462c-a166-9f34594f9bba,9de14907-ec23-4a07-96f0-85521cb6b53b,"
		+ "51f2d5d8-ea4d-4064-8892-82951750031e,e68182ea-4237-4383-967f-90c1e3370bc7,"
		+ "fb282519-d103-4dd3-bc12-cb271d631dfc", ",");
КонецФункции

// Читает значения <xr:ClassId> из XML.
//
// Параметры:
//   Путь — полный путь к Configuration.xml (или другому XML с ClassId).
//
// Возвращаемое значение:
//   Массив строк (нижний регистр); пустой — файла нет или ClassId не указаны.
Функция ClassIdИзФайла(Путь) Экспорт
	Рез = Новый Массив;
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Для Каждого Стр Из СтрРазделить(Т.ПолучитьТекст(), Символы.ПС, Ложь) Цикл
		Нач = СтрНайти(Стр, "ClassId>");
		Если Нач = 0 Или СтрНайти(Стр, "</") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Хвост = Сред(Стр, Нач + 8);
		Кон = СтрНайти(Хвост, "<");
		Если Кон > 1 Тогда
			Рез.Добавить(НРег(СокрЛП(Лев(Хвост, Кон - 1))));
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Сверяет ClassId extension/Configuration.xml с эталоном.
//
// Параметры:
//   КатРасш — каталог extension; КореньИсходной — выгрузка УП (эталон) или "".
//
// Возвращаемое значение:
//   Категория self_check: id=invalid_class_id, samples — чужие ClassId.
Функция ПроверитьClassId(КатРасш, КореньИсходной = "") Экспорт
	Эталон = Новый Соответствие;
	Источник = "platform";
	Если КореньИсходной <> "" Тогда
		Для Каждого Ид Из ClassIdИзФайла(ОбъединитьПути(КореньИсходной, "Configuration.xml")) Цикл
			Эталон.Вставить(Ид, Истина);
			Источник = "source";
		КонецЦикла;
	КонецЕсли;
	Если Эталон.Количество() = 0 Тогда
		Для Каждого Ид Из ПлатформенныеClassIdКонфигурации() Цикл
			Эталон.Вставить(Ид, Истина);
		КонецЦикла;
	КонецЕсли;
	Образцы = Новый Массив;
	Для Каждого Ид Из ClassIdИзФайла(ОбъединитьПути(КатРасш, "Configuration.xml")) Цикл
		Если Эталон.Получить(Ид) = Неопределено Тогда
			Образцы.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("id, ok, count, detail, samples",
		"invalid_class_id", Образцы.Количество() = 0, Образцы.Количество(),
		"ClassId в extension/Configuration.xml вне эталона (" + Источник + ")", Образцы);
КонецФункции

// Ищет повторные объявления одного метода в файле (extension и restored).
//
// Параметры:
//   КатРасш, КатВосст — каталоги с *.bsl (отсутствующий каталог пропускается).
//
// Возвращаемое значение:
//   Категория self_check: id=duplicate_method_definitions.
Функция ПроверитьПовторыМетодов(КатРасш, КатВосст) Экспорт
	Число = 0;
	Образцы = Новый Массив;
	Для Каждого Корень Из СтрРазделить(КатРасш + Символы.ПС + КатВосст, Символы.ПС) Цикл
		Если Не (Новый Файл(Корень)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Корень, "*.bsl", Истина) Цикл
			Т = Новый ТекстовыйДокумент;
			Т.Прочитать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
			Видели = Новый Соответствие;
			Для Каждого Мт Из Разбор.РазобратьМодуль(Т.ПолучитьТекст()).Методы Цикл
				Ключ = НРег(Мт.Имя);
				Если Видели.Получить(Ключ) = Неопределено Тогда
					Видели.Вставить(Ключ, Истина);
					Продолжить;
				КонецЕсли;
				Число = Число + 1;
				Если Образцы.Количество() < 20 Тогда
					Образцы.Добавить(Сред(Ф.ПолноеИмя, СтрДлина(Корень) - СтрДлина((Новый Файл(Корень)).Имя) + 1) + ": " + Мт.Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("id, ok, count, detail, samples",
		"duplicate_method_definitions", Число = 0, Число, "Повторное объявление метода в модуле", Образцы);
КонецФункции

// Длительность последней синтаксической проверки, мс (0 — не выполнялась).
Функция МсСинтаксиса() Экспорт
	Возврат ?(МсСинтаксиса = Неопределено, 0, МсСинтаксиса);
КонецФункции

// Синтаксический разбор модулей extension и restored через vendored bsparser.
//
// Параметры:
//   КатРасш, КатВосст — каталоги; Параметры — Структура(enabled, limit) или Неопределено.
//
// Возвращаемое значение:
//   Категория self_check: id=syntax_errors; при enabled=Ложь — ok без проверки.
Функция ПроверитьСинтаксис(КатРасш, КатВосст, Параметры) Экспорт
	Вкл = Параметры = Неопределено Или Параметры.enabled;
	Лимит = ?(Параметры = Неопределено, 0, Параметры.limit);
	Если Не Вкл Тогда
		Возврат Новый Структура("id, ok, count, detail, samples",
			"syntax_errors", Истина, 0, "Отключено (--без-синтаксиса)", Новый Массив);
	КонецЕсли;
	Каталоги = Новый Массив;
	Каталоги.Добавить(КатРасш);
	Каталоги.Добавить(КатВосст);
	С = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "СинтаксисBsl.os"));
	Р = С.ПроверитьКаталоги(Каталоги, Лимит);
	МсСинтаксиса = Р.ms;
	Подробно = "bsparser: файлов " + Р.files + ", проверено " + Р.checked + ", пропущено " + Р.skipped
		+ ", мс " + Р.ms + ?(Р.available, "", " (парсер недоступен)");
	Возврат Новый Структура("id, ok, count, detail, samples",
		"syntax_errors", Р.errors = 0, Р.errors, Подробно, Р.samples);
КонецФункции

Функция ПроверитьЦелостностьИк(Модули)
	Сломано = 0;
	Для Каждого М Из Модули Цикл
		Для Каждого Мт Из М.methods Цикл
			Если Мт.hook <> "changeAndControl" Или СокрЛП(Мт.hookBody) = "" Тогда
				Продолжить;
			КонецЕсли;
			Если Синтез <> Неопределено И Не Синтез.ПроверитьЦелостностьТелаИк(Мт.hookBody) Тогда
				Сломано = Сломано + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("id, ok, count, detail",
		"cac_statement_integrity", Сломано = 0, Сломано,
		"Тела &ИзменениеИКонтроль с маркером внутри оператора");
КонецФункции

// Сверка как при применимости в 1С: для каждого &ИзменениеИКонтроль в extension типовой текст,
// восстановленный из хука (без #Вставка и строк директив), должен дословно совпасть с методом
// основной конфигурации. Основная — <выход>\restored этого же прогона (каждый модуль extension
// пишется в restored вместе с ним); up-typical не используется: он собирается после генерации
// и в повторном --выход может остаться от прошлого прогона. Нет модуля или метода — ошибка.
// Сравнение без учёта CR в концах строк; пробелы и табуляция учитываются.
Функция ПроверитьИкПротивОсновной(КаталогВыхода)
	КатРасш = ОбъединитьПути(КаталогВыхода, "extension");
	КатОсн = ОбъединитьПути(КаталогВыхода, "restored");
	Ошибок = 0;
	Проверено = 0;
	Образцы = Новый Массив;
	Если (Новый Файл(КатРасш)).Существует() И Синтез <> Неопределено Тогда
		Для Каждого Ф Из НайтиФайлы(КатРасш, "*.bsl", Истина) Цикл
			ПутьОсн = ОбъединитьПути(КатОсн, Сред(Ф.ПолноеИмя, СтрДлина(КатРасш) + 2));
			Р = СверитьМодульИк(ПрочитатьТекстФайла(Ф.ПолноеИмя), ПутьОсн);
			Проверено = Проверено + Р.checked;
			Ошибок = Ошибок + Р.Имена.Количество();
			Для Каждого Имя Из Р.Имена Цикл
				Если Образцы.Количество() < 20 Тогда
					Образцы.Добавить(Сред(Ф.ПолноеИмя, СтрДлина(КатРасш) + 2) + ": " + Имя);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("id, ok, count, detail, samples",
		"cac_vs_main", Ошибок = 0, Ошибок,
		"&ИзменениеИКонтроль: типовой текст из хука не совпал с методом основной ("
			+ (Новый Файл(КатОсн)).Имя + "), проверено " + Проверено, Образцы);
КонецФункции

// Сверяет методы &ИзменениеИКонтроль текста расширения с файлом основной конфигурации.
//
// Параметры:
//   ТекстРасш — текст модуля extension; ПутьОсн — путь к модулю основной конфигурации.
//
// Возвращаемое значение:
//   Структура checked (Число), Имена (Массив базовых имён без совпадения, в т.ч. «нет метода/модуля»).
Функция СверитьМодульИк(ТекстРасш, ПутьОсн) Экспорт
	Р = Новый Структура("checked, Имена", 0, Новый Массив);
	ЕстьМодуль = (Новый Файл(ПутьОсн)).Существует();
	ТекстОсн = ?(ЕстьМодуль, ПрочитатьТекстФайла(ПутьОсн), Неопределено);
	МетодыОсн = Новый Соответствие;
	Если ТекстОсн <> Неопределено Тогда
		Для Каждого Мт Из Разбор.РазобратьМодуль(ТекстОсн).Методы Цикл
			МетодыОсн.Вставить(Мт.Ключ, Мт);
		КонецЦикла;
	КонецЕсли;
	Для Каждого Мт Из Разбор.РазобратьМодуль(ТекстРасш).Методы Цикл
		Базовое = БазовоеИмяИк(Мт.Текст);
		Если Базовое = "" Тогда
			Продолжить;
		КонецЕсли;
		Р.checked = Р.checked + 1;
		Осн = МетодыОсн.Получить(НРег(Базовое));
		Если Осн = Неопределено Тогда
			Р.Имена.Добавить(Базовое + ?(ЕстьМодуль, " (нет метода в основной)", " (нет модуля в основной)"));
			Продолжить;
		КонецЕсли;
		Хук = ЧастиМетода(Мт.Текст);
		Тип = ЧастиМетода(Осн.Текст);
		Заголовок = СтрЗаменить(Хук.Заголовок, Мт.Имя + "(", Базовое + "(");
		Если Заголовок <> Тип.Заголовок Или Синтез.ВосстановитьБазовыйТекстТиповогоИзХука(Хук.Тело) <> Тип.Тело Тогда
			Р.Имена.Добавить(Базовое);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПрочитатьТекстФайла(Путь)
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат СтрЗаменить(Т.ПолучитьТекст(), Символы.ВК, "");
КонецФункции

// Имя из &ИзменениеИКонтроль("Имя") в аннотациях метода или пустая строка.
Функция БазовоеИмяИк(ТекстМетода)
	Для Каждого Стр Из СтрРазделить(ТекстМетода, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если Лев(С, 1) <> "&" Тогда
			Прервать;
		КонецЕсли;
		Если СтрНачинаетсяС(НРег(С), "&изменениеиконтроль") Тогда
			Ч = СтрРазделить(С, """");
			Возврат ?(Ч.Количество() >= 3, Ч[1], "");
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Заголовок (строки объявления до закрывающей скобки параметров, без аннотаций) и тело метода.
Функция ЧастиМетода(ТекстМетода)
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	Нач = 0;
	Пока Нач < Строки.Количество() И Лев(СокрЛП(Строки[Нач]), 1) = "&" Цикл
		Нач = Нач + 1;
	КонецЦикла;
	Кон = Нач;
	Глубина = 0;
	БылаСкобка = Ложь;
	Для Й = Нач По Строки.Количество() - 1 Цикл
		Чистая = Разбор.УбратьКомментарий(Строки[Й]);
		БылаСкобка = БылаСкобка Или СтрНайти(Чистая, "(") > 0;
		Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
		Кон = Й;
		Если БылаСкобка И Глубина <= 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Заг = Новый Массив;
	Для Й = Нач По Кон Цикл
		Заг.Добавить(Строки[Й]);
	КонецЦикла;
	Тело = Новый Массив;
	Для Й = Кон + 1 По Строки.Количество() - 2 Цикл
		Тело.Добавить(Строки[Й]);
	КонецЦикла;
	Возврат Новый Структура("Заголовок, Тело", СтрСоединить(Заг, Символы.ПС), СтрСоединить(Тело, Символы.ПС));
КонецФункции

Функция ПроверитьСинтетическиеUuid(КатРасш)
	Число = 0;
	Если (Новый Файл(КатРасш)).Существует() Тогда
		Для Каждого Ф Из НайтиФайлы(КатРасш, "*.xml", Истина) Цикл
			Т = Новый ТекстовыйДокумент;
			Т.Прочитать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
			Число = Число + СтрЧислоВхождений(Т.ПолучитьТекст(), "e1000001-");
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("id, ok, count, detail",
		"synthetic_configuration_uuid", Число = 0, Число,
		"Шаблонные e1000001-* в XML черновика (нужна подстановка InternalInfo)");
КонецФункции

Функция ПроверитьВосстановленныеВызовы(Модули, КатВосст)
	Проблемы = 0;
	Если Дозаполнение = Неопределено Или Не (Новый Файл(КатВосст)).Существует() Тогда
		Возврат Новый Структура("id, ok, count, detail",
			"restored_vendor_method_calls", Истина, 0, "Вызовы удалённых в УП методов в restored");
	КонецЕсли;
	Для Каждого М Из Модули Цикл
		Путь = ОбъединитьПути(КатВосст, СтрЗаменить(М.path, "\", ПолучитьРазделительПути()));
		Если Не (Новый Файл(Путь)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Т = Новый ТекстовыйДокумент;
		Т.Прочитать(Путь, КодировкаТекста.UTF8);
		Текст = Т.ПолучитьТекст();
		Вызовы = Дозаполнение.ВсеВызовыИзТекста(Текст);
		РазборМ = Разбор.РазобратьМодуль(Текст);
		Имена = Новый Соответствие;
		Для Каждого Мт Из РазборМ.Методы Цикл
			Имена.Вставить(НРег(Мт.Имя), Истина);
		КонецЦикла;
		Для Каждого Мт Из М.methods Цикл
			Если Мт.status <> "removed" Тогда
				Продолжить;
			КонецЕсли;
			Если Вызовы.Получить(Мт.name) <> Неопределено И Имена.Получить(НРег(Мт.name)) = Неопределено Тогда
				Проблемы = Проблемы + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("id, ok, count, detail",
		"restored_vendor_method_calls", Проблемы = 0, Проблемы,
		"Вызов без тела удалённого в УП метода в restored");
КонецФункции

Функция ПроверитьКорзины(Сводка)
	Ручн = 0;
	Если Сводка <> Неопределено И Сводка.Свойство("counts") Тогда
		Ручн = Сводка.counts.manual;
	КонецЕсли;
	Возврат Новый Структура("id, ok, count, detail",
		"manual_bucket_modules", Истина, Ручн,
		"Модулей в корзине manual (ожидается ручной разбор)");
КонецФункции
