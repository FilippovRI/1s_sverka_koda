// Заимствование реквизитов/значений перечислений/типов, на которые ссылаются динамические списки
// СОБСТВЕННЫХ форм расширения (перенесённых из УП). Конфигуратор проверяет запрос и пути данных
// списка по метаданным расширения: неперечисленный в расширении реквизит заимствованного объекта
// даёт «Неверный путь к данным Список.Поле». Работает по файлам каталога extension (генератор и
// исправление готового выхода на месте). Исходная выгрузка только читается.

Перем ДС;
Перем Ч;
Перем КэшИсх;
Перем Корни; // Неопределено — КореньИсходной; иначе массив корней основной конфигурации (по порядку)

Функция Ид()
	Возврат "[\wЁё]+";
КонецФункции

Функция ТипыРусАнгл()
	Р = Новый Соответствие;
	Пары = СтрРазделить("справочник=Catalog,документ=Document,журналдокументов=DocumentJournal,перечисление=Enum,"
		+ "регистрсведений=InformationRegister,регистрнакопления=AccumulationRegister,регистрбухгалтерии=AccountingRegister,"
		+ "регистррасчета=CalculationRegister,плансчетов=ChartOfAccounts,планвидовхарактеристик=ChartOfCharacteristicTypes,"
		+ "планвидоврасчета=ChartOfCalculationTypes,планобмена=ExchangePlan,бизнеспроцесс=BusinessProcess,задача=Task,"
		+ "константа=Constant", ",");
	Для Каждого П Из Пары Цикл
		Ч2 = СтрРазделить(П, "=");
		Р.Вставить(Ч2[0], Ч2[1]);
		Р.Вставить(НРег(Ч2[1]), Ч2[1]);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПапкаТипа(Тип) Экспорт
	Если Тип = "ChartOfCharacteristicTypes" Тогда
		Возврат "ChartsOfCharacteristicTypes";
	ИначеЕсли Тип = "ChartOfAccounts" Тогда
		Возврат "ChartsOfAccounts";
	ИначеЕсли Тип = "ChartOfCalculationTypes" Тогда
		Возврат "ChartsOfCalculationTypes";
	ИначеЕсли Тип = "BusinessProcess" Тогда
		Возврат "BusinessProcesses";
	КонецЕсли;
	Возврат Тип + "s";
КонецФункции

Функция КартаИменСтандартныхРеквизитов()
	Р = Новый Соответствие;
	Пары = СтрРазделить("номер=Number,number=Number,дата=Date,date=Date,проведен=Posted,posted=Posted,"
		+ "ref=Ref,ссылка=Ref,code=Code,код=Code,description=Description,наименование=Description,"
		+ "owner=Owner,владелец=Owner,parent=Parent,родитель=Parent,deletionmark=DeletionMark,пометкаудаления=DeletionMark,"
		+ "isfolder=IsFolder,этогруппа=IsFolder,defaultpicture=DefaultPicture", ",");
	Для Каждого П Из Пары Цикл
		Ч2 = СтрРазделить(П, "=");
		Р.Вставить(Ч2[0], Ч2[1]);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИмяСтандартногоРеквизита(ИмяПоля)
	Возврат КартаИменСтандартныхРеквизитов().Получить(НРег(ИмяПоля));
КонецФункции

Функция ТипXmlСтандартногоРеквизита(ТипМета, ИмяСт, ИмяОбъекта)
	Если ИмяСт = "Number" Тогда
		Возврат "<Type><v8:Type>xs:string</v8:Type><v8:StringQualifiers><v8:Length>11</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers></Type>";
	ИначеЕсли ИмяСт = "Date" Тогда
		Возврат "<Type><v8:Type>xs:dateTime</v8:Type><v8:DateQualifiers><v8:DateFractions>DateTime</v8:DateFractions></v8:DateQualifiers></Type>";
	ИначеЕсли ИмяСт = "Posted" Или ИмяСт = "DeletionMark" Или ИмяСт = "IsFolder" Тогда
		Возврат "<Type><v8:Type>xs:boolean</v8:Type></Type>";
	ИначеЕсли ИмяСт = "Ref" Тогда
		Возврат "<Type><v8:Type>cfg:" + ТипМета + "Ref." + ИмяОбъекта + "</v8:Type></Type>";
	ИначеЕсли ИмяСт = "Code" Или ИмяСт = "Description" Тогда
		Возврат "<Type><v8:Type>xs:string</v8:Type><v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers></Type>";
	ИначеЕсли ИмяСт = "Parent" Тогда
		Возврат "<Type><v8:Type>cfg:" + ТипМета + "Ref." + ИмяОбъекта + "</v8:Type></Type>";
	ИначеЕсли ИмяСт = "Owner" Тогда
		Влад = ИмяОбъекта;
		Если ИмяОбъекта = "ДоговорыКонтрагентов" Тогда
			Влад = "Контрагенты";
		КонецЕсли;
		Возврат "<Type><v8:Type>cfg:CatalogRef." + Влад + "</v8:Type></Type>";
	ИначеЕсли ИмяСт = "DefaultPicture" Тогда
		Возврат "<Type><v8:Type>v8ui:Picture</v8:Type></Type>";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция Стандартные()
	Р = Новый Соответствие;
	Для Каждого С Из СтрРазделить("ссылка,пометкаудаления,код,наименование,родитель,владелец,этогруппа,предопределенный,"
		+ "имяпредопределенныхданных,дата,номер,проведен,период,регистратор,номерстроки,активность,виддвижения,порядок,"
		+ "моментвремени,представление,версияданных,типзначения,ref,deletionmark,code,description,parent,owner,isfolder,"
		+ "predefined,predefineddataname,date,number,posted,period,recorder,linenumber,active,recordtype,order,pointintime,"
		+ "presentation,dataversion,valuetype,стартован,завершен,ведущаязадача,выполнена,бизнеспроцесс,точкамаршрута,"
		+ "started,completed,headtask,executed,businessprocess,routepoint,defaultpicture", ",") Цикл
		Р.Вставить(С, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ВиртуальныеТаблицы()
	Р = Новый Соответствие;
	Для Каждого С Из СтрРазделить("срезпоследних,срезпервых,остатки,обороты,остаткииобороты,движенияссубконто,оборотыдткт,"
		+ "субконто,базарасчетов,графикрасчета,данныеграфика,фактическийпериоддействия,"
		+ "slicelast,slicefirst,balance,turnovers,balanceandturnovers,recordswithextdimensions,drcrturnovers", ",") Цикл
		Р.Вставить(С, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстБезЛитералов(Знач Т)
	Рв = Новый РегулярноеВыражение("//[^\n]*|""[^""]*""");
	Возврат Рв.Заменить(Т, " ");
КонецФункции

Функция Разэкранировать(Знач Т)
	Т = СтрЗаменить(Т, "&lt;", "<");
	Т = СтрЗаменить(Т, "&gt;", ">");
	Т = СтрЗаменить(Т, "&quot;", """");
	Возврат СтрЗаменить(Т, "&amp;", "&");
КонецФункции

Функция ПрочитатьТекст(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), "UTF-8");
	Если Лев(Т, 1) = Символ(65279) Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	Возврат СтрЗаменить(Т, Символы.ВК, "");
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
	Ф = Новый Файл(Путь);
	БылBOM = Ложь;
	Если Ф.Существует() Тогда
		Ст = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), "UTF-8");
		БылBOM = Лев(Ст, 1) = Символ(65279);
	КонецЕсли;
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, БылBOM).Записать(Путь);
КонецПроцедуры

// Дочерние реквизиты XML объекта (без реквизитов табличных частей).
// Соответствие нрег(имя) -> Структура(Вид, Имя, Uuid, ТипXml).
Функция ДетиТекста(Текст) Экспорт
	Р = Новый Соответствие;
	БезТЧ = (Новый РегулярноеВыражение("<TabularSection uuid=""[^""]*"">[\s\S]*?</TabularSection>")).Заменить(Текст, "");
	Рв = Новый РегулярноеВыражение("<(Attribute|Dimension|Resource|EnumValue|AccountingFlag|ExtDimensionAccountingFlag) uuid=""([^""]+)"">([\s\S]*?)</\1>");
	РвИмя = Новый РегулярноеВыражение("<Name>([^<]*)</Name>");
	РвТип = Новый РегулярноеВыражение("<Type>[\s\S]*?</Type>|<Type/>");
	Для Каждого С Из Рв.НайтиСовпадения(БезТЧ) Цикл
		Тело = С.Группы[3].Значение;
		СИ = РвИмя.НайтиСовпадения(Тело);
		Если СИ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		СТ = РвТип.НайтиСовпадения(Тело);
		Р.Вставить(НРег(СИ[0].Группы[1].Значение), Новый Структура("Вид, Имя, Uuid, ТипXml", С.Группы[1].Значение,
			СИ[0].Группы[1].Значение, С.Группы[2].Значение, ?(СТ.Количество() = 0, "", СТ[0].Значение)));
	КонецЦикла;
	// табличные части верхнего уровня (заимствуются без реквизитов: модулю объекта нужно только имя ТЧ)
	РвТЧ = Новый РегулярноеВыражение("<TabularSection uuid=""([^""]+)"">[\s\S]*?<Properties>[\s\S]*?<Name>([^<]*)</Name>");
	Для Каждого С Из РвТЧ.НайтиСовпадения(Текст) Цикл
		Если Р.Получить(НРег(С.Группы[2].Значение)) = Неопределено Тогда
			Р.Вставить(НРег(С.Группы[2].Значение), Новый Структура("Вид, Имя, Uuid, ТипXml", "TabularSection",
				С.Группы[2].Значение, С.Группы[1].Значение, ""));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Описание объекта исходной выгрузки или Неопределено.
Функция Источник(КореньИсходной, Тип, Имя)
	Ключ = Тип + "." + Имя;
	Р = КэшИсх.Получить(Ключ);
	Если Р <> Неопределено Тогда
		Возврат ?(Р = Ложь, Неопределено, Р);
	КонецЕсли;
	Т = Неопределено;
	Список = Корни;
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Список.Добавить(КореньИсходной);
	КонецЕсли;
	Для Каждого Кор Из Список Цикл
		Путь = ОбъединитьПути(Кор, ПапкаТипа(Тип), Имя + ".xml");
		Т = ПрочитатьТекст(Путь);
		Если Т <> Неопределено Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Т = Неопределено Тогда
		КэшИсх.Вставить(Ключ, Ложь);
		Возврат Неопределено;
	КонецЕсли;
	СУ = (Новый РегулярноеВыражение("<" + Тип + " uuid=""([^""]+)""")).НайтиСовпадения(Т);
	Р = Новый Структура("Путь, Uuid, Дети", Путь, ?(СУ.Количество() = 0, "", СУ[0].Группы[1].Значение), ДетиТекста(Т));
	КэшИсх.Вставить(Ключ, Р);
	Возврат Р;
КонецФункции

// Объекты метаданных, на которые ссылается тип реквизита. Массив Структура(Тип, Имя).
Функция ТипыИзТипаXml(ТипXml) Экспорт
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("cfg:(Catalog|Document|Enum|ChartOfCharacteristicTypes|ChartOfAccounts|ChartOfCalculationTypes|BusinessProcess|Task|ExchangePlan)Ref\.([\wЁё]+)|cfg:DefinedType\.([\wЁё]+)");
	Для Каждого С Из Рв.НайтиСовпадения(ТипXml) Цикл
		Если С.Группы[3].Значение <> "" Тогда
			Р.Добавить(Новый Структура("Тип, Имя", "DefinedType", С.Группы[3].Значение));
		Иначе
			Р.Добавить(Новый Структура("Тип, Имя", С.Группы[1].Значение, С.Группы[2].Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция Потребность(П, Тип, Имя)
	Ключ = Тип + "." + Имя;
	Н = П.Получить(Ключ);
	Если Н = Неопределено Тогда
		Н = Новый Структура("Тип, Имя, Поля, Источники", Тип, Имя, Новый Соответствие, Новый Массив);
		П.Вставить(Ключ, Н);
	КонецЕсли;
	Возврат Н;
КонецФункции

Процедура ДобавитьПоле(П, Тип, Имя, Поле, Метка, Виды = "")
	Н = Потребность(П, Тип, Имя);
	Если Поле <> "" И Н.Поля.Получить(НРег(Поле)) = Неопределено Тогда
		Н.Поля.Вставить(НРег(Поле), Новый Структура("Имя, Метка, Виды", Поле, Метка, Виды));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьЗаметку(Заметки, Было, Текст)
	Если Было.Получить(Текст) = Неопределено Тогда
		Было.Вставить(Текст, Истина);
		Заметки.Добавить(Текст);
	КонецЕсли;
КонецПроцедуры

// Разбор запроса динамического списка: объекты, поля по псевдонимам (в т.ч. через разыменование), значения перечислений.
Процедура РазобратьЗапрос(Знач Текст, КореньИсходной, П, Метка, Заметки, Было, Предопр = Неопределено, ПутьФормы = "", ИмяСписка = "")
	Т = ТекстБезЛитералов(Разэкранировать(Текст));
	РА = ТипыРусАнгл();
	Вирт = ВиртуальныеТаблицы();
	Типы = "Справочник|Документ|ЖурналДокументов|Перечисление|РегистрСведений|РегистрНакопления|РегистрБухгалтерии|РегистрРасчета|ПланСчетов|ПланВидовХарактеристик|ПланВидовРасчета|ПланОбмена|БизнесПроцесс|Задача|Константа|Catalog|Document|DocumentJournal|Enum|InformationRegister|AccumulationRegister|AccountingRegister|CalculationRegister|ChartOfAccounts|ChartOfCharacteristicTypes|ChartOfCalculationTypes|ExchangePlan|BusinessProcess|Task|Constant";
	Рв = Новый РегулярноеВыражение("(ЗНАЧЕНИЕ\s*\(\s*|VALUE\s*\(\s*)?(?<![\wЁё.&])(" + Типы + ")\.(" + Ид() + ")((?:\.(?:" + Ид() + "))*)(\s*\((?:[^()]|\([^()]*\))*\))?(\s+(?:КАК|AS)\s+(" + Ид() + "))?");
	Рв.ИгнорироватьРегистр = Истина;
	Псевд = Новый Соответствие;
	Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
		ВЗначении = С.Группы[1].Значение <> "";
		Тип = РА.Получить(НРег(С.Группы[2].Значение));
		Имя = С.Группы[3].Значение;
		Хвост = Сред(С.Группы[4].Значение, 2);
		Потребность(П, Тип, Имя);
		Сегм = ?(Хвост = "", Новый Массив, СтрРазделить(Хвост, "."));
		Если Тип = "Enum" И Сегм.Количество() > 0 Тогда
			Если НРег(Сегм[0]) <> "пустаяссылка" И НРег(Сегм[0]) <> "emptyref" Тогда
				ДобавитьПоле(П, Тип, Имя, Сегм[0], Метка);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ВЗначении И Сегм.Количество() > 0 Тогда
			Если НРег(Сегм[0]) <> "пустаяссылка" И НРег(Сегм[0]) <> "emptyref" Тогда
				Если Предопр <> Неопределено Тогда
					Предопр.Добавить(Новый Структура("Форма, Список, ВидРус, Имя, Элемент",
						ПутьФормы, ИмяСписка, С.Группы[2].Значение, Имя, Сегм[0]));
				Иначе
					ДобавитьЗаметку(Заметки, Было, Метка + ": предопределённое " + Тип + "." + Имя + "." + Сегм[0] + " в запросе");
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Псевдоним = С.Группы[7].Значение;
		Если Псевдоним = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Сегм.Количество() = 0 Или Вирт.Получить(НРег(Сегм[0])) <> Неопределено Тогда
			Псевд.Вставить(НРег(Псевдоним), Новый Структура("Тип, Имя", Тип, Имя));
		Иначе
			ДобавитьЗаметку(Заметки, Было, Метка + ": табличная часть " + Тип + "." + Имя + "." + Хвост + " — поля не заимствуются автоматически");
		КонецЕсли;
	КонецЦикла;
	Если Псевд.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	РвП = Новый РегулярноеВыражение("(?<![\wЁё.&])(" + Ид() + ")((?:\.(?:" + Ид() + "))+)");
	Для Каждого С Из РвП.НайтиСовпадения(Т) Цикл
		Ст = Псевд.Получить(НРег(С.Группы[1].Значение));
		Если Ст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Сегм = СтрРазделить(Сред(С.Группы[2].Значение, 2), ".");
		ТекТип = Ст.Тип;
		ТекИмя = Ст.Имя;
		Для Й = 0 По Сегм.ВГраница() Цикл
			ДобавитьПоле(П, ТекТип, ТекИмя, Сегм[Й], Метка);
			Если Й = Сегм.ВГраница() Тогда
				Прервать;
			КонецЕсли;
			Ист = Источник(КореньИсходной, ТекТип, ТекИмя);
			Если Ист = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Реб = Ист.Дети.Получить(НРег(Сегм[Й]));
			Если Реб = Неопределено Тогда
				Прервать;
			КонецЕсли;
			Сс = ТипыИзТипаXml(Реб.ТипXml);
			Если Сс.Количество() <> 1 Или Сс[0].Тип = "DefinedType" Тогда
				Прервать;
			КонецЕсли;
			ТекТип = Сс[0].Тип;
			ТекИмя = Сс[0].Имя;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Имена реквизитов формы (уровня формы) с типом ТипXml.
Функция РеквизитыТипа(Текст, ТипXml)
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("\n\t\t<Attribute name=""([^""]*)"" id=""[^""]*"">([\s\S]*?)\n\t\t</Attribute>");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Если СтрНайти(С.Группы[2].Значение, "<v8:Type>" + ТипXml + "</v8:Type>") > 0 Тогда
			Р.Добавить(С.Группы[1].Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Потребности собственных форм расширения с динамическими списками.
// Структура(Потребности: Соответствие "Тип.Имя" -> Структура(Тип, Имя, Поля), Формы: Массив путей, Заметки: Массив).
Функция СобратьПотребности(КаталогРасш, КореньИсходной) Экспорт
	П = Новый Соответствие;
	Предопр = Новый Массив;
	Формы = Новый Массив;
	Заметки = Новый Массив;
	Было = Новый Соответствие;
	РА = ТипыРусАнгл();
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "Form.xml", Истина) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Или СтрНайти(Т, "<BaseForm") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		// реквизит формы типа НаборКонстант: пути Набор.Константа требуют заимствованной константы
		Для Каждого ИмяН Из РеквизитыТипа(Т, "cfg:ConstantsSet") Цикл
			РвК = Новый РегулярноеВыражение(">(?:Items\.)?" + ИмяН + "\.([\wЁё]+)<");
			Для Каждого СК Из РвК.НайтиСовпадения(Т) Цикл
				Потребность(П, "Constant", СК.Группы[1].Значение);
				Если Формы.Найти(Отн) = Неопределено Тогда
					Формы.Добавить(Отн);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если СтрНайти(Т, "xsi:type=""DynamicList""") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Списки = ДС.СпискиФормы(Т);
		Если Списки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Формы.Найти(Отн) = Неопределено Тогда
			Формы.Добавить(Отн);
		КонецЕсли;
		Для Каждого КЗ Из Списки Цикл
			С = КЗ.Значение;
			Метка = Отн + " " + КЗ.Ключ;
			Если С.manual Тогда
				РазобратьЗапрос(С.text, КореньИсходной, П, Метка, Заметки, Было, Предопр, Ф.ПолноеИмя, КЗ.Ключ);
			ИначеЕсли С.mainTable <> "" И СтрНайти(С.mainTable, ".") > 0 Тогда
				Поз = СтрНайти(С.mainTable, ".");
				Тип = РА.Получить(НРег(Лев(С.mainTable, Поз - 1)));
				Если Тип = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Имя = Сред(С.mainTable, Поз + 1);
				Потребность(П, Тип, Имя);
				Для Каждого Поле Из ДС.ПутиСписка(Т, КЗ.Ключ) Цикл
					ДобавитьПоле(П, Тип, Имя, Поле, Метка);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	СобратьПотребностиЗаимствованныхФорм(КаталогРасш, КореньИсходной, П, Формы, Заметки, Было, Предопр);
	СобратьПотребностиDataPathФорм(КаталогРасш, П, Формы);
	Возврат Новый Структура("Потребности, Формы, Заметки, Предопр", П, Формы, Заметки, Предопр);
КонецФункции

// Пути Объект.*/Отчет.* на всех Form.xml (в т.ч. чистая копия БП без BaseForm).
Процедура СобратьПотребностиDataPathФорм(КаталогРасш, П, Формы)
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "Form.xml", Истина) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Или СтрНайти(Т, "<BaseForm") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		Мета = ТипИмяМетаданныхФормы(Отн);
		Если Мета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РвГл = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]*)""[^>]*>.*?<MainAttribute>true</MainAttribute>");
		Для Каждого СГ Из РвГл.НайтиСовпадения(Т) Цикл
			ИмяГл = СГ.Группы[1].Значение;
			РвП = Новый РегулярноеВыражение("<DataPath>" + ИмяГл + "\.([\wЁёА-Яа-я]+)(?:\.([\wЁёА-Яа-я]+))?</DataPath>");
			Для Каждого СП Из РвП.НайтиСовпадения(Т) Цикл
				Если СП.Группы[2].Значение = "" Тогда
					ДобавитьПоле(П, Мета.Тип, Мета.Имя, СП.Группы[1].Значение, Отн);
				Иначе
					ДобавитьПоле(П, Мета.Тип, Мета.Имя, СП.Группы[1].Значение + "." + СП.Группы[2].Значение, Отн);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		РвО = Новый РегулярноеВыражение("<DataPath>Объект\.([\wЁёА-Яа-я]+)(?:\.([\wЁёА-Яа-я]+)|\[0\]\.([\wЁёА-Яа-я]+))?</DataPath>");
		Для Каждого СО Из РвО.НайтиСовпадения(Т) Цикл
			Им1 = СО.Группы[1].Значение;
			Им2 = ?(СО.Группы[2].Значение <> "", СО.Группы[2].Значение, СО.Группы[3].Значение);
			Если Им2 = "" Тогда
				ДобавитьПоле(П, Мета.Тип, Мета.Имя, Им1, Отн);
			Иначе
				ДобавитьПоле(П, Мета.Тип, Мета.Имя, Им1 + "." + Им2, Отн);
			КонецЕсли;
		КонецЦикла;
		Если Мета.Тип = "Report" Тогда
			РвОтч = Новый РегулярноеВыражение("<DataPath>Отчет\.([\wЁёА-Яа-я]+)</DataPath>");
			Для Каждого СР Из РвОтч.НайтиСовпадения(Т) Цикл
				ДобавитьПоле(П, "Report", Мета.Имя, СР.Группы[1].Значение, Отн);
			КонецЦикла;
		КонецЕсли;
		Если Мета.Тип = "DataProcessor" Тогда
			РвОб = Новый РегулярноеВыражение("<DataPath>([\wЁёА-Яа-я]+)\.([\wЁёА-Яа-я]+)</DataPath>");
			Для Каждого СОб Из РвОб.НайтиСовпадения(Т) Цикл
				Если СОб.Группы[1].Значение = "Объект" Или СОб.Группы[1].Значение = "Отчет" Тогда
					Продолжить;
				КонецЕсли;
				ДобавитьПоле(П, Мета.Тип, Мета.Имя, СОб.Группы[1].Значение + "." + СОб.Группы[2].Значение, Отн);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ТипИмяМетаданныхФормы(ОтнПуть)
	Пары = СтрРазделить("Catalogs=Catalog,Documents=Document,InformationRegisters=InformationRegister,"
		+ "AccumulationRegisters=AccumulationRegister,AccountingRegisters=AccountingRegister,"
		+ "CalculationRegisters=CalculationRegister,Reports=Report,DataProcessors=DataProcessor", ",");
	Для Каждого П Из Пары Цикл
		Пара = СтрРазделить(П, "=");
		Если СтрНачинаетсяС(ОтнПуть, Пара[0] + "\") Или СтрНачинаетсяС(ОтнПуть, Пара[0] + "/") Тогда
			Хвост = Сред(ОтнПуть, СтрДлина(Пара[0]) + 2);
			Поз = СтрНайти(Хвост, "\");
			Если Поз = 0 Тогда
				Поз = СтрНайти(Хвост, "/");
			КонецЕсли;
			Если Поз > 0 Тогда
				Возврат Новый Структура("Тип, Имя", Пара[1], Лев(Хвост, Поз - 1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Процедура СобратьПотребностиЗаимствованныхФорм(КаталогРасш, КореньИсходной, П, Формы, Заметки, Было, Предопр)
	РА = ТипыРусАнгл();
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "Form.xml", Истина) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Или СтрНайти(Т, "<BaseForm") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		Мета = ТипИмяМетаданныхФормы(Отн);
		Если Мета <> Неопределено И СтрНайти(Т, "xsi:type=""DynamicList""") > 0 Тогда
			Списки = ДС.СпискиФормы(Т);
			Для Каждого КЗ Из Списки Цикл
				С = КЗ.Значение;
				Метка = Отн + " " + КЗ.Ключ;
				Если С.manual Тогда
					РазобратьЗапрос(С.text, КореньИсходной, П, Метка, Заметки, Было, Предопр, Ф.ПолноеИмя, КЗ.Ключ);
				ИначеЕсли С.mainTable <> "" И СтрНайти(С.mainTable, ".") > 0 Тогда
					Поз = СтрНайти(С.mainTable, ".");
					Тип = РА.Получить(НРег(Лев(С.mainTable, Поз - 1)));
					Если Тип <> Неопределено Тогда
						Потребность(П, Тип, Сред(С.mainTable, Поз + 1));
					КонецЕсли;
				КонецЕсли;
				Для Каждого Поле Из ДС.ПутиСписка(Т, КЗ.Ключ) Цикл
					Если Мета <> Неопределено Тогда
						ДобавитьПоле(П, Мета.Тип, Мета.Имя, Поле, Метка);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			Если Формы.Найти(Отн) = Неопределено Тогда
				Формы.Добавить(Отн);
			КонецЕсли;
		КонецЕсли;
		Если Мета <> Неопределено Тогда
			РвГл = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]*)""[^>]*>.*?<MainAttribute>true</MainAttribute>");
			Для Каждого СГ Из РвГл.НайтиСовпадения(Т) Цикл
				ИмяГл = СГ.Группы[1].Значение;
				РвП = Новый РегулярноеВыражение("<DataPath>" + ИмяГл + "\.([\wЁёА-Яа-я]+)(?:\.([\wЁёА-Яа-я]+))?</DataPath>");
				Для Каждого СП Из РвП.НайтиСовпадения(Т) Цикл
					Если СП.Группы[2].Значение = "" Тогда
						ДобавитьПоле(П, Мета.Тип, Мета.Имя, СП.Группы[1].Значение, Отн);
					Иначе
						ДобавитьПоле(П, Мета.Тип, Мета.Имя, СП.Группы[1].Значение + "." + СП.Группы[2].Значение, Отн);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
		РвПр = Новый РегулярноеВыражение("xr:DesignTimeRef"">Enum[.]([\wЁё]+)[.]EnumValue[.]([\wЁё]+)</Value>");
		Для Каждого СПр Из РвПр.НайтиСовпадения(Т) Цикл
			ДобавитьПоле(П, "Enum", СПр.Группы[1].Значение, СПр.Группы[2].Значение, Отн, "EnumValue");
		КонецЦикла;
		Если Мета <> Неопределено Тогда
			РвО = Новый РегулярноеВыражение("<DataPath>Объект\.([\wЁёА-Яа-я]+)(?:\.([\wЁёА-Яа-я]+)|\[0\]\.([\wЁёА-Яа-я]+))?</DataPath>");
			Для Каждого СО Из РвО.НайтиСовпадения(Т) Цикл
				Им1 = СО.Группы[1].Значение;
				Им2 = ?(СО.Группы[2].Значение <> "", СО.Группы[2].Значение, СО.Группы[3].Значение);
				Если Им2 = "" Тогда
					ДобавитьПоле(П, Мета.Тип, Мета.Имя, Им1, Отн);
				Иначе
					ДобавитьПоле(П, Мета.Тип, Мета.Имя, Им1 + "." + Им2, Отн);
				КонецЕсли;
			КонецЦикла;
			РвОтч = Новый РегулярноеВыражение("<DataPath>Отчет\.([\wЁёА-Яа-я]+)</DataPath>");
			Если Мета.Тип = "Report" Тогда
				Для Каждого СР Из РвОтч.НайтиСовпадения(Т) Цикл
					ДобавитьПоле(П, "Report", Мета.Имя, СР.Группы[1].Значение, Отн);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВставитьРеквизитВТабличнуюЧасть(Текст, ИмяТС, Блок)
	Рв = Новый РегулярноеВыражение("(?s)(<TabularSection uuid=""[^""]*"">.*?<Name>" + ИмяТС + "</Name>.*?<ChildObjects>)([\s\S]*?)(</ChildObjects>)");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Вставка = С[0].Группы[1].Значение + С[0].Группы[2].Значение + Блок + Символы.ПС + С[0].Группы[3].Значение;
	Возврат Лев(Текст, С[0].Индекс) + Вставка + Сред(Текст, С[0].Индекс + С[0].Длина);
КонецФункции

Функция АтрибутТабличнойЧастиВТексте(ТекстОбъекта, ИмяТС, ИмяРек)
	Рв = Новый РегулярноеВыражение("(?s)<TabularSection uuid=""[^""]*"">.*?<Name>" + ИмяТС + "</Name>.*?<ChildObjects>([\s\S]*?)</ChildObjects>");
	СТ = Рв.НайтиСовпадения(ТекстОбъекта);
	Если СТ.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	РвА = Новый РегулярноеВыражение("(?s)<Attribute uuid=""([^""]*)""[^>]*>.*?<Name>" + ИмяРек + "</Name>");
	СА = РвА.НайтиСовпадения(СТ[0].Группы[1].Значение);
	Если СА.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	РвТ = Новый РегулярноеВыражение("(?s)<Type>[\s\S]*?</Type>");
	СТип = РвТ.НайтиСовпадения(СА[0].Значение);
	Возврат Новый Структура("Вид, Имя, Uuid, ТипXml", "Attribute", ИмяРек, СА[0].Группы[1].Значение,
		?(СТип.Количество() = 0, "", СТип[0].Значение));
КонецФункции

// Все колонки табличной части в метаданных исходной — для заимствования ТЧ целиком (правило расширения).
Функция ВсеАтрибутыТабличнойЧасти(ТекстОбъекта, ИмяТС)
	Рез = Новый Массив;
	Рв = Новый РегулярноеВыражение("(?s)<TabularSection uuid=""[^""]*"">.*?<Name>" + ИмяТС + "</Name>.*?<ChildObjects>([\s\S]*?)</ChildObjects>");
	СТ = Рв.НайтиСовпадения(ТекстОбъекта);
	Если СТ.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	РвИм = Новый РегулярноеВыражение("<Name>([^<]+)</Name>");
	РвБлок = Новый РегулярноеВыражение("(?s)<Attribute uuid=""[^""]*"">.*?</Attribute>");
	Для Каждого Б Из РвБлок.НайтиСовпадения(СТ[0].Группы[1].Значение) Цикл
		СИ = РвИм.НайтиСовпадения(Б.Значение);
		Если СИ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Реб = АтрибутТабличнойЧастиВТексте(ТекстОбъекта, ИмяТС, СИ[0].Группы[1].Значение);
		Если Реб <> Неопределено Тогда
			Рез.Добавить(Реб);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция СвойстваОбъекта(Текст)
	Н = СтрНайти(Текст, "<Properties>");
	К = СтрНайти(Текст, "</Properties>");
	Если Н = 0 Или К = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Текст, Н, К - Н);
КонецФункции

Функция XmlДочернего(Реб, Uuid, Тип = "", ИмяОбъекта = "")
	Т = Новый Массив;
	Т.Добавить("			<" + Реб.Вид + " uuid=""" + Uuid + """>");
	Если Реб.Вид = "TabularSection" Тогда
		Т.Добавить("				<InternalInfo>");
		Для Каждого Кат Из СтрРазделить("TabularSection,TabularSectionRow", ",") Цикл
			Т.Добавить("					<xr:GeneratedType name=""" + Тип + Кат + "." + ИмяОбъекта + "." + Реб.Имя + """ category=""" + Кат + """>");
			Т.Добавить("						<xr:TypeId>" + Ч.ДетерминированныйUuid(Uuid + Символы.ПС + Кат + ".type") + "</xr:TypeId>");
			Т.Добавить("						<xr:ValueId>" + Ч.ДетерминированныйUuid(Uuid + Символы.ПС + Кат + ".value") + "</xr:ValueId>");
			Т.Добавить("					</xr:GeneratedType>");
		КонецЦикла;
		Т.Добавить("				</InternalInfo>");
	Иначе
		Т.Добавить("				<InternalInfo/>");
	КонецЕсли;
	Т.Добавить("				<Properties>");
	Т.Добавить("					<ObjectBelonging>Adopted</ObjectBelonging>");
	Т.Добавить("					<Name>" + Реб.Имя + "</Name>");
	Т.Добавить("					<Comment/>");
	Т.Добавить("					<ExtendedConfigurationObject>" + Реб.Uuid + "</ExtendedConfigurationObject>");
	Если Реб.Вид <> "EnumValue" И Реб.ТипXml <> "" Тогда
		Т.Добавить("					" + Реб.ТипXml);
	КонецЕсли;
	Т.Добавить("				</Properties>");
	Если Реб.Вид = "TabularSection" Тогда
		Т.Добавить("				<ChildObjects/>");
	КонецЕсли;
	Т.Добавить("			</" + Реб.Вид + ">");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

Функция ПорядокВида(Вид)
	П = СтрРазделить("EnumValue,Resource,Attribute,Dimension,AccountingFlag,ExtDimensionAccountingFlag,TabularSection,Form,Template,Command", ",");
	И1 = П.Найти(Вид);
	Возврат ?(И1 = Неопределено, 100, И1);
КонецФункции

// Вставляет блок дочернего элемента в ChildObjects с учётом порядка видов.
Функция ВставитьДочерний(Текст, Тип, Блок, Вид)
	Пустой = Символы.ПС + "		<ChildObjects/>";
	Если СтрНайти(Текст, Пустой) > 0 Тогда
		Возврат СтрЗаменить(Текст, Пустой, Символы.ПС + "		<ChildObjects>" + Символы.ПС + Блок + Символы.ПС + "		</ChildObjects>");
	КонецЕсли;
	// ChildObjects объекта — с отступом ровно в 2 табуляции (вложенные ChildObjects ТЧ глубже: «\t\t</ChildObjects>»
	// без перевода строки перед ним совпал бы с закрытием ТЧ и дочерний попал бы внутрь ТЧ)
	Н = СтрНайти(Текст, Символы.ПС + "		<ChildObjects>");
	Если Н > 0 Тогда
		Н = Н + 1;
	КонецЕсли;
	Если Н = 0 Тогда
		К = СтрНайти(Текст, "	</" + Тип + ">");
		Возврат Лев(Текст, К - 1) + "		<ChildObjects>" + Символы.ПС + Блок + Символы.ПС + "		</ChildObjects>" + Символы.ПС + Сред(Текст, К);
	КонецЕсли;
	К = СтрНайти(Текст, Символы.ПС + "		</ChildObjects>", , Н) + 1;
	Мой = ПорядокВида(Вид);
	Рв = Новый РегулярноеВыражение("\n\t\t\t<(\w+)[ >/]");
	Тело = Сред(Текст, Н, К - Н);
	Для Каждого С Из Рв.НайтиСовпадения(Тело) Цикл
		Если ПорядокВида(С.Группы[1].Значение) > Мой Тогда
			Поз = Н + С.Индекс; // позиция символа перевода строки (индекс с 0)
			Возврат Лев(Текст, Поз) + Блок + Сред(Текст, Поз);
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(Текст, К - 1) + Блок + Символы.ПС + Сред(Текст, К);
КонецФункции

// Вставляет <Тип>Имя</Тип> в ChildObjects Configuration.xml расширения в каноническом порядке.
Функция ВставитьВКонфигурацию(Текст, Тип, Имя, ПорядокТипов) Экспорт
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Мой = ПорядокТипов.Найти(Тип);
	Если Мой = Неопределено Тогда
		Мой = 1000;
	КонецЕсли;
	Нач = -1;
	Кон = -1;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если Нач < 0 И СокрЛП(Строки[Й]) = "<ChildObjects>" И СтрНачинаетсяС(Строки[Й], "		<") Тогда
			Нач = Й;
		ИначеЕсли Нач >= 0 И СокрЛП(Строки[Й]) = "</ChildObjects>" Тогда
			Кон = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Нач < 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("^\s*<(\w+)>([^<]*)</\1>\s*$");
	Куда = Нач + 1;
	Для Й = Нач + 1 По Кон - 1 Цикл
		СС = Рв.НайтиСовпадения(Строки[Й]);
		Если СС.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Т = СС[0].Группы[1].Значение;
		И1 = ?(Т = "Language", -1, ПорядокТипов.Найти(Т));
		Если И1 = Неопределено Тогда
			И1 = 1000;
		КонецЕсли;
		Если И1 < Мой Или (И1 = Мой И СС[0].Группы[2].Значение < Имя) Тогда
			Куда = Й + 1;
		КонецЕсли;
	КонецЦикла;
	Строки.Вставить(Куда, "			<" + Тип + ">" + Имя + "</" + Тип + ">");
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ИмяПараметраПредопр(Пр)
	Возврат "Предопределенное_" + Пр.Имя + "_" + Пр.Элемент;
КонецФункции

// ЗНАЧЕНИЕ(Справочник.X.Элемент) в запросе собственной формы расширения: Конфигуратор проверяет запрос по
// метаданным расширения, где предопределённых заимствованного объекта нет («Неверный путь к данным» на все поля
// списка). Заменяется параметром &Предопределенное_X_Элемент, значение ставится в ПриСозданииНаСервере через
// ПредопределенноеЗначение (строкой — без проверки модуля по метаданным расширения).
Функция ЗаменитьПредопределённые(ПутьФормы, Пункты)
	Т = ПрочитатьТекст(ПутьФормы);
	ПутьМодуля = ОбъединитьПути((Новый Файл(ПутьФормы)).Путь, "Form", "Module.bsl");
	М = ПрочитатьТекст(ПутьМодуля);
	Если М = Неопределено Тогда
		М = "";
	КонецЕсли;
	Строки = Новый Массив;
	Было = Новый Соответствие;
	Для Каждого Пр Из Пункты Цикл
		Имя = ИмяПараметраПредопр(Пр);
		Рв = Новый РегулярноеВыражение("(?:ЗНАЧЕНИЕ|VALUE)\s*\(\s*" + Пр.ВидРус + "\." + Пр.Имя + "\." + Пр.Элемент + "\s*\)");
		Рв.ИгнорироватьРегистр = Истина;
		Т = Рв.Заменить(Т, "&amp;" + Имя); // текст запроса в Form.xml экранирован
		Ключ = Пр.Список + "|" + Имя;
		Если Было.Получить(Ключ) = Неопределено И СтрНайти(М, """" + Имя + """") = 0 Тогда
			Было.Вставить(Ключ, Истина);
			Строки.Добавить("	" + Пр.Список + ".Параметры.УстановитьЗначениеПараметра(""" + Имя + """, ПредопределенноеЗначение("""
				+ Пр.ВидРус + "." + Пр.Имя + "." + Пр.Элемент + """));");
		КонецЕсли;
	КонецЦикла;
	Если Строки.Количество() > 0 Тогда
		Вставка = "	// typovaya-up: предопределённые значения запроса динамического списка (см. ЗаимствованиеПолейСписков)" + Символы.ПС
			+ СтрСоединить(Строки, Символы.ПС) + Символы.ПС;
		Рв = Новый РегулярноеВыражение("(Процедура\s+([\wЁё]+)\s*\(\s*Отказ\s*,\s*СтандартнаяОбработка\s*\)[^\n]*\n)");
		Обр = "";
		СС = (Новый РегулярноеВыражение("<Event name=""OnCreateAtServer"">([^<]*)</Event>")).НайтиСовпадения(Т);
		Если СС.Количество() > 0 Тогда
			Обр = СС[0].Группы[1].Значение;
		КонецЕсли;
		Поз = 0;
		Если Обр <> "" Тогда
			СП = (Новый РегулярноеВыражение("Процедура\s+" + Обр + "\s*\([^)]*\)[^\n]*\n")).НайтиСовпадения(М);
			Если СП.Количество() > 0 Тогда
				Поз = СП[0].Индекс + СП[0].Длина;
			КонецЕсли;
		КонецЕсли;
		Если Поз > 0 Тогда
			М = Лев(М, Поз) + Вставка + Сред(М, Поз + 1);
		Иначе
			Обр = "ТиповаяУп_ПриСозданииНаСервере";
			М = М + Символы.ПС + "&НаСервере" + Символы.ПС + "Процедура " + Обр + "(Отказ, СтандартнаяОбработка)" + Символы.ПС
				+ Вставка + "КонецПроцедуры" + Символы.ПС;
			Если СтрНайти(Т, "<Event name=""OnCreateAtServer"">") = 0 Тогда
				Если СтрНайти(Т, Символы.ПС + "	<Events>") > 0 Тогда
					Т = СтрЗаменить(Т, Символы.ПС + "	<Events>", Символы.ПС + "	<Events>" + Символы.ПС + "		<Event name=""OnCreateAtServer"">" + Обр + "</Event>");
				Иначе
					Т = СтрЗаменить(Т, Символы.ПС + "	<ChildItems>", Символы.ПС + "	<Events>" + Символы.ПС + "		<Event name=""OnCreateAtServer"">" + Обр + "</Event>" + Символы.ПС + "	</Events>" + Символы.ПС + "	<ChildItems>");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ЗаписатьТекст(ПутьМодуля, М);
	КонецЕсли;
	ЗаписатьТекст(ПутьФормы, Т);
	Возврат Строки.Количество();
КонецФункции

// Применяет (Записывать = Истина) или только проверяет потребности собственных форм.
// Возврат: Структура(forms, addedObjects, addedChildren: Массив строк, missing: Массив строк (что не заимствовано),
// notes: Массив строк (не исправляется автоматически)).
// Текст модуля без комментариев, строковых литералов и блоков #Удаление (их код не компилируется).
Функция КодМодуля(Знач Т) Экспорт
	Т = (Новый РегулярноеВыражение("(?m)^[ \t]*#Удаление[\s\S]*?^[ \t]*#КонецУдаления")).Заменить(Т, "");
	Т = (Новый РегулярноеВыражение("""[^""\n]*(""|$)")).Заменить(Т, """""");
	Т = (Новый РегулярноеВыражение("(?m)^[ \t]*\|[^\n]*")).Заменить(Т, "");
	Т = (Новый РегулярноеВыражение("//[^\n]*")).Заменить(Т, "");
	Возврат Т;
КонецФункции

// Неквалифицированные идентификаторы кода (не после точки, не вызов метода). Соответствие нрег -> Имя.
Функция ИдентификаторыМодуля(Текст) Экспорт
	Р = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?<![\wЁё.&#~])([А-ЯЁа-яёA-Za-z_][\wЁё]*)(?![\wЁё]|\s*\()");
	Для Каждого С Из Рв.НайтиСовпадения(КодМодуля(Текст)) Цикл
		Р.Вставить(НРег(С.Группы[1].Значение), С.Группы[1].Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Задача 10: модуль объекта расширения видит только заимствованные реквизиты/ТЧ, модуль менеджера
// перечисления — только заимствованные значения. Собирает потребности по модулям заимствованных объектов.
Функция СобратьПотребностиМодулей(КаталогРасш) Экспорт
	П = Новый Соответствие;
	Формы = Новый Массив;
	Заметки = Новый Массив;
	Для Каждого Тип Из СтрРазделить("Catalog,Document,Enum,ChartOfCharacteristicTypes,ChartOfAccounts,ChartOfCalculationTypes,"
		+ "BusinessProcess,Task,ExchangePlan,DataProcessor,Report", ",") Цикл
		Папка = ОбъединитьПути(КаталогРасш, ПапкаТипа(Тип));
		Для Каждого Ф Из НайтиФайлы(Папка, "*.xml", Ложь) Цикл
			ТекстОб = ПрочитатьТекст(Ф.ПолноеИмя);
			Если ТекстОб = Неопределено Или СтрНайти(СвойстваОбъекта(ТекстОб), "<ObjectBelonging>Adopted</ObjectBelonging>") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Имя = Ф.ИмяБезРасширения;
			Модули = Новый Структура("ObjectModule, ManagerModule", "Attribute,TabularSection", ?(Тип = "Enum", "EnumValue", ""));
			Для Каждого КМ Из Модули Цикл
				Если КМ.Значение = "" Тогда
					Продолжить;
				КонецЕсли;
				ТекстМ = ПрочитатьТекст(ОбъединитьПути(Папка, Имя, "Ext", КМ.Ключ + ".bsl"));
				Если ТекстМ = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Метка = ПапкаТипа(Тип) + "/" + Имя + "/" + КМ.Ключ;
				Для Каждого КЗ Из ИдентификаторыМодуля(ТекстМ) Цикл
					ДобавитьПоле(П, Тип, Имя, КЗ.Значение, Метка, КМ.Значение);
				КонецЦикла;
				Формы.Добавить(Метка);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("Потребности, Формы, Заметки, Предопр", П, Формы, Заметки, Новый Массив);
КонецФункции

Функция ПотребностиПоФильтруФорм(П, ФильтрМеток)
	Если ФильтрМеток = Неопределено Или ФильтрМеток.Количество() = 0 Тогда
		Возврат П;
	КонецЕсли;
	Нов = Новый Соответствие;
	Для Каждого КЗ Из П Цикл
		Оставить = Ложь;
		Для Каждого КП Из КЗ.Значение.Поля Цикл
			М = КП.Значение.Метка;
			Для Каждого Ф Из ФильтрМеток Цикл
				Если СтрНайти(М, Ф) > 0 Тогда
					Оставить = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Оставить Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Оставить Тогда
			Нов.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Нов;
КонецФункции

Функция Применить(КаталогРасш, КореньИсходной, ИмяРасширения, Записывать = Истина, КорниМодулей = Неопределено, ФильтрМеток = Неопределено) Экспорт
	КэшИсх = Новый Соответствие;
	Корни = КорниМодулей;
	Если КорниМодулей = Неопределено Тогда
		Сбор = СобратьПотребности(КаталогРасш, КореньИсходной);
	Иначе
		Сбор = СобратьПотребностиМодулей(КаталогРасш);
	КонецЕсли;
	П = ПотребностиПоФильтруФорм(Сбор.Потребности, ФильтрМеток);
	Заметки = Сбор.Заметки;
	Было = Новый Соответствие;
	ДобОбъекты = Новый Массив;
	ДобДети = Новый Массив;
	Нет = Новый Массив;
	Стд = Стандартные();
	ПутьКонф = ОбъединитьПути(КаталогРасш, "Configuration.xml");
	ТекстКонф = ПрочитатьТекст(ПутьКонф);
	Если ТекстКонф = Неопределено Тогда
		ТекстКонф = "";
	КонецЕсли;
	КонфИзменена = Ложь;
	Очередь = Новый Массив;
	Для Каждого КЗ Из П Цикл
		Очередь.Добавить(КЗ.Ключ);
	КонецЦикла;
	Обработано = Новый Соответствие;
	Й = 0;
	Пока Й < Очередь.Количество() Цикл
		Ключ = Очередь[Й];
		Й = Й + 1;
		Если Обработано.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Обработано.Вставить(Ключ, Истина);
		Н = П.Получить(Ключ);
		// В заимствованном журнале документов дочерние Attribute недопустимы (перечисления — заимствование EnumValue).
		Если Н.Тип = "DocumentJournal" Тогда
			Продолжить;
		КонецЕсли;
		Ист = Источник(КореньИсходной, Н.Тип, Н.Имя);
		Если Ист = Неопределено Тогда
			ДобавитьЗаметку(Заметки, Было, "нет в исходной выгрузке: " + Ключ);
			Продолжить;
		КонецЕсли;
		// какие дочерние нужны
		Нужные = Новый Массив;
		ТекстИсх = ПрочитатьТекст(Ист.Путь);
		Для Каждого КП Из Н.Поля Цикл
			ИмяП = КП.Значение.Имя;
			Реб = Неопределено;
			Если СтрЧислоВхождений(ИмяП, ".") > 0 Тогда
				Сегм = СтрРазделить(ИмяП, ".");
				РебТС = Ист.Дети.Получить(НРег(Сегм[0]));
				Если РебТС = Неопределено И ТекстИсх <> Неопределено Тогда
					РвТС = Новый РегулярноеВыражение("(?s)<TabularSection uuid=""([^""]*)""[^>]*>.*?<Name>" + Сегм[0] + "</Name>");
					СТС = РвТС.НайтиСовпадения(ТекстИсх);
					Если СТС.Количество() > 0 Тогда
						РебТС = Новый Структура("Вид, Имя, Uuid, ТипXml", "TabularSection", Сегм[0], СТС[0].Группы[1].Значение, "");
						Нужные.Добавить(РебТС);
					КонецЕсли;
				ИначеЕсли РебТС <> Неопределено Тогда
					Нужные.Добавить(РебТС);
				КонецЕсли;
				Если ТекстИсх <> Неопределено Тогда
					Для Каждого Кол Из ВсеАтрибутыТабличнойЧасти(ТекстИсх, Сегм[0]) Цикл
						Нужные.Добавить(Кол);
					КонецЦикла;
				КонецЕсли;
			Иначе
				Реб = Ист.Дети.Получить(КП.Ключ);
			КонецЕсли;
			Если КП.Значение.Виды <> "" Тогда
				// идентификатор модуля: нужен только дочерний подходящего вида (иначе — локальная переменная и т.п.)
				Если Реб = Неопределено Или СтрНайти("," + КП.Значение.Виды + ",", "," + Реб.Вид + ",") = 0 Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			Если Реб = Неопределено Тогда
				ИмяСт = ИмяСтандартногоРеквизита(ИмяП);
				Если ИмяСт <> "" И СтрЧислоВхождений(ИмяП, ".") = 0 Тогда
					ТипXml = ТипXmlСтандартногоРеквизита(Н.Тип, ИмяСт, Н.Имя);
					Если ТипXml <> "" Тогда
						Реб = Новый Структура("Вид, Имя, Uuid, ТипXml", "Attribute", ИмяСт,
							Ч.ДетерминированныйUuid(Ист.Uuid + Символы.ПС + "std:" + ИмяСт), ТипXml);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если Реб = Неопределено Тогда
				Если Стд.Получить(КП.Ключ) = Неопределено И СтрЧислоВхождений(ИмяП, ".") = 0 Тогда
					ДобавитьЗаметку(Заметки, Было, КП.Значение.Метка + ": поля " + Ключ + "." + КП.Значение.Имя + " нет в метаданных исходной (реквизит ТЧ/общий или ошибка исходной формы)");
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			Если СтрЧислоВхождений(ИмяП, ".") = 0 Тогда
				Нужные.Добавить(Реб);
			КонецЕсли;
		КонецЦикла;
		ПутьРасш = ОбъединитьПути(КаталогРасш, ПапкаТипа(Н.Тип), Н.Имя + ".xml");
		ТекстРасш = ПрочитатьТекст(ПутьРасш);
		Изменён = Ложь;
		Если ТекстРасш = Неопределено Тогда
			Нет.Добавить("объект " + Ключ);
			ДобОбъекты.Добавить(Ключ);
			Данные = Новый Структура("Тип, Имя, СвойUuid, БазовыйUuid, ПутьИсходногоXml, Команды, Формы", Н.Тип, Н.Имя,
				Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + Ключ + Символы.ПС + "object"), Ист.Uuid, Ист.Путь, Неопределено, Неопределено);
			ТекстРасш = СтрЗаменить(Ч.XmlОбъекта(Данные), Символы.ВК, "");
			Изменён = Истина;
		ИначеЕсли СтрНайти(СвойстваОбъекта(ТекстРасш), "<ObjectBelonging>Adopted</ObjectBelonging>") = 0 Тогда
			// собственный объект расширения — полная копия, реквизиты уже есть
			Продолжить;
		КонецЕсли;
		Если СтрНайти(ТекстКонф, "<" + Н.Тип + ">" + Н.Имя + "</" + Н.Тип + ">") = 0 И ТекстКонф <> "" Тогда
			Если ДобОбъекты.Найти(Ключ) = Неопределено Тогда
				Нет.Добавить("объект в Configuration.xml " + Ключ);
				ДобОбъекты.Добавить(Ключ);
			КонецЕсли;
			ТекстКонф = ВставитьВКонфигурацию(ТекстКонф, Н.Тип, Н.Имя, Ч.ПорядокТиповКонфигурации());
			КонфИзменена = Истина;
		КонецЕсли;
		Если Н.Тип = "Constant" Тогда
			СвР = СвойстваОбъекта(ТекстРасш);
			Если СтрНайти(СвР, "<Type>") = 0 Тогда
				ТипИсх = (Новый РегулярноеВыражение("<Type>[\s\S]*?</Type>")).НайтиСовпадения(ПрочитатьТекст(Ист.Путь));
				Если ТипИсх.Количество() > 0 Тогда
					Нет.Добавить("тип константы " + Ключ);
					ДобДети.Добавить(Ключ + ".Type");
					Поз = СтрНайти(ТекстРасш, "		</Properties>");
					ТекстРасш = Лев(ТекстРасш, Поз - 1) + "			" + ТипИсх[0].Значение + Символы.ПС + Сред(ТекстРасш, Поз);
					Изменён = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		ЕстьВРасш = ДетиТекста(ТекстРасш);
		ТСОбработаны = Новый Соответствие;
		Для Каждого КП Из Н.Поля Цикл
			ИмяП = КП.Значение.Имя;
			Если СтрЧислоВхождений(ИмяП, ".") <> 1 Тогда
				Продолжить;
			КонецЕсли;
			Сегм = СтрРазделить(ИмяП, ".");
			Если ТекстИсх = Неопределено Или ТСОбработаны.Получить(НРег(Сегм[0])) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТСОбработаны.Вставить(НРег(Сегм[0]), Истина);
			Если ЕстьВРасш.Получить(НРег(Сегм[0])) = Неопределено Тогда
				РебТС = Ист.Дети.Получить(НРег(Сегм[0]));
				Если РебТС = Неопределено Тогда
					РвТС = Новый РегулярноеВыражение("(?s)<TabularSection uuid=""([^""]*)""[^>]*>.*?<Name>" + Сегм[0] + "</Name>");
					СТС = РвТС.НайтиСовпадения(ТекстИсх);
					Если СТС.Количество() > 0 Тогда
						РебТС = Новый Структура("Вид, Имя, Uuid, ТипXml", "TabularSection", Сегм[0], СТС[0].Группы[1].Значение, "");
						UuidТС = Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + Ключ + Символы.ПС + "TabularSection." + Сегм[0]);
						ТекстРасш = ВставитьДочерний(ТекстРасш, Н.Тип, XmlДочернего(РебТС, UuidТС, Н.Тип, Н.Имя), "TabularSection");
						ЕстьВРасш.Вставить(НРег(Сегм[0]), РебТС);
						Изменён = Истина;
					КонецЕсли;
				Иначе
					UuidТС = Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + Ключ + Символы.ПС + "TabularSection." + Сегм[0]);
					ТекстРасш = ВставитьДочерний(ТекстРасш, Н.Тип, XmlДочернего(РебТС, UuidТС, Н.Тип, Н.Имя), "TabularSection");
					ЕстьВРасш.Вставить(НРег(Сегм[0]), РебТС);
					Изменён = Истина;
				КонецЕсли;
			КонецЕсли;
			Для Каждого Реб Из ВсеАтрибутыТабличнойЧасти(ТекстИсх, Сегм[0]) Цикл
				КлючКол = НРег(Сегм[0] + "." + Реб.Имя);
				Если ЕстьВРасш.Получить(КлючКол) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ИмяПКол = Сегм[0] + "." + Реб.Имя;
				Нет.Добавить("Attribute " + Ключ + "." + ИмяПКол);
				ДобДети.Добавить(Ключ + "." + ИмяПКол);
				Uuid = Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + Ключ + Символы.ПС + "TS." + ИмяПКол);
				Блок = XmlДочернего(Реб, Uuid, Н.Тип, Н.Имя);
				ТекстРасш = ВставитьРеквизитВТабличнуюЧасть(ТекстРасш, Сегм[0], Блок);
				ЕстьВРасш.Вставить(КлючКол, Реб);
				Изменён = Истина;
			КонецЦикла;
		КонецЦикла;
		Для Каждого Реб Из Нужные Цикл
			Если Реб.Вид = "Attribute" И СтрЧислоВхождений(Реб.Имя, ".") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьВРасш.Получить(НРег(Реб.Имя)) = Неопределено Тогда
				Нет.Добавить(Реб.Вид + " " + Ключ + "." + Реб.Имя);
				ДобДети.Добавить(Ключ + "." + Реб.Имя);
				Uuid = Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + Ключ + Символы.ПС + Реб.Вид + "." + Реб.Имя);
				ТекстРасш = ВставитьДочерний(ТекстРасш, Н.Тип, XmlДочернего(Реб, Uuid, Н.Тип, Н.Имя), Реб.Вид);
				ЕстьВРасш.Вставить(НРег(Реб.Имя), Реб);
				Изменён = Истина;
			КонецЕсли;
			// типы реквизита должны быть объектами расширения
			Для Каждого Сс Из ТипыИзТипаXml(Реб.ТипXml) Цикл
				Потребность(П, Сс.Тип, Сс.Имя);
				Очередь.Добавить(Сс.Тип + "." + Сс.Имя);
			КонецЦикла;
		КонецЦикла;
		Если Изменён И Записывать Тогда
			ЗаписатьТекст(ПутьРасш, ТекстРасш);
		КонецЕсли;
	КонецЦикла;
	ПоФормам = Новый Соответствие;
	Для Каждого Пр Из Сбор.Предопр Цикл
		Нет.Добавить("предопределённое в запросе " + Сред(Пр.Форма, СтрДлина(КаталогРасш) + 2) + " " + Пр.ВидРус + "." + Пр.Имя + "." + Пр.Элемент);
		Если ПоФормам.Получить(Пр.Форма) = Неопределено Тогда
			ПоФормам.Вставить(Пр.Форма, Новый Массив);
		КонецЕсли;
		ПоФормам.Получить(Пр.Форма).Добавить(Пр);
	КонецЦикла;
	Если Записывать Тогда
		Для Каждого КЗ Из ПоФормам Цикл
			ЗаменитьПредопределённые(КЗ.Ключ, КЗ.Значение);
			ДобДети.Добавить("параметр предопределённых " + КЗ.Ключ);
		КонецЦикла;
	КонецЕсли;
	Если КонфИзменена И Записывать Тогда
		ЗаписатьТекст(ПутьКонф, ТекстКонф);
	КонецЕсли;
	Возврат Новый Структура("forms, addedObjects, addedChildren, missing, notes", Сбор.Формы, ДобОбъекты, ДобДети, Нет, Заметки);
КонецФункции

Процедура УстановитьЧерновик(Модуль) Экспорт
	Ч = Модуль;
КонецПроцедуры

ДС = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗапросыДинСписков.os"));
Ч = Неопределено;
КэшИсх = Новый Соответствие;
