// Построчный прогресс: консоль + немедленная дозапись в log (tail -f), без ожидания конца прогона.

Перем ПутьЛога;

Процедура УстановитьПутьЛога(Путь) Экспорт
	ПутьЛога = ?(Путь = Неопределено, "", Путь);
КонецПроцедуры

Процедура Вывести(Текст) Экспорт
	Сообщить(Текст);
	Если ПутьЛога <> "" Тогда
		Попытка
			З = Новый ЗаписьТекста(ПутьЛога, КодировкаТекста.UTF8, , Истина);
			З.ЗаписатьСтроку(Текст);
			З.Закрыть();
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры