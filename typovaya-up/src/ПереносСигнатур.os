// Методы с разной сигнатурой УП/БП: в restored — текст БП байт в байт,
// в расширение — копия УП_<Имя> (сигнатура и тело УП), вызовы только-УП-арности
// переписываются на УП_<Имя> (в хуках &ИзменениеИКонтроль — только в #Вставка).

Перем Разбор;
Перем Контракт;
Перем КлючевыеОбъявления;
Перем КартаКвалификаторов;
Перем КартаТиповПапок;
Перем КэшИменКвалиф;
Перем КэшКвалиф;

Процедура Инициализировать(МодульРазбора, МодульКонтракта) Экспорт
	Разбор = МодульРазбора;
	Контракт = МодульКонтракта;
	КлючевыеОбъявления = Новый Соответствие;
	Для Каждого С Из СтрРазделить("Процедура,Функция,Асинх,Procedure,Function,Async,Если,If,Пока,While,Для,For,Возврат,Return,Новый,New,Выполнить,Execute,ВызватьИсключение,Raise,ИначеЕсли,ElsIf,Elsif,ДобавитьОбработчик,AddHandler,УдалитьОбработчик,RemoveHandler,Перейти,Goto,Ждать,Await", ",", Ложь) Цикл
		КлючевыеОбъявления.Вставить(НРег(СокрЛП(С)), Истина);
	КонецЦикла;
	ИнициализироватьКвалификаторы();
КонецПроцедуры

Процедура ИнициализироватьКвалификаторы()
	КартаКвалификаторов = Новый Соответствие;
	КартаТиповПапок = Новый Соответствие;
	ДобТип("Catalogs", "Справочники");
	ДобТип("Documents", "Документы");
	ДобТип("InformationRegisters", "РегистрыСведений");
	ДобТип("AccumulationRegisters", "РегистрыНакопления");
	ДобТип("AccountingRegisters", "РегистрыБухгалтерии");
	ДобТип("CalculationRegisters", "РегистрыРасчета");
	ДобТип("ChartsOfCharacteristicTypes", "ПланыВидовХарактеристик");
	ДобТип("ChartsOfAccounts", "ПланыСчетов");
	ДобТип("ChartsOfCalculationTypes", "ПланыВидовРасчета");
	ДобТип("ExchangePlans", "ПланыОбмена");
	ДобТип("BusinessProcesses", "БизнесПроцессы");
	ДобТип("Tasks", "Задачи");
	ДобТип("DataProcessors", "Обработки");
	ДобТип("Reports", "Отчеты");
	ДобТип("DocumentJournals", "ЖурналыДокументов");
	ДобТип("FilterCriteria", "КритерииОтбора");
	ДобТип("SettingsStorages", "ХранилищаНастроек");
	ДобТип("Enums", "Перечисления");
	ДобТип("Constants", "Константы");
	ДобТип("Sequences", "Последовательности");
КонецПроцедуры

Процедура ДобТип(ПапкаАнгл, ИмяРус)
	КартаТиповПапок.Вставить(ПапкаАнгл, ИмяРус);
	КартаКвалификаторов.Вставить(НРег(ИмяРус), ПапкаАнгл);
	КартаКвалификаторов.Вставить(НРег(ПапкаАнгл), ПапкаАнгл);
КонецПроцедуры

Функция Пометить(Мт, ТекстПост, ТекстИсх) Экспорт
	Если СокрЛП(Строка(ТекстПост)) = "" Или СокрЛП(Строка(ТекстИсх)) = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	СигБп = РазобратьСигнатуру(ТекстПост, ИмяМетода(Мт));
	СигУп = РазобратьСигнатуру(ТекстИсх, ИмяМетода(Мт));
	Если СигБп = Неопределено Или СигУп = Неопределено Или КонтрактыРавны(СигБп, СигУп) Тогда
		Возврат Ложь;
	КонецЕсли;
	Мт.Вставить("signatureDiffers", Истина);
	Мт.Вставить("signatureUp", СигУп);
	Мт.Вставить("signatureBp", СигБп);
	Доп = "Сигнатура УП отличается от БП: в restored — сигнатура и тело БП, в расширение выносится УП_" + ИмяМетода(Мт) + ".";
	Если Мт.Свойство("explain") И СокрЛП(Строка(Мт.explain)) <> "" Тогда
		Мт.explain = Доп + " " + Мт.explain;
	Иначе
		Мт.Вставить("explain", Доп);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Истина, если сигнатура БП = сигнатура УП + необязательные параметры в конце (вид, Экспорт,
// имена/Знач/умолчания общих параметров совпадают). Тогда все вызовы УП подходят к сигнатуре БП.
Функция ТолькоДобавленыНеобязательные(ТекстПост, ТекстИсх) Экспорт
	СигБп = РазобратьСигнатуру(ТекстПост, "");
	СигУп = РазобратьСигнатуру(ТекстИсх, "");
	Если СигБп = Неопределено Или СигУп = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НРег(СигБп.kind) <> НРег(СигУп.kind) Или СигБп.export <> СигУп.export Тогда
		Возврат Ложь;
	КонецЕсли;
	ПБ = СигБп.contract.Параметры;
	ПУ = СигУп.contract.Параметры;
	Если ПУ.Количество() >= ПБ.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Й = 0 По ПУ.Количество() - 1 Цикл
		Если НРег(ПУ[Й].Имя) <> НРег(ПБ[Й].Имя) Или ПУ[Й].ПоЗнач <> ПБ[Й].ПоЗнач
			Или СокрЛП(Строка(ПУ[Й].Дефолт)) <> СокрЛП(Строка(ПБ[Й].Дефолт)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Й = ПУ.Количество() По ПБ.Количество() - 1 Цикл
		Если СокрЛП(Строка(ПБ[Й].Дефолт)) = "" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоПеренос(Мт) Экспорт
	Возврат Мт.Свойство("signatureDiffers") И Мт.signatureDiffers = Истина
		И СокрЛП(Строка(Мт.vendorText)) <> "";
КонецФункции

Функция ИмяМетода(Мт)
	Если Мт.Свойство("name") Тогда
		Возврат Строка(Мт.name);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция РазобратьСигнатуру(ТекстМетода, Имя) Экспорт
	Если Контракт = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	К = Неопределено;
	Попытка
		К = Контракт.РазобратьКонтракт(ТекстМетода, Разбор);
	Исключение
		К = Неопределено;
	КонецПопытки;
	Если К = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Всего = К.Параметры.Количество();
	Обяз = 0;
	Для Каждого П Из К.Параметры Цикл
		Если СокрЛП(Строка(П.Дефолт)) = "" Тогда
			Обяз = Обяз + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("kind, export, total, required, text, contract",
		К.Вид, К.Экспорт, Всего, Обяз, СигнатураИзКонтракта(Имя, К), К);
КонецФункции

Функция СигнатураИзКонтракта(Имя, К)
	Части = Новый Массив;
	Для Каждого П Из К.Параметры Цикл
		С = П.Имя;
		Если П.ПоЗнач Тогда
			С = "Знач " + С;
		КонецЕсли;
		Если СокрЛП(Строка(П.Дефолт)) <> "" Тогда
			С = С + " = " + П.Дефолт;
		КонецЕсли;
		Части.Добавить(С);
	КонецЦикла;
	Возврат К.Вид + " " + Имя + "(" + СтрСоединить(Части, ", ") + ")";
КонецФункции

Функция КонтрактыРавны(А, Б)
	Если А = Неопределено Или Б = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если НРег(А.kind) <> НРег(Б.kind) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если А.export <> Б.export Тогда
		Возврат Ложь;
	КонецЕсли;
	Если А.contract.Параметры.Количество() <> Б.contract.Параметры.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Й = 0 По А.contract.Параметры.Количество() - 1 Цикл
		ПА = А.contract.Параметры[Й];
		ПБ = Б.contract.Параметры[Й];
		Если НРег(ПА.Имя) <> НРег(ПБ.Имя) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ПА.ПоЗнач <> ПБ.ПоЗнач Тогда
			Возврат Ложь;
		КонецЕсли;
		Если СокрЛП(Строка(ПА.Дефолт)) <> СокрЛП(Строка(ПБ.Дефолт)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ВызовПодходит(Сиг, Факт) Экспорт
	Если Сиг = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Факт >= Сиг.required И Факт <= Сиг.total;
КонецФункции

Функция НужноПереименоватьВызов(СигУп, СигБп, Факт) Экспорт
	Возврат ВызовПодходит(СигУп, Факт) И Не ВызовПодходит(СигБп, Факт);
КонецФункции

Функция ТекстКопииУп(Мт, Префикс) Экспорт
	Имя = ИмяМетода(Мт);
	НовоеИмя = Префикс + Имя;
	Текст = Мт.sourceText;
	Если СокрЛП(Строка(Текст)) = "" Тогда
		Возврат "";
	КонецЕсли;
	Текст = ПереименоватьОбъявление(Текст, Имя, НовоеИмя);
	Текст = ОбеспечитьЭкспорт(Текст, Мт.kind, НовоеИмя);
	Если Мт.Свойство("preprocPrefixSource") И Мт.preprocPrefixSource <> "" Тогда
		Текст = Разбор.ОбернутьТекстПрепроцессором(Текст, Мт.preprocPrefixSource, Мт.preprocSuffixSource);
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ПереименоватьОбъявление(Знач Текст, Имя, НовоеИмя)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Объ = Разбор.РазобратьОбъявление(Строки[Й]);
		Если Объ = Неопределено Или НРег(Объ.Имя) <> НРег(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Строки[Й] = ЗаменитьИмяОбъявления(Строки[Й], Имя, НовоеИмя);
		Прервать;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ЗаменитьИмяОбъявления(Стр, Имя, НовоеИмя)
	Н = НРег(Стр);
	Ни = НРег(Имя);
	Поз = СтрНайти(Н, Ни);
	Пока Поз > 0 Цикл
		Перед = ?(Поз = 1, "", Сред(Стр, Поз - 1, 1));
		После = Сред(Стр, Поз + СтрДлина(Имя), 1);
		Если Не ЭтоЛитералИдентификатора(Перед) И Не ЭтоЛитералИдентификатора(После) Тогда
			Возврат Лев(Стр, Поз - 1) + НовоеИмя + Сред(Стр, Поз + СтрДлина(Имя));
		КонецЕсли;
		Дальше = СтрНайти(Н, Ни, Поз + 1);
		Если Дальше = 0 Тогда
			Прервать;
		КонецЕсли;
		Поз = Дальше;
	КонецЦикла;
	Возврат Стр;
КонецФункции

Функция ЭтоЛитералИдентификатора(С)
	Если С = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	К = КодСимвола(С);
	Возврат (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или (К >= 48 И К <= 57)
		Или (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105 Или С = "_";
КонецФункции

Функция ОбеспечитьЭкспорт(Знач Текст, Вид, Имя)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Глубина = 0;
	Начали = Ложь;
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Стр = Строки[Й];
		Объ = Разбор.РазобратьОбъявление(Стр);
		Если Не Начали Тогда
			Если Объ = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Начали = Истина;
		КонецЕсли;
		Чистая = Разбор.УбратьКомментарий(Стр);
		Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
		Если Глубина > 0 Тогда
			Продолжить;
		КонецЕсли;
		Н = НРег(Чистая);
		Если СтрНайти(Н, " экспорт") > 0 Или СтрНайти(Н, " export") > 0 Тогда
			Возврат Текст;
		КонецЕсли;
		// вставить Экспорт перед комментарием или в конец строки объявления
		Ком = СтрНайти(Стр, "//");
		Если Ком > 0 Тогда
			Строки[Й] = СокрП(Лев(Стр, Ком - 1)) + " Экспорт " + Сред(Стр, Ком);
		Иначе
			Строки[Й] = СокрП(Стр) + " Экспорт";
		КонецЕсли;
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция СобратьКарты(Модули, Префикс) Экспорт
	Рез = Новый Структура("ПоПути, Квалифицированные, Items", Новый Соответствие, Новый Соответствие, Новый Массив);
	Если Модули = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	Для Каждого М Из Модули Цикл
		Путь = "";
		Если М.Свойство("path") Тогда
			Путь = СтрЗаменить(Строка(М.path), "/", "\");
		КонецЕсли;
		Лок = Новый Соответствие;
		Для Каждого Мт Из М.methods Цикл
			Если Не ЭтоПеренос(Мт) Тогда
				Продолжить;
			КонецЕсли;
			Инфо = Новый Структура("name, newName, path, sigUp, sigBp, kind, objectName",
				ИмяМетода(Мт), Префикс + ИмяМетода(Мт), Путь,
				?(Мт.Свойство("signatureUp"), Мт.signatureUp, Неопределено),
				?(Мт.Свойство("signatureBp"), Мт.signatureBp, Неопределено),
				"", "");
			Части = СтрРазделить(Путь, "\", Истина);
			Если Части.Количество() > 0 Тогда
				Инфо.kind = Части[0];
			КонецЕсли;
			Если Части.Количество() > 1 И НРег(Инфо.kind) <> "ext" Тогда
				Инфо.objectName = Части[1];
			КонецЕсли;
			Лок.Вставить(НРег(Инфо.name), Инфо);
			Рез.Items.Добавить(Инфо);
			Если НРег(Инфо.kind) = НРег("CommonModules") И Инфо.objectName <> "" Тогда
				Рез.Квалифицированные.Вставить(НРег(Инфо.objectName) + "." + НРег(Инфо.name), Инфо);
			КонецЕсли;
			ЭтоМенеджер = СтрЗаканчиваетсяНа(НРег(Путь), "\ext\managermodule.bsl");
			Если ЭтоМенеджер И Инфо.objectName <> "" Тогда
				Рус = КартаТиповПапок.Получить(Инфо.kind);
				Если Рус <> Неопределено Тогда
					Рез.Квалифицированные.Вставить(НРег(Рус) + "." + НРег(Инфо.objectName) + "." + НРег(Инфо.name), Инфо);
					Рез.Квалифицированные.Вставить(НРег(Инфо.kind) + "." + НРег(Инфо.objectName) + "." + НРег(Инфо.name), Инфо);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Если Лок.Количество() > 0 Тогда
			Рез.ПоПути.Вставить(НРег(Путь), Лок);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПереписатьВызовы(Знач Текст, ЛокальнаяКарта, Квалифицированные, ТолькоВставки) Экспорт
	Если (ЛокальнаяКарта = Неопределено Или ЛокальнаяКарта.Количество() = 0)
		И (Квалифицированные = Неопределено Или Квалифицированные.Количество() = 0) Тогда
		Возврат Новый Структура("Текст, count", Текст, 0);
	КонецЕсли;
	Если Не ЕстьКандидатыЗамены(Текст, ЛокальнаяКарта, Квалифицированные) Тогда
		Возврат Новый Структура("Текст, count", Текст, 0);
	КонецЕсли;
	Замен = 0;
	Длина = СтрДлина(Текст);
	// Текст копируется кусками между заменами (без посимвольной конкатенации — O(n)).
	Части = Новый Массив;
	ПозКопии = 1;
	Й = 1;
	НомСтроки = 1;
	ВСтроке = Ложь;
	Вставка = Не ТолькоВставки;
	ПослеОбъявления = Ложь;
	Пока Й <= Длина Цикл
		С = Сред(Текст, Й, 1);
		Если ВСтроке Тогда
			Если С = """" Тогда
				Если Сред(Текст, Й + 1, 1) = """" Тогда
					Й = Й + 2;
					Продолжить;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			ИначеЕсли С = Символы.ПС Тогда
				НомСтроки = НомСтроки + 1;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ВСтроке = Истина;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = "/" И Сред(Текст, Й + 1, 1) = "/" Тогда
			Пока Й <= Длина И Сред(Текст, Й, 1) <> Символы.ПС Цикл
				Й = Й + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если С = Символы.ПС Тогда
			НомСтроки = НомСтроки + 1;
			Й = Й + 1;
			// директива препроцессора на следующей строке проверяется при чтении идентификатора/#
			Продолжить;
		КонецЕсли;
		Если С = "#" И ТолькоВставки Тогда
			НачСтр = Й;
			Пока НачСтр > 1 И Сред(Текст, НачСтр - 1, 1) <> Символы.ПС Цикл
				НачСтр = НачСтр - 1;
			КонецЦикла;
			Если НачСтр = Й Или СокрЛП(Сред(Текст, НачСтр, Й - НачСтр)) = "" Тогда
				КонСтр = Й;
				Пока КонСтр <= Длина И Сред(Текст, КонСтр, 1) <> Символы.ПС Цикл
					КонСтр = КонСтр + 1;
				КонецЦикла;
				Дир = НРег(СокрЛП(Разбор.УбратьКомментарий(Сред(Текст, Й, КонСтр - Й))));
				Если Дир = "#вставка" Или Дир = "#insert" Тогда
					Вставка = Истина;
				ИначеЕсли Дир = "#конецвставки" Или Дир = "#endinsert" Тогда
					Вставка = Ложь;
				КонецЕсли;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если Не ЭтоНачалоИдентификатора(С) Тогда
			Если С <> " " И С <> Символы.Таб И С <> Символы.ВК И С <> Символы.ПС Тогда
				ПослеОбъявления = Ложь;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		// прочитать цепочку идентификаторов с точками и скобку
		НачЦеп = Й;
		Иденты = Новый Массив;
		Поз = Й;
		Пока Истина Цикл
			Ид = ПрочитатьИдентификатор(Текст, Поз, Длина);
			Иденты.Добавить(Новый Структура("name, start, finish", Ид.name, Ид.start, Ид.finish));
			Поз = ПропуститьПробелы(Текст, Ид.finish, Длина);
			Если Поз <= Длина И Сред(Текст, Поз, 1) = "." Тогда
				Поз = ПропуститьПробелы(Текст, Поз + 1, Длина);
				Продолжить;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Если Поз <= Длина И Сред(Текст, Поз, 1) = "(" Тогда
			ЭтоОбъяв = ПослеОбъявления Или ЭтоКлючевоеОбъявлениеЦепочки(Иденты);
			ПослеОбъявления = Ложь;
			Если Не Вставка Или ЭтоОбъяв Тогда
				Й = Поз;
				Продолжить;
			КонецЕсли;
			Арг = ПосчитатьАргументы(Текст, Поз, Длина);
			Инфо = НайтиИнфоВызова(Иденты, ЛокальнаяКарта, Квалифицированные);
			Если Инфо <> Неопределено И НужноПереименоватьВызов(Инфо.sigUp, Инфо.sigBp, Арг.argc) Тогда
				Посл = Иденты[Иденты.Количество() - 1];
				Части.Добавить(Сред(Текст, ПозКопии, Посл.start - ПозКопии));
				Части.Добавить(Инфо.newName);
				ПозКопии = Посл.finish;
				Замен = Замен + 1;
				Й = Поз;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		ПослеОбъявления = ЭтоОбъявляющееСлово(Иденты);
		Й = Поз;
	КонецЦикла;
	Если Замен = 0 Тогда
		Возврат Новый Структура("Текст, count", Текст, 0);
	КонецЕсли;
	Части.Добавить(Сред(Текст, ПозКопии));
	Возврат Новый Структура("Текст, count", СтрСоединить(Части, ""), Замен);
КонецФункции

// Быстрый отсев: замена возможна, только если в тексте встречается имя метода из карт.
Функция ЕстьКандидатыЗамены(Текст, ЛокальнаяКарта, Квалифицированные)
	Имена = ИменаКартДляОтсева(ЛокальнаяКарта, Квалифицированные);
	НТекст = НРег(Текст);
	Для Каждого КЗ Из Имена Цикл
		Если СтрНайти(НТекст, КЗ.Ключ) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ИменаКартДляОтсева(ЛокальнаяКарта, Квалифицированные)
	Имена = Новый Соответствие;
	Если ЛокальнаяКарта <> Неопределено Тогда
		Для Каждого КЗ Из ЛокальнаяКарта Цикл
			Имена.Вставить(НРег(КЗ.Ключ), Истина);
		КонецЦикла;
	КонецЕсли;
	Если Квалифицированные <> Неопределено Тогда
		Если КэшИменКвалиф = Неопределено Или КэшКвалиф <> Квалифицированные Тогда
			КэшИменКвалиф = Новый Соответствие;
			Для Каждого КЗ Из Квалифицированные Цикл
				Ч = СтрРазделить(КЗ.Ключ, ".");
				КэшИменКвалиф.Вставить(НРег(Ч[Ч.ВГраница()]), Истина);
			КонецЦикла;
			КэшКвалиф = Квалифицированные;
		КонецЕсли;
		Для Каждого КЗ Из КэшИменКвалиф Цикл
			Имена.Вставить(КЗ.Ключ, Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Имена;
КонецФункции

Функция ЭтоНачалоИдентификатора(С)
	К = КодСимвола(С);
	Возврат (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105 Или С = "_";
КонецФункции

Функция ПрочитатьИдентификатор(Текст, Нач, Длина)
	Й = Нач;
	Пока Й <= Длина И ЭтоЛитералИдентификатора(Сред(Текст, Й, 1)) Цикл
		Й = Й + 1;
	КонецЦикла;
	Возврат Новый Структура("name, start, finish", Сред(Текст, Нач, Й - Нач), Нач, Й);
КонецФункции

Функция ПропуститьПробелы(Текст, Нач, Длина)
	Й = Нач;
	Пока Й <= Длина Цикл
		С = Сред(Текст, Й, 1);
		Если С = " " Или С = Символы.Таб Или С = Символы.ВК Тогда
			Й = Й + 1;
		ИначеЕсли С = Символы.ПС Тогда
			Й = Й + 1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Й;
КонецФункции

// После «Процедура/Функция/Новый» следующий идентификатор со скобкой — объявление/конструктор, не вызов.
// После «Если/Возврат/Пока/…» идёт обычное выражение — вызовы в нём переписываются.
Функция ЭтоОбъявляющееСлово(Иденты)
	Если Иденты.Количество() <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(",процедура,функция,асинх,procedure,function,async,новый,new,", "," + НРег(Иденты[0].name) + ",") > 0;
КонецФункции

Функция ЭтоКлючевоеОбъявлениеЦепочки(Иденты)
	Если Иденты.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат КлючевыеОбъявления.Получить(НРег(Иденты[0].name)) = Истина;
КонецФункции

Функция ПосчитатьАргументы(Текст, ПозОткр, Длина) Экспорт
	Глубина = 0;
	ВСтроке = Ложь;
	Й = ПозОткр;
	Арг = 0;
	ЕстьСодерж = Ложь;
	Пока Й <= Длина Цикл
		С = Сред(Текст, Й, 1);
		Если ВСтроке Тогда
			Если С = """" Тогда
				Если Сред(Текст, Й + 1, 1) = """" Тогда
					Й = Й + 2;
					Продолжить;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ВСтроке = Истина;
			ЕстьСодерж = Истина;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = "/" И Сред(Текст, Й + 1, 1) = "/" И Глубина > 0 Тогда
			Пока Й <= Длина И Сред(Текст, Й, 1) <> Символы.ПС Цикл
				Й = Й + 1;
			КонецЦикла;
			Продолжить;
		КонецЕсли;
		Если С = "(" Тогда
			Глубина = Глубина + 1;
			Если Глубина > 1 Тогда
				ЕстьСодерж = Истина;
			КонецЕсли;
		ИначеЕсли С = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				// Ф(А,) — пропущенный последний аргумент тоже фактический параметр.
				Если ЕстьСодерж Или Арг > 0 Тогда
					Арг = Арг + 1;
				КонецЕсли;
				Возврат Новый Структура("argc, pos", Арг, Й + 1);
			КонецЕсли;
		ИначеЕсли С = "," И Глубина = 1 Тогда
			Арг = Арг + 1;
			ЕстьСодерж = Ложь;
		ИначеЕсли С <> " " И С <> Символы.Таб И С <> Символы.ВК И С <> Символы.ПС Тогда
			Если Глубина >= 1 Тогда
				ЕстьСодерж = Истина;
			КонецЕсли;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Новый Структура("argc, pos", Арг, Й);
КонецФункции

Функция НайтиИнфоВызова(Иденты, ЛокальнаяКарта, Квалифицированные)
	Если Иденты.Количество() = 1 Тогда
		Если ЛокальнаяКарта = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЛокальнаяКарта.Получить(НРег(Иденты[0].name));
	КонецЕсли;
	Если Квалифицированные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Иденты.Количество() = 2 Тогда
		Ключ = НРег(Иденты[0].name) + "." + НРег(Иденты[1].name);
		Возврат Квалифицированные.Получить(Ключ);
	КонецЕсли;
	Если Иденты.Количество() = 3 Тогда
		Ключ = НРег(Иденты[0].name) + "." + НРег(Иденты[1].name) + "." + НРег(Иденты[2].name);
		Возврат Квалифицированные.Получить(Ключ);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ТекстСЗаменойИмени(Текст, Иденты, НовоеИмя, НачЦеп, ПозСкобки)
	Посл = Иденты[Иденты.Количество() - 1];
	Возврат Сред(Текст, НачЦеп, Посл.start - НачЦеп) + НовоеИмя + Сред(Текст, Посл.finish, ПозСкобки - Посл.finish);
КонецФункции
