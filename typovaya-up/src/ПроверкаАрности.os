// Проверка арности вызовов в restored и extension: число фактических параметров против сигнатуры
// вызываемого метода. Основная конфигурация = restored поверх УП; в extension свои объявления
// модуля имеют приоритет. Вызовы внутри #Удаление, строки и комментарии не проверяются.

Перем Разбор;
Перем Контракт;
Перем Перенос;
Перем КэшМодулей;
Перем РвЛексем;
Перем РвВызов;
Перем КартаРусТипов;

Процедура Инициализировать(МодульРазбора, МодульКонтракта, МодульПереноса) Экспорт
	Разбор = МодульРазбора;
	Контракт = МодульКонтракта;
	Перенос = МодульПереноса;
	КэшМодулей = Новый Соответствие;
	РвЛексем = Новый РегулярноеВыражение("""(?:[^""]|"""")*""|//[^\n]*");
	РвЛексем.Многострочный = Ложь;
	РвВызов = Новый РегулярноеВыражение("(?<![A-Za-zА-яЁё0-9_.&])((?:[A-Za-zА-яЁё_][A-Za-zА-яЁё0-9_]*[ \t]*\.[ \t]*){0,2}[A-Za-zА-яЁё_][A-Za-zА-яЁё0-9_]*)[ \t]*\(");
	КартаРусТипов = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("справочники:Catalogs,документы:Documents,регистрысведений:InformationRegisters,"
		+ "регистрынакопления:AccumulationRegisters,регистрыбухгалтерии:AccountingRegisters,регистрырасчета:CalculationRegisters,"
		+ "планывидовхарактеристик:ChartsOfCharacteristicTypes,планысчетов:ChartsOfAccounts,планывидоврасчета:ChartsOfCalculationTypes,"
		+ "планыобмена:ExchangePlans,бизнеспроцессы:BusinessProcesses,задачи:Tasks,обработки:DataProcessors,отчеты:Reports,"
		+ "журналыдокументов:DocumentJournals,перечисления:Enums", ",") Цикл
		Ч = СтрРазделить(Пара, ":");
		КартаРусТипов.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
КонецПроцедуры

// Возвращаемое значение: Структура checked, broken, too_many, too_few, byModule, items.
Функция Проверить(КаталогВыхода, КореньУп) Экспорт
	Рез = Новый Структура("checked, broken, too_many, too_few, restored, extension, items", 0, 0, 0, 0, 0, 0, Новый Массив);
	Корни = Новый Структура("restored, extension, up", ОбъединитьПути(КаталогВыхода, "restored"),
		ОбъединитьПути(КаталогВыхода, "extension"), КореньУп);
	Для Каждого Сторона Из СтрРазделить("restored,extension", ",") Цикл
		Кат = Корни[Сторона];
		Если Не (Новый Файл(Кат)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
			Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, СтрДлина(Кат) + 2), "/", "\");
			ПроверитьМодуль(Отн, ПрочитатьТекст(Ф.ПолноеИмя), Сторона, Корни, Рез);
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура ПроверитьМодуль(Отн, Текст, Сторона, Корни, Рез)
	Чистый = ОчиститьТекст(Текст, Сторона = "extension");
	Длина = СтрДлина(Чистый);
	НачалаСтрок = Новый Массив;
	Для Каждого Сов Из РвВызов.НайтиСовпадения(Чистый) Цикл
		Цепь = Сов.Группы[1].Значение;
		Части = СтрРазделить(СтрЗаменить(СтрЗаменить(Цепь, " ", ""), Символы.Таб, ""), ".", Ложь);
		Сиг = НайтиСигнатуру(Части, Отн, Сторона, Корни);
		Если Сиг = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПозСкобки = Сов.Индекс + Сов.Длина; // 1-based позиция «(»
		Арг = Перенос.ПосчитатьАргументы(Чистый, ПозСкобки, Длина);
		Рез.checked = Рез.checked + 1;
		Факт = Арг.argc;
		Если Факт >= Сиг.required И Факт <= Сиг.total Тогда
			Продолжить;
		КонецЕсли;
		Вид = ?(Факт > Сиг.total, "too_many", "too_few");
		Рез.broken = Рез.broken + 1;
		Рез[Вид] = Рез[Вид] + 1;
		Рез[Сторона] = Рез[Сторона] + 1;
		Строка_ = СтрЧислоСтрок(Лев(Чистый, ПозСкобки));
		Рез.items.Добавить(Новый Структура("side, module, line, call, args, required, total, kind, target",
			Сторона, Отн, Строка_, СтрСоединить(Части, "."), Факт, Сиг.required, Сиг.total, Вид, Сиг.module));
	КонецЦикла;
КонецПроцедуры

// Текст без комментариев, литералов ("" на месте строки), директив, аннотаций, объявлений
// и (для extension) без блоков #Удаление; число строк сохраняется.
Функция ОчиститьТекст(Текст, ЭтоРасширение)
	Части = Новый Массив;
	Поз = 1;
	Для Каждого Сов Из РвЛексем.НайтиСовпадения(Текст) Цикл
		Нач = Сов.Индекс + 1;
		Части.Добавить(Сред(Текст, Поз, Нач - Поз));
		Знач_ = Сов.Значение;
		Если Лев(Знач_, 1) = """" Тогда
			Части.Добавить("""""" + ПереводыСтрок(Знач_));
		КонецЕсли;
		Поз = Нач + Сов.Длина;
	КонецЦикла;
	Части.Добавить(Сред(Текст, Поз));
	Строки = СтрРазделить(СтрСоединить(Части, ""), Символы.ПС, Истина);
	ВУдалении = Ложь;
	Для Й = 0 По Строки.ВГраница() Цикл
		С = НРег(СокрЛП(Строки[Й]));
		Если ЭтоРасширение И (СтрНачинаетсяС(С, "#удаление") Или СтрНачинаетсяС(С, "#delete")) Тогда
			ВУдалении = Истина;
			Строки[Й] = "";
		ИначеЕсли ЭтоРасширение И (СтрНачинаетсяС(С, "#конецудаления") Или СтрНачинаетсяС(С, "#enddelete")) Тогда
			ВУдалении = Ложь;
			Строки[Й] = "";
		ИначеЕсли ВУдалении Или СтрНачинаетсяС(С, "#") Или СтрНачинаетсяС(С, "&") Тогда
			Строки[Й] = "";
		ИначеЕсли Разбор.РазобратьОбъявление(Строки[Й]) <> Неопределено Тогда
			Строки[Й] = "";
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ПереводыСтрок(Знач С)
	Н = СтрЧислоВхождений(С, Символы.ПС);
	Рез = "";
	Для Й = 1 По Н Цикл
		Рез = Рез + Символы.ПС;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция НайтиСигнатуру(Части, Отн, Сторона, Корни)
	Имя = НРег(Части[Части.ВГраница()]);
	Если Части.Количество() = 1 Тогда
		ПутьЦели = Отн;
	ИначеЕсли Части.Количество() = 2 Тогда
		ПутьЦели = "CommonModules\" + Части[0] + "\Ext\Module.bsl";
	Иначе
		Папка = КартаРусТипов.Получить(НРег(Части[0]));
		Если Папка = Неопределено Тогда
			Папка = Части[0];
		КонецЕсли;
		ПутьЦели = Папка + "\" + Части[1] + "\Ext\ManagerModule.bsl";
	КонецЕсли;
	Если Сторона = "extension" Тогда
		Сиг = МетодыМодуля(Корни.extension, ПутьЦели).Получить(Имя);
		Если Сиг <> Неопределено Тогда
			Возврат Сиг;
		КонецЕсли;
	КонецЕсли;
	Мет = МетодыМодуля(Корни.restored, ПутьЦели);
	Если Мет.Количество() = 0 Тогда
		Мет = МетодыМодуля(Корни.up, ПутьЦели);
	КонецЕсли;
	Сиг = Мет.Получить(Имя);
	Если Сиг <> Неопределено И Части.Количество() > 1 И Не Сиг.export Тогда
		Возврат Неопределено; // неэкспортный — не вызов этого метода (или другая ошибка, не арность)
	КонецЕсли;
	Возврат Сиг;
КонецФункции

// Соответствие имя (нрег) → Структура(required, total, export, module); кэш по пути.
Функция МетодыМодуля(Корень, Отн)
	Ключ = Корень + "|" + НРег(Отн);
	Р = КэшМодулей.Получить(Ключ);
	Если Р <> Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Р = Новый Соответствие;
	Путь = ОбъединитьПути(Корень, СтрЗаменить(Отн, "\", ПолучитьРазделительПути()));
	Если (Новый Файл(Путь)).Существует() Тогда
		Для Каждого Мт Из Разбор.РазобратьМодуль(ПрочитатьТекст(Путь)).Методы Цикл
			Если Р.Получить(Мт.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			К = Неопределено;
			Попытка
				К = Контракт.РазобратьКонтракт(Мт.Текст, Разбор);
			Исключение
				К = Неопределено;
			КонецПопытки;
			Если К = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Обяз = 0;
			Для Каждого П Из К.Параметры Цикл
				Если СокрЛП(Строка(П.Дефолт)) = "" Тогда
					Обяз = Обяз + 1;
				КонецЕсли;
			КонецЦикла;
			Р.Вставить(Мт.Ключ, Новый Структура("required, total, export, module", Обяз, К.Параметры.Количество(), К.Экспорт, Отн));
		КонецЦикла;
	КонецЕсли;
	КэшМодулей.Вставить(Ключ, Р);
	Возврат Р;
КонецФункции

Функция ПрочитатьТекст(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", СтрЗаменить(Т, Символы.ВК, ""));
КонецФункции
