// Проход по всем Form.xml: только ПодготовитьFormXmlКIbcmd (Picture/style).
// --type-soft: точечно по ibcmd, НЕ массово на заимствованных формах (ломает DynamicList).
Фр = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФормыRestored.os"));
Корень = "D:\typovaya-up-out-20261118u\extension";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Корень = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Н = 0;
Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
	Т = Фр.ПрочитатьТекстUtf8(Ф.ПолноеИмя);
	Если Т = "" Тогда
		Продолжить;
	КонецЕсли;
	Нов = Фр.ПодготовитьFormXmlКIbcmd(Т);
	Если АргументыКоманднойСтроки.Количество() > 1 Тогда
		Фл = СокрЛП(АргументыКоманднойСтроки[1]);
		Если Фл = "--type" Тогда
			Нов = Фр.ДопостобработкаFormXmlНаДиске(Нов);
		ИначеЕсли Фл = "--type-soft" Тогда
			Нов = Фр.ДопостобработкаТиповIbcmd(Нов);
		ИначеЕсли Фл = "--type-min" Тогда
			Нов = Фр.ДопостобработкаТиповIbcmdМинимум(Нов);
		КонецЕсли;
	КонецЕсли;
	Если Нов <> Т Тогда
		ПолучитьДвоичныеДанныеИзСтроки(Нов, КодировкаТекста.UTF8, Истина).Записать(Ф.ПолноеИмя);
		Н = Н + 1;
	КонецЕсли;
КонецЦикла;
Сообщить("ibcmd Form.xml touch: " + Н);