// Убрать из ChildObjects ссылки на формы, для которых нет каталога Forms/<имя> в расширении.
КореньСк = ТекущийСценарий().Каталог;
КаталогРасш = "D:\typovaya-up-out-20261118u\extension";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	КаталогРасш = АргументыКоманднойСтроки[0];
КонецЕсли;
Типы = "Catalogs,Documents,DocumentJournals,Reports,DataProcessors,InformationRegisters,"
	+ "ChartsOfCharacteristicTypes,Enums,CommonForms";
Удалено = 0;
Файлов = 0;
Рв = Новый РегулярноеВыражение("(?m)^\t\t\t<Form>([^<]+)</Form>\r?\n");
Для Каждого Т Из СтрРазделить(Типы, ",") Цикл
	Пап = ОбъединитьПути(КаталогРасш, Т);
	Если Не (Новый Файл(Пап)).Существует() Тогда
		Продолжить;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Пап, "*.xml", Ложь) Цикл
		ИмяОб = Лев(Ф.Имя, СтрДлина(Ф.Имя) - 4);
		КатОб = ОбъединитьПути(Пап, ИмяОб);
		Тд = Новый ТекстовыйДокумент;
		Попытка
			Тд.Прочитать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
		Исключение
			Продолжить;
		КонецПопытки;
		Текст = Тд.ПолучитьТекст();
		Нов = Текст;
		Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
			ИмяФ = С.Группы[1].Значение;
			ПутьФ = ОбъединитьПути(КатОб, "Forms", ИмяФ);
			Если Не (Новый Файл(ОбъединитьПути(ПутьФ, "Ext", "Form.xml")).Существует()
				Или (Новый Файл(ПутьФ + ".xml")).Существует()) Тогда
				Нов = СтрЗаменить(Нов, С.Значение, "");
				Удалено = Удалено + 1;
			КонецЕсли;
		КонецЦикла;
		Если Нов <> Текст Тогда
			Тд.УстановитьТекст(Нов);
			Тд.Записать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
			Файлов = Файлов + 1;
		КонецЕсли;
	КонецЦикла;
КонецЦикла;
Сообщить("form refs removed: " + Удалено + ", files touched: " + Файлов);