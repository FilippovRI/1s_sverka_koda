// Быстрый режим restored: метаданные УП, тексты .bsl и Form.xml — дословно из БП где есть путь.

Функция ЗаменитьМодулиBslИзБп(КореньRestored, КореньБп, Лог) Экспорт
	Если Не (Новый Файл(КореньRestored)).Существует() Или Не (Новый Файл(КореньБп)).Существует() Тогда
		ВызватьИсключение "ЗаменитьМодулиBslИзБп: нет каталога restored или БП";
	КонецЕсли;
	Преф = НРег(КореньRestored);
	Если Не СтрЗаканчиваетсяНа(Преф, "\") Тогда
		Преф = Преф + "\";
	КонецЕсли;
	Дл = СтрДлина(Преф);
	Зам = 0;
	Для Каждого Ф Из НайтиФайлы(КореньRestored, "*.bsl", Истина) Цикл
		Отн = Сред(НРег(Ф.ПолноеИмя), Дл + 1);
		Исх = ОбъединитьПути(КореньБп, Отн);
		Если (Новый Файл(Исх)).Существует() Тогда
			КопироватьФайл(Исх, Ф.ПолноеИмя);
			Зам = Зам + 1;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("modulesForms: заменено модулей .bsl из БП: " + Зам);
	Возврат Зам;
КонецФункции

Функция ЗаменитьFormXmlИзБп(КореньRestored, КореньБп, Лог) Экспорт
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Заг.Инициализировать();
	Зам = Заг.ВернутьFormXmlИзБп(КореньRestored, КореньБп);
	Лог.Добавить("modulesForms: заменено Form.xml из БП: " + Зам);
	Возврат Зам;
КонецФункции

// Полный overlay restored: все .bsl и Form.xml, для которых есть путь в БП.
Функция ПрименитьДословноБпКRestored(КореньRestored, КореньБп, Лог) Экспорт
	Модули = ЗаменитьМодулиBslИзБп(КореньRestored, КореньБп, Лог);
	Формы = ЗаменитьFormXmlИзБп(КореньRestored, КореньБп, Лог);
	Возврат Новый Структура("modulesBsl, formsXml", Модули, Формы);
КонецФункции