// Быстрый режим restored: метаданные УП, тексты .bsl из БП (Form.xml и модули форм — из УП при --формы-из-уп).

Функция ЭтоПутьФормы(ОтнПуть) Экспорт
	Н = НРег(ОтнПуть);
	Возврат СтрНайти(Н, "\ext\form.xml") > 0 Или СтрНайти(Н, "\ext\form\module.bsl") > 0;
КонецФункции

Функция ЗаменитьМодулиBslИзБп(КореньRestored, КореньБп, Лог, БезМодулейФорм = Ложь) Экспорт
	Если Не (Новый Файл(КореньRestored)).Существует() Или Не (Новый Файл(КореньБп)).Существует() Тогда
		ВызватьИсключение "ЗаменитьМодулиBslИзБп: нет каталога restored или БП";
	КонецЕсли;
	Преф = КореньRestored;
	Если Не СтрЗаканчиваетсяНа(Преф, "\") Тогда
		Преф = Преф + "\";
	КонецЕсли;
	Дл = СтрДлина(Преф);
	Зам = 0;
	Для Каждого Ф Из НайтиФайлы(КореньRestored, "*.bsl", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, Дл + 1);
		Если БезМодулейФорм И ЭтоПутьФормы(Отн) Тогда
			Продолжить;
		КонецЕсли;
		Исх = ОбъединитьПути(КореньБп, Отн);
		Если (Новый Файл(Исх)).Существует() Тогда
			КопироватьФайл(Исх, Ф.ПолноеИмя);
			Зам = Зам + 1;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("modulesForms: заменено модулей .bsl из БП: " + Зам);
	Возврат Зам;
КонецФункции

Функция КореньUpПуть(Корень)
	П = НРег(Корень);
	Если Не СтрЗаканчиваетсяНа(П, "\") Тогда
		Возврат П + "\";
	КонецЕсли;
	Возврат П;
КонецФункции

Процедура ВернутьМодульФормыИзУп(ПутьFormRestored, КореньУп, Лог, КореньRestored)
	Преф = КореньRestored;
	Если Не СтрЗаканчиваетсяНа(Преф, "\") Тогда
		Преф = Преф + "\";
	КонецЕсли;
	Отн = Сред(ПутьFormRestored, СтрДлина(Преф) + 1);
	ПУп = ОбъединитьПути(КореньУп, Отн);
	ПМ = ОбъединитьПути((Новый Файл(ПУп)).Путь, "Form", "Module.bsl");
	ПМн = ОбъединитьПути((Новый Файл(ПутьFormRestored)).Путь, "Form", "Module.bsl");
	Если (Новый Файл(ПМ)).Существует() Тогда
		СоздатьКаталог((Новый Файл(ПМн)).Путь);
		КопироватьФайл(ПМ, ПМн);
	КонецЕсли;
КонецПроцедуры

// Overlay Form.xml: БП, кроме путей из Соответствие(path->reason) — оставить УП + модуль формы УП.
Функция ЗаменитьFormXmlИзБп(КореньRestored, КореньБп, КореньУп, ИсключитьПути, Лог) Экспорт
	Зам = 0;
	Оставлено = 0;
	Преф = НРег(КореньRestored);
	Если Не СтрЗаканчиваетсяНа(Преф, "\") Тогда
		Преф = Преф + "\";
	КонецЕсли;
	Дл = СтрДлина(Преф);
	Для Каждого Ф Из НайтиФайлы(КореньRestored, "Form.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Ext\Form.xml") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, Дл + 1);
		Если ИсключитьПути.Получить(Отн) <> Неопределено Тогда
			ПУп = ОбъединитьПути(КореньУп, Отн);
			Если (Новый Файл(ПУп)).Существует() Тогда
				КопироватьФайл(ПУп, Ф.ПолноеИмя);
				ВернутьМодульФормыИзУп(Ф.ПолноеИмя, КореньУп, Лог, КореньRestored);
			КонецЕсли;
			Оставлено = Оставлено + 1;
			Продолжить;
		КонецЕсли;
		Исх = ОбъединитьПути(КореньБп, Отн);
		Если (Новый Файл(Исх)).Существует() Тогда
			КопироватьФайл(Исх, Ф.ПолноеИмя);
			Зам = Зам + 1;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("modulesForms: заменено Form.xml из БП: " + Зам + ", оставлено УП: " + Оставлено);
	Возврат Новый Структура("replaced, keptUp", Зам, Оставлено);
КонецФункции

Функция СобратьИсключенияForm(Предчек)
	Иск = Новый Соответствие;
	Для Каждого Э Из Предчек.items Цикл
		Иск.Вставить(Э.path, Э.reason);
	КонецЦикла;
	Возврат Иск;
КонецФункции

Процедура УбратьЗаимствованныеФормыИзРасширения(КореньВыход, ФормыУп, Лог) Экспорт
	КатРасш = ОбъединитьПути(КореньВыход, "extension");
	Если Не (Новый Файл(КатРасш)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Сч = 0;
	Для Каждого Э Из ФормыУп Цикл
		Отн = Э.path;
		// Catalogs\X\Forms\Y\Ext\Form.xml -> удалить заимствованный Form.xml/Form в extension с тем же путём
		ПРасш = ОбъединитьПути(КатРасш, Отн);
		ПМ = ОбъединитьПути((Новый Файл(ПРасш)).Путь, "Form");
		Если (Новый Файл(ПМ)).Существует() Тогда
			УдалитьФайлы(ПМ);
		КонецЕсли;
		Если (Новый Файл(ПРасш)).Существует() Тогда
			УдалитьФайлы(ПРасш);
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("formsKeptUp: убрано тел форм в extension: " + Сч);
КонецПроцедуры

// Снять все заимствованные Form.xml / Form\ в extension (режим «формы только из УП»).
Процедура УбратьВсеТелаФормИзРасширения(КореньВыход, Лог) Экспорт
	КатРасш = ОбъединитьПути(КореньВыход, "extension");
	Если Не (Новый Файл(КатРасш)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Сч = 0;
	Для Каждого Ф Из НайтиФайлы(КатРасш, "Form.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Ext\Form.xml") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПМ = ОбъединитьПути((Новый Файл(Ф.ПолноеИмя)).Путь, "Form");
		Если (Новый Файл(ПМ)).Существует() Тогда
			УдалитьФайлы(ПМ);
		КонецЕсли;
		УдалитьФайлы(Ф.ПолноеИмя);
		Сч = Сч + 1;
	КонецЦикла;
	Лог.Добавить("formsFromUp: убрано тел форм в extension: " + Сч);
КонецПроцедуры

Функция ВосстановитьВсеФормыИзУп(КореньRestored, КореньУп, Лог) Экспорт
	Зам = 0;
	Преф = КореньRestored;
	Если Не СтрЗаканчиваетсяНа(Преф, "\") Тогда
		Преф = Преф + "\";
	КонецЕсли;
	Дл = СтрДлина(Преф);
	Для Каждого Ф Из НайтиФайлы(КореньRestored, "Form.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Ext\Form.xml") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, Дл + 1);
		ПУп = ОбъединитьПути(КореньУп, Отн);
		Если (Новый Файл(ПУп)).Существует() Тогда
			КопироватьФайл(ПУп, Ф.ПолноеИмя);
			ВернутьМодульФормыИзУп(Ф.ПолноеИмя, КореньУп, Лог, КореньRestored);
			Зам = Зам + 1;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("formsFromUp: Form.xml+модуль формы восстановлено из УП: " + Зам);
	Возврат Зам;
КонецФункции

// Overlay: из БП только не-форменные .bsl; формы целиком из УП; заимствования форм в extension снимаются.
Функция ПрименитьМодулиБпФормыИзУп(КореньRestored, КореньБп, КореньУп, Лог, КореньВыход = "") Экспорт
	Если КореньУп = "" Тогда
		ВызватьИсключение "ПрименитьМодулиБпФормыИзУп: нужен КореньУп";
	КонецЕсли;
	Модули = ЗаменитьМодулиBslИзБп(КореньRestored, КореньБп, Лог, Истина);
	Форм = ВосстановитьВсеФормыИзУп(КореньRestored, КореньУп, Лог);
	Если КореньВыход <> "" Тогда
		УбратьВсеТелаФормИзРасширения(КореньВыход, Лог);
	КонецЕсли;
	ПустПредчек = Новый Структура("checked, incompatible, items, topReasons", 0, 0, Новый Массив, Новый Массив);
	Возврат Новый Структура("modulesBsl, formsXml, formsKeptUp, formPrecheck, formsFromUp, formsUpRestored",
		Модули, 0, Новый Массив, ПустПредчек, Истина, Форм);
КонецФункции

// Полный overlay: bsl из БП; Form.xml с учётом совместимости (предчек).
Функция ПрименитьДословноБпКRestored(КореньRestored, КореньБп, КореньУп, Лог, КореньВыход = "") Экспорт
	Если КореньУп = "" Тогда
		ВызватьИсключение "ПрименитьДословноБпКRestored: нужен КореньУп";
	КонецЕсли;
	Пров = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ПроверкаЗамкнутости.os"));
	Предчек = Пров.ПредчекOverlayFormBp(КореньRestored, КореньБп, КореньУп);
	Лог.Добавить("formPrecheck: проверено " + Предчек.checked + ", несовместимо " + Предчек.incompatible);
	Иск = СобратьИсключенияForm(Предчек);
	Модули = ЗаменитьМодулиBslИзБп(КореньRestored, КореньБп, Лог);
	РФ = ЗаменитьFormXmlИзБп(КореньRestored, КореньБп, КореньУп, Иск, Лог);
	Если КореньВыход <> "" Тогда
		УбратьЗаимствованныеФормыИзРасширения(КореньВыход, Предчек.items, Лог);
	КонецЕсли;
	Возврат Новый Структура("modulesBsl, formsXml, formsKeptUp, formPrecheck",
		Модули, РФ.replaced, Предчек.items, Предчек);
КонецФункции