// restored + расширение в InfoBase_ModCheck (не InfoBase3). Платформа 8.5.1.1150.
// oscript ИмпортModCheck.os [каталог выхода] [--only-ext]
КореньСк = ТекущийСценарий().Каталог;
Oscript = "C:\Users\rst_filippov\OneScript\bin\oscript.exe";
Кав = Символ(34);
Иб = "C:\Program Files\1cv8\8.5.1.1150\bin\ibcmd.exe";
ИбБаза = "C:\Users\rst_filippov\Documents\InfoBase_ModCheck";
ИмяРасш = "УП_Доработки";
Выход = "D:\typovaya-up-out-20261118u";
ТолькоРасш = Ложь;
Для Каждого Арг Из АргументыКоманднойСтроки Цикл
	А = СокрЛП(Арг);
	Если А = "--only-ext" Тогда
		ТолькоРасш = Истина;
	ИначеЕсли Не ПустаяСтрока(А) И А <> "--only-ext" Тогда
		Выход = А;
	КонецЕсли;
КонецЦикла;
КореньРасш = ОбъединитьПути(Выход, "extension");
КореньВосст = ОбъединитьПути(Выход, "restored");
ЛогОсн = ОбъединитьПути(Выход, "modcheck-import-main.log");
ЛогРасш = ОбъединитьПути(Выход, "modcheck-import-ext.log");

Если Не ТолькоРасш Тогда
	ПутьКонф = ОбъединитьПути(КореньВосст, "Configuration.xml");
	Если Не (Новый Файл(ПутьКонф)).Существует() Тогда
		ВызватьИсключение "нет restored/Configuration.xml";
	КонецЕсли;
	Если Не (Новый Файл(ОбъединитьПути(КореньВосст, "ConfigDumpInfo.xml"))).Существует() Тогда
		Сообщить("WARN: нет restored/ConfigDumpInfo.xml");
	КонецЕсли;
	Сообщить("gate extension…");
	Кг = Новый КомандаОС();
	Кг.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав + ОбъединитьПути(КореньСк, "ГейтПередИмпортом.os") + Кав + " " + Кав + КореньРасш + Кав);
	Кг.ИспользоватьВыводКакРезультат = Ложь;
	Кг.Исполнить();
	Если Кг.КодВозврата <> 0 Тогда
		ВызватьИсключение "pre-import gate failed";
	КонецЕсли;
	Сообщить("import main restored…");
	КодОсн = 0;
	Км = Новый КомандаОС();
	Км.УстановитьКоманду(Кав + Иб + Кав + " infobase config import --db-path=" + Кав + ИбБаза + Кав + " " + Кав + КореньВосст + Кав + " > " + Кав + ЛогОсн + Кав + " 2>&1");
	Км.ИспользоватьВыводКакРезультат = Ложь;
	Км.Исполнить();
	КодОсн = Км.КодВозврата;
	Сообщить("import main exit " + КодОсн);
	Кс = Новый КомандаОС();
	Кс.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав + ОбъединитьПути(КореньСк, "СводкаОшибокImport.os") + Кав + " " + Кав + ЛогОсн + Кав);
	Кс.ИспользоватьВыводКакРезультат = Ложь;
	Кс.Исполнить();
	Если КодОсн <> 0 Тогда
		ВызватьИсключение "import main failed";
	КонецЕсли;
	Сообщить("apply main --force…");
	Кап = Новый КомандаОС();
	ЛогApplyMain = ОбъединитьПути(Выход, "modcheck-apply-main.log");
	Кап.УстановитьКоманду(Кав + Иб + Кав + " infobase config apply --db-path=" + Кав + ИбБаза + Кав + " --force > " + Кав + ЛогApplyMain + Кав + " 2>&1");
	Кап.ИспользоватьВыводКакРезультат = Ложь;
	Кап.Исполнить();
	Сообщить("apply main exit " + Кап.КодВозврата);
	Если Кап.КодВозврата <> 0 Тогда
		ВызватьИсключение "apply main failed";
	КонецЕсли;
	Сообщить("export-verify main…");
	Кэ = Новый КомандаОС();
	ЛогExp = ОбъединитьПути(Выход, "modcheck-export-verify.log");
	ВремЭксп = ОбъединитьПути(Выход, "_modcheck_export_tmp");
	Кэ.УстановитьКоманду(Кав + Иб + Кав + " infobase config export --db-path=" + Кав + ИбБаза + Кав + " " + Кав + ВремЭксп + Кав + " > " + Кав + ЛогExp + Кав + " 2>&1");
	Кэ.ИспользоватьВыводКакРезультат = Ложь;
	Кэ.Исполнить();
	Сообщить("export-verify exit " + Кэ.КодВозврата);
	Кд = Новый КомандаОС();
	Кд.УстановитьКоманду(Кав + Иб + Кав + " infobase config extension delete --db-path=" + Кав + ИбБаза + Кав + " --name=" + ИмяРасш + " > " + Кав + ЛогОсн + ".delete" + Кав + " 2>&1");
	Кд.ИспользоватьВыводКакРезультат = Ложь;
	Кд.Исполнить();
КонецЕсли;
Сообщить("import extension…");
Кр = Новый КомандаОС();
Кр.УстановитьКоманду(Кав + Иб + Кав + " infobase config import --db-path=" + Кав + ИбБаза + Кав + " --extension=" + ИмяРасш + " " + Кав + КореньРасш + Кав + " > " + Кав + ЛогРасш + Кав + " 2>&1");
Кр.ИспользоватьВыводКакРезультат = Ложь;
Кр.Исполнить();
КодРасш = Кр.КодВозврата;
Сообщить("import extension exit " + КодРасш);
Кс2 = Новый КомандаОС();
Кс2.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав + ОбъединитьПути(КореньСк, "СводкаОшибокImport.os") + Кав + " " + Кав + ЛогРасш + Кав);
Кс2.ИспользоватьВыводКакРезультат = Ложь;
Кс2.Исполнить();
Если КодРасш <> 0 Тогда
	ВызватьИсключение "import extension exit " + КодРасш;
КонецЕсли;
Сообщить("apply…");
ЛогApply = ОбъединитьПути(Выход, "modcheck-apply.log");
Ка = Новый КомандаОС();
Ка.УстановитьКоманду(Кав + Иб + Кав + " infobase config apply --db-path=" + Кав + ИбБаза + Кав + " --extension=" + ИмяРасш + " > " + Кав + ЛогApply + Кав + " 2>&1");
Ка.ИспользоватьВыводКакРезультат = Ложь;
Ка.Исполнить();
Сообщить("apply exit " + Ка.КодВозврата);
Сообщить("CheckModules…");
ЛогCm = ОбъединитьПути(Выход, "modcheck-checkmodules.log");
Кч = Новый КомандаОС();
Кч.УстановитьКоманду(Кав + Иб + Кав + " infobase config checkmodules --db-path=" + Кав + ИбБаза + Кав
	+ " --extension=" + ИмяРасш + " -ThinClient -Server -ExternalConnection > " + Кав + ЛогCm + Кав + " 2>&1");
Кч.ИспользоватьВыводКакРезультат = Ложь;
Кч.Исполнить();
Сообщить("checkmodules exit " + Кч.КодВозврата);