// Ссылки на общие модули в теле BSL vs дерево метаданных УП.

Функция ИменаОбщихМодулейВыгрузки(Корень) Экспорт
	Р = Новый Соответствие;
	Кат = ОбъединитьПути(Корень, "CommonModules");
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого П Из НайтиФайлы(Кат, "*.xml", Ложь) Цикл
		Имя = Лев(П.Имя, СтрДлина(П.Имя) - 4);
		Р.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СсылкиНаМодулиИзТекста(Текст) Экспорт
	Р = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		ДобавитьСсылкиИзСтроки(Стр, Р);
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ДобавитьСсылкиИзСтроки(Стр, Р)
	Дл = СтрДлина(Стр);
	П = 1;
	ВСтроке = Ложь;
	Пока П <= Дл Цикл
		С = Сред(Стр, П, 1);
		Если С = """" Тогда ВСтроке = Не ВСтроке; П = П + 1; Продолжить; КонецЕсли;
		Если ВСтроке Тогда П = П + 1; Продолжить; КонецЕсли;
		Если ЭтоБукваИли_(С) Тогда
			Имя = ПрочитатьИд(Стр, П);
			П2 = П + СтрДлина(Имя);
			Пока П2 <= Дл И (Сред(Стр, П2, 1) = " " Или Сред(Стр, П2, 1) = Символы.Таб) Цикл П2 = П2 + 1; КонецЦикла;
			Если П2 <= Дл И Сред(Стр, П2, 1) = "." Тогда
				Р.Вставить(Имя, Истина);
			КонецЕсли;
			П = П + СтрДлина(Имя);
			Продолжить;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоБукваИли_(С)
	К = КодСимвола(С);
	Возврат (К >= 1040 И К <= 1103) Или (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или С = "_";
КонецФункции

Функция ПрочитатьИд(Стр, П)
	Дл = СтрДлина(Стр);
	Р = "";
	Для Й = П По Дл Цикл
		С = Сред(Стр, Й, 1);
		Если ЭтоБукваИли_(С) Или (С >= "0" И С <= "9") Тогда
			Р = Р + С;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОтсутствующиеОбщиеМодули(Текст, НаборУп) Экспорт
	Р = Новый Массив;
	Ссылки = СсылкиНаМодулиИзТекста(Текст);
	Для Каждого КЗ Из Ссылки Цикл
		Если НаборУп.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Текст, НаборУп) Экспорт
	Возврат ОтсутствующиеОбщиеМодули(Текст, НаборУп).Количество();
КонецФункции

Функция ТелоБезопасноДляДереваУп(Текст, НаборУп) Экспорт
	Возврат ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Текст, НаборУп) = 0;
КонецФункции
