// Ссылки на общие модули в теле BSL vs дерево метаданных УП.
Перем КэшСсылок;
Перем РвИд;

Функция ИменаОбщихМодулейВыгрузки(Корень) Экспорт
	Р = Новый Соответствие;
	Кат = ОбъединитьПути(Корень, "CommonModules");
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого П Из НайтиФайлы(Кат, "*.xml", Ложь) Цикл
		Имя = Лев(П.Имя, СтрДлина(П.Имя) - 4);
		Р.Вставить(Имя, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СсылкиНаМодулиИзТекста(Текст) Экспорт
	Если КэшСсылок = Неопределено Тогда
		КэшСсылок = Новый Соответствие;
		РвИд = Новый РегулярноеВыражение("([A-Za-zА-яЁё_][A-Za-zА-яЁё_0-9]*)[ \t]*\.");
	КонецЕсли;
	Р = КэшСсылок.Получить(Текст);
	Если Р <> Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Р = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Если СтрНайти(Стр, ".") = 0 Тогда
			Продолжить;
		КонецЕсли;
		// Код — нечётные куски между кавычками (как переключатель ВСтроке в ДобавитьСсылкиИзСтроки).
		Куски = СтрРазделить(Стр, """", Истина);
		Для Й = 0 По Куски.ВГраница() Цикл
			Если Й % 2 = 1 Или СтрНайти(Куски[Й], ".") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Сов Из РвИд.НайтиСовпадения(Куски[Й]) Цикл
				Р.Вставить(Сов.Группы[1].Значение, Истина);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	КэшСсылок.Вставить(Текст, Р);
	Возврат Р;
КонецФункции

// Исходный посимвольный вариант (эталон для тестов эквивалентности).
Функция СсылкиНаМодулиИзТекстаПосимвольно(Текст) Экспорт
	Р = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		ДобавитьСсылкиИзСтроки(Стр, Р);
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ДобавитьСсылкиИзСтроки(Стр, Р)
	Дл = СтрДлина(Стр);
	П = 1;
	ВСтроке = Ложь;
	Пока П <= Дл Цикл
		С = Сред(Стр, П, 1);
		Если С = """" Тогда ВСтроке = Не ВСтроке; П = П + 1; Продолжить; КонецЕсли;
		Если ВСтроке Тогда П = П + 1; Продолжить; КонецЕсли;
		Если ЭтоБукваИли_(С) Тогда
			Имя = ПрочитатьИд(Стр, П);
			П2 = П + СтрДлина(Имя);
			Пока П2 <= Дл И (Сред(Стр, П2, 1) = " " Или Сред(Стр, П2, 1) = Символы.Таб) Цикл П2 = П2 + 1; КонецЦикла;
			Если П2 <= Дл И Сред(Стр, П2, 1) = "." Тогда
				Р.Вставить(Имя, Истина);
			КонецЕсли;
			П = П + СтрДлина(Имя);
			Продолжить;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
КонецПроцедуры

Функция ЭтоБукваИли_(С)
	К = КодСимвола(С);
	Возврат (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105 Или (К >= 65 И К <= 90) Или (К >= 97 И К <= 122) Или С = "_";
КонецФункции

Функция ПрочитатьИд(Стр, П)
	Дл = СтрДлина(Стр);
	Р = "";
	Для Й = П По Дл Цикл
		С = Сред(Стр, Й, 1);
		Если ЭтоБукваИли_(С) Или (С >= "0" И С <= "9") Тогда
			Р = Р + С;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОтсутствующиеОбщиеМодули(Текст, НаборУп) Экспорт
	Р = Новый Массив;
	Ссылки = СсылкиНаМодулиИзТекста(Текст);
	Для Каждого КЗ Из Ссылки Цикл
		Если НаборУп.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Текст, НаборУп) Экспорт
	Возврат ОтсутствующиеОбщиеМодули(Текст, НаборУп).Количество();
КонецФункции

Функция ТелоБезопасноДляДереваУп(Текст, НаборУп) Экспорт
	Возврат ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Текст, НаборУп) = 0;
КонецФункции

// Ссылки «Имя.» из текста БП, которые являются общими модулями поставщика и отсутствуют в УП.
// Локальные переменные (Запрос., Форма. и т.п.) не считаются: их нет среди общих модулей БП.
//
// Параметры:
//   Текст — тело метода БП; НаборУп, НаборБп — Соответствие имён общих модулей.
//
// Возвращаемое значение:
//   Массив имён.
Функция ОтсутствующиеОбщиеМодулиПоставщика(Текст, НаборУп, НаборБп) Экспорт
	Р = Новый Массив;
	Для Каждого КЗ Из СсылкиНаМодулиИзТекста(Текст) Цикл
		Если НаборБп.Получить(КЗ.Ключ) <> Неопределено И НаборУп.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции
