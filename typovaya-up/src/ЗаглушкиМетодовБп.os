// Заглушки методов БП в основной: метод БП (в restored — точно как в БП) обращается к объектам,
// реквизитам или значениям перечислений, которых нет в метаданных УП, и основная не компилируется.
// Источник — лог CheckConfig основной (ошибки компиляции с позицией {Объект.Модуль(строка,колонка)}):
// метод, содержащий строку с ошибкой, ищется в каталоге, который был загружен в базу при проверке
// (КореньПроверки), и глушится, только если там его текст совпадает с БП (ошибки в коде УП не глушатся).
// В заглушке сигнатура и директивы БП (препроцессорная обёртка метода остаётся вне его границ),
// тело — комментарий-маркер и для функции «Возврат Неопределено;». Хук &ИзменениеИКонтроль этого метода
// в расширении переписывается: доработка УП целиком в #Вставка, дальше — тело заглушки как в основной.
// Выгрузки БП/УП только читаются. Отчёт — stubbed_methods.json (модуль, метод, причина).

Перем Разбор;

Процедура Инициализировать(МодульРазбора) Экспорт
	Разбор = МодульРазбора;
КонецПроцедуры

Функция Маркер() Экспорт
	Возврат "// Заглушка typovaya-up: метод БП обращается к объектам/реквизитам, отсутствующим в УП";
КонецФункции

// ---------- Лог проверки ----------

// Ошибки модулей основной из лога CheckConfig. Массив Структура(object, line, message).
// Строки расширения («{ИмяРасширения Объект.Модуль(...)}») пропускаются.
Функция ОшибкиОсновнойИзЛога(Знач ТекстЛога) Экспорт
	Р = Новый Массив;
	Уже = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?m)^\{([^{}]+?)\((\d+),(\d+)\)\}:[ \t]*([^\r\n]*)");
	Для Каждого С Из Рв.НайтиСовпадения(ТекстЛога) Цикл
		Об = СокрЛП(С.Группы[1].Значение);
		Если СтрНайти(Об, " ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = НРег(Об) + "|" + С.Группы[2].Значение + "|" + С.Группы[4].Значение;
		Если Уже.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Ключ, Истина);
		Р.Добавить(Новый Структура("object, line, message", Об, Число(С.Группы[2].Значение), СокрЛП(С.Группы[4].Значение)));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КаталогТипа(Тип)
	Карта = Новый Соответствие;
	Для Каждого П Из СтрРазделить("ОбщийМодуль:CommonModules,Справочник:Catalogs,Документ:Documents,Обработка:DataProcessors,"
		+ "Отчет:Reports,Перечисление:Enums,РегистрСведений:InformationRegisters,РегистрНакопления:AccumulationRegisters,"
		+ "РегистрБухгалтерии:AccountingRegisters,РегистрРасчета:CalculationRegisters,ПланВидовХарактеристик:ChartsOfCharacteristicTypes,"
		+ "ПланСчетов:ChartsOfAccounts,ПланВидовРасчета:ChartsOfCalculationTypes,ПланОбмена:ExchangePlans,БизнесПроцесс:BusinessProcesses,"
		+ "Задача:Tasks,ЖурналДокументов:DocumentJournals,Константа:Constants,ОбщаяФорма:CommonForms,ОбщаяКоманда:CommonCommands,"
		+ "HTTPСервис:HTTPServices,WebСервис:WebServices,ВнешнийИсточникДанных:ExternalDataSources", ",") Цикл
		КЗ = СтрРазделить(П, ":");
		Карта.Вставить(НРег(КЗ[0]), КЗ[1]);
	КонецЦикла;
	Возврат Карта.Получить(НРег(Тип));
КонецФункции

// «Справочник.Х.МодульОбъекта» -> «Catalogs\Х\Ext\ObjectModule.bsl» (разделитель — Раздел); "" — не распознан.
Функция ОтносительныйПуть(Знач Объект, Знач Раздел = "\") Экспорт
	Ч = СтрРазделить(Объект, ".");
	Если Ч.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Кат = КаталогТипа(Ч[0]);
	Если Кат = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Файлы = Новый Соответствие;
	Файлы.Вставить("модуль", "Module.bsl");
	Файлы.Вставить("модульобъекта", "ObjectModule.bsl");
	Файлы.Вставить("модульменеджера", "ManagerModule.bsl");
	Файлы.Вставить("модульнаборазаписей", "RecordSetModule.bsl");
	Файлы.Вставить("модульменеджеразначения", "ValueManagerModule.bsl");
	Части = Новый Массив;
	Части.Добавить(Кат);
	Если Ч.Количество() = 3 И НРег(Ч[0]) = "общаяформа" И НРег(Ч[2]) = "форма" Тогда
		Части.Добавить(Ч[1]); Части.Добавить("Ext"); Части.Добавить("Form"); Части.Добавить("Module.bsl");
	ИначеЕсли Ч.Количество() = 3 И НРег(Ч[0]) = "общаякоманда" Тогда
		Части.Добавить(Ч[1]); Части.Добавить("Ext"); Части.Добавить("CommandModule.bsl");
	ИначеЕсли Ч.Количество() = 3 И Файлы.Получить(НРег(Ч[2])) <> Неопределено Тогда
		Части.Добавить(Ч[1]); Части.Добавить("Ext"); Части.Добавить(Файлы.Получить(НРег(Ч[2])));
	ИначеЕсли Ч.Количество() = 5 И НРег(Ч[2]) = "форма" Тогда
		Части.Добавить(Ч[1]); Части.Добавить("Forms"); Части.Добавить(Ч[3]); Части.Добавить("Ext"); Части.Добавить("Form"); Части.Добавить("Module.bsl");
	ИначеЕсли Ч.Количество() = 5 И НРег(Ч[2]) = "команда" Тогда
		Части.Добавить(Ч[1]); Части.Добавить("Commands"); Части.Добавить(Ч[3]); Части.Добавить("Ext"); Части.Добавить("CommandModule.bsl");
	Иначе
		Возврат "";
	КонецЕсли;
	Возврат СтрСоединить(Части, Раздел);
КонецФункции

// ---------- Файлы без потери BOM и CRLF ----------

Функция ПрочитатьФайл(Путь) Экспорт
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДД = Новый ДвоичныеДанные(Путь);
	Hex = "";
	Если ДД.Размер() >= 3 Тогда
		Поток = ДД.ОткрытьПотокДляЧтения();
		Буф = Новый БуферДвоичныхДанных(3);
		Поток.Прочитать(Буф, 0, 3);
		Поток.Закрыть();
		Hex = ПолучитьHexСтрокуИзБуфераДвоичныхДанных(Буф);
	КонецЕсли;
	Текст = ПолучитьСтрокуИзДвоичныхДанных(ДД, "UTF-8");
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	ЕстьВК = СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0;
	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Возврат Новый Структура("Текст, BOM, CRLF", Текст, ВРег(Hex) = "EFBBBF", ЕстьВК);
КонецФункции

Процедура ЗаписатьФайл(Путь, Знач Текст, BOM, CRLF) Экспорт
	Если CRLF Тогда
		Текст = СтрЗаменить(Текст, Символы.ПС, Символы.ВК + Символы.ПС);
	КонецЕсли;
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, BOM).Записать(Путь);
КонецПроцедуры

// ---------- Методы ----------

Функция МетодПоСтроке(Методы, НомерСтроки)
	Для Каждого Мт Из Методы Цикл
		Если Мт.Начало <= НомерСтроки И НомерСтроки <= Мт.Конец Тогда
			Возврат Мт;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция МетодПоИмени(Методы, Ключ)
	Для Каждого Мт Из Методы Цикл
		Если Мт.Ключ = Ключ Тогда
			Возврат Мт;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Индекс (0-based в строках метода) последней строки сигнатуры: объявление + закрывающая скобка параметров.
Функция КонецСигнатуры(Строки)
	Нач = -1;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если Разбор.РазобратьОбъявление(Строки[Й]) <> Неопределено Тогда
			Нач = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Нач < 0 Тогда
		Возврат -1;
	КонецЕсли;
	Глубина = 0;
	БылаСкобка = Ложь;
	Для Й = Нач По Строки.ВГраница() Цикл
		Чистая = Разбор.УбратьКомментарий(Строки[Й]);
		Если СтрНайти(Чистая, "(") > 0 Тогда
			БылаСкобка = Истина;
		КонецЕсли;
		Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
		Если БылаСкобка И Глубина <= 0 Тогда
			Возврат Й;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции

Функция ТелоЗаглушки(Вид)
	Т = Новый Массив;
	Т.Добавить(Символы.Таб + Маркер());
	Если НРег(Вид) = "функция" Тогда
		Т.Добавить(Символы.Таб + "Возврат Неопределено;");
	КонецЕсли;
	Возврат Т;
КонецФункции

// Текст метода-заглушки: строки до конца сигнатуры как есть, тело заглушки, строка конца метода как есть.
Функция ТекстЗаглушкиМетода(ТекстМетода, Вид) Экспорт
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	Кс = КонецСигнатуры(Строки);
	Если Кс < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Р = Новый Массив;
	Для Й = 0 По Кс Цикл
		Р.Добавить(Строки[Й]);
	КонецЦикла;
	Для Каждого С Из ТелоЗаглушки(Вид) Цикл
		Р.Добавить(С);
	КонецЦикла;
	Р.Добавить(Строки[Строки.ВГраница()]);
	Возврат СтрСоединить(Р, Символы.ПС);
КонецФункции

Функция ЭтоЗаглушка(ТекстМетода)
	Возврат СтрНайти(ТекстМетода, Маркер()) > 0;
КонецФункции

// Хук &ИзменениеИКонтроль под тело-заглушку: доработка УП (тело хука без #Удаление, без маркеров #Вставка)
// целиком в #Вставка, затем тело заглушки как в основной.
Функция ТекстХукаПодЗаглушку(ТекстХука, Вид) Экспорт
	Строки = СтрРазделить(ТекстХука, Символы.ПС, Истина);
	Кс = КонецСигнатуры(Строки);
	Если Кс < 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Р = Новый Массив;
	Для Й = 0 По Кс Цикл
		Р.Добавить(Строки[Й]);
	КонецЦикла;
	Р.Добавить("#Вставка");
	ВУдалении = Ложь;
	Для Й = Кс + 1 По Строки.ВГраница() - 1 Цикл
		С = НРег(СокрЛП(Строки[Й]));
		Если С = "#удаление" Тогда
			ВУдалении = Истина;
			Продолжить;
		ИначеЕсли С = "#конецудаления" Тогда
			ВУдалении = Ложь;
			Продолжить;
		ИначеЕсли С = "#вставка" Или С = "#конецвставки" Тогда
			Продолжить;
		КонецЕсли;
		Если Не ВУдалении Тогда
			Р.Добавить(Строки[Й]);
		КонецЕсли;
	КонецЦикла;
	Р.Добавить("#КонецВставки");
	Для Каждого С Из ТелоЗаглушки(Вид) Цикл
		Р.Добавить(С);
	КонецЦикла;
	Р.Добавить(Строки[Строки.ВГраница()]);
	Возврат СтрСоединить(Р, Символы.ПС);
КонецФункции

Функция ИмяИзИиК(ТекстМетода)
	Рв = Новый РегулярноеВыражение("(?i)&ИзменениеИКонтроль\s*\(\s*""([^""]+)""");
	С = Рв.НайтиСовпадения(ТекстМетода);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат НРег(С[0].Группы[1].Значение);
КонецФункции

// ---------- Отбор ----------

// Методы для заглушки по ошибкам лога. КореньПроверки — каталог, загруженный в базу при проверке
// (номера строк лога — по его файлам). Метод берётся, только если там его текст равен тексту БП.
// Результат: Структура(items — Массив Структура(module, method, kind, reasons), skipped — Массив строк).
Функция Отобрать(Ошибки, КореньПроверки, КореньБп) Экспорт
	Раздел = ПолучитьРазделительПути();
	Кэш = Новый Соответствие;
	Поиндексу = Новый Соответствие; // путь|метод -> элемент
	Элементы = Новый Массив;
	Пропуски = Новый Массив;
	УжеПропуск = Новый Соответствие;
	Для Каждого О Из Ошибки Цикл
		Отн = ОтносительныйПуть(О.object, Раздел);
		Если Отн = "" Тогда
			ДобавитьПропуск(Пропуски, УжеПропуск, О.object + ": модуль не распознан");
			Продолжить;
		КонецЕсли;
		Пр = РазобранныйФайл(Кэш, ОбъединитьПути(КореньПроверки, Отн));
		Бп = РазобранныйФайл(Кэш, ОбъединитьПути(КореньБп, Отн));
		Если Пр = Неопределено Тогда
			ДобавитьПропуск(Пропуски, УжеПропуск, Отн + ": нет файла в каталоге проверки");
			Продолжить;
		КонецЕсли;
		Мт = МетодПоСтроке(Пр.Методы, О.line);
		Если Мт = Неопределено Тогда
			ДобавитьПропуск(Пропуски, УжеПропуск, Отн + "(" + О.line + "): строка вне методов");
			Продолжить;
		КонецЕсли;
		Ключ = НРег(Отн) + "|" + Мт.Ключ;
		Эл = Поиндексу.Получить(Ключ);
		Если Эл <> Неопределено Тогда
			Если Эл.reasons.Найти(О.message) = Неопределено Тогда
				Эл.reasons.Добавить(О.message);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		МтБп = ?(Бп = Неопределено, Неопределено, МетодПоИмени(Бп.Методы, Мт.Ключ));
		Если МтБп = Неопределено Или МтБп.Норм <> Мт.Норм Тогда
			ДобавитьПропуск(Пропуски, УжеПропуск, Отн + " " + Мт.Имя + ": текст метода не равен БП (код УП) — не глушится");
			Продолжить;
		КонецЕсли;
		Причины = Новый Массив;
		Причины.Добавить(О.message);
		Эл = Новый Структура("module, method, kind, reasons", Отн, Мт.Имя, Мт.Вид, Причины);
		Поиндексу.Вставить(Ключ, Эл);
		Элементы.Добавить(Эл);
	КонецЦикла;
	Возврат Новый Структура("items, skipped", Элементы, Пропуски);
КонецФункции

Процедура ДобавитьПропуск(Пропуски, Уже, Текст)
	Если Уже.Получить(Текст) = Неопределено Тогда
		Уже.Вставить(Текст, Истина);
		Пропуски.Добавить(Текст);
	КонецЕсли;
КонецПроцедуры

Функция РазобранныйФайл(Кэш, Путь)
	Ключ = НРег(Путь);
	Р = Кэш.Получить(Ключ);
	Если Р <> Неопределено Тогда
		Возврат ?(Р = Ложь, Неопределено, Р);
	КонецЕсли;
	Ф = ПрочитатьФайл(Путь);
	Если Ф = Неопределено Тогда
		Кэш.Вставить(Ключ, Ложь);
		Возврат Неопределено;
	КонецЕсли;
	Р = Новый Структура("Текст, Методы", Ф.Текст, Разбор.РазобратьМодуль(Ф.Текст).Методы);
	Кэш.Вставить(Ключ, Р);
	Возврат Р;
КонецФункции

// ---------- Применение ----------

// Глушит отобранные методы в КореньЦели (restored или папка загрузки), если там метод совпадает с БП
// (или уже заглушка). КаталогРасш (необязательно) — хуки &ИзменениеИКонтроль переписываются под заглушку.
// Результат: Структура(stubbed, already, notVendor, hooksRewritten, files).
Функция Применить(Отбор, КореньЦели, КореньБп, КаталогРасш = "") Экспорт
	Итог = Новый Структура("stubbed, already, notVendor, hooksRewritten, files", 0, 0, 0, 0, Новый Массив);
	ПоФайлам = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Эл Из Отбор.items Цикл
		Сп = ПоФайлам.Получить(Эл.module);
		Если Сп = Неопределено Тогда
			Сп = Новый Массив;
			ПоФайлам.Вставить(Эл.module, Сп);
			Порядок.Добавить(Эл.module);
		КонецЕсли;
		Сп.Добавить(Эл);
	КонецЦикла;
	КэшБп = Новый Соответствие;
	Для Каждого Отн Из Порядок Цикл
		Путь = ОбъединитьПути(КореньЦели, Отн);
		Ф = ПрочитатьФайл(Путь);
		Бп = РазобранныйФайл(КэшБп, ОбъединитьПути(КореньБп, Отн));
		Если Ф = Неопределено Или Бп = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена = Новый Соответствие;
		Для Каждого Эл Из ПоФайлам.Получить(Отн) Цикл
			Имена.Вставить(НРег(Эл.method), Эл);
		КонецЦикла;
		Текст = ЗаменитьМетоды(Ф.Текст, Имена, Бп, Итог, Истина);
		Если Текст <> Ф.Текст Тогда
			ЗаписатьФайл(Путь, Текст, Ф.BOM, Ф.CRLF);
			Итог.files.Добавить(Отн);
		КонецЕсли;
		Если КаталогРасш <> "" Тогда
			ПутьХ = ОбъединитьПути(КаталогРасш, Отн);
			Фх = ПрочитатьФайл(ПутьХ);
			Если Фх <> Неопределено Тогда
				ТекстХ = ЗаменитьМетоды(Фх.Текст, Имена, Бп, Итог, Ложь);
				Если ТекстХ <> Фх.Текст Тогда
					ЗаписатьФайл(ПутьХ, ТекстХ, Фх.BOM, Фх.CRLF);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции

// Основная (ЭтоОсновная): метод с именем из Имена, равный БП, -> заглушка. Расширение: хук ИиК с этим именем -> под заглушку.
Функция ЗаменитьМетоды(Текст, Имена, Бп, Итог, ЭтоОсновная)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Методы = Разбор.РазобратьМодуль(Текст).Методы;
	Замены = Новый Соответствие; // 0-based начало -> Структура(Конец, Текст)
	Для Каждого Мт Из Методы Цикл
		Если ЭтоОсновная Тогда
			Эл = Имена.Получить(Мт.Ключ);
			Если Эл = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоЗаглушка(Мт.Текст) Тогда
				Итог.already = Итог.already + 1;
				Продолжить;
			КонецЕсли;
			МтБп = МетодПоИмени(Бп.Методы, Мт.Ключ);
			Если МтБп = Неопределено Или МтБп.Норм <> Мт.Норм Тогда
				Итог.notVendor = Итог.notVendor + 1;
				Продолжить;
			КонецЕсли;
			Нов = ТекстЗаглушкиМетода(Мт.Текст, Мт.Вид);
			Если Нов <> Неопределено Тогда
				Замены.Вставить(Мт.Начало - 1, Новый Структура("Конец, Текст", Мт.Конец - 1, Нов));
				Итог.stubbed = Итог.stubbed + 1;
			КонецЕсли;
		Иначе
			Имя = ИмяИзИиК(Мт.Текст);
			Если Имя = "" Или Имена.Получить(Имя) = Неопределено Или СтрНайти(Мт.Текст, Маркер()) > 0 Тогда
				Продолжить;
			КонецЕсли;
			Нов = ТекстХукаПодЗаглушку(Мт.Текст, Мт.Вид);
			Если Нов <> Неопределено Тогда
				Замены.Вставить(Мт.Начало - 1, Новый Структура("Конец, Текст", Мт.Конец - 1, Нов));
				Итог.hooksRewritten = Итог.hooksRewritten + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Замены.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Р = Новый Массив;
	Й = 0;
	Пока Й <= Строки.ВГраница() Цикл
		З = Замены.Получить(Й);
		Если З = Неопределено Тогда
			Р.Добавить(Строки[Й]);
			Й = Й + 1;
		Иначе
			Р.Добавить(З.Текст);
			Й = З.Конец + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Р, Символы.ПС);
КонецФункции
