// XDTO-постобработка Form.xml в restored по мета-папкам (быстрее полного дерева).
// oscript ПостобработкаRestoredForm.os [restored] [Catalogs|Documents|DataProcessors|Reports|all]
Корень = "D:\typovaya-up-out-20261118u\restored";
Область = "all";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Корень = АргументыКоманднойСтроки[0];
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	Область = НРег(АргументыКоманднойСтроки[1]);
КонецЕсли;
Фр = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФормыRestored.os"));
Лог = Новый Массив;
Список = ?(Область = "all", "Catalogs,Documents,DataProcessors,Reports", Область);
Итого = 0;
Для Каждого П Из СтрРазделить(Список, ",") Цикл
	Кат = ОбъединитьПути(Корень, СокрЛП(П));
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Продолжить;
	КонецЕсли;
	Итого = Итого + Фр.ПостобработкаВсехForm(Кат, Лог, Ложь);
	Сообщить(П + ": " + Итого);
КонецЦикла;
Сообщить("total updated: " + Итого);