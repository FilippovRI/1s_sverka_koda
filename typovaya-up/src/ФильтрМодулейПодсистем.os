// Фильтр списка модулей в typovaya ПодсистемыКонфигурацииПереопределяемый.ПриДобавленииПодсистем:
// typovaya перечисляет библиотеки, которых может не быть в этой сборке. Хук расширения
// не выполняется в фоне ПараметрыРаботыПрограммы (БезРасширений = Истина), поэтому
// фильтр ставится в основную конфигурацию (restored).

Функция МаркерФильтра() Экспорт
	Возврат "Метаданные.ОбщиеМодули.Найти(МодулиПодсистем[Индекс])";
КонецФункции

Функция СтрокиФильтра() Экспорт
	Р = Новый Массив;
	Р.Добавить(Символы.Таб + "// typovaya-up: не вызывать ОбщегоНазначения.ОбщийМодуль для библиотек, которых нет в этой сборке.");
	Р.Добавить(Символы.Таб + "// Нужно и в фоновом сеансе без расширений (ПараметрыРаботыПрограммы, БезРасширений).");
	Р.Добавить(Символы.Таб + "Индекс = МодулиПодсистем.ВГраница();");
	Р.Добавить(Символы.Таб + "Пока Индекс >= 0 Цикл");
	Р.Добавить(Символы.Таб + Символы.Таб + "Если Метаданные.ОбщиеМодули.Найти(МодулиПодсистем[Индекс]) = Неопределено Тогда");
	Р.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "МодулиПодсистем.Удалить(Индекс);");
	Р.Добавить(Символы.Таб + Символы.Таб + "КонецЕсли;");
	Р.Добавить(Символы.Таб + Символы.Таб + "Индекс = Индекс - 1;");
	Р.Добавить(Символы.Таб + "КонецЦикла;");
	Возврат Р;
КонецФункции

// Вставляет фильтр перед КонецПроцедуры процедуры ПриДобавленииПодсистем.
// Возвращает структуру: Текст, Статус = "applied"|"already"|"no_proc"|"no_end".
Функция ВставитьФильтрВТекст(Текст) Экспорт
	Рез = Новый Структура("Текст, Статус", Текст, "no_proc");
	Если СтрНайти(Текст, МаркерФильтра()) > 0 Тогда
		Рез.Статус = "already";
		Возврат Рез;
	КонецЕсли;
	НЛ = Символы.ПС;
	Если СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0 Тогда
		НЛ = Символы.ВК + Символы.ПС;
	КонецЕсли;
	Кончался = (СтрДлина(Текст) > 0) И (Прав(Текст, 1) = Символы.ПС Или Прав(Текст, 1) = Символы.ВК);
	Части = СтрРазделить(СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС), Символы.ПС, Истина);
	Старт = -1;
	Для Индекс = 0 По Части.ВГраница() Цикл
		Если СтрНайти(Части[Индекс], "Процедура ПриДобавленииПодсистем(") > 0 Тогда
			Старт = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Старт < 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Конец = -1;
	Для Индекс = Старт + 1 По Части.ВГраница() Цикл
		Если СокрЛП(Части[Индекс]) = "КонецПроцедуры" Тогда
			Конец = Индекс;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Конец < 0 Тогда
		Рез.Статус = "no_end";
		Возврат Рез;
	КонецЕсли;
	Вставка = Конец;
	Пока Вставка > Старт И СокрЛП(Части[Вставка - 1]) = "" Цикл
		Вставка = Вставка - 1;
	КонецЦикла;
	Новые = Новый Массив;
	Для Индекс = 0 По Вставка - 1 Цикл
		Новые.Добавить(Части[Индекс]);
	КонецЦикла;
	Новые.Добавить("");
	Для Каждого С Из СтрокиФильтра() Цикл
		Новые.Добавить(С);
	КонецЦикла;
	Новые.Добавить("");
	Для Индекс = Вставка По Части.ВГраница() Цикл
		Новые.Добавить(Части[Индекс]);
	КонецЦикла;
	Собран = СтрСоединить(Новые, НЛ);
	Если Кончался И Прав(Собран, СтрДлина(НЛ)) <> НЛ Тогда
		Собран = Собран + НЛ;
	КонецЕсли;
	Рез.Текст = Собран;
	Рез.Статус = "applied";
	Возврат Рез;
КонецФункции

Функция ПрочитатьФайл(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	С = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(С = Неопределено, "", С);
КонецФункции

Процедура ЗаписатьФайл(Путь, Текст)
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	З.Записать(Текст);
	З.Закрыть();
КонецПроцедуры

// Применяет фильтр к restored. Возвращает Структура(changed, path, status).
Функция Применить(КаталогВосст, Лог = Неопределено) Экспорт
	Путь = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КаталогВосст, "CommonModules"), "ПодсистемыКонфигурацииПереопределяемый"), "Ext");
	Путь = ОбъединитьПути(Путь, "Module.bsl");
	Рез = Новый Структура("changed, path, status", Ложь, Путь, "missing");
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Если Лог <> Неопределено Тогда
			Лог.Добавить("ФильтрМодулейПодсистем: нет файла " + Путь);
		КонецЕсли;
		Возврат Рез;
	КонецЕсли;
	Исх = ПрочитатьФайл(Путь);
	Патч = ВставитьФильтрВТекст(Исх);
	Рез.status = Патч.Статус;
	Если Патч.Статус = "applied" Тогда
		ЗаписатьФайл(Путь, Патч.Текст);
		Рез.changed = Истина;
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("ФильтрМодулейПодсистем: " + Патч.Статус + " " + Путь);
	КонецЕсли;
	Возврат Рез;
КонецФункции
