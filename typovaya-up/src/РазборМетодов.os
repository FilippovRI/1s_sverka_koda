// Разбор текста модуля на процедуры/функции и нормализация текста.

// Возвращает структуру: Методы (Массив структур), ВнеМетодов (нормализованный текст вне процедур).
Функция РазобратьМодуль(Знач Текст) Экспорт

	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Методы = Новый Массив;
	Вне = Новый Массив;
	Ожидающие = Новый Массив; // строки &Директив над объявлением
	Номер = 0;
	Всего = Строки.Количество();
	Пока Номер < Всего Цикл
		Стр = Строки[Номер];
		Объявление = РазобратьОбъявление(Стр);
		Если Объявление = Неопределено Тогда
			Если Лев(СокрЛП(Стр), 1) = "&" Тогда
				Ожидающие.Добавить(Номер);
			Иначе
				Если СокрЛП(Стр) <> "" Тогда
					ПеренестиВВне(Ожидающие, Строки, Вне);
				КонецЕсли;
				Вне.Добавить(Стр);
			КонецЕсли;
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;

		Начало = ?(Ожидающие.Количество() > 0, Ожидающие[0], Номер);
		Ожидающие.Очистить();
		Окончание = Всего - 1;
		Маркер = ?(Объявление.Вид = "Функция", "конецфункции", "конецпроцедуры");
		Для Й = Номер + 1 По Всего - 1 Цикл
			Если СтрНачинаетсяС(НРег(СокрЛП(Строки[Й])), Маркер) Тогда
				Окончание = Й;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Тело = Новый Массив;
		Для Й = Начало По Окончание Цикл
			Тело.Добавить(Строки[Й]);
		КонецЦикла;
		ТекстМетода = СтрСоединить(Тело, Символы.ПС);
		Методы.Добавить(Новый Структура("Имя, Ключ, Вид, Начало, Конец, Текст, Норм",
			Объявление.Имя, НРег(Объявление.Имя), Объявление.Вид, Начало + 1, Окончание + 1, ТекстМетода, Нормализовать(ТекстМетода)));
		Номер = Окончание + 1;
	КонецЦикла;
	ПеренестиВВне(Ожидающие, Строки, Вне);

	Возврат Новый Структура("Методы, ВнеМетодов", Методы, Нормализовать(СтрСоединить(Вне, Символы.ПС)));

КонецФункции

// "Процедура Имя(" / "Асинх Функция Имя(" -> Структура Вид, Имя; иначе Неопределено.
Функция РазобратьОбъявление(Знач Стр) Экспорт
	С = СокрЛП(Стр);
	Н = НРег(С);
	Если СтрНачинаетсяС(Н, "асинх ") Тогда
		С = СокрЛП(Сред(С, 7));
		Н = НРег(С);
	КонецЕсли;
	Если СтрНачинаетсяС(Н, "процедура ") Тогда
		Вид = "Процедура";
		Остаток = Сред(С, 11);
	ИначеЕсли СтрНачинаетсяС(Н, "функция ") Тогда
		Вид = "Функция";
		Остаток = Сред(С, 9);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Скобка = СтрНайти(Остаток, "(");
	Если Скобка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = СокрЛП(Лев(Остаток, Скобка - 1));
	Если Имя = "" ИЛИ СтрНайти(Имя, " ") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вид, Имя", Вид, Имя);
КонецФункции

// Без комментариев //, без пустых строк, без отступов по краям.
Функция Нормализовать(Знач Текст) Экспорт
	Результат = Новый Массив;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		С = СокрЛП(УбратьКомментарий(Стр));
		Если С <> "" Тогда
			Результат.Добавить(С);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

Функция УбратьКомментарий(Знач Стр) Экспорт
	Если СтрНайти(Стр, "//") = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	ВСтроке = Ложь;
	Длина = СтрДлина(Стр);
	Для Й = 1 По Длина - 1 Цикл
		С = Сред(Стр, Й, 1);
		Если С = """" Тогда
			ВСтроке = Не ВСтроке;
		ИначеЕсли Не ВСтроке И С = "/" И Сред(Стр, Й + 1, 1) = "/" Тогда
			Возврат Лев(Стр, Й - 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Стр;
КонецФункции

// Доля отличающихся строк (мультимножество нормализованных строк), 0..1.
Функция ДоляОтличий(Знач НормА, Знач НормБ) Экспорт
	Счетчик = Новый Соответствие;
	СтрокиА = СтрРазделить(НормА, Символы.ПС, Ложь);
	СтрокиБ = СтрРазделить(НормБ, Символы.ПС, Ложь);
	Для Каждого С Из СтрокиА Цикл
		Было = Счетчик.Получить(С);
		Счетчик.Вставить(С, ?(Было = Неопределено, 0, Было) + 1);
	КонецЦикла;
	Общих = 0;
	Для Каждого С Из СтрокиБ Цикл
		Было = Счетчик.Получить(С);
		Если Было <> Неопределено И Было > 0 Тогда
			Счетчик.Вставить(С, Было - 1);
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	Всего = Макс(СтрокиА.Количество(), СтрокиБ.Количество(), 1);
	Возврат (Всего - Общих) / Всего;
КонецФункции


// Тело метода без заголовка Процедура/Функция и без КонецПроцедуры/КонецФункции.
Функция ИзвлечьТелоМетода(Знач ТекстМетода) Экспорт
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	НачОбъявления = -1;
	Вид = "";
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Объявление = РазобратьОбъявление(Строки[Й]);
		Если Объявление <> Неопределено Тогда
			НачОбъявления = Й;
			Вид = Объявление.Вид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НачОбъявления < 0 Тогда
		Возврат "";
	КонецЕсли;
	Маркер = ?(Вид = "Функция", "конецфункции", "конецпроцедуры");
	КонецТела = Строки.Количество();
	Для Й = НачОбъявления + 1 По Строки.Количество() - 1 Цикл
		Если СтрНачинаетсяС(НРег(СокрЛП(Строки[Й])), Маркер) Тогда
			КонецТела = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Тело = Новый Массив;
	Для Й = НачОбъявления + 1 По КонецТела - 1 Цикл
		Тело.Добавить(Строки[Й]);
	КонецЦикла;
	Возврат СтрСоединить(Тело, Символы.ПС);
КонецФункции

Функция НормализоватьСтроку(Знач Стр) Экспорт
	Возврат СокрЛП(УбратьКомментарий(Стр));
КонецФункции

Процедура ПеренестиВВне(Ожидающие, Строки, Вне)
	Для Каждого Н Из Ожидающие Цикл
		Вне.Добавить(Строки[Н]);
	КонецЦикла;
	Ожидающие.Очистить();
КонецПроцедуры
