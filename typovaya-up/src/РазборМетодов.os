// Лексический разбор модуля на процедуры/функции (не полный парсер BSL).
// Учитывает // вне строк, "" в строках, маркеры конца только как отдельные операторы.

Перем КэшТекст1, КэшСтроки1, КэшТекст2, КэшСтроки2;

// Разбирает текст модуля на методы и нормализованный код вне методов.
//
// Параметры:
//   Текст — полный текст .bsl.
//
// Возвращаемое значение:
//   Структура Методы, ВнеМетодов. Неоднозначные конструкции могут дать ложные границы — см. test_parse.os.
Функция РазобратьМодуль(Знач Текст) Экспорт
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Методы = Новый Массив;
	Вне = Новый Массив;
	ВнеИндексы = Новый Массив;
	Ожидающие = Новый Массив;
	Номер = 0;
	Всего = Строки.Количество();
	Пока Номер < Всего Цикл
		СтрОбъяв = СобратьСтрокуОбъявления(Строки, Номер);
		Объявление = РазобратьОбъявление(СтрОбъяв.Текст);
		Если Объявление = Неопределено Тогда
			Стр = Строки[Номер];
			Если СтрокаДирективаПрепроцессора(Стр) Тогда
				Вне.Добавить(Стр);
				ВнеИндексы.Добавить(Номер);
				Номер = Номер + 1;
				Продолжить;
			КонецЕсли;
			Если Лев(СокрЛП(Стр), 1) = "&" Тогда
				Ожидающие.Добавить(Номер);
			Иначе
				Если СокрЛП(УбратьКомментарий(Стр)) <> "" Тогда
					ПеренестиВВне(Ожидающие, Строки, Вне, ВнеИндексы);
				КонецЕсли;
				Вне.Добавить(Стр);
				ВнеИндексы.Добавить(Номер);
			КонецЕсли;
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;
		Начало = ?(Ожидающие.Количество() > 0, Ожидающие[0], СтрОбъяв.Начало);
		Ожидающие.Очистить();
		Окончание = НайтиКонецМетода(Строки, СтрОбъяв.Начало, Объявление.Вид);
		Тело = Новый Массив;
		Для Й = Начало По Окончание Цикл
			Тело.Добавить(Строки[Й]);
		КонецЦикла;
		ТекстМетода = СтрСоединить(Тело, Символы.ПС);
		Методы.Добавить(Новый Структура("Имя, Ключ, Вид, Начало, Конец, Текст, Норм, ОбёрткаНачало, ОбёрткаКонец",
			Объявление.Имя, НРег(Объявление.Имя), Объявление.Вид, Начало + 1, Окончание + 1, ТекстМетода, Нормализовать(ТекстМетода), "", ""));
		Номер = Окончание + 1;
	КонецЦикла;
	ПеренестиВВне(Ожидающие, Строки, Вне, ВнеИндексы);
	ИндОбёрток = Новый Соответствие;
	Для Каждого Мт Из Методы Цикл
		Об = НайтиОбёрткуПрепроцессора(Строки, Мт.Начало - 1, Мт.Конец - 1, Методы);
		Мт.ОбёрткаНачало = Об.Начало;
		Мт.ОбёрткаКонец = Об.Конец;
		Для Каждого Й Из Об.Индексы Цикл
			ИндОбёрток.Вставить(Й, Истина);
		КонецЦикла;
	КонецЦикла;
	Если ИндОбёрток.Количество() > 0 Тогда
		Вне2 = Новый Массив;
		Для Й = 0 По Вне.ВГраница() Цикл
			Если ИндОбёрток.Получить(ВнеИндексы[Й]) = Неопределено Тогда
				Вне2.Добавить(Вне[Й]);
			КонецЕсли;
		КонецЦикла;
		Вне = Вне2;
	КонецЕсли;
	Возврат Новый Структура("Методы, ВнеМетодов", Методы, Нормализовать(СтрСоединить(Вне, Символы.ПС)));
КонецФункции

// Склеивает строки заголовка, если «(» на следующей строке (многострочная сигнатура).
Функция СобратьСтрокуОбъявления(Строки, Номер)
	Текст = Строки[Номер];
	Если СтрНайти(УбратьКомментарий(Текст), "(") > 0 Тогда
		Возврат Новый Структура("Текст, Начало", Текст, Номер);
	КонецЕсли;
	Код = СокрЛП(УбратьКомментарий(Текст));
	Н = НРег(Код);
	Если Не (СтрНачинаетсяС(Н, "процедура ") Или СтрНачинаетсяС(Н, "функция ") Или СтрНачинаетсяС(Н, "асинх ")) Тогда
		Возврат Новый Структура("Текст, Начало", Текст, Номер);
	КонецЕсли;
	Лимит = Мин(Номер + 4, Строки.Количество() - 1);
	Для Й = Номер + 1 По Лимит Цикл
		Текст = Текст + " " + СокрЛП(УбратьКомментарий(Строки[Й]));
		Если СтрНайти(Текст, "(") > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Текст, Начало", Текст, Номер);
КонецФункции

Функция НайтиКонецМетода(Строки, НомерНачала, Вид)
	Маркер = ?(Вид = "Функция", "конецфункции", "конецпроцедуры");
	Окончание = Строки.Количество() - 1;
	Для Й = НомерНачала + 1 По Строки.Количество() - 1 Цикл
		Если ЭтоМаркерКонцаМетода(Строки[Й], Маркер) Тогда
			Окончание = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Окончание;
КонецФункции

Функция СтрокаДирективаПрепроцессора(Стр)
	Код = СокрЛП(УбратьКомментарий(Стр));
	Возврат СтрНачинаетсяС(Код, "#");
КонецФункции

// Строка — только «КонецПроцедуры» / «КонецФункции» (опционально «;»), не в строковом литерале.
Функция ЭтоМаркерКонцаМетода(Стр, МаркерНРег) Экспорт
	Код = СокрЛП(УбратьКомментарий(Стр));
	Если Код = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Н = НРег(Код);
	Если Не СтрНачинаетсяС(Н, МаркерНРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	Хвост = СокрЛП(Сред(Код, СтрДлина(МаркерНРег) + 1));
	Возврат Хвост = "" Или Хвост = ";";
КонецФункции

// Объявление: только в начале строки кода (после снятия //). Имя — одно слово до «(».
Функция РазобратьОбъявление(Знач Стр) Экспорт
	С = СокрЛП(УбратьКомментарий(Стр));
	Если С = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Н = НРег(С);
	Если СтрНачинаетсяС(Н, "асинх ") Тогда
		С = СокрЛП(Сред(С, 7));
		Н = НРег(С);
	КонецЕсли;
	Если СтрНачинаетсяС(Н, "процедура ") Тогда
		Вид = "Процедура";
		Остаток = Сред(С, 11);
	ИначеЕсли СтрНачинаетсяС(Н, "функция ") Тогда
		Вид = "Функция";
		Остаток = Сред(С, 9);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Скобка = СтрНайти(Остаток, "(");
	Если Скобка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = СокрЛП(Лев(Остаток, Скобка - 1));
	Если Имя = "" Или СтрНайти(Имя, " ") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вид, Имя", Вид, Имя);
КонецФункции

Функция Нормализовать(Знач Текст) Экспорт
	Результат = Новый Массив;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		С = СокрЛП(УбратьКомментарий(Стр));
		Если С <> "" Тогда
			Результат.Добавить(С);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

// Удаляет «//»-комментарий; «//» внутри строки и удвоенные «""» не считаются комментарием.
Функция УбратьКомментарий(Знач Стр) Экспорт
	// Быстрый путь: нет «//» — нет комментария; кавычка только после первого «//» — комментарий с него.
	ПозКомм = СтрНайти(Стр, "//");
	Если ПозКомм = 0 Тогда
		Возврат Стр;
	КонецЕсли;
	ПозКав = СтрНайти(Стр, """");
	Если ПозКав = 0 Или ПозКав > ПозКомм Тогда
		Возврат Лев(Стр, ПозКомм - 1);
	КонецЕсли;
	ВСтроке = Ложь;
	Длина = СтрДлина(Стр);
	Й = 1;
	Пока Й <= Длина Цикл
		С = Сред(Стр, Й, 1);
		Если Не ВСтроке Тогда
			Если С = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли С = "/" И Й < Длина И Сред(Стр, Й + 1, 1) = "/" Тогда
				Возврат Лев(Стр, Й - 1);
			КонецЕсли;
		Иначе
			Если С = """" Тогда
				Если Й < Длина И Сред(Стр, Й + 1, 1) = """" Тогда
					Й = Й + 1;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Стр;
КонецФункции

Функция ДоляОтличий(Знач НормА, Знач НормБ) Экспорт
	Счетчик = Новый Соответствие;
	СтрокиА = СтрРазделить(НормА, Символы.ПС, Ложь);
	СтрокиБ = СтрРазделить(НормБ, Символы.ПС, Ложь);
	Для Каждого С Из СтрокиА Цикл
		Было = Счетчик.Получить(С);
		Счетчик.Вставить(С, ?(Было = Неопределено, 0, Было) + 1);
	КонецЦикла;
	Общих = 0;
	Для Каждого С Из СтрокиБ Цикл
		Было = Счетчик.Получить(С);
		Если Было <> Неопределено И Было > 0 Тогда
			Счетчик.Вставить(С, Было - 1);
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	Всего = Макс(СтрокиА.Количество(), СтрокиБ.Количество(), 1);
	Возврат (Всего - Общих) / Всего;
КонецФункции

Функция ИзвлечьТелоМетода(Знач ТекстМетода) Экспорт
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	НачОбъявления = -1;
	Вид = "";
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Объявление = РазобратьОбъявление(Строки[Й]);
		Если Объявление <> Неопределено Тогда
			НачОбъявления = Й;
			Вид = Объявление.Вид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НачОбъявления < 0 Тогда
		Возврат "";
	КонецЕсли;
	НачТела = НачОбъявления + 1;
	Глубина = 0;
	БылаСкобка = Ложь;
	Для Й = НачОбъявления По Строки.Количество() - 1 Цикл
		Чистая = УбратьКомментарий(Строки[Й]);
		Если СтрНайти(Чистая, "(") > 0 Тогда
			БылаСкобка = Истина;
		КонецЕсли;
		Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
		Если БылаСкобка И Глубина <= 0 Тогда
			НачТела = Й + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Маркер = ?(Вид = "Функция", "конецфункции", "конецпроцедуры");
	КонецТела = Строки.Количество();
	Для Й = НачТела По Строки.Количество() - 1 Цикл
		Если ЭтоМаркерКонцаМетода(Строки[Й], Маркер) Тогда
			КонецТела = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Тело = Новый Массив;
	Для Й = НачТела По КонецТела - 1 Цикл
		Тело.Добавить(Строки[Й]);
	КонецЦикла;
	Возврат СтрСоединить(Тело, Символы.ПС);
КонецФункции

Функция НормализоватьСтроку(Знач Стр) Экспорт
	Возврат СокрЛП(УбратьКомментарий(Стр));
КонецФункции

Функция ЭтоПробельныйСимвол(С)
	Возврат С = " " Или С = Символы.Таб;
КонецФункции

Функция ЭтоЛитералИдентификатора(С)
	К = КодСимвола(С);
	Если (К >= 48 И К <= 57) Или С = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти("_АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", С) > 0;
КонецФункции

// Лексемы строки кода без пробелов/табов и без //‑комментария (как срез BSL LS для diff).
Функция ЛексемыСтроки(Знач Стр) Экспорт
	Код = УбратьКомментарий(Стр);
	Токены = Новый Массив;
	Длина = СтрДлина(Код);
	Й = 1;
	Пока Й <= Длина Цикл
		С = Сред(Код, Й, 1);
		Если ЭтоПробельныйСимвол(С) Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ТекстЛит = "";
			Й = Й + 1;
			Пока Й <= Длина Цикл
				С2 = Сред(Код, Й, 1);
				Если С2 = """" Тогда
					Если Й < Длина И Сред(Код, Й + 1, 1) = """" Тогда
						ТекстЛит = ТекстЛит + """";
						Й = Й + 2;
					Иначе
						Й = Й + 1;
						Прервать;
					КонецЕсли;
				Иначе
					ТекстЛит = ТекстЛит + С2;
					Й = Й + 1;
				КонецЕсли;
			КонецЦикла;
			Токены.Добавить("S:" + ТекстЛит);
			Продолжить;
		КонецЕсли;
		Если ЭтоЛитералИдентификатора(С) Тогда
			Слово = С;
			Й = Й + 1;
			Пока Й <= Длина Цикл
				С2 = Сред(Код, Й, 1);
				Если ЭтоЛитералИдентификатора(С2) Тогда
					Слово = Слово + С2;
					Й = Й + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Токены.Добавить(НРег(Слово));
			Продолжить;
		КонецЕсли;
		Дв = С;
		Если Й < Длина Тогда
			Д2 = С + Сред(Код, Й + 1, 1);
			Если Д2 = "<=" Или Д2 = ">=" Или Д2 = "<>" Или Д2 = "!=" Тогда
				Токены.Добавить(Д2);
				Й = Й + 2;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Токены.Добавить(С);
		Й = Й + 1;
	КонецЦикла;
	Возврат Токены;
КонецФункции

Функция ХешСтроки(Строка)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Строка);
	Возврат НРег(Хеш.ХешСуммаСтрокой);
КонецФункции

// Пустая строка → "" (строка вне diff); иначе MD5 от лексем через «|».
Функция ХешЛексемСтроки(Знач Стр) Экспорт
	Ток = ЛексемыСтроки(Стр);
	Если Ток.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ХешСтроки(СтрСоединить(Ток, "|"));
КонецФункции

Процедура ПеренестиВВне(Ожидающие, Строки, Вне, ВнеИндексы)
	Для Каждого Н Из Ожидающие Цикл
		Вне.Добавить(Строки[Н]);
		ВнеИндексы.Добавить(Н);
	КонецЦикла;
	Ожидающие.Очистить();
КонецПроцедуры

// Строки текста модуля: два последних текста кэшируются (вызывается на каждый метод большого модуля).
Функция СтрокиТекстаСКэшем(Текст)
	Если КэшТекст1 <> Неопределено И КэшТекст1 = Текст Тогда
		Возврат КэшСтроки1;
	КонецЕсли;
	Если КэшТекст2 <> Неопределено И КэшТекст2 = Текст Тогда
		Возврат КэшСтроки2;
	КонецЕсли;
	КэшТекст2 = КэшТекст1;
	КэшСтроки2 = КэшСтроки1;
	КэшТекст1 = Текст;
	КэшСтроки1 = СтрРазделить(Текст, Символы.ПС, Истина);
	Возврат КэшСтроки1;
КонецФункции

// Обёртка #Если/#ИначеЕсли/#Иначе/#КонецЕсли непосредственно вокруг метода (1-based номера строк).
Функция НайтиОбёрткуПрепроцессораВТексте(Знач Текст, Знач НомерНачала, Знач НомерКонца) Экспорт
	Строки = СтрокиТекстаСКэшем(Текст);
	Возврат НайтиОбёрткуПрепроцессора(Строки, НомерНачала - 1, НомерКонца - 1, Неопределено);
КонецФункции

Функция ОбернутьТекстПрепроцессором(Знач Текст, Знач Префикс, Знач Суффикс) Экспорт
	Если СокрЛП(Строка(Префикс)) = "" Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Префикс + Символы.ПС + Текст + Символы.ПС + ?(СокрЛП(Строка(Суффикс)) = "", "#КонецЕсли", Суффикс);
КонецФункции

// Нач0/Кон0 — 0-based включительно (метод с аннотациями). Только если директивы сразу вокруг метода.
Функция НайтиОбёрткуПрепроцессора(Строки, Нач0, Кон0, Методы) Экспорт
	Пусто = Новый Структура("Начало, Конец, Индексы", "", "", Новый Массив);
	ОткрЙ = Неопределено;
	Для Й = 1 По Нач0 Цикл
		Н = Нач0 - Й;
		Если ПустаяИлиКомментарий(Строки[Н]) Тогда
			Продолжить;
		КонецЕсли;
		Слово = СловоДирективыПрепроцессора(Строки[Н]);
		Если Слово = "если" Или Слово = "иначеесли" Или Слово = "иначе" Тогда
			ОткрЙ = Н;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	ЗакрЙ = Неопределено;
	Для Й = Кон0 + 1 По Строки.Количество() - 1 Цикл
		Если ПустаяИлиКомментарий(Строки[Й]) Тогда
			Продолжить;
		КонецЕсли;
		Слово = СловоДирективыПрепроцессора(Строки[Й]);
		Если Слово = "конецесли" Или Слово = "иначеесли" Или Слово = "иначе" Тогда
			ЗакрЙ = Й;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Если ОткрЙ = Неопределено Или ЗакрЙ = Неопределено Тогда
		Возврат Пусто;
	КонецЕсли;
	ПрефЙ = Новый Массив;
	Если Не СобратьЦепочкуЕсли(Строки, ОткрЙ, Методы, ПрефЙ) Тогда
		Возврат Пусто;
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Й Из ПрефЙ Цикл
		Части.Добавить(Строки[Й]);
	КонецЦикла;
	СловоЗакр = СловоДирективыПрепроцессора(Строки[ЗакрЙ]);
	Суффикс = ?(СловоЗакр = "конецесли", Строки[ЗакрЙ], "#КонецЕсли");
	Индексы = Новый Массив;
	Для Каждого Й Из ПрефЙ Цикл
		Индексы.Добавить(Й);
	КонецЦикла;
	Индексы.Добавить(ЗакрЙ);
	Возврат Новый Структура("Начало, Конец, Индексы", СтрСоединить(Части, Символы.ПС), Суффикс, Индексы);
КонецФункции

Функция ПустаяИлиКомментарий(Стр)
	Возврат СокрЛП(УбратьКомментарий(Стр)) = "";
КонецФункции

// Первое слово после «#»: если, иначеесли, иначе, конецесли, область…
Функция СловоДирективыПрепроцессора(Стр) Экспорт
	Код = СокрЛП(УбратьКомментарий(Стр));
	Если Не СтрНачинаетсяС(Код, "#") Тогда
		Возврат "";
	КонецЕсли;
	Ост = СокрЛ(Сред(Код, 2));
	Слово = "";
	Для Й = 1 По СтрДлина(Ост) Цикл
		С = Сред(Ост, Й, 1);
		Если ЭтоЛитералИдентификатора(С) Тогда
			Слово = Слово + С;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат НРег(Слово);
КонецФункции

// Собирает индексы директив от #Если до ветки метода включительно (для #Иначе — всю цепочку).
Функция СобратьЦепочкуЕсли(Строки, ОткрЙ, Методы, ПрефЙ)
	СловоОткр = СловоДирективыПрепроцессора(Строки[ОткрЙ]);
	Если СловоОткр = "если" Тогда
		ПрефЙ.Добавить(ОткрЙ);
		Возврат Истина;
	КонецЕсли;
	Цепь = Новый Массив;
	Цепь.Добавить(ОткрЙ);
	Й = ОткрЙ - 1;
	Пока Й >= 0 Цикл
		Мт = МетодПоСтроке(Й, Методы);
		Если Мт <> Неопределено Тогда
			Й = Мт.Начало - 2;
			Продолжить;
		КонецЕсли;
		Если ПустаяИлиКомментарий(Строки[Й]) Тогда
			Й = Й - 1;
			Продолжить;
		КонецЕсли;
		Слово = СловоДирективыПрепроцессора(Строки[Й]);
		Если Слово = "конецесли" Тогда
			Й = ПропуститьВложенныйКонецЕслиНазад(Строки, Й - 1, Методы);
			Продолжить;
		КонецЕсли;
		Если Слово = "иначеесли" Или Слово = "иначе" Тогда
			Цепь.Добавить(Й);
			Й = Й - 1;
			Продолжить;
		КонецЕсли;
		Если Слово = "если" Тогда
			Цепь.Добавить(Й);
			Для К = 1 По Цепь.Количество() Цикл
				ПрефЙ.Добавить(Цепь[Цепь.Количество() - К]);
			КонецЦикла;
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция МетодПоСтроке(Й, Методы)
	Если Методы = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Мт Из Методы Цикл
		Если Й >= Мт.Начало - 1 И Й <= Мт.Конец - 1 Тогда
			Возврат Мт;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПропуститьВложенныйКонецЕслиНазад(Строки, Знач Й, Методы)
	Глубина = 1;
	Пока Й >= 0 И Глубина > 0 Цикл
		Мт = МетодПоСтроке(Й, Методы);
		Если Мт <> Неопределено Тогда
			Й = Мт.Начало - 2;
			Продолжить;
		КонецЕсли;
		Слово = СловоДирективыПрепроцессора(Строки[Й]);
		Если Слово = "конецесли" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Слово = "если" Тогда
			Глубина = Глубина - 1;
		КонецЕсли;
		Й = Й - 1;
	КонецЦикла;
	Возврат Й;
КонецФункции

// Обёртка #Если…#КонецЕсли на весь модуль: первая значащая строка — #Если,
// последняя — #КонецЕсли, и эта пара закрывается только в конце файла.
// Пустые строки и комментарии до и после директив допустимы.
Функция НайтиОбёрткуМодуля(Знач Текст) Экспорт
	Пусто = Новый Структура("Начало, Конец, Есть, ИндексНачала, ИндексКонца", "", "", Ложь, -1, -1);
	Если СокрЛП(Строка(Текст)) = "" Тогда
		Возврат Пусто;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	ОткрЙ = -1;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если ПустаяИлиКомментарий(Строки[Й]) Тогда
			Продолжить;
		КонецЕсли;
		Если СловоДирективыПрепроцессора(Строки[Й]) = "если" Тогда
			ОткрЙ = Й;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	ЗакрЙ = -1;
	Для Сдвиг = 0 По Строки.ВГраница() Цикл
		Й = Строки.ВГраница() - Сдвиг;
		Если ПустаяИлиКомментарий(Строки[Й]) Тогда
			Продолжить;
		КонецЕсли;
		Если СловоДирективыПрепроцессора(Строки[Й]) = "конецесли" Тогда
			ЗакрЙ = Й;
		КонецЕсли;
		Прервать;
	КонецЦикла;
	Если ОткрЙ < 0 Или ЗакрЙ < 0 Или ЗакрЙ <= ОткрЙ Тогда
		Возврат Пусто;
	КонецЕсли;
	Глубина = 0;
	Для Й = ОткрЙ По ЗакрЙ Цикл
		Слово = СловоДирективыПрепроцессора(Строки[Й]);
		Если Слово = "если" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Слово = "конецесли" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 И Й <> ЗакрЙ Тогда
				Возврат Пусто;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Глубина <> 0 Тогда
		Возврат Пусто;
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец, Есть, ИндексНачала, ИндексКонца",
		Строки[ОткрЙ], Строки[ЗакрЙ], Истина, ОткрЙ, ЗакрЙ);
КонецФункции

Функция НормализоватьДирективуПрепроцессора(Знач Стр)
	С = СокрЛП(УбратьКомментарий(Строка(Стр)));
	Пока СтрНайти(С, "  ") > 0 Цикл
		С = СтрЗаменить(С, "  ", " ");
	КонецЦикла;
	Возврат НРег(С);
КонецФункции

// Накладывает обёртку модуля. Ту же директиву повторно не добавляет.
// Другую внешнюю обёртку модуля заменяет на типовую (как в БП).
Функция ПрименитьОбёрткуМодуля(Знач Текст, Знач Префикс, Знач Суффикс) Экспорт
	Если СокрЛП(Строка(Префикс)) = "" Тогда
		Возврат Текст;
	КонецЕсли;
	Если СокрЛП(Строка(Суффикс)) = "" Тогда
		Суффикс = "#КонецЕсли";
	КонецЕсли;
	Префикс = СокрП(Строка(Префикс));
	Суффикс = СокрП(Строка(Суффикс));
	Тек = НайтиОбёрткуМодуля(Текст);
	Если Тек.Есть
		И НормализоватьДирективуПрепроцессора(Тек.Начало) = НормализоватьДирективуПрепроцессора(Префикс)
		И НормализоватьДирективуПрепроцессора(Тек.Конец) = НормализоватьДирективуПрепроцессора(Суффикс) Тогда
		Возврат Текст;
	КонецЕсли;
	Если Тек.Есть Тогда
		Текст = УбратьОбёрткуМодуля(Текст);
	КонецЕсли;
	Возврат ОбернутьТекстМодуля(Текст, Префикс, Суффикс);
КонецФункции

Функция УбратьОбёрткуМодуля(Знач Текст)
	Об = НайтиОбёрткуМодуля(Текст);
	Если Не Об.Есть Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Рез = Новый Массив;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если Й = Об.ИндексНачала Или Й = Об.ИндексКонца Тогда
			Продолжить;
		КонецЕсли;
		Рез.Добавить(Строки[Й]);
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция ОбернутьТекстМодуля(Знач Текст, Знач Префикс, Знач Суффикс)
	Т = Строка(Текст);
	Пока СтрЗаканчиваетсяНа(Т, Символы.ПС) Или СтрЗаканчиваетсяНа(Т, Символы.ВК) Цикл
		Т = Лев(Т, СтрДлина(Т) - 1);
	КонецЦикла;
	Пока СтрНачинаетсяС(Т, Символы.ПС) Или СтрНачинаетсяС(Т, Символы.ВК) Цикл
		Т = Сред(Т, 2);
	КонецЦикла;
	Возврат Префикс + Символы.ПС + Т + Символы.ПС + Суффикс + Символы.ПС;
КонецФункции
