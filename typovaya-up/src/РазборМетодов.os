// Лексический разбор модуля на процедуры/функции (не полный парсер BSL).
// Учитывает // вне строк, "" в строках, маркеры конца только как отдельные операторы.

// Разбирает текст модуля на методы и нормализованный код вне методов.
//
// Параметры:
//   Текст — полный текст .bsl.
//
// Возвращаемое значение:
//   Структура Методы, ВнеМетодов. Неоднозначные конструкции могут дать ложные границы — см. test_parse.os.
Функция РазобратьМодуль(Знач Текст) Экспорт
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Методы = Новый Массив;
	Вне = Новый Массив;
	Ожидающие = Новый Массив;
	Номер = 0;
	Всего = Строки.Количество();
	Пока Номер < Всего Цикл
		СтрОбъяв = СобратьСтрокуОбъявления(Строки, Номер);
		Объявление = РазобратьОбъявление(СтрОбъяв.Текст);
		Если Объявление = Неопределено Тогда
			Стр = Строки[Номер];
			Если СтрокаДирективаПрепроцессора(Стр) Тогда
				Вне.Добавить(Стр);
				Номер = Номер + 1;
				Продолжить;
			КонецЕсли;
			Если Лев(СокрЛП(Стр), 1) = "&" Тогда
				Ожидающие.Добавить(Номер);
			Иначе
				Если СокрЛП(УбратьКомментарий(Стр)) <> "" Тогда
					ПеренестиВВне(Ожидающие, Строки, Вне);
				КонецЕсли;
				Вне.Добавить(Стр);
			КонецЕсли;
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;
		Начало = ?(Ожидающие.Количество() > 0, Ожидающие[0], СтрОбъяв.Начало);
		Ожидающие.Очистить();
		Окончание = НайтиКонецМетода(Строки, СтрОбъяв.Начало, Объявление.Вид);
		Тело = Новый Массив;
		Для Й = Начало По Окончание Цикл
			Тело.Добавить(Строки[Й]);
		КонецЦикла;
		ТекстМетода = СтрСоединить(Тело, Символы.ПС);
		Методы.Добавить(Новый Структура("Имя, Ключ, Вид, Начало, Конец, Текст, Норм",
			Объявление.Имя, НРег(Объявление.Имя), Объявление.Вид, Начало + 1, Окончание + 1, ТекстМетода, Нормализовать(ТекстМетода)));
		Номер = Окончание + 1;
	КонецЦикла;
	ПеренестиВВне(Ожидающие, Строки, Вне);
	Возврат Новый Структура("Методы, ВнеМетодов", Методы, Нормализовать(СтрСоединить(Вне, Символы.ПС)));
КонецФункции

// Склеивает строки заголовка, если «(» на следующей строке (многострочная сигнатура).
Функция СобратьСтрокуОбъявления(Строки, Номер)
	Текст = Строки[Номер];
	Если СтрНайти(УбратьКомментарий(Текст), "(") > 0 Тогда
		Возврат Новый Структура("Текст, Начало", Текст, Номер);
	КонецЕсли;
	Код = СокрЛП(УбратьКомментарий(Текст));
	Н = НРег(Код);
	Если Не (СтрНачинаетсяС(Н, "процедура ") Или СтрНачинаетсяС(Н, "функция ") Или СтрНачинаетсяС(Н, "асинх ")) Тогда
		Возврат Новый Структура("Текст, Начало", Текст, Номер);
	КонецЕсли;
	Лимит = Мин(Номер + 4, Строки.Количество() - 1);
	Для Й = Номер + 1 По Лимит Цикл
		Текст = Текст + " " + СокрЛП(УбратьКомментарий(Строки[Й]));
		Если СтрНайти(Текст, "(") > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Текст, Начало", Текст, Номер);
КонецФункции

Функция НайтиКонецМетода(Строки, НомерНачала, Вид)
	Маркер = ?(Вид = "Функция", "конецфункции", "конецпроцедуры");
	Окончание = Строки.Количество() - 1;
	Для Й = НомерНачала + 1 По Строки.Количество() - 1 Цикл
		Если ЭтоМаркерКонцаМетода(Строки[Й], Маркер) Тогда
			Окончание = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Окончание;
КонецФункции

Функция СтрокаДирективаПрепроцессора(Стр)
	Код = СокрЛП(УбратьКомментарий(Стр));
	Возврат СтрНачинаетсяС(Код, "#");
КонецФункции

// Строка — только «КонецПроцедуры» / «КонецФункции» (опционально «;»), не в строковом литерале.
Функция ЭтоМаркерКонцаМетода(Стр, МаркерНРег) Экспорт
	Код = СокрЛП(УбратьКомментарий(Стр));
	Если Код = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Н = НРег(Код);
	Если Не СтрНачинаетсяС(Н, МаркерНРег) Тогда
		Возврат Ложь;
	КонецЕсли;
	Хвост = СокрЛП(Сред(Код, СтрДлина(МаркерНРег) + 1));
	Возврат Хвост = "" Или Хвост = ";";
КонецФункции

// Объявление: только в начале строки кода (после снятия //). Имя — одно слово до «(».
Функция РазобратьОбъявление(Знач Стр) Экспорт
	С = СокрЛП(УбратьКомментарий(Стр));
	Если С = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Н = НРег(С);
	Если СтрНачинаетсяС(Н, "асинх ") Тогда
		С = СокрЛП(Сред(С, 7));
		Н = НРег(С);
	КонецЕсли;
	Если СтрНачинаетсяС(Н, "процедура ") Тогда
		Вид = "Процедура";
		Остаток = Сред(С, 11);
	ИначеЕсли СтрНачинаетсяС(Н, "функция ") Тогда
		Вид = "Функция";
		Остаток = Сред(С, 9);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Скобка = СтрНайти(Остаток, "(");
	Если Скобка = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имя = СокрЛП(Лев(Остаток, Скобка - 1));
	Если Имя = "" Или СтрНайти(Имя, " ") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Вид, Имя", Вид, Имя);
КонецФункции

Функция Нормализовать(Знач Текст) Экспорт
	Результат = Новый Массив;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		С = СокрЛП(УбратьКомментарий(Стр));
		Если С <> "" Тогда
			Результат.Добавить(С);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, Символы.ПС);
КонецФункции

// Удаляет «//»-комментарий; «//» внутри строки и удвоенные «""» не считаются комментарием.
Функция УбратьКомментарий(Знач Стр) Экспорт
	ВСтроке = Ложь;
	Длина = СтрДлина(Стр);
	Й = 1;
	Пока Й <= Длина Цикл
		С = Сред(Стр, Й, 1);
		Если Не ВСтроке Тогда
			Если С = """" Тогда
				ВСтроке = Истина;
			ИначеЕсли С = "/" И Й < Длина И Сред(Стр, Й + 1, 1) = "/" Тогда
				Возврат Лев(Стр, Й - 1);
			КонецЕсли;
		Иначе
			Если С = """" Тогда
				Если Й < Длина И Сред(Стр, Й + 1, 1) = """" Тогда
					Й = Й + 1;
				Иначе
					ВСтроке = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Стр;
КонецФункции

Функция ДоляОтличий(Знач НормА, Знач НормБ) Экспорт
	Счетчик = Новый Соответствие;
	СтрокиА = СтрРазделить(НормА, Символы.ПС, Ложь);
	СтрокиБ = СтрРазделить(НормБ, Символы.ПС, Ложь);
	Для Каждого С Из СтрокиА Цикл
		Было = Счетчик.Получить(С);
		Счетчик.Вставить(С, ?(Было = Неопределено, 0, Было) + 1);
	КонецЦикла;
	Общих = 0;
	Для Каждого С Из СтрокиБ Цикл
		Было = Счетчик.Получить(С);
		Если Было <> Неопределено И Было > 0 Тогда
			Счетчик.Вставить(С, Было - 1);
			Общих = Общих + 1;
		КонецЕсли;
	КонецЦикла;
	Всего = Макс(СтрокиА.Количество(), СтрокиБ.Количество(), 1);
	Возврат (Всего - Общих) / Всего;
КонецФункции

Функция ИзвлечьТелоМетода(Знач ТекстМетода) Экспорт
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	НачОбъявления = -1;
	Вид = "";
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Объявление = РазобратьОбъявление(Строки[Й]);
		Если Объявление <> Неопределено Тогда
			НачОбъявления = Й;
			Вид = Объявление.Вид;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если НачОбъявления < 0 Тогда
		Возврат "";
	КонецЕсли;
	НачТела = НачОбъявления + 1;
	Глубина = 0;
	БылаСкобка = Ложь;
	Для Й = НачОбъявления По Строки.Количество() - 1 Цикл
		Чистая = УбратьКомментарий(Строки[Й]);
		Если СтрНайти(Чистая, "(") > 0 Тогда
			БылаСкобка = Истина;
		КонецЕсли;
		Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
		Если БылаСкобка И Глубина <= 0 Тогда
			НачТела = Й + 1;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Маркер = ?(Вид = "Функция", "конецфункции", "конецпроцедуры");
	КонецТела = Строки.Количество();
	Для Й = НачТела По Строки.Количество() - 1 Цикл
		Если ЭтоМаркерКонцаМетода(Строки[Й], Маркер) Тогда
			КонецТела = Й;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Тело = Новый Массив;
	Для Й = НачТела По КонецТела - 1 Цикл
		Тело.Добавить(Строки[Й]);
	КонецЦикла;
	Возврат СтрСоединить(Тело, Символы.ПС);
КонецФункции

Функция НормализоватьСтроку(Знач Стр) Экспорт
	Возврат СокрЛП(УбратьКомментарий(Стр));
КонецФункции

Функция ЭтоПробельныйСимвол(С)
	Возврат С = " " Или С = Символы.Таб;
КонецФункции

Функция ЭтоЛитералИдентификатора(С)
	К = КодСимвола(С);
	Если (К >= 48 И К <= 57) Или С = "_" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат СтрНайти("_АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯабвгдеёжзийклмнопрстуфхцчшщъыьэюяABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz", С) > 0;
КонецФункции

// Лексемы строки кода без пробелов/табов и без //‑комментария (как срез BSL LS для diff).
Функция ЛексемыСтроки(Знач Стр) Экспорт
	Код = УбратьКомментарий(Стр);
	Токены = Новый Массив;
	Длина = СтрДлина(Код);
	Й = 1;
	Пока Й <= Длина Цикл
		С = Сред(Код, Й, 1);
		Если ЭтоПробельныйСимвол(С) Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ТекстЛит = "";
			Й = Й + 1;
			Пока Й <= Длина Цикл
				С2 = Сред(Код, Й, 1);
				Если С2 = """" Тогда
					Если Й < Длина И Сред(Код, Й + 1, 1) = """" Тогда
						ТекстЛит = ТекстЛит + """";
						Й = Й + 2;
					Иначе
						Й = Й + 1;
						Прервать;
					КонецЕсли;
				Иначе
					ТекстЛит = ТекстЛит + С2;
					Й = Й + 1;
				КонецЕсли;
			КонецЦикла;
			Токены.Добавить("S:" + ТекстЛит);
			Продолжить;
		КонецЕсли;
		Если ЭтоЛитералИдентификатора(С) Тогда
			Слово = С;
			Й = Й + 1;
			Пока Й <= Длина Цикл
				С2 = Сред(Код, Й, 1);
				Если ЭтоЛитералИдентификатора(С2) Тогда
					Слово = Слово + С2;
					Й = Й + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Токены.Добавить(НРег(Слово));
			Продолжить;
		КонецЕсли;
		Дв = С;
		Если Й < Длина Тогда
			Д2 = С + Сред(Код, Й + 1, 1);
			Если Д2 = "<=" Или Д2 = ">=" Или Д2 = "<>" Или Д2 = "!=" Тогда
				Токены.Добавить(Д2);
				Й = Й + 2;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Токены.Добавить(С);
		Й = Й + 1;
	КонецЦикла;
	Возврат Токены;
КонецФункции

Функция ХешСтроки(Строка)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(Строка);
	Возврат НРег(Хеш.ХешСуммаСтрокой);
КонецФункции

// Пустая строка → "" (строка вне diff); иначе MD5 от лексем через «|».
Функция ХешЛексемСтроки(Знач Стр) Экспорт
	Ток = ЛексемыСтроки(Стр);
	Если Ток.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ХешСтроки(СтрСоединить(Ток, "|"));
КонецФункции

Процедура ПеренестиВВне(Ожидающие, Строки, Вне)
	Для Каждого Н Из Ожидающие Цикл
		Вне.Добавить(Строки[Н]);
	КонецЦикла;
	Ожидающие.Очистить();
КонецПроцедуры
