// Быстрая проверка restored перед ibcmd import: ссылки на объекты, которых нет в Configuration.xml, в местах, где 1С
// падает при загрузке («Неизвестный объект метаданных»): Configuration.xml, Ext/*.xml (командный интерфейс, начальная
// страница), подсистемы, Rights.xml ролей, функциональные опции, определяемые типы, общие реквизиты, состав планов обмена,
// подписки на события; ссылки вида «Тег.Имя» и типы cfg:…Ref.Имя.

Перем Вб;
Перем ОТУ;

Функция Проверить(Каталог, Лог = Неопределено, КаталогОтчёта = "") Экспорт
	Кат = ТекущийСценарий().Каталог;
	Вб = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ВозвратОбщихМодулейБп.os"));
	ОТУ = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ОбъектыТолькоУп.os"));
	Состав = Вб.СоставКонфигурации(ОбъединитьПути(Каталог, "Configuration.xml"));
	Теги = Новый Массив;
	Для Каждого Т Из СтрРазделить("Catalog,Document,Enum,ChartOfCharacteristicTypes,ChartOfAccounts,ChartOfCalculationTypes,InformationRegister,"
		+ "AccumulationRegister,AccountingRegister,CalculationRegister,ExchangePlan,BusinessProcess,Task,DocumentJournal,Report,DataProcessor,"
		+ "CommonPicture,StyleItem,CommonCommand,CommonForm,DefinedType,Constant,SettingsStorage,FunctionalOption,CommandGroup,Subsystem,"
		+ "CommonModule,CommonTemplate,SessionParameter,FilterCriterion,Role,Sequence,DocumentNumerator,WebService,HTTPService,"
		+ "EventSubscription,ScheduledJob,CommonAttribute,FunctionalOptionsParameter,XDTOPackage", ",") Цикл
		Теги.Добавить(Т);
	КонецЦикла;
	РвИмя = Новый РегулярноеВыражение("(?<![\wЁё.:/])(" + СтрСоединить(Теги, "|") + ")\.([\wЁё]+)");
	РвCfg = Новый РегулярноеВыражение("cfg:([A-Za-z]+?)(Ref|Object|Manager|RecordSet|RecordKey|RecordManager|List|Selection|ValueManager)?\.([\wЁё]+)");
	РвИмя.ИгнорироватьРегистр = Ложь; // «report.ru» и т.п. — не ссылки
	РвCfg.ИгнорироватьРегистр = Ложь;
	Файлы = Новый Массив;
	Файлы.Добавить(ОбъединитьПути(Каталог, "Configuration.xml"));
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(Каталог, "Ext"), "*.xml", Ложь) Цикл
		Файлы.Добавить(Ф.ПолноеИмя);
	КонецЦикла;
	Для Каждого П Из СтрРазделить("Subsystems|FunctionalOptions|DefinedTypes|CommonAttributes|EventSubscriptions|FunctionalOptionsParameters", "|") Цикл
		Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(Каталог, П), "*.xml", Истина) Цикл
			Файлы.Добавить(Ф.ПолноеИмя);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(Каталог, "Roles"), "Rights.xml", Истина) Цикл
		Файлы.Добавить(Ф.ПолноеИмя);
	КонецЦикла;
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(Каталог, "ExchangePlans"), "Content.xml", Истина) Цикл
		Файлы.Добавить(Ф.ПолноеИмя);
	КонецЦикла;
	Рез = Новый Структура("files, missing", Файлы.Количество(), Новый Массив);
	Было = Новый Соответствие;
	Для Каждого Путь Из Файлы Цикл
		Т = Вб.ПрочитатьТекст(Путь);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отн = СтрЗаменить(Сред(Путь, СтрДлина(Каталог) + 2), "\", "/");
		Для Каждого С Из РвИмя.НайтиСовпадения(Т) Цикл
			Отметить(Состав, С.Группы[1].Значение, С.Группы[2].Значение, Отн, Рез, Было);
		КонецЦикла;
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			Тег = С.Группы[1].Значение;
			Если Теги.Найти(Тег) <> Неопределено Тогда
				Отметить(Состав, Тег, С.Группы[3].Значение, Отн, Рез, Было);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("Проверка ссылок restored перед загрузкой: файлов " + Рез.files + ", ссылок на отсутствующие объекты " + Рез.missing.Количество()
			+ ?(Рез.missing.Количество() > 0, " (первые: " + СтрСоединить(Первые(Рез.missing, 5), "; ") + ")", ""));
	КонецЕсли;
	Если КаталогОтчёта <> "" Тогда
		ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Рез.missing, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8, Истина)
			.Записать(ОбъединитьПути(КаталогОтчёта, "restored_missing_refs.txt"));
	КонецЕсли;
	Возврат Рез;
КонецФункции

Процедура Отметить(Состав, Тег, Имя, Отн, Рез, Было)
	Им = Вб.ИменаТега(Состав, Тег);
	Если Им.Получить(НРег(Имя)) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	К = Отн + ": " + Тег + "." + Имя;
	Если Было.Получить(К) = Неопределено Тогда
		Было.Вставить(К, Истина);
		Рез.missing.Добавить(К);
	КонецЕсли;
КонецПроцедуры

Функция Первые(Массив, Кол)
	Р = Новый Массив;
	Для Каждого Э Из Массив Цикл
		Если Р.Количество() >= Кол Тогда
			Прервать;
		КонецЕсли;
		Р.Добавить(Э);
	КонецЦикла;
	Возврат Р;
КонецФункции
