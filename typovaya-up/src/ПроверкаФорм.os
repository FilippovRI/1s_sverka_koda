// Проверка XML форм: модуль формы restored (БП) против Form.xml restored (БП; overlay при загрузке).
// Обработчики из Form.xml, которых нет в модуле БП, — ручной разбор. Пишет forms_check.json.

Функция Проверить(КаталогВыхода, КореньУп, Разбор) Экспорт
	КатВосст = ОбъединитьПути(КаталогВыхода, "restored");
	КатРасш = ОбъединитьПути(КаталогВыхода, "extension");
	Р = Новый Структура("formModules, adoptedForms, withMissingHandlers, items", 0, 0, 0, Новый Массив);
	Рв = Новый РегулярноеВыражение("<(Event|Action)\b[^>]*>([^<]+)</(Event|Action)>");
	Если Не (Новый Файл(КатВосст)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(КатВосст, "Module.bsl", Истина) Цикл
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, СтрДлина(КатВосст) + 2), "/", "\");
		Если Не СтрЗаканчиваетсяНа(Отн, "\Ext\Form\Module.bsl") Тогда
			Продолжить;
		КонецЕсли;
		Р.formModules = Р.formModules + 1;
		ОтнXml = Лев(Отн, СтрДлина(Отн) - СтрДлина("\Form\Module.bsl")) + "\Form.xml";
		Если (Новый Файл(ОбъединитьПути(КатРасш, СтрЗаменить(ОтнXml, "\", ПолучитьРазделительПути())))).Существует() Тогда
			Р.adoptedForms = Р.adoptedForms + 1;
		КонецЕсли;
		ПутьXml = ОбъединитьПути(КатВосст, СтрЗаменить(ОтнXml, "\", ПолучитьРазделительПути()));
		Если Не (Новый Файл(ПутьXml)).Существует() Тогда
			ПутьXml = ОбъединитьПути(КореньУп, СтрЗаменить(ОтнXml, "\", ПолучитьРазделительПути()));
			Если Не (Новый Файл(ПутьXml)).Существует() Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Методы = Новый Соответствие;
		Для Каждого Мт Из Разбор.РазобратьМодуль(ПрочитатьТекст(Ф.ПолноеИмя)).Методы Цикл
			Методы.Вставить(Мт.Ключ, Истина);
		КонецЦикла;
		Нет = Новый Массив;
		Для Каждого С Из Рв.НайтиСовпадения(ПрочитатьТекст(ПутьXml)) Цикл
			Имя = СокрЛП(С.Группы[2].Значение);
			Если Имя <> "" И Методы.Получить(НРег(Имя)) = Неопределено И Нет.Найти(Имя) = Неопределено Тогда
				Нет.Добавить(Имя);
			КонецЕсли;
		КонецЦикла;
		Если Нет.Количество() > 0 Тогда
			Р.withMissingHandlers = Р.withMissingHandlers + 1;
			Р.items.Добавить(Новый Структура("form, missingHandlers, decision", Отн, Нет, "manual"));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПрочитатьТекст(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", СтрЗаменить(Т, Символы.ВК, ""));
КонецФункции
