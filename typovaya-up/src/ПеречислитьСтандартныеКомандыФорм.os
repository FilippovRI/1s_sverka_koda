// Инвентаризация стандартных команд списков в Form.xml расширения (без удаления).
// oscript ПеречислитьСтандартныеКомандыФорм.os [каталог extension] [файл отчёта]
КореньРасш = "D:\typovaya-up-out-20261118u\extension";
ПутьОтч = "D:\typovaya-up-standard-commands.json";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	КореньРасш = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	ПутьОтч = СокрЛП(АргументыКоманднойСтроки[1]);
КонецЕсли;
РвCmd = Новый РегулярноеВыражение("<CommandName>([^<]+)</CommandName>");
РвExc = Новый РегулярноеВыражение("<ExcludedCommand>([^<]+)</ExcludedCommand>");
Интерес = Новый Соответствие;
Для Каждого К Из СтрРазделить("Copy,Find,SortListAsc,Create,Delete,Change,SetDeletionMark,Refresh,Output,CustomizeForm", ",") Цикл
	Интерес.Вставить(К, Истина);
КонецЦикла;
Формы = Новый Соответствие;
Всего = 0;
Для Каждого Ф Из НайтиФайлы(КореньРасш, "Form.xml", Истина) Цикл
	Т = Новый ТекстовыйДокумент;
	Попытка
		Т.Прочитать(Ф.ПолноеИмя, КодировкаТекста.UTF8);
	Исключение
		Продолжить;
	КонецПопытки;
	Текст = Т.ПолучитьТекст();
	Отн = Сред(Ф.ПолноеИмя, СтрДлина(КореньРасш) + 2);
	Строки = Новый Массив;
	Для Каждого Рв Из Новый Массив(РвCmd, РвExc) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
			К = С.Группы[1].Значение;
			Если СтрНайти(К, "StandardCommand") = 0 И СтрНайти(К, "Form.StandardCommand") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Всего = Всего + 1;
			Строки.Добавить(К);
		КонецЦикла;
	КонецЦикла;
	Если СтрНайти(Текст, ".StandardCommand.") > 0 Тогда
		Для Каждого С Из РвCmd.НайтиСовпадения(Текст) Цикл
			К = С.Группы[1].Значение;
			Если СтрНайти(К, "StandardCommand") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Строки.Найти(К) = Неопределено Тогда
				Всего = Всего + 1;
				Строки.Добавить(К);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Строки.Количество() > 0 Тогда
		Формы.Вставить(Отн, Строки);
	КонецЕсли;
КонецЦикла;
Ч = Новый ЗаписьJSON;
Ч.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
ЗаписатьJSON(Ч, Новый Структура("formCount, commandRefs, forms", Формы.Количество(), Всего, Формы));
ТекстJson = Ч.Закрыть();
ПолучитьДвоичныеДанныеИзСтроки(ТекстJson, КодировкаТекста.UTF8, Истина).Записать(ПутьОтч);
Сообщить("Форм со стандартными командами: " + Формы.Количество() + ", ссылок: " + Всего);
Сообщить(ПутьОтч);