// Точечная ibcmd-подготовка перечисленных Form.xml (по одному пути на строку в .lst или argv).
Фр = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФормыRestored.os"));
Список = Новый Массив;
Если АргументыКоманднойСтроки.Количество() > 0 И СтрЗаканчиваетсяНа(НРег(АргументыКоманднойСтроки[0]), ".lst") Тогда
	Тм = Новый ТекстовыйДокумент;
	Тм.Прочитать(АргументыКоманднойСтроки[0], КодировкаТекста.UTF8);
	Для Каждого Стр Из СтрРазделить(Тм.ПолучитьТекст(), Символы.ПС, Истина) Цикл
		Если СокрЛП(Стр) <> "" Тогда
			Список.Добавить(СокрЛП(Стр));
		КонецЕсли;
	КонецЦикла;
Иначе
	Для Каждого А Из АргументыКоманднойСтроки Цикл
		Список.Добавить(СокрЛП(А));
	КонецЦикла;
КонецЕсли;
РежимТип = "";
Для Каждого П Из Список Цикл
	Если П = "--type" Или П = "--type-soft" Или П = "--type-min" Тогда
		РежимТип = П;
	Иначе
		// путь формы — ниже
	КонецЕсли;
КонецЦикла;
СписокПутей = Новый Массив;
Для Каждого П Из Список Цикл
	Если П = "--type" Или П = "--type-soft" Или П = "--type-min" Тогда
		Продолжить;
	КонецЕсли;
	СписокПутей.Добавить(П);
КонецЦикла;
Для Каждого П Из СписокПутей Цикл
	Ф = Новый Файл(П);
	Если Не Ф.Существует() Тогда
		Сообщить("skip missing: " + П);
		Продолжить;
	КонецЕсли;
	Т = Фр.ПрочитатьТекстUtf8(П);
	Нов = Фр.ПодготовитьFormXmlКIbcmd(Т);
	Если РежимТип = "--type" Тогда
		Нов = Фр.ДопостобработкаFormXmlНаДиске(Нов);
	ИначеЕсли РежимТип = "--type-min" Тогда
		Нов = Фр.ДопостобработкаТиповIbcmdМинимум(Нов);
	ИначеЕсли РежимТип = "--type-soft" Тогда
		Нов = Фр.ДопостобработкаТиповIbcmd(Нов);
	КонецЕсли;
	ПолучитьДвоичныеДанныеИзСтроки(Нов, КодировкаТекста.UTF8, Истина).Записать(П);
	Сообщить("fixed: " + П);
КонецЦикла;