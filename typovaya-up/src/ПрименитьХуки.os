// Точечное дописывание хуков в extension по списку up_changes_not_moved.json (без полного прогона).
// oscript src/ПрименитьХуки.os --выход D:\out --уп D:\УП --бп D:\БП --список D:\out\up_changes_not_moved.json

Выход = "";
Уп = "";
Бп = "";
Список = "";
Префикс = "УП_";
Парсер = "bsparser";

Для Й = 0 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(АргументыКоманднойСтроки[Й]);
	Если (А = "--выход" Или А = "--out") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Выход = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли (А = "--уп" Или А = "--source") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Уп = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли (А = "--бп" Или А = "--vendor") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Бп = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли (А = "--список" Или А = "--list") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Список = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли (А = "--префикс" Или А = "--prefix") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Префикс = АргументыКоманднойСтроки[Й + 1]; Й = Й + 1;
	ИначеЕсли (А = "--парсер" Или А = "--parser") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Парсер = НРег(АргументыКоманднойСтроки[Й + 1]); Й = Й + 1;
	КонецЕсли;
КонецЦикла;

Если Выход = "" Или Уп = "" Или Бп = "" Тогда
	Сообщить("Нужны --выход, --уп, --бп");
	ВызватьИсключение "args";
КонецЕсли;
Если Список = "" Тогда
	Список = ОбъединитьПути(Выход, "up_changes_not_moved.json");
КонецЕсли;
Если Не (Новый Файл(Список)).Существует() Тогда
	Сообщить("Нет файла списка: " + Список);
	ВызватьИсключение "list";
КонецЕсли;

Кат = ТекущийСценарий().Каталог;
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Кат, "РазборМетодов.os"));
Без = ЗагрузитьСценарий(ОбъединитьПути(Кат, "БезопасностьПереноса.os"));
Синтез = ЗагрузитьСценарий(ОбъединитьПути(Кат, "СинтезХуков.os"));
Синтез.Инициализировать(Разбор, Без);
Контракт = ЗагрузитьСценарий(ОбъединитьПути(Кат, "КонтрактМетода.os"));
Настр = ЗагрузитьСценарий(ОбъединитьПути(Кат, "НастройкиСравнения.os"));
Выг = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЧтениеВыгрузки.os"));
Ср = ЗагрузитьСценарий(ОбъединитьПути(Кат, "Сравнение.os"));
Ср.Инициализировать(Разбор, Выг, Настр, Синтез, Контракт, Без);
Аст = ЗагрузитьСценарий(ОбъединитьПути(Кат, "РазборAST.os"));
Если Парсер = "bsparser" Тогда
	Ср.ВключитьBsparser(Аст);
КонецЕсли;

Черн = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЧерновикРасширения.os"));
Черн.Инициализировать(Разбор, Настр);
Перенос = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ПереносСигнатур.os"));
Перенос.Инициализировать(Разбор, Контракт);

Чтение = Новый ЧтениеJSON;
Чтение.ОткрытьФайл(Список, "UTF-8");
Данные = ПрочитатьJSON(Чтение);
Чтение.Закрыть();

ПоМодулям = Новый Соответствие;
ПутиМодулей = Новый Массив;
Для Каждого Э Из Данные.items Цикл
	П = Строка(Э.path);
	Мас = ПоМодулям.Получить(П);
	Если Мас = Неопределено Тогда
		Мас = Новый Массив;
		ПоМодулям.Вставить(П, Мас);
		ПутиМодулей.Добавить(П);
	КонецЕсли;
	Мас.Добавить(Строка(Э.method));
КонецЦикла;

Лог = Новый Массив;
Исходная = Выг.ПрочитатьВыгрузку(Уп, Лог);
Поставщик = Выг.ПрочитатьВыгрузку(Бп, Лог);
КаталогРасш = ОбъединитьПути(Выход, "extension");
Модули = Новый Массив;
Задачи = Новый Массив;

Для Каждого Путь Из ПутиМодулей Цикл
	М = Ср.СравнитьМодуль(Путь,
		Исходная.Модули.Получить(Путь), Поставщик.Модули.Получить(Путь));
	Модули.Добавить(М);
	Задачи.Добавить(Новый Структура("path, module, names", Путь, М, ПоМодулям.Получить(Путь)));
КонецЦикла;

Черн.УстановитьКартыСигнатур(Перенос.СобратьКарты(Модули, Префикс));

Добавлено = 0;
Осталось = 0;

Для Каждого З Из Задачи Цикл
	М = З.module;
	Имена = З.names;
	Итог = Новый Структура("hooks, methods, helpersCopied, upCopies, callRewrites", 0, 0, 0, 0, 0);
	Добавлено = Добавлено + Черн.ДописатьВРасширение(КаталогРасш, М, Префикс, Имена, Итог, Лог);
	Для Каждого Имя Из Имена Цикл
		Перенесён = Ложь;
		Для Каждого Мт Из М.methods Цикл
			Если НРег(Мт.name) <> НРег(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Если Черн.ИдётВРасширение(Мт) Или Перенос.ЭтоПеренос(Мт) Тогда
				Перенесён = Истина;
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Если Не Перенесён Тогда
			Осталось = Осталось + 1;
		КонецЕсли;
	КонецЦикла;
КонецЦикла;

Сообщить("Дописано фрагментов: " + Добавлено + ", по-прежнему без переноса (оценка): " + Осталось);
Для Каждого Стр Из Лог Цикл
	Сообщить(Стр);
КонецЦикла;