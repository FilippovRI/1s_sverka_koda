// PREVIEW РеквизитФормы/ИзменитьРеквизиты — не пишется в extension/restored, не меняет Form.xml.
// Поддержан один новый реквизит: xs:string | xs:boolean, без изменений существующих, без динамики в Module.bsl.

Функция ОценитьПревью(Доб, Уд, Об, КартаИсх, ПутьFormИсх) Экспорт
	Рез = Новый Структура("programGeneration, previewReason, previewCode, insertHint",
		"manual", "", "", "");
	Если Об.Количество() > 0 Тогда
		Рез.previewReason = "изменён существующий реквизит (type/DataPath) — preview только для одиночного added";
		Возврат Рез;
	КонецЕсли;
	Если Доб.Количество() <> 1 Тогда
		Рез.previewReason = "поддержан ровно один новый реквизит, найдено: " + Доб.Количество();
		Возврат Рез;
	КонецЕсли;
	Если Уд.Количество() > 0 Тогда
		Рез.previewReason = "удалённые реквизиты в форме — preview не генерируется";
		Возврат Рез;
	КонецЕсли;
	Имя = Доб[0];
	Инфо = КартаИсх.Получить(Имя);
	Если Инфо = Неопределено Тогда
		Рез.previewReason = "нет описания реквизита в УП";
		Возврат Рез;
	КонецЕсли;
	ТипБлок = Инфо.type;
	Если Не ПоддерживаемыйТипПревью(ТипБлок) Тогда
		Рез.previewReason = "тип не поддержан для preview: " + ТипБлок + " (только xs:string, xs:boolean)";
		Возврат Рез;
	КонецЕсли;
	Если СокрЛП(Инфо.dataPath) <> "" Тогда
		Рез.previewReason = "DataPath задан (" + Инфо.dataPath + ") — зависимость от сервера не доказана";
		Возврат Рез;
	КонецЕсли;
	ТекстМодуля = ПрочитатьМодульФормы(ПутьFormИсх);
	ПричМ = ПроверитьМодульФормы(ТекстМодуля, Имя);
	Если ПричМ <> "" Тогда
		Рез.previewReason = ПричМ;
		Возврат Рез;
	КонецЕсли;
	Рез.programGeneration = "preview";
	Рез.insertHint = "Вставьте вызов в серверную процедуру ДО первого обращения к реквизиту "
		+ "(например ПриСозданииНаСервере); точка не доказана анализатором.";
	Рез.previewCode = СгенерироватьКодПревью(Имя, ТипБлок);
	Рез.previewReason = "одиночный added, " + ТипБлок;
	Возврат Рез;
КонецФункции

Функция ПоддерживаемыйТипПревью(ТипСтрока) Экспорт
	Т = НРег(СокрЛП(ТипСтрока));
	Возврат Т = "xs:string" Или Т = "xs:boolean";
КонецФункции

Функция ПрочитатьМодульФормы(ПутьFormXml)
	База = Лев(ПутьFormXml, СтрДлина(ПутьFormXml) - СтрДлина("Form.xml"));
	М = ОбъединитьПути(База, "Form", "Module.bsl");
	Если Не (Новый Файл(М)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(М, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Функция ПроверитьМодульФормы(Текст, ИмяРеквизита)
	Если СокрЛП(Текст) = "" Тогда
		Возврат "";
	КонецЕсли;
	Н = НРег(Текст);
	ИН = НРег(ИмяРеквизита);
	Если СтрНайти(Н, "реквизитформы") > 0 Или СтрНайти(Н, "изменитьреквизиты") > 0 Тогда
		Шаблон1 = "реквизитформы(""" + ИН + """";
		Шаблон2 = "реквизитформы('" + ИН + "'";
		Если СтрНайти(Н, Шаблон1) > 0 Или СтрНайти(Н, Шаблон2) > 0 Тогда
			Возврат "Module.bsl: дублирующее runtime-создание реквизита " + ИмяРеквизита;
		КонецЕсли;
		Возврат "Module.bsl: уже есть РеквизитФормы/ИзменитьРеквизиты — консервативно manual";
	КонецЕсли;
	Если СтрНайти(Н, ИН) > 0 Тогда
		Возврат "Module.bsl: обращение к " + ИмяРеквизита + " до доказанной точки вставки";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СгенерироватьКодПревью(Имя, ТипСтрока) Экспорт
	ТипБсл = ФрагментОписаниеТипов(ТипСтрока);
	Ч = Новый Массив;
	Ч.Добавить("// PREVIEW typovaya-up — не загружается в extension автоматически");
	Ч.Добавить("// РеквизитФормы + ИзменитьРеквизиты (управляемая форма)");
	Ч.Добавить("");
	Ч.Добавить("&НаСервере");
	Ч.Добавить("Процедура УП_ПревьюДобавить_" + Имя + "()");
	Ч.Добавить("	НовРек = Новый РеквизитФормы(""" + Имя + """, " + ТипБсл + ");");
	Ч.Добавить("	Добавляемые = Новый Массив;");
	Ч.Добавить("	Добавляемые.Добавить(НовРек);");
	Ч.Добавить("	ИзменитьРеквизиты(Добавляемые, , );");
	Ч.Добавить("КонецПроцедуры");
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

Функция ФрагментОписаниеТипов(ТипСтрока)
	Т = НРег(СокрЛП(ТипСтрока));
	Если Т = "xs:boolean" Тогда
		Возврат "Новый ОписаниеТипов(""Булево"")";
	КонецЕсли;
	Возврат "Новый ОписаниеТипов(""Строка"", , Новый КвалификаторыСтроки(100))";
КонецФункции

Функция ИмяФайлаПревью(КлючФормы) Экспорт
	Без = СтрЗаменить(СтрЗаменить(КлючФормы, "\", "_"), "/", "_");
	Возврат Без + ".preview.bsl";
КонецФункции

Функция ЗаписатьHtmlПревью(Каталог, Элементы) Экспорт
	Стр = Новый Массив;
	Стр.Добавить("<!DOCTYPE html><html><head><meta charset=""utf-8""/><title>forms preview</title>");
	Стр.Добавить("<style>body{font-family:sans-serif}table{border-collapse:collapse}td,th{border:1px solid #ccc;padding:4px 8px}pre{font-size:12px}</style></head><body>");
	Стр.Добавить("<h1>Превью реквизитов форм (не extension)</h1><table><tr><th>path</th><th>generation</th><th>reason</th><th>preview</th></tr>");
	Для Каждого Э Из Элементы Цикл
		Если Э.programGeneration <> "preview" И СтрНайти(Э.note, "превью") = 0 И Э.previewReason = "" Тогда
			Продолжить;
		КонецЕсли;
		Код = ?(Э.previewCode = "", "—", "<pre>" + ЭкранHtml(Э.previewCode) + "</pre>");
		Прич = ?(Э.previewReason = "", Э.note, Э.previewReason);
		Стр.Добавить("<tr><td>" + ЭкранHtml(Э.path) + "</td><td>" + Э.programGeneration + "</td><td>"
			+ ЭкранHtml(Прич) + "</td><td>" + Код + "</td></tr>");
	КонецЦикла;
	Стр.Добавить("</table></body></html>");
	ЗаписатьТекст(ОбъединитьПути(Каталог, "forms_preview.html"), СтрСоединить(Стр, ""));
КонецФункции

Функция ЭкранHtml(С)
	С = СтрЗаменить(С, "&", "&amp;");
	С = СтрЗаменить(С, "<", "&lt;");
	С = СтрЗаменить(С, ">", "&gt;");
	Возврат С;
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст) Экспорт
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст(Текст);
	Тд.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры
