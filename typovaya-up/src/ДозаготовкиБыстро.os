// Быстрые дозаготовки по логу ibcmd (без полной пересборки typovaya-up).
// oscript ДозаготовкиБыстро.os --лог <файл> [--out D:\...\typovaya-up-out] [--цель restored|extension]
КореньСк = ТекущийСценарий().Каталог;
Выход = "D:\typovaya-up-out-20261118u";
КореньБп = "D:\выгрузка БП";
КореньУп = "D:\Выгрузка УП";
ПутьЛога = "";
Цель = "restored";
ПостВсеForm = Ложь;
FormДословно = Ложь;
Для Й = 0 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
	Если (А = "--лог" Или А = "--log") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		ПутьЛога = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--out" Или А = "--выход") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Выход = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--цель" Или А = "--target") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Цель = НРег(АргументыКоманднойСтроки[Й + 1]);
		Й = Й + 1;
	ИначеЕсли (А = "--бп" Или А = "--bp") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		КореньБп = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--уп" Или А = "--up") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		КореньУп = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли А = "--post-all-forms" Тогда
		ПостВсеForm = Истина;
	ИначеЕсли А = "--forms-literal" Тогда
		FormДословно = Истина;
	КонецЕсли;
КонецЦикла;
Если ПутьЛога = "" Или Не (Новый Файл(ПутьЛога)).Существует() Тогда
	ВызватьИсключение "укажите --лог <файл ibcmd>";
КонецЕсли;
Корень = ОбъединитьПути(Выход, ?(Цель = "extension", "extension", "restored"));
Заг = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ЗаготовкиОбъектовБп.os"));
Лог = Новый Массив;
Разбор = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "РазборЛогаИмпорта.os"));
Пути = Разбор.ПутиНеизвестныхМетаданных(ПутьЛога);
Сообщить("путей из лога: " + Пути.Количество());
// Пути уже собраны выше для постобработки Form.xml
Доп = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ДополненияПоЛогуImport.os"));
Р = Заг.ДополнитьЗаготовкиТолькоПоЛогу(Корень, КореньБп, КореньУп, ПутьЛога, Лог);
Р.Вставить("formsLiteral", 0);
Р.Вставить("formsPost", 0);
Р.Вставить("formsPostStub", 0);
Если Цель = "restored" Тогда
	Заг.Инициализировать();
	Если FormДословно Тогда
		Р.formsLiteral = Заг.ВернутьFormXmlИзБп(Корень, КореньБп);
		Лог.Добавить("restored: Form.xml дословно из БП, файлов " + Р.formsLiteral);
	КонецЕсли;
	Доп.КопироватьCommonPictureПоЛогу("", Корень, КореньБп, Лог);
Иначе
	Фр = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ФормыRestored.os"));
	Р.Вставить("formsPost", Фр.ПостобработкаFormПоПутямЛога(Корень, Пути, Лог, Истина));
	Если ПостВсеForm Тогда
		Р.Вставить("formsPostAll", Фр.ПостобработкаВсехForm(Корень, Лог, Истина));
	КонецЕсли;
КонецЕсли;
РДоп = Доп.Применить(Корень, КореньБп, ПутьЛога, Лог, Цель = "extension");
Р.Вставить("logExtras", РДоп);
Отч = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ОтчетHTML.os"));
Стат = ?(Р.Свойство("stats"), Р.stats, Неопределено);
Отч.ЗаписатьФайл(ОбъединитьПути(Корень, "stubs_fast.json"), Отч.ВJSON(Новый Структура("paths, stubs, fragments, requirements, stats, formsLiteral, formsPost, formsPostStub, log",
	Р.paths, Р.stubs, Р.fragments, Р.requirements, Стат, Р.formsLiteral, Р.formsPost, ?(Р.Свойство("formsPostStub"), Р.formsPostStub, 0), Лог)));
Сообщить("stubs=" + Р.stubs + " fragments=" + Р.fragments + " requirements=" + Р.requirements);
Для Каждого Стр Из Лог Цикл
	Сообщить(Стр);
КонецЦикла;