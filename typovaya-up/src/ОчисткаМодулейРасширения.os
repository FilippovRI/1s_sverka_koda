// Удаление из extension методов, на которых CheckModules фиксирует «Переменная не определена» (класс 3).

Перем Разбор;

Процедура Инициализировать(МодульРазбора) Экспорт
	Разбор = МодульРазбора;
КонецПроцедуры

Функция ОшибкиРасширенияИзЛога(Текст, ИмяРасширения = "УП_Доработки") Экспорт
	Р = Новый Массив;
	Зм = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаглушкиМетодовБп.os"));
	Рв = Новый РегулярноеВыражение("(?m)^\{([^{}]+?)\((\d+),(\d+)\)\}:[ \t]*([^\r\n]*)");
	Пре = НРег(ИмяРасширения + " ");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Об = СокрЛП(С.Группы[1].Значение);
		Если СтрНайти(Об, " ") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если НРег(Лев(Об, СтрДлина(Пре))) <> Пре Тогда
			Продолжить;
		КонецЕсли;
		Объект = СокрЛП(Сред(Об, СтрДлина(ИмяРасширения) + 2));
		Р.Добавить(Новый Структура("object, line, message", Объект, Число(С.Группы[2].Значение), СокрЛП(С.Группы[4].Значение)));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция МетодПоСтроке(Методы, Строка)
	Для Каждого М Из Методы Цикл
		Если М.Начало <= Строка И М.Конец >= Строка Тогда
			Возврат М;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция УдалитьМетодыИзТекста(Текст, ИменаМетодовНРег)
	Если ИменаМетодовНРег.Количество() = 0 Тогда
		Возврат Новый Структура("text, removed", Текст, 0);
	КонецЕсли;
	Методы = Разбор.РазобратьМодуль(Текст).Методы;
	Удал = Новый Соответствие;
	Для Каждого М Из Методы Цикл
		Если ИменаМетодовНРег.Получить(М.Ключ) <> Неопределено Тогда
			Удал.Вставить(М.Начало - 1, М.Конец - 1);
		КонецЕсли;
	КонецЦикла;
	Если Удал.Количество() = 0 Тогда
		Возврат Новый Структура("text, removed", Текст, 0);
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Р = Новый Массив;
	Й = 0;
	Пока Й <= Строки.ВГраница() Цикл
		К = Удал.Получить(Й);
		Если К <> Неопределено Тогда
			Й = К + 1;
			Продолжить;
		КонецЕсли;
		Р.Добавить(Строки[Й]);
		Й = Й + 1;
	КонецЦикла;
	Возврат Новый Структура("text, removed", СтрСоединить(Р, Символы.ПС), Удал.Количество());
КонецФункции

Функция Применить(Ошибки, КаталогРасш, ИмяРасширения = "УП_Доработки", Лог = Неопределено) Экспорт
	Итог = Новый Структура("removedMethods, files, items", 0, Новый Массив, Новый Массив);
	Зм = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаглушкиМетодовБп.os"));
	Раздел = ПолучитьРазделительПути();
	ПоФайлу = Новый Соответствие;
	Для Каждого О Из Ошибки Цикл
		Отн = Зм.ОтносительныйПуть(О.object, Раздел);
		Если Отн = "" Тогда
			Продолжить;
		КонецЕсли;
		Сп = ПоФайлу.Получить(Отн);
		Если Сп = Неопределено Тогда
			Сп = Новый Массив;
			ПоФайлу.Вставить(Отн, Сп);
		КонецЕсли;
		Сп.Добавить(О);
	КонецЦикла;
	Для Каждого КЗ Из ПоФайлу Цикл
		Путь = ОбъединитьПути(КаталогРасш, КЗ.Ключ);
		Ф = Новый Файл(Путь);
		Если Не Ф.Существует() Тогда
			Продолжить;
		КонецЕсли;
		Тд = Новый ТекстовыйДокумент;
		Тд.Прочитать(Путь, КодировкаТекста.UTF8);
		Текст = Тд.ПолучитьТекст();
		Методы = Разбор.РазобратьМодуль(Текст).Методы;
		Имена = Новый Соответствие;
		Для Каждого О Из КЗ.Значение Цикл
			Мт = МетодПоСтроке(Методы, О.line);
			Если Мт <> Неопределено Тогда
				Имена.Вставить(Мт.Ключ, Мт.Имя);
			КонецЕсли;
		КонецЦикла;
		Р = УдалитьМетодыИзТекста(Текст, Имена);
		Если Р.removed > 0 И Р.text <> Текст Тогда
			Тд.УстановитьТекст(Р.text);
			Тд.Записать(Путь, КодировкаТекста.UTF8);
			Итог.removedMethods = Итог.removedMethods + Р.removed;
			Итог.files.Добавить(КЗ.Ключ);
			Для Каждого КИ Из Имена Цикл
				Итог.items.Добавить(КЗ.Ключ + ": " + КИ.Значение);
			КонецЦикла;
			Если Лог <> Неопределено Тогда
				Лог.Добавить("Очистка extension: " + КЗ.Ключ + " — удалено методов " + Р.removed);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Итог;
КонецФункции