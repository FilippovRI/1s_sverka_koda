// Запуск ibcmd/oscript без КомандаОС (OneScript 2.x): cmd через ЗапуститьПриложение.

Функция ВременныйКаталог(Префикс) Экспорт
	База = ОбъединитьПути(КаталогВременныхФайлов(), Префикс + "_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss"));
	СоздатьКаталог(База);
	Возврат База;
КонецФункции

Функция ЭкранироватьДляPs(Стр)
	Возврат СтрЗаменить(Стр, "'", "''");
КонецФункции

Функция ИсполнитьCmd(СтрокаКоманды, КаталогРаботы = "", ЛогФайл = "") Экспорт
	Вр = ВременныйКаталог("sh");
	ИмяBat = ОбъединитьПути(Вр, "run.cmd");
	ИмяЛог = ?(ЛогФайл = "", ОбъединитьПути(Вр, "out.txt"), ЛогФайл);
	Если ЛогФайл <> "" Тогда
		СоздатьКаталог((Новый Файл(ИмяЛог)).Путь);
	КонецЕсли;
	З = Новый ЗаписьТекста(ИмяBat, "UTF-8");
	З.ЗаписатьСтроку("@echo off");
	Если КаталогРаботы <> "" Тогда
		З.ЗаписатьСтроку("cd /d " + """" + КаталогРаботы + """");
	КонецЕсли;
	Если ЛогФайл <> "" Тогда
		З.ЗаписатьСтроку("chcp 65001>nul");
		З.ЗаписатьСтроку("(" + СтрокаКоманды + ") 1> """ + ИмяЛог + """ 2>&1");
	Иначе
		З.ЗаписатьСтроку(СтрокаКоманды + " 1> """ + ИмяЛог + """ 2>&1");
	КонецЕсли;
	З.ЗаписатьСтроку("exit /b %ERRORLEVEL%");
	З.Закрыть();
	Код = 0;
	ЗапуститьПриложение(ИмяBat, Вр, Истина, Код);
	Текст = "";
	Если (Новый Файл(ИмяЛог)).Существует() Тогда
		Тм = Новый ТекстовыйДокумент;
		Тм.Прочитать(ИмяЛог, КодировкаТекста.UTF8);
		Текст = Тм.ПолучитьТекст();
	КонецЕсли;
	Возврат Новый Структура("exitCode, output, log", Код, Текст, ИмяЛог);
КонецФункции

Функция КавЫдержать(Путь)
	Возврат """" + Путь + """";
КонецФункции

// a|b|c — надёжнее Новый Массив(...) в OneScript 2.x
Функция ArgvИзСтрок(Стр) Экспорт
	Р = Новый Массив;
	Для Каждого Ч Из СтрРазделить(Стр, "|") Цикл
		Р.Добавить(Ч);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИсполнитьIbcmd(ПутьIbcmd, Argv, ЛогФайл = "") Экспорт
	Части = Новый Массив;
	Части.Добавить(КавЫдержать(ПутьIbcmd));
	Для Каждого А Из Argv Цикл
		Если СтрНайти(А, " ") > 0 Тогда
			Части.Добавить(КавЫдержать(А));
		Иначе
			Части.Добавить(А);
		КонецЕсли;
	КонецЦикла;
	Возврат ИсполнитьCmd(СтрСоединить(Части, " "), "", ЛогФайл);
КонецФункции