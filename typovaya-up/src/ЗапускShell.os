// Запуск ibcmd/oscript без КомандаОС (OneScript 2.x): cmd + PowerShell для полного лога.

Функция ВременныйКаталог(Префикс) Экспорт
	База = ОбъединитьПути(КаталогВременныхФайлов(), Префикс + "_" + Формат(ТекущаяДата(), "ДФ=yyyyMMdd_HHmmss"));
	СоздатьКаталог(База);
	Возврат База;
КонецФункции

Функция ЭкранироватьДляPs(Стр)
	Возврат СтрЗаменить(Стр, "'", "''");
КонецФункции

Функция ИсполнитьCmd(СтрокаКоманды, КаталогРаботы = "", ЛогФайл = "") Экспорт
	Вр = ВременныйКаталог("sh");
	ИмяBat = ОбъединитьПути(Вр, "run.cmd");
	ИмяPs = ОбъединитьПути(Вр, "run.ps1");
	ИмяЛог = ?(ЛогФайл = "", ОбъединитьПути(Вр, "out.txt"), ЛогФайл);
	Если ЛогФайл <> "" Тогда
		СоздатьКаталог((Новый Файл(ИмяЛог)).Путь);
	КонецЕсли;
	З = Новый ЗаписьТекста(ИмяBat, "UTF-8");
	З.ЗаписатьСтроку("@echo off");
	Если КаталогРаботы <> "" Тогда
		З.ЗаписатьСтроку("cd /d " + """" + КаталогРаботы + """");
	КонецЕсли;
	Если ЛогФайл <> "" Тогда
		// Лог через cmd (для Start-Process нужен разбор в ИсполнитьIbcmd).
		З.ЗаписатьСтроку("chcp 65001>nul");
		З.ЗаписатьСтроку("(" + СтрокаКоманды + ") 1> """ + ИмяЛог + """ 2>&1");
	Иначе
		З.ЗаписатьСтроку(СтрокаКоманды + " 1> """ + ИмяЛог + """ 2>&1");
	КонецЕсли;
	З.ЗаписатьСтроку("exit /b %ERRORLEVEL%");
	З.Закрыть();
	Код = 0;
	ЗапуститьПриложение(ИмяBat, Вр, Истина, Код);
	Текст = "";
	Если (Новый Файл(ИмяЛог)).Существует() Тогда
		Тм = Новый ТекстовыйДокумент;
		Тм.Прочитать(ИмяЛог, КодировкаТекста.UTF8);
		Текст = Тм.ПолучитьТекст();
	КонецЕсли;
	Возврат Новый Структура("exitCode, output, log", Код, Текст, ИмяЛог);
КонецФункции

Функция КавЫдержать(Путь)
	Возврат """" + Путь + """";
КонецФункции

Функция ArgvИзСтрок(Стр) Экспорт
	Р = Новый Массив;
	Для Каждого Ч Из СтрРазделить(Стр, "|") Цикл
		Р.Добавить(Ч);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИсполнитьIbcmd(ПутьIbcmd, Argv, ЛогФайл = "") Экспорт
	Если ЛогФайл = "" Тогда
		Части = Новый Массив;
		Части.Добавить(КавЫдержать(ПутьIbcmd));
		Для Каждого А Из Argv Цикл
			Если СтрНайти(А, " ") > 0 Тогда
				Части.Добавить(КавЫдержать(А));
			Иначе
				Части.Добавить(А);
			КонецЕсли;
		КонецЦикла;
		Возврат ИсполнитьCmd(СтрСоединить(Части, " "), "", ЛогФайл);
	КонецЕсли;
	Вр = ВременныйКаталог("ib");
	ИмяPs = ОбъединитьПути(Вр, "ib.ps1");
	ИмяBat = ОбъединитьПути(Вр, "ib.cmd");
	СоздатьКаталог((Новый Файл(ЛогФайл)).Путь);
	Пс = Новый ЗаписьТекста(ИмяPs, "UTF-8");
	ИмяКод = ОбъединитьПути(Вр, "exitcode.txt");
	Пс.ЗаписатьСтроку("$log = '" + ЭкранироватьДляPs(ЛогФайл) + "'");
	Пс.ЗаписатьСтроку("$ec = '" + ЭкранироватьДляPs(ИмяКод) + "'");
	Пс.ЗаписатьСтроку("$arg = @(");
	Для Й = 0 По Argv.ВГраница() Цикл
		Пс.ЗаписатьСтроку("  '" + ЭкранироватьДляPs(Argv[Й]) + "'" + ?(Й < Argv.ВГраница(), ",", ""));
	КонецЦикла;
	Пс.ЗаписатьСтроку(")");
	Пс.ЗаписатьСтроку("[Console]::OutputEncoding = [System.Text.UTF8Encoding]::new($false)");
	Пс.ЗаписатьСтроку("$exe = '" + ЭкранироватьДляPs(ПутьIbcmd) + "'");
	Пс.ЗаписатьСтроку("$buf = New-Object System.Collections.Generic.List[string]");
	Пс.ЗаписатьСтроку("$output = & $exe @arg 2>&1");
	Пс.ЗаписатьСтроку("$code = $LASTEXITCODE");
	Пс.ЗаписатьСтроку("foreach ($line in $output) { [void]$buf.Add($line.ToString()) }");
	Пс.ЗаписатьСтроку("$buf | Out-File -LiteralPath $log -Encoding utf8");
	Пс.ЗаписатьСтроку("$code | Out-File -LiteralPath $ec -Encoding ascii -NoNewline");
	Пс.ЗаписатьСтроку("exit $code");
	Пс.Закрыть();
	З = Новый ЗаписьТекста(ИмяBat, "UTF-8");
	З.ЗаписатьСтроку("@echo off");
	З.ЗаписатьСтроку("powershell -NoProfile -ExecutionPolicy Bypass -File """ + ИмяPs + """");
	З.ЗаписатьСтроку("exit /b %ERRORLEVEL%");
	З.Закрыть();
	Код = 0;
	ЗапуститьПриложение(ИмяBat, Вр, Истина, Код);
	Если (Новый Файл(ИмяКод)).Существует() Тогда
		ТмК = Новый ТекстовыйДокумент;
		ТмК.Прочитать(ИмяКод);
		Код = Число(СокрЛП(ТмК.ПолучитьТекст()));
	ИначеЕсли Код < 0 Тогда
		Код = 1;
	КонецЕсли;
	Текст = "";
	Если (Новый Файл(ЛогФайл)).Существует() Тогда
		Тм = Новый ТекстовыйДокумент;
		Тм.Прочитать(ЛогФайл, КодировкаТекста.UTF8);
		Текст = Тм.ПолучитьТекст();
	КонецЕсли;
	Возврат Новый Структура("exitCode, output, log", Код, Текст, ЛогФайл);
КонецФункции