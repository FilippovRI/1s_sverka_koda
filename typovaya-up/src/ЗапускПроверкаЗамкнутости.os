// Точка входа CLI для ПроверкаЗамкнутости.os
// oscript ЗапускПроверкаЗамкнутости.os <restored> [--бп path] [--уп path] [--json path] [--txt path]
// Совместимость: oscript ПроверкаЗамкнутости.os <restored> ... — тот же вызов (см. конец файла).
КореньСк = ТекущийСценарий().Каталог;
Пров = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ПроверкаЗамкнутости.os"));
Пров.ЗапускИзКоманднойСтроки();