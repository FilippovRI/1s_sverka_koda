// Метаданные БП для Form.xml: полный возврат картинок/стилей; остальное — пустые заготовки (ЗаготовкиОбъектовБп).

Перем ВозвратБп;

Функция Инициализировать() Экспорт
	ВозвратБп = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
КонецФункции

Функция ПапкиОбъектов() Экспорт
	Р = Новый Соответствие;
	Для Каждого П Из СтрРазделить("CommonPicture:CommonPictures,StyleItem:StyleItems,Style:Styles,CommonCommand:CommonCommands,"
		+ "CommandGroup:CommandGroups,CommonTemplate:CommonTemplates,FilterCriterion:FilterCriteria,Language:Languages,"
		+ "CommonForm:CommonForms,DefinedType:DefinedTypes,FunctionalOption:FunctionalOptions,CommonModule:CommonModules", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Р.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ВозвращаемыеТеги() Экспорт
	Р = Новый Соответствие;
	Для Каждого Т Из СтрРазделить("CommonPicture,StyleItem,Style,CommonCommand,CommandGroup,CommonTemplate,FilterCriterion,Language,DefinedType", ",") Цикл
		Р.Вставить(Т, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СсылкаИзСтроки(Знач СтрокаСсылка)
	СтрокаСсылка = СокрЛП(СтрокаСсылка);
	П = СтрНайти(СтрокаСсылка, ".");
	Если П = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Тег, Имя", Лев(СтрокаСсылка, П - 1), Сред(СтрокаСсылка, П + 1));
КонецФункции

// Сканирует XML (все Form.xml и прочие *.xml). Возврат: Структура(byTag, byForm, refs, missing).
Функция Сканировать(Корень, КореньБп = "") Экспорт
	Если ВозвратБп = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Осн = ВозвратБп.СоставКонфигурации(ОбъединитьПути(Корень, "Configuration.xml"));
	Бп = ?(КореньБп = "", Осн, ВозвратБп.СоставКонфигурации(ОбъединитьПути(КореньБп, "Configuration.xml")));
	Рв = Новый РегулярноеВыражение("<xr:Ref>([^<]+)</xr:Ref>");
	РвCfg = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
	ByTag = Новый Соответствие;
	Missing = Новый Соответствие;
	Refs = 0;
	ByForm = Новый Соответствие;
	Для Каждого Ф Из НайтиФайлы(Корень, "*.xml", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(Корень) + 2);
		Т = ВозвратБп.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Т, "xr:Ref") = 0 И СтрНайти(Т, "cfg:") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
			Р = СсылкаИзСтроки(С.Группы[1].Значение);
			Если Р = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Refs = Refs + 1;
			УчётТега(ByTag, Р.Тег);
			Если Не ЕстьВСоставе(Осн, Р.Тег, Р.Имя) Тогда
				УчётТега(Missing, Р.Тег);
				ДобавитьВСписке(ByForm, Отн, Р.Тег + "." + Р.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			Р = СсылкаИзCfg(С.Группы[1].Значение);
			Если Р = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Refs = Refs + 1;
			УчётТега(ByTag, Р.Тег);
			Если Не ЕстьВСоставе(Осн, Р.Тег, Р.Имя) Тогда
				УчётТега(Missing, Р.Тег);
				ДобавитьВСписке(ByForm, Отн, "cfg:" + Р.Тег + "." + Р.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("byTag, missing, refs, byForm", СводкаСч(ByTag), СводкаСч(Missing), Refs, ByForm);
КонецФункции

Функция СсылкаИзCfg(Знач ТипCfg)
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Р = Заг.РазборCfg(ТипCfg);
	Если Р = Неопределено Или Р.Режим <> "Объект" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Тег, Имя", Р.Тег, Р.Имя);
КонецФункции

Функция ЕстьВСоставе(Состав, Тег, Имя)
	С = ВозвратБп.ИменаТега(Состав, Тег);
	Возврат С.Получить(НРег(Имя)) <> Неопределено;
КонецФункции

Процедура УчётТега(Куда, Тег)
	Куда.Вставить(Тег, ?(Куда.Получить(Тег) = Неопределено, 1, Куда.Получить(Тег) + 1));
КонецПроцедуры

Процедура ДобавитьВСписке(Куда, Ключ, Значение)
	С = Куда.Получить(Ключ);
	Если С = Неопределено Тогда
		С = Новый Массив;
		Куда.Вставить(Ключ, С);
	КонецЕсли;
	Если С.Найти(Значение) = Неопределено Тогда
		С.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

Функция СводкаСч(Куда)
	Р = Новый Массив;
	Для Каждого КЗ Из Куда Цикл
		Р.Добавить(Новый Структура("tag, count", КЗ.Ключ, КЗ.Значение));
	КонецЦикла;
	Возврат Р;
КонецФункции

// Возврат метаданных и заготовок по ссылкам из Form.xml (без вырезания форм).
Функция Исправить(Корень, КореньБп, КореньУп, Лог, ПутьСписка = "") Экспорт
	Если ВозвратБп = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Рз = Заг.Применить(Корень, КореньБп, Лог, ПутьСписка, КореньУп);
	Возврат Новый Структура("returned, stubs, full, strippedForms, strippedBlocks, configLines",
		Новый Массив, Рз.stubs, Рз.full, 0, 0, Рз.configLines);
КонецФункции

Функция СобратьОтсутствующиеСсылки(Корень, Осн)
	Р = Новый Массив;
	Уже = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("<xr:Ref>([^<]+)</xr:Ref>");
	Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
		Т = ВозвратБп.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
			ДобСсылку(Р, Уже, С.Группы[1].Значение, Осн);
		КонецЦикла;
		РвCfg = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			Р1 = СсылкаИзCfg(С.Группы[1].Значение);
			Если Р1 <> Неопределено Тогда
				ДобСсылкуИзРазбора(Р, Уже, Р1, Осн);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ДобСсылку(Р, Уже, СтрСсылка, Осн)
	Р1 = СсылкаИзСтроки(СтрСсылка);
	Если Р1 = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДобСсылкуИзРазбора(Р, Уже, Р1, Осн);
КонецПроцедуры

Процедура ДобСсылкуИзРазбора(Р, Уже, Р1, Осн)
	Ключ = Р1.Тег + "|" + Р1.Имя;
	Если Уже.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Уже.Вставить(Ключ, Истина);
	Если ЕстьВСоставе(Осн, Р1.Тег, Р1.Имя) Тогда
		Возврат;
	КонецЕсли;
	Р.Добавить(Р1);
КонецПроцедуры

Функция ВернутьОбъект(Тег, Имя, КореньБп, Куда, Папки)
	Пап = Папки.Получить(Тег);
	Если Пап = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Исх = ОбъединитьПути(КореньБп, Пап, Имя + ".xml");
	Если Не (Новый Файл(Исх)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	СоздатьКаталог(ОбъединитьПути(Куда, Пап));
	КопироватьФайл(Исх, ОбъединитьПути(Куда, Пап, Имя + ".xml"));
	Кат = ОбъединитьПути(КореньБп, Пап, Имя);
	Если (Новый Файл(Кат)).Существует() Тогда
		КопироватьКаталогРек(Кат, ОбъединитьПути(Куда, Пап, Имя));
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура КопироватьКаталогРек(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Ложь) Цикл
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталогРек(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		Иначе
			КопироватьФайл(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ДобавитьВКонфигурацию(ПутьКонф, Тег, Имя, Осн)
	Если ЕстьВСоставе(Осн, Тег, Имя) Тогда
		Возврат 0;
	КонецЕсли;
	Дв = Новый ДвоичныеДанные(ПутьКонф);
	Т = ПолучитьСтрокуИзДвоичныхДанных(Дв, "UTF-8");
	БОМ = СтрДлина(Т) > 0 И КодСимвола(Т, 1) = 65279;
	Если БОМ Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	ПС = ?(СтрНайти(Т, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Метка = "</" + Тег + ">" + ПС;
	Стр = Символы.Таб + Символы.Таб + Символы.Таб + "<" + Тег + ">" + Имя + "</" + Тег + ">" + ПС;
	Поз = 0;
	Н = СтрНайти(Т, Метка, НаправлениеПоиска.СКонца);
	Если Н > 0 Тогда
		Поз = Н + СтрДлина(Метка);
	Иначе
		Н = СтрНайти(Т, "</ChildObjects>");
		Поз = СтрНайти(Сред(Т, 1, Н), ПС, НаправлениеПоиска.СКонца) + СтрДлина(ПС);
	КонецЕсли;
	Т = Лев(Т, Поз - 1) + Стр + Сред(Т, Поз);
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, БОМ).Записать(ПутьКонф);
	Возврат 1;
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

ВозвратБп = Неопределено;