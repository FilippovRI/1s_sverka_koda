// import только после гейта XML (XDTO heuristic — warn only).
КореньСк = ТекущийСценарий().Каталог;
Oscript = "C:\Users\rst_filippov\OneScript\bin\oscript.exe";
Кав = Символ(34);
КореньРасш = "D:\typovaya-up-out-20261118u\extension";
ИмяРасш = "УП_Доработки";
Иб = "C:\Program Files\1cv8\8.5.1.1150\bin\ibcmd.exe";
ИбБаза = "C:\Users\rst_filippov\Documents\InfoBase3";
Лог = "D:\typovaya-up-ext-import-latest.log";
ПропуститьГейт = Ложь;
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	КореньРасш = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 И НРег(СокрЛП(АргументыКоманднойСтроки[1])) = "--skip-gate" Тогда
	ПропуститьГейт = Истина;
КонецЕсли;
Если Не ПропуститьГейт Тогда
	Сообщить("gate…");
	Команда = Новый КомандаОС();
	Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
		+ ОбъединитьПути(КореньСк, "ГейтПередИмпортом.os") + Кав + " " + Кав + КореньРасш + Кав);
	Команда.ИспользоватьВыводКакРезультат = Ложь;
	Команда.Исполнить();
	Если Команда.КодВозврата <> 0 Тогда
		ВызватьИсключение "pre-import gate failed";
	КонецЕсли;
КонецЕсли;
Сообщить("ibcmd import…");
Команда = Новый КомандаОС();
Команда.УстановитьКоманду(Кав + Иб + Кав + " infobase config import --db-path=" + Кав + ИбБаза + Кав
	+ " --extension=" + ИмяРасш + " " + Кав + КореньРасш + Кав + " > " + Кав + Лог + Кав + " 2>&1");
Команда.ИспользоватьВыводКакРезультат = Ложь;
Команда.Исполнить();
КомандаСвод = Новый КомандаОС();
КомандаСвод.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
	+ ОбъединитьПути(КореньСк, "СводкаОшибокImport.os") + Кав + " " + Кав + Лог + Кав);
КомандаСвод.ИспользоватьВыводКакРезультат = Ложь;
КомандаСвод.Исполнить();
Если Команда.КодВозврата <> 0 Тогда
	ВызватьИсключение "ibcmd import exit " + Команда.КодВозврата;
КонецЕсли;
Сообщить("import OK exit 0");