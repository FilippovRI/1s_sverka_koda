// Проверка extension в режиме formsFromUp: нет заимствованных тел форм и ссылок <Form> в Configuration.xml.
// Собственные формы собственных объектов extension (перенесённые мелкие объекты только УП) разрешены — ownForms.

Функция ЗаимствованВладелец(КореньРасш, ПолноеИмя)
	Отн = СтрЗаменить(Сред(ПолноеИмя, СтрДлина(КореньРасш) + 2), "\", "/");
	Ч_ = СтрРазделить(Отн, "/");
	Если Ч_.Количество() < 2 Тогда
		Возврат Истина;
	КонецЕсли;
	Мета = ОбъединитьПути(ОбъединитьПути(КореньРасш, Ч_[0]), Ч_[1] + ".xml");
	Ф = Новый Файл(Мета);
	Если Не Ф.Существует() Тогда
		Возврат Истина;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Мета, КодировкаТекста.UTF8);
	Возврат СтрНайти(Т.ПолучитьТекст(), "<ObjectBelonging>Adopted</ObjectBelonging>") > 0;
КонецФункции

Функция ПроверитьКаталог(КореньРасш) Экспорт
	Р = Новый Структура("formsDirs, formExtXml, formRefsInConfiguration, ownForms, ok", 0, 0, 0, 0, Истина);
	Для Каждого Ф Из НайтиФайлы(КореньРасш, "*", Истина) Цикл
		Если Ф.ЭтоКаталог() И Ф.Имя = "Forms" Тогда
			Если ЗаимствованВладелец(КореньРасш, Ф.ПолноеИмя) Тогда
				Р.formsDirs = Р.formsDirs + 1;
				Р.ok = Ложь;
			Иначе
				Р.ownForms = Р.ownForms + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ф Из НайтиФайлы(КореньРасш, "Form.xml", Истина) Цикл
		Если СтрНайти(СтрЗаменить(Ф.ПолноеИмя, "/", "\"), "\Ext\Form.xml") > 0 Тогда
			Если ЗаимствованВладелец(КореньРасш, Ф.ПолноеИмя) Тогда
				Р.formExtXml = Р.formExtXml + 1;
				Р.ok = Ложь;
			Иначе
				Р.ownForms = Р.ownForms + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ПК = ОбъединитьПути(КореньРасш, "Configuration.xml");
	Если (Новый Файл(ПК)).Существует() Тогда
		Т = Новый ТекстовыйДокумент;
		Т.Прочитать(ПК, КодировкаТекста.UTF8);
		Рв = Новый РегулярноеВыражение("<Form>");
		Р.formRefsInConfiguration = Рв.НайтиСовпадения(Т.ПолучитьТекст()).Количество();
		Если Р.formRefsInConfiguration > 0 Тогда
			Р.ok = Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Р;
КонецФункции
