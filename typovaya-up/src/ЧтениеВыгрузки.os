// Чтение файловой выгрузки конфигурации 1С (Конфигуратор -> Выгрузить конфигурацию в файлы).

// Возвращает структуру: Корень, Имя, Версия, ЕстьConfigDumpInfo, Модули (Соответствие ОтнПуть -> ПолныйПуть).
Функция ПрочитатьВыгрузку(Знач Корень, Лог) Экспорт

	Корень = УбратьХвостовойРазделитель((Новый Файл(Корень)).ПолноеИмя);
	Результат = Новый Структура("Корень, Имя, Версия, ЕстьConfigDumpInfo, Модули", Корень, "", "", Ложь, Новый Соответствие);

	ФайлКонфигурации = Новый Файл(ОбъединитьПути(Корень, "Configuration.xml"));
	Если ФайлКонфигурации.Существует() Тогда
		ПрочитатьСвойстваКонфигурации(ФайлКонфигурации.ПолноеИмя, Результат);
	Иначе
		Лог.Добавить("ПРЕДУПРЕЖДЕНИЕ: в " + Корень + " нет Configuration.xml — это точно выгрузка конфигуратора?");
	КонецЕсли;
	Результат.ЕстьConfigDumpInfo = (Новый Файл(ОбъединитьПути(Корень, "ConfigDumpInfo.xml"))).Существует();

	ДлинаКорня = СтрДлина(Корень);
	Для Каждого Ф Из НайтиФайлы(Корень, "*.bsl", Истина) Цикл
		Если Ф.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Отн = НормализоватьПуть(Сред(Ф.ПолноеИмя, ДлинаКорня + 2));
		Если ИсключенныйПуть(Отн) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Модули.Вставить(Отн, Ф.ПолноеИмя);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Формы и макеты пользователь разбирает сам.
Функция ИсключенныйПуть(Знач Отн) Экспорт
	П = "\" + Отн;
	Возврат СтрНайти(П, "\Forms\") > 0 ИЛИ СтрНайти(П, "\Templates\") > 0;
КонецФункции

Функция НормализоватьПуть(Знач Путь) Экспорт
	Возврат СтрЗаменить(СокрЛП(Путь), "/", "\");
КонецФункции

// Текст модуля: UTF-8 (BOM распознаётся автоматически), при битых символах — cp1251.
Функция ПрочитатьТекстМодуля(Знач ПолныйПуть) Экспорт
	Чтение = Новый ЧтениеТекста(ПолныйПуть, "UTF-8");
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Если Текст = Неопределено Тогда
		Текст = "";
	КонецЕсли;
	Если СтрНайти(Текст, Символ(65533)) > 0 Тогда
		Чтение = Новый ЧтениеТекста(ПолныйПуть, "windows-1251");
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
	КонецЕсли;
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат СтрЗаменить(Текст, Символы.ВК, "");
КонецФункции

Функция ХешФайла(Знач ПолныйПуть) Экспорт
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.ДобавитьФайл(ПолныйПуть);
	Возврат Хеш.ХешСуммаСтрокой;
КонецФункции

Процедура ПрочитатьСвойстваКонфигурации(Путь, Результат)
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Путь);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		КонецЕсли;
		Имя = Чтение.ЛокальноеИмя;
		Если (Имя = "Name" И Результат.Имя = "") ИЛИ (Имя = "Version" И Результат.Версия = "") Тогда
			Чтение.Прочитать();
			Если Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Если Имя = "Name" Тогда
					Результат.Имя = Чтение.Значение;
				Иначе
					Результат.Версия = Чтение.Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Если Результат.Имя <> "" И Результат.Версия <> "" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
КонецПроцедуры

Функция УбратьХвостовойРазделитель(Знач Путь)
	Путь = СокрЛП(Путь);
	Пока СтрДлина(Путь) > 1 И (Прав(Путь, 1) = "\" ИЛИ Прав(Путь, 1) = "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Возврат Путь;
КонецФункции
