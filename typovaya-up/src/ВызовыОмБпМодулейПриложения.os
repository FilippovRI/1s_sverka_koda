// Вариант А (решение 24.11): модули уровня конфигурации restored (модуль приложения, сеанса, внешнего соединения)
// взяты из БП дословно и вызывают общие модули только БП, которых нет в restored. Такие операторы:
//  - в restored убираются (редакция УП — в УП этих вызовов нет);
//  - в extension переносятся через заимствованный модуль и &ИзменениеИКонтроль с #Вставка (ОМ БП в extension — заглушки).
// Источник — текст БП (идемпотентно при повторных прогонах). Если restored не совпадает ни с БП, ни с прошлым
// результатом шага — файл не трогается (лог). Операторы, которые нельзя вырезать целиком, — в лог (ручной разбор).

Перем ДС;

Функция МодулиКонфигурации() Экспорт
	Р = Новый Массив;
	Р.Добавить("ManagedApplicationModule");
	Р.Добавить("OrdinaryApplicationModule");
	Р.Добавить("SessionModule");
	Р.Добавить("ExternalConnectionModule");
	Возврат Р;
КонецФункции

Функция ИменаОм(ПутьКонф)
	Вб = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	Возврат Вб.ИменаТега(Вб.СоставКонфигурации(ПутьКонф), "CommonModule");
КонецФункции

// Структура(restoredFiles, extensionMethods, statements, skipped — Массив строк, places — Массив строк).
Функция Применить(КаталогВосст, КаталогРас, КореньБп, Префикс, Лог, КаталогОтчёта = "") Экспорт
	ДС = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗапросыДинСписков.os"));
	Рез = Новый Структура("restoredFiles, extensionMethods, statements, skipped, places", 0, 0, 0, Новый Массив, Новый Массив);
	БпМ = ИменаОм(ОбъединитьПути(КореньБп, "Configuration.xml"));
	ОснМ = ИменаОм(ОбъединитьПути(КаталогВосст, "Configuration.xml"));
	ТолькоБп = Новый Соответствие;
	Для Каждого КЗ Из БпМ Цикл
		Если ОснМ.Получить(КЗ.Ключ) = Неопределено Тогда
			ТолькоБп.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Мод Из МодулиКонфигурации() Цикл
		ПутьБп = ОбъединитьПути(КореньБп, "Ext", Мод + ".bsl");
		ПутьВосст = ОбъединитьПути(КаталогВосст, "Ext", Мод + ".bsl");
		ПутьРас = ОбъединитьПути(КаталогРас, "Ext", Мод + ".bsl");
		СБп = ДС.ПрочитатьСырой(ПутьБп);
		СВосст = ДС.ПрочитатьСырой(ПутьВосст);
		Если СБп = Неопределено Или СВосст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Разбор = Разобрать(СБп.Текст, ТолькоБп, Префикс, Мод, Рез);
		Если Разбор.Методы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Норм = СтрЗаменить(СВосст.Текст, Символы.ВК, "");
		Если Норм <> СтрЗаменить(СБп.Текст, Символы.ВК, "") И Норм <> СтрЗаменить(Разбор.Восст, Символы.ВК, "") Тогда
			Рез.skipped.Добавить(Мод + ": restored не совпадает с БП — не изменялся");
			Продолжить;
		КонецЕсли;
		Если Норм <> СтрЗаменить(Разбор.Восст, Символы.ВК, "") Тогда
			ДС.ЗаписатьСырой(ПутьВосст, Разбор.Восст, СВосст.BOM);
			Рез.restoredFiles = Рез.restoredFiles + 1;
		КонецЕсли;
		ЗаписатьБлокРасширения(ПутьРас, Разбор.Расш);
		Рез.extensionMethods = Рез.extensionMethods + Разбор.Методы.Количество();
	КонецЦикла;
	Лог.Добавить("Вызовы ОМ только БП в модулях приложения/сеанса: restored файлов " + Рез.restoredFiles + ", методов &ИзменениеИКонтроль в extension "
		+ Рез.extensionMethods + ", операторов " + Рез.statements + ", пропущено " + Рез.skipped.Количество()
		+ ?(Рез.skipped.Количество() > 0, " (" + СтрСоединить(Рез.skipped, "; ") + ")", ""));
	Если КаталогОтчёта <> "" Тогда
		Отч = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ОтчетHTML.os"));
		Отч.ЗаписатьФайл(ОбъединитьПути(КаталогОтчёта, "app_module_bp_calls.json"), Отч.ВJSON(Рез));
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ЕстьВызовОм(Стр, ТолькоБп)
	Ст = СокрЛП(Стр);
	Если Ст = "" Или Лев(Ст, 2) = "//" Или Лев(Ст, 1) = "#" Или Лев(Ст, 1) = "&" Тогда
		Возврат "";
	КонецЕсли;
	Поз = СтрНайти(Ст, "//");
	Код = ?(Поз > 0, Лев(Ст, Поз - 1), Ст);
	Для Каждого С Из (Новый РегулярноеВыражение("(?<![\wЁё.])([\wЁё]+)[ \t]*\.")).НайтиСовпадения(Код) Цикл
		Имя = ТолькоБп.Получить(НРег(С.Группы[1].Значение));
		Если Имя <> Неопределено Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция КодСтроки(Стр)
	Ст = СокрЛП(Стр);
	Поз = СтрНайти(Ст, "//");
	Возврат СокрЛП(?(Поз > 0, Лев(Ст, Поз - 1), Ст));
КонецФункции

// Оператор можно вырезать, если он начинается с начала строки после завершённого оператора/начала блока.
Функция НачалоОператора(Строки, Й)
	К = Й - 1;
	Пока К >= 0 Цикл
		Пред = КодСтроки(Строки[К]);
		Если Пред = "" Или Лев(Пред, 1) = "#" Тогда
			К = К - 1;
			Продолжить;
		КонецЕсли;
		Возврат Прав(Пред, 1) = ";" Или Прав(Пред, 1) = ")" И СтрНачинаетсяС(НРег(Пред), "процедура") Или СтрНачинаетсяС(НРег(Пред), "функция")
			Или Прав(НРег(Пред), 5) = "тогда" Или НРег(Пред) = "иначе" Или Прав(НРег(Пред), 4) = "цикл" Или НРег(Пред) = "попытка"
			Или НРег(Пред) = "исключение" Или Прав(НРег(Пред), 7) = "экспорт";
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Не управляющая конструкция (Если/Пока/Для/Возврат…): её нельзя вырезать без изменения структуры метода.
Функция ПростойОператор(Строки, Нач, Кон)
	Перв = НРег(КодСтроки(Строки[Нач]));
	Для Каждого Сл Из СтрРазделить("если,иначеесли,пока,для,возврат,ждать,попытка", ",") Цикл
		Если Перв = Сл Или СтрНачинаетсяС(Перв, Сл + " ") Или СтрНачинаетсяС(Перв, Сл + "(") Или СтрНачинаетсяС(Перв, Сл + Символы.Таб) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Н = Нач По Кон Цикл
		К_ = НРег(КодСтроки(Строки[Н]));
		Если Прав(К_, 5) = "тогда" Или Прав(К_, 4) = "цикл" Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Структура(Восст — текст restored, Расш — блок extension, Методы — Массив имён).
Функция Разобрать(Текст, ТолькоБп, Префикс, Мод, Рез)
	ПС = ?(СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Вых = Новый Массив;
	Расш = Новый Массив;
	Методы = Новый Массив;
	РвНач = Новый РегулярноеВыражение("^\s*(?:Асинх\s+)?(Процедура|Функция)\s+([\wЁё]+)\s*\(");
	Й = 0;
	Пока Й < Строки.Количество() Цикл
		Сов = РвНач.НайтиСовпадения(Строки[Й]);
		Если Сов.Количество() = 0 Тогда
			Вых.Добавить(Строки[Й]);
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Вид = Сов[0].Группы[1].Значение;
		ИмяМ = Сов[0].Группы[2].Значение;
		Кон = Й;
		Конец = ?(НРег(Вид) = "процедура", "конецпроцедуры", "конецфункции");
		Пока Кон < Строки.Количество() И Не СтрНачинаетсяС(НРег(СокрЛП(Строки[Кон])), Конец) Цикл
			Кон = Кон + 1;
		КонецЦикла;
		// сигнатура: до строки с закрывающей скобкой
		КонСиг = Й;
		Пока КонСиг < Кон И СтрНайти(Строки[КонСиг], ")") = 0 Цикл
			КонСиг = КонСиг + 1;
		КонецЦикла;
		МетодВосст = Новый Массив;
		МетодРасш = Новый Массив;
		Вырезано = 0;
		К = Й;
		Пока К <= Кон И К < Строки.Количество() Цикл
			Стр = Строки[К];
			Ом = ?(К > КонСиг И К < Кон, ЕстьВызовОм(Стр, ТолькоБп), "");
			Если Ом = "" Тогда
				МетодВосст.Добавить(Стр);
				МетодРасш.Добавить(Стр);
				К = К + 1;
				Продолжить;
			КонецЕсли;
			КонОп = К;
			Пока КонОп < Кон И Прав(КодСтроки(Строки[КонОп]), 1) <> ";" Цикл
				КонОп = КонОп + 1;
			КонецЦикла;
			Если КонОп >= Кон Или Не НачалоОператора(Строки, К) Или Не ПростойОператор(Строки, К, КонОп) Тогда
				Рез.skipped.Добавить(Мод + "." + ИмяМ + ": строка " + (К + 1) + " (" + Ом + ") — не отдельный оператор");
				МетодВосст.Добавить(Стр);
				МетодРасш.Добавить(Стр);
				К = К + 1;
				Продолжить;
			КонецЕсли;
			МетодРасш.Добавить("#Вставка");
			Для Н = К По КонОп Цикл
				МетодРасш.Добавить(Строки[Н]);
			КонецЦикла;
			МетодРасш.Добавить("#КонецВставки");
			Рез.places.Добавить(Мод + "." + ИмяМ + ": " + СокрЛП(Строки[К]));
			Рез.statements = Рез.statements + 1;
			Вырезано = Вырезано + 1;
			К = КонОп + 1;
		КонецЦикла;
		Для Каждого С Из МетодВосст Цикл
			Вых.Добавить(С);
		КонецЦикла;
		Если Вырезано > 0 Тогда
			Методы.Добавить(ИмяМ);
			Расш.Добавить("&ИзменениеИКонтроль(""" + ИмяМ + """)");
			Перв = МетодРасш[0];
			Поз = СтрНайти(Перв, ИмяМ);
			МетодРасш[0] = Лев(Перв, Поз - 1) + Префикс + ИмяМ + Сред(Перв, Поз + СтрДлина(ИмяМ));
			Для Каждого С Из МетодРасш Цикл
				Расш.Добавить(С);
			КонецЦикла;
			Расш.Добавить("");
		КонецЕсли;
		Й = Кон + 1;
	КонецЦикла;
	Возврат Новый Структура("Восст, Расш, Методы", СтрСоединить(Вых, ПС), СтрСоединить(Расш, ПС), Методы);
КонецФункции

Процедура ЗаписатьБлокРасширения(Путь, Блок)
	Нач = "// typovaya-up: вызовы ОМ только БП (начало)";
	Кон = "// typovaya-up: вызовы ОМ только БП (конец)";
	С = ДС.ПрочитатьСырой(Путь);
	Т = ?(С = Неопределено, "", СтрЗаменить(С.Текст, Символы.ВК, ""));
	П1 = СтрНайти(Т, Нач);
	П2 = СтрНайти(Т, Кон);
	Если П1 > 0 И П2 > П1 Тогда
		Т = Лев(Т, П1 - 1) + Сред(Т, П2 + СтрДлина(Кон) + 1);
	КонецЕсли;
	Т = СокрП(Т);
	Т = ?(Т = "", "", Т + Символы.ПС + Символы.ПС) + Нач + Символы.ПС + СтрЗаменить(Блок, Символы.ВК, "") + Символы.ПС + Кон + Символы.ПС;
	ДС.ЗаписатьСырой(Путь, СтрЗаменить(Т, Символы.ПС, Символы.ВК + Символы.ПС), Истина);
КонецПроцедуры
