// Анализ-only: реквизиты управляемых форм УП vs БП по пути формы (без UUID). Генерация BSL — не в этом срезе.

Функция ПеречислитьFormXml(Корень) Экспорт
	Рез = Новый Соответствие;
	ИскатьFormXml(Корень, Корень, Рез);
	Возврат Рез;
КонецФункции

Процедура ИскатьFormXml(Корень, Текущий, Рез)
	Для Каждого Эл Из НайтиФайлы(Текущий, "Form.xml", Ложь) Цикл
		Если СтрНайти(НРег(Эл.ПолноеИмя), "\forms\") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Эл.ПолноеИмя, СтрДлина(Корень) + 2);
		Рез.Вставить(СтрЗаменить(Отн, "/", "\"), Эл.ПолноеИмя);
	КонецЦикла;
	Для Каждого Под Из НайтиФайлы(Текущий, "*", Ложь) Цикл
		Если Под.ЭтоКаталог() Тогда
			ИскатьFormXml(Корень, Под.ПолноеИмя, Рез);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИменаРеквизитовFormXml(ПутьXml) Экспорт
	Рез = Новый Массив;
	Если Не (Новый Файл(ПутьXml)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(ПутьXml, КодировкаТекста.UTF8);
	Текст = Т.ПолучитьТекст();
	Нач = СтрНайти(Текст, "<Attributes");
	Если Нач = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Хвост = Сред(Текст, Нач);
	Кон = СтрНайти(Хвост, "</Attributes>");
	Если Кон > 0 Тогда
		Хвост = Лев(Хвост, Кон - 1);
	КонецЕсли;
	Метка = "<Name>";
	Поз = СтрНайти(Хвост, Метка);
	Пока Поз > 0 Цикл
		Х2 = Сред(Хвост, Поз + СтрДлина(Метка));
		КонИм = СтрНайти(Х2, "</Name>");
		Если КонИм = 0 Тогда
			Прервать;
		КонецЕсли;
		Рез.Добавить(СокрЛП(Лев(Х2, КонИм - 1)));
		Хвост = Сред(Х2, КонИм + СтрДлина("</Name>"));
		Поз = СтрНайти(Хвост, Метка);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПрефиксОбъектаИзПутиФормы(ПутьФормы)
	Ч = СтрРазделить(ПутьФормы, "\");
	Если Ч.Количество() < 4 ИЛИ Ч[2] <> "Forms" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ч[0] + "\" + Ч[1];
КонецФункции

Функция ВПериметреОбъекта(Префикс, ПериметрМодулей)
	Если ПериметрМодулей = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КЗ Из ПериметрМодулей Цикл
		Если СтрНачинаетсяС(КЗ.Ключ, Префикс + "\") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Пишет forms_analysis.json; programGeneration всегда manual в срезе 1.
Функция СравнитьФормы(КореньИсх, КореньПост, ПериметрМодулей, Выход, Лог) Экспорт
	ФИсх = ПеречислитьFormXml(КореньИсх);
	ФПост = ПеречислитьFormXml(КореньПост);
	Все = Новый Соответствие;
	Для Каждого КЗ Из ФИсх Цикл
		Все.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из ФПост Цикл
		Все.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Элементы = Новый Массив;
	Для Каждого КЗ Из Все Цикл
		Ключ = КЗ.Ключ;
		Преф = ПрефиксОбъектаИзПутиФормы(Ключ);
		Если Преф <> "" И Не ВПериметреОбъекта(Преф, ПериметрМодулей) Тогда
			Продолжить;
		КонецЕсли;
		ПутьИ = ФИсх.Получить(Ключ);
		ПутьП = ФПост.Получить(Ключ);
		Если ПутьИ = Неопределено Тогда
			Элементы.Добавить(ЗаписьФормы(Ключ, "only_vendor", Новый Массив, Новый Массив, Новый Массив, "Форма только у поставщика"));
			Продолжить;
		КонецЕсли;
		Если ПутьП = Неопределено Тогда
			Элементы.Добавить(ЗаписьФормы(Ключ, "only_source", ИменаРеквизитовFormXml(ПутьИ), Новый Массив, Новый Массив, "Форма только в УП — без отката"));
			Продолжить;
		КонецЕсли;
		РИ = ИменаРеквизитовFormXml(ПутьИ);
		РП = ИменаРеквизитовFormXml(ПутьП);
		Доб = РазницаСписков(РИ, РП);
		Уд = РазницаСписков(РП, РИ);
		Об = ПересечениеСОтличиями(РИ, РП);
		Статус = ?(Доб.Количество() = 0 И Уд.Количество() = 0 И Об.Количество() = 0, "identical", "changed");
		Прич = "programGeneration=manual: программное создание реквизитов не реализовано в срезе 1";
		Элементы.Добавить(ЗаписьФормы(Ключ, Статус, Доб, Уд, Об, Прич));
	КонецЦикла;
	Тело = "{""forms"":" + ВJSONМассив(Элементы) + "}";
	ЗаписатьТекст(ОбъединитьПути(Выход, "forms_analysis.json"), Тело);
	Лог.Добавить("Анализ форм: записано forms_analysis.json, форм " + Элементы.Количество());
	Возврат Элементы.Количество();
КонецФункции

Функция ЗаписьФормы(Путь, Статус, Добавленные, Удалённые, Изменённые, Причина)
	Возврат Новый Структура("path, status, added, removed, changed, programGeneration, note",
		Путь, Статус, Добавленные, Удалённые, Изменённые, "manual", Причина);
КонецФункции

Функция РазницаСписков(А, Б)
	Р = Новый Массив;
	Для Каждого Э Из А Цикл
		Если Б.Найти(Э) = Неопределено Тогда
			Р.Добавить(Э);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПересечениеСОтличиями(А, Б)
	// срез 1: не сравниваем типы/DataPath — только заглушка
	Возврат Новый Массив;
КонецФункции

Функция ВJSONМассив(МассивСтруктур)
	// минимальная сериализация через ОтчетHTML нет — простой JSON
	Части = Новый Массив;
	Для Каждого С Из МассивСтруктур Цикл
		Части.Добавить(СтруктураВJSON(С));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Части, ",") + "]";
КонецФункции

Функция СтруктураВJSON(С)
	Возврат "{""path"":""" + JSONЭкран(С.path) + """,""status"":""" + С.status
		+ """,""programGeneration"":""" + С.programGeneration + """,""note"":""" + JSONЭкран(С.note) + """"
		+ ",""added"":" + МассивВJSON(С.added) + ",""removed"":" + МассивВJSON(С.removed)
		+ ",""changed"":" + МассивВJSON(С.changed) + "}";
КонецФункции

Функция МассивВJSON(М)
	Если М.Количество() = 0 Тогда
		Возврат "[]";
	КонецЕсли;
	Ч = Новый Массив;
	Для Каждого Э Из М Цикл
		Ч.Добавить("""" + JSONЭкран(Строка(Э)) + """");
	КонецЦикла;
	Возврат "[" + СтрСоединить(Ч, ",") + "]";
КонецФункции

Функция JSONЭкран(З)
	З = СтрЗаменить(З, "\", "\\");
	З = СтрЗаменить(З, """", "\""");
	Возврат З;
КонецФункции
