// Анализ реквизитов управляемых форм УП vs БП; opt-in preview BSL (исходники не меняются).

Функция ПеречислитьFormXml(Корень) Экспорт
	Рез = Новый Соответствие;
	ИскатьFormXml(Корень, Корень, Рез);
	Возврат Рез;
КонецФункции

Процедура ИскатьFormXml(Корень, Текущий, Рез)
	Для Каждого Эл Из НайтиФайлы(Текущий, "Form.xml", Ложь) Цикл
		Норм = СтрЗаменить(НРег(Эл.ПолноеИмя), "/", "\");
		Если СтрНайти(Норм, "\forms\") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Эл.ПолноеИмя, СтрДлина(Корень) + 2);
		Рез.Вставить(СтрЗаменить(Отн, "/", "\"), Эл.ПолноеИмя);
	КонецЦикла;
	Для Каждого Под Из НайтиФайлы(Текущий, "*", Ложь) Цикл
		Если Под.ЭтоКаталог() Тогда
			ИскатьFormXml(Корень, Под.ПолноеИмя, Рез);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИменаРеквизитовFormXml(ПутьXml) Экспорт
	Имена = Новый Массив;
	Для Каждого Р Из РазобратьРеквизитыFormXml(ПутьXml) Цикл
		Имена.Добавить(Р.Имя);
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Массив: Имя, ТипСырой, Тип1С, Поддержан.
Функция РазобратьРеквизитыFormXml(ПутьXml) Экспорт
	Рез = Новый Массив;
	Если Не (Новый Файл(ПутьXml)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(ПутьXml, КодировкаТекста.UTF8);
	Текст = Т.ПолучитьТекст();
	Нач = СтрНайти(Текст, "<Attributes");
	Если Нач = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Хвост = Сред(Текст, Нач);
	Кон = СтрНайти(Хвост, "</Attributes>");
	Если Кон > 0 Тогда
		Хвост = Лев(Хвост, Кон + СтрДлина("</Attributes>") - 1);
	КонецЕсли;
	Поз = СтрНайти(Хвост, "<Attribute");
	Пока Поз > 0 Цикл
		Кусок = Сред(Хвост, Поз);
		КонА = СтрНайти(Кусок, "</Attribute>");
		Если КонА = 0 Тогда
			Прервать;
		КонецЕсли;
		Блок = Лев(Кусок, КонА + СтрДлина("</Attribute>") - 1);
		Имя = ИмяИзБлока(Блок);
		Если Имя <> "" Тогда
			ТипСыр = ТипИзБлока(Блок);
			Оц = ОценитьТип(ТипСыр, Блок);
			Рез.Добавить(Новый Структура("Имя, ТипСырой, Тип1С, Поддержан", Имя, ТипСыр, Оц.Тип1С, Оц.Поддержан));
		КонецЕсли;
		Хвост = Сред(Кусок, КонА + СтрДлина("</Attribute>"));
		Поз = СтрНайти(Хвост, "<Attribute");
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ИмяИзБлока(Блок)
	П = СтрНайти(Блок, "<Name>");
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Х = Сред(Блок, П + 6);
	К = СтрНайти(Х, "</Name>");
	Если К = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Х, К - 1));
КонецФункции

Функция ТипИзБлока(Блок)
	П = СтрНайти(НРег(Блок), "v8:type>");
	Если П > 0 Тогда
		Х = Сред(Блок, П + 8);
		К = СтрНайти(Х, "<");
		Если К > 0 Тогда
			Возврат СокрЛП(Лев(Х, К - 1));
		КонецЕсли;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ОценитьТип(ТипСырой, Блок)
	Н = НРег(ТипСырой);
	Если СтрНайти(НРег(Блок), "valuetable") > 0 Или СтрНайти(НРег(Блок), "dynamiclist") > 0 Тогда
		Возврат Новый Структура("Тип1С, Поддержан", "Неподдержан", Ложь);
	КонецЕсли;
	Если Н = "" Тогда
		// нет явного типа в XML — только manual
		Возврат Новый Структура("Тип1С, Поддержан", "Неизвестен", Ложь);
	КонецЕсли;
	Если СтрНайти(Н, "string") > 0 Тогда
		Возврат Новый Структура("Тип1С, Поддержан", "Строка", Истина);
	ИначеЕсли СтрНайти(Н, "decimal") > 0 Или СтрНайти(Н, "integer") > 0 Или СтрНайти(Н, "number") > 0 Тогда
		Возврат Новый Структура("Тип1С, Поддержан", "Число", Истина);
	ИначеЕсли СтрНайти(Н, "boolean") > 0 Тогда
		Возврат Новый Структура("Тип1С, Поддержан", "Булево", Истина);
	КонецЕсли;
	Возврат Новый Структура("Тип1С, Поддержан", ТипСырой, Ложь);
КонецФункции

Функция DataPathsFormXml(ПутьXml) Экспорт
	Рез = Новый Массив;
	Если Не (Новый Файл(ПутьXml)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(ПутьXml, КодировкаТекста.UTF8);
	Текст = Т.ПолучитьТекст();
	Метка = "DataPath";
	Поз = СтрНайти(Текст, Метка);
	Пока Поз > 0 Цикл
		Х = Сред(Текст, Поз + СтрДлина(Метка));
		Отк = СтрНайти(Х, ">");
		Зак = СтрНайти(Х, "<");
		Если Отк > 0 И Зак > Отк Тогда
			Рез.Добавить(СокрЛП(Сред(Х, Отк + 1, Зак - Отк - 1)));
		КонецЕсли;
		Текст = Сред(Текст, Поз + 1);
		Поз = СтрНайти(Текст, Метка);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПутьМодуляФормы(ПутьFormXml)
	Кат = (Новый Файл(ПутьFormXml)).Путь;
	Возврат ОбъединитьПути(Кат, "Form", "Module.bsl");
КонецФункции

Функция ПрочитатьТекстФайла(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Функция РаннееОбращениеВМодуле(Имя, ТекстМодуля)
	Если СокрЛП(ТекстМодуля) = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	// грубо: имя вне комментария до блока ПриСозданииНаСервере
	До = СтрНайти(НРег(ТекстМодуля), "присозданиинасервере");
	Фраг = ?(До > 0, Лев(ТекстМодуля, До - 1), ТекстМодуля);
	Возврат СтрНайти(Фраг, Имя) > 0;
КонецФункции

Функция КодКандидата(Имя, Тип1С)
	Возврат "&НаСервере" + Символы.ПС
		+ "&После(""ПриСозданииНаСервере"")" + Символы.ПС
		+ "Процедура ПослеПриСозданииНаСервере_Формы(Отказ, СтандартнаяОбработка)" + Символы.ПС
		+ "	М = Новый Массив;" + Символы.ПС
		+ "	М.Добавить(Новый РеквизитФормы(""" + Имя + """, Новый ОписаниеТипов(""" + Тип1С + """)));" + Символы.ПС
		+ "	ИзменитьРеквизиты(М, Новый Массив);" + Символы.ПС
		+ "КонецПроцедуры";
КонецФункции

Функция ОценитьДобавленный(Рек, ТекстМодуля, DataPaths)
	Если Не Рек.Поддержан Тогда
		Возврат Новый Структура("decision, reason, candidate", "manual", "Неподдержанный тип: " + Рек.ТипСырой + " / " + Рек.Тип1С, "");
	КонецЕсли;
	Если РаннееОбращениеВМодуле(Рек.Имя, ТекстМодуля) Тогда
		Возврат Новый Структура("decision, reason, candidate", "manual", "Раннее обращение к реквизиту в модуле формы до создания", "");
	КонецЕсли;
	Для Каждого D Из DataPaths Цикл
		Если СтрНайти(D, Рек.Имя) > 0 Тогда
			// UI уже ссылается — нужна ручная увязка элементов
			Возврат Новый Структура("decision, reason, candidate",
				"preview", "DataPath на реквизит без автосинхронизации UI — проверьте элементы", КодКандидата(Рек.Имя, Рек.Тип1С));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("decision, reason, candidate", "supported", "Простой тип, нет ранних обращений", КодКандидата(Рек.Имя, Рек.Тип1С));
КонецФункции

Функция ПрефиксОбъектаИзПутиФормы(ПутьФормы)
	Ч = СтрРазделить(ПутьФормы, "\");
	Если Ч.Количество() < 4 ИЛИ Ч[2] <> "Forms" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ч[0] + "\" + Ч[1];
КонецФункции

Функция ВПериметреОбъекта(Префикс, ПериметрМодулей)
	Если ПериметрМодулей = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КЗ Из ПериметрМодулей Цикл
		Если СтрНачинаетсяС(КЗ.Ключ, Префикс + "\") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СравнитьФормы(КореньИсх, КореньПост, ПериметрМодулей, Выход, Лог, Опции = Неопределено) Экспорт
	Программа = Ложь;
	Если Опции <> Неопределено И Опции.Свойство("program") Тогда
		Программа = Опции.program;
	КонецЕсли;
	ФИсх = ПеречислитьFormXml(КореньИсх);
	ФПост = ПеречислитьFormXml(КореньПост);
	Все = Новый Соответствие;
	Для Каждого КЗ Из ФИсх Цикл
		Все.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из ФПост Цикл
		Все.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Элементы = Новый Массив;
	Кандидаты = Новый Массив;
	Для Каждого КЗ Из Все Цикл
		Ключ = КЗ.Ключ;
		Преф = ПрефиксОбъектаИзПутиФормы(Ключ);
		Если Преф <> "" И Не ВПериметреОбъекта(Преф, ПериметрМодулей) Тогда
			Продолжить;
		КонецЕсли;
		ПутьИ = ФИсх.Получить(Ключ);
		ПутьП = ФПост.Получить(Ключ);
		Если ПутьИ = Неопределено Тогда
			Элементы.Добавить(ЗаписьФормы(Ключ, "only_vendor", Новый Массив, "Форма только у поставщика"));
			Продолжить;
		КонецЕсли;
		Если ПутьП = Неопределено Тогда
			Элементы.Добавить(ЗаписьФормы(Ключ, "only_source", Новый Массив, "Форма только в УП — без отката"));
			Продолжить;
		КонецЕсли;
		РИ = РазобратьРеквизитыFormXml(ПутьИ);
		РП = РазобратьРеквизитыFormXml(ПутьП);
		Детали = СравнитьРеквизиты(РИ, РП, ПрочитатьТекстФайла(ПутьМодуляФормы(ПутьИ)), DataPathsFormXml(ПутьИ));
		Статус = ?(Детали.Идентична, "identical", "changed");
		Элементы.Добавить(ЗаписьФормы(Ключ, Статус, Детали.Атрибуты, Детали.Сводка));
		Для Каждого А Из Детали.Атрибуты Цикл
			Если (А.decision = "supported" Или А.decision = "preview") И А.candidate <> "" Тогда
				Кандидаты.Добавить(Новый Структура("form, attribute, decision", Ключ, А.name, А.decision));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	ЗаписатьОтчетФормJson(ОбъединитьПути(Выход, "forms_analysis.json"), Элементы);
	ЗаписатьHtml(ОбъединитьПути(Выход, "forms_analysis.html"), Элементы);
	Если Программа Тогда
		ЗаписатьПрограмму(Выход, Элементы);
	КонецЕсли;
	Лог.Добавить("Анализ форм: " + Элементы.Количество() + " форм; program=" + ?(Программа, "да", "нет"));
	Возврат Элементы.Количество();
КонецФункции

Функция СравнитьРеквизиты(РИ, РП, ТекстМодуля, DataPaths)
	Атр = Новый Массив;
	Идент = Истина;
	Для Каждого Р Из РИ Цикл
		ВП = НайтиРеквизитПоИмени(РП, Р.Имя);
		Если ВП = Неопределено Тогда
			О = ОценитьДобавленный(Р, ТекстМодуля, DataPaths);
			Атр.Добавить(ЗаписьАтр(Р.Имя, "added", Р.Тип1С, "", О));
			Идент = Ложь;
		ИначеЕсли Р.ТипСырой <> ВП.ТипСырой И (Р.ТипСырой <> "" Или ВП.ТипСырой <> "") Тогда
			Ман = Новый Структура("decision, reason, candidate", "manual", "Изменён существующий реквизит — не переносится как добавленный", "");
			Атр.Добавить(ЗаписьАтр(Р.Имя, "changed", Р.Тип1С, ВП.Тип1С, Ман));
			Идент = Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ВП Из РП Цикл
		Если НайтиРеквизитПоИмени(РИ, ВП.Имя) = Неопределено Тогда
			Ман = Новый Структура("decision, reason, candidate", "manual", "Удалён у поставщика", "");
			Атр.Добавить(ЗаписьАтр(ВП.Имя, "removed", "", ВП.Тип1С, Ман));
			Идент = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Атрибуты, Идентична, Сводка", Атр, Идент, ?(Идент, "без отличий", "есть отличия реквизитов формы"));
КонецФункции

Функция НайтиРеквизитПоИмени(М, Имя)
	Для Каждого Р Из М Цикл
		Если Р.Имя = Имя Тогда
			Возврат Р;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЗаписьАтр(Имя, Вид, ТипУп, ТипПост, О)
	Возврат Новый Структура("name, changeKind, typeUp, typeVendor, decision, reason, candidate",
		Имя, Вид, ТипУп, ТипПост, О.decision, О.reason, О.candidate);
КонецФункции

Функция ЗаписьФормы(Путь, Статус, Атрибуты, Сводка)
	Возврат Новый Структура("path, status, summary, attributes", Путь, Статус, Сводка, Атрибуты);
КонецФункции

Процедура ЗаписатьОтчетФормJson(Путь, Элементы)
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст("{""forms"":" + ВJSONМассив(Элементы) + "}");
	Тд.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

Процедура ЗаписатьHtml(Путь, Элементы)
	Ч = Новый Массив;
	Ч.Добавить("<!DOCTYPE html><meta charset=utf-8><title>Формы</title><h1>Анализ форм</h1>");
	Для Каждого Ф Из Элементы Цикл
		Ч.Добавить("<h2>" + HTML(Ф.path) + " — " + Ф.status + "</h2><p>" + HTML(Ф.summary) + "</p><ul>");
		Для Каждого А Из Ф.attributes Цикл
			Ч.Добавить("<li><b>" + HTML(А.name) + "</b> " + HTML(А.changeKind) + " / " + HTML(А.decision)
				+ ": " + HTML(А.reason) + "</li>");
		КонецЦикла;
		Ч.Добавить("</ul>");
	КонецЦикла;
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст(СтрСоединить(Ч, Символы.ПС));
	Тд.Записать(Путь, КодировкаТекста.UTF8);
КонецПроцедуры

Процедура ЗаписатьПрограмму(Выход, Элементы)
	Кат = ОбъединитьПути(Выход, "forms_program");
	СоздатьКаталог(Кат);
	Тексты = Новый Массив;
	Тексты.Добавить("// preview: не удаляет статические реквизиты из XML; не пишет в extension автоматически");
	Для Каждого Ф Из Элементы Цикл
		Для Каждого А Из Ф.attributes Цикл
			Если А.decision = "supported" И А.candidate <> "" Тогда
				Тексты.Добавить("// " + Ф.path + " :: " + А.name);
				Тексты.Добавить(А.candidate);
				Тексты.Добавить("");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст(СтрСоединить(Тексты, Символы.ПС));
	Тд.Записать(ОбъединитьПути(Кат, "candidates.bsl"), КодировкаТекста.UTF8);
КонецПроцедуры

Функция HTML(З)
	З = СтрЗаменить(З, "&", "&amp;");
	З = СтрЗаменить(З, "<", "&lt;");
	Возврат З;
КонецФункции

Функция ВJSONМассив(МассивСтруктур)
	Части = Новый Массив;
	Для Каждого С Из МассивСтруктур Цикл
		Части.Добавить(ФормаВJSON(С));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Части, ",") + "]";
КонецФункции

Функция ФормаВJSON(Ф)
	Возврат "{""path"":""" + JSONЭкран(Ф.path) + """,""status"":""" + Ф.status + """,""summary"":""" + JSONЭкран(Ф.summary)
		+ """,""attributes"":" + АтрибутыВJSON(Ф.attributes) + "}";
КонецФункции

Функция АтрибутыВJSON(Атр)
	Ч = Новый Массив;
	Для Каждого А Из Атр Цикл
		Ч.Добавить("{""name"":""" + JSONЭкран(А.name) + """,""changeKind"":""" + А.changeKind
			+ """,""decision"":""" + А.decision + """,""reason"":""" + JSONЭкран(А.reason)
			+ """,""typeUp"":""" + JSONЭкран(Строка(А.typeUp)) + """,""typeVendor"":""" + JSONЭкран(Строка(А.typeVendor)) + """}");
	КонецЦикла;
	Возврат "[" + СтрСоединить(Ч, ",") + "]";
КонецФункции

Функция JSONЭкран(З)
	З = СтрЗаменить(З, "\", "\\");
	З = СтрЗаменить(З, """", "\""");
	Возврат З;
КонецФункции
