// Анализ-only: реквизиты управляемых форм УП vs БП (имя, тип, DataPath). Исходные выгрузки не меняются.
// programGeneration по умолчанию manual; runtime-создание в Module.bsl только фиксируется с причиной.

Функция ПеречислитьFormXml(Корень) Экспорт
	Рез = Новый Соответствие;
	ИскатьFormXml(Корень, Корень, Рез);
	Возврат Рез;
КонецФункции

Процедура ИскатьFormXml(Корень, Текущий, Рез)
	Для Каждого Эл Из НайтиФайлы(Текущий, "Form.xml", Ложь) Цикл
		Норм = СтрЗаменить(НРег(Эл.ПолноеИмя), "/", "\");
		Если СтрНайти(Норм, "\forms\") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Эл.ПолноеИмя, СтрДлина(Корень) + 2);
		Рез.Вставить(СтрЗаменить(Отн, "/", "\"), Эл.ПолноеИмя);
	КонецЦикла;
	Для Каждого Под Из НайтиФайлы(Текущий, "*", Ложь) Цикл
		Если Под.ЭтоКаталог() Тогда
			ИскатьFormXml(Корень, Под.ПолноеИмя, Рез);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИменаРеквизитовFormXml(ПутьXml) Экспорт
	Карта = КартаРеквизитовFormXml(ПутьXml);
	Рез = Новый Массив;
	Для Каждого КЗ Из Карта Цикл
		Рез.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Имя → Структура(type, dataPath, qualParsed, qualLength, qualAllowed) — лексика Form.xml.
Функция КартаРеквизитовFormXml(ПутьXml) Экспорт
	Рез = Новый Соответствие;
	Если Не (Новый Файл(ПутьXml)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(ПутьXml, КодировкаТекста.UTF8);
	Блок = ВырезатьБлокАтрибутов(Т.ПолучитьТекст());
	Если Блок = "" Тогда
		Возврат Рез;
	КонецЕсли;
	Поз = СтрНайти(Блок, "<Attribute");
	Пока Поз > 0 Цикл
		Хвост = Сред(Блок, Поз);
		КонБлок = СтрНайти(Хвост, "</Attribute>");
		Если КонБлок = 0 Тогда
			Прервать;
		КонецЕсли;
		Фраг = Лев(Хвост, КонБлок + СтрДлина("</Attribute>") - 1);
		Имя = ЗначениеТега(Фраг, "Name");
		Если Имя <> "" Тогда
			Кв = РазобратьКвалификаторыСтроки(Фраг);
			Рез.Вставить(Имя, Новый Структура("type, dataPath, qualParsed, qualLength, qualAllowed",
				НормТип(ЗначениеТегаV8Тип(Фраг)), СокрЛП(ЗначениеТега(Фраг, "DataPath")),
				Кв.parsed, Кв.length, Кв.allowed));
		КонецЕсли;
		Блок = Сред(Хвост, КонБлок + СтрДлина("</Attribute>"));
		Поз = СтрНайти(Блок, "<Attribute");
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ВырезатьБлокАтрибутов(Текст)
	Нач = СтрНайти(Текст, "<Attributes");
	Если Нач = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Нач);
	Кон = СтрНайти(Хвост, "</Attributes>");
	Если Кон > 0 Тогда
		Хвост = Лев(Хвост, Кон - 1);
	КонецЕсли;
	Возврат Хвост;
КонецФункции

Функция ЗначениеТега(Фраг, ИмяТега)
	Метка = "<" + ИмяТега + ">";
	Поз = СтрНайти(Фраг, Метка);
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Х2 = Сред(Фраг, Поз + СтрДлина(Метка));
	Закр = "</" + ИмяТега + ">";
	Кон = СтрНайти(Х2, Закр);
	Если Кон = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Х2, Кон - 1));
КонецФункции

Функция ЗначениеТегаV8Тип(Фраг)
	М = "<v8:Type>";
	Поз = СтрНайти(Фраг, М);
	Если Поз = 0 Тогда
		Возврат ЗначениеТега(Фраг, "Type");
	КонецЕсли;
	Х2 = Сред(Фраг, Поз + СтрДлина(М));
	Кон = СтрНайти(Х2, "</v8:Type>");
	Если Кон = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Х2, Кон - 1));
КонецФункции

Функция НормТип(Т)
	Если Т = "" Тогда
		Возврат "?";
	КонецЕсли;
	Возврат Т;
КонецФункции

Функция РазобратьКвалификаторыСтроки(Фраг)
	Пусто = Новый Структура("parsed, length, allowed", Ложь, 0, "");
	Если НРег(ЗначениеТегаV8Тип(Фраг)) <> "xs:string" Тогда
		Возврат Пусто;
	КонецЕсли;
	Поз = СтрНайти(Фраг, "<v8:StringQualifiers");
	Если Поз = 0 Тогда
		Возврат Пусто;
	КонецЕсли;
	Блок = Сред(Фраг, Поз);
	Кон = СтрНайти(Блок, "</v8:StringQualifiers>");
	Если Кон = 0 Тогда
		Возврат Пусто;
	КонецЕсли;
	Блок = Лев(Блок, Кон - 1);
	Дл = ЗначениеВложенногоV8(Блок, "Length");
	Доп = ЗначениеВложенногоV8(Блок, "AllowedLength");
	Если Дл = "" Или Доп = "" Тогда
		Возврат Пусто;
	КонецЕсли;
	Попытка
		ЧДл = Число(Дл);
	Исключение
		Возврат Пусто;
	КонецПопытки;
	НДоп = НРег(Доп);
	Если НДоп <> "fixed" И НДоп <> "variable" И НДоп <> "any" Тогда
		Возврат Пусто;
	КонецЕсли;
	Возврат Новый Структура("parsed, length, allowed", Истина, ЧДл, НДоп);
КонецФункции

Функция ЗначениеВложенногоV8(Блок, ЛокИмя)
	М = "<v8:" + ЛокИмя + ">";
	П = СтрНайти(Блок, М);
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Х = Сред(Блок, П + СтрДлина(М));
	К = СтрНайти(Х, "</v8:" + ЛокИмя + ">");
	Если К = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Х, К - 1));
КонецФункции

Функция ПрефиксОбъектаИзПутиФормы(ПутьФормы)
	Ч = СтрРазделить(ПутьФормы, "\");
	Если Ч.Количество() < 4 ИЛИ Ч[2] <> "Forms" Тогда
		Возврат "";
	КонецЕсли;
	Возврат Ч[0] + "\" + Ч[1];
КонецФункции

Функция ВПериметреОбъекта(Префикс, ПериметрМодулей)
	Если ПериметрМодулей = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КЗ Из ПериметрМодулей Цикл
		Если СтрНачинаетсяС(КЗ.Ключ, Префикс + "\") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Пишет forms_analysis.json; programGeneration по умолчанию manual (без правки выгрузок).
// РежимПревью: forms_preview/ + forms_preview.html (не extension, не Form.xml).
// РежимПеренос: forms_transfer/ + forms_transfer.json (opt-in, не extension, не Form.xml).
Функция СравнитьФормы(КореньИсх, КореньПост, ПериметрМодулей, Выход, Лог, РежимПревью = Ложь, РежимПеренос = Ложь) Экспорт
	Превью = ?(РежимПревью, ЗагрузитьПревью(), Неопределено);
	Перенос = ?(РежимПеренос, ЗагрузитьПеренос(), Неопределено);
	ПакетыПереноса = ?(РежимПеренос, Новый Массив, Неопределено);
	ФИсх = ПеречислитьFormXml(КореньИсх);
	ФПост = ПеречислитьFormXml(КореньПост);
	Все = Новый Соответствие;
	Для Каждого КЗ Из ФИсх Цикл
		Все.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из ФПост Цикл
		Все.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Элементы = Новый Массив;
	Для Каждого КЗ Из Все Цикл
		Ключ = КЗ.Ключ;
		Преф = ПрефиксОбъектаИзПутиФормы(Ключ);
		Если Преф <> "" И Не ВПериметреОбъекта(Преф, ПериметрМодулей) Тогда
			Продолжить;
		КонецЕсли;
		ПутьИ = ФИсх.Получить(Ключ);
		ПутьП = ФПост.Получить(Ключ);
		Если ПутьИ = Неопределено Тогда
			Зап = ЗаписьФормы(Ключ, "only_vendor", Новый Массив, Новый Массив, Новый Массив, "Форма только у поставщика");
			Элементы.Добавить(Зап);
			Если Перенос <> Неопределено Тогда
				ПакетыПереноса.Добавить(Перенос.ОценитьФорму(Зап, ПутьИ, ПутьП, Новый Соответствие, Новый Соответствие));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если ПутьП = Неопределено Тогда
			Зап = ЗаписьФормы(Ключ, "only_source", ИменаРеквизитовFormXml(ПутьИ), Новый Массив, Новый Массив, "Форма только в УП — без отката");
			Элементы.Добавить(Зап);
			Если Перенос <> Неопределено Тогда
				ПакетыПереноса.Добавить(Перенос.ОценитьФорму(Зап, ПутьИ, ПутьП, КартаРеквизитовFormXml(ПутьИ), Новый Соответствие));
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		КИ = КартаРеквизитовFormXml(ПутьИ);
		КП = КартаРеквизитовFormXml(ПутьП);
		Доб = ИменаТолькоВПервой(КИ, КП);
		Уд = ИменаТолькоВПервой(КП, КИ);
		Об = ОтличияОбщихРеквизитов(КИ, КП);
		Статус = ?(Доб.Количество() = 0 И Уд.Количество() = 0 И Об.Количество() = 0, "identical", "changed");
		Прич = СводкаАнализаФормы(ПутьИ, ПутьП, Доб, Уд, Об);
		Зап = ЗаписьФормы(Ключ, Статус, Доб, Уд, Об, Прич);
		Если Превью <> Неопределено И ПутьИ <> Неопределено Тогда
			Доп = Превью.ОценитьПревью(Доб, Уд, Об, КИ, ПутьИ);
			Зап.programGeneration = Доп.programGeneration;
			Зап.previewReason = Доп.previewReason;
			Зап.previewCode = Доп.previewCode;
			Зап.insertHint = Доп.insertHint;
			Если Доп.programGeneration = "preview" Тогда
				Зап.note = Зап.note + "; " + Доп.insertHint;
			ИначеЕсли Доп.previewReason <> "" Тогда
				Зап.note = Зап.note + "; preview: " + Доп.previewReason;
			КонецЕсли;
		КонецЕсли;
		Если Перенос <> Неопределено Тогда
			Пк = Перенос.ОценитьФорму(Зап, ПутьИ, ПутьП, КИ, КП);
			ПакетыПереноса.Добавить(Пк);
			Если ЕстьПеренесённыйАтрибут(Пк.attributes) Тогда
				Зап.programGeneration = "transfer";
				Зап.note = Зап.note + "; forms_transfer: см. forms_transfer.json";
			ИначеЕсли РежимПеренос И Статус = "changed" И (Доб.Количество() > 0 Или Уд.Количество() > 0) Тогда
				Зап.note = Зап.note + "; transfer: все реквизиты manual/skip — forms_transfer.json";
			КонецЕсли;
		КонецЕсли;
		Элементы.Добавить(Зап);
	КонецЦикла;
	Тело = "{""forms"":" + ВJSONМассив(Элементы) + "}";
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст(Тело);
	Тд.Записать(ОбъединитьПути(Выход, "forms_analysis.json"), КодировкаТекста.UTF8);
	Лог.Добавить("Анализ форм: записано forms_analysis.json, форм " + Элементы.Количество());
	Если Превью <> Неопределено Тогда
		КатПревью = ОбъединитьПути(Выход, "forms_preview");
		СоздатьКаталог(КатПревью);
		Для Каждого Э Из Элементы Цикл
			Если Э.programGeneration = "preview" И Э.previewCode <> "" Тогда
				Превью.ЗаписатьТекст(ОбъединитьПути(КатПревью, Превью.ИмяФайлаПревью(Э.path)), Э.previewCode);
			КонецЕсли;
		КонецЦикла;
		Превью.ЗаписатьHtmlПревью(Выход, Элементы);
		Лог.Добавить("Анализ форм: forms_preview/ (не extension)");
	КонецЕсли;
	Если Перенос <> Неопределено Тогда
		КатПер = ОбъединитьПути(Выход, "forms_transfer");
		Перенос.ЗаписатьФайлыПереноса(КатПер, Элементы, ПакетыПереноса);
		Перенос.ЗаписатьОтчетПереноса(КатПер, Элементы, ПакетыПереноса);
		Лог.Добавить("Анализ форм: forms_transfer/ (не extension)");
	КонецЕсли;
	Возврат Элементы.Количество();
КонецФункции

Функция ЕстьПеренесённыйАтрибут(Атрибуты)
	Для Каждого А Из Атрибуты Цикл
		Если А.status = "transferred" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЗагрузитьПеренос()
	К = ОбъединитьПути(ТекущийСценарий().Каталог, "ПереносРеквизитовФормы.os");
	Если (Новый Файл(К)).Существует() Тогда
		Возврат ЗагрузитьСценарий(К);
	КонецЕсли;
	К2 = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПереносРеквизитовФормы.os");
	Возврат ЗагрузитьСценарий(К2);
КонецФункции

Функция ЗагрузитьПревью()
	К = ОбъединитьПути(ТекущийСценарий().Каталог, "ПревьюРеквизитовФормы.os");
	Если (Новый Файл(К)).Существует() Тогда
		Возврат ЗагрузитьСценарий(К);
	КонецЕсли;
	// при вызове из Главный.os каталог — src/
	К2 = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПревьюРеквизитовФормы.os");
	Возврат ЗагрузитьСценарий(К2);
КонецФункции

Функция ЗаписьФормы(Путь, Статус, Добавленные, Удалённые, Изменённые, Причина)
	Возврат Новый Структура("path, status, added, removed, changed, programGeneration, note, previewReason, previewCode, insertHint",
		Путь, Статус, Добавленные, Удалённые, Изменённые, "manual", Причина, "", "", "");
КонецФункции

Функция Содержит(М, Значение)
	Для Каждого Э Из М Цикл
		Если Э = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция РазницаСписков(А, Б)
	Р = Новый Массив;
	Для Каждого Э Из А Цикл
		Если Не Содержит(Б, Э) Тогда
			Р.Добавить(Э);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИменаТолькоВПервой(К1, К2)
	Р = Новый Массив;
	Для Каждого КЗ Из К1 Цикл
		Если К2.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОтличияОбщихРеквизитов(КИ, КП)
	Р = Новый Массив;
	Для Каждого КЗ Из КИ Цикл
		Имя = КЗ.Ключ;
		ДП = КП.Получить(Имя);
		Если ДП = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДИ = КЗ.Значение;
		Части = Новый Массив;
		Если ДИ.type <> ДП.type Тогда
			Части.Добавить("type:" + ДП.type + "→" + ДИ.type);
		КонецЕсли;
		Если ДИ.dataPath <> ДП.dataPath Тогда
			Части.Добавить("dataPath:" + ?(ДП.dataPath = "", "—", ДП.dataPath) + "→" + ?(ДИ.dataPath = "", "—", ДИ.dataPath));
		КонецЕсли;
		Если Части.Количество() > 0 Тогда
			Р.Добавить(Имя + "|" + СтрСоединить(Части, ","));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СводкаАнализаФормы(ПутьИ, ПутьП, Доб, Уд, Об)
	Ч = Новый Массив;
	Ч.Добавить("programGeneration=manual: исходные Form.xml не изменяются");
	Если Доб.Количество() > 0 Или Уд.Количество() > 0 Или Об.Количество() > 0 Тогда
		Ч.Добавить("сверка имя/тип/DataPath");
	КонецЕсли;
	Доп = ПримечаниеМодульФормы(ПутьИ, ПутьП);
	Если Доп <> "" Тогда
		Ч.Добавить(Доп);
	КонецЕсли;
	Возврат СтрСоединить(Ч, "; ");
КонецФункции

Функция ПримечаниеМодульФормы(ПутьИ, ПутьП)
	Заметки = Новый Массив;
	Пути = Новый Массив;
	Пути.Добавить(ПутьИ);
	Если ПутьП <> Неопределено Тогда
		Пути.Добавить(ПутьП);
	КонецЕсли;
	Для Каждого П Из Пути Цикл
		Если П = Неопределено Или П = "" Тогда
			Продолжить;
		КонецЕсли;
		М = ПутьМодуляФормы(П);
		Если М = "" Или Не (Новый Файл(М)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Т = Новый ТекстовыйДокумент;
		Т.Прочитать(М, КодировкаТекста.UTF8);
		Н = НРег(Т.ПолучитьТекст());
		Если СтрНайти(Н, "реквизитформы") > 0 Или СтрНайти(Н, "изменитьреквизиты") > 0 Тогда
			Заметки.Добавить("Module.bsl: runtime создание реквизитов — manual, без эквивалентности runtime");
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Заметки, "; ");
КонецФункции

Функция ПутьМодуляФормы(ПутьFormXml)
	База = Лев(ПутьFormXml, СтрДлина(ПутьFormXml) - СтрДлина("Form.xml"));
	Возврат ОбъединитьПути(База, "Form", "Module.bsl");
КонецФункции

Функция ВJSONМассив(МассивСтруктур)
	// минимальная сериализация через ОтчетHTML нет — простой JSON
	Части = Новый Массив;
	Для Каждого С Из МассивСтруктур Цикл
		Части.Добавить(СтруктураВJSON(С));
	КонецЦикла;
	Возврат "[" + СтрСоединить(Части, ",") + "]";
КонецФункции

Функция СтруктураВJSON(С)
	База = "{""path"":""" + JSONЭкран(С.path) + """,""status"":""" + С.status
		+ """,""programGeneration"":""" + С.programGeneration + """,""note"":""" + JSONЭкран(С.note) + """"
		+ ",""added"":" + МассивВJSON(С.added) + ",""removed"":" + МассивВJSON(С.removed)
		+ ",""changed"":" + МассивВJSON(С.changed);
	Если С.previewReason <> "" Или С.previewCode <> "" Тогда
		База = База + ",""previewReason"":""" + JSONЭкран(С.previewReason) + """,""insertHint"":"""
			+ JSONЭкран(С.insertHint) + """,""previewCode"":""" + JSONЭкран(С.previewCode) + """";
	КонецЕсли;
	Возврат База + "}";
КонецФункции

Функция МассивВJSON(М)
	Если М.Количество() = 0 Тогда
		Возврат "[]";
	КонецЕсли;
	Ч = Новый Массив;
	Для Каждого Э Из М Цикл
		Ч.Добавить("""" + JSONЭкран(Строка(Э)) + """");
	КонецЦикла;
	Возврат "[" + СтрСоединить(Ч, ",") + "]";
КонецФункции

Функция JSONЭкран(З)
	З = СтрЗаменить(З, "\", "\\");
	З = СтрЗаменить(З, """", "\""");
	Возврат З;
КонецФункции
