// Diff метаданных УП↔БП для отчёта класса 3 (не для правки текстов модулей расширения).

Перем КэшОтсутств;
Перем Настройки;
Перем РвСимвол;

Процедура Инициализировать(МодульНастроек) Экспорт
	Настройки = МодульНастроек;
	КэшОтсутств = Неопределено;
	РвСимвол = Новый РегулярноеВыражение("(?<![\wЁё.&#~])([А-ЯЁа-яёA-Za-z_][\wЁё]*)(?![\wЁё]|\s*\()");
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Функция ПостроитьКэш(КореньУп, КореньБп)
	Тодо = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "TodoMissingMetadata.os"));
	Тодо.ИнициализироватьРегексп();
	Р = Новый Соответствие;
	Для Каждого П Из СтрРазделить(
		"Catalog:Catalogs:Справочник,Document:Documents:Документ,Enum:Enums:Перечисление,"
		+ "ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes:ПланВидовХарактеристик,"
		+ "DataProcessor:DataProcessors:Обработка,Report:Reports:Отчет,"
		+ "InformationRegister:InformationRegisters:РегистрСведений,AccumulationRegister:AccumulationRegisters:РегистрНакопления", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Пап = Ч[1];
		ТегРу = Ч[2];
		КатУп = ОбъединитьПути(КореньУп, Пап);
		КатБп = ОбъединитьПути(КореньБп, Пап);
		Если Не (Новый Файл(КатБп)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(КатБп, "*.xml", Ложь) Цикл
			Имя = Ф.ИмяБезРасширения;
			ПутьУп = ОбъединитьПути(КатУп, Имя + ".xml");
			Если Не (Новый Файл(ПутьУп)).Существует() Тогда
				Продолжить;
			КонецЕсли;
			Ключ = ТегРу + "." + Имя;
			ТУ = Тодо.ИменаИзXml(ПрочитатьТекст(ПутьУп));
			ТБ = Тодо.ИменаИзXml(ПрочитатьТекст(Ф.ПолноеИмя));
			Эл = Новый Структура("attrs, tsCols, enumVals", Новый Массив, Новый Массив, Новый Массив);
			Если Ч[0] = "Enum" Тогда
				ЗУ = Тодо.ЗначенияПеречисления(ПрочитатьТекст(ПутьУп));
				ЗБ = Тодо.ЗначенияПеречисления(ПрочитатьТекст(Ф.ПолноеИмя));
				Для Каждого КЗ Из ЗБ Цикл
					Если ЗУ.Получить(КЗ.Ключ) = Неопределено Тогда
						Эл.enumVals.Добавить(КЗ.Значение);
					КонецЕсли;
				КонецЦикла;
			Иначе
				Для Каждого КЗ Из ТБ.attrs Цикл
					Если ТУ.attrs.Получить(КЗ.Ключ) = Неопределено Тогда
						Эл.attrs.Добавить(КЗ.Значение);
					КонецЕсли;
				КонецЦикла;
				Для Каждого КТ Из ТБ.ts Цикл
					СтБ = КТ.Значение;
					СтУ = ТУ.ts.Получить(КТ.Ключ);
					Если СтУ = Неопределено Тогда
						Эл.tsCols.Добавить(СтБ.name);
					Иначе
						Для Каждого Кц Из СтБ.cols Цикл
							Если СтУ.cols.Получить(Кц.Ключ) = Неопределено Тогда
								Эл.tsCols.Добавить(СтБ.name + "." + Кц.Значение);
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			Р.Вставить(НРег(Ключ), Эл);
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция Кэш(КореньУп, КореньБп) Экспорт
	Если КэшОтсутств = Неопределено Тогда
		КэшОтсутств = ПостроитьКэш(КореньУп, КореньБп);
	КонецЕсли;
	Возврат КэшОтсутств;
КонецФункции

Функция ТегРуМетаданных(ТипEn)
	Карта = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Document:Документ,Catalog:Справочник,Enum:Перечисление,Report:Отчет,DataProcessor:Обработка,"
		+ "InformationRegister:РегистрСведений,AccumulationRegister:РегистрНакопления,ChartOfCharacteristicTypes:ПланВидовХарактеристик,"
		+ "ChartOfAccounts:ПланСчетов", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Карта.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Возврат ?(Карта.Получить(ТипEn) = Неопределено, ТипEn, Карта.Получить(ТипEn));
КонецФункции

Функция КлючОбъектаИзПути(ОтнПуть) Экспорт
	Ч = СтрРазделить(СтрЗаменить(ОтнПуть, "/", "\"), "\");
	Если Ч.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Если Ч[0] = "CommonModules" Или Ч[0] = "CommonForms" Тогда
		Возврат "";
	КонецЕсли;
	Тип = Настройки.ТипПоКаталогу(Ч[0]);
	Если Тип = "" Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТегРуМетаданных(Тип) + "." + Ч[1];
КонецФункции

Функция ВстречаетсяИмя(Текст, Имя)
	Ин = НРег(Имя);
	Для Каждого С Из РвСимвол.НайтиСовпадения(Текст) Цикл
		Если НРег(С.Группы[1].Значение) = Ин Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Если СтрНайти(НРег(Текст), Ин) > 0 И СтрНайти(Текст, Имя + ".") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ОтсутствующиеВТексте(КлючОбъекта, Текст, КореньУп, КореньБп) Экспорт
	Р = Новый Массив;
	Если СокрЛП(КлючОбъекта) = "" Или СокрЛП(Текст) = "" Тогда
		Возврат Р;
	КонецЕсли;
	Эл = Кэш(КореньУп, КореньБп).Получить(НРег(КлючОбъекта));
	Если Эл = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Уже = Новый Соответствие;
	Для Каждого Им Из Эл.attrs Цикл
		Если ВстречаетсяИмя(Текст, Им) Тогда
			Ст = "реквизит " + Им;
			Если Уже.Получить(Ст) = Неопределено Тогда
				Уже.Вставить(Ст, Истина);
				Р.Добавить(Ст);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Им Из Эл.tsCols Цикл
		Если СтрНайти(Им, ".") > 0 Тогда
			Ч = СтрРазделить(Им, ".");
			Если ВстречаетсяИмя(Текст, Ч[0]) И ВстречаетсяИмя(Текст, Ч[1]) Тогда
				Ст = "колонка ТЧ " + Им;
				Если Уже.Получить(Ст) = Неопределено Тогда
					Уже.Вставить(Ст, Истина);
					Р.Добавить(Ст);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ВстречаетсяИмя(Текст, Им) Тогда
			Ст = "ТЧ " + Им;
			Если Уже.Получить(Ст) = Неопределено Тогда
				Уже.Вставить(Ст, Истина);
				Р.Добавить(Ст);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Им Из Эл.enumVals Цикл
		Если ВстречаетсяИмя(Текст, Им) Тогда
			Ст = "значение перечисления " + Им;
			Если Уже.Получить(Ст) = Неопределено Тогда
				Уже.Вставить(Ст, Истина);
				Р.Добавить(Ст);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстМетодаДляПроверки(Мт) Экспорт
	Части = Новый Массив;
	Если СокрЛП(Мт.vendorText) <> "" Тогда
		Части.Добавить(Мт.vendorText);
	КонецЕсли;
	Если СокрЛП(Мт.hookBody) <> "" Тогда
		Части.Добавить(Мт.hookBody);
	КонецЕсли;
	Если Мт.status = "added" И СокрЛП(Мт.sourceText) <> "" Тогда
		Части.Добавить(Мт.sourceText);
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции