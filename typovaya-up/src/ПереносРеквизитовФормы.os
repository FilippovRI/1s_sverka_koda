// Срез 1: реальный перенос (артефакты в forms_transfer/, выгрузки не меняются).
// Добавления — только сравнение УП/БП (список added в АнализФорм).

Функция ОценитьФорму(Запись, ПутьИ, ПутьП, КартаИ, КартаП) Экспорт
	Атрибуты = Новый Массив;
	СтатусФ = Запись.status;
	Если СтатусФ = "only_source" Тогда
		Для Каждого Имя Из Запись.added Цикл
			Атрибуты.Добавить(ЗаписьАтрибута(Имя, "manual", "форма только в УП"));
		КонецЦикла;
		Для Каждого Имя Из ИменаИзКарты(КартаИ) Цикл
			Если Не ЕстьИмяВ(Запись.added, Имя) Тогда
				Атрибуты.Добавить(ЗаписьАтрибута(Имя, "skip", "форма УП-only"));
			КонецЕсли;
		КонецЦикла;
		Возврат ПакетФормы(Атрибуты, "", "");
	КонецЕсли;
	Если СтатусФ = "only_vendor" Тогда
		Возврат ПакетФормы(Атрибуты, "", "");
	КонецЕсли;
	Если СтатусФ = "identical" Тогда
		Возврат ПакетФормы(Атрибуты, "", "");
	КонецЕсли;
	Для Каждого Имя Из Запись.removed Цикл
		Атрибуты.Добавить(ЗаписьАтрибута(Имя, "manual", "удалённый реквизит в Form.xml"));
	КонецЦикла;
	Для Каждого Стр Из Запись.changed Цикл
		Имя = ИмяИзСтрокиИзменения(Стр);
		Атрибуты.Добавить(ЗаписьАтрибута(Имя, "manual", "изменён существующий: " + Стр));
	КонецЦикла;
	Для Каждого Имя Из Запись.added Цикл
		Оц = ОценитьДобавленный(Имя, Запись, КартаИ, КартаП, ПутьИ, ПутьП);
		Атрибуты.Добавить(Оц);
	КонецЦикла;
	Код = "";
	Если ЕстьПеренесённые(Атрибуты) Тогда
		Код = СобратьКодФормы(Атрибуты, КартаИ, ПутьИ);
	КонецЕсли;
	Возврат ПакетФормы(Атрибуты, Код, "");
КонецФункции

Функция ОценитьДобавленный(Имя, Запись, КартаИ, КартаП, ПутьИ, ПутьП)
	Если Запись.added.Количество() <> 1 Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", "срез 1: ровно один added, найдено " + Запись.added.Количество());
	КонецЕсли;
	Если Запись.removed.Количество() > 0 Или Запись.changed.Количество() > 0 Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", "срез 1: только одиночное added без прочих отличий");
	КонецЕсли;
	Инфо = КартаИ.Получить(Имя);
	Если Инфо = Неопределено Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", "нет описания в УП Form.xml");
	КонецЕсли;
	Если Не ПростойТипСреза1(Инфо) Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", "тип не срез 1: " + Инфо.type);
	КонецЕсли;
	Если НРег(Инфо.type) = "xs:string" И Не Инфо.qualParsed Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", "квалификаторы строки не распознаны");
	КонецЕсли;
	ТекстМодуля = ПрочитатьМодульФормы(ПутьИ);
	ПричМ = ПроверитьМодульФормы(ТекстМодуля, Имя);
	Если ПричМ <> "" Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", ПричМ);
	КонецЕсли;
	ПричМ = ПроверитьМодульСложность(ТекстМодуля);
	Если ПричМ <> "" Тогда
		Возврат ЗаписьАтрибута(Имя, "manual", ПричМ);
	КонецЕсли;
	Эл = ЭлементыUiПоРеквизиту(ПутьИ, Имя);
	Возврат Новый Структура("name, status, reason, info, uiElements, transferBody",
		Имя, "transferred", "одиночный added, " + Инфо.type + СуффиксDataPath(Инфо),
		Инфо, Эл, СгенерироватьТелоПереноса(Имя, Инфо, Эл, ПутьИ));
КонецФункции

Функция ПростойТипСреза1(Инфо)
	Т = НРег(СокрЛП(Инфо.type));
	Возврат Т = "xs:string" Или Т = "xs:boolean";
КонецФункции

Функция СуффиксDataPath(Инфо)
	Если СокрЛП(Инфо.dataPath) = "" Тогда
		Возврат "";
	КонецЕсли;
	Возврат ", DataPath=" + Инфо.dataPath;
КонецФункции

Функция ПроверитьМодульФормы(Текст, ИмяРеквизита)
	Если СокрЛП(Текст) = "" Тогда
		Возврат "";
	КонецЕсли;
	Н = НРег(Текст);
	ИН = НРег(ИмяРеквизита);
	Если СтрНайти(Н, "реквизитформы") > 0 Или СтрНайти(Н, "изменитьреквизиты") > 0 Тогда
		Шаблон1 = "реквизитформы(""" + ИН + """";
		Шаблон2 = "реквизитформы('" + ИН + "'";
		Если СтрНайти(Н, Шаблон1) > 0 Или СтрНайти(Н, Шаблон2) > 0 Тогда
			Возврат "Module.bsl: дублирующее runtime-создание реквизита " + ИмяРеквизита;
		КонецЕсли;
		Возврат "Module.bsl: уже есть РеквизитФормы/ИзменитьРеквизиты — консервативно manual";
	КонецЕсли;
	Если СтрНайти(Н, ИН) > 0 Тогда
		Возврат "Module.bsl: обращение к " + ИмяРеквизита + " до доказанной точки вставки";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПроверитьМодульСложность(Текст)
	Если СокрЛП(Текст) = "" Тогда
		Возврат "";
	КонецЕсли;
	Н = НРег(Текст);
	Если СтрНайти(Н, "динамическийсписок") > 0 Или СтрНайти(Н, "dynamiclist") > 0 Тогда
		Возврат "Module.bsl: динамический список — manual";
	КонецЕсли;
	Если СтрНайти(Н, "таблицазначений") > 0 Или СтрНайти(Н, "табличнаячасть") > 0 Тогда
		Возврат "Module.bsl: таблица — manual";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЭлементыUiПоРеквизиту(ПутьFormXml, ИмяРеквизита)
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(ПутьFormXml, КодировкаТекста.UTF8);
	Текст = Т.ПолучитьТекст();
	Рез = Новый Массив;
	Ищ = НРег(ИмяРеквизита);
	Поз = 1;
	Пока Истина Цикл
		П = СтрНайти(Текст, "<DataPath>", , Поз);
		Если П = 0 Тогда
			Прервать;
		КонецЕсли;
		Х = Сред(Текст, П + СтрДлина("<DataPath>"));
		К = СтрНайти(Х, "</DataPath>");
		Если К = 0 Тогда
			Прервать;
		КонецЕсли;
		Путь = СокрЛП(Лев(Х, К - 1));
		Если СтрНайти(НРег(Путь), Ищ) > 0 Тогда
			Фраг = ФрагментРодителя(Текст, П);
			Рез.Добавить(Фраг);
		КонецЕсли;
		Поз = П + 1;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ФрагментРодителя(Текст, ПозDataPath)
	Нач = СтрНайти(Текст, "<", , ПозDataPath, -1);
	Если Нач = 0 Тогда
		Возврат "";
	КонецЕсли;
	Кон = СтрНайти(Текст, ">", , ПозDataPath);
	Если Кон = 0 Тогда
		Возврат "";
	КонецЕсли;
	Кон2 = СтрНайти(Текст, ">", , Кон + 1);
	Если Кон2 > Кон Тогда
		Кон = Кон2;
	КонецЕсли;
	Хвост = Сред(Текст, Нач);
	Закр = СтрНайти(Хвост, "</");
	Если Закр = 0 Тогда
		Возврат СокрЛ(Лев(Текст, Кон));
	КонецЕсли;
	ИмяТега = ИмяТегаИзОткрытия(Сред(Текст, Нач, 80));
	Если ИмяТега = "" Тогда
		Возврат "";
	КонецЕсли;
	Полный = СтрНайти(Хвост, "</" + ИмяТега + ">");
	Если Полный > 0 Тогда
		Возврат Лев(Хвост, Полный + СтрДлина("</" + ИмяТега + ">") - 1);
	КонецЕсли;
	Возврат Лев(Хвост, Мин(200, СтрДлина(Хвост)));
КонецФункции

Функция ИмяТегаИзОткрытия(Фраг)
	Если Лев(Фраг, 1) <> "<" Тогда
		Возврат "";
	КонецЕсли;
	Х = Сред(Фраг, 2);
	П = СтрНайти(Х, " ");
	Если П = 0 Тогда
		П = СтрНайти(Х, ">");
	КонецЕсли;
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(Х, П - 1);
КонецФункции

Функция СгенерироватьТелоПереноса(Имя, Инфо, ЭлементыUi, ПутьИ)
	ТипБсл = ФрагментОписаниеТипов(Инфо);
	Ч = Новый Массив;
	Ч.Добавить("// typovaya-up forms_transfer — применять в расширении; статический <Attribute> удалить вместе с этим кодом");
	Ч.Добавить("// REMOVE_STATIC_ATTRIBUTE: " + Имя);
	Ч.Добавить("");
	Ч.Добавить("&НаСервере");
	Ч.Добавить("Процедура УП_Перенос_" + Имя + "(Форма)");
	Ч.Добавить("	// Вызовите ДО первого использования реквизита (например из &После ПриСозданииНаСервере)");
	Ч.Добавить("	НовРек = Новый РеквизитФормы(""" + Имя + """, " + ТипБсл + ");");
	Ч.Добавить("	Добавляемые = Новый Массив;");
	Ч.Добавить("	Добавляемые.Добавить(НовРек);");
	Если ЭлементыUi.Количество() > 0 Тогда
		Ч.Добавить("	// Элементы UI (по DataPath из УП Form.xml) — проверьте в конфигураторе:");
		Для Каждого Э Из ЭлементыUi Цикл
			Ч.Добавить("	// " + СокрЛП(СтрЗаменить(Лев(Э, 120), Символы.ПС, " ")));
		КонецЦикла;
	КонецЕсли;
	Ч.Добавить("	ИзменитьРеквизиты(Добавляемые, , );");
	Ч.Добавить("КонецПроцедуры");
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

Функция ЭкранКавычек(С)
	Возврат СтрЗаменить(С, """", """""");
КонецФункции

Функция ФрагментОписаниеТипов(Инфо)
	Т = НРег(СокрЛП(Инфо.type));
	Если Т = "xs:boolean" Тогда
		Возврат "Новый ОписаниеТипов(""Булево"")";
	КонецЕсли;
	Доп = Инфо.qualAllowed;
	Дл = Инфо.qualLength;
	Если Доп = "fixed" Тогда
		Возврат "Новый ОписаниеТипов(""Строка"", , Новый КвалификаторыСтроки(" + Дл + ", , ДопустимаяДлина.Фиксированная))";
	ИначеЕсли Доп = "variable" Тогда
		Возврат "Новый ОписаниеТипов(""Строка"", , Новый КвалификаторыСтроки(" + Дл + ", , ДопустимаяДлина.Переменная))";
	ИначеЕсли Доп = "any" Тогда
		Возврат "Новый ОписаниеТипов(""Строка"", , Новый КвалификаторыСтроки(0, , ДопустимаяДлина.Неограниченная))";
	КонецЕсли;
	Возврат "Новый ОписаниеТипов(""Строка"")";
КонецФункции

Функция СобратьКодФормы(Атрибуты, КартаИ, ПутьИ)
	Части = Новый Массив;
	Для Каждого А Из Атрибуты Цикл
		Если А.status = "transferred" И А.transferBody <> "" Тогда
			Части.Добавить(А.transferBody);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);
КонецФункции

Функция ЕстьПеренесённые(Атрибуты)
	Для Каждого А Из Атрибуты Цикл
		Если А.status = "transferred" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЗаписьАтрибута(Имя, Статус, Причина)
	Возврат Новый Структура("name, status, reason, info, uiElements, transferBody",
		Имя, Статус, Причина, Неопределено, Новый Массив, "");
КонецФункции

Функция ПакетФормы(Атрибуты, Код, Прим)
	Возврат Новый Структура("attributes, transferCode, note", Атрибуты, Код, Прим);
КонецФункции

Функция ПрочитатьМодульФормы(ПутьFormXml)
	База = Лев(ПутьFormXml, СтрДлина(ПутьFormXml) - СтрДлина("Form.xml"));
	М = ОбъединитьПути(База, "Form", "Module.bsl");
	Если Не (Новый Файл(М)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(М, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Функция ИменаИзКарты(Карта)
	Р = Новый Массив;
	Для Каждого КЗ Из Карта Цикл
		Р.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЕстьИмяВ(М, Имя)
	Для Каждого Э Из М Цикл
		Если Э = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ИмяИзСтрокиИзменения(Стр)
	П = СтрНайти(Стр, "|");
	Если П > 0 Тогда
		Возврат Лев(Стр, П - 1);
	КонецЕсли;
	Возврат Стр;
КонецФункции

Функция ИмяФайлаПереноса(КлючФормы) Экспорт
	Без = СтрЗаменить(СтрЗаменить(КлючФормы, "\", "_"), "/", "_");
	Возврат Без + ".transfer.bsl";
КонецФункции

Функция ЗаписатьОтчетПереноса(Каталог, ЭлементыАнализа, Пакеты) Экспорт
	Формы = Новый Массив;
	Для Инд = 0 По ЭлементыАнализа.Количество() - 1 Цикл
		Э = ЭлементыАнализа[Инд];
		П = Пакеты[Инд];
		Формы.Добавить(Новый Структура("path, status, attributes", Э.path, Э.status, ПакетАтрибутовJson(П.attributes)));
	КонецЦикла;
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст("{""forms"":" + СериализоватьМассивФорм(Формы) + "}");
	Тд.Записать(ОбъединитьПути(Каталог, "forms_transfer.json"), КодировкаТекста.UTF8);
КонецФункции

Функция ПакетАтрибутовJson(Атрибуты)
	Ч = Новый Массив;
	Для Каждого А Из Атрибуты Цикл
		Ч.Добавить("{""name"":""" + ЭкранJson(А.name) + """,""status"":""" + А.status + """,""reason"":""" + ЭкранJson(А.reason) + """}");
	КонецЦикла;
	Если Ч.Количество() = 0 Тогда
		Возврат "[]";
	КонецЕсли;
	Возврат "[" + СтрСоединить(Ч, ",") + "]";
КонецФункции

Функция СериализоватьМассивФорм(Формы)
	Ч = Новый Массив;
	Для Каждого Ф Из Формы Цикл
		Ч.Добавить("{""path"":""" + ЭкранJson(Ф.path) + """,""status"":""" + Ф.status + """,""attributes"":"
			+ Ф.attributes + "}");
	КонецЦикла;
	Возврат "[" + СтрСоединить(Ч, ",") + "]";
КонецФункции

Функция ЭкранJson(С)
	С = СтрЗаменить(С, "\", "\\");
	С = СтрЗаменить(С, """", "\""");
	Возврат С;
КонецФункции

Функция ЗаписатьФайлыПереноса(Каталог, Элементы, Пакеты) Экспорт
	СоздатьКаталог(Каталог);
	Для Инд = 0 По Элементы.Количество() - 1 Цикл
		Код = Пакеты[Инд].transferCode;
		Если СокрЛП(Код) = "" Тогда
			Продолжить;
		КонецЕсли;
		Путь = ОбъединитьПути(Каталог, ИмяФайлаПереноса(Элементы[Инд].path));
		Тд = Новый ТекстовыйДокумент;
		Тд.УстановитьТекст(Код);
		Тд.Записать(Путь, КодировкаТекста.UTF8);
	КонецЦикла;
КонецФункции
