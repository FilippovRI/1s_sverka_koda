// Восстановить объекты метаданных (корневые *.xml) из эталонного экспорта, формы не трогать.
КореньСк = ТекущийСценарий().Каталог;
Эталон = "D:\typovaya-up-modcheck-ext";
КаталогРасш = "D:\typovaya-up-out-20261118u\extension";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Эталон = АргументыКоманднойСтроки[0];
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	КаталогРасш = АргументыКоманднойСтроки[1];
КонецЕсли;
Типы = "Catalogs,Documents,DocumentJournals,Enums,InformationRegisters,Reports,DataProcessors,"
	+ "ChartsOfAccounts,ChartsOfCalculationTypes,ChartsOfCharacteristicTypes,AccumulationRegisters,"
	+ "AccountingRegisters,CalculationRegisters,CommonModules,CommonCommands,Constants";
Ск = 0;
Проп = 0;
Для Каждого Т Из СтрРазделить(Типы, ",") Цикл
	ПапЭ = ОбъединитьПути(Эталон, Т);
	ПапР = ОбъединитьПути(КаталогРасш, Т);
	Если Не (Новый Файл(ПапЭ)).Существует() Тогда
		Продолжить;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(ПапЭ, "*.xml", Ложь) Цикл
		Если Ф.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Назнач = ОбъединитьПути(ПапР, Ф.Имя);
		СоздатьКаталог(ПапР);
		Попытка
			КопироватьФайл(Ф.ПолноеИмя, Назнач);
			Ск = Ск + 1;
		Исключение
			Проп = Проп + 1;
		КонецПопытки;
	КонецЦикла;
КонецЦикла;
Сообщить("restored root metadata xml: " + Ск + ", skip: " + Проп);