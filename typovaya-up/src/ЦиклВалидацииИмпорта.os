// Цикл: gate → (починка) → import → сводка; ibcmd только при XML+XDTO 0.
КореньСк = ТекущийСценарий().Каталог;
Oscript = "C:\Users\rst_filippov\OneScript\bin\oscript.exe";
Кав = Символ(34);
КореньРасш = "D:\typovaya-up-out-20261118u\extension";
Макс = 12;
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	КореньРасш = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	Макс = Число(АргументыКоманднойСтроки[1]);
КонецЕсли;
Для Ит = 1 По Макс Цикл
	Сообщить("=== iteration " + Ит + "/" + Макс + " ===");
	Команда = Новый КомандаОС();
	Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
		+ ОбъединитьПути(КореньСк, "ГейтПередИмпортом.os") + Кав + " " + Кав + КореньРасш + Кав);
	Команда.ИспользоватьВыводКакРезультат = Ложь;
	Команда.Исполнить();
	Если Команда.КодВозврата <> 0 Тогда
		Сообщить("gate failed — rebuild forms…");
		Команда = Новый КомандаОС();
		Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
			+ ОбъединитьПути(КореньСк, "ПочинитьФормыРасширения.os") + Кав);
		Команда.ИспользоватьВыводКакРезультат = Ложь;
		Команда.Исполнить();
		Команда = Новый КомандаОС();
		Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
			+ ОбъединитьПути(КореньСк, "ПрименитьЗаимствованиеПолей.os") + Кав);
		Команда.ИспользоватьВыводКакРезультат = Ложь;
		Команда.Исполнить();
		Продолжить;
	КонецЕсли;
	Сообщить("gate OK — import…");
	Команда = Новый КомандаОС();
	Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
		+ ОбъединитьПути(КореньСк, "ИмпортРасширенияСГейтом.os") + Кав + " " + Кав + КореньРасш
		+ Кав + " " + Кав + "--skip-gate" + Кав);
	Команда.ИспользоватьВыводКакРезультат = Ложь;
	Команда.Исполнить();
	Если Команда.КодВозврата = 0 Тогда
		Сообщить("=== import exit 0 — apply/check ===");
		Иб = "C:\Program Files\1cv8\8.5.1.1150\bin\ibcmd.exe";
		База = "C:\Users\rst_filippov\Documents\InfoBase3";
		Имя = "УП_Доработки";
		Для Каждого Ш Из Новый Массив("config check --extension=" + Имя + " --force",
			"config apply --extension=" + Имя + " --force") Цикл
			Команда = Новый КомандаОС();
			Команда.УстановитьКоманду(Кав + Иб + Кав + " infobase --db-path=" + Кав + База + Кав + " " + Ш);
			Команда.ИспользоватьВыводКакРезультат = Ложь;
			Команда.Исполнить();
			Если Команда.КодВозврата <> 0 Тогда
				ВызватьИсключение "ibcmd " + Ш + " exit " + Команда.КодВозврата;
			КонецЕсли;
		КонецЦикла;
		Прервать;
	КонецЕсли;
	Сообщить("import failed — rebuild + field adoption, retry…");
	Команда = Новый КомандаОС();
	Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
		+ ОбъединитьПути(КореньСк, "ПочинитьФормыРасширения.os") + Кав);
	Команда.ИспользоватьВыводКакРезультат = Ложь;
	Команда.Исполнить();
	Команда = Новый КомандаОС();
	Команда.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав
		+ ОбъединитьПути(КореньСк, "ПрименитьЗаимствованиеПолей.os") + Кав);
	Команда.ИспользоватьВыводКакРезультат = Ложь;
	Команда.Исполнить();
КонецЦикла;