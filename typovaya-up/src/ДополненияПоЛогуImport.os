// Дозаготовки по полному логу ibcmd: константы, роли, файлы, фрагменты метаданных, команды форм.
// Вызывается из ДозаготовкиБыстро после классических заготовок.

Функция ПрочитатьЛог(Путь) Экспорт
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "РазборЛогаИмпорта.os"));
	Возврат СклеитьРазорванныеСтрокиЛога(Разбор.ПрочитатьЛог(Путь));
КонецФункции

Функция СклеитьРазорванныеСтрокиЛога(Текст) Экспорт
	Если Текст = "" Тогда
		Возврат "";
	КонецЕсли;
	РвНов = Новый РегулярноеВыражение("^\s*(\[ERROR\]|\[INFO\]|\[WARN\]|ibcmd)");
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Буф = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Если Буф.Количество() = 0 Тогда
			Буф.Добавить(Стр);
			Продолжить;
		КонецЕсли;
		Если РвНов.НайтиСовпадения(Стр).Количество() > 0 Тогда
			Буф.Добавить(Стр);
		Иначе
			Буф[Буф.ВГраница()] = Буф[Буф.ВГраница()] + Стр;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Буф, Символы.ПС);
КонецФункции

Функция ПутиFormИзТекста(Текст) Экспорт
	Р = Новый Массив;
	Уник = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?i)restored[/\\]([^\r\n]+?Form\.xml)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			П = СтрЗаменить(С.Группы[1].Значение, "/", "\");
			Если Уник.Получить(П) = Неопределено Тогда
				Уник.Вставить(П, Истина);
				Р.Добавить(П);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИменаКомандИзТекста(Текст) Экспорт
	Р = Новый Массив;
	Уник = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("Неверное имя команды элемента формы\.\s*-\s*([^\r\n]+)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			Им = СокрЛП(С.Группы[1].Значение);
			Если Уник.Получить(Им) = Неопределено Тогда
				Уник.Вставить(Им, Истина);
				Р.Добавить(Им);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КаталогиОбъектовИзТекста(Текст) Экспорт
	Уник = Новый Соответствие;
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("(?i)restored[/\\](Catalogs|Documents|DataProcessors|Reports|CommonForms|AccumulationRegisters)[/\\]([^/\\\s]+)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			Кат = С.Группы[1].Значение + "\" + С.Группы[2].Значение;
			Если Уник.Получить(Кат) = Неопределено Тогда
				Уник.Вставить(Кат, Истина);
				Р.Добавить(Кат);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КаталогиИзПутейForm(ПутиForm)
	Уник = Новый Соответствие;
	Р = Новый Массив;
	Для Каждого П Из ПутиForm Цикл
		// CommonForms\Имя или Catalogs\Имя — постобработка команд на всём объекте
		Ч = СтрРазделить(П, "\");
		Если Ч.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Кат = Ч[0] + "\" + Ч[1];
		Если Уник.Получить(Кат) = Неопределено Тогда
			Уник.Вставить(Кат, Истина);
			Р.Добавить(Кат);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТегПапкиИзПутиФайла(ОтнПуть)
	Н = НРег(ОтнПуть);
	Для Каждого П Из СтрРазделить("Catalogs:Catalog,Documents:Document,DataProcessors:DataProcessor,Reports:Report,"
		+ "AccumulationRegisters:AccumulationRegister,InformationRegisters:InformationRegister,CommonForms:CommonForm", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Если Лев(Н, СтрДлина(Ч[0]) + 1) = НРег(Ч[0]) + "\" Или Лев(Н, СтрДлина(Ч[0]) + 1) = НРег(Ч[0]) + "/" Тогда
			Хв = Сред(ОтнПуть, СтрДлина(Ч[0]) + 2);
			Имя = СтрРазделить(Хв, "\")[0];
			Если Имя = "" Тогда
				Имя = СтрРазделить(Хв, "/")[0];
			КонецЕсли;
			Возврат Новый Структура("tag, name, folder", Ч[1], Имя, Ч[0]);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция СобратьТребованияИзDataPath(Текст, Заг)
	Треб = Новый Соответствие;
	РвСтрока = Новый РегулярноеВыражение("(?:Файл\s*-\s*[^\r\n]*?restored[/\\]([^\r\n]+?Form\.xml):)?\s*Неверный путь к данным:\s*""([^""]+)""");
	Папки = Заг.ПапкиМетаданных();
	Константы = Новый Соответствие;
	Роли = Новый Соответствие;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Каждого Стр Из Строки Цикл
		СП = РвСтрока.НайтиСовпадения(Стр);
		Если СП.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПутьД = СокрЛП(СП[0].Группы[2].Значение);
		ЧП = СтрРазделить(ПутьД, ".");
		Если ЧП.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Преф = ЧП[0];
		Поле = ЧП[1];
		Мета = Неопределено;
		ОтнФ = СокрЛП(СП[0].Группы[1].Значение);
		Если ОтнФ <> "" Тогда
			Мета = ТегПапкиИзПутиФайла(ОтнФ);
		КонецЕсли;
		Если Преф = "НаборКонстант" Тогда
			Константы.Вставить(Поле, Истина);
		ИначеЕсли Преф = "Объект" И Мета <> Неопределено Тогда
			Т = Заг.ТребованиеОбъекта(Треб, Мета.tag, Мета.name);
			Т.attrs.Вставить(НРег(Поле), Поле);
		ИначеЕсли Преф = "Список" И Мета <> Неопределено И Мета.tag = "AccumulationRegister" Тогда
			Т = Заг.ТребованиеОбъекта(Треб, Мета.tag, Мета.name);
			Т.res.Вставить(НРег(Поле), Поле);
		ИначеЕсли ЧП.Количество() = 2 И Мета <> Неопределено И Мета.tag = "Catalog" Тогда
			// РегистрацияВНалоговомОргане.Owner
			Т = Заг.ТребованиеОбъекта(Треб, Мета.tag, Мета.name);
			Если Т.ts.Получить(Преф) = Неопределено Тогда
				Т.ts.Вставить(Преф, Новый Соответствие);
			КонецЕсли;
			Т.ts.Получить(Преф).Вставить(НРег(Поле), Поле);
		ИначеЕсли Мета <> Неопределено И (Преф = Мета.name Или Преф = "ПриоритетОбновленияВОбластяхДанных") Тогда
			Константы.Вставить(Поле, Истина);
		КонецЕсли;
	КонецЦикла;
	РвРоль = Новый РегулярноеВыражение("Неизвестный объект метаданных\s*-\s*Role\.([\wЁёА-Яа-яA-Za-z0-9_]+)");
	Для Каждого Стр Из Строки Цикл
		Для Каждого С Из РвРоль.НайтиСовпадения(Стр) Цикл
			Роли.Вставить(С.Группы[1].Значение, Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("requirements, constants, roles", Треб, Константы, Роли);
КонецФункции

Функция КопироватьФайлИзБп(ПутьRestored, Корень, КореньБп)
	Отн = Сред(ПутьRestored, СтрДлина(Корень) + 2);
	Исх = ОбъединитьПути(КореньБп, Отн);
	Если (Новый Файл(Исх)).Существует() Тогда
		СоздатьКаталог((Новый Файл(ПутьRestored)).Путь);
		КопироватьФайл(Исх, ПутьRestored);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция КопироватьНедостающиеФайлы(Текст, Корень, КореньБп, Лог)
	Рв = Новый РегулярноеВыражение("Файл не найден\s*-\s*([^\r\n]+)");
	Доб = 0;
	Уник = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			П = СокрЛП(С.Группы[1].Значение);
			Если Уник.Получить(П) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уник.Вставить(П, Истина);
			Если НРег(Лев(П, СтрДлина(Корень))) <> НРег(Корень) Тогда
				Продолжить;
			КонецЕсли;
			Если КопироватьФайлИзБп(П, Корень, КореньБп) Тогда
				Доб = Доб + 1;
				Лог.Добавить("file: " + П);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Доб;
КонецФункции

Функция КопироватьКонстантыИРоли(Константы, Роли, Корень, КореньБп, Лог)
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Вб = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	Заг.Инициализировать();
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = Вб.СоставКонфигурации(ПутьКонф);
	Доб = 0;
	Для Каждого КЗ Из Константы Цикл
		Имя = КЗ.Ключ;
		Исх = ОбъединитьПути(КореньБп, "Constants", Имя + ".xml");
		Назн = ОбъединитьПути(Корень, "Constants", Имя + ".xml");
		Если Не (Новый Файл(Исх)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		СоздатьКаталог(ОбъединитьПути(Корень, "Constants"));
		Если Не (Новый Файл(Назн)).Существует() Тогда
			КопироватьФайл(Исх, Назн);
			Заг.ДобавитьВКонфигурацию(ПутьКонф, "Constant", Имя, Осн);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
			Доб = Доб + 1;
			Лог.Добавить("const: " + Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Роли Цикл
		Имя = КЗ.Ключ;
		Исх = ОбъединитьПути(КореньБп, "Roles", Имя + ".xml");
		Назн = ОбъединитьПути(Корень, "Roles", Имя + ".xml");
		Если Не (Новый Файл(Исх)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		СоздатьКаталог(ОбъединитьПути(Корень, "Roles"));
		Если Не (Новый Файл(Назн)).Существует() Тогда
			КопироватьФайл(Исх, Назн);
			Прав = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньБп, "Roles", Имя), "Ext"), "Rights.xml");
			Если (Новый Файл(Прав)).Существует() Тогда
				Кп = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "Roles", Имя), "Ext"), "Rights.xml");
				СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(Корень, "Roles", Имя), "Ext"));
				КопироватьФайл(Прав, Кп);
			КонецЕсли;
			Заг.ДобавитьВКонфигурацию(ПутьКонф, "Role", Имя, Осн);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
			Доб = Доб + 1;
			Лог.Добавить("role: " + Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Доб;
КонецФункции

Функция ПрименитьФрагментыПоТребованиям(Треб, Корень, КореньБп, Лог)
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Заг.Инициализировать();
	Папки = Заг.ПапкиМетаданных();
	Частей = 0;
	Для Каждого КЗ Из Треб Цикл
		Ч = СтрРазделить(КЗ.Ключ, "|");
		Пап = Папки.Получить(Ч[0]);
		Если Пап = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Р = Заг.ДополнитьФрагментамиОбъект(Корень, КореньБп, Пап, Ч[0], Ч[1], КЗ.Значение, Лог);
		Частей = Частей + Р.parts;
	КонецЦикла;
	Возврат Частей;
КонецФункции

Функция Применить(Корень, КореньБп, ПутьЛога, Лог) Экспорт
	Текст = ПрочитатьЛог(ПутьЛога);
	Если Текст = "" Тогда
		Возврат Новый Структура("files, meta, fragments, commands", 0, 0, 0, 0);
	КонецЕсли;
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Заг.Инициализировать();
	Соб = СобратьТребованияИзDataPath(Текст, Заг);
	Файлы = КопироватьНедостающиеФайлы(Текст, Корень, КореньБп, Лог);
	Мета = КопироватьКонстантыИРоли(Соб.constants, Соб.roles, Корень, КореньБп, Лог);
	Частей = ПрименитьФрагментыПоТребованиям(Соб.requirements, Корень, КореньБп, Лог);
	Фр = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ФормыRestored.os"));
	ИменаК = ИменаКомандИзТекста(Текст);
	ПутиФ = ПутиFormИзТекста(Текст);
	Каталоги = КаталогиОбъектовИзТекста(Текст);
	Команды = 0;
	Для Каждого К Из Каталоги Цикл
		РО = Фр.ОчиститьСтандартныеКомандыВКаталоге(ОбъединитьПути(Корень, К), Лог);
		Команды = Команды + РО.forms;
	КонецЦикла;
	Команды = Команды + Фр.УбратьКомандыПоСпискуВФайлахForm(Корень, ИменаК, ПутиФ, Лог);
	ПостФ = Фр.ПостобработкаФайловПоСписку(Корень, ПутиФ, Лог, Ложь);
	Сообщить("parse: forms=" + ПутиФ.Количество() + " cmd=" + ИменаК.Количество() + " req=" + Соб.requirements.Количество()
		+ " const=" + Соб.constants.Количество() + " roles=" + Соб.roles.Количество());
	Сообщить("дополнения: files=" + Файлы + " meta=" + Мета + " fragments=" + Частей + " commands=" + Команды);
	Возврат Новый Структура("files, meta, fragments, commands, formsPost", Файлы, Мета, Частей, Команды, ПостФ);
КонецФункции