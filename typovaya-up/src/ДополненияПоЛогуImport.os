// Дозаготовки по полному логу ibcmd: константы, роли, файлы, фрагменты метаданных, команды форм.
// Вызывается из ДозаготовкиБыстро после классических заготовок.

Функция ПрочитатьЛог(Путь) Экспорт
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "РазборЛогаИмпорта.os"));
	Возврат СклеитьРазорванныеСтрокиЛога(Разбор.ПрочитатьЛог(Путь));
КонецФункции

Функция СклеитьРазорванныеСтрокиЛога(Текст) Экспорт
	Если Текст = "" Тогда
		Возврат "";
	КонецЕсли;
	РвНов = Новый РегулярноеВыражение("^\s*(\[ERROR\]|\[INFO\]|\[WARN\]|ibcmd)");
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Буф = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Если Буф.Количество() = 0 Тогда
			Буф.Добавить(Стр);
			Продолжить;
		КонецЕсли;
		Если РвНов.НайтиСовпадения(Стр).Количество() > 0 Тогда
			Буф.Добавить(Стр);
		Иначе
			Буф[Буф.ВГраница()] = Буф[Буф.ВГраница()] + Стр;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Буф, Символы.ПС);
КонецФункции

Функция ПутиFormИзТекста(Текст) Экспорт
	Р = Новый Массив;
	Уник = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?i)restored[/\\]([^\r\n]+?Form\.xml)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			П = СтрЗаменить(С.Группы[1].Значение, "/", "\");
			Если Уник.Получить(П) = Неопределено Тогда
				Уник.Вставить(П, Истина);
				Р.Добавить(П);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИменаКомандИзТекста(Текст) Экспорт
	Р = Новый Массив;
	Уник = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?:Неверное имя команды элемента формы\.|StandardCommand\.)\s*-\s*([^\r\n]+)");
	Рв2 = Новый РегулярноеВыражение("\-\s*((?:CommonCommand|Catalog|Document|DataProcessor|Report|DocumentJournal|InformationRegister|AccumulationRegister)\.[^\r\n]+)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			Им = СокрЛП(С.Группы[1].Значение);
			Если Уник.Получить(Им) = Неопределено Тогда
				Уник.Вставить(Им, Истина);
				Р.Добавить(Им);
			КонецЕсли;
		КонецЦикла;
		Для Каждого С Из Рв2.НайтиСовпадения(Стр) Цикл
			Им = СокрЛП(С.Группы[1].Значение);
			Если СтрНайти(Им, ".") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Уник.Получить(Им) = Неопределено Тогда
				Уник.Вставить(Им, Истина);
				Р.Добавить(Им);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КаталогиОбъектовИзТекста(Текст) Экспорт
	Уник = Новый Соответствие;
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("(?i)restored[/\\](Catalogs|Documents|DataProcessors|Reports|CommonForms|AccumulationRegisters)[/\\]([^/\\\s]+)");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			Кат = С.Группы[1].Значение + "\" + С.Группы[2].Значение;
			Если Уник.Получить(Кат) = Неопределено Тогда
				Уник.Вставить(Кат, Истина);
				Р.Добавить(Кат);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КаталогиИзПутейForm(ПутиForm)
	Уник = Новый Соответствие;
	Р = Новый Массив;
	Для Каждого П Из ПутиForm Цикл
		// CommonForms\Имя или Catalogs\Имя — постобработка команд на всём объекте
		Ч = СтрРазделить(П, "\");
		Если Ч.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Кат = Ч[0] + "\" + Ч[1];
		Если Уник.Получить(Кат) = Неопределено Тогда
			Уник.Вставить(Кат, Истина);
			Р.Добавить(Кат);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТегПапкиИзПутиФайла(ОтнПуть)
	Н = НРег(ОтнПуть);
	Для Каждого П Из СтрРазделить("Catalogs:Catalog,Documents:Document,DataProcessors:DataProcessor,Reports:Report,"
		+ "AccumulationRegisters:AccumulationRegister,InformationRegisters:InformationRegister,CommonForms:CommonForm", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Если Лев(Н, СтрДлина(Ч[0]) + 1) = НРег(Ч[0]) + "\" Или Лев(Н, СтрДлина(Ч[0]) + 1) = НРег(Ч[0]) + "/" Тогда
			Хв = Сред(ОтнПуть, СтрДлина(Ч[0]) + 2);
			Имя = СтрРазделить(Хв, "\")[0];
			Если Имя = "" Тогда
				Имя = СтрРазделить(Хв, "/")[0];
			КонецЕсли;
			Возврат Новый Структура("tag, name, folder", Ч[1], Имя, Ч[0]);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция СобратьТребованияИзDataPath(Текст, Заг)
	Треб = Новый Соответствие;
	РвСтрока = Новый РегулярноеВыражение("(?:Файл\s*-\s*[^\r\n]*?restored[/\\]([^\r\n]+?Form\.xml):)?\s*Неверный путь к данным:\s*""([^""]+)""");
	Папки = Заг.ПапкиМетаданных();
	Константы = Новый Соответствие;
	Роли = Новый Соответствие;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Каждого Стр Из Строки Цикл
		СП = РвСтрока.НайтиСовпадения(Стр);
		Если СП.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПутьД = СокрЛП(СП[0].Группы[2].Значение);
		ЧП = СтрРазделить(ПутьД, ".");
		Если ЧП.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Преф = ЧП[0];
		Поле = ЧП[1];
		Мета = Неопределено;
		ОтнФ = СокрЛП(СП[0].Группы[1].Значение);
		Если ОтнФ <> "" Тогда
			Мета = ТегПапкиИзПутиФайла(ОтнФ);
		КонецЕсли;
		Если Преф = "НаборКонстант" Тогда
			Константы.Вставить(Поле, Истина);
		ИначеЕсли Преф = "Объект" И Мета <> Неопределено Тогда
			Т = Заг.ТребованиеОбъекта(Треб, Мета.tag, Мета.name);
			Т.attrs.Вставить(НРег(Поле), Поле);
		ИначеЕсли Преф = "Список" И Мета <> Неопределено И Мета.tag = "AccumulationRegister" Тогда
			Т = Заг.ТребованиеОбъекта(Треб, Мета.tag, Мета.name);
			Т.res.Вставить(НРег(Поле), Поле);
		ИначеЕсли ЧП.Количество() = 2 И Мета <> Неопределено И Мета.tag = "Catalog" Тогда
			// РегистрацияВНалоговомОргане.Owner
			Т = Заг.ТребованиеОбъекта(Треб, Мета.tag, Мета.name);
			Если Т.ts.Получить(Преф) = Неопределено Тогда
				Т.ts.Вставить(Преф, Новый Соответствие);
			КонецЕсли;
			Т.ts.Получить(Преф).Вставить(НРег(Поле), Поле);
		ИначеЕсли Мета <> Неопределено И (Преф = Мета.name Или Преф = "ПриоритетОбновленияВОбластяхДанных") Тогда
			Константы.Вставить(Поле, Истина);
		КонецЕсли;
	КонецЦикла;
	РвРоль = Новый РегулярноеВыражение("Неизвестный объект метаданных\s*-\s*Role\.([\wЁёА-Яа-яA-Za-z0-9_]+)");
	Для Каждого Стр Из Строки Цикл
		Для Каждого С Из РвРоль.НайтиСовпадения(Стр) Цикл
			Роли.Вставить(С.Группы[1].Значение, Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("requirements, constants, roles", Треб, Константы, Роли);
КонецФункции

Функция КопироватьФайлИзБп(ПутьRestored, Корень, КореньБп)
	Отн = Сред(ПутьRestored, СтрДлина(Корень) + 2);
	Исх = ОбъединитьПути(КореньБп, Отн);
	Если (Новый Файл(Исх)).Существует() Тогда
		СоздатьКаталог((Новый Файл(ПутьRestored)).Путь);
		КопироватьФайл(Исх, ПутьRestored);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция КопироватьНедостающиеФайлы(Текст, Корень, КореньБп, Лог)
	Рв = Новый РегулярноеВыражение("Файл не найден\s*-\s*([^\r\n]+)");
	Доб = 0;
	Уник = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			П = СокрЛП(С.Группы[1].Значение);
			Если Уник.Получить(П) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уник.Вставить(П, Истина);
			Если НРег(Лев(П, СтрДлина(Корень))) <> НРег(Корень) Тогда
				Продолжить;
			КонецЕсли;
			Если КопироватьФайлИзБп(П, Корень, КореньБп) Тогда
				Доб = Доб + 1;
				Лог.Добавить("file: " + П);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Доб;
КонецФункции

Функция КопироватьКонстантыИРоли(Константы, Роли, Корень, КореньБп, Лог)
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Вб = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	Заг.Инициализировать();
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = Вб.СоставКонфигурации(ПутьКонф);
	Доб = 0;
	Для Каждого КЗ Из Константы Цикл
		Имя = КЗ.Ключ;
		Исх = ОбъединитьПути(КореньБп, "Constants", Имя + ".xml");
		Назн = ОбъединитьПути(Корень, "Constants", Имя + ".xml");
		Если Не (Новый Файл(Исх)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		СоздатьКаталог(ОбъединитьПути(Корень, "Constants"));
		Если Не (Новый Файл(Назн)).Существует() Тогда
			КопироватьФайл(Исх, Назн);
			Заг.ДобавитьВКонфигурацию(ПутьКонф, "Constant", Имя, Осн);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
			Доб = Доб + 1;
			Лог.Добавить("const: " + Имя);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Роли Цикл
		Имя = КЗ.Ключ;
		Исх = ОбъединитьПути(КореньБп, "Roles", Имя + ".xml");
		Назн = ОбъединитьПути(Корень, "Roles", Имя + ".xml");
		Если Не (Новый Файл(Исх)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		СоздатьКаталог(ОбъединитьПути(Корень, "Roles"));
		Если Не (Новый Файл(Назн)).Существует() Тогда
			КопироватьФайл(Исх, Назн);
			Прав = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(КореньБп, "Roles", Имя), "Ext"), "Rights.xml");
			Если (Новый Файл(Прав)).Существует() Тогда
				Кп = ОбъединитьПути(ОбъединитьПути(ОбъединитьПути(Корень, "Roles", Имя), "Ext"), "Rights.xml");
				СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(Корень, "Roles", Имя), "Ext"));
				КопироватьФайл(Прав, Кп);
			КонецЕсли;
			Заг.ДобавитьВКонфигурацию(ПутьКонф, "Role", Имя, Осн);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
			Доб = Доб + 1;
			Лог.Добавить("role: " + Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Доб;
КонецФункции

Функция ПрименитьФрагментыПоТребованиям(Треб, Корень, КореньБп, Лог)
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Заг.Инициализировать();
	Папки = Заг.ПапкиМетаданных();
	Частей = 0;
	Для Каждого КЗ Из Треб Цикл
		Ч = СтрРазделить(КЗ.Ключ, "|");
		Пап = Папки.Получить(Ч[0]);
		Если Пап = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Р = Заг.ДополнитьФрагментамиОбъект(Корень, КореньБп, Пап, Ч[0], Ч[1], КЗ.Значение, Лог);
		Частей = Частей + Р.parts;
	КонецЦикла;
	Возврат Частей;
КонецФункции

Функция ПутьМетаданныхИзКоманды(ИмяКоманды)
	Рв = Новый РегулярноеВыражение("^(CommonCommand)\.([^\s\.]+)$");
	С = Рв.НайтиСовпадения(ИмяКоманды);
	Если С.Количество() > 0 Тогда
		Возврат Новый Структура("tag, name, cmd", С[0].Группы[1].Значение, С[0].Группы[2].Значение, "");
	КонецЕсли;
	Рв2 = Новый РегулярноеВыражение("^(Catalog|Document|DataProcessor|Report|DocumentJournal|AccumulationRegister)\.([^.]+)\.Command\.(.+)$");
	С2 = Рв2.НайтиСовпадения(ИмяКоманды);
	Если С2.Количество() > 0 Тогда
		Возврат Новый Структура("tag, name, cmd", С2[0].Группы[1].Значение, С2[0].Группы[2].Значение, С2[0].Группы[3].Значение);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция КопироватьОбщийОбъектБп(Тег, Имя, Папка, Корень, КореньБп, ПутьКонф, Осн, Заг, Вб, Лог)
	Исх = ОбъединитьПути(КореньБп, Папка, Имя + ".xml");
	Назн = ОбъединитьПути(Корень, Папка, Имя + ".xml");
	Если Не (Новый Файл(Исх)).Существует() Тогда
		Возврат 0;
	КонецЕсли;
	СоздатьКаталог(ОбъединитьПути(Корень, Папка));
	Если (Новый Файл(Назн)).Существует() Тогда
		Возврат 0;
	КонецЕсли;
	КопироватьФайл(Исх, Назн);
	Заг.ДобавитьВКонфигурацию(ПутьКонф, Тег, Имя, Осн);
	Лог.Добавить(НРег(Тег) + ": " + Имя);
	Возврат 1;
КонецФункции

Процедура ДополнитьКомандыВФрагменте(Корень, КореньБп, Пап, Тег, Имя, ИмяКоманды, Заг, Вб, Лог)
	Назн = ОбъединитьПути(Корень, Пап, Имя + ".xml");
	Исх = ОбъединитьПути(КореньБп, Пап, Имя + ".xml");
	Если Не (Новый Файл(Назн)).Существует() Или Не (Новый Файл(Исх)).Существует() Тогда
		Возврат;
	КонецЕсли;
	ТекНазн = Вб.ПрочитатьТекст(Назн);
	ТекБп = Вб.ПрочитатьТекст(Исх);
	Если ТекНазн = Неопределено Или ТекБп = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВнутрНазн = Заг.ИзвлечьChildObjectsОбъекта(ТекНазн, Тег);
	Если Заг.ЕстьВChildObjects(ВнутрНазн, "Command", ИмяКоманды) Тогда
		Возврат;
	КонецЕсли;
	Ф = Заг.ВырезатьЭлементChildObjects(Заг.ИзвлечьChildObjectsОбъекта(ТекБп, Тег), "Command", ИмяКоманды);
	Если Ф = "" Тогда
		Ф = Заг.ВырезатьКороткуюСсылку(Заг.ИзвлечьChildObjectsОбъекта(ТекБп, Тег), "Command", ИмяКоманды);
	КонецЕсли;
	Если Ф = "" Тогда
		Возврат;
	КонецЕсли;
	НовыйВнутр = ВнутрНазн + Ф;
	ТекНазн = Заг.ЗаменитьChildObjectsКорняОбъекта(ТекНазн, Тег, НовыйВнутр);
	ПолучитьДвоичныеДанныеИзСтроки(ТекНазн, КодировкаТекста.UTF8, Истина).Записать(Назн);
	Лог.Добавить("cmd-meta: " + Тег + "." + Имя + ".Command." + ИмяКоманды);
КонецПроцедуры

Функция КопироватьМетаданныеПоКомандам(ИменаКоманд, Корень, КореньБп, Лог)
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Вб = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	Заг.Инициализировать();
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = Вб.СоставКонфигурации(ПутьКонф);
	Папки = Заг.ПапкиМетаданных();
	Доб = 0;
	Частей = 0;
	Уник = Новый Соответствие;
	Для Каждого ИмП Из ИменаКоманд Цикл
		Р = ПутьМетаданныхИзКоманды(ИмП);
		Если Р = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Р.tag = "CommonCommand" Тогда
			Ключ = "CC|" + Р.name;
			Если Уник.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уник.Вставить(Ключ, Истина);
			Доб = Доб + КопироватьОбщийОбъектБп("CommonCommand", Р.name, "CommonCommands", Корень, КореньБп, ПутьКонф, Осн, Заг, Вб, Лог);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
		ИначеЕсли Р.cmd <> "" Тогда
			Ключ = Р.tag + "|" + Р.name + "|" + Р.cmd;
			Если Уник.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уник.Вставить(Ключ, Истина);
			Пап = Папки.Получить(Р.tag);
			Если Пап <> Неопределено Тогда
				ДополнитьКомандыВФрагменте(Корень, КореньБп, Пап, Р.tag, Р.name, Р.cmd, Заг, Вб, Лог);
				Частей = Частей + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("commonCmd, objCmd", Доб, Частей);
КонецФункции

Функция КопироватьCommonPictureПоЛогу(Текст, Корень, КореньБп, Лог) Экспорт
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Вб = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	Заг.Инициализировать();
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = Вб.СоставКонфигурации(ПутьКонф);
	Рв = Новый РегулярноеВыражение("CommonPicture\.([\wЁёА-Яа-яA-Za-z0-9_]+)");
	Уник = Новый Соответствие;
	Доб = 0;
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из Рв.НайтиСовпадения(Стр) Цикл
			Им = С.Группы[1].Значение;
			Если Уник.Получить(Им) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уник.Вставить(Им, Истина);
			Доб = Доб + КопироватьОбщийОбъектБп("CommonPicture", Им, "CommonPictures", Корень, КореньБп, ПутьКонф, Осн, Заг, Вб, Лог);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
			// каталог картинки
			ИсхК = ОбъединитьПути(КореньБп, "CommonPictures", Им);
			НазнК = ОбъединитьПути(Корень, "CommonPictures", Им);
			Если (Новый Файл(ИсхК)).Существует() И Не (Новый Файл(НазнК)).Существует() Тогда
				СоздатьКаталог(НазнК);
				Для Каждого Ф Из НайтиФайлы(ИсхК, "*", Истина) Цикл
					Отн = Сред(Ф.ПолноеИмя, СтрДлина(ИсхК) + 2);
					К = ОбъединитьПути(НазнК, Отн);
					Если Ф.ЭтоКаталог() Тогда
						СоздатьКаталог(К);
					Иначе
						СоздатьКаталог((Новый Файл(К)).Путь);
						КопироватьФайл(Ф.ПолноеИмя, К);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	// из Form.xml restored после дословного копирования
	Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
		Вб2 = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
		Т = Вб2.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
			Им = С.Группы[1].Значение;
			Назн = ОбъединитьПути(Корень, "CommonPictures", Им + ".xml");
			Если (Новый Файл(Назн)).Существует() Тогда
				Продолжить;
			КонецЕсли;
			Доб = Доб + КопироватьОбщийОбъектБп("CommonPicture", Им, "CommonPictures", Корень, КореньБп, ПутьКонф, Осн, Заг, Вб, Лог);
			Осн = Вб.СоставКонфигурации(ПутьКонф);
		КонецЦикла;
	КонецЦикла;
	Лог.Добавить("commonpicture: " + Доб);
	Возврат Доб;
КонецФункции

Функция ПутиМетаданныхИзXdtoForm(ПутьЛога, Корень) Экспорт
	Текст = ПрочитатьЛог(ПутьЛога);
	Если Текст = "" Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Заг.Инициализировать();
	Вб = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	Уник = Новый Соответствие;
	Р = Новый Массив;
	РвФ = Новый РегулярноеВыражение("(?i)(?:чтении файла-|reading file-)\s*([^\s]+Form\.xml)");
	РвCfg = Новый РегулярноеВыражение("<v8:Type(?:Set)?>(cfg:[^<]+)</v8:Type(?:Set)?>");
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Для Каждого С Из РвФ.НайтиСовпадения(Стр) Цикл
			П = СтрЗаменить(С.Группы[1].Значение, "/", "\");
			Если НРег(Лев(П, СтрДлина(Корень))) <> НРег(Корень) Тогда
				Продолжить;
			КонецЕсли;
			Если Не (Новый Файл(П)).Существует() Тогда
				Продолжить;
			КонецЕсли;
			Тм = Вб.ПрочитатьТекст(П);
			Если Тм = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Т Из РвCfg.НайтиСовпадения(Тм) Цикл
				Раз = Заг.РазборCfg(Т.Группы[1].Значение);
				Если Раз = Неопределено Или Раз.Режим <> "Объект" Тогда
					Продолжить;
				КонецЕсли;
				Путь = Раз.Тег + "." + Раз.Имя;
				Если Уник.Получить(Путь) = Неопределено Тогда
					Уник.Вставить(Путь, Истина);
					Р.Добавить(Путь);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция Применить(Корень, КореньБп, ПутьЛога, Лог, РежимРасширения = Ложь) Экспорт
	Текст = ПрочитатьЛог(ПутьЛога);
	Если Текст = "" Тогда
		Возврат Новый Структура("files, meta, fragments, metaCmd, pictures", 0, 0, 0, 0, 0);
	КонецЕсли;
	Заг = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаготовкиОбъектовБп.os"));
	Заг.Инициализировать();
	Соб = СобратьТребованияИзDataPath(Текст, Заг);
	Файлы = КопироватьНедостающиеФайлы(Текст, Корень, КореньБп, Лог);
	Мета = КопироватьКонстантыИРоли(Соб.constants, Соб.roles, Корень, КореньБп, Лог);
	Частей = ПрименитьФрагментыПоТребованиям(Соб.requirements, Корень, КореньБп, Лог);
	ИменаК = ИменаКомандИзТекста(Текст);
	МетаК = КопироватьМетаданныеПоКомандам(ИменаК, Корень, КореньБп, Лог);
	Карт = 0;
	Если Не РежимРасширения Тогда
		Карт = КопироватьCommonPictureПоЛогу(Текст, Корень, КореньБп, Лог);
	КонецЕсли;
	Сообщить("parse: cmd=" + ИменаК.Количество() + " req=" + Соб.requirements.Количество()
		+ " const=" + Соб.constants.Количество() + " roles=" + Соб.roles.Количество());
	Сообщить("дополнения: files=" + Файлы + " meta=" + Мета + " fragments=" + Частей
		+ " metaCmd=" + МетаК.commonCmd + "+" + МетаК.objCmd + " pictures=" + Карт);
	Возврат Новый Структура("files, meta, fragments, metaCmd, pictures", Файлы, Мета, Частей, МетаК, Карт);
КонецФункции