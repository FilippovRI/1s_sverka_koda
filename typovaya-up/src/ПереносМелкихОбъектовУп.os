// Решение 24.11 (t724s2564, вариант 1): ссылки restored на убранные ОМ только УП.
// (а) Мелкие объекты только УП (обработки, отчёты, общие команды, общие формы), в коде которых есть ссылки на убранные ОМ
//     только УП, переносятся из restored в extension собственными объектами вместе со своими формами (копия из выгрузки УП,
//     uuid заменяются детерминированными); из restored убираются XML/каталог, строка Configuration.xml, ConfigDumpInfo.xml,
//     элементы состава подсистем, команды командных интерфейсов, блоки прав ролей.
//     Прочие объекты только УП (документы, регистры, справочники, константы, HTTP-сервисы…) не переносятся — в todo.
// (б) Строки в объектах, общих с БП (формы в редакции УП при «формы из УП»), остаются в restored — в todo.
// Todo: todo_uponly_cm_refs.md/.csv в каталоге отчёта (объект, модуль, строка, ОМ, класс).

Перем Вб;
Перем ОТУ;
Перем ДС;
Перем Ч;
Перем Пер;

Процедура Инициализировать()
	Кат = ТекущийСценарий().Каталог;
	Вб = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ВозвратОбщихМодулейБп.os"));
	ОТУ = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ОбъектыТолькоУп.os"));
	ДС = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЗапросыДинСписков.os"));
	Ч = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЧерновикРасширения.os"));
	Пер = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ПереносОбъектовУп.os"));
	Пер.Инициализировать(Ч, ОТУ);
КонецПроцедуры

Функция МелкиеТеги() Экспорт
	Р = Новый Соответствие;
	Для Каждого Т Из СтрРазделить("DataProcessor,Report,CommonCommand,CommonForm", ",") Цикл
		Р.Вставить(Т, Истина);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Структура(moved — Массив «Тег.Имя», files, configLines, dumpInfoLines, subsystemLines, commandInterfaces, rolesCleaned, todo, todoA, todoB, notMoved).
Функция Применить(КаталогРас, КаталогВосст, КореньУп, КореньБп, ИмяРасширения, Лог, КаталогОтчёта = "") Экспорт
	Инициализировать();
	Уп = Вб.СоставКонфигурации(ОбъединитьПути(КореньУп, "Configuration.xml"));
	Бп = Вб.СоставКонфигурации(ОбъединитьПути(КореньБп, "Configuration.xml"));
	Рез = Новый Структура("moved, files, adopted, configLines, dumpInfoLines, subsystemLines, commandInterfaces, rolesCleaned, functionalOptions, homePageItems, todo, todoA, todoB, notMoved, skippedQuery",
		Новый Массив, 0, 0, 0, 0, 0, 0, 0, 0, 0, Новый Массив, 0, 0, Новый Соответствие, Новый Соответствие);
	БпМ = Вб.ИменаТега(Бп, "CommonModule");
	Убрать = Новый Массив;
	Для Каждого КЗ Из Вб.ИменаТега(Уп, "CommonModule") Цикл
		Если БпМ.Получить(КЗ.Ключ) = Неопределено Тогда
			Убрать.Добавить(КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Убрать.Количество() = 0 Тогда
		Лог.Добавить("Мелкие объекты только УП: ОМ только УП нет — ничего не делается");
		Возврат Рез;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("(?<![\wЁё.])(" + СтрСоединить(Убрать, "|") + ")\s*\.");
	Рв.ИгнорироватьРегистр = Истина;
	Мелкие = МелкиеТеги();
	СтрокиКонф = Новый Соответствие;
	СтрокиПодс = Новый Соответствие;
	ПолныеИмена = Новый Соответствие;
	ИменаПереноса = Новый Соответствие;
	УидыПереноса = Новый Соответствие;
	Для Каждого КЗТ Из Уп Цикл
		Тег = КЗТ.Ключ;
		Если Мелкие.Получить(Тег) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Папка = ОТУ.КаталогПоКлассу(Тег);
		ИмБп = Вб.ИменаТега(Бп, Тег);
		Для Каждого КЗ Из КЗТ.Значение Цикл
			Имя = КЗ.Значение;
			Если ИмБп.Получить(КЗ.Ключ) <> Неопределено Или Не ЕстьСсылки(ОбъединитьПути(КореньУп, Папка, Имя), Рв) Тогда
				Продолжить;
			КонецЕсли;
			Если ЕстьПроизвольныйЗапрос(ОбъединитьПути(КореньУп, Папка, Имя)) Тогда
				// 1С не загружает в расширение форму с динамическим списком на произвольном запросе к таблицам основной
				// («Неверный путь к данным» по всем полям) — объект остаётся в restored, ссылки уходят в todo (а)
				Рез.skippedQuery.Вставить(Тег + "." + Имя, Истина);
				Продолжить;
			КонецЕсли;
			КопироватьВРасширение(КореньУп, КаталогРас, Папка, Имя, ИмяРасширения, УидыПереноса, Рез);
			ДобавитьСтрокуКонфигурации(КаталогРас, Тег, Имя);
			Рез.moved.Добавить(Тег + "." + Имя);
			ИменаПереноса.Вставить(Тег + "." + Имя, Истина);
			ПутьВосст = ОбъединитьПути(КаталогВосст, Папка, Имя + ".xml");
			Если (Новый Файл(ПутьВосст)).Существует() Тогда
				УдалитьФайлы(ПутьВосст);
			КонецЕсли;
			Кат = ОбъединитьПути(КаталогВосст, Папка, Имя);
			Если (Новый Файл(Кат)).Существует() Тогда
				УдалитьФайлы(Кат);
			КонецЕсли;
			СтрокиКонф.Вставить("<" + Тег + ">" + Имя + "</" + Тег + ">", Истина);
			СтрокиПодс.Вставить("<xr:Item xsi:type=""xr:MDObjectRef"">" + Тег + "." + Имя + "</xr:Item>", Истина);
			ПолныеИмена.Вставить(НРег(Тег + "." + Имя), Истина);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Пол Из Рез.moved Цикл
		Рез.adopted = Рез.adopted + ЗаимствоватьСсылки(КаталогРас, КаталогВосст, ИмяРасширения, Пол, ИменаПереноса);
	КонецЦикла;
	Если ИменаПереноса.Количество() > 0 Тогда
		ЧиститьRestored(КаталогВосст, СтрокиКонф, СтрокиПодс, ПолныеИмена, ИменаПереноса, УидыПереноса, Рез);
	КонецЕсли;
	СобратьTodo(КаталогВосст, Бп, Рв, Мелкие, Рез);
	Лог.Добавить("Мелкие объекты только УП → extension (ссылки на ОМ только УП): перенесено " + Рез.moved.Количество() + " (файлов " + Рез.files
		+ ", заимствовано объектов основной " + Рез.adopted + "); restored: строк Configuration.xml " + Рез.configLines + ", ConfigDumpInfo " + Рез.dumpInfoLines + ", подсистем " + Рез.subsystemLines
		+ ", командных интерфейсов " + Рез.commandInterfaces + ", ролей " + Рез.rolesCleaned + ", функц. опций " + Рез.functionalOptions
		+ ", начальная страница " + Рез.homePageItems + "; todo: (а) " + Рез.todoA + " мест в "
		+ Рез.notMoved.Количество() + " объектах только УП, (б) " + Рез.todoB + " мест");
	Если КаталогОтчёта <> "" Тогда
		ЗаписатьTodo(КаталогОтчёта, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ЕстьПроизвольныйЗапрос(Кат)
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Кат, "Form.xml", Истина) Цикл
		Т = Вб.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т <> Неопределено И СтрНайти(Т, "<ManualQuery>true</ManualQuery>") > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЕстьСсылки(Кат, Рв)
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
		Т = Вб.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т <> Неопределено И Рв.Совпадает(Вб.КодБезЛитералов(Т)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Процедура КопироватьВРасширение(КореньУп, КаталогРас, Папка, Имя, ИмяРасширения, УидыПереноса, Рез)
	// прежняя копия (собственная или заимствованная) заменяется
	Старый = ОбъединитьПути(КаталогРас, Папка, Имя + ".xml");
	Если (Новый Файл(Старый)).Существует() Тогда
		УдалитьФайлы(Старый);
	КонецЕсли;
	Если (Новый Файл(ОбъединитьПути(КаталогРас, Папка, Имя))).Существует() Тогда
		УдалитьФайлы(ОбъединитьПути(КаталогРас, Папка, Имя));
	КонецЕсли;
	Файлы = Новый Массив;
	Мета = ОбъединитьПути(КореньУп, Папка, Имя + ".xml");
	Если (Новый Файл(Мета)).Существует() Тогда
		Файлы.Добавить(Мета);
	КонецЕсли;
	Кат = ОбъединитьПути(КореньУп, Папка, Имя);
	Если (Новый Файл(Кат)).Существует() Тогда
		Для Каждого Ф Из НайтиФайлы(Кат, "*", Истина) Цикл
			Если Не Ф.ЭтоКаталог() Тогда
				Файлы.Добавить(Ф.ПолноеИмя);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Ключ = Папка + "\" + Имя;
	РвО = Новый РегулярноеВыражение("uuid=""([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})""");
	Замены = Новый Соответствие;
	Тексты = Новый Соответствие;
	Для Каждого Путь Из Файлы Цикл
		Если НРег(Прав(Путь, 4)) = ".xml" Тогда
			С = ДС.ПрочитатьСырой(Путь);
			Тексты.Вставить(Путь, С);
			Для Каждого М Из РвО.НайтиСовпадения(С.Текст) Цикл
				У = М.Группы[1].Значение;
				Если Замены.Получить(У) = Неопределено Тогда
					Замены.Вставить(У, Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + "uponly" + Символы.ПС + Ключ + Символы.ПС + НРег(У)));
					УидыПереноса.Вставить(НРег(У), Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Длина = СтрДлина(КореньУп);
	Для Каждого Путь Из Файлы Цикл
		Куда = ОбъединитьПути(КаталогРас, Сред(Путь, Длина + 2));
		СоздатьКаталог((Новый Файл(Куда)).Путь);
		С = Тексты.Получить(Путь);
		Если С = Неопределено Тогда
			КопироватьФайл(Путь, Куда);
		Иначе
			Т = С.Текст;
			Для Каждого КЗ Из Замены Цикл
				Т = СтрЗаменить(Т, КЗ.Ключ, КЗ.Значение);
			КонецЦикла;
			ДС.ЗаписатьСырой(Куда, Т, С.BOM);
		КонецЕсли;
		Рез.files = Рез.files + 1;
	КонецЦикла;
КонецПроцедуры

Функция КлючиТаблицЗапроса()
	М = Новый Массив;
	Для Каждого КЗ Из ТаблицыЗапроса() Цикл
		М.Добавить(КЗ.Ключ);
	КонецЦикла;
	Возврат СтрСоединить(М, "|");
КонецФункции

Функция ТаблицыЗапроса()
	Соотв = Новый Соответствие;
	Пары = "справочник=Catalog;документ=Document;перечисление=Enum;планвидовхарактеристик=ChartOfCharacteristicTypes;плансчетов=ChartOfAccounts;"
		+ "планвидоврасчета=ChartOfCalculationTypes;регистрсведений=InformationRegister;регистрнакопления=AccumulationRegister;"
		+ "регистрбухгалтерии=AccountingRegister;регистррасчета=CalculationRegister;планобмена=ExchangePlan;бизнеспроцесс=BusinessProcess;"
		+ "задача=Task;журналдокументов=DocumentJournal;константа=Constant";
	Для Каждого Пара Из СтрРазделить(Пары, ";") Цикл
		Ч_ = СтрРазделить(Пара, "=");
		Соотв.Вставить(Ч_[0], Ч_[1]);
		Соотв.Вставить(НРег(Ч_[1]), Ч_[1]);
	КонецЦикла;
	Возврат Соотв;
КонецФункции

// Объекты основной (restored), на которые ссылаются метаданные перенесённого объекта (главная таблица динамического
// списка, типы cfg:…Ref.Имя), должны быть в extension заимствованными — иначе 1С: «Неверно указана главная таблица…».
Функция ЗаимствоватьСсылки(КаталогРас, КаталогВосст, ИмяРасширения, ПолноеИмя, ИменаПереноса)
	Ч_ = СтрРазделить(ПолноеИмя, ".");
	Папка = ОТУ.КаталогПоКлассу(Ч_[0]);
	Файлы = Новый Массив;
	Мета = ОбъединитьПути(КаталогРас, Папка, Ч_[1] + ".xml");
	Если (Новый Файл(Мета)).Существует() Тогда
		Файлы.Добавить(Мета);
	КонецЕсли;
	Кат = ОбъединитьПути(КаталогРас, Папка, Ч_[1]);
	Если (Новый Файл(Кат)).Существует() Тогда
		Для Каждого Ф Из НайтиФайлы(Кат, "*.xml", Истина) Цикл
			Файлы.Добавить(Ф.ПолноеИмя);
		КонецЦикла;
	КонецЕсли;
	Заимств = Новый Соответствие;
	Для Каждого Т Из СтрРазделить("Catalog,Document,Enum,ChartOfCharacteristicTypes,ChartOfAccounts,ChartOfCalculationTypes,InformationRegister,"
		+ "AccumulationRegister,AccountingRegister,CalculationRegister,ExchangePlan,BusinessProcess,Task,DocumentJournal,Report,DataProcessor,"
		+ "CommonPicture,StyleItem,CommonCommand,CommonForm,DefinedType,Constant,SettingsStorage,FunctionalOption,CommandGroup", ",") Цикл
		Заимств.Вставить(Т, Истина);
	КонецЦикла;
	РвГт = Новый РегулярноеВыражение("<MainTable>([A-Za-z]+)\.([^<.]+)</MainTable>");
	РвCfg = Новый РегулярноеВыражение("cfg:([A-Za-z]+?)(Ref|Object|Manager|RecordSet|RecordKey|RecordManager|List|Selection|ValueManager)?\.([\wЁё]+)");
	РвCfg.ИгнорироватьРегистр = Ложь;
	// таблицы текста запроса динамического списка (Документ.Х, Справочник.Х, …) — тоже метаданные основной
	РвЗапр = Новый РегулярноеВыражение("<QueryText>([\s\S]*?)</QueryText>");
	РвТабл = Новый РегулярноеВыражение("(?<![\wЁё.&])(" + КлючиТаблицЗапроса() + ")\.([\wЁё]+)");
	РвТабл.ИгнорироватьРегистр = Истина;
	Нужно = Новый Соответствие;
	Для Каждого П Из Файлы Цикл
		Т = Вб.ПрочитатьТекст(П);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из РвГт.НайтиСовпадения(Т) Цикл
			Нужно.Вставить(С.Группы[1].Значение + "." + С.Группы[2].Значение, Истина);
		КонецЦикла;
		Для Каждого СЗ Из РвЗапр.НайтиСовпадения(Т) Цикл
			Для Каждого С Из РвТабл.НайтиСовпадения(СЗ.Группы[1].Значение) Цикл
				Нужно.Вставить(ТаблицыЗапроса().Получить(НРег(С.Группы[1].Значение)) + "." + С.Группы[2].Значение, Истина);
			КонецЦикла;
		КонецЦикла;
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			Нужно.Вставить(С.Группы[1].Значение + "." + С.Группы[3].Значение, Истина);
		КонецЦикла;
	КонецЦикла;
	Кол = 0;
	Для Каждого КЗ Из Нужно Цикл
		Ч2 = СтрРазделить(КЗ.Ключ, ".");
		Если Заимств.Получить(Ч2[0]) = Неопределено Или ИменаПереноса.Получить(КЗ.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Кол = Кол + ЗаимствоватьОбъект(КаталогРас, КаталогВосст, ИмяРасширения, Ч2[0], Ч2[1]);
	КонецЦикла;
	Возврат Кол;
КонецФункции

// Заимствует объект основной (restored) в extension: XML-заглушка Adopted + строка Configuration.xml. 1 — создан, 0 — уже был / нет в restored.
Функция ЗаимствоватьОбъект(КаталогРас, КаталогВосст, ИмяРасширения, Тег, Имя) Экспорт
	Если Ч = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	П2 = ОТУ.КаталогПоКлассу(Тег);
	Куда = ОбъединитьПути(КаталогРас, П2, Имя + ".xml");
	Откуда = ОбъединитьПути(КаталогВосст, П2, Имя + ".xml");
	Если (Новый Файл(Куда)).Существует() Тогда
		ДобавитьСтрокуКонфигурации(КаталогРас, Тег, Имя);
		Возврат 0;
	КонецЕсли;
	Если Не (Новый Файл(Откуда)).Существует() Тогда
		Возврат 0;
	КонецЕсли;
	Данные = Новый Структура("Тип, Имя, СвойUuid, БазовыйUuid, ПутьИсходногоXml, Команды", Тег, Имя,
		Ч.ДетерминированныйUuid(ИмяРасширения + Символы.ПС + Тег + "." + Имя), Ч.UuidОбъекта(Откуда), Откуда, Неопределено);
	СоздатьКаталог(ОбъединитьПути(КаталогРас, П2));
	ДС.ЗаписатьСырой(Куда, Ч.XmlОбъекта(Данные), Ложь);
	ДобавитьСтрокуКонфигурации(КаталогРас, Тег, Имя);
	Возврат 1;
КонецФункции

Процедура ДобавитьСтрокуКонфигурации(КаталогРас, Тег, Имя)
	Путь = ОбъединитьПути(КаталогРас, "Configuration.xml");
	С = ДС.ПрочитатьСырой(Путь);
	Если С = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Строка = "<" + Тег + ">" + Имя + "</" + Тег + ">";
	Если СтрНайти(С.Текст, Строка) > 0 Тогда
		Возврат;
	КонецЕсли;
	Поз = СтрНайти(С.Текст, "</ChildObjects>");
	Если Поз = 0 Тогда
		Возврат;
	КонецЕсли;
	ПС = ?(СтрНайти(С.Текст, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Нач = Поз;
	Пока Нач > 1 И (Сред(С.Текст, Нач - 1, 1) = Символы.Таб Или Сред(С.Текст, Нач - 1, 1) = " ") Цикл
		Нач = Нач - 1;
	КонецЦикла;
	ДС.ЗаписатьСырой(Путь, Лев(С.Текст, Нач - 1) + "			" + Строка + ПС + Сред(С.Текст, Нач), С.BOM);
КонецПроцедуры

Функция УдалитьСтрокиВФайле(Путь, Удалять)
	С = ДС.ПрочитатьСырой(Путь);
	Если С = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Нов = Новый Массив;
	Кол = 0;
	Для Каждого Стр Из СтрРазделить(С.Текст, Символы.ПС, Истина) Цикл
		Если Удалять.Получить(СокрЛП(Стр)) <> Неопределено Тогда
			Кол = Кол + 1;
			Продолжить;
		КонецЕсли;
		Нов.Добавить(Стр);
	КонецЦикла;
	Если Кол > 0 Тогда
		ДС.ЗаписатьСырой(Путь, СтрСоединить(Нов, Символы.ПС), С.BOM);
	КонецЕсли;
	Возврат Кол;
КонецФункции

Процедура ЧиститьRestored(КаталогВосст, СтрокиКонф, СтрокиПодс, ПолныеИмена, ИменаПереноса, УидыПереноса, Рез)
	Рез.configLines = УдалитьСтрокиВФайле(ОбъединитьПути(КаталогВосст, "Configuration.xml"), СтрокиКонф);
	// ConfigDumpInfo: <Metadata name="Тег.Имя"…> и вложенные
	ПутьДамп = ОбъединитьПути(КаталогВосст, "ConfigDumpInfo.xml");
	С = ДС.ПрочитатьСырой(ПутьДамп);
	Если С <> Неопределено Тогда
		РвМ = Новый РегулярноеВыражение("<Metadata name=""([^"".]+\.[^"".]+)[""\.]");
		Нов = Новый Массив;
		Для Каждого Стр Из СтрРазделить(С.Текст, Символы.ПС, Истина) Цикл
			Сов = РвМ.НайтиСовпадения(Стр);
			Если Сов.Количество() > 0 И ПолныеИмена.Получить(НРег(Сов[0].Группы[1].Значение)) <> Неопределено Тогда
				Рез.dumpInfoLines = Рез.dumpInfoLines + 1;
				Продолжить;
			КонецЕсли;
			Нов.Добавить(Стр);
		КонецЦикла;
		Если Рез.dumpInfoLines > 0 Тогда
			ДС.ЗаписатьСырой(ПутьДамп, СтрСоединить(Нов, Символы.ПС), С.BOM);
		КонецЕсли;
	КонецЕсли;
	// подсистемы и командные интерфейсы
	ФайлыКи = Новый Массив;
	Для Каждого Отн Из СтрРазделить("Ext/CommandInterface.xml|Ext/MainSectionCommandInterface.xml", "|") Цикл
		ФайлыКи.Добавить(ОбъединитьПути(КаталогВосст, Отн));
	КонецЦикла;
	КатП = ОбъединитьПути(КаталогВосст, "Subsystems");
	Если (Новый Файл(КатП)).Существует() Тогда
		Для Каждого Ф Из НайтиФайлы(КатП, "*.xml", Истина) Цикл
			Если Ф.Имя = "CommandInterface.xml" Тогда
				ФайлыКи.Добавить(Ф.ПолноеИмя);
			Иначе
				Рез.subsystemLines = Рез.subsystemLines + УдалитьСтрокиВФайле(Ф.ПолноеИмя, СтрокиПодс);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого П Из ФайлыКи Цикл
		С = ДС.ПрочитатьСырой(П);
		Если С = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Кол = 0;
		Т = Пер.ЧиститьКомандныйИнтерфейс(С.Текст, ИменаПереноса, УидыПереноса, Кол);
		Если Кол > 0 Тогда
			ДС.ЗаписатьСырой(П, Т, С.BOM);
			Рез.commandInterfaces = Рез.commandInterfaces + 1;
		КонецЕсли;
	КонецЦикла;
	// функциональные опции: <xr:Object>Тег.Имя…</xr:Object>
	КатФо = ОбъединитьПути(КаталогВосст, "FunctionalOptions");
	Если (Новый Файл(КатФо)).Существует() Тогда
		РвФо = Новый РегулярноеВыражение("^\s*<xr:Object>([^<]+)</xr:Object>\s*$");
		Для Каждого Ф Из НайтиФайлы(КатФо, "*.xml", Ложь) Цикл
			Рез.functionalOptions = Рез.functionalOptions + УдалитьСтрокиПоИмени(Ф.ПолноеИмя, РвФо, ИменаПереноса);
		КонецЦикла;
	КонецЕсли;
	// рабочая область начальной страницы: <Item> с <Form>Тег.Имя</Form>
	Рез.homePageItems = ЧиститьНачальнуюСтраницу(ОбъединитьПути(КаталогВосст, "Ext", "HomePageWorkArea.xml"), ИменаПереноса);
	// роли: блоки прав перенесённых объектов
	КатР = ОбъединитьПути(КаталогВосст, "Roles");
	Если (Новый Файл(КатР)).Существует() Тогда
		Для Каждого Ф Из НайтиФайлы(КатР, "Rights.xml", Истина) Цикл
			С = ДС.ПрочитатьСырой(Ф.ПолноеИмя);
			Если С = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Разбор = Пер.РазобратьПрава(С.Текст, ИменаПереноса);
			Если Разбор.Блоки.Количество() > 0 Тогда
				ДС.ЗаписатьСырой(Ф.ПолноеИмя, Разбор.Остаток, С.BOM);
				Рез.rolesCleaned = Рез.rolesCleaned + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Функция УдалитьСтрокиПоИмени(Путь, Рв, ИменаПереноса)
	С = ДС.ПрочитатьСырой(Путь);
	Если С = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Нов = Новый Массив;
	Кол = 0;
	Для Каждого Стр Из СтрРазделить(С.Текст, Символы.ПС, Истина) Цикл
		Сов = Рв.НайтиСовпадения(СтрЗаменить(Стр, Символы.ВК, ""));
		Если Сов.Количество() > 0 И Пер.ЭтоПереносимоеИмя(Сов[0].Группы[1].Значение, ИменаПереноса) Тогда
			Кол = Кол + 1;
			Продолжить;
		КонецЕсли;
		Нов.Добавить(Стр);
	КонецЦикла;
	Если Кол > 0 Тогда
		ДС.ЗаписатьСырой(Путь, СтрСоединить(Нов, Символы.ПС), С.BOM);
	КонецЕсли;
	Возврат Кол;
КонецФункции

Функция ЧиститьНачальнуюСтраницу(Путь, ИменаПереноса)
	С = ДС.ПрочитатьСырой(Путь);
	Если С = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Строки = СтрРазделить(С.Текст, Символы.ПС, Истина);
	Рв = Новый РегулярноеВыражение("<Form>([^<]+)</Form>");
	Удалить = Новый Соответствие;
	Кол = 0;
	Для Н = 0 По Строки.ВГраница() Цикл
		Сов = Рв.НайтиСовпадения(Строки[Н]);
		Если Сов.Количество() = 0 Или Не Пер.ЭтоПереносимоеИмя(Сов[0].Группы[1].Значение, ИменаПереноса) Тогда
			Продолжить;
		КонецЕсли;
		Нач = Н;
		Пока Нач > 0 И СокрЛП(Строки[Нач]) <> "<Item>" Цикл
			Нач = Нач - 1;
		КонецЦикла;
		Кон = Н;
		Пока Кон < Строки.ВГраница() И СокрЛП(Строки[Кон]) <> "</Item>" Цикл
			Кон = Кон + 1;
		КонецЦикла;
		Если СокрЛП(Строки[Нач]) <> "<Item>" Или СокрЛП(Строки[Кон]) <> "</Item>" Тогда
			Нач = Н;
			Кон = Н;
		КонецЕсли;
		Для К = Нач По Кон Цикл
			Удалить.Вставить(К, Истина);
		КонецЦикла;
		Кол = Кол + 1;
	КонецЦикла;
	Если Кол = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Нов = Новый Массив;
	Для Н = 0 По Строки.ВГраница() Цикл
		Если Удалить.Получить(Н) = Неопределено Тогда
			Нов.Добавить(Строки[Н]);
		КонецЕсли;
	КонецЦикла;
	ДС.ЗаписатьСырой(Путь, СтрСоединить(Нов, Символы.ПС), С.BOM);
	Возврат Кол;
КонецФункции

// Оставшиеся в restored ссылки на убранные ОМ только УП: (а) объект только УП (тип не переносится), (б) объект общий с БП.
Процедура СобратьTodo(КаталогВосст, Бп, Рв, Мелкие, Рез)
	Длина = СтрДлина(КаталогВосст);
	Для Каждого Ф Из НайтиФайлы(КаталогВосст, "*.bsl", Истина) Цикл
		Т = Вб.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Или Не Рв.Совпадает(Т) Тогда
			Продолжить;
		КонецЕсли;
		Код = Вб.КодБезЛитералов(Т);
		Если Не Рв.Совпадает(Код) Тогда
			Продолжить;
		КонецЕсли;
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, Длина + 2), "\", "/");
		Ч_ = СтрРазделить(Отн, "/");
		Тег = ?(Ч_[0] = "Ext", "Configuration", ОТУ.КлассПоКаталогу(Ч_[0]));
		Объект = ?(Тег = "Configuration", "Configuration", Тег + "." + ?(Ч_.Количество() > 1, Ч_[1], ""));
		ВБп = Тег = "Configuration" Или (Тег <> "" И Ч_.Количество() > 1 И Вб.ИменаТега(Бп, Тег).Получить(НРег(Ч_[1])) <> Неопределено);
		Строки = СтрРазделить(СтрЗаменить(Код, Символы.ВК, ""), Символы.ПС, Истина);
		Для Н = 0 По Строки.ВГраница() Цикл
			Сов = Рв.НайтиСовпадения(Строки[Н]);
			Если Сов.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если ВБп Тогда
				Класс = "б";
				Вид = "объект общий с БП, строка УП в restored (формы из УП) — оставлено, перенос вставки отложен";
				Рез.todoB = Рез.todoB + 1;
			Иначе
				Класс = "а";
				Если Рез.skippedQuery.Получить(Объект) <> Неопределено Тогда
					Вид = "мелкий объект только УП не перенесён: форма с динамическим списком на произвольном запросе (1С не загружает её в extension)";
				Иначе
					Вид = "объект только УП, тип " + Тег + " не переносится (документы/регистры/справочники… остаются в restored)";
				КонецЕсли;
				Рез.todoA = Рез.todoA + 1;
				Рез.notMoved.Вставить(Объект, Истина);
			КонецЕсли;
			Рез.todo.Добавить(Новый Структура("cls, object, module, line, cm, kind", Класс, Объект, Отн, Н + 1, Сов[0].Группы[1].Значение, Вид));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьTodo(Каталог, Рез)
	Csv = Новый Массив;
	Csv.Добавить("Класс;Объект;Модуль;Строка;ОМ только УП;Вид");
	Md = Новый Массив;
	Md.Добавить("# Что исправить: ссылки restored на убранные ОМ только УП");
	Md.Добавить("");
	Md.Добавить("Перенесено в extension (мелкие объекты только УП): " + Рез.moved.Количество() + " — " + СтрСоединить(Рез.moved, ", ") + ".");
	Md.Добавить("");
	Мест = Новый Массив;
	Для Каждого КЗ Из Рез.notMoved Цикл
		Мест.Добавить(КЗ.Ключ);
	КонецЦикла;
	Md.Добавить("(а) объекты только УП, которые не переносятся (" + Мест.Количество() + "): " + СтрСоединить(Мест, ", ") + "; мест " + Рез.todoA + ".");
	Md.Добавить("(б) объекты, общие с БП (строки УП в формах в редакции УП): мест " + Рез.todoB + ".");
	Md.Добавить("");
	Md.Добавить("| Класс | Объект | Модуль | Строка | ОМ | Вид |");
	Md.Добавить("|---|---|---|---|---|---|");
	Для Каждого Т Из Рез.todo Цикл
		Csv.Добавить(Т.cls + ";" + Т.object + ";" + Т.module + ";" + Т.line + ";" + Т.cm + ";" + Т.kind);
		Md.Добавить("| " + Т.cls + " | " + Т.object + " | " + Т.module + " | " + Т.line + " | " + Т.cm + " | " + Т.kind + " |");
	КонецЦикла;
	ЗаписатьUtf8(ОбъединитьПути(Каталог, "todo_uponly_cm_refs.csv"), СтрСоединить(Csv, Символы.ВК + Символы.ПС));
	ЗаписатьUtf8(ОбъединитьПути(Каталог, "todo_uponly_cm_refs.md"), СтрСоединить(Md, Символы.ВК + Символы.ПС));
КонецПроцедуры

Процедура ЗаписатьUtf8(Путь, Текст)
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
