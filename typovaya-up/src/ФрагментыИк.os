// Границы фрагментов &ИзменениеИКонтроль: #Вставка/#Удаление только на границах целых операторов и блоков
// (Если…КонецЕсли, Для/Пока…КонецЦикла, Попытка…КонецПопытки, #Если/#Область препроцессора).
// 1) Разорванный фрагмент расширяется до ближайшей границы целых операторов/блоков в обоих видах (БП: общие +
//    #Удаление, УП: общие + #Вставка) — виды при этом не меняются.
// 2) Если вид УП перехвата не совпадает с методом выгрузки УП (с учётом переименований «УП_»), перехват
//    перестраивается по diff вида БП и метода УП (с теми же переименованиями) и затем — п.1.
// 3) Не получилось — перехват убирается из модуля и пишется в todo_hook_fragments (битый перехват не остаётся).
// Модули форм не обрабатываются.

Перем Откр, Закр, Сред_, КонСлова, ПпОткр, ПпЗакр, ПпСред;

Процедура Инициализировать()
	Откр = Новый Соответствие;
	Для Каждого П Из СтрРазделить("если:if,if:if,для:loop,for:loop,пока:loop,while:loop,попытка:try,try:try", ",") Цикл
		Ч = СтрРазделить(П, ":"); Откр.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Закр = Новый Соответствие;
	Для Каждого П Из СтрРазделить("конецесли:if,endif:if,конеццикла:loop,enddo:loop,конецпопытки:try,endtry:try", ",") Цикл
		Ч = СтрРазделить(П, ":"); Закр.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Сред_ = Новый Соответствие;
	Для Каждого П Из СтрРазделить("иначе:if,else:if,иначеесли:if,elsif:if,исключение:try,except:try", ",") Цикл
		Ч = СтрРазделить(П, ":"); Сред_.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	КонСлова = Новый Соответствие;
	Для Каждого С Из СтрРазделить("тогда,then,цикл,do,иначе,else,попытка,try,исключение,except,конецесли,endif,конеццикла,enddo,конецпопытки,endtry", ",") Цикл
		КонСлова.Вставить(С, Истина);
	КонецЦикла;
	ПпОткр = Новый Соответствие;
	Для Каждого П Из СтрРазделить("#если:pif,#if:pif,#область:reg,#region:reg", ",") Цикл
		Ч = СтрРазделить(П, ":"); ПпОткр.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	ПпЗакр = Новый Соответствие;
	Для Каждого П Из СтрРазделить("#конецесли:pif,#endif:pif,#конецобласти:reg,#endregion:reg", ",") Цикл
		Ч = СтрРазделить(П, ":"); ПпЗакр.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	ПпСред = Новый Соответствие;
	Для Каждого П Из СтрРазделить("#иначе:pif,#иначеесли:pif,#else:pif,#elsif:pif", ",") Цикл
		Ч = СтрРазделить(П, ":"); ПпСред.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
КонецПроцедуры

Функция ЭтоБукваИд(С)
	К = КодСимвола(С);
	Возврат К = 95 Или (К >= 48 И К <= 57) Или (К >= 65 И К <= 90) Или (К >= 97 И К <= 122)
		Или (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105;
КонецФункции

// Код строки без строковых литералов и комментария. Структура(Код, ВСтроке — литерал открыт в конце строки).
Функция КодСтроки(Знач Стр, Знач ВСтроке)
	Н = СтрДлина(Стр);
	Пз = 1;
	Если ВСтроке Тогда
		Т = СокрЛ(Стр);
		Если Лев(Т, 1) = "|" Тогда
			Пз = Н - СтрДлина(Т) + 2;
		ИначеЕсли Лев(Т, 2) = "//" Или Т = "" Тогда
			Возврат Новый Структура("Код, ВСтроке", "", Истина);
		КонецЕсли;
	КонецЕсли;
	Рез = "";
	Пока Пз <= Н Цикл
		С = Сред(Стр, Пз, 1);
		Если ВСтроке Тогда
			Если С = """" Тогда
				Если Сред(Стр, Пз + 1, 1) = """" Тогда
					Пз = Пз + 2;
					Продолжить;
				КонецЕсли;
				ВСтроке = Ложь;
			КонецЕсли;
			Пз = Пз + 1;
			Продолжить;
		КонецЕсли;
		Если С = """" Тогда
			ВСтроке = Истина;
			Рез = Рез + " ";
		ИначеЕсли С = "/" И Сред(Стр, Пз + 1, 1) = "/" Тогда
			Прервать;
		Иначе
			Рез = Рез + С;
		КонецЕсли;
		Пз = Пз + 1;
	КонецЦикла;
	Возврат Новый Структура("Код, ВСтроке", Рез, ВСтроке);
КонецФункции

// Слова кода в нижнем регистре.
Функция Слова(Код)
	Р = Новый Массив;
	Тек = "";
	Для Пз = 1 По СтрДлина(Код) Цикл
		С = Сред(Код, Пз, 1);
		Если ЭтоБукваИд(С) Тогда
			Тек = Тек + С;
		ИначеЕсли Тек <> "" Тогда
			Р.Добавить(НРег(Тек));
			Тек = "";
		КонецЕсли;
	КонецЦикла;
	Если Тек <> "" Тогда
		Р.Добавить(НРег(Тек));
	КонецЕсли;
	Возврат Р;
КонецФункции

Функция КонецОператора(Знач Код)
	Код = СокрП(Код);
	Если Прав(Код, 1) = ";" Тогда
		Возврат Истина;
	КонецЕсли;
	Сл = Слова(Код);
	Если Сл.Количество() > 0 И КонСлова.Получить(Сл[Сл.ВГраница()]) <> Неопределено
		И СтрНайти(",(+-*/=<>", Прав(Код, 1)) = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Лев(СокрЛ(Код), 1) = "~" И Прав(Код, 1) = ":";
КонецФункции

// Разметка тела: Массив Структура(Тег C/D/I, Стр).
Функция Разметить(Строки) Экспорт
	Тег = "C";
	Р = Новый Массив;
	Для Каждого С Из Строки Цикл
		Т = НРег(СокрЛП(С));
		Если Т = "#вставка" Тогда
			Тег = "I";
		ИначеЕсли Т = "#удаление" Тогда
			Тег = "D";
		ИначеЕсли Т = "#конецвставки" Или Т = "#конецудаления" Тогда
			Тег = "C";
		Иначе
			Р.Добавить(Новый Структура("Тег, Стр", Тег, С));
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Для вида V (D — БП, I — УП) по каждой строке: токены блоков, последний код, состояние литерала.
Функция Подготовить(Т, V)
	Инфо = Новый Массив;
	ВСтроке = Ложь;
	Последний = "";
	Для Каждого Э Из Т Цикл
		Пз = Новый Структура("В, Токены, Код, ДоПоследний, ДоВСтроке", Ложь, Новый Массив, "", Последний, ВСтроке);
		Инфо.Добавить(Пз);
		Если Э.Тег <> "C" И Э.Тег <> V Тогда
			Продолжить;
		КонецЕсли;
		Пз.В = Истина;
		Т_ = СокрЛП(Э.Стр);
		Если Лев(Т_, 1) = "#" Тогда
			Сл = НРег(СтрРазделить(Т_ + " ", " ")[0]);
			Если ПпОткр.Получить(Сл) <> Неопределено Тогда
				Пз.Токены.Добавить("o:" + ПпОткр.Получить(Сл));
			ИначеЕсли ПпЗакр.Получить(Сл) <> Неопределено Тогда
				Пз.Токены.Добавить("c:" + ПпЗакр.Получить(Сл));
			ИначеЕсли ПпСред.Получить(Сл) <> Неопределено Тогда
				Пз.Токены.Добавить("m:" + ПпСред.Получить(Сл));
			КонецЕсли;
			Продолжить;
		ИначеЕсли Лев(Т_, 1) = "&" Тогда
			Продолжить;
		КонецЕсли;
		К = КодСтроки(Э.Стр, ВСтроке);
		ВСтроке = К.ВСтроке;
		Пз.Код = СокрЛП(К.Код);
		Если Пз.Код <> "" Тогда
			Последний = Пз.Код;
		КонецЕсли;
		Для Каждого Сл Из Слова(К.Код) Цикл
			Если Откр.Получить(Сл) <> Неопределено Тогда
				Пз.Токены.Добавить("o:" + Откр.Получить(Сл));
			ИначеЕсли Закр.Получить(Сл) <> Неопределено Тогда
				Пз.Токены.Добавить("c:" + Закр.Получить(Сл));
			ИначеЕсли Сред_.Получить(Сл) <> Неопределено Тогда
				Пз.Токены.Добавить("m:" + Сред_.Получить(Сл));
			КонецЕсли;
		КонецЦикла;
		Пз.Вставить("ПослеВСтроке", ВСтроке);
	КонецЦикла;
	Возврат Инфо;
КонецФункции

// Структура(Ок, Лево, Право) для вида на отрезке Н..К.
Функция СторонаОк(Инфо, Н, К, ВКонце)
	Стек = Новый Массив;
	Лево = Ложь;
	Право = Ложь;
	Последний = "";
	ВСтроке = Ложь;
	Для Й = Н По К Цикл
		Пз = Инфо[Й];
		Если Не Пз.В Тогда
			Продолжить;
		КонецЕсли;
		Если Пз.Код <> "" Тогда
			Последний = Пз.Код;
		КонецЕсли;
		Если Пз.Свойство("ПослеВСтроке") Тогда
			ВСтроке = Пз.ПослеВСтроке;
		КонецЕсли;
		Для Каждого Ток Из Пз.Токены Цикл
			Вид = Лев(Ток, 1);
			Тип = Сред(Ток, 3);
			Если Вид = "o" Тогда
				Стек.Добавить(Тип);
			ИначеЕсли Вид = "c" Тогда
				Если Стек.Количество() = 0 Тогда
					Лево = Истина;
				ИначеЕсли Стек[Стек.ВГраница()] <> Тип Тогда
					Лево = Истина;
					Право = Истина;
				Иначе
					Стек.Удалить(Стек.ВГраница());
				КонецЕсли;
			Иначе
				Если Стек.Количество() = 0 Тогда
					Лево = Истина;
				ИначеЕсли Стек[Стек.ВГраница()] <> Тип Тогда
					Лево = Истина;
					Право = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Стек.Количество() > 0 Или ВСтроке Тогда
		Право = Истина;
	КонецЕсли;
	Если Последний <> "" И Не ВКонце И Не КонецОператора(Последний) Тогда
		Право = Истина;
	КонецЕсли;
	Возврат Новый Структура("Ок, Лево, Право", Не Лево И Не Право, Лево, Право);
КонецФункции

Функция ДоОк(Инфо, Н)
	Пз = Инфо[Н];
	Если Пз.ДоВСтроке Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Пз.ДоПоследний = "" Или КонецОператора(Пз.ДоПоследний);
КонецФункции

Функция РегионОк(ИнфоБ, ИнфоУ, Н, К, Всего)
	А = СторонаОк(ИнфоБ, Н, К, К = Всего - 1);
	Б = СторонаОк(ИнфоУ, Н, К, К = Всего - 1);
	До = ДоОк(ИнфоБ, Н) И ДоОк(ИнфоУ, Н);
	Возврат Новый Структура("Ок, Лево, Право", А.Ок И Б.Ок И До, А.Лево Или Б.Лево Или Не До, А.Право Или Б.Право);
КонецФункции

// Перехват с фрагментами на границах целых операторов/блоков: Структура(Строки, Изменён) или Неопределено.
Функция Нормализовать(СтрокиТела) Экспорт
	Если Откр = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Т = Разметить(СтрокиТела);
	Всего = Т.Количество();
	ИнфоБ = Подготовить(Т, "D");
	ИнфоУ = Подготовить(Т, "I");
	Регионы = Новый Массив;
	Плохо = Ложь;
	Й = 0;
	Пока Й < Всего Цикл
		Если Т[Й].Тег = "C" Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Н = Й;
		К = Й;
		Пока К + 1 < Всего И Т[К + 1].Тег <> "C" Цикл
			К = К + 1;
		КонецЦикла;
		Й = К + 1;
		Р = РегионОк(ИнфоБ, ИнфоУ, Н, К, Всего);
		Если Р.Ок Тогда
			Регионы.Добавить(Новый Структура("Н, К, Ш", Н, К, Ложь));
			Продолжить;
		КонецЕсли;
		Плохо = Истина;
		Шаг = 1;
		Пока Не Р.Ок Цикл
			Лево = Р.Лево;
			Право = Р.Право;
			Если Не Лево И Не Право Тогда
				Лево = Истина;
				Право = Истина;
			КонецЕсли;
			Сдвиг = Ложь;
			Если Лево И Н > 0 Тогда
				Н = Макс(0, Н - Шаг);
				Сдвиг = Истина;
			КонецЕсли;
			Если Право И К < Всего - 1 Тогда
				К = Мин(Всего - 1, К + Шаг);
				Сдвиг = Истина;
			КонецЕсли;
			Если Не Сдвиг Тогда
				Если Н > 0 Тогда
					Н = Макс(0, Н - Шаг);
				ИначеЕсли К < Всего - 1 Тогда
					К = Мин(Всего - 1, К + Шаг);
				Иначе
					Возврат Неопределено;
				КонецЕсли;
			КонецЕсли;
			Пока Н > 0 И Т[Н - 1].Тег <> "C" Цикл
				Н = Н - 1;
			КонецЦикла;
			Пока К < Всего - 1 И Т[К + 1].Тег <> "C" Цикл
				К = К + 1;
			КонецЦикла;
			Шаг = Шаг * 2;
			Р = РегионОк(ИнфоБ, ИнфоУ, Н, К, Всего);
		КонецЦикла;
		Регионы.Добавить(Новый Структура("Н, К, Ш", Н, К, Истина));
		Если К + 1 > Й Тогда
			Й = К + 1;
		КонецЕсли;
	КонецЦикла;
	Если Не Плохо Тогда
		Возврат Новый Структура("Строки, Изменён", СтрокиТела, Ложь);
	КонецЕсли;
	// слияние пересекающихся (регионы идут по возрастанию Н)
	Сл = Новый Массив;
	Для Каждого Р Из Регионы Цикл
		Если Сл.Количество() > 0 И Р.Н <= Сл[Сл.ВГраница()].К Тогда
			П = Сл[Сл.ВГраница()];
			П.К = Макс(П.К, Р.К);
			П.Ш = П.Ш Или Р.Ш;
			П.Н = Мин(П.Н, Р.Н);
		Иначе
			Сл.Добавить(Новый Структура("Н, К, Ш", Р.Н, Р.К, Р.Ш));
		КонецЕсли;
	КонецЦикла;
	// регион, расширенный влево, мог поглотить предыдущие — повторное слияние
	Сл2 = Новый Массив;
	Для Каждого Р Из Сл Цикл
		Пока Сл2.Количество() > 0 И Р.Н <= Сл2[Сл2.ВГраница()].К Цикл
			П = Сл2[Сл2.ВГраница()];
			Р.Н = Мин(Р.Н, П.Н);
			Р.К = Макс(Р.К, П.К);
			Р.Ш = Истина;
			Сл2.Удалить(Сл2.ВГраница());
		КонецЦикла;
		Сл2.Добавить(Р);
	КонецЦикла;
	Для Каждого Р Из Сл2 Цикл
		Если Р.Ш И Не РегионОк(ИнфоБ, ИнфоУ, Р.Н, Р.К, Всего).Ок Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Вых = Новый Массив;
	Й = 0;
	Для Каждого Р Из Сл2 Цикл
		Пока Й < Р.Н Цикл
			Вых.Добавить(Т[Й].Стр);
			Й = Й + 1;
		КонецЦикла;
		Если Р.Ш Тогда
			Б = Новый Массив;
			У = Новый Массив;
			ЕстьБ = Ложь;
			ЕстьУ = Ложь;
			Для Х = Р.Н По Р.К Цикл
				Если Т[Х].Тег <> "I" Тогда
					Б.Добавить(Т[Х].Стр);
					ЕстьБ = ЕстьБ Или СокрЛП(Т[Х].Стр) <> "";
				КонецЕсли;
				Если Т[Х].Тег <> "D" Тогда
					У.Добавить(Т[Х].Стр);
					ЕстьУ = ЕстьУ Или СокрЛП(Т[Х].Стр) <> "";
				КонецЕсли;
			КонецЦикла;
			Если ЕстьБ Тогда
				Вых.Добавить("#Удаление");
				Для Каждого С Из Б Цикл Вых.Добавить(С); КонецЦикла;
				Вых.Добавить("#КонецУдаления");
			КонецЕсли;
			Если ЕстьУ Тогда
				Вых.Добавить("#Вставка");
				Для Каждого С Из У Цикл Вых.Добавить(С); КонецЦикла;
				Вых.Добавить("#КонецВставки");
			КонецЕсли;
		Иначе
			ОтрисоватьРазметку(Т, Р.Н, Р.К, Вых);
		КонецЕсли;
		Й = Р.К + 1;
	КонецЦикла;
	Пока Й < Всего Цикл
		Вых.Добавить(Т[Й].Стр);
		Й = Й + 1;
	КонецЦикла;
	Возврат Новый Структура("Строки, Изменён", Вых, Истина);
КонецФункции

Процедура ОтрисоватьРазметку(Т, Н, К, Вых)
	Тек = "C";
	Для Х = Н По К Цикл
		Тг = Т[Х].Тег;
		Если Тг <> Тек Тогда
			Если Тек = "I" Тогда Вых.Добавить("#КонецВставки"); КонецЕсли;
			Если Тек = "D" Тогда Вых.Добавить("#КонецУдаления"); КонецЕсли;
			Если Тг = "I" Тогда Вых.Добавить("#Вставка"); КонецЕсли;
			Если Тг = "D" Тогда Вых.Добавить("#Удаление"); КонецЕсли;
			Тек = Тг;
		КонецЕсли;
		Вых.Добавить(Т[Х].Стр);
	КонецЦикла;
	Если Тек = "I" Тогда Вых.Добавить("#КонецВставки"); КонецЕсли;
	Если Тек = "D" Тогда Вых.Добавить("#КонецУдаления"); КонецЕсли;
КонецПроцедуры

// ---------- сравнение вида УП с методом УП ----------

Функция НормСтроки(Строки, СнятьУп)
	Р = Новый Массив;
	ВСтроке = Ложь;
	Рв = Новый РегулярноеВыражение("(?<![\wЁё])уп_");
	Для Каждого С Из Строки Цикл
		Т = СокрЛП(С);
		Если Т = "" Тогда
			Продолжить;
		КонецЕсли;
		Если ВСтроке Или Лев(Т, 1) = "|" Тогда
			ВСтроке = КодСтроки(С, ВСтроке).ВСтроке;
			Н = НРег(Т);
		Иначе
			Если Лев(Т, 2) = "//" Тогда
				Продолжить;
			КонецЕсли;
			Н = НРег(БезКомментария(С));
			ВСтроке = КодСтроки(С, Ложь).ВСтроке;
			Если Н = "" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если СнятьУп Тогда
			Н = Рв.Заменить(Н, "");
		КонецЕсли;
		Р.Добавить(БезПробелов(Н));
	КонецЦикла;
	Возврат СтрСоединить(Р, Символы.ПС);
КонецФункции

Функция БезПробелов(Знач С)
	Возврат СтрЗаменить(СтрЗаменить(С, " ", ""), Символы.Таб, "");
КонецФункции

// Строка без комментария вне литерала, обрезанная.
Функция БезКомментария(Знач С)
	ВСтр = Ложь;
	Для Пз = 1 По СтрДлина(С) Цикл
		Х = Сред(С, Пз, 1);
		Если Х = """" Тогда
			ВСтр = Не ВСтр;
		ИначеЕсли Не ВСтр И Х = "/" И Сред(С, Пз + 1, 1) = "/" Тогда
			Возврат СокрЛП(Лев(С, Пз - 1));
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(С);
КонецФункции

Функция КлючСтроки(С)
	Н = БезПробелов(НРег(БезКомментария(С)));
	Возврат ?(Н = "", "#" + СокрЛП(С), Н);
КонецФункции

// Разметка diff А (БП) → Б (УП): общие строки берутся из А.
Функция Diff(А, Б)
	Ка = Новый Массив; Кб = Новый Массив;
	Для Каждого С Из А Цикл Ка.Добавить(КлючСтроки(С)); КонецЦикла;
	Для Каждого С Из Б Цикл Кб.Добавить(КлючСтроки(С)); КонецЦикла;
	П = 0;
	Пока П < Ка.Количество() И П < Кб.Количество() И Ка[П] = Кб[П] Цикл П = П + 1; КонецЦикла;
	С_ = 0;
	Пока С_ < Ка.Количество() - П И С_ < Кб.Количество() - П И Ка[Ка.ВГраница() - С_] = Кб[Кб.ВГраница() - С_] Цикл С_ = С_ + 1; КонецЦикла;
	Р = Новый Массив;
	Для Й = 0 По П - 1 Цикл Р.Добавить(Новый Структура("Тег, Стр", "C", А[Й])); КонецЦикла;
	Н = Ка.Количество() - П - С_;
	М = Кб.Количество() - П - С_;
	Если Н * М > 1000000 Тогда
		Для Й = П По П + Н - 1 Цикл Р.Добавить(Новый Структура("Тег, Стр", "D", А[Й])); КонецЦикла;
		Для Й = П По П + М - 1 Цикл Р.Добавить(Новый Структура("Тег, Стр", "I", Б[Й])); КонецЦикла;
	Иначе
		// LCS: Д[i][j] — длина для суффиксов
		Д = Новый Массив(Н + 1);
		Для Пз = 0 По Н Цикл
			Стр_ = Новый Массив(М + 1);
			Для Ж = 0 По М Цикл Стр_[Ж] = 0; КонецЦикла;
			Д[Пз] = Стр_;
		КонецЦикла;
		Для Пз_ = 1 По Н Цикл
			Пз = Н - Пз_;
			Для Ж_ = 1 По М Цикл
				Ж = М - Ж_;
				Если Ка[П + Пз] = Кб[П + Ж] Тогда
					Д[Пз][Ж] = Д[Пз + 1][Ж + 1] + 1;
				Иначе
					Д[Пз][Ж] = Макс(Д[Пз + 1][Ж], Д[Пз][Ж + 1]);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Пз = 0; Ж = 0;
		Пока Пз < Н И Ж < М Цикл
			Если Ка[П + Пз] = Кб[П + Ж] Тогда
				Р.Добавить(Новый Структура("Тег, Стр", "C", А[П + Пз])); Пз = Пз + 1; Ж = Ж + 1;
			ИначеЕсли Д[Пз + 1][Ж] >= Д[Пз][Ж + 1] Тогда
				Р.Добавить(Новый Структура("Тег, Стр", "D", А[П + Пз])); Пз = Пз + 1;
			Иначе
				Р.Добавить(Новый Структура("Тег, Стр", "I", Б[П + Ж])); Ж = Ж + 1;
			КонецЕсли;
		КонецЦикла;
		Пока Пз < Н Цикл Р.Добавить(Новый Структура("Тег, Стр", "D", А[П + Пз])); Пз = Пз + 1; КонецЦикла;
		Пока Ж < М Цикл Р.Добавить(Новый Структура("Тег, Стр", "I", Б[П + Ж])); Ж = Ж + 1; КонецЦикла;
	КонецЕсли;
	Для Й = Ка.Количество() - С_ По Ка.ВГраница() Цикл Р.Добавить(Новый Структура("Тег, Стр", "C", А[Й])); КонецЦикла;
	Вых = Новый Массив;
	ОтрисоватьРазметку(Р, 0, Р.ВГраница(), Вых);
	Возврат Вых;
КонецФункции

// Перехват заново по виду БП и телу УП: Массив строк или Неопределено.
Функция Перестроить(СтрокиБп, СтрокиУп) Экспорт
	Если Откр = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Р = Нормализовать(Diff(СтрокиБп, СтрокиУп));
	Возврат ?(Р = Неопределено, Неопределено, Р.Строки);
КонецФункции

// Вызовы X( в теле УП заменяются на УП_X(, если в виде УП перехвата вызывается УП_X(.
Функция ПереименоватьКакВПерехвате(СтрокиУп, ВидУп)
	Имена = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?<![\wЁё.])УП_([\wЁё]+)\s*\(");
	Для Каждого С Из Рв.НайтиСовпадения(СтрСоединить(ВидУп, Символы.ПС)) Цикл
		Имена.Вставить(НРег(С.Группы[1].Значение), Истина);
	КонецЦикла;
	Если Имена.Количество() = 0 Тогда
		Возврат СтрокиУп;
	КонецЕсли;
	Р = Новый Массив;
	Рв2 = Новый РегулярноеВыражение("(?<![\wЁё.])([\wЁё]+)(?=\s*\()");
	Для Каждого С Из СтрокиУп Цикл
		Н = С;
		Совп = Рв2.НайтиСовпадения(С);
		Для Сч = 1 По Совп.Количество() Цикл
			М = Совп[Совп.Количество() - Сч];
			Если Имена.Получить(НРег(М.Значение)) <> Неопределено Тогда
				Н = Лев(Н, М.Индекс) + "УП_" + Сред(Н, М.Индекс + 1);
			КонецЕсли;
		КонецЦикла;
		Р.Добавить(Н);
	КонецЦикла;
	Возврат Р;
КонецФункции

// ---------- модули ----------

Функция Прочитать(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", СтрЗаменить(Т, Символы.ВК, ""));
КонецФункции

Функция ЭтоОбъявление(Стр, Имя = "[\wЁё]+")
	Рв = Новый РегулярноеВыражение("^\s*(Асинх\s+)?(Процедура|Функция)\s+" + Имя + "\s*\(");
	Возврат Рв.Совпадает(Стр);
КонецФункции

Функция ЭтоКонецМетода(Стр)
	// в выгрузке встречается «	КонецФункции» с отступом — внутри метода эти слова невозможны
	Т = НРег(СокрЛ(Стр));
	Возврат СтрНачинаетсяС(Т, "конецпроцедуры") Или СтрНачинаетсяС(Т, "конецфункции");
КонецФункции

// Индекс строки, на которой закрывается список параметров объявления, начиная с Н.
Функция КонецОбъявления(Строки, Н)
	Глуб = 0;
	Для Й = Н По Строки.ВГраница() Цикл
		К = КодСтроки(Строки[Й], Ложь).Код;
		Для Пз = 1 По СтрДлина(К) Цикл
			С = Сред(К, Пз, 1);
			Если С = "(" Тогда
				Глуб = Глуб + 1;
			ИначеЕсли С = ")" Тогда
				Глуб = Глуб - 1;
				Если Глуб = 0 Тогда
					Возврат Й;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Н;
КонецФункции

// Тело метода Имя в тексте модуля УП: Массив строк или Неопределено.
Функция ТелоМетода(Текст, Имя)
	Если Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.ВГраница() Цикл
		Если ЭтоОбъявление(Строки[Й], Имя) Тогда
			К = КонецОбъявления(Строки, Й);
			Р = Новый Массив;
			Для Х = К + 1 По Строки.ВГраница() Цикл
				Если ЭтоКонецМетода(Строки[Х]) Тогда
					Возврат Р;
				КонецЕсли;
				Р.Добавить(Строки[Х]);
			КонецЦикла;
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Обработка модуля расширения. Структура(Текст — новый текст или Неопределено, Итог — счётчики, Тудо — Массив).
Функция ОбработатьМодуль(Текст, ТекстУп, ОтнПуть) Экспорт
	Если Откр = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Итог = Новый Структура("hooks, widened, rebuilt, removed, keptUnchecked", 0, 0, 0, 0, 0);
	Тудо = Новый Массив;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Вых = Новый Массив;
	Изм = Ложь;
	РвА = Новый РегулярноеВыражение("^\s*&ИзменениеИКонтроль\s*\(\s*""([^""]+)""");
	Й = 0;
	Пока Й <= Строки.ВГраница() Цикл
		Совп = РвА.НайтиСовпадения(Строки[Й]);
		Если Совп.Количество() = 0 Тогда
			Вых.Добавить(Строки[Й]);
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Имя = Совп[0].Группы[1].Значение;
		Об = Й + 1;
		Пока Об <= Строки.ВГраница() И Не ЭтоОбъявление(Строки[Об]) Цикл
			Об = Об + 1;
		КонецЦикла;
		Кон = Об + 1;
		Пока Кон <= Строки.ВГраница() И Не ЭтоКонецМетода(Строки[Кон]) Цикл
			Кон = Кон + 1;
		КонецЦикла;
		Если Об > Строки.ВГраница() Или Кон > Строки.ВГраница() Тогда
			Вых.Добавить(Строки[Й]);
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Итог.hooks = Итог.hooks + 1;
		КД = КонецОбъявления(Строки, Об);
		Тело = Новый Массив;
		Для Х = КД + 1 По Кон - 1 Цикл
			Тело.Добавить(Строки[Х]);
		КонецЦикла;
		Т = Разметить(Тело);
		ВидБ = Новый Массив; ВидУ = Новый Массив;
		Для Каждого Э Из Т Цикл
			Если Э.Тег <> "I" Тогда ВидБ.Добавить(Э.Стр); КонецЕсли;
			Если Э.Тег <> "D" Тогда ВидУ.Добавить(Э.Стр); КонецЕсли;
		КонецЦикла;
		ТелоУп = ТелоМетода(ТекстУп, Имя);
		Новое = Неопределено;
		Вид = "";
		Если ТелоУп <> Неопределено И НормСтроки(ВидУ, Истина) <> НормСтроки(ТелоУп, Истина) Тогда
			// имена УП_X — из всего тела перехвата (вид УП мог потерять строку вызова)
			Новое = Перестроить(ВидБ, ПереименоватьКакВПерехвате(ТелоУп, Тело));
			Вид = "rebuilt";
			Если Новое = Неопределено Тогда
				Тудо.Добавить(Новый Структура("module, method, reason", ОтнПуть, Имя,
					"вид УП перехвата не совпадает с методом УП, перестроить по границам операторов/блоков не удалось — перехват убран"));
				Итог.removed = Итог.removed + 1;
				Изм = Истина;
				// директива компиляции перед аннотацией уходит вместе с методом
				Пока Вых.Количество() > 0 И Лев(СокрЛП(Вых[Вых.ВГраница()]), 1) = "&" Цикл
					Вых.Удалить(Вых.ВГраница());
				КонецЦикла;
				// убрать аннотацию и метод вместе с пустой строкой после
				Й = Кон + 1;
				Если Й <= Строки.ВГраница() И СокрЛП(Строки[Й]) = "" Тогда
					Й = Й + 1;
				КонецЕсли;
				Продолжить;
			КонецЕсли;
		Иначе
			Р = Нормализовать(Тело);
			Если Р = Неопределено Тогда
				Тудо.Добавить(Новый Структура("module, method, reason", ОтнПуть, Имя,
					"границы фрагментов не нормализованы (вид УП совпадает с методом УП) — перехват оставлен как есть"));
				Итог.keptUnchecked = Итог.keptUnchecked + 1;
			ИначеЕсли Р.Изменён Тогда
				Новое = Р.Строки;
				Вид = "widened";
			КонецЕсли;
		КонецЕсли;
		Для Х = Й По КД Цикл
			Вых.Добавить(Строки[Х]);
		КонецЦикла;
		Если Новое = Неопределено Тогда
			Для Каждого С Из Тело Цикл Вых.Добавить(С); КонецЦикла;
		Иначе
			Для Каждого С Из Новое Цикл Вых.Добавить(С); КонецЦикла;
			Итог[Вид] = Итог[Вид] + 1;
			Изм = Истина;
		КонецЕсли;
		Вых.Добавить(Строки[Кон]);
		Й = Кон + 1;
	КонецЦикла;
	Возврат Новый Структура("Текст, Итог, Тудо", ?(Изм, СтрСоединить(Вых, Символы.ПС), Неопределено), Итог, Тудо);
КонецФункции

// Код формы в модуле объекта/менеджера расширения (п.3 24.11): новый метод (не перехват), обращающийся к ЭтаФорма,
// который нигде в модуле не вызывается, — это обработчик команды формы, попавший в модуль объекта УП. В модуле объекта
// он не компилируется (ЭтаФорма, реквизиты формы); убирается, причина — в todo.
Функция УбратьКодФормы(Текст, ОтнПуть) Экспорт
	Если Откр = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Тудо = Новый Массив;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	РвИмя = Новый РегулярноеВыражение("^\s*(?:Асинх\s+)?(?:Процедура|Функция)\s+([\wЁё]+)\s*\(");
	// слова кода по строкам (без строк и комментариев)
	СловаСтрок = Новый Массив;
	ВСтроке = Ложь;
	Для Каждого Стр Из Строки Цикл
		К = КодСтроки(Стр, ВСтроке);
		ВСтроке = К.ВСтроке;
		СловаСтрок.Добавить(Слова(К.Код));
	КонецЦикла;
	Удалить = Новый Соответствие;
	Й = 0;
	Пока Й <= Строки.ВГраница() Цикл
		Совп = РвИмя.НайтиСовпадения(Строки[Й]);
		Если Совп.Количество() = 0 Тогда
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Имя = Совп[0].Группы[1].Значение;
		Нач = Й;
		Перехват = Ложь;
		Пока Нач > 0 И Лев(СокрЛП(Строки[Нач - 1]), 1) = "&" Цикл
			Нач = Нач - 1;
			Т = НРег(СокрЛП(Строки[Нач]));
			Если СтрНачинаетсяС(Т, "&перед") Или СтрНачинаетсяС(Т, "&после") Или СтрНачинаетсяС(Т, "&вместо") Или СтрНачинаетсяС(Т, "&изменениеиконтроль") Тогда
				Перехват = Истина;
			КонецЕсли;
		КонецЦикла;
		Кон = Й + 1;
		Пока Кон <= Строки.ВГраница() И Не ЭтоКонецМетода(Строки[Кон]) Цикл
			Кон = Кон + 1;
		КонецЦикла;
		Если Кон > Строки.ВГраница() Тогда
			Прервать;
		КонецЕсли;
		ЕстьФорма = Ложь;
		Если Не Перехват Тогда
			Для Х = Й По Кон Цикл
				Если СловаСтрок[Х].Найти("этаформа") <> Неопределено Тогда
					ЕстьФорма = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ЕстьФорма Тогда
			ИмяН = НРег(Имя);
			Вызов = Ложь;
			Для Х = 0 По СловаСтрок.ВГраница() Цикл
				Если (Х < Й Или Х > Кон) И СловаСтрок[Х].Найти(ИмяН) <> Неопределено Тогда
					Вызов = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Вызов Тогда
				Для Х = Нач По Кон Цикл
					Удалить.Вставить(Х, Истина);
				КонецЦикла;
				Если Кон + 1 <= Строки.ВГраница() И СокрЛП(Строки[Кон + 1]) = "" Тогда
					Удалить.Вставить(Кон + 1, Истина);
				КонецЕсли;
				Тудо.Добавить(Новый Структура("module, method, reason", ОтнПуть, Имя,
					"код формы в модуле объекта (ЭтаФорма), метод нигде не вызывается — не перенесён"));
			КонецЕсли;
		КонецЕсли;
		Й = Кон + 1;
	КонецЦикла;
	Если Удалить.Количество() = 0 Тогда
		Возврат Новый Структура("Текст, Тудо", Неопределено, Тудо);
	КонецЕсли;
	Вых = Новый Массив;
	Для Х = 0 По Строки.ВГраница() Цикл
		Если Удалить.Получить(Х) = Неопределено Тогда
			Вых.Добавить(Строки[Х]);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Текст, Тудо", СтрСоединить(Вых, Символы.ПС), Тудо);
КонецФункции

Функция Применить(КаталогРасш, КореньУп, Лог, КаталогОтчёта = "") Экспорт
	Инициализировать();
	Всего = Новый Структура("modules, hooks, widened, rebuilt, removed, keptUnchecked, formCode", 0, 0, 0, 0, 0, 0, 0);
	Тудо = Новый Массив;
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "*.bsl", Истина) Цикл
		ОтнПуть = СтрЗаменить(Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2), "\", "/");
		Если СтрНайти(ОтнПуть, "/Forms/") > 0 Или СтрНачинаетсяС(ОтнПуть, "CommonForms/") Тогда
			Продолжить;
		КонецЕсли;
		Текст = Прочитать(Ф.ПолноеИмя);
		ТекстИсх = Текст;
		Если (Ф.Имя = "ObjectModule.bsl" Или Ф.Имя = "ManagerModule.bsl") И СтрНайти(НРег(Текст), "этаформа") > 0 Тогда
			Рф = УбратьКодФормы(Текст, ОтнПуть);
			Для Каждого С Из Рф.Тудо Цикл
				Тудо.Добавить(С);
				Всего.formCode = Всего.formCode + 1;
			КонецЦикла;
			Если Рф.Текст <> Неопределено Тогда
				Текст = Рф.Текст;
			КонецЕсли;
		КонецЕсли;
		Если СтрНайти(Текст, "&ИзменениеИКонтроль") = 0 Тогда
			Р = Новый Структура("Текст, Итог, Тудо", Неопределено, Новый Структура, Новый Массив);
		Иначе
			Р = ОбработатьМодуль(Текст, Прочитать(ОбъединитьПути(КореньУп, ОтнПуть)), ОтнПуть);
		КонецЕсли;
		Если Р.Текст = Неопределено И Текст <> ТекстИсх Тогда
			Р.Текст = Текст;
		КонецЕсли;
		Для Каждого КЗ Из Р.Итог Цикл
			Всего[КЗ.Ключ] = Всего[КЗ.Ключ] + КЗ.Значение;
		КонецЦикла;
		Для Каждого С Из Р.Тудо Цикл
			Тудо.Добавить(С);
		КонецЦикла;
		Если Р.Текст <> Неопределено Тогда
			Всего.modules = Всего.modules + 1;
			ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Р.Текст, Символы.ПС, Символы.ВК + Символы.ПС), КодировкаТекста.UTF8, Истина).Записать(Ф.ПолноеИмя);
		КонецЕсли;
	КонецЦикла;
	Если КаталогОтчёта <> "" Тогда
		Csv = Новый Массив;
		Csv.Добавить("Модуль;Метод;Причина");
		Для Каждого С Из Тудо Цикл
			Csv.Добавить(С.module + ";" + С.method + ";" + С.reason);
		КонецЦикла;
		ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Csv, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8, Истина)
			.Записать(ОбъединитьПути(КаталогОтчёта, "todo_hook_fragments.csv"));
	КонецЕсли;
	Лог.Добавить("Фрагменты &ИзменениеИКонтроль: перехватов " + Всего.hooks + ", границы расширены " + Всего.widened
		+ ", перестроено по методу УП " + Всего.rebuilt + ", убрано (todo) " + Всего.removed + ", оставлено без нормализации (todo) "
		+ Всего.keptUnchecked + ", код формы в модуле объекта убран (todo) " + Всего.formCode + "; модулей изменено " + Всего.modules);
	Возврат Всего;
КонецФункции
