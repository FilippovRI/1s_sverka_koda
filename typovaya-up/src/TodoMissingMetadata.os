// Класс 3 CheckModules: реквизиты/ТЧ/значения перечислений БП, которых нет в метаданных УП.
// Отчёт (todo_missing_metadata.md / .csv). Элементы со ссылками из кода добавляет в restored шаг ДобавлениеМетаданныхБп
// (решение 24.11, t744u) — они исключаются по metadata_bp_added.csv.

Перем РвAttr;
Перем РвTs;
Перем РвИмя;
Перем РвEnumVal;
Перем РвCheck;
Перем РвСимвол;

Процедура ИнициализироватьРегексп() Экспорт
	РвAttr = Новый РегулярноеВыражение("(?s)<Attribute\s[^>]*>(.*?)</Attribute>");
	РвTs = Новый РегулярноеВыражение("(?s)<TabularSection\s[^>]*>(.*?)</TabularSection>");
	РвИмя = Новый РегулярноеВыражение("<Properties>\s*<Name>([^<]+)</Name>");
	РвEnumVal = Новый РегулярноеВыражение("(?s)<EnumValue\s[^>]*>(.*?)</EnumValue>");
	РвCheck = Новый РегулярноеВыражение("(?m)^\{([^{}]+?)\((\d+),(\d+)\)\}:[ \t]*([^\r\n]+)");
	РвСимвол = Новый РегулярноеВыражение("(?<![\wЁё.&#~])([А-ЯЁа-яёA-Za-z_][\wЁё]*)(?![\wЁё]|\s*\()");
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Функция НоваяЗапись(Объект, Модуль, Строка, Имя, Вид, Источник, ПапкаОбъекта = "")
	Возврат Новый Структура("object, module, line, name, kind, source, folder", Объект, Модуль, Строка, Имя, Вид, Источник, ПапкаОбъекта);
КонецФункции

Функция ИменаИзXml(Текст) Экспорт
	Р = Новый Структура("attrs, ts", Новый Соответствие, Новый Соответствие);
	Если Текст = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого С Из РвAttr.НайтиСовпадения(Текст) Цикл
		Им = РвИмя.НайтиСовпадения(С.Группы[1].Значение);
		Если Им.Количество() > 0 Тогда
			Р.attrs.Вставить(НРег(Им[0].Группы[1].Значение), Им[0].Группы[1].Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Стд Из СтрРазделить("Description,Code,Ref,DeletionMark,Owner,Parent,LineNumber,Predefined", ",") Цикл
		Р.attrs.Вставить(НРег(Стд), Стд);
	КонецЦикла;
	Для Каждого С Из РвTs.НайтиСовпадения(Текст) Цикл
		ИмТ = РвИмя.НайтиСовпадения(С.Группы[1].Значение);
		Если ИмТ.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмТс = ИмТ[0].Группы[1].Значение;
		Кц = Новый Соответствие;
		Для Каждого А Из РвAttr.НайтиСовпадения(С.Группы[1].Значение) Цикл
			ИмК = РвИмя.НайтиСовпадения(А.Группы[1].Значение);
			Если ИмК.Количество() > 0 Тогда
				Кц.Вставить(НРег(ИмК[0].Группы[1].Значение), ИмК[0].Группы[1].Значение);
			КонецЕсли;
		КонецЦикла;
		Р.ts.Вставить(НРег(ИмТс), Новый Структура("name, cols", ИмТс, Кц));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЗначенияПеречисления(Текст) Экспорт
	Р = Новый Соответствие;
	Если Текст = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого С Из РвEnumVal.НайтиСовпадения(Текст) Цикл
		Им = РвИмя.НайтиСовпадения(С.Группы[1].Значение);
		Если Им.Количество() > 0 Тогда
			Р.Вставить(НРег(Им[0].Группы[1].Значение), Им[0].Группы[1].Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция РазличияМетаданных(КореньУп, КореньБп) Экспорт
	Р = Новый Массив;
	Для Каждого П Из СтрРазделить(
		"Catalog:Catalogs:Справочник,Document:Documents:Документ,Enum:Enums:Перечисление,"
		+ "ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes:ПланВидовХарактеристик,"
		+ "ChartOfAccounts:ChartsOfAccounts:ПланСчетов,DataProcessor:DataProcessors:Обработка,Report:Reports:Отчет,"
		+ "InformationRegister:InformationRegisters:РегистрСведений,AccumulationRegister:AccumulationRegisters:РегистрНакопления,"
		+ "ChartOfCalculationTypes:ChartsOfCalculationTypes:ПланВидовРасчета,AccountingRegister:AccountingRegisters:РегистрБухгалтерии,"
		+ "CalculationRegister:CalculationRegisters:РегистрРасчета,BusinessProcess:BusinessProcesses:БизнесПроцесс,Task:Tasks:Задача,"
		+ "ExchangePlan:ExchangePlans:ПланОбмена", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Пап = Ч[1];
		ТегРу = Ч[2];
		КатУп = ОбъединитьПути(КореньУп, Пап);
		КатБп = ОбъединитьПути(КореньБп, Пап);
		Если Не (Новый Файл(КатБп)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(КатБп, "*.xml", Ложь) Цикл
			Имя = Ф.ИмяБезРасширения;
			ПутьУп = ОбъединитьПути(КатУп, Имя + ".xml");
			Если Не (Новый Файл(ПутьУп)).Существует() Тогда
				Продолжить;
			КонецЕсли;
			ТУ = ИменаИзXml(ПрочитатьТекст(ПутьУп));
			ТБ = ИменаИзXml(ПрочитатьТекст(Ф.ПолноеИмя));
			Объект = ТегРу + "." + Имя;
			Папка = Пап + "\" + Имя;
			Если Ч[0] = "Enum" Тогда
				ЗУ = ЗначенияПеречисления(ПрочитатьТекст(ПутьУп));
				ЗБ = ЗначенияПеречисления(ПрочитатьТекст(Ф.ПолноеИмя));
				Для Каждого КЗ Из ЗБ Цикл
					Если ЗУ.Получить(КЗ.Ключ) = Неопределено Тогда
						Р.Добавить(НоваяЗапись(Объект, "", 0, КЗ.Значение, "значение перечисления", "metadata", Папка));
					КонецЕсли;
				КонецЦикла;
				Продолжить;
			КонецЕсли;
			Для Каждого КЗ Из ТБ.attrs Цикл
				Если ТУ.attrs.Получить(КЗ.Ключ) = Неопределено Тогда
					Р.Добавить(НоваяЗапись(Объект, "", 0, КЗ.Значение, "реквизит", "metadata", Папка));
				КонецЕсли;
			КонецЦикла;
			Для Каждого КТ Из ТБ.ts Цикл
				СтБ = КТ.Значение;
				СтУ = ТУ.ts.Получить(КТ.Ключ);
				Если СтУ = Неопределено Тогда
					Р.Добавить(НоваяЗапись(Объект, "", 0, СтБ.name, "ТЧ", "metadata", Папка));
				Иначе
					Для Каждого Кц Из СтБ.cols Цикл
						Если СтУ.cols.Получить(Кц.Ключ) = Неопределено Тогда
							Р.Добавить(НоваяЗапись(Объект, "", 0, СтБ.name + "." + Кц.Значение, "колонка ТЧ", "metadata", Папка));
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ДополнитьСтрокиBsl(КореньRestored, Записи)
	Доп = Новый Массив;
	Для Каждого З Из Записи Цикл
		Если З.folder = "" Тогда
			Продолжить;
		КонецЕсли;
		ИмНрег = НРег(?(СтрНайти(З.name, ".") > 0, СтрРазделить(З.name, ".")[1], З.name));
		Кат = ОбъединитьПути(КореньRestored, З.folder);
		Если Не (Новый Файл(Кат)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
			Текст = ПрочитатьТекст(Ф.ПолноеИмя);
			Если Текст = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Модуль = ИмяМодуляПоПути(Ф.ПолноеИмя, КореньRestored);
			Строки = СтрРазделить(Текст, Символы.ПС, Истина);
			Для Н = 0 По Строки.ВГраница() Цикл
				Стр = Строки[Н];
				Если СтрНайти(НРег(Стр), ИмНрег) = 0 Тогда
					Продолжить;
				КонецЕсли;
				Нашли = Ложь;
				Для Каждого С Из РвСимвол.НайтиСовпадения(Стр) Цикл
					Если НРег(С.Группы[1].Значение) = ИмНрег Или НРег(С.Группы[1].Значение) = НРег(З.name) Тогда
						Нашли = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если Не Нашли И СтрНайти(Стр, З.name) > 0 Тогда
					Нашли = Истина;
				КонецЕсли;
				Если Нашли Тогда
					Доп.Добавить(НоваяЗапись(З.object, Модуль, Н + 1, З.name, З.kind, З.source, З.folder));
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Д Из Доп Цикл
		Записи.Добавить(Д);
	КонецЦикла;
КонецПроцедуры

Функция ИмяМодуляПоПути(Полный, Корень)
	Отн = Сред(Полный, СтрДлина(Корень) + 2);
	Ч = СтрРазделить(СтрЗаменить(Отн, "\", "/"), "/");
	Если Ч.Количество() < 3 Тогда
		Возврат Отн;
	КонецЕсли;
	Папка = Ч[0];
	Имя = Ч[1];
	ИмяМ = Ч[Ч.Количество() - 1];
	Тег = "Модуль";
	Если ИмяМ = "ObjectModule.bsl" Тогда
		Тег = "МодульОбъекта";
	ИначеЕсли ИмяМ = "ManagerModule.bsl" Тогда
		Тег = "МодульМенеджера";
	ИначеЕсли ИмяМ = "Module.bsl" Тогда
		Тег = "Модуль";
	КонецЕсли;
	Карта = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Catalogs:Справочник,Documents:Документ,CommonModules:ОбщийМодуль,Enums:Перечисление,"
		+ "DataProcessors:Обработка,Reports:Отчет,InformationRegisters:РегистрСведений,AccumulationRegisters:РегистрНакопления,"
		+ "ChartsOfCalculationTypes:ПланВидовРасчета,ChartsOfCharacteristicTypes:ПланВидовХарактеристик,ChartsOfAccounts:ПланСчетов,"
		+ "AccountingRegisters:РегистрБухгалтерии,CalculationRegisters:РегистрРасчета,BusinessProcesses:БизнесПроцесс,Tasks:Задача,"
		+ "ExchangePlans:ПланОбмена", ",") Цикл
		П2 = СтрРазделить(П, ":");
		Карта.Вставить(П2[0], П2[1]);
	КонецЦикла;
	ТегОб = Карта.Получить(Папка);
	Если ТегОб = Неопределено Тогда
		ТегОб = Папка;
	КонецЕсли;
	Возврат ТегОб + "." + Имя + "." + Тег;
КонецФункции

Функция ОшибкиИзCheckModules(Путь)
	Р = Новый Массив;
	Т = ПрочитатьТекст(Путь);
	Если Т = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	РвИм = Новый РегулярноеВыражение("(?i)(?:\(|"")([А-ЯЁа-яёA-Za-z_][\wЁё]*)");
	Для Каждого С Из РвCheck.НайтиСовпадения(Т) Цикл
		Об = СокрЛП(С.Группы[1].Значение);
		Ист = "check_modules";
		Если СтрНайти(Об, " ") > 0 Тогда
			Ч = СтрРазделить(Об, " ", Ложь);
			Если Ч.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Об = Ч[1];
			Ист = "check_modules_extension";
		КонецЕсли;
		Стр = Число(С.Группы[2].Значение);
		Сообщ = СокрЛП(С.Группы[4].Значение);
		Вид = "реквизит";
		Нс = НРег(Сообщ);
		Если СтрНайти(Нс, "перечисл") > 0 Тогда
			Вид = "значение перечисления";
		ИначеЕсли СтрНайти(Нс, "таблич") > 0 Тогда
			Вид = "ТЧ";
		КонецЕсли;
		Имя = "";
		Для Каждого Сов Из РвИм.НайтиСовпадения(Сообщ) Цикл
			Имя = Сов.Группы[1].Значение;
			Если НРег(Имя) <> "не" И НРег(Имя) <> "определена" И НРег(Имя) <> "переменная" Тогда
				Прервать;
			КонецЕсли;
			Имя = "";
		КонецЦикла;
		Если Имя = "" Тогда
			Имя = Лев(Сообщ, 80);
		КонецЕсли;
		Объект = ОбъектИзСтрокиПлатформы(Об);
		Р.Добавить(НоваяЗапись(Объект, Об, Стр, Имя, Вид, Ист, ""));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ОбъектИзСтрокиПлатформы(СтрОб)
	Ч = СтрРазделить(СтрОб, ".");
	Если Ч.Количество() < 2 Тогда
		Возврат СтрОб;
	КонецЕсли;
	Возврат Ч[0] + "." + Ч[1];
КонецФункции

Функция ПримерыКлассов124()
	Р = Новый Массив;
	Р.Добавить(НоваяЗапись("(класс 1)", "ДокументооборотСКОГлобальный", 0, "НСК_ПредупрежденияОЗаявленияхПФРКлиент", "ОМ УП → extension", "manual"));
	Р.Добавить(НоваяЗапись("(класс 1)", "РегламентированнаяОтчетностьКлиентПереопределяемый", 169, "РегламентированнаяОтчетностьНСККлиент", "ссылка на ОМ без точки", "manual"));
	Р.Добавить(НоваяЗапись("(класс 2)", "ОбменДаннымиПереопределяемый", 0, "МенеджерОбменаЧерезУниверсальныйФормат13", "ОМ БП без точки", "manual"));
	Р.Добавить(НоваяЗапись("(класс 4)", "Справочник.БанковскиеСчета", 0, "СуществуютСсылки", "локальный метод / УП_СуществуютСсылки", "manual"));
	Возврат Р;
КонецФункции

Процедура ДобавитьУник(Р, Уник, М)
	Для Каждого З Из М Цикл
		К = З.object + "|" + З.module + "|" + З.line + "|" + З.name + "|" + З.kind;
		Если Уник.Получить(К) = Неопределено Тогда
			Уник.Вставить(К, Истина);
			Р.Добавить(З);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ОбъединитьЗаписи(М1, М2)
	Р = Новый Массив;
	Уник = Новый Соответствие;
	ДобавитьУник(Р, Уник, М1);
	ДобавитьУник(Р, Уник, М2);
	Возврат Р;
КонецФункции

Процедура ЗаписатьОтчеты(Записи, Примеры, ПутьMd, ПутьCsv)
	Группы = Новый Соответствие;
	Для Каждого З Из Записи Цикл
		Если СтрНачинаетсяС(З.object, "(класс") Тогда
			Продолжить;
		КонецЕсли;
		М = Группы.Получить(З.object);
		Если М = Неопределено Тогда
			М = Новый Массив;
			Группы.Вставить(З.object, М);
		КонецЕсли;
		М.Добавить(З);
	КонецЦикла;
	Ключи = Новый Массив;
	Для Каждого КЗ Из Группы Цикл
		Ключи.Добавить(КЗ.Ключ);
	КонецЦикла;
	Для I = 0 По Ключи.ВГраница() - 1 Цикл
		Для J = I + 1 По Ключи.ВГраница() Цикл
			Если Ключи[I] > Ключи[J] Тогда
				В = Ключи[I];
				Ключи[I] = Ключи[J];
				Ключи[J] = В;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Мд = Новый Массив;
	Мд.Добавить("# Отсутствующие в УП реквизиты, ТЧ и значения перечислений (класс 3)");
	Мд.Добавить("");
	Мд.Добавить("Генератор **не** добавляет реквизиты, не заимствует объекты и не строит &ИзменениеИКонтроль/&Вместо.");
	Мд.Добавить("Источники: diff метаданных УП vs БП; `check_modules.txt` (если есть).");
	Мд.Добавить("");
	Мд.Добавить("## Классы 1, 2, 4 (чинит генератор)");
	Для Каждого З Из Примеры Цикл
		Мд.Добавить("- **" + З.object + "**: " + З.module + " — " + З.name + " (" + З.kind + ")");
	КонецЦикла;
	Мд.Добавить("");
	Мд.Добавить("## Класс 3 — по объектам");
	Цсв = Новый Массив;
	Цсв.Добавить("object;module;line;missing_name;kind;source");
	Для Каждого К Из Ключи Цикл
		Мд.Добавить("### " + К);
		Для Каждого З Из Группы[К] Цикл
			Мд.Добавить("- " + ?(З.module = "", "—", З.module) + ", стр. " + ?(З.line = 0, "—", Строка(З.line)) + ": **" + З.name + "** (" + З.kind + ", " + З.source + ")");
			Цсв.Добавить(З.object + ";" + З.module + ";" + З.line + ";" + З.name + ";" + З.kind + ";" + З.source);
		КонецЦикла;
		Мд.Добавить("");
	КонецЦикла;
	Тм = Новый ТекстовыйДокумент;
	Тм.УстановитьТекст(СтрСоединить(Мд, Символы.ПС));
	Тм.Записать(ПутьMd, КодировкаТекста.UTF8);
	Тц = Новый ТекстовыйДокумент;
	Тц.УстановитьТекст(СтрСоединить(Цсв, Символы.ПС));
	Тц.Записать(ПутьCsv, КодировкаТекста.UTF8);
КонецПроцедуры

Функция ЗаписиИзExtensionTodoJson(ПутьJson)
	Р = Новый Массив;
	Если Не (Новый Файл(ПутьJson)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Д = Неопределено;
	Попытка
		Чт = Новый ЧтениеJSON;
		Чт.ОткрытьФайл(ПутьJson);
		Д = ПрочитатьJSON(Чт, Ложь);
		Чт.Закрыть();
	Исключение
		Возврат Р;
	КонецПопытки;
	Если Д = Неопределено Или Не Д.Свойство("items") Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Э Из Д.items Цикл
		Вид = "реквизит";
		Если Э.action = "Удаление" Тогда
			Вид = "diff #Удаление";
		ИначеЕсли Э.action = "Вставка" Тогда
			Вид = "diff #Вставка";
		КонецЕсли;
		Р.Добавить(НоваяЗапись(Э.object, Э.method, Э.line, Э.name, Вид, "extension_wrap", ""));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция БезДобавленных(Записи, ПутьCsv)
	Т = ПрочитатьТекст(ПутьCsv);
	Если Т = Неопределено Тогда
		Возврат Записи;
	КонецЕсли;
	Доб = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(СтрЗаменить(Т, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Ч = СтрРазделить(Стр, ";");
		Если Ч.Количество() >= 4 И Ч[3] = "добавлено" Тогда
			Доб.Вставить(НРег(Ч[0] + ";" + Ч[2]), Истина);
		КонецЕсли;
	КонецЦикла;
	Р = Новый Массив;
	Для Каждого З Из Записи Цикл
		Если Доб.Получить(НРег(З.object + ";" + З.name)) = Неопределено Тогда
			Р.Добавить(З);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция Сформировать(КореньRestored, КореньУп, КореньБп, КаталогВыход, ПутьCheckModules = "", Лог = Неопределено) Экспорт
	ИнициализироватьРегексп();
	Если ПутьCheckModules = "" Тогда
		ПутьCheckModules = "D:\typovaya-up-tmp-check\check_modules.txt";
	КонецЕсли;
	Мет = РазличияМетаданных(КореньУп, КореньБп);
	// добавленные в restored шагом ДобавлениеМетаданныхБп (класс 3 со ссылками из кода) — не todo
	Мет = БезДобавленных(Мет, ОбъединитьПути(КаталогВыход, "metadata_bp_added.csv"));
	ДополнитьСтрокиBsl(КореньRestored, Мет);
	Чм = ОшибкиИзCheckModules(ПутьCheckModules);
	Об = ОбъединитьЗаписи(Мет, Чм);
	ТудуРасш = ЗаписиИзExtensionTodoJson(ОбъединитьПути(КаталогВыход, "extension_bp_attrs_todo.json"));
	Все = ОбъединитьЗаписи(Об, ТудуРасш);
	Прим = ПримерыКлассов124();
	ПутьMd = ОбъединитьПути(КаталогВыход, "todo_missing_metadata.md");
	ПутьCsv = ОбъединитьПути(КаталогВыход, "todo_missing_metadata.csv");
	ЗаписатьОтчеты(Все, Прим, ПутьMd, ПутьCsv);
	Р = Новый Структура("count, md, csv, metadataRows, checkModulesRows, extensionWrapRows",
		Все.Количество(), ПутьMd, ПутьCsv, Мет.Количество(), Чм.Количество(), ТудуРасш.Количество());
	Если Лог <> Неопределено Тогда
		Лог.Добавить("todo_missing_metadata: " + Все.Количество() + " (метаданные " + Мет.Количество()
			+ ", check_modules " + Чм.Количество() + ", extension_wrap " + ТудуРасш.Количество() + ")");
	КонецЕсли;
	Возврат Р;
КонецФункции