// Сценарии Vanessa: список, форма создания, форма открытия.
// Создание пропускается, если кнопки «Создать» нет или она недоступна.
// Окна форм закрываются все сразу, главное окно клиента не закрывается.
// Запись с заполнением только у основных справочников.
// Запись, копирование, ввод на основании и печать в исключениях генератора дыма.

Функция Собрать(КореньРасширения, КаталогВывода, ПутьБазы) Экспорт
	Типы = ТипыМетаданных();
	Списки = Новый Соответствие;
	Приложения = Новый Соответствие;
	Создания = Новый Соответствие;
	Открытия = Новый Соответствие;
	ПоИмени = Новый Массив;
	Исключения = Новый Соответствие;
	Файлы = НайтиФайлы(КореньРасширения, "*.xml", Истина);
	Для Каждого Ф Из Файлы Цикл
		Описание = РазобратьПутьФормы(Ф.ПолноеИмя, КореньРасширения, Типы);
		Если Описание = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьИсключениеЗаписи(Исключения, Описание);
		Если Описание.Список И Описание.ИмяФормы = "ФормаСписка" Тогда
			Списки.Вставить(Описание.ПолноеИмя, Описание.Ссылка);
			Открытия.Вставить(Описание.ПолноеИмя, Описание.Ссылка);
			Если Описание.МожноСоздать И Не СозданиеНедоступно(Описание.ПолноеИмя) Тогда
				Создания.Вставить(Описание.ПолноеИмя, Описание.Ссылка);
			КонецЕсли;
		ИначеЕсли Не Описание.Список И Описание.Основная Тогда
			Приложения.Вставить(Описание.ПолноеИмя, Описание.Ссылка);
		Иначе
			ПоИмени.Добавить(Описание.ПолноеИмяФормы);
		КонецЕсли;
	КонецЦикла;
	СоздатьКаталог(КаталогВывода);
	КаталогИсключений = ОбъединитьПути(КаталогВывода, "исключения");
	СоздатьКаталог(КаталогИсключений);
	ЗаписатьИсключения(КаталогИсключений, Исключения);
	Поля = ПоляЗаписи();
	ТекстФичи = ТекстФичи(ПутьБазы, Списки, Приложения, Создания, Открытия, Поля);
	ЗаписатьТекст(ОбъединитьПути(КаталогВывода, "дымовые_формы.feature"), ТекстФичи);
	ЗаписатьТекст(ОбъединитьПути(КаталогВывода, "формы_по_имени.txt"), СтрСоединить(ПоИмени, Символы.ПС));
	ЗаписатьТекст(ОбъединитьПути(КаталогВывода, "клиент.json"), ТекстКлиента(ПутьБазы));
	ЗаписатьТекст(ОбъединитьПути(КаталогВывода, "VAParams.json"), ТекстПараметров(КаталогВывода, КаталогИсключений));
	Всего = Списки.Количество() + Приложения.Количество() + Создания.Количество() + Открытия.Количество() + Поля.Количество();
	Рез = Новый Структура("сценарии,поИмени,база,создание,открытие,запись", Всего, ПоИмени.Количество(), ПутьБазы, Создания.Количество(), Открытия.Количество(), Поля.Количество());
	Возврат Рез;
КонецФункции

Функция ТипыМетаданных()
	Т = Новый Соответствие;
	Т.Вставить("Catalogs", Новый Структура("Файл,Единственное,Список,МожноСоздать", "Справочники.txt", "Справочник", Истина, Истина));
	Т.Вставить("Documents", Новый Структура("Файл,Единственное,Список,МожноСоздать", "Документы.txt", "Документ", Истина, Истина));
	Т.Вставить("DocumentJournals", Новый Структура("Файл,Единственное,Список,МожноСоздать", "ЖурналыДокументов.txt", "ЖурналДокументов", Истина, Ложь));
	Т.Вставить("InformationRegisters", Новый Структура("Файл,Единственное,Список,МожноСоздать", "РегистрыСведений.txt", "РегистрСведений", Истина, Истина));
	Т.Вставить("AccumulationRegisters", Новый Структура("Файл,Единственное,Список,МожноСоздать", "РегистрыНакопления.txt", "РегистрНакопления", Истина, Ложь));
	Т.Вставить("AccountingRegisters", Новый Структура("Файл,Единственное,Список,МожноСоздать", "РегистрыБухгалтерии.txt", "РегистрБухгалтерии", Истина, Ложь));
	Т.Вставить("CalculationRegisters", Новый Структура("Файл,Единственное,Список,МожноСоздать", "РегистрыРасчета.txt", "РегистрРасчета", Истина, Ложь));
	Т.Вставить("ChartsOfCharacteristicTypes", Новый Структура("Файл,Единственное,Список,МожноСоздать", "ПланыВидовХарактеристик.txt", "ПланВидовХарактеристик", Истина, Истина));
	Т.Вставить("ChartsOfAccounts", Новый Структура("Файл,Единственное,Список,МожноСоздать", "ПланыСчетов.txt", "ПланСчетов", Истина, Истина));
	Т.Вставить("ChartsOfCalculationTypes", Новый Структура("Файл,Единственное,Список,МожноСоздать", "ПланыВидовРасчета.txt", "ПланВидовРасчета", Истина, Истина));
	Т.Вставить("ExchangePlans", Новый Структура("Файл,Единственное,Список,МожноСоздать", "ПланыОбмена.txt", "ПланОбмена", Истина, Истина));
	Т.Вставить("BusinessProcesses", Новый Структура("Файл,Единственное,Список,МожноСоздать", "БизнесПроцессы.txt", "БизнесПроцесс", Истина, Истина));
	Т.Вставить("Tasks", Новый Структура("Файл,Единственное,Список,МожноСоздать", "Задачи.txt", "Задача", Истина, Истина));
	Т.Вставить("DataProcessors", Новый Структура("Файл,Единственное,Список,МожноСоздать", "Обработки.txt", "Обработка", Ложь, Ложь));
	Т.Вставить("Reports", Новый Структура("Файл,Единственное,Список,МожноСоздать", "Отчеты.txt", "Отчет", Ложь, Ложь));
	Т.Вставить("CommonForms", Новый Структура("Файл,Единственное,Список,МожноСоздать", "ОбщиеФормы.txt", "ОбщаяФорма", Ложь, Ложь));
	Возврат Т;
КонецФункции

Функция РазобратьПутьФормы(ПолныйПуть, Корень, Типы)
	Относительный = Сред(ПолныйПуть, СтрДлина(Корень) + 1);
	Относительный = СтрЗаменить(Относительный, "/", "\");
	Если Лев(Относительный, 1) = "\" Тогда
		Относительный = Сред(Относительный, 2);
	КонецЕсли;
	Части = СтрРазделить(Относительный, "\", Ложь);
	Если Части.Количество() < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НРег(Части[2]) <> "forms" Или НРег(Части[3]) = "ext" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НРег(Прав(Части[3], 4)) <> ".xml" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вид = Типы.Получить(Части[0]);
	Если Вид = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяОбъекта = Части[1];
	ИмяФормы = Лев(Части[3], СтрДлина(Части[3]) - 4);
	ПолноеИмя = Вид.Единственное + "." + ИмяОбъекта;
	Рез = Новый Структура;
	Рез.Вставить("ФайлИсключений", Вид.Файл);
	Рез.Вставить("ИмяОбъекта", ИмяОбъекта);
	Рез.Вставить("ИмяФормы", ИмяФормы);
	Рез.Вставить("Список", Вид.Список);
	Рез.Вставить("МожноСоздать", Вид.МожноСоздать);
	Рез.Вставить("ПолноеИмя", ПолноеИмя);
	Рез.Вставить("ПолноеИмяФормы", ПолноеИмя + ".Форма." + ИмяФормы);
	Рез.Вставить("Основная", ИмяФормы = "Форма" Или ИмяФормы = "Основная");
	Если Вид.Список Тогда
		Рез.Вставить("Ссылка", "e1cib/list/" + ПолноеИмя);
	Иначе
		Рез.Вставить("Ссылка", "e1cib/app/" + ПолноеИмя);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Процедура ДобавитьИсключениеЗаписи(Исключения, Описание)
	Набор = Исключения.Получить(Описание.ФайлИсключений);
	Если Набор = Неопределено Тогда
		Набор = Новый Соответствие;
		Исключения.Вставить(Описание.ФайлИсключений, Набор);
	КонецЕсли;
	Набор.Вставить(Описание.ИмяОбъекта + ".Запись", Истина);
	Набор.Вставить(Описание.ИмяОбъекта + ".Копирование", Истина);
	Набор.Вставить(Описание.ИмяОбъекта + ".ВводНаОсновании", Истина);
	Набор.Вставить(Описание.ИмяОбъекта + ".Печать", Истина);
КонецПроцедуры

Процедура ЗаписатьИсключения(Каталог, Исключения)
	Для Каждого Пара Из Исключения Цикл
		Имена = Новый Массив;
		Для Каждого СтрокаИсключения Из Пара.Значение Цикл
			Имена.Добавить(СтрокаИсключения.Ключ);
		КонецЦикла;
		ЗаписатьТекст(ОбъединитьПути(Каталог, Пара.Ключ), СтрСоединить(Имена, Символы.ПС));
	КонецЦикла;
КонецПроцедуры

Функция ПоляЗаписи()
	Р = Новый Соответствие;
	Р.Вставить("Должности", "Наименование=Дым Должности");
	Р.Вставить("Банки", "Код=000000001;Наименование=Дым Банк");
	Р.Вставить("Контрагенты", "Наименование=Дым Контрагент");
	Р.Вставить("Организации", "Наименование=Дым Организация");
	Р.Вставить("ФизическиеЛица", "Фамилия=Дымов;Имя=Тест;Отчество=Проверка");
	Р.Вставить("Валюты", "Код=998;Наименование=Дым;НаименованиеПолное=Дымовая валюта;ФормулаРасчетаКурса=1");
	Р.Вставить("Номенклатура", "Наименование=Дым Номенклатура");
	Р.Вставить("ПодразделенияОрганизаций", "Наименование=Дым Подразделение");
	Р.Вставить("Сотрудники", "Наименование=Дым Сотрудник");
	Р.Вставить("БанковскиеСчета", "НомерСчета=40702810900000000001");
	Возврат Р;
КонецФункции

Функция ПорядокЗаписи()
	Возврат СтрРазделить("Должности,Банки,Контрагенты,Организации,ФизическиеЛица,Валюты,Номенклатура,ПодразделенияОрганизаций,Сотрудники,БанковскиеСчета", ",", Ложь);
КонецФункции

Функция ТекстФичи(ПутьБазы, Списки, Приложения, Создания, Открытия, Поля)
	Строки = Новый Массив;
	Строки.Добавить("# language: ru");
	Строки.Добавить("# База клиента тестирования: " + ПутьБазы);
	Строки.Добавить("# Менеджер и клиент тестирования после прогона не закрываются.");
	Строки.Добавить("");
	Строки.Добавить("@tree");
	Строки.Добавить("@дымовые_формы");
	Строки.Добавить("");
	Строки.Добавить("Функционал: Дымовое открытие форм расширения");
	Строки.Добавить("");
	ДобавитьПодключение(Строки, ПутьБазы);
	ДобавитьСценарии(Строки, Списки, "Список");
	ДобавитьСценарии(Строки, Приложения, "Основная форма");
	ДобавитьСценарииФормы(Строки, Создания, "Создание", Истина);
	ДобавитьСценарииФормы(Строки, Открытия, "Открытие", Ложь);
	ДобавитьСценарииЗаписи(Строки, Поля);
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Процедура ДобавитьПодключение(Строки, ПутьБазы)
	Строки.Добавить("Сценарий: Подключение клиента тестирования");
	Строки.Добавить(Символы.Таб + "Когда Я подключаю клиент тестирования с параметрами:");
	Строки.Добавить(Символы.Таб + Символы.Таб + "| 'Имя подключения' | 'Имя компьютера' | 'Порт' | 'Строка соединения' | 'Тип клиента' | 'Дополнительные параметры строки запуска' |");
	Строки.Добавить(Символы.Таб + Символы.Таб + "| 'Этот клиент' | 'localhost' | '48000' | 'File=""" + ПутьБазы + """;' | 'Тонкий' | '/AllowExecuteScheduledJobs -Off /DisableStartupMessages' |");
	Строки.Добавить(Символы.Таб + "И я закрываю все окна клиентского приложения");
	Строки.Добавить("");
КонецПроцедуры

Процедура ДобавитьЗакрытиеОкон(Строки)
	Строки.Добавить(Символы.Таб + "И я закрываю все окна клиентского приложения");
КонецПроцедуры

Функция СозданиеНедоступно(ПолноеИмя)
	// Кнопка «Создать» есть, но недоступна: условие «поле существует» её не отсекает.
	Если ПолноеИмя = "Справочник.ШаблоныАнкет" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ПолноеИмя = "РегистрСведений.ГражданствоФизическихЛиц" Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Процедура ДобавитьСценарии(Строки, СоответствиеСсылок, ВидСценария)
	Ключи = КлючиСоответствия(СоответствиеСсылок);
	Для Каждого Ключ Из Ключи Цикл
		Строки.Добавить("Сценарий: " + ВидСценария + " " + Ключ);
		Строки.Добавить(Символы.Таб + "Дано Я открываю навигационную ссылку """ + СоответствиеСсылок.Получить(Ключ) + """");
		ДобавитьЗакрытиеОкон(Строки);
		Строки.Добавить("");
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСценарииФормы(Строки, СоответствиеСсылок, ВидСценария, ЭтоСоздание)
	Ключи = КлючиСоответствия(СоответствиеСсылок);
	Для Каждого Ключ Из Ключи Цикл
		Строки.Добавить("Сценарий: " + ВидСценария + " " + Ключ);
		Строки.Добавить(Символы.Таб + "Дано Я открываю навигационную ссылку """ + СоответствиеСсылок.Получить(Ключ) + """");
		Если ЭтоСоздание Тогда
			Строки.Добавить(Символы.Таб + "Если поле ""Создать"" существует тогда");
			Строки.Добавить(Символы.Таб + Символы.Таб + "И я нажимаю на кнопку ""Создать""");
			Строки.Добавить(Символы.Таб + "КонецЕсли");
		Иначе
			Строки.Добавить(Символы.Таб + "И в таблице ""Список"" я перехожу к первой строке");
			Строки.Добавить(Символы.Таб + "И в таблице ""Список"" я выбираю текущую строку");
		КонецЕсли;
		ДобавитьЗакрытиеОкон(Строки);
		Строки.Добавить("");
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСценарииЗаписи(Строки, Поля)
	Для Каждого ИмяОбъекта Из ПорядокЗаписи() Цикл
		ТекстПолей = Поля.Получить(ИмяОбъекта);
		Если ТекстПолей = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить("Сценарий: Запись Справочник." + ИмяОбъекта);
		Строки.Добавить(Символы.Таб + "Дано Я открываю навигационную ссылку ""e1cib/list/Справочник." + ИмяОбъекта + """");
		Строки.Добавить(Символы.Таб + "И я нажимаю на кнопку ""Создать""");
		Для Каждого Часть Из СтрРазделить(ТекстПолей, ";", Ложь) Цикл
			Поз = СтрНайти(Часть, "=");
			ИмяПоля = Лев(Часть, Поз - 1);
			ЗначениеПоля = Сред(Часть, Поз + 1);
			Строки.Добавить(Символы.Таб + "И в поле с именем '" + ИмяПоля + "' я ввожу текст """ + ЗначениеПоля + """");
		КонецЦикла;
		Строки.Добавить(Символы.Таб + "И я нажимаю на кнопку с именем 'ФормаЗаписать'");
		ДобавитьЗакрытиеОкон(Строки);
		Строки.Добавить(Символы.Таб + "И я открываю навигационную ссылку ""e1cib/list/Справочник." + ИмяОбъекта + """");
		Строки.Добавить(Символы.Таб + "И в таблице ""Список"" я перехожу к первой строке");
		Строки.Добавить(Символы.Таб + "И в таблице ""Список"" я выбираю текущую строку");
		ДобавитьЗакрытиеОкон(Строки);
		Строки.Добавить("");
	КонецЦикла;
КонецПроцедуры

Функция КлючиСоответствия(СоответствиеСсылок)
	Ключи = Новый Массив;
	Для Каждого Пара Из СоответствиеСсылок Цикл
		Ключи.Добавить(Пара.Ключ);
	КонецЦикла;
	Возврат Ключи;
КонецФункции

Функция ТекстКлиента(ПутьБазы)
	Экранированный = СтрЗаменить(ПутьБазы, "\", "\\");
	Возврат "{" + Символы.ПС
		+ "  ""Имя"": ""УП""," + Символы.ПС
		+ "  ""СтрокаСоединения"": ""File=\""" + Экранированный + "\"";""" + Символы.ПС
		+ "}" + Символы.ПС;
КонецФункции

Функция ТекстПараметров(КаталогВывода, КаталогИсключений)
	Вывод = СтрЗаменить(КаталогВывода, "\", "\\");
	Искл = СтрЗаменить(КаталогИсключений, "\", "\\");
	Возврат "{" + Символы.ПС
		+ "  ""ДымовыеТестыКаталогВыходныхФайлов"": """ + Вывод + """," + Символы.ПС
		+ "  ""ДымовыеТестыКаталогФайловИсключений"": """ + Искл + """," + Символы.ПС
		+ "  ""ДымовыеТестыОчищатьКаталогВыходныхФайлов"": false" + Символы.ПС
		+ "}" + Символы.ПС;
КонецФункции

Процедура ЗаписатьТекст(Путь, ТекстЛФ)
	Ф = Новый Файл(Путь);
	Если Ф.Путь <> "" И Не (Новый Файл(Ф.Путь)).Существует() Тогда
		СоздатьКаталог(Ф.Путь);
	КонецЕсли;
	Текст = СтрЗаменить(ТекстЛФ, Символы.ПС, Символы.ВК + Символы.ПС);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры
