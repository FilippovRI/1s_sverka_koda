// Validator-only: каталог скелета расширения от пользователя (ibcmd export). Не вызывает ibcmd/1С.

Перем URI_XR;
Перем URI_LOGFORM;

Процедура Инициализировать()
	URI_XR = "http://v8.1c.ru/8.3/xcf/readable";
	URI_LOGFORM = "http://v8.1c.ru/8.3/xcf/logform";
КонецПроцедуры

Функция ПроверитьКаталогСкелета(Каталог) Экспорт
	Инициализировать();
	Р = Новый Структура("ОК, Причина, containedCount, objectIds, classIds, configDumpPresent, disclaimer",
		Ложь, "", 0, Новый Массив, Новый Массив, Ложь,
		"Структурная проверка; происхождение из ИБ/ibcmd не доказана.");
	Если СокрЛП(Каталог) = "" Или Не (Новый Файл(Каталог)).Существует() Тогда
		Р.Причина = "каталог скелета не найден — передайте выгрузку, полученную пользователем";
		Возврат Р;
	КонецЕсли;
	ПутьCfg = ОбъединитьПути(Каталог, "Configuration.xml");
	Если Не (Новый Файл(ПутьCfg)).Существует() Тогда
		Р.Причина = "нет Configuration.xml";
		Возврат Р;
	КонецЕсли;
	Разбор = РазобратьConfigurationXml(ПутьCfg);
	Если Не Разбор.ОК Тогда
		Р.Причина = Разбор.Причина;
		Возврат Р;
	КонецЕсли;
	Р.containedCount = Разбор.containedCount;
	Р.objectIds = Разбор.objectIds;
	Р.classIds = Разбор.classIds;
	ПутьDump = ОбъединитьПути(Каталог, "ConfigDumpInfo.xml");
	Если (Новый Файл(ПутьDump)).Существует() Тогда
		Р.configDumpPresent = Истина;
		Пд = ПроверитьConfigDumpInfo(ПутьDump);
		Если Не Пд.ОК Тогда
			Р.Причина = Пд.Причина;
			Возврат Р;
		КонецЕсли;
	КонецЕсли;
	Р.ОК = Истина;
	Р.Причина = "структура принята; ObjectId=" + Р.objectIds.Количество();
	Возврат Р;
КонецФункции

Функция РазобратьConfigurationXml(Путь)
	Р = Новый Структура("ОК, Причина, containedCount, objectIds, classIds", Ложь, "", 0, Новый Массив, Новый Массив);
	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(Путь);
		ГлубинаInternal = 0;
		ГлубинаContained = 0;
		СчетContained = 0;
		ЖдемObjectId = Ложь;
		ЖдемClassId = Ложь;
		БлокClass = Ложь;
		БлокObject = Ложь;
		ВнеInternal = 0;
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Если Чтение.ЛокальноеИмя = "InternalInfo" Тогда
					ГлубинаInternal = ГлубинаInternal + 1;
				ИначеЕсли ЭтоЭлементXr(Чтение, "ContainedObject") Тогда
					Если ГлубинаInternal = 0 Тогда
						ВнеInternal = ВнеInternal + 1;
					Иначе
						СчетContained = СчетContained + 1;
						ГлубинаContained = ГлубинаContained + 1;
						БлокClass = Ложь;
						БлокObject = Ложь;
						ЖдемObjectId = Ложь;
						ЖдемClassId = Ложь;
					КонецЕсли;
				ИначеЕсли ГлубинаContained > 0 И ЭтоЭлементXr(Чтение, "ObjectId") Тогда
					ЖдемObjectId = Истина;
				ИначеЕсли ГлубинаContained > 0 И ЭтоЭлементXr(Чтение, "ClassId") Тогда
					ЖдемClassId = Истина;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				Если Чтение.ЛокальноеИмя = "InternalInfo" Тогда
					ГлубинаInternal = ГлубинаInternal - 1;
					Если ГлубинаInternal < 0 Тогда
						ГлубинаInternal = 0;
					КонецЕсли;
				ИначеЕсли ЭтоЛокальноеИмя(Чтение, "ContainedObject") Тогда
					Если ГлубинаContained > 0 Тогда
						Если Не БлокClass Или Не БлокObject Тогда
							Р.Причина = "ContainedObject без пары ClassId+ObjectId";
							Чтение.Закрыть();
							Возврат Р;
						КонецЕсли;
						ГлубинаContained = ГлубинаContained - 1;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Зн = СокрЛП(Чтение.Значение);
				Если ЖдемObjectId Тогда
					Если Не ВалидныйUuid(Зн) Тогда
						Р.Причина = "некорректный xr:ObjectId: " + Зн;
						Чтение.Закрыть();
						Возврат Р;
					КонецЕсли;
					Если Р.objectIds.Найти(НРег(Зн)) <> Неопределено Тогда
						Р.Причина = "дубликат xr:ObjectId: " + Зн;
						Чтение.Закрыть();
						Возврат Р;
					КонецЕсли;
					Р.objectIds.Добавить(НРег(Зн));
					БлокObject = Истина;
					ЖдемObjectId = Ложь;
				ИначеЕсли ЖдемClassId Тогда
					Если Не ВалидныйUuid(Зн) Тогда
						Р.Причина = "некорректный xr:ClassId: " + Зн;
						Чтение.Закрыть();
						Возврат Р;
					КонецЕсли;
					Р.classIds.Добавить(НРег(Зн));
					БлокClass = Истина;
					ЖдемClassId = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		Р.Причина = "ошибка XML: " + ОписаниеОшибки();
		Возврат Р;
	КонецПопытки;
	Если ВнеInternal > 0 Тогда
		Р.Причина = "ContainedObject вне InternalInfo: " + ВнеInternal;
		Возврат Р;
	КонецЕсли;
	Р.containedCount = СчетContained;
	Если Р.containedCount <> Р.objectIds.Количество() Тогда
		Р.Причина = "ContainedObject=" + Р.containedCount + ", ObjectId=" + Р.objectIds.Количество();
		Возврат Р;
	КонецЕсли;
	Если Р.containedCount = 0 Тогда
		Р.Причина = "нет xr:ContainedObject в InternalInfo (namespace " + URI_XR + ")";
		Возврат Р;
	КонецЕсли;
	Если Р.containedCount <> Р.classIds.Количество() Тогда
		Р.Причина = "число ClassId и ObjectId не совпадает";
		Возврат Р;
	КонецЕсли;
	Р.ОК = Истина;
	Возврат Р;
КонецФункции

Функция ЭтоЭлементXr(Чтение, Локальное)
	Возврат Чтение.ЛокальноеИмя = Локальное И Чтение.URIПространстваИмен = URI_XR;
КонецФункции

Функция ЭтоЛокальноеИмя(Чтение, Локальное)
	Возврат Чтение.ЛокальноеИмя = Локальное;
КонецФункции

Функция ВалидныйUuid(С)
	С = НРег(СокрЛП(С));
	Если СтрДлина(С) <> 36 Тогда
		Возврат Ложь;
	КонецЕсли;
	Шаблон = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx";
	Для П = 1 По 36 Цикл
		Сим = Сред(С, П, 1);
		Ж = Сред(Шаблон, П, 1);
		Если Ж = "-" Тогда
			Если Сим <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Если СтрНайти("0123456789abcdef", Сим) = 0 Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПроверитьConfigDumpInfo(Путь)
	Р = Новый Структура("ОК, Причина", Ложь, "");
	Попытка
		Ч = Новый ЧтениеXML;
		Ч.ОткрытьФайл(Путь);
		ЕстьКорень = Ложь;
		ЕстьМетаданные = Ложь;
		Пока Ч.Прочитать() Цикл
			Если Ч.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				Если Ч.ЛокальноеИмя = "ConfigDumpInfo" Тогда
					ЕстьКорень = Истина;
				ИначеЕсли Ч.ЛокальноеИмя = "Metadata" Или Ч.ЛокальноеИмя = "ConfigVersions" Тогда
					ЕстьМетаданные = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Ч.Закрыть();
		Если Не ЕстьКорень Тогда
			Р.Причина = "ConfigDumpInfo.xml: корневой элемент не ConfigDumpInfo";
			Возврат Р;
		КонецЕсли;
		Если Не ЕстьМетаданные Тогда
			Р.Причина = "ConfigDumpInfo.xml: нет Metadata/ConfigVersions";
			Возврат Р;
		КонецЕсли;
	Исключение
		Р.Причина = "ConfigDumpInfo.xml: " + ОписаниеОшибки();
		Возврат Р;
	КонецПопытки;
	Р.ОК = Истина;
	Возврат Р;
КонецФункции

Функция ЗаписатьОтчетВалидации(Результат, КаталогВыход) Экспорт
	СоздатьКаталог(КаталогВыход);
	Путь = ОбъединитьПути(КаталогВыход, "skeleton_validation.json");
	Тело = "{""ok"":" + ?(Результат.ОК, "true", "false")
		+ ",""reason"":""" + ЭкранJson(Результат.Причина) + """"
		+ ",""containedCount"":" + Результат.containedCount
		+ ",""disclaimer"":""" + ЭкранJson(Результат.disclaimer) + """"
		+ ",""objectIds"":" + МассивВJson(Результат.objectIds) + "}";
	ЗаписатьТекст(Путь, Тело);
	Возврат Путь;
КонецФункции

Функция ЭкранJson(С)
	С = СтрЗаменить(С, "\", "\\");
	С = СтрЗаменить(С, """", "\""");
	Возврат С;
КонецФункции

Функция МассивВJson(М)
	Ч = Новый Массив;
	Для Каждого Э Из М Цикл
		Ч.Добавить("""" + Э + """");
	КонецЦикла;
	Возврат "[" + СтрСоединить(Ч, ",") + "]";
КонецФункции

Функция ПрочитатьТекст(П)
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(П, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Процедура ЗаписатьТекст(П, Текст)
	Тд = Новый ТекстовыйДокумент;
	Тд.УстановитьТекст(Текст);
	Тд.Записать(П, КодировкаТекста.UTF8);
КонецПроцедуры
