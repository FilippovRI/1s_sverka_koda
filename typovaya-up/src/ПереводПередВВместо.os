// Перевод хуков &Перед с безусловным Возврат (отключение типового метода) в &Вместо
// без ПродолжитьВызов. Условный Возврат внутри Если не меняется — только в отчёт «проверить».

Перем Разбор;
Перем Синтез;

Процедура Инициализировать(МодульРазбора, МодульСинтеза) Экспорт
	Разбор = МодульРазбора;
	Синтез = МодульСинтеза;
КонецПроцедуры

Функция Применить(КаталогРасш, КаталогОтчёта = "", Лог = Неопределено) Экспорт
	Отчёт = Новый Структура("ok, reason, converted, check, rewrittenFiles, reportPath",
		Ложь, "", Новый Массив, Новый Массив, 0, "");
	Если Не (Новый Файл(КаталогРасш)).Существует() Тогда
		Отчёт.reason = "нет каталога расширения";
		Возврат Отчёт;
	КонецЕсли;
	Файлы = НайтиФайлы(КаталогРасш, "*.bsl", Истина);
	Для Каждого Ф Из Файлы Цикл
		Р = ОбработатьФайл(Ф.ПолноеИмя, КаталогРасш);
		Для Каждого Э Из Р.converted Цикл
			Отчёт.converted.Добавить(Э);
		КонецЦикла;
		Для Каждого Э Из Р.check Цикл
			Отчёт.check.Добавить(Э);
		КонецЦикла;
		Если Р.changed Тогда
			Отчёт.rewrittenFiles = Отчёт.rewrittenFiles + 1;
		КонецЕсли;
	КонецЦикла;
	Отчёт.ok = Истина;
	Если КаталогОтчёта <> "" Тогда
		СоздатьКаталог(КаталогОтчёта);
		Отчёт.reportPath = ЗаписатьОтчёт(КаталогОтчёта, Отчёт);
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("ПереводПередВВместо: переведено " + Отчёт.converted.Количество()
			+ ", проверить " + Отчёт.check.Количество()
			+ ", файлов " + Отчёт.rewrittenFiles);
	КонецЕсли;
	Возврат Отчёт;
КонецФункции

Функция ОбработатьФайл(Путь, КаталогРасш)
	Р = Новый Структура("converted, check, changed", Новый Массив, Новый Массив, Ложь);
	Сырой = ПрочитатьСБом(Путь);
	Текст = Сырой.Текст;
	Разобр = Разбор.РазобратьМодуль(Текст);
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	НЛ = ?(СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Для Каждого Мт Из Разобр.Методы Цикл
		Дир = ДирективаХука(Мт.Текст);
		Если Дир.Вид <> "Перед" Тогда
			Продолжить;
		КонецЕсли;
		Тело = Разбор.ИзвлечьТелоМетода(Мт.Текст);
		Класс = Синтез.КлассВозвратаВТеле(Тело);
		Ключ = КлючМетода(КаталогРасш, Путь, Дир.ИмяТипового);
		Если Класс = "conditional" Тогда
			Р.check.Добавить(Ключ);
			Продолжить;
		КонецЕсли;
		Если Класс <> "unconditional" Тогда
			Продолжить;
		КонецЕсли;
		// заменить &Перед( на &Вместо( только в строках этого метода
		Для Й = Мт.Начало - 1 По Мин(Мт.Конец - 1, Строки.ВГраница()) Цикл
			Если СтрНайти(Строки[Й], "&Перед(") > 0 Или СтрНайти(Строки[Й], "&перед(") > 0 Тогда
				Строки[Й] = СтрЗаменить(Строки[Й], "&Перед(", "&Вместо(");
				Строки[Й] = СтрЗаменить(Строки[Й], "&перед(", "&Вместо(");
			КонецЕсли;
		КонецЦикла;
		Если Мт.Вид = "Функция" Тогда
			ТелоНов = Синтез.НормализоватьВозвратФункции(Тело, Истина);
			Если ТелоНов <> Тело Тогда
				ПодменитьТело(Строки, Мт, Тело, ТелоНов);
			КонецЕсли;
		КонецЕсли;
		Р.converted.Добавить(Ключ);
		Р.changed = Истина;
	КонецЦикла;
	Если Р.changed Тогда
		ЗаписатьСБом(Путь, СтрСоединить(Строки, НЛ), Сырой.BOM);
	КонецЕсли;
	Возврат Р;
КонецФункции

Функция ДирективаХука(ТекстМетода)
	Р = Новый Структура("Вид, ИмяТипового", "", "");
	Для Каждого Стр Из СтрРазделить(ТекстМетода, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Н = НРег(С);
		Если СтрНачинаетсяС(Н, "&перед(") Тогда
			Р.Вид = "Перед";
			Р.ИмяТипового = ИмяИзДирективы(С);
			Возврат Р;
		ИначеЕсли СтрНачинаетсяС(Н, "&вместо(") Тогда
			Р.Вид = "Вместо";
			Р.ИмяТипового = ИмяИзДирективы(С);
			Возврат Р;
		ИначеЕсли СтрНачинаетсяС(Н, "&после(") Тогда
			Р.Вид = "После";
			Р.ИмяТипового = ИмяИзДирективы(С);
			Возврат Р;
		ИначеЕсли СтрНачинаетсяС(Н, "&изменениеиконтроль(") Тогда
			Р.Вид = "ИзменениеИКонтроль";
			Р.ИмяТипового = ИмяИзДирективы(С);
			Возврат Р;
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ИмяИзДирективы(Стр)
	Поз = СтрНайти(Стр, "(");
	Если Поз = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хв = Сред(Стр, Поз + 1);
	Хв = СтрЗаменить(Хв, ")", "");
	Хв = СтрЗаменить(Хв, """", "");
	Возврат СокрЛП(Хв);
КонецФункции

Процедура ПодменитьТело(Строки, Мт, ТелоСтарое, ТелоНовое)
	Старые = СтрРазделить(ТелоСтарое, Символы.ПС, Истина);
	Новые = СтрРазделить(ТелоНовое, Символы.ПС, Истина);
	Если Старые.Количество() <> Новые.Количество() Тогда
		Возврат;
	КонецЕсли;
	// ищем первое совпадение тела в диапазоне метода
	НачПоиска = Мт.Начало - 1;
	КонПоиска = Мт.Конец - 1;
	Для Й = НачПоиска По КонПоиска Цикл
		Если Й + Старые.Количество() - 1 > КонПоиска Тогда
			Прервать;
		КонецЕсли;
		Совп = Истина;
		Для К = 0 По Старые.ВГраница() Цикл
			Если Строки[Й + К] <> Старые[К] Тогда
				Совп = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Совп Тогда
			Для К = 0 По Новые.ВГраница() Цикл
				Строки[Й + К] = Новые[К];
			КонецЦикла;
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция КлючМетода(КаталогРасш, Путь, ИмяТипового)
	Норм = СтрЗаменить(Путь, "/", "\");
	Маркеры = "CommonModules,Catalogs,Documents,InformationRegisters,AccumulationRegisters,AccountingRegisters,CalculationRegisters,DataProcessors,Reports,Enums,ChartsOfCharacteristicTypes,ChartsOfAccounts,ChartsOfCalculationTypes,BusinessProcesses,Tasks,ExchangePlans,DocumentJournals,Constants,CommonForms,CommonCommands";
	ПозНай = 0;
	ИмяМаркера = "";
	Для Каждого М Из СтрРазделить(Маркеры, ",") Цикл
		Игл = "\" + М + "\";
		Поз = СтрНайти(Норм, Игл);
		Если Поз = 0 Тогда
			Поз = СтрНайти(Норм, "\" + НРег(М) + "\");
		КонецЕсли;
		Если Поз > 0 И (ПозНай = 0 Или Поз < ПозНай) Тогда
			ПозНай = Поз;
			ИмяМаркера = М;
		КонецЕсли;
	КонецЦикла;
	Если ПозНай = 0 Тогда
		Возврат ИмяТипового;
	КонецЕсли;
	Ост = Сред(Норм, ПозНай + 1); // с имени папки
	Части = СтрРазделить(Ост, "\");
	Если Части.Количество() < 2 Тогда
		Возврат ИмяТипового;
	КонецЕсли;
	Папка = Части[0];
	ИмяОб = Части[1];
	Рус = РусскийКласс(Папка);
	Если НРег(Папка) = "commonmodules" Тогда
		Модуль = ИмяОб;
	ИначеЕсли Рус <> "" Тогда
		Модуль = Рус + "." + ИмяОб;
		Для Й = 0 По Части.ВГраница() Цикл
			Если НРег(Части[Й]) = "forms" И Й + 1 <= Части.ВГраница() Тогда
				Модуль = Модуль + ".Форма." + Части[Й + 1];
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Модуль = ИмяОб;
	КонецЕсли;
	Возврат Модуль + "." + ИмяТипового;
КонецФункции

Функция РусскийКласс(Папка)
	Н = НРег(Папка);
	Если Н = "catalogs" Тогда Возврат "Справочники";
	ИначеЕсли Н = "documents" Тогда Возврат "Документы";
	ИначеЕсли Н = "informationregisters" Тогда Возврат "РегистрыСведений";
	ИначеЕсли Н = "accumulationregisters" Тогда Возврат "РегистрыНакопления";
	ИначеЕсли Н = "accountingregisters" Тогда Возврат "РегистрыБухгалтерии";
	ИначеЕсли Н = "calculationregisters" Тогда Возврат "РегистрыРасчета";
	ИначеЕсли Н = "dataprocessors" Тогда Возврат "Обработки";
	ИначеЕсли Н = "reports" Тогда Возврат "Отчеты";
	ИначеЕсли Н = "enums" Тогда Возврат "Перечисления";
	ИначеЕсли Н = "chartsOfcharacteristictypes" Или Н = "chartsofcharacteristictypes" Тогда Возврат "ПланыВидовХарактеристик";
	ИначеЕсли Н = "chartsofaccounts" Тогда Возврат "ПланыСчетов";
	ИначеЕсли Н = "chartsofcalculationtypes" Тогда Возврат "ПланыВидовРасчета";
	ИначеЕсли Н = "businessprocesses" Тогда Возврат "БизнесПроцессы";
	ИначеЕсли Н = "tasks" Тогда Возврат "Задачи";
	ИначеЕсли Н = "exchangeplans" Тогда Возврат "ПланыОбмена";
	ИначеЕсли Н = "documentjournals" Тогда Возврат "ЖурналыДокументов";
	ИначеЕсли Н = "constants" Тогда Возврат "Константы";
	ИначеЕсли Н = "commonforms" Тогда Возврат "ОбщиеФормы";
	ИначеЕсли Н = "commoncommands" Тогда Возврат "ОбщиеКоманды";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ПрочитатьСБом(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Ч.Прочитать();
	Ч.Закрыть();
	Возврат Новый Структура("Текст, BOM", ?(Текст = Неопределено, "", Текст), Истина);
КонецФункции

Процедура ЗаписатьСБом(Путь, Текст, ЕстьБом)
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, ЕстьБом = Истина).Записать(Путь);
КонецПроцедуры

Функция ЗаписатьОтчёт(КаталогОтчёта, Отчёт)
	// json
	Стр = "{""converted"":" + XMLСтрока(Отчёт.converted.Количество())
		+ ",""check"":" + XMLСтрока(Отчёт.check.Количество())
		+ ",""items"":[";
	Перв = Истина;
	Для Каждого Имя Из Отчёт.converted Цикл
		Если Не Перв Тогда Стр = Стр + ","; КонецЕсли;
		Перв = Ложь;
		Стр = Стр + "{""key"":" + JsonStr(Имя) + ",""kind"":""instead""}";
	КонецЦикла;
	Для Каждого Имя Из Отчёт.check Цикл
		Если Не Перв Тогда Стр = Стр + ","; КонецЕсли;
		Перв = Ложь;
		Стр = Стр + "{""key"":" + JsonStr(Имя) + ",""kind"":""check""}";
	КонецЦикла;
	Стр = Стр + "]}";
	Путь = ОбъединитьПути(КаталогОтчёта, "before_return_instead.json");
	ЗаписатьСБом(Путь, Стр, Ложь);
	Мд = ОбъединитьПути(КаталогОтчёта, "before_return_instead.md");
	Т = Новый Массив;
	Т.Добавить("# &Перед с Возврат → &Вместо");
	Т.Добавить("");
	Т.Добавить("Переведено в &Вместо: " + Отчёт.converted.Количество()
		+ ", условных «проверить»: " + Отчёт.check.Количество());
	Т.Добавить("");
	Т.Добавить("## Переведено в &Вместо (безусловный Возврат)");
	Для Каждого Имя Из Отчёт.converted Цикл
		Т.Добавить("- " + Имя);
	КонецЦикла;
	Т.Добавить("");
	Т.Добавить("## Проверить (условный Возврат внутри Если)");
	Для Каждого Имя Из Отчёт.check Цикл
		Т.Добавить("- " + Имя);
	КонецЦикла;
	ЗаписатьСБом(Мд, СтрСоединить(Т, Символы.ПС), Ложь);
	Возврат Путь;
КонецФункции

Функция JsonStr(С)
	В = СтрЗаменить(Строка(С), "\", "\\");
	В = СтрЗаменить(В, """", "\""");
	В = СтрЗаменить(В, Символы.ПС, "\n");
	Возврат """" + В + """";
КонецФункции
