// Задача 6: тексты запросов динамических списков (Form.xml) УП против БП.
// Form.xml в основной (restored) — запрос как в БП; доработка УП применяется программно
// собственным обработчиком события формы ПриСозданииНаСервере (callType="Before") в заимствованной форме:
// проверка хеша текста запроса БП → если совпал, ставится текст УП; иначе предупреждение в ЖР, текст УП НЕ ставится.

Перем ТипыРус;
Перем ТипыТабл;
Перем КореньМета;
Перем КэшМета;
Перем ОбщиеРекв;
Перем ИндексКаталогов;

// Нормализация для хеша: без пробелов, табуляций и переводов строк (те же правила — в коде расширения).
Функция Нормализовать(Знач Текст) Экспорт
	Возврат СтрСоединить(СтрРазделить(Текст, " " + Символы.Таб + Символы.ВК + Символы.ПС, Ложь), "");
КонецФункции

Функция Хеш(Знач Текст) Экспорт
	Х = Новый ХешированиеДанных(ХешФункция.SHA256);
	Х.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Нормализовать(Текст), КодировкаТекста.UTF8, Ложь));
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Х.ХешСумма));
КонецФункции

Функция ИзXml(Знач С)
	С = СтрЗаменить(С, "&lt;", "<");
	С = СтрЗаменить(С, "&gt;", ">");
	С = СтрЗаменить(С, "&quot;", """");
	С = СтрЗаменить(С, "&apos;", "'");
	С = СтрЗаменить(С, "&#xD;", "");
	С = СтрЗаменить(С, "&#13;", "");
	Возврат СтрЗаменить(С, "&amp;", "&");
КонецФункции

Функция ВXml(Знач С)
	С = СтрЗаменить(С, "&", "&amp;");
	С = СтрЗаменить(С, "<", "&lt;");
	Возврат СтрЗаменить(С, ">", "&gt;");
КонецФункции

Функция Элемент(Блок, Имя)
	Н = СтрНайти(Блок, "<" + Имя + ">");
	Если Н = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хв = Сред(Блок, Н + СтрДлина(Имя) + 2);
	К = СтрНайти(Хв, "</" + Имя + ">");
	Если К = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ИзXml(Лев(Хв, К - 1));
КонецФункции

// Динамические списки формы: Соответствие ИмяРеквизита → Структура(manual, text, mainTable, start, finish).
// start/finish — границы блока <Settings xsi:type="DynamicList"> … </Settings> в тексте.
Функция СпискиФормы(Текст) Экспорт
	Рез = Новый Соответствие;
	Метка = "<Settings xsi:type=""DynamicList"">";
	Поз = 1;
	Пока Истина Цикл
		Н = СтрНайти(Текст, Метка, , Поз);
		Если Н = 0 Тогда
			Прервать;
		КонецЕсли;
		К = СтрНайти(Текст, "</Settings>", , Н);
		Если К = 0 Тогда
			Прервать;
		КонецЕсли;
		К = К + СтрДлина("</Settings>");
		// имя — ближайший предшествующий <Attribute name="…"
		А = СтрНайти(Текст, "<Attribute name=""", НаправлениеПоиска.СКонца, Н);
		Имя = "";
		Если А > 0 Тогда
			Хв = Сред(Текст, А + 17);
			Имя = Лев(Хв, СтрНайти(Хв, """") - 1);
		КонецЕсли;
		Блок = Сред(Текст, Н, К - Н);
		// ListSettings не участвует (там нет QueryText/MainTable)
		ПозLS = СтрНайти(Блок, "<ListSettings");
		Голова = ?(ПозLS > 0, Лев(Блок, ПозLS - 1), Блок);
		Руч = Элемент(Голова, "ManualQuery");
		Т = Элемент(Голова, "QueryText");
		Осн = Элемент(Голова, "MainTable");
		Если Имя <> "" Тогда
			Рез.Вставить(Имя, Новый Структура("manual, text, mainTable, start, finish, head",
				НРег(Руч) = "true", ?(Т = Неопределено, "", Т), ОсновнаяТаблицаИмя(Осн), Н, Н + СтрДлина(Голова), Голова));
		КонецЕсли;
		Поз = К;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// MainTable вида «1:<uuid>» (ссылка на объект по идентификатору, напр. в регл. отчётах) не сравнивается и не переносится.
Функция ОсновнаяТаблицаИмя(Осн)
	Если Осн = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	П = СтрНайти(Осн, ":");
	Если П > 0 И СтрДлина(Осн) - П = 36 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Осн;
КонецФункции

Функция ПрочитатьТекст(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат СтрЗаменить(Т.ПолучитьТекст(), Символы.ВК, "");
КонецФункции

Функция Отличаются(У, Б)
	Если У.manual <> Б.manual Или (У.mainTable <> "" И Б.mainTable <> "" И НРег(У.mainTable) <> НРег(Б.mainTable)) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат (У.manual Или Б.manual) И Нормализовать(У.text) <> Нормализовать(Б.text);
КонецФункции

// Проверка «поля списка есть в запросе/основной таблице» по метаданным основной конфигурации (= УП).
// Основная конфигурация собирается из метаданных УП, поэтому запрос БП, подставленный в Form.xml основной,
// обязан ссылаться только на объекты/поля, которые есть в УП, а элементы формы (DataPath) — только на поля списка:
// при ПроизвольномЗапросе — псевдонимы выборки (стандартные реквизиты по-русски: Ссылка, Дата…; Ref/Date там нет),
// без ПроизвольногоЗапроса — реквизиты основной таблицы (стандартные — по-английски: Ref, Date…).
// Иначе Конфигуратор: «Неверный путь к данным "Список.Ref"» (и все поля списка, если запрос невалиден).

Функция ТипыТаблиц()
	Если ТипыТабл = Неопределено Тогда
		ТипыТабл = Новый Соответствие;
		Пары = "Справочник=Catalogs,Документ=Documents,ЖурналДокументов=DocumentJournals,Перечисление=Enums,РегистрСведений=InformationRegisters,РегистрНакопления=AccumulationRegisters,РегистрБухгалтерии=AccountingRegisters,РегистрРасчета=CalculationRegisters,ПланСчетов=ChartsOfAccounts,ПланВидовХарактеристик=ChartsOfCharacteristicTypes,ПланВидовРасчета=ChartsOfCalculationTypes,ПланОбмена=ExchangePlans,БизнесПроцесс=BusinessProcesses,Задача=Tasks,Константа=Constants,"
			+ "Catalog=Catalogs,Document=Documents,DocumentJournal=DocumentJournals,Enum=Enums,InformationRegister=InformationRegisters,AccumulationRegister=AccumulationRegisters,AccountingRegister=AccountingRegisters,CalculationRegister=CalculationRegisters,ChartOfAccounts=ChartsOfAccounts,ChartOfCharacteristicTypes=ChartsOfCharacteristicTypes,ChartOfCalculationTypes=ChartsOfCalculationTypes,ExchangePlan=ExchangePlans,BusinessProcess=BusinessProcesses,Task=Tasks,Constant=Constants";
		Для Каждого П Из СтрРазделить(Пары, ",") Цикл
			Ч = СтрРазделить(П, "=");
			ТипыТабл.Вставить(НРег(Ч[0]), Ч[1]);
		КонецЦикла;
	КонецЕсли;
	Возврат ТипыТабл;
КонецФункции

Функция СтандартныеРус()
	Возврат "ссылка,код,наименование,владелец,родитель,пометкаудаления,номер,дата,проведен,этогруппа,предопределенный,имяпредопределенныхданных,период,регистратор,номерстроки,активность,тип,типзначения,моментвремени,представление,виддвижения,порядок,видсчета,забалансовый,периоддействия,периодрегистрации,счет,субконто,версияданных,значение,ведущаязадача,стартован,завершен,точка,бизнеспроцесс,выполнена,исполнитель,дата,отправитель,получатель,номеротправленного,номерпринятого,этотузел";
КонецФункции

Функция СтандартныеАнгл()
	Возврат "ref,code,description,owner,parent,deletionmark,number,date,posted,isfolder,predefined,predefineddataname,period,recorder,linenumber,active,type,valuetype,pointintime,presentation,defaultpicture,recordtype,order,dataversion,value,started,completed,executed";
КонецФункции

Функция СтандартныеРусАнгл()
	Рез = Новый Соответствие;
	Для Каждого П Из СтрРазделить("ссылка=ref,код=code,наименование=description,владелец=owner,родитель=parent,пометкаудаления=deletionmark,номер=number,дата=date,проведен=posted,этогруппа=isfolder,предопределенный=predefined,имяпредопределенныхданных=predefineddataname,период=period,регистратор=recorder,номерстроки=linenumber,активность=active,тип=type,типзначения=valuetype,моментвремени=pointintime,версияданных=dataversion,порядок=order,виддвижения=recordtype,значение=value", ",") Цикл
		Ч = СтрРазделить(П, "=");
		Рез.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Метаданные основной конфигурации (каталог выгрузки УП); сбрасывает кэш.
Процедура УстановитьКореньМетаданных(Корень) Экспорт
	КореньМета = Корень;
	КэшМета = Новый Соответствие;
	ИндексКаталогов = Новый Соответствие;
	ОбщиеРекв = Новый Массив;
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(Корень, "CommonAttributes"), "*.xml", Ложь) Цикл
		ОбщиеРекв.Добавить(НРег(Ф.ИмяБезРасширения));
	КонецЦикла;
КонецПроцедуры

// Путь к <Каталог>/<Имя>.xml без учёта регистра имени (выгрузка с Windows; на Linux ФС регистрозависима).
Функция ФайлОбъекта(Каталог, Имя)
	Инд = ИндексКаталогов.Получить(Каталог);
	Если Инд = Неопределено Тогда
		Инд = Новый Соответствие;
		Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(КореньМета, Каталог), "*.xml", Ложь) Цикл
			Инд.Вставить(НРег(Ф.ИмяБезРасширения), Ф.ПолноеИмя);
		КонецЦикла;
		ИндексКаталогов.Вставить(Каталог, Инд);
	КонецЕсли;
	Возврат Инд.Получить(НРег(Имя));
КонецФункции

// Соответствие «имя поля в нижнем регистре → Истина» объекта метаданных; Неопределено — объекта нет в основной.
// ТолькоСвои = Истина — без стандартных реквизитов (имена из XML объекта и общие реквизиты).
Функция ПоляОбъекта(Знач ВидТаблицы, Знач Имя, ТолькоСвои = Ложь) Экспорт
	Каталог = ТипыТаблиц().Получить(НРег(ВидТаблицы));
	Если Каталог = Неопределено Или КореньМета = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = Каталог + "." + НРег(Имя);
	Рез = КэшМета.Получить(Ключ);
	Если Рез = Неопределено Тогда
		Файл = ФайлОбъекта(Каталог, Имя);
		Текст = ?(Файл = Неопределено, Неопределено, ПрочитатьТекст(Файл));
		Если Текст = Неопределено Тогда
			Рез = Ложь;
		Иначе
			Свои = Новый Соответствие;
			Рв = Новый РегулярноеВыражение("<Name>([^<]+)</Name>");
			Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
				Свои.Вставить(НРег(С.Группы[1].Значение), Истина);
			КонецЦикла;
			Для Каждого Имя1 Из ОбщиеРекв Цикл
				Свои.Вставить(Имя1, Истина);
			КонецЦикла;
			Все = Новый Соответствие;
			Для Каждого КЗ Из Свои Цикл
				Все.Вставить(КЗ.Ключ, Истина);
			КонецЦикла;
			Для Каждого Имя1 Из СтрРазделить(СтандартныеРус() + "," + СтандартныеАнгл(), ",") Цикл
				Все.Вставить(Имя1, Истина);
			КонецЦикла;
			Рез = Новый Структура("Все, Свои", Все, Свои);
		КонецЕсли;
		КэшМета.Вставить(Ключ, Рез);
	КонецЕсли;
	Если ТипЗнч(Рез) = Тип("Булево") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ?(ТолькоСвои, Рез.Свои, Рез.Все);
КонецФункции

// Текст запроса без комментариев и строковых литералов (в них имена не проверяются).
Функция ТекстБезЛитералов(Знач Т)
	Рв = Новый РегулярноеВыражение("//[^\n]*|""[^""]*""");
	Возврат Рв.Заменить(Т, " ");
КонецФункции

// Объекты/поля, на которые ссылается запрос, но которых нет в метаданных основной. Массив строк.
Функция ПроблемыЗапроса(Знач Текст) Экспорт
	Рез = Новый Массив;
	Если КореньМета = Неопределено Или СокрЛП(Текст) = "" Тогда
		Возврат Рез;
	КонецЕсли;
	Т = ТекстБезЛитералов(Текст);
	Ид = "[\wЁё]+";
	Типы = "Справочник|Документ|ЖурналДокументов|Перечисление|РегистрСведений|РегистрНакопления|РегистрБухгалтерии|РегистрРасчета|ПланСчетов|ПланВидовХарактеристик|ПланВидовРасчета|ПланОбмена|БизнесПроцесс|Задача|Константа|Catalog|Document|DocumentJournal|Enum|InformationRegister|AccumulationRegister|AccountingRegister|CalculationRegister|ChartOfAccounts|ChartOfCharacteristicTypes|ChartOfCalculationTypes|ExchangePlan|BusinessProcess|Task|Constant";
	Было = Новый Соответствие;
	Псевд = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?<![\wЁё.&])(" + Типы + ")\.(" + Ид + ")((?:\.(?:" + Ид + "))*)(\s+(?:КАК|AS)\s+(" + Ид + "))?");
	Рв.ИгнорироватьРегистр = Истина;
	Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
		ВидТ = С.Группы[1].Значение;
		Имя = С.Группы[2].Значение;
		Хвост = С.Группы[3].Значение;
		Поля = ПоляОбъекта(ВидТ, Имя);
		Если Поля = Неопределено Тогда
			Добавить(Рез, Было, "нет объекта " + ВидТ + "." + Имя);
			Продолжить;
		КонецЕсли;
		Если НРег(ВидТ) = "перечисление" Или НРег(ВидТ) = "enum" Тогда
			Знач1 = Сред(Хвост, 2);
			Если Знач1 <> "" И СтрНайти(Знач1, ".") = 0 И НРег(Знач1) <> "пустаяссылка" И НРег(Знач1) <> "emptyref" И Поля.Получить(НРег(Знач1)) = Неопределено Тогда
				Добавить(Рез, Было, "нет значения " + ВидТ + "." + Имя + "." + Знач1);
			КонецЕсли;
		КонецЕсли;
		Если Хвост = "" И С.Группы[5].Значение <> "" Тогда
			Псевд.Вставить(НРег(С.Группы[5].Значение), Новый Структура("Вид, Имя, Поля", ВидТ, Имя, Поля));
		КонецЕсли;
	КонецЦикла;
	Если Псевд.Количество() > 0 Тогда
		РвП = Новый РегулярноеВыражение("(?<![\wЁё.&])(" + Ид + ")\.(" + Ид + ")");
		Для Каждого С Из РвП.НайтиСовпадения(Т) Цикл
			Ст = Псевд.Получить(НРег(С.Группы[1].Значение));
			Если Ст = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Поле = С.Группы[2].Значение;
			Если Ст.Поля.Получить(НРег(Поле)) = Неопределено Тогда
				Добавить(Рез, Было, "нет поля " + Ст.Вид + "." + Ст.Имя + "." + Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Рез;
КонецФункции

Процедура Добавить(Мас, Было, Стр)
	Если Было.Получить(Стр) = Неопределено Тогда
		Было.Вставить(Стр, Истина);
		Мас.Добавить(Стр);
	КонецЕсли;
КонецПроцедуры

// Элементы списка выборки, разделённые запятыми верхнего уровня (вне скобок).
Функция ЭлементыВыборки(Текст)
	Рез = Новый Массив;
	Глуб = 0;
	Нач = 1;
	Для Й = 1 По СтрДлина(Текст) Цикл
		Сим = Сред(Текст, Й, 1);
		Если Сим = "(" Тогда
			Глуб = Глуб + 1;
		ИначеЕсли Сим = ")" Тогда
			Глуб = Глуб - 1;
		ИначеЕсли Сим = "," И Глуб = 0 Тогда
			Рез.Добавить(СокрЛП(Сред(Текст, Нач, Й - Нач)));
			Нач = Й + 1;
		КонецЕсли;
	КонецЦикла;
	Рез.Добавить(СокрЛП(Сред(Текст, Нач)));
	Возврат Рез;
КонецФункции

// Поля динамического списка (С — из СпискиФормы): Соответствие или Неопределено (не определить — не проверяется).
Функция ПоляСписка(С) Экспорт
	Если С.manual Тогда
		Т = ТекстБезЛитералов(С.text);
		// первая выборка: до ИЗ/FROM вне скобок
		Рв = Новый РегулярноеВыражение("(?i)(?:^|[^\wЁё])(ИЗ|FROM)(?![\wЁё])");
		Выборка = Т;
		Для Каждого С1 Из Рв.НайтиСовпадения(Т) Цикл
			Лево = Лев(Т, С1.Группы[1].Индекс);
			Если СтрЧислоВхождений(Лево, "(") = СтрЧислоВхождений(Лево, ")") Тогда
				Выборка = Лево;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрНайти(Выборка, ".*") > 0 Или СтрНайти(Выборка, "*") > 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Рез = Новый Соответствие;
		Рез.Вставить("defaultpicture", Истина);
		// элементы выборки (запятые верхнего уровня): «… КАК Псевдоним» — поле Псевдоним; «Т.Поле» — поле Поле,
		// стандартный реквизит без псевдонима доступен и по английскому имени (DataPath «Список.Ref»),
		// с псевдонимом «КАК Ссылка» — только по псевдониму (Ref/Date тогда — «Неверный путь к данным»)
		Англ = СтандартныеРусАнгл();
		РвА = Новый РегулярноеВыражение("(?i)(?:^|[^\wЁё])(?:КАК|AS)\s+([\wЁё]+)\s*$");
		РвБ = Новый РегулярноеВыражение("\.([\wЁё]+)\s*$");
		РвН = Новый РегулярноеВыражение("(?i)^\s*(ВЫБРАТЬ|SELECT)(\s+(РАЗРЕШЕННЫЕ|ALLOWED|РАЗЛИЧНЫЕ|DISTINCT|ПЕРВЫЕ\s+\d+|TOP\s+\d+))*\s+");
		Для Каждого Эл Из ЭлементыВыборки(РвН.Заменить(Выборка, "")) Цикл
			Совп = РвА.НайтиСовпадения(Эл);
			Если Совп.Количество() > 0 Тогда
				Рез.Вставить(НРег(Совп[0].Группы[1].Значение), Истина);
				Продолжить;
			КонецЕсли;
			Совп = РвБ.НайтиСовпадения(Эл);
			Если Совп.Количество() > 0 Тогда
				Имя1 = НРег(Совп[0].Группы[1].Значение);
				Рез.Вставить(Имя1, Истина);
				Если Англ.Получить(Имя1) <> Неопределено Тогда
					Рез.Вставить(Англ.Получить(Имя1), Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат Рез;
	КонецЕсли;
	Если С.mainTable = "" Или СтрНайти(С.mainTable, ".") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	П = СтрНайти(С.mainTable, ".");
	Поля = ПоляОбъекта(Лев(С.mainTable, П - 1), Сред(С.mainTable, П + 1), Истина);
	Если Поля = Неопределено Тогда
		Возврат Неопределено; // отсутствие таблицы — в ПроверитьСписок
	КонецЕсли;
	// без произвольного запроса стандартные реквизиты — по-английски (Ref, Date…), остальные — по именам метаданных
	Рез = Новый Соответствие;
	Для Каждого КЗ Из Поля Цикл
		Рез.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого Имя1 Из СтрРазделить(СтандартныеАнгл(), ",") Цикл
		Рез.Вставить(Имя1, Истина);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Поля списка, на которые ссылаются элементы формы: >Список.Поле…, >Items.Список.CurrentData.Поле…
Функция ПутиСписка(ТекстФормы, ИмяСписка) Экспорт
	Рез = Новый Массив;
	Было = Новый Соответствие;
	Рв = Новый РегулярноеВыражение(">(?:Items\.)?" + ИмяСписка + "\.(?:CurrentData\.)?([\wЁё]+)");
	Для Каждого С Из Рв.НайтиСовпадения(ТекстФормы) Цикл
		Добавить(Рез, Было, С.Группы[1].Значение);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Проверка списка ИмяСписка с настройками С в форме ТекстФормы. Структура(missingFields, queryProblems).
Функция ПроверитьСписок(ТекстФормы, ИмяСписка, С) Экспорт
	Нет = Новый Массив;
	Пробл = Новый Массив;
	Если С.manual Тогда
		Пробл = ПроблемыЗапроса(С.text);
	ИначеЕсли С.mainTable <> "" И СтрНайти(С.mainTable, ".") > 0 Тогда
		П = СтрНайти(С.mainTable, ".");
		Если ТипыТаблиц().Получить(НРег(Лев(С.mainTable, П - 1))) <> Неопределено
			И ПоляОбъекта(Лев(С.mainTable, П - 1), Сред(С.mainTable, П + 1)) = Неопределено Тогда
			Пробл.Добавить("нет объекта " + С.mainTable);
		КонецЕсли;
	КонецЕсли;
	Поля = ПоляСписка(С);
	Если Поля <> Неопределено Тогда
		Для Каждого Поле Из ПутиСписка(ТекстФормы, ИмяСписка) Цикл
			Если Поля.Получить(НРег(Поле)) = Неопределено Тогда
				Нет.Добавить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("missingFields, queryProblems", Нет, Пробл);
КонецФункции

// Проблемы списка в форме ТекстФормы с настройками СНов, которых нет у того же списка в базовой форме
// (ТекстБаза/СБаза — форма УП как есть: её собственные «неверные» пути/запросы УП — не новые, Конфигуратор их уже принимал).
Функция НовыеПроблемы(ТекстФормы, ИмяСписка, СНов, ТекстБаза = Неопределено, СБаза = Неопределено) Экспорт
	Р = ПроверитьСписок(ТекстФормы, ИмяСписка, СНов);
	Если СБаза = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Р0 = ПроверитьСписок(ТекстБаза, ИмяСписка, СБаза);
	Возврат Новый Структура("missingFields, queryProblems", Вычесть(Р.missingFields, Р0.missingFields), Вычесть(Р.queryProblems, Р0.queryProblems));
КонецФункции

Функция Вычесть(А, Б)
	Есть = Новый Соответствие;
	Для Каждого Х Из Б Цикл
		Есть.Вставить(НРег(Х), Истина);
	КонецЦикла;
	Рез = Новый Массив;
	Для Каждого Х Из А Цикл
		Если Есть.Получить(НРег(Х)) = Неопределено Тогда
			Рез.Добавить(Х);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Самопроверка «поля DataPath списка есть в запросе/основной таблице»: все Form.xml каталога (restored/загрузки)
// с динамическими списками на метаданных КореньМетаданных (выгрузка УП). КореньБазы — выгрузка УП с формами:
// если форма там есть, учитываются только проблемы, которых нет у списка в исходной форме УП.
// Возвращает Структура(forms, lists, bad, items).
Функция ПроверитьКаталог(Каталог, КореньМетаданных, КореньБазы = "") Экспорт
	УстановитьКореньМетаданных(КореньМетаданных);
	Эл = Новый Массив;
	Форм = 0;
	Списков = 0;
	Для Каждого Ф Из НайтиФайлы(Каталог, "Form.xml", Истина) Цикл
		Текст = ПрочитатьТекст(Ф.ПолноеИмя);
		Если Текст = Неопределено Или СтрНайти(Текст, "xsi:type=""DynamicList""") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = СтрЗаменить(Сред(Ф.ПолноеИмя, СтрДлина(Каталог) + 2), "\", "/");
		Форм = Форм + 1;
		ТекстБаза = Неопределено;
		СпБаза = Новый Соответствие;
		Если КореньБазы <> "" Тогда
			ТекстБаза = ПрочитатьТекст(ОбъединитьПути(КореньБазы, Отн));
			Если ТекстБаза <> Неопределено Тогда
				СпБаза = СпискиФормы(ТекстБаза);
			КонецЕсли;
		КонецЕсли;
		Для Каждого КЗ Из СпискиФормы(Текст) Цикл
			Списков = Списков + 1;
			Р = НовыеПроблемы(Текст, КЗ.Ключ, КЗ.Значение, ТекстБаза, СпБаза.Получить(КЗ.Ключ));
			Если Р.missingFields.Количество() > 0 Или Р.queryProblems.Количество() > 0 Тогда
				Эл.Добавить(Новый Структура("form, list, manualQuery, missingFields, queryProblems",
					СтрЗаменить(Отн, "/", "\"), КЗ.Ключ, КЗ.Значение.manual, Р.missingFields, Р.queryProblems));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Новый Структура("forms, lists, bad, items", Форм, Списков, Эл.Количество(), Эл);
КонецФункции

// Сравнение всех форм УП и БП. Возвращает массив структур (по одной на отличающийся список).
// Каталоги форм: <Тип>\<Объект>\Forms\<Форма>\Ext\Form.xml и CommonForms\<Форма>\Ext\Form.xml.
Функция Сравнить(КореньУп, КореньБп, КореньМетаданных = "") Экспорт
	Рез = Новый Массив;
	УстановитьКореньМетаданных(?(КореньМетаданных = "", КореньУп, КореньМетаданных));
	Для Каждого Ф Из НайтиФайлы(КореньУп, "Form.xml", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КореньУп) + 2);
		Отн = СтрЗаменить(Отн, "/", "\");
		Части = СтрРазделить(Отн, "\", Ложь);
		ЭтоФормаОбъекта = Части.Количество() = 6 И Части[2] = "Forms" И Части[4] = "Ext";
		ЭтоОбщая = Части.Количество() = 4 И Части[0] = "CommonForms" И Части[2] = "Ext";
		Если Не ЭтоФормаОбъекта И Не ЭтоОбщая Тогда
			Продолжить;
		КонецЕсли;
		ТекстУ = ПрочитатьТекст(Ф.ПолноеИмя);
		Если ТекстУ = Неопределено Или СтрНайти(ТекстУ, "xsi:type=""DynamicList""") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ТекстБ = ПрочитатьТекст(ОбъединитьПути(КореньБп, СтрЗаменить(Отн, "\", ПолучитьРазделительПути())));
		Если ТекстБ = Неопределено Тогда
			Продолжить; // форма только в УП — задача 5
		КонецЕсли;
		СпУ = СпискиФормы(ТекстУ);
		СпБ = СпискиФормы(ТекстБ);
		Для Каждого КЗ Из СпУ Цикл
			Б = СпБ.Получить(КЗ.Ключ);
			Если Б = Неопределено Или Не Отличаются(КЗ.Значение, Б) Тогда
				Продолжить;
			КонецЕсли;
			У = КЗ.Значение;
			Модуль = ?(ЭтоОбщая, Части[0] + "\" + Части[1] + "\Ext\Form\Module.bsl",
				Части[0] + "\" + Части[1] + "\Forms\" + Части[3] + "\Ext\Form\Module.bsl");
			// Form.xml основной = форма УП с настройками списка БП на метаданных УП: запрос БП должен ссылаться
			// только на объекты/поля УП, а элементы формы УП — только на поля списка БП.
			Пр = НовыеПроблемы(ТекстУ, КЗ.Ключ, Б, ТекстУ, У);
			Если Пр.queryProblems.Количество() > 0 Тогда
				Решение = "manual_bp_query_not_in_up";
			ИначеЕсли Пр.missingFields.Количество() > 0 Тогда
				Решение = "manual_up_fields_in_form";
			Иначе
				Решение = "bp_in_main_up_in_extension";
			КонецЕсли;
			Рез.Добавить(Новый Структура("form, module, list, bpManualQuery, upManualQuery, bpMainTable, upMainTable, bpHash, upHash, upText, bpText, missingFields, queryProblems, decision",
				Отн, Модуль, КЗ.Ключ, Б.manual, У.manual, Б.mainTable, У.mainTable,
				?(Б.manual, Хеш(Б.text), ""), ?(У.manual, Хеш(У.text), ""), У.text, Б.text, Пр.missingFields, Пр.queryProblems, Решение));
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Form.xml УП, в котором у отличающихся списков ManualQuery/QueryText/MainTable взяты из БП.
Функция FormXmlСЗапросамиБп(ТекстУ, ТекстБ, ТолькоСписки = Неопределено) Экспорт
	СпУ = СпискиФормы(ТекстУ);
	СпБ = СпискиФормы(ТекстБ);
	Замены = Новый Массив;
	Для Каждого КЗ Из СпУ Цикл
		Б = СпБ.Получить(КЗ.Ключ);
		Если Б <> Неопределено И Отличаются(КЗ.Значение, Б)
			И (ТолькоСписки = Неопределено Или ТолькоСписки.Найти(КЗ.Ключ) <> Неопределено) Тогда
			Замены.Добавить(Новый Структура("start, finish, head", КЗ.Значение.start, КЗ.Значение.finish, Б.head));
		КонецЕсли;
	КонецЦикла;
	// с конца, чтобы позиции не съезжали
	Упор = Новый СписокЗначений;
	Для Каждого З Из Замены Цикл
		Упор.Добавить(З, Формат(З.start, "ЧЦ=12; ЧВН=; ЧГ=0"));
	КонецЦикла;
	Упор.СортироватьПоПредставлению(НаправлениеСортировки.Убыв);
	Рез = ТекстУ;
	Для Каждого Эл Из Упор Цикл
		З = Эл.Значение;
		Рез = Лев(Рез, З.start - 1) + З.head + Сред(Рез, З.finish);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ТипРус(Знач Таблица)
	Если ТипыРус = Неопределено Тогда
		ТипыРус = Новый Соответствие;
		Пары = "Catalog=Справочник,Document=Документ,DocumentJournal=ЖурналДокументов,Enum=Перечисление,InformationRegister=РегистрСведений,AccumulationRegister=РегистрНакопления,AccountingRegister=РегистрБухгалтерии,CalculationRegister=РегистрРасчета,ChartOfAccounts=ПланСчетов,ChartOfCharacteristicTypes=ПланВидовХарактеристик,ChartOfCalculationTypes=ПланВидовРасчета,ExchangePlan=ПланОбмена,BusinessProcess=БизнесПроцесс,Task=Задача,Constant=Константа";
		Для Каждого П Из СтрРазделить(Пары, ",") Цикл
			Ч = СтрРазделить(П, "=");
			ТипыРус.Вставить(Ч[0], Ч[1]);
		КонецЦикла;
	КонецЕсли;
	Т = СтрЗаменить(Таблица, "\", ".");
	П = СтрНайти(Т, ".");
	Если П = 0 Тогда
		Возврат Т;
	КонецЕсли;
	Р = ТипыРус.Получить(Лев(Т, П - 1));
	Возврат ?(Р = Неопределено, Т, Р + Сред(Т, П));
КонецФункции

Функция ЛитералBsl(Знач Т, Отступ)
	Строки = СтрРазделить(СтрЗаменить(Т, """", """"""), Символы.ПС, Истина);
	Для Й = 1 По Строки.ВГраница() Цикл
		Строки[Й] = Отступ + "|" + Строки[Й];
	КонецЦикла;
	Возврат """" + СтрСоединить(Строки, Символы.ПС) + """";
КонецФункции

Функция ИмяОбработчика() Экспорт
	Возврат "УП_ДинСпискиПередПриСозданииНаСервере";
КонецФункции

// Текст методов расширения для одной формы (Пункты — элементы Сравнить() этой формы).
Функция ТекстОбработчика(Пункты, ИмяФормы) Экспорт
	Т = Новый Массив;
	Т.Добавить("// Задача 6 (typovaya-up): запросы динамических списков УП. Form.xml основной — как в БП.");
	Т.Добавить("// Если типовой запрос изменился (хеш не совпал) — предупреждение в журнале регистрации, текст УП не применяется.");
	Т.Добавить("&НаСервере");
	Т.Добавить("Процедура " + ИмяОбработчика() + "(Отказ, СтандартнаяОбработка)");
	Для Каждого П Из Пункты Цикл
		Т.Добавить("	УП_ПрименитьЗапросДинСписка(""" + П.list + """, " + ?(П.bpManualQuery, "Истина", "Ложь") + ", """ + П.bpHash + """,");
		Т.Добавить("		" + ?(П.upManualQuery, "Истина", "Ложь") + ", """ + ТипРус(П.upMainTable) + """,");
		Т.Добавить("		" + ЛитералBsl(?(П.upManualQuery, П.upText, ""), "		") + ");");
	КонецЦикла;
	Т.Добавить("КонецПроцедуры");
	Т.Добавить("");
	Т.Добавить("&НаСервере");
	Т.Добавить("Процедура УП_ПрименитьЗапросДинСписка(ИмяСписка, ПроизвольныйБП, ХешБП, ПроизвольныйУП, ОсновнаяТаблицаУП, ТекстУП)");
	Т.Добавить("	Список = ЭтотОбъект[ИмяСписка];");
	Т.Добавить("	Совпал = (Список.ПроизвольныйЗапрос = ПроизвольныйБП);");
	Т.Добавить("	Если Совпал И ПроизвольныйБП Тогда");
	Т.Добавить("		Нормализованный = СтрСоединить(СтрРазделить(Список.ТекстЗапроса, "" "" + Символы.Таб + Символы.ВК + Символы.ПС, Ложь), """");");
	Т.Добавить("		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);");
	Т.Добавить("		Хеширование.Добавить(ПолучитьДвоичныеДанныеИзСтроки(Нормализованный, КодировкаТекста.UTF8, Ложь));");
	Т.Добавить("		Совпал = (НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеширование.ХешСумма)) = ХешБП);");
	Т.Добавить("	КонецЕсли;");
	Т.Добавить("	Если Не Совпал Тогда");
	Т.Добавить("		ЗаписьЖурналаРегистрации(""УП_Доработки.ИзменилсяТиповойЗапрос"", УровеньЖурналаРегистрации.Предупреждение, , ,");
	Т.Добавить("			СтрШаблон(""Форма %1, список %2: типовой текст запроса изменился после обновления — доработка УП не применена, нужна сверка (typovaya-up, dynlist_queries.json)."",");
	Т.Добавить("				ЭтотОбъект.ИмяФормы, ИмяСписка));");
	Т.Добавить("		Возврат;");
	Т.Добавить("	КонецЕсли;");
	Т.Добавить("	Список.ПроизвольныйЗапрос = ПроизвольныйУП;");
	Т.Добавить("	Если ЗначениеЗаполнено(ОсновнаяТаблицаУП) Тогда");
	Т.Добавить("		Список.ОсновнаяТаблица = ОсновнаяТаблицаУП;");
	Т.Добавить("	КонецЕсли;");
	Т.Добавить("	Если ПроизвольныйУП Тогда");
	Т.Добавить("		Список.ТекстЗапроса = ТекстУП;");
	Т.Добавить("	КонецЕсли;");
	Т.Добавить("КонецПроцедуры");
	Возврат СтрСоединить(Т, Символы.ПС);
КонецФункции

// Form.xml заимствованной формы: событие ПриСозданииНаСервере с callType="Before" (только в части расширения, не в BaseForm).
Функция ДобавитьСобытиеВFormXml(Знач ТекстXml) Экспорт
	Если СтрНайти(ТекстXml, ИмяОбработчика()) > 0 Тогда
		Возврат ТекстXml;
	КонецЕсли;
	Метка = "</AutoCommandBar>";
	Н = СтрНайти(ТекстXml, Метка);
	Б = СтрНайти(ТекстXml, "<BaseForm");
	Если Н = 0 Или (Б > 0 И Н > Б) Тогда
		Возврат ТекстXml;
	КонецЕсли;
	Вст = Символы.ПС + "	<Events>" + Символы.ПС
		+ "		<Event name=""OnCreateAtServer"" callType=""Before"">" + ИмяОбработчика() + "</Event>" + Символы.ПС
		+ "	</Events>";
	П = Н + СтрДлина(Метка);
	Возврат Лев(ТекстXml, П - 1) + Вст + Сред(ТекстXml, П);
КонецФункции

// dynlist_queries.json; ПредыдущийJson — прошлый отчёт (для отметки «хеш БП изменился»).
Процедура ЗаписатьОтчёт(Пункты, КаталогВыхода, Лог) Экспорт
	Путь = ОбъединитьПути(КаталогВыхода, "dynlist_queries.json");
	Прежние = Новый Соответствие;
	Если (Новый Файл(Путь)).Существует() Тогда
		Попытка
			Ч = Новый ЧтениеJSON;
			Ч.ОткрытьФайл(Путь, "UTF-8");
			Старый = ПрочитатьJSON(Ч, Ложь);
			Ч.Закрыть();
			Для Каждого Э Из Старый.items Цикл
				Прежние.Вставить(Э.form + "|" + Э.list, Э.bpHash);
			КонецЦикла;
		Исключение
			Лог.Добавить("dynlist: прежний dynlist_queries.json не прочитан: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Эл = Новый Массив;
	Изм = 0;
	Ручных = 0;
	Для Каждого П Из Пункты Цикл
		Было = Прежние.Получить(П.form + "|" + П.list);
		Сменился = Было <> Неопределено И Было <> П.bpHash;
		Если Сменился Тогда
			Изм = Изм + 1;
			Лог.Добавить("ВНИМАНИЕ dynlist: у " + П.form + " / " + П.list + " изменился типовой запрос БП (хеш " + Было + " -> " + П.bpHash + ") — сверить доработку УП");
		КонецЕсли;
		Эл.Добавить(Новый Структура("form, list, decision, missingFields, queryProblems, bpManualQuery, upManualQuery, bpMainTable, upMainTable, bpHash, upHash, previousBpHash, bpHashChanged, handler",
			П.form, П.list, П.decision, П.missingFields, ?(П.Свойство("queryProblems"), П.queryProblems, Новый Массив), П.bpManualQuery, П.upManualQuery, П.bpMainTable, П.upMainTable, П.bpHash, П.upHash,
			?(Было = Неопределено, "", Было), Сменился, ?(П.decision <> "bp_in_main_up_in_extension", "", ИмяОбработчика())));
		Если П.decision <> "bp_in_main_up_in_extension" Тогда
			Ручных = Ручных + 1;
		КонецЕсли;
	КонецЦикла;
	Данные = Новый Структура("count, manual, bpHashChanged, policy, items", Эл.Количество(), Ручных, Изм,
		"Form.xml основной — запрос БП; в заимствованной форме обработчик ПриСозданииНаСервере (Before): хеш БП совпал — ставится запрос УП, иначе предупреждение в ЖР (УП_Доработки.ИзменилсяТиповойЗапрос) и запрос УП НЕ ставится; manual_up_fields_in_form — элементы формы УП ссылаются на поля, которых нет в списке БП (при произвольном запросе — только псевдонимы выборки, Ref/Date там нет); manual_bp_query_not_in_up — запрос БП ссылается на объекты/поля, которых нет в метаданных УП (основной): в обоих случаях в основной остаётся запрос УП, ручной разбор", Эл);
	З = Новый ЗаписьJSON;
	З.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, "  "));
	ЗаписатьJSON(З, Данные);
	Т = З.Закрыть();
	ЗТ = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	ЗТ.Записать(Т);
	ЗТ.Закрыть();
КонецПроцедуры

// Чтение/запись без потери BOM и переводов строк (Form.xml restored — побайтно как исходный, кроме замен).
Функция ПрочитатьСырой(Путь) Экспорт
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДД = Новый ДвоичныеДанные(Путь);
	Т = ПолучитьСтрокуИзДвоичныхДанных(ДД, "UTF-8");
	ЕстьBOM = ДД.Размер() - ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, Ложь).Размер() = 3;
	Возврат Новый Структура("Текст, BOM", Т, ЕстьBOM);
КонецФункции

Процедура ЗаписатьСырой(Путь, Текст, ЕстьBOM) Экспорт
	Ф = Новый Файл(Путь);
	СоздатьКаталог(Ф.Путь);
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, ЕстьBOM).Записать(Путь);
КонецПроцедуры
