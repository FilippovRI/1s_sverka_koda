// Модули БП, на которые ссылается код основной (restored в ИБ), но которых нет в метаданных УП:
// при --только-extension добавляем в расширение собственные общие модули (не в restored).
// Все нужные модули — только заглушки (XML контекста из БП + пустые экспортные вызываемые методы); restored не меняем.

Перем В;

Процедура Инициализировать(МодульВозврата) Экспорт
	В = МодульВозврата;
КонецПроцедуры

// Набор имён общих модулей: restored + extension (для статической проверки ссылок).
Функция ОбъединённыйНаборМодулей(КаталогВосст, КаталогРасш)
	Пров = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ПроверкаСсылокКонфигурации.os"));
	Р = Пров.ИменаОбщихМодулейВыгрузки(КаталогВосст);
	Для Каждого КЗ Из Пров.ИменаОбщихМодулейВыгрузки(КаталогРасш) Цикл
		Р.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Скан *.bsl в Каталоги: ссылки на общие модули вне НаборМодулей.
// Структура(modules, refs, top, missingModules).
Функция СканОтсутствующихМодулей(НаборМодулей, Каталоги) Экспорт
	Пров = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ПроверкаСсылокКонфигурации.os"));
	Рез = Новый Структура("modules, refs, top, missingModules", 0, 0, Новый Массив, Новый Массив);
	БезМодуля = Новый Соответствие;
	Таб = Новый ТаблицаЗначений;
	Таб.Колонки.Добавить("Файл");
	Таб.Колонки.Добавить("Строк");
	Для Каждого Кат Из Каталоги Цикл
		Если Не (Новый Файл(Кат)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
			Текст = В.ПрочитатьТекст(Ф.ПолноеИмя);
			Если Текст = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Нет = Пров.ОтсутствующиеОбщиеМодули(Текст, НаборМодулей);
			Если Нет.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Им Из Нет Цикл
				Если БезМодуля.Получить(Им) = Неопределено Тогда
					БезМодуля.Вставить(Им, Истина);
					Рез.missingModules.Добавить(Им);
				КонецЕсли;
			КонецЦикла;
			Сч = Пров.ПодсчитатьСсылокНаОтсутствующиеОбщиеМодули(Текст, НаборМодулей);
			Рез.refs = Рез.refs + Сч;
			СтрТ = Таб.Добавить();
			СтрТ.Файл = Сред(Ф.ПолноеИмя, СтрДлина(Кат) + 2);
			СтрТ.Строк = Сч;
			Рез.modules = Рез.modules + 1;
		КонецЦикла;
	КонецЦикла;
	Таб.Сортировать("Строк Убыв");
	Для Каждого Стр Из Таб Цикл
		Рез.top.Добавить(Стр.Файл + ": " + Стр.Строк);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Анализ + clean/blocked в КаталогРасш; пишет bp_modules_extension.json при КаталогОтчёта <> "".
// Возврат: clean, cleanAdded, stubs, stubMethods, blocked, objects, scanRestored, scanExtension, scanAfter.
// Все модули замыкания Анализ, которых нет в метаданных основной (в т.ч. ссылки из CommonModules/*.bsl).
Функция ИменаДляЗаглушек(КаталогВосст, Рв)
	ОснМ = В.ИменаТега(В.СоставКонфигурации(ОбъединитьПути(КаталогВосст, "Configuration.xml")), "CommonModule");
	Р = Новый Массив;
	Блок = Новый Массив;
	Для Каждого Имя Из Рв.modules Цикл
		Если ОснМ.Получить(НРег(Имя)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Р.Добавить(Имя);
		Если В.ПричинаБлокировки(Имя, Рв) <> "" Тогда
			Блок.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("all, blocked", Р, Блок);
КонецФункции

Функция Обеспечить(КаталогВосст, КаталогРасш, КореньБп, Лог, КаталогОтчёта = "") Экспорт
	КатТекстов = Новый Массив;
	КатТекстов.Добавить(КаталогВосст);
	КатТекстов.Добавить(КаталогРасш);
	Рв = В.Анализ(КаталогВосст, КореньБп, КатТекстов);
	Сп = ИменаДляЗаглушек(КаталогВосст, Рв);
	НаборДо = ОбъединённыйНаборМодулей(КаталогВосст, КаталогРасш);
	ТолькоОсн = Новый Массив;
	ТолькоОсн.Добавить(КаталогВосст);
	СканДо = СканОтсутствующихМодулей(НаборДо, ТолькоОсн);
	ИменаЗагл = Сп.all;
	ЗаглБп = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЗаглушкиОбщихМодулейБп.os"));
	ЗаглБп.Инициализировать(В);
	РзБп = ЗаглБп.Создать(ИменаЗагл, КореньБп, КаталогРасш, КатТекстов);
	НаборПосле = ОбъединённыйНаборМодулей(КаталогВосст, КаталогРасш);
	СканПослеОсн = СканОтсутствующихМодулей(НаборПосле, ТолькоОсн);
	СканПослеВсё = СканОтсутствующихМодулей(НаборПосле, КатТекстов);
	Итог = Новый Структура("stubs, stubMethods, stubCfgLines, blocked, objects, closure, scanRestoredBefore, scanRestoredAfter, scanCombinedAfter",
		РзБп.modules.Количество(), РзБп.methods, РзБп.added, Сп.blocked.Количество(), Рв.objects.Количество(), Рв.modules.Количество(),
		СканДо, СканПослеОсн, СканПослеВсё);
	Лог.Добавить("Заглушки общих модулей БП в extension (restored не менялся): модулей " + РзБп.modules.Количество()
		+ " (методов " + РзБп.methods + ", в Configuration +" + РзБп.added + "), с отсутствующими объектами (blocked) "
		+ Сп.blocked.Количество() + ", замыкание " + Рв.modules.Количество());
	Лог.Добавить("Ссылки на отсутствующие общие модули: restored до — модулей " + СканДо.modules + ", вызовов " + СканДо.refs
		+ "; после extension — модулей " + СканПослеОсн.modules + ", вызовов " + СканПослеОсн.refs
		+ " (restored+extension текст: модулей " + СканПослеВсё.modules + ", вызовов " + СканПослеВсё.refs + ")");
	Если КаталогОтчёта <> "" Тогда
		Отч = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ОтчетHTML.os"));
		Отч.ЗаписатьФайл(ОбъединитьПути(КаталогОтчёта, "bp_modules_extension.json"), Отч.ВJSON(Новый Структура(
			"stubs, stubMethods, stubNames, blocked, objects, closure, notExported, scanRestoredBefore, scanRestoredAfter, scanCombinedAfter",
			РзБп.modules, РзБп.methods, ИменаЗагл, Сп.blocked, Рв.objects, Рв.modules, РзБп.notExported, СканДо, СканПослеОсн, СканПослеВсё)));
	КонецЕсли;
	Возврат Итог;
КонецФункции