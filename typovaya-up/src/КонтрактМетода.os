// Лексический разбор сигнатур Процедура/Функция (не полный парсер типов).

// Сравнение контрактов УП и поставщика перед auto-хуком.
// Возвращает: ОК, Причина, callRewritePreview (диагностика, не выполненный CallRewrite).
Функция ПроверитьПередАвтоПереносом(ТекстПост, ТекстИсх, Разбор) Экспорт
	Кп = РазобратьКонтракт(ТекстПост, Разбор);
	Ки = РазобратьКонтракт(ТекстИсх, Разбор);
	Если Кп = Неопределено Или Ки = Неопределено Тогда
		Возврат ОтветЛожь("Не удалось разобрать сигнатуру — manual");
	КонецЕсли;
	Если Кп.Вид <> Ки.Вид Тогда
		Возврат ОтветЛожь("Несовместимый вид: " + Кп.Вид + " vs " + Ки.Вид);
	КонецЕсли;
	Если Кп.Экспорт <> Ки.Экспорт Тогда
		Возврат ОтветЛожь("Экспорт объявления отличается — manual (не доказана эквивалентность)");
	КонецЕсли;
	Если Кп.Параметры.Количество() <> Ки.Параметры.Количество() Тогда
		Возврат ОтветЛожь("Число параметров: " + Ки.Параметры.Количество() + " (УП) vs "
			+ Кп.Параметры.Количество() + " (БП)");
	КонецЕсли;
	Для Нп = 0 По Кп.Параметры.Количество() - 1 Цикл
		Пп = Кп.Параметры[Нп];
		Пи = Ки.Параметры[Нп];
		Если НРег(Пп.Имя) <> НРег(Пи.Имя) Тогда
			Возврат ОтветЛожь("Параметр " + (Нп + 1) + ": имя " + Пи.Имя + " vs " + Пп.Имя);
		КонецЕсли;
		Если Пп.ПоЗнач <> Пи.ПоЗнач Тогда
			Возврат ОтветЛожь("Параметр " + Пи.Имя + ": Знач отличается");
		КонецЕсли;
		Если НормДефолт(Пп.Дефолт) <> НормДефолт(Пи.Дефолт) Тогда
			Возврат ОтветЛожь("Параметр " + Пи.Имя + ": дефолт отличается");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ОК, Причина, callRewritePreview", Истина, "",
		"CallRewrite: не выполнялся; контракт совпадает (лексически)");
КонецФункции

Функция ОтветЛожь(Причина)
	Возврат Новый Структура("ОК, Причина, callRewritePreview", Ложь, Причина,
		"CallRewrite: заблокирован — " + Причина);
КонецФункции

Функция ПревьюНовогоМетода(Имя, Префикс) Экспорт
	Возврат "Кандидат " + Префикс + Имя + ": новый метод; CallRewrite не выполнялся (preview)";
КонецФункции

Функция РазобратьКонтракт(ТекстМетода, Разбор) Экспорт
	Заг = ЗаголовокМетода(ТекстМетода, Разбор);
	Если Заг = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	СтЗ = СтрРазделить(Заг, Символы.ПС, Истина);
	Объ = Разбор.РазобратьОбъявление(?(СтЗ.Количество() > 0, СтЗ[0], Заг));
	Если Объ = Неопределено Тогда
		Объ = Разбор.РазобратьОбъявление(СокрЛП(СтрЗаменить(Заг, Символы.ПС, " ")));
	КонецЕсли;
	Если Объ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	НЗ = НРег(Заг);
	Эксп = СтрНайти(НЗ, " экспорт") > 0 Или СтрНайти(НЗ, " export") > 0;
	Список = ИзвлечьСписокПараметров(Заг);
	Возврат Новый Структура("Вид, Экспорт, Параметры", Объ.Вид, Эксп, РазобратьСписокПараметров(Список));
КонецФункции

Функция ЗаголовокМетода(Текст, Разбор)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.Количество() - 1 Цикл
		Если Разбор.РазобратьОбъявление(Строки[Й]) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Рез = Новый Массив;
		Глубина = 0;
		Для К = Й По Строки.Количество() - 1 Цикл
			Стр = Строки[К];
			Рез.Добавить(Стр);
			Чистая = Разбор.УбратьКомментарий(Стр);
			Глубина = Глубина + СтрЧислоВхождений(Чистая, "(") - СтрЧислоВхождений(Чистая, ")");
			Если Глубина <= 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат СтрСоединить(Рез, Символы.ПС);
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИзвлечьСписокПараметров(Заголовок)
	Нач = СтрНайти(Заголовок, "(");
	Если Нач = 0 Тогда
		Возврат "";
	КонецЕсли;
	Глубина = 0;
	Для Й = Нач По СтрДлина(Заголовок) Цикл
		С = Сред(Заголовок, Й, 1);
		Если С = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли С = ")" Тогда
			Глубина = Глубина - 1;
			Если Глубина = 0 Тогда
				Возврат Сред(Заголовок, Нач + 1, Й - Нач - 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция РазобратьСписокПараметров(Список)
	Рез = Новый Массив;
	Если СокрЛП(Список) = "" Тогда
		Возврат Рез;
	КонецЕсли;
	Для Каждого Сег Из РазделитьПоЗапятой(Список) Цикл
		Рез.Добавить(РазобратьПараметр(Сег));
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция РазделитьПоЗапятой(Список)
	Рез = Новый Массив;
	Тек = "";
	Глубина = 0;
	ВСтроке = Ложь;
	Для Й = 1 По СтрДлина(Список) Цикл
		С = Сред(Список, Й, 1);
		Если Не ВСтроке И С = """" Тогда
			ВСтроке = Истина;
		ИначеЕсли ВСтроке И С = """" Тогда
			ВСтроке = Ложь;
		ИначеЕсли Не ВСтроке И С = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Не ВСтроке И С = ")" Тогда
			Глубина = Глубина - 1;
		ИначеЕсли Не ВСтроке И С = "," И Глубина = 0 Тогда
			Рез.Добавить(Тек);
			Тек = "";
			Продолжить;
		КонецЕсли;
		Тек = Тек + С;
	КонецЦикла;
	Если СокрЛП(Тек) <> "" Тогда
		Рез.Добавить(Тек);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция РазобратьПараметр(Сег)
	С = СокрЛП(Сег);
	ПоЗнач = Ложь;
	Н = НРег(С);
	Если СтрНачинаетсяС(Н, "знач ") Тогда
		ПоЗнач = Истина;
		С = СокрЛП(Сред(С, 6));
	КонецЕсли;
	Деф = "";
	Рав = СтрНайти(С, "=");
	Если Рав > 0 Тогда
		Деф = СокрЛП(Сред(С, Рав + 1));
		С = СокрЛП(Лев(С, Рав - 1));
	КонецЕсли;
	Ч = СтрРазделить(С, " ");
	Имя = Ч[Ч.Количество() - 1];
	Возврат Новый Структура("Имя, ПоЗнач, Дефолт", Имя, ПоЗнач, Деф);
КонецФункции

Функция НормДефолт(Д)
	Возврат СокрЛП(Д);
КонецФункции
