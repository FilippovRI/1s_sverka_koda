// Задача 12: пустые общие модули-заглушки в основной для модулей БП, которые нельзя вернуть как есть
// (их замыкание тянет отсутствующие в основной объекты — blocked из ВозвратОбщихМодулейБп). Код restored (БП)
// остаётся без изменений и компилируется: модуль с тем же именем и флагами контекста (XML из БП как есть),
// в модуле — только экспортные методы, которые реально вызываются из restored/extension, с сигнатурами БП;
// целевой каталог Куда — restored или extension (собственные объекты расширения);
// функции возвращают Неопределено, процедуры пустые. Выгрузка БП только читается.

Перем В; // ВозвратОбщихМодулейБп

Процедура Инициализировать(МодульВозврата) Экспорт
	В = МодульВозврата;
КонецПроцедуры

Функция ТекстМодуля(КореньБп, Имя)
	Т = В.ПрочитатьТекст(ОбъединитьПути(КореньБп, "CommonModules", Имя, "Ext") + ПолучитьРазделительПути() + "Module.bsl");
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

// Экспортные методы модуля: Соответствие нрег -> Структура(Имя, Вид, Асинх, Параметры) в порядке объявления — Массив.
Функция ЭкспортныеМетоды(Текст) Экспорт
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("(?im)^[ \t]*(Асинх[ \t]+)?(Процедура|Функция)[ \t]+([\wЁё]+)[ \t]*\(([^)]*)\)[ \t]*Экспорт");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Пар = (Новый РегулярноеВыражение("//[^\n]*")).Заменить(С.Группы[4].Значение, "");
		Пар = СокрЛП((Новый РегулярноеВыражение("\s+")).Заменить(Пар, " "));
		Р.Добавить(Новый Структура("Имя, Вид, Асинх, Параметры", С.Группы[3].Значение, С.Группы[2].Значение,
			С.Группы[1].Значение <> "", Пар));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТекстЗаглушки(Методы) Экспорт
	ПС = Символы.ВК + Символы.ПС;
	Т = "// Заглушка typovaya-up: модуль БП отсутствует в УП" + ПС
		+ "// (вызывается из типового кода БП в restored; методы — только вызываемые, сигнатуры как в БП)" + ПС;
	Для Каждого М Из Методы Цикл
		Т = Т + ПС + ?(М.Асинх, "Асинх ", "") + М.Вид + " " + М.Имя + "(" + М.Параметры + ") Экспорт" + ПС;
		Если НРег(М.Вид) = "функция" Тогда
			Т = Т + "	Возврат Неопределено;" + ПС + "КонецФункции" + ПС;
		Иначе
			Т = Т + "КонецПроцедуры" + ПС;
		КонецЕсли;
	КонецЦикла;
	Возврат Т;
КонецФункции

// Вызываемые методы модулей Имена из *.bsl каталогов КаталогиТекстов (квалифицированные «Модуль.Метод»,
// для глобальных модулей — и «Метод(»). Соответствие Модуль -> Соответствие(нрег метод -> Истина).
Функция ВызываемыеМетоды(Имена, КореньБп, КаталогиТекстов, Пропуск) Экспорт
	Карта = Новый Соответствие;
	Р = Новый Соответствие;
	Глоб = Новый Соответствие;
	Для Каждого Имя Из Имена Цикл
		Карта.Вставить(НРег(Имя), Имя);
		Р.Вставить(Имя, Новый Соответствие);
		Х = В.ПрочитатьТекст(ОбъединитьПути(КореньБп, "CommonModules", Имя + ".xml"));
		Если Х <> Неопределено И СтрНайти(Х, "<Global>true</Global>") > 0 Тогда
			Для Каждого М Из ЭкспортныеМетоды(ТекстМодуля(КореньБп, Имя)) Цикл
				Глоб.Вставить(НРег(М.Имя), Имя);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	РвК = Новый РегулярноеВыражение("(?<![\wЁё.&#])([\wЁё]+)[ \t]*\.[ \t]*([\wЁё]+)");
	РвВ = Новый РегулярноеВыражение("(?<![\wЁё.&#])([\wЁё]+)[ \t]*\(");
	Для Каждого Кат Из КаталогиТекстов Цикл
		Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
			Если Пропуск.Получить(НРег(Ф.ПолноеИмя)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Код = В.КодБезЛитералов(В.ПрочитатьТекст(Ф.ПолноеИмя));
			Для Каждого С Из РвК.НайтиСовпадения(Код) Цикл
				Имя = Карта.Получить(НРег(С.Группы[1].Значение));
				Если Имя <> Неопределено Тогда
					Р.Получить(Имя).Вставить(НРег(С.Группы[2].Значение), Истина);
				КонецЕсли;
			КонецЦикла;
			Если Глоб.Количество() > 0 Тогда
				Для Каждого С Из РвВ.НайтиСовпадения(Код) Цикл
					Имя = Глоб.Получить(НРег(С.Группы[1].Значение));
					Если Имя <> Неопределено Тогда
						Р.Получить(Имя).Вставить(НРег(С.Группы[1].Значение), Истина);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

// Создаёт заглушки в Куда (CommonModules + Configuration.xml). Возврат Структура(modules — Массив Структура(name, methods,
// global), methods — всего методов, notExported — «Модуль.Метод», которых нет среди экспортных в БП, added — строк в Configuration.xml).
Функция Создать(Имена, КореньБп, Куда, КаталогиТекстов, Записывать = Истина) Экспорт
	Пропуск = Новый Соответствие;
	Для Каждого Имя Из Имена Цикл
		Пропуск.Вставить(НРег(ОбъединитьПути(Куда, "CommonModules", Имя, "Ext") + ПолучитьРазделительПути() + "Module.bsl"), Истина);
	КонецЦикла;
	Нужные = ВызываемыеМетоды(Имена, КореньБп, КаталогиТекстов, Пропуск);
	Рез = Новый Структура("modules, methods, notExported, added", Новый Массив, 0, Новый Массив, 0);
	Если Записывать И Имена.Количество() > 0 Тогда
		СоздатьКаталог(ОбъединитьПути(Куда, "CommonModules"));
	КонецЕсли;
	Для Каждого Имя Из Имена Цикл
		Н = Нужные.Получить(Имя);
		Методы = Новый Массив;
		Есть = Новый Соответствие;
		Для Каждого М Из ЭкспортныеМетоды(ТекстМодуля(КореньБп, Имя)) Цикл
			Если Н.Получить(НРег(М.Имя)) <> Неопределено И Есть.Получить(НРег(М.Имя)) = Неопределено Тогда
				Методы.Добавить(М);
				Есть.Вставить(НРег(М.Имя), Истина);
			КонецЕсли;
		КонецЦикла;
		Для Каждого КЗ Из Н Цикл
			Если Есть.Получить(КЗ.Ключ) = Неопределено Тогда
				Рез.notExported.Добавить(Имя + "." + КЗ.Ключ);
			КонецЕсли;
		КонецЦикла;
		Х = В.ПрочитатьТекст(ОбъединитьПути(КореньБп, "CommonModules", Имя + ".xml"));
		Рез.modules.Добавить(Новый Структура("name, methods, global", Имя, Методы.Количество(),
			Х <> Неопределено И СтрНайти(Х, "<Global>true</Global>") > 0));
		Рез.methods = Рез.methods + Методы.Количество();
		Если Записывать Тогда
			КопироватьФайл(ОбъединитьПути(КореньБп, "CommonModules", Имя + ".xml"), ОбъединитьПути(Куда, "CommonModules", Имя + ".xml"));
			Кат = ОбъединитьПути(Куда, "CommonModules", Имя, "Ext");
			СоздатьКаталог(Кат);
			ПолучитьДвоичныеДанныеИзСтроки(ТекстЗаглушки(Методы), КодировкаТекста.UTF8, Истина).Записать(Кат + ПолучитьРазделительПути() + "Module.bsl");
		КонецЕсли;
	КонецЦикла;
	Если Записывать Тогда
		Рез.added = В.ДобавитьВКонфигурацию(ОбъединитьПути(Куда, "Configuration.xml"), Имена);
	КонецЕсли;
	Возврат Рез;
КонецФункции

// Прямые ссылки кода (*.bsl Каталог) на немодульные объекты, которых нет в основной (Configuration.xml КореньОсн).
// Структура(modules — число модулей, lines — строк, objects — Массив «Тег.Имя», top — Массив «файл: строк» по убыванию).
Функция СсылкиНаОтсутствующиеОбъекты(КореньОсн, Каталог) Экспорт
	Осн = В.СоставКонфигурации(ОбъединитьПути(КореньОсн, "Configuration.xml"));
	Рез = Новый Структура("modules, lines, objects, top", 0, 0, Новый Массив, Новый Массив);
	Было = Новый Соответствие;
	Т = Новый ТаблицаЗначений;
	Т.Колонки.Добавить("Файл");
	Т.Колонки.Добавить("Строк");
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.bsl", Истина) Цикл
		Текст = В.ПрочитатьТекст(Ф.ПолноеИмя);
		Как = Новый Соответствие;
		Для Каждого С Из В.СсылкиНаОбъекты(Текст) Цикл
			Имена = Осн.Получить(С.Тег);
			Если Имена <> Неопределено И Имена.Получить(НРег(С.Имя)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Как.Вставить(С.Как, Истина);
			Ключ = С.Тег + "." + С.Имя;
			Если Было.Получить(Ключ) = Неопределено Тогда
				Было.Вставить(Ключ, Истина);
				Рез.objects.Добавить(Ключ);
			КонецЕсли;
		КонецЦикла;
		Если Как.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Код = Новый ТекстовыйДокумент;
		Код.УстановитьТекст(Текст);
		Строк = 0;
		Для Н = 1 По Код.КоличествоСтрок() Цикл
			Стр = Код.ПолучитьСтроку(Н);
			Если СтрНачинаетсяС(СокрЛ(Стр), "//") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого КЗ Из Как Цикл
				Если СтрНайти(Стр, КЗ.Ключ) > 0 Тогда
					Строк = Строк + 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Если Строк > 0 Тогда
			Рез.modules = Рез.modules + 1;
			Рез.lines = Рез.lines + Строк;
			Стр = Т.Добавить();
			Стр.Файл = Сред(Ф.ПолноеИмя, СтрДлина(Каталог) + 2);
			Стр.Строк = Строк;
		КонецЕсли;
	КонецЦикла;
	Т.Сортировать("Строк Убыв");
	Для Каждого Стр Из Т Цикл
		Рез.top.Добавить(Стр.Файл + ": " + Стр.Строк);
	КонецЦикла;
	Возврат Рез;
КонецФункции
