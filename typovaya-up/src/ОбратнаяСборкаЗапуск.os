// Отдельный запуск обратной сборки по готовому выходу (без пересравнения):
//   oscript src/ОбратнаяСборкаЗапуск.os <выход> <выгрузка УП> <выгрузка БП> [префикс]
// Пишет reverse_build.json, дополняет summary.json (reverseBuild) и раздел в razbor_moduley.html, строки в log.txt.
Каталог = ТекущийСценарий().Каталог;
Если АргументыКоманднойСтроки.Количество() < 3 Тогда
	Сообщить("Использование: oscript ОбратнаяСборкаЗапуск.os <выход> <УП> <БП> [префикс]");
	ЗавершитьРаботу(1);
КонецЕсли;
Выход = АргументыКоманднойСтроки[0];
Префикс = ?(АргументыКоманднойСтроки.Количество() > 3, АргументыКоманднойСтроки[3], "УП_");
Разбор = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "РазборМетодов.os"));
Отчет = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОтчетHTML.os"));
Обр = ЗагрузитьСценарий(ОбъединитьПути(Каталог, "ОбратнаяСборка.os"));
Обр.Инициализировать(Разбор);
Р = Обр.Проверить(Выход, АргументыКоманднойСтроки[1], АргументыКоманднойСтроки[2], Префикс);
Отчет.ЗаписатьФайл(ОбъединитьПути(Выход, "reverse_build.json"), Отчет.ВJSON(Р));
Сводка = Отчет.ПрочитатьСводку(Выход);
Если Сводка <> Неопределено Тогда
	Сводка.Вставить("reverseBuild", Р.summary);
	Отчет.ЗаписатьФайл(ОбъединитьПути(Выход, "summary.json"), Отчет.ВJSON(Сводка));
КонецЕсли;
Обр.ВставитьВHtml(Р, ОбъединитьПути(Выход, "razbor_moduley.html"));
Лог = Новый Массив;
Обр.ДобавитьВЛог(Р, Лог);
Зп = Новый ЗаписьТекста(ОбъединитьПути(Выход, "log.txt"), "UTF-8", , Истина);
Для Каждого С Из Лог Цикл
	Зп.ЗаписатьСтроку(С);
	Сообщить(С);
КонецЦикла;
Зп.Закрыть();
