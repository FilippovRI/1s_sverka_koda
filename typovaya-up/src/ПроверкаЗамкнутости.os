// Статическая проверка замкнутости ссылок в каталоге restored (без платформы 1С).
// oscript ПроверкаЗамкнутости.os <restored> [--бп|--bp путь] [--уп|--up путь] [--json файл] [--txt файл]

Перем ЖурналПроверки;
Перем Заг;
Перем ВозвратБп;
Перем Отчет;
Перем РвV8Type;
Перем РвCfgInline;
Перем РвXrRef;
Перем РвStyle;
Перем РвDataPath;
Перем РвCommand;
Перем РвPicture;
Перем РвTypeSet;
Перем РвMetaPath;
Перем РвAttrName;
Перем РвTsName;
Перем РвEnumVal;
Перем КартаПапок;
Перем ТегиКорневые;

Функция ИнициализироватьРегексп() Экспорт
	РвV8Type = Новый РегулярноеВыражение("<v8:Type>([^<]+)</v8:Type>");
	РвCfgInline = Новый РегулярноеВыражение("cfg:([A-Za-zА-Яа-яЁё_][A-Za-zА-Яа-яЁё_0-9]*)\.([^\s""<]+)");
	РвXrRef = Новый РегулярноеВыражение("<xr:Ref>([^<]+)</xr:Ref>");
	РвStyle = Новый РегулярноеВыражение("(?:style:|StyleItem\.)([A-Za-zА-Яа-яЁё_][\wЁёА-Яа-яA-Za-z0-9_]*)");
	РвDataPath = Новый РегулярноеВыражение("<(?:DataPath|RowPictureDataPath|HeaderPictureDataPath)>([^<]+)</(?:DataPath|RowPictureDataPath|HeaderPictureDataPath)>");
	РвCommand = Новый РегулярноеВыражение("<CommandName>([^<]+)</CommandName>");
	РвPicture = Новый РегулярноеВыражение("<(?:Picture|RowsPicture)>\s*(?:<xr:Ref>)?([^<]+?)(?:</xr:Ref>)?\s*</(?:Picture|RowsPicture)>");
	РвTypeSet = Новый РегулярноеВыражение("<v8:TypeSet>([^<]+)</v8:TypeSet>");
	РвMetaPath = Новый РегулярноеВыражение("(?:Catalog|Document|Enum|InformationRegister|AccumulationRegister|AccountingRegister|ChartOfAccounts|ChartOfCharacteristicTypes|ChartOfCalculationTypes|BusinessProcess|Task|DataProcessor|Report|Constant|ChartOfAccounts|ExchangePlan)\.([\wЁёА-Яа-яA-Za-z0-9_]+)(?:\.(?:TabularSection|Attribute|Dimension|Resource|Command|Form|EnumValue)\.([\wЁёА-Яа-яA-Za-z0-9_]+))?");
	РвAttrName = Новый РегулярноеВыражение("(?s)<Attribute[^>]*>.*?<Name>([^<]+)</Name>");
	РвTsName = Новый РегулярноеВыражение("(?s)<TabularSection[^>]*>.*?<Name>([^<]+)</Name>");
	РвEnumVal = Новый РегулярноеВыражение("(?s)<EnumValue[^>]*>.*?<Name>([^<]+)</Name>");
КонецФункции

Процедура ПостроитьКартыТегов()
	КартаПапок = Заг.ПапкиМетаданных();
	ТегиКорневые = Новый Соответствие;
	Для Каждого КЗ Из КартаПапок Цикл
		ТегиКорневые.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Для Каждого Д Из СтрРазделить("Constant:Constants,Role:Roles,Subsystem:Subsystems,SessionParameter:SessionParameters,FunctionalOption:FunctionalOptions,"
		+ "Language:Languages,CommonModule:CommonModules,CommonForm:CommonForms,CommonTemplate:CommonTemplates,FilterCriterion:FilterCriteria,"
		+ "CommandGroup:CommandGroups,ScheduledJob:ScheduledJobs,EventSubscription:EventSubscriptions,WebService:WebServices,HTTPService:HTTPServices,"
		+ "ExchangePlan:ExchangePlans,BusinessProcess:BusinessProcesses,CalculationRegister:CalculationRegisters,SettingsStorage:SettingsStorages", ",") Цикл
		Ч = СтрРазделить(Д, ":");
		ТегиКорневые.Вставить(Ч[0], Ч[1]);
		КартаПапок.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
	Попытка
		ДД = Новый ДвоичныеДанные(Путь);
		Возврат ПолучитьСтрокуИзДвоичныхДанных(ДД, "UTF-8");
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ОтносительныйПуть(Полный)
	Возврат Сред(Полный, СтрДлина(ЖурналПроверки.корень) + 2);
КонецФункции

Функция ЕстьВСоставе(Состав, Тег, Имя)
	Если Состав = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Н = ВозвратБп.ИменаТега(Состав, Тег);
	Возврат Н.Получить(НРег(Имя)) <> Неопределено;
КонецФункции

Функция ПодсказкиОбъекта(Тег, Имя)
	Возврат Новый Структура("inBp, inUp", ЕстьВСоставе(ЖурналПроверки.составБп, Тег, Имя), ЕстьВСоставе(ЖурналПроверки.составУп, Тег, Имя));
КонецФункции

Процедура УчестьСчетчик(Класс)
	Если ЖурналПроверки.счетчики.Получить(Класс) = Неопределено Тогда
		ЖурналПроверки.счетчики.Вставить(Класс, 0);
	КонецЕсли;
	ЖурналПроверки.счетчики[Класс] = ЖурналПроверки.счетчики[Класс] + 1;
КонецПроцедуры

Процедура ДобавитьПроблему(Файл, Ссылка, Класс, Деталь = "", Тег = "", Имя = "")
	Ключ = Файл + "|" + Класс + "|" + Ссылка;
	Если ЖурналПроверки.уник.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЖурналПроверки.уник.Вставить(Ключ, Истина);
	УчестьСчетчик(Класс);
	Пд = ПодсказкиОбъекта(Тег, Имя);
	ЖурналПроверки.список.Добавить(Новый Структура("file, ref, class, detail, inBp, inUp", Файл, Ссылка, Класс, Деталь, Пд.inBp, Пд.inUp));
КонецПроцедуры

Функция ПутьМетаданных(Тег, Имя)
	Пап = КартаПапок.Получить(Тег);
	Если Пап = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОбъединитьПути(ЖурналПроверки.корень, Пап, Имя + ".xml");
КонецФункции

Функция ОбъектВRestored(Тег, Имя)
	К = Тег + "|" + НРег(Имя);
	Р = ЖурналПроверки.объекты.Получить(К);
	Если Р <> Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Если Не ЕстьВСоставе(ЖурналПроверки.составОсн, Тег, Имя) Тогда
		ЖурналПроверки.объекты.Вставить(К, Ложь);
		Возврат Ложь;
	КонецЕсли;
	Путь = ПутьМетаданных(Тег, Имя);
	Р = (Новый Файл(Путь)).Существует();
	ЖурналПроверки.объекты.Вставить(К, Р);
	Возврат Р;
КонецФункции

Функция СтруктураОбъекта(Тег, Имя)
	К = "S|" + Тег + "|" + НРег(Имя);
	Кэш = ЖурналПроверки.структуры.Получить(К);
	Если Кэш <> Неопределено Тогда
		Возврат Кэш;
	КонецЕсли;
	Ст = Новый Структура("attrs, ts, commands, forms", Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие);
	Путь = ПутьМетаданных(Тег, Имя);
	Т = ПрочитатьТекст(Путь);
	Если Т <> Неопределено Тогда
		Для Каждого С Из РвAttrName.НайтиСовпадения(Т) Цикл
			Ст.attrs.Вставить(НРег(С.Группы[1].Значение), С.Группы[1].Значение);
		КонецЦикла;
		Для Каждого С Из РвTsName.НайтиСовпадения(Т) Цикл
			ИмТс = С.Группы[1].Значение;
			Ст.ts.Вставить(НРег(ИмТс), Новый Соответствие);
		КонецЦикла;
		// атрибуты внутри TabularSection — грубо по блокам
		РвБлок = Новый РегулярноеВыражение("(?s)<TabularSection[^>]*>.*?<Name>([^<]+)</Name>(.*?)</TabularSection>");
		Для Каждого Б Из РвБлок.НайтиСовпадения(Т) Цикл
			ИмТс = Б.Группы[1].Значение;
			Кц = Ст.ts.Получить(НРег(ИмТс));
			Если Кц = Неопределено Тогда
				Кц = Новый Соответствие;
				Ст.ts.Вставить(НРег(ИмТс), Кц);
			КонецЕсли;
			Для Каждого А Из РвAttrName.НайтиСовпадения(Б.Группы[2].Значение) Цикл
				Кц.Вставить(НРег(А.Группы[1].Значение), А.Группы[1].Значение);
			КонецЦикла;
		КонецЦикла;
		Для Каждого С Из (Новый РегулярноеВыражение("(?s)<Command[^>]*>.*?<Name>([^<]+)</Name>")).НайтиСовпадения(Т) Цикл
			Ст.commands.Вставить(НРег(С.Группы[1].Значение), С.Группы[1].Значение);
		КонецЦикла;
	КонецЕсли;
	ЖурналПроверки.структуры.Вставить(К, Ст);
	Возврат Ст;
КонецФункции

Функция ЗначениеПеречисленияЕсть(ИмяПер, ИмяЗн)
	К = "E|" + НРег(ИмяПер);
	Зн = ЖурналПроверки.енумЗнач.Получить(К);
	Если Зн = Неопределено Тогда
		Зн = Новый Соответствие;
		Путь = ПутьМетаданных("Enum", ИмяПер);
		Т = ПрочитатьТекст(Путь);
		Если Т <> Неопределено Тогда
			Для Каждого С Из РвEnumVal.НайтиСовпадения(Т) Цикл
				Зн.Вставить(НРег(С.Группы[1].Значение), Истина);
			КонецЦикла;
		КонецЕсли;
		ЖурналПроверки.енумЗнач.Вставить(К, Зн);
	КонецЕсли;
	Возврат Зн.Получить(НРег(ИмяЗн)) <> Неопределено;
КонецФункции

Функция РазрешитьCfg(ТипCfg, Файл)
	СтрТип = СокрЛП(ТипCfg);
	Нт = НРег(СтрТип);
	Если Лев(Нт, 3) = "xs:" Или Лев(Нт, 3) = "v8:" Или Лев(Нт, 5) = "v8ui:" Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрТип = "StdPicture" Или Нт = "cfg:dynamiclist" Или Нт = "cfg:anyref" Тогда
		Возврат Истина;
	КонецЕсли;
	Р = Заг.РазборCfg(СтрТип);
	Если Р = Неопределено Тогда
		ДобавитьПроблему(Файл, СтрТип, "CfgType", "не разобран");
		Возврат Ложь;
	КонецЕсли;
	Если Р.Режим = "EnumValue" Тогда
		Если Не ОбъектВRestored("Enum", Р.Имя) Тогда
			ДобавитьПроблему(Файл, СтрТип, "EnumValue", "", "Enum", Р.Имя);
			Возврат Ложь;
		КонецЕсли;
		Если Не ЗначениеПеречисленияЕсть(Р.Имя, Р.Значение) Тогда
			ДобавитьПроблему(Файл, СтрТип, "EnumValue", "нет значения", "Enum", Р.Имя);
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Если Не ОбъектВRestored(Р.Тег, Р.Имя) Тогда
		ДобавитьПроблему(Файл, СтрТип, "CfgType", "", Р.Тег, Р.Имя);
		Возврат Ложь;
	КонецЕсли;
	// подсказка: ссылка на объект только из БП (есть в restored, нет в УП)
	Если ЕстьВСоставе(ЖурналПроверки.составБп, Р.Тег, Р.Имя) И Не ЕстьВСоставе(ЖурналПроверки.составУп, Р.Тег, Р.Имя) Тогда
		Если Р.Тег = "Document" И СтрНайти(СтрТип, "DocumentRef.") > 0 Тогда
			КП = "bpdoc|" + Файл + "|" + СтрТип;
			Если ЖурналПроверки.уник.Получить(КП) = Неопределено Тогда
				ЖурналПроверки.уник.Вставить(КП, Истина);
				ЖурналПроверки.bpOnly.Добавить(Новый Структура("file, ref, class", Файл, СтрТип, "DocumentRefBpOnly"));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Процедура ПроверитьXrRef(СсылкаТекст, Файл)
	З = СокрЛП(СсылкаТекст);
	Если З = "" Тогда
		Возврат;
	КонецЕсли;
	Если Лев(З, 11) = "StdPicture." Тогда
		Возврат;
	КонецЕсли;
	П = СтрНайти(З, ".");
	Если П = 0 Тогда
		ДобавитьПроблему(Файл, З, "XrRef");
		Возврат;
	КонецЕсли;
	Тег = Лев(З, П - 1);
	Хв = Сред(З, П + 1);
	Если Тег = "CommonPicture" Тогда
		Если Не ОбъектВRestored("CommonPicture", Хв) Тогда
			ДобавитьПроблему(Файл, З, "CommonPicture", "", "CommonPicture", Хв);
		КонецЕсли;
	ИначеЕсли Тег = "StyleItem" Тогда
		Если Не ОбъектВRestored("StyleItem", Хв) Тогда
			ДобавитьПроблему(Файл, З, "StyleItem", "", "StyleItem", Хв);
		КонецЕсли;
	ИначеЕсли КартаПапок.Получить(Тег) <> Неопределено Тогда
		Имя = Хв;
		П2 = СтрНайти(Хв, ".");
		Если П2 > 0 Тогда
			Имя = Лев(Хв, П2 - 1);
		КонецЕсли;
		Если Не ОбъектВRestored(Тег, Имя) Тогда
			ДобавитьПроблему(Файл, З, "XrRef", "", Тег, Имя);
		КонецЕсли;
	Иначе
		ДобавитьПроблему(Файл, З, "XrRef", "неизвестный тег " + Тег);
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьМетаПуть(ПутьМ, Файл)
	Ч = СтрРазделить(ПутьМ, ".");
	Если Ч.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	Тег = Ч[0];
	Имя = Ч[1];
	Если Не ОбъектВRestored(Тег, Имя) Тогда
		ДобавитьПроблему(Файл, ПутьМ, "MetadataPath", "", Тег, Имя);
		Возврат;
	КонецЕсли;
	Если Ч.Количество() >= 4 И (Ч[2] = "TabularSection" Или Ч[2] = "Attribute") Тогда
		Ст = СтруктураОбъекта(Тег, Имя);
		Если Ч[2] = "Attribute" Тогда
			Если Ст.attrs.Получить(НРег(Ч[3])) = Неопределено Тогда
				ДобавитьПроблему(Файл, ПутьМ, "MetadataPath", "нет реквизита", Тег, Имя);
			КонецЕсли;
		Иначе
			ИмТс = Ч[3];
			Если Ст.ts.Получить(НРег(ИмТс)) = Неопределено Тогда
				ДобавитьПроблему(Файл, ПутьМ, "MetadataPath", "нет ТЧ", Тег, Имя);
			ИначеЕсли Ч.Количество() >= 6 И Ч[4] = "Attribute" Тогда
				Кц = Ст.ts.Получить(НРег(ИмТс));
				Если Кц.Получить(НРег(Ч[5])) = Неопределено Тогда
					ДобавитьПроблему(Файл, ПутьМ, "MetadataPath", "нет колонки", Тег, Имя);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция РеквизитыФормы(Текст)
	Р = Новый Соответствие;
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]+)""[^>]*>(.*?)</Attribute>");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Имя = С.Группы[1].Значение;
		Блок = С.Группы[2].Значение;
		Гл = СтрНайти(Блок, "<MainAttribute>true</MainAttribute>") > 0;
		Кол = Новый Соответствие;
		РвК = Новый РегулярноеВыражение("(?s)<Column\s+name=""([^""]+)""");
		Для Каждого К Из РвК.НайтиСовпадения(Блок) Цикл
			Кол.Вставить(НРег(К.Группы[1].Значение), Истина);
		КонецЦикла;
		ТипГл = "";
		РвТ = Новый РегулярноеВыражение("<v8:Type>([^<]+)</v8:Type>");
		СТ = РвТ.НайтиСовпадения(Блок);
		Если СТ.Количество() > 0 Тогда
			ТипГл = СТ[0].Группы[1].Значение;
		КонецЕсли;
		Р.Вставить(НРег(Имя), Новый Структура("name, main, type, columns", Имя, Гл, ТипГл, Кол));
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ПроверитьDataPath(ПутьД, ФормАтр, Файл, МетаФормы)
	Путь = СтрЗаменить(ПутьД, "~", "");
	Ч = СтрРазделить(Путь, ".");
	Если Ч.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Ч[0] = "НаборКонстант" Тогда
		Если Ч.Количество() < 2 Тогда
			ДобавитьПроблему(Файл, ПутьД, "DataPath");
			Возврат;
		КонецЕсли;
		Если Не ОбъектВRestored("Constant", Ч[1]) Тогда
			ДобавитьПроблему(Файл, ПутьД, "DataPath", "константа", "Constant", Ч[1]);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Атр = ФормАтр.Получить(НРег(Ч[0]));
	Если Атр = Неопределено Тогда
		ДобавитьПроблему(Файл, ПутьД, "DataPath", "нет реквизита формы");
		Возврат;
	КонецЕсли;
	Если Ч.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
	Если Ч[0] = "Объект" Тогда
		Атр = ФормАтр.Получить("объект");
		Если Атр = Неопределено Тогда
			ДобавитьПроблему(Файл, ПутьД, "DataPath", "нет реквизита Объект");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Ч[0] = "Объект" Или (Атр.main И СтрНайти(Атр.type, "Object.") > 0) Тогда
		Р = Заг.РазборCfg(Атр.type);
		Если Р = Неопределено Тогда
			Если МетаФормы <> Неопределено Тогда
				ПроверитьМетаПуть(МетаФормы.tag + "." + МетаФормы.name + ".Attribute." + Ч[1], Файл);
			КонецЕсли;
			Возврат;
		КонецЕсли;
		Ст = СтруктураОбъекта(Р.Тег, Р.Имя);
		Если Ч.Количество() = 2 Тогда
			Стд = Новый Соответствие;
			Для Каждого Им Из СтрРазделить("Parent,Description,Code,Date,Number,Posted,Ref,DeletionMark,IsFolder,Owner,Predefined,LineNumber", ",") Цикл
				Стд.Вставить(НРег(Им), Истина);
			КонецЦикла;
			Если Стд.Получить(НРег(Ч[1])) <> Неопределено Тогда
				Возврат;
			КонецЕсли;
			Если Ст.attrs.Получить(НРег(Ч[1])) = Неопределено Тогда
				ДобавитьПроблему(Файл, Путь, "DataPath", "нет реквизита объекта", Р.Тег, Р.Имя);
			КонецЕсли;
		ИначеЕсли Ч.Количество() >= 3 Тогда
			Кц = Ст.ts.Получить(НРег(Ч[1]));
			Если Кц = Неопределено Тогда
				ДобавитьПроблему(Файл, ПутьД, "DataPath", "нет ТЧ объекта", Р.Тег, Р.Имя);
			ИначеЕсли Кц.Получить(НРег(Ч[2])) = Неопределено Тогда
				ДобавитьПроблему(Файл, ПутьД, "DataPath", "нет колонки ТЧ", Р.Тег, Р.Имя);
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Атр.columns.Количество() > 0 И Ч.Количество() >= 2 Тогда
		Если Атр.columns.Получить(НРег(Ч[1])) = Неопределено Тогда
			ДобавитьПроблему(Файл, ПутьД, "DataPath", "нет колонки ValueTable");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	// Список.* и прочее — только корневой реквизит проверен
КонецПроцедуры

Процедура ПроверитьCommandName(Имя, Файл)
	Если Лев(Имя, 5) = "Form." Тогда
		Возврат;
	КонецЕсли;
	П = СтрНайти(Имя, ".");
	Если П = 0 Тогда
		ДобавитьПроблему(Файл, Имя, "CommandName");
		Возврат;
	КонецЕсли;
	Тег = Лев(Имя, П - 1);
	Хв = Сред(Имя, П + 1);
	Если Тег = "CommonCommand" Тогда
		Если Не ОбъектВRestored("CommonCommand", Хв) Тогда
			ДобавитьПроблему(Файл, Имя, "CommandName", "", "CommonCommand", Хв);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	П2 = СтрНайти(Хв, ".Command.");
	Если П2 > 0 Тогда
		ИмОб = Лев(Хв, П2 - 1);
		ИмК = Сред(Хв, П2 + 9);
		Если Не ОбъектВRestored(Тег, ИмОб) Тогда
			ДобавитьПроблему(Файл, Имя, "CommandName", "", Тег, ИмОб);
			Возврат;
		КонецЕсли;
		Ст = СтруктураОбъекта(Тег, ИмОб);
		Если Ст.commands.Получить(НРег(ИмК)) = Неопределено Тогда
			ДобавитьПроблему(Файл, Имя, "CommandName", "нет команды", Тег, ИмОб);
		КонецЕсли;
	Иначе
		ДобавитьПроблему(Файл, Имя, "CommandName", "формат");
	КонецЕсли;
КонецПроцедуры

Функция МетаВладельцаФормы(ОтнФайл)
	М = Новый Структура("tag, name", "", "");
	Н = НРег(ОтнФайл);
	Для Каждого П Из СтрРазделить("Catalogs:Catalog,Documents:Document,DataProcessors:DataProcessor,Reports:Report,"
		+ "InformationRegisters:InformationRegister,AccumulationRegisters:AccumulationRegister,DocumentJournals:DocumentJournal,"
		+ "Tasks:Task,BusinessProcesses:BusinessProcess,ChartsOfCharacteristicTypes:ChartOfCharacteristicTypes,CommonForms:CommonForm", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Преф = НРег(Ч[0]) + "\";
		Если Лев(Н, СтрДлина(Преф)) = Преф Тогда
			Х = Сред(ОтнФайл, СтрДлина(Ч[0]) + 2);
			Части = СтрРазделить(Х, "\");
			М.tag = Ч[1];
			М.name = Части[0];
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат М;
КонецФункции

Процедура ПроверитьValueTableCfg(Текст, Файл)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]+""[^>]*>.*?<v8:Type>v8:ValueTable</v8:Type>.*?</Attribute>");
	Для Каждого Б Из Рв.НайтиСовпадения(Текст) Цикл
		Блок = Б.Значение;
		РвК = Новый РегулярноеВыражение("(?s)<Column[^>]*>.*?<v8:Type>(cfg:[^<]+)</v8:Type>");
		Для Каждого С Из РвК.НайтиСовпадения(Блок) Цикл
			ДобавитьПроблему(Файл, С.Группы[1].Значение, "FormValueTableCfgType", "ValueTable.Column");
			РазрешитьCfg(С.Группы[1].Значение, Файл);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция НуженСканФайла(ПолныйПуть)
	Ф = Новый Файл(ПолныйПуть);
	Имя = НРег(Ф.Имя);
	Если Имя = "configdumpinfo.xml" Тогда
		Возврат Ложь;
	КонецЕсли;
	Отн = Сред(ПолныйПуть, СтрДлина(ЖурналПроверки.корень) + 2);
	НОт = НРег(Отн);
	Если Имя = "form.xml" Тогда
		Возврат Истина;
	КонецЕсли;
	Если Имя = "template.xml" Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(НОт, "\forms\") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(НОт, "\ext\") > 0 И Имя <> "form.xml" И Имя <> "template.xml" Тогда
		Возврат Ложь;
	КонецЕсли;
	Папки = Новый Соответствие;
	Для Каждого П Из КартаПапок Цикл
		Папки.Вставить(НРег(П.Значение), Истина);
	КонецЦикла;
	Ч = СтрРазделить(Отн, "\");
	Если Ч.Количество() <> 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Папки.Получить(НРег(Ч[0])) <> Неопределено;
КонецФункции

Процедура СканироватьТекст(Текст, Отн, ЭтоФорма)
	ЖурналПроверки.файлов = ЖурналПроверки.файлов + 1;
	Если СтрНайти(Текст, "cfg:") = 0 И СтрНайти(Текст, "style:") = 0 И СтрНайти(Текст, "<xr:Ref>") = 0
		И СтрНайти(Текст, "<v8:TypeSet>") = 0 И Не ЭтоФорма Тогда
		Возврат;
	КонецЕсли;
	Для Каждого С Из РвV8Type.НайтиСовпадения(Текст) Цикл
		РазрешитьCfg(С.Группы[1].Значение, Отн);
	КонецЦикла;
	Для Каждого С Из РвCfgInline.НайтиСовпадения(Текст) Цикл
		РазрешитьCfg("cfg:" + С.Группы[1].Значение + "." + С.Группы[2].Значение, Отн);
	КонецЦикла;
	Для Каждого С Из РвTypeSet.НайтиСовпадения(Текст) Цикл
		РазрешитьCfg(С.Группы[1].Значение, Отн);
	КонецЦикла;
	Для Каждого С Из РвXrRef.НайтиСовпадения(Текст) Цикл
		ПроверитьXrRef(С.Группы[1].Значение, Отн);
	КонецЦикла;
	Для Каждого С Из РвStyle.НайтиСовпадения(Текст) Цикл
		Им = С.Группы[1].Значение;
		Если Не ОбъектВRestored("StyleItem", Им) Тогда
			ДобавитьПроблему(Отн, "style:" + Им, "StyleItem", "", "StyleItem", Им);
		КонецЕсли;
	КонецЦикла;
	РвПуть = Новый РегулярноеВыражение("(?:from|CharacteristicTypes|CharacteristicValues|CharacteristicExtValues|TypesFilterValue)[^""]*""([^""]+)""");
	Для Каждого С Из РвПуть.НайтиСовпадения(Текст) Цикл
		ПроверитьМетаПуть(С.Группы[1].Значение, Отн);
	КонецЦикла;
	РвДт = Новый РегулярноеВыражение(">(Catalog|Document|InformationRegister|AccumulationRegister|ChartOfAccounts|ChartOfCharacteristicTypes|BusinessProcess|Task|DataProcessor|Report|Constant|Enum)\.([\wЁёА-Яа-яA-Za-z0-9_\.]+)<");
	Для Каждого С Из РвДт.НайтиСовпадения(Текст) Цикл
		ПроверитьМетаПуть(С.Группы[1].Значение + "." + С.Группы[2].Значение, Отн);
	КонецЦикла;
	Если ЭтоФорма Тогда
		ФА = РеквизитыФормы(Текст);
		МФ = МетаВладельцаФормы(Отн);
		Для Каждого С Из РвDataPath.НайтиСовпадения(Текст) Цикл
			ПроверитьDataPath(С.Группы[1].Значение, ФА, Отн, МФ);
		КонецЦикла;
		Для Каждого С Из РвCommand.НайтиСовпадения(Текст) Цикл
			ПроверитьCommandName(С.Группы[1].Значение, Отн);
		КонецЦикла;
		ПроверитьValueTableCfg(Текст, Отн);
	КонецЕсли;
	Если СтрНайти(Текст, "<Picture>") > 0 Или СтрНайти(Текст, "<RowsPicture>") > 0 Тогда
		Для Каждого С Из РвPicture.НайтиСовпадения(Текст) Цикл
			ПроверитьXrRef(С.Группы[1].Значение, Отн);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьConfiguration()
	Путь = ОбъединитьПути(ЖурналПроверки.корень, "Configuration.xml");
	Т = ПрочитатьТекст(Путь);
	Если Т = Неопределено Тогда
		ДобавитьПроблему("Configuration.xml", "Configuration.xml", "Configuration", "не читается");
		Возврат;
	КонецЕсли;
	Для Каждого С Из (Новый РегулярноеВыражение("(?m)^\t\t\t<(\w+)>([^<]+)</\1>")).НайтиСовпадения(Т) Цикл
		Тег = С.Группы[1].Значение;
		Имя = С.Группы[2].Значение;
		Пап = КартаПапок.Получить(Тег);
		Если Пап = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ПутьО = ОбъединитьПути(ЖурналПроверки.корень, Пап, Имя + ".xml");
		Если Не (Новый Файл(ПутьО)).Существует() Тогда
			ДобавитьПроблему("Configuration.xml", Тег + "." + Имя, "ConfigChildMissing", "нет файла", Тег, Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьDefinedTypes()
	Кат = ОбъединитьПути(ЖурналПроверки.корень, "DefinedTypes");
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат;
	КонецЕсли;
	ПоUuid = Новый Соответствие;
	ПоИмени = Новый Соответствие;
	Для Каждого Ф Из НайтиФайлы(Кат, "*.xml", Ложь) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		РвU = Новый РегулярноеВыражение("<DefinedType uuid=""([^""]+)""");
		РвN = Новый РегулярноеВыражение("<Name>([^<]+)</Name>");
		Сu = РвU.НайтиСовпадения(Т);
		Сn = РвN.НайтиСовпадения(Т);
		Если Сu.Количество() = 0 Или Сn.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Uuid = Сu[0].Группы[1].Значение;
		Имя = Сn[0].Группы[1].Значение;
		Отн = ОтносительныйПуть(Ф.ПолноеИмя);
		Если ПоUuid.Получить(НРег(Uuid)) <> Неопределено Тогда
			ДобавитьПроблему(Отн, Uuid, "DefinedTypeDuplicateUuid", "дубль uuid " + ПоUuid.Получить(НРег(Uuid)));
		Иначе
			ПоUuid.Вставить(НРег(Uuid), Отн);
		КонецЕсли;
		Если ПоИмени.Получить(НРег(Имя)) <> Неопределено Тогда
			ДобавитьПроблему(Отн, Имя, "DefinedTypeDuplicateName", "дубль имени " + ПоИмени.Получить(НРег(Имя)));
		Иначе
			ПоИмени.Вставить(НРег(Имя), Отн);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Параметры: Корень — restored; КореньБп, КореньУп — опционально для inBp/inUp.
// Возвращает Структура ok, counts, unresolved, bpOnly, files, ms, version.
Процедура ИнициализироватьЖурнал(Корень, КореньБп, КореньУп, СоставОсн, СоставБп, СоставУп)
	ЖурналПроверки = Новый Структура;
	ЖурналПроверки.Вставить("корень", Корень);
	ЖурналПроверки.Вставить("составОсн", СоставОсн);
	ЖурналПроверки.Вставить("составБп", СоставБп);
	ЖурналПроверки.Вставить("составУп", СоставУп);
	ЖурналПроверки.Вставить("объекты", Новый Соответствие);
	ЖурналПроверки.Вставить("структуры", Новый Соответствие);
	ЖурналПроверки.Вставить("енумЗнач", Новый Соответствие);
	ЖурналПроверки.Вставить("счетчики", Новый Соответствие);
	ЖурналПроверки.Вставить("список", Новый Массив);
	ЖурналПроверки.Вставить("bpOnly", Новый Массив);
	ЖурналПроверки.Вставить("уник", Новый Соответствие);
	ЖурналПроверки.Вставить("файлов", 0);
КонецПроцедуры

Функция КаталогМодуляSrc()
	Кат = ТекущийСценарий().Каталог;
	Если (Новый Файл(ОбъединитьПути(Кат, "ЗаготовкиОбъектовБп.os"))).Существует() Тогда
		Возврат Кат;
	КонецЕсли;
	Кат2 = ОбъединитьПути(Кат, "..", "src");
	Если (Новый Файл(ОбъединитьПути(Кат2, "ЗаготовкиОбъектовБп.os"))).Существует() Тогда
		Возврат Кат2;
	КонецЕсли;
	Возврат Кат;
КонецФункции

Функция ВыполнитьПроверку(Корень, КореньБп = "", КореньУп = "") Экспорт
	ИнициализироватьРегексп();
	КатСк = КаталогМодуляSrc();
	Заг = ЗагрузитьСценарий(ОбъединитьПути(КатСк, "ЗаготовкиОбъектовБп.os"));
	ВозвратБп = ЗагрузитьСценарий(ОбъединитьПути(КатСк, "ВозвратОбщихМодулейБп.os"));
	ПостроитьКартыТегов();
	СостОсн = ВозвратБп.СоставКонфигурации(ОбъединитьПути(Корень, "Configuration.xml"));
	СостБп = ?(КореньБп = "", Неопределено, ВозвратБп.СоставКонфигурации(ОбъединитьПути(КореньБп, "Configuration.xml")));
	СостУп = ?(КореньУп = "", Неопределено, ВозвратБп.СоставКонфигурации(ОбъединитьПути(КореньУп, "Configuration.xml")));
	ИнициализироватьЖурнал(Корень, КореньБп, КореньУп, СостОсн, СостБп, СостУп);
	Т0 = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ПроверитьConfiguration();
	ПроверитьDefinedTypes();
	Для Каждого Ф Из НайтиФайлы(Корень, "*.xml", Истина) Цикл
		Если Не НуженСканФайла(Ф.ПолноеИмя) Тогда
			Продолжить;
		КонецЕсли;
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Отн = ОтносительныйПуть(Ф.ПолноеИмя);
		СканироватьТекст(Т, Отн, НРег(Ф.Имя) = "form.xml");
	КонецЦикла;
	Мс = ТекущаяУниверсальнаяДатаВМиллисекундах() - Т0;
	Сч = Новый Соответствие;
	Для Каждого КЗ Из ЖурналПроверки.счетчики Цикл
		Сч.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Возврат Новый Структура("ok, counts, unresolved, bpOnly, files, ms, version", ЖурналПроверки.список.Количество() = 0, Сч, ЖурналПроверки.список, ЖурналПроверки.bpOnly, ЖурналПроверки.файлов, Мс, "1");
КонецФункции

Процедура ЗаписатьОтчеты(Рез, ПутьJson, ПутьTxt) Экспорт
	Отчет = ЗагрузитьСценарий(ОбъединитьПути(КаталогМодуляSrc(), "ОтчетHTML.os"));
	Тело = Новый Структура("ok, counts, unresolved, bpOnly, files, ms, version", Рез.ok, Рез.counts, Рез.unresolved, Рез.bpOnly, Рез.files, Рез.ms, Рез.version);
	Отчет.ЗаписатьФайл(ПутьJson, Отчет.ВJSON(Тело));
	Текст = Новый ТекстовыйДокумент;
	Текст.ДобавитьСтроку("modcheck closure");
	Текст.ДобавитьСтроку("ok: " + ?(Рез.ok, "true", "false"));
	Текст.ДобавитьСтроку("files: " + Рез.files);
	Текст.ДобавитьСтроку("ms: " + Рез.ms);
	Текст.ДобавитьСтроку("unresolved total: " + Рез.unresolved.Количество());
	Текст.ДобавитьСтроку("--- counts by class ---");
	Для Каждого КЗ Из Рез.counts Цикл
		Текст.ДобавитьСтроку(КЗ.Ключ + ": " + КЗ.Значение);
	КонецЦикла;
	Текст.ДобавитьСтроку("--- top examples ---");
	Макс = Мин(10, Рез.unresolved.Количество());
	Для Й = 0 По Макс - 1 Цикл
		П = Рез.unresolved[Й];
		Текст.ДобавитьСтроку(П.class + "	" + П.file + "	" + П.ref + "	inBp=" + П.inBp + "	inUp=" + П.inUp);
	КонецЦикла;
	Текст.Записать(ПутьTxt, КодировкаТекста.UTF8);
КонецПроцедуры

// CLI: oscript ЗапускПроверкаЗамкнутости.os <restored> [...]
Процедура ЗапускИзКоманднойСтроки() Экспорт
	Корень = "";
	КореньБп = "";
	КореньУп = "";
	ПутьJson = "";
	ПутьTxt = "";
	Если АргументыКоманднойСтроки.Количество() = 0 Тогда
		Сообщить("usage: oscript ЗапускПроверкаЗамкнутости.os <restored> [--бп path] [--уп path] [--json path] [--txt path]");
		ЗавершитьРаботу(2);
	КонецЕсли;
	Корень = АргументыКоманднойСтроки[0];
	Для Й = 1 По АргументыКоманднойСтроки.ВГраница() Цикл
		А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
		Если (А = "--бп" Или А = "--bp") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
			КореньБп = АргументыКоманднойСтроки[Й + 1];
			Й = Й + 1;
		ИначеЕсли (А = "--уп" Или А = "--up") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
			КореньУп = АргументыКоманднойСтроки[Й + 1];
			Й = Й + 1;
		ИначеЕсли А = "--json" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
			ПутьJson = АргументыКоманднойСтроки[Й + 1];
			Й = Й + 1;
		ИначеЕсли А = "--txt" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
			ПутьTxt = АргументыКоманднойСтроки[Й + 1];
			Й = Й + 1;
		КонецЕсли;
	КонецЦикла;
	Если ПутьJson = "" Тогда
		ПутьJson = ОбъединитьПути(Корень, "modcheck_closure.json");
	КонецЕсли;
	Если ПутьTxt = "" Тогда
		ПутьTxt = ОбъединитьПути(Корень, "modcheck_closure.txt");
	КонецЕсли;
	Р = ВыполнитьПроверку(Корень, КореньБп, КореньУп);
	ЗаписатьОтчеты(Р, ПутьJson, ПутьTxt);
	Сообщить("modcheck_closure: ok=" + ?(Р.ok, "true", "false") + " unresolved=" + Р.unresolved.Количество() + " files=" + Р.files + " ms=" + Р.ms);
	ЗавершитьРаботу(?(Р.ok, 0, 1));
КонецПроцедуры

Если АргументыКоманднойСтроки.Количество() > 0
	И НРег((Новый Файл(ТекущийСценарий().Источник)).Имя) = "проверказамкнутости.os" Тогда
	ЗапускИзКоманднойСтроки();
КонецЕсли;