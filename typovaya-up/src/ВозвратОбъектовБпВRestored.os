// Решение 24.11 (t716s2524): общие модули только БП, на которые ссылается код restored, возвращаются в restored из выгрузки БП
// вместе с транзитивной цепочкой ОМ (ссылки «Имя.», модуль как значение, вызовы методов глобальных ОМ). Другие объекты БП
// (документы, регистры, справочники, перечисления, картинки, роли, подсистемы…) не возвращаются: ссылки на отсутствующие в
// restored объекты из возвращённых модулей пишутся в todo (md+csv). Класс 3 (реквизиты, ТЧ, измерения, ресурсы, значения
// перечислений у объектов УП) не добавляется — только перечисляется в todo. Модули копируются как есть (XML с флагами +
// Ext); собственные объекты/заглушки extension с теми же именами удаляются (заимствованные остаются). Исключения — файл
// return_bp_exclude.txt в каталоге отчёта (по имени ОМ в строке): модули из него не возвращаются (todo). Выгрузка БП только читается.

Перем Вб;
Перем ОТУ;
Перем ДС;

Функция Инициализировать() Экспорт
	Кат = ТекущийСценарий().Каталог;
	Вб = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ВозвратОбщихМодулейБп.os"));
	ОТУ = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ОбъектыТолькоУп.os"));
	ДС = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЗапросыДинСписков.os"));
КонецФункции

// Структура(added — Соответствие «CommonModule.Имя» -> откуда, order, byTag, files, configLines, extRemoved, todo — Массив Структура).
Функция Вернуть(КаталогВосст, КореньБп, КаталогРас, Лог, КаталогОтчёта = "", ТолькоАнализ = Ложь) Экспорт
	Инициализировать();
	Осн = Вб.СоставКонфигурации(ОбъединитьПути(КаталогВосст, "Configuration.xml"));
	Бп = Вб.СоставКонфигурации(ОбъединитьПути(КореньБп, "Configuration.xml"));
	Рез = Новый Структура("added, order, byTag, files, configLines, extRemoved, todo, todoKeys, excluded, cached", Новый Соответствие, Новый Массив,
		Новый Соответствие, 0, 0, 0, Новый Массив, Новый Соответствие, Новый Массив, Ложь);
	Исключения = Новый Соответствие;
	Если КаталогОтчёта <> "" Тогда
		Тх = Вб.ПрочитатьТекст(ОбъединитьПути(КаталогОтчёта, "return_bp_exclude.txt"));
		Если Тх <> Неопределено Тогда
			Для Каждого Стр Из СтрРазделить(Тх, Символы.ПС, Ложь) Цикл
				Им = СокрЛП(СтрЗаменить(СтрЗаменить(Стр, Символы.ВК, ""), "CommonModule.", ""));
				Если Им <> "" И Лев(Им, 1) <> "#" Тогда
					Исключения.Вставить(НРег(Им), Им);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	ОснМ = Вб.ИменаТега(Осн, "CommonModule");
	// инкрементность: входы не изменились с прошлого прогона (тексты restored те же или их меньше, ОМ restored не меньше,
	// Configuration.xml БП и исключения те же) — скан (~20 мин) пропускается, нового к возврату нет.
	ПутьКэша = ?(КаталогОтчёта = "", "", ОбъединитьПути(ОбъединитьПути(КаталогОтчёта, "cache"), "return_bp_objects.txt"));
	Если ПутьКэша <> "" И Не ТолькоАнализ И КэшАктуален(ПутьКэша, КаталогВосст, КореньБп, КаталогОтчёта, ОснМ) Тогда
		Рез.cached = Истина;
		Лог.Добавить("Возврат ОМ только БП в restored: пропущен — входы не изменились (кэш " + ПутьКэша + ")");
		Возврат Рез;
	КонецЕсли;
	Кандидаты = Новый Соответствие;
	Для Каждого КЗ Из Вб.ИменаТега(Бп, "CommonModule") Цикл
		Если ОснМ.Получить(КЗ.Ключ) = Неопределено Тогда
			Кандидаты.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	ГлобМетоды = Новый Соответствие;
	Для Каждого КЗ Из Кандидаты Цикл
		Х = Вб.ПрочитатьТекст(ОбъединитьПути(КореньБп, "CommonModules", КЗ.Значение + ".xml"));
		Если Х <> Неопределено И СтрНайти(Х, "<Global>true</Global>") > 0 Тогда
			Т = Вб.ПрочитатьТекст(ПутьМодуля(КореньБп, КЗ.Значение));
			Если Т <> Неопределено Тогда
				Для Каждого М Из Вб.ОбъявленныеМетоды(Вб.КодБезЛитералов(Т), Истина) Цикл
					ГлобМетоды.Вставить(М.Ключ, КЗ.Значение);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Очередь = Новый Массив;
	Ктх = Новый Структура("Осн, Бп, Кандидаты, ГлобМетоды, Очередь, Рез, Исключения, КаталогВосст, КэшXml", Осн, Бп, Кандидаты, ГлобМетоды,
		Очередь, Рез, Исключения, КаталогВосст, Новый Соответствие);
	// семена: код restored
	Для Каждого Ф Из НайтиФайлы(КаталогВосст, "*.bsl", Истина) Цикл
		СсылкиИзКода(Вб.ПрочитатьТекст(Ф.ПолноеИмя), Ктх, "restored:" + Сред(Ф.ПолноеИмя, СтрДлина(КаталогВосст) + 2), Истина);
	КонецЦикла;
	// и модули уровня конфигурации в редакции БП (restored несёт их текст БП; вызовы могли быть вырезаны шагом appModuleBpCalls)
	Для Каждого Ф Из НайтиФайлы(ОбъединитьПути(КореньБп, "Ext"), "*.bsl", Ложь) Цикл
		Если (Новый Файл(ОбъединитьПути(КаталогВосст, "Ext", Ф.Имя))).Существует() Тогда
			СсылкиИзКода(Вб.ПрочитатьТекст(Ф.ПолноеИмя), Ктх, "БП:Ext/" + Ф.Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	// замыкание только по ОМ
	Й = 0;
	Пока Й < Очередь.Количество() Цикл
		Ключ = Очередь[Й];
		Й = Й + 1;
		СсылкиИзКода(Вб.ПрочитатьТекст(ПутьМодуля(КореньБп, Сред(Ключ, 14))), Ктх, Ключ, Ложь);
	КонецЦикла;
	Рез.byTag.Вставить("CommonModule", Рез.order.Количество());
	Если Не ТолькоАнализ Тогда
		Применить(КаталогВосст, КореньБп, КаталогРас, Рез);
	КонецЕсли;
	Отс = 0;
	Кл3 = 0;
	Для Каждого Т Из Рез.todo Цикл
		Если СтрНачинаетсяС(Т.kind, "класс 3") Тогда
			Кл3 = Кл3 + 1;
		Иначе
			Отс = Отс + 1;
		КонецЕсли;
	КонецЦикла;
	Лог.Добавить("Возврат ОМ только БП в restored" + ?(ТолькоАнализ, " (анализ)", "") + ": " + Рез.order.Количество()
		+ "; файлов " + Рез.files + ", строк Configuration.xml " + Рез.configLines + ", убрано из extension " + Рез.extRemoved
		+ ", исключено " + Рез.excluded.Количество() + "; todo: ссылок на отсутствующие объекты " + Отс + ", класс 3 " + Кл3);
	Если ПутьКэша <> "" И Не ТолькоАнализ Тогда
		ЗаписатьКэш(ПутьКэша, КаталогВосст, КореньБп, КаталогОтчёта);
	КонецЕсли;
	Если КаталогОтчёта <> "" Тогда
		Отч = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ОтчетHTML.os"));
		Отч.ЗаписатьФайл(ОбъединитьПути(КаталогОтчёта, "bp_objects_returned.json"), Отч.ВJSON(Новый Структура("byTag, order, added, excluded, files, configLines, extRemoved, todoCount",
			Рез.byTag, Рез.order, Рез.added, Рез.excluded, Рез.files, Рез.configLines, Рез.extRemoved, Рез.todo.Количество())));
		ЗаписатьTodo(КаталогОтчёта, Рез);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ХешТекста(Т)
	Х = Новый ХешированиеДанных(ХешФункция.MD5);
	Х.Добавить(?(Т = Неопределено, "", Т));
	Возврат Строка(Х.ХешСуммаСтрокой);
КонецФункции

Функция ШапкаКэша(КаталогВосст, КореньБп, КаталогОтчёта)
	Возврат ХешТекста(Вб.ПрочитатьТекст(ОбъединитьПути(КореньБп, "Configuration.xml"))) + "|"
		+ ХешТекста(Вб.ПрочитатьТекст(ОбъединитьПути(КаталогОтчёта, "return_bp_exclude.txt")));
КонецФункции

Функция ОтпечаткиBsl(КаталогВосст)
	Р = Новый Соответствие;
	Длина = СтрДлина(КаталогВосст);
	Для Каждого Ф Из НайтиФайлы(КаталогВосст, "*.bsl", Истина) Цикл
		Р.Вставить(НРег(Сред(Ф.ПолноеИмя, Длина + 2)), Строка(Ф.Размер()) + "|" + Формат(Ф.ПолучитьВремяИзменения(), "ДФ=yyyyMMddHHmmss"));
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ЗаписатьКэш(ПутьКэша, КаталогВосст, КореньБп, КаталогОтчёта)
	Строки = Новый Массив;
	Строки.Добавить(ШапкаКэша(КаталогВосст, КореньБп, КаталогОтчёта));
	ОМ = Новый Массив;
	// только ОМ, которые есть в БП (ОМ только УП позже убираются из restored шагом upOnlyCmFromRestored)
	БпМ = Вб.ИменаТега(Вб.СоставКонфигурации(ОбъединитьПути(КореньБп, "Configuration.xml")), "CommonModule");
	Для Каждого КЗ Из Вб.ИменаТега(Вб.СоставКонфигурации(ОбъединитьПути(КаталогВосст, "Configuration.xml")), "CommonModule") Цикл
		Если БпМ.Получить(КЗ.Ключ) <> Неопределено Тогда
			ОМ.Добавить(КЗ.Ключ);
		КонецЕсли;
	КонецЦикла;
	Строки.Добавить(СтрСоединить(ОМ, ","));
	Для Каждого КЗ Из ОтпечаткиBsl(КаталогВосст) Цикл
		Строки.Добавить(КЗ.Ключ + Символы.Таб + КЗ.Значение);
	КонецЦикла;
	СоздатьКаталог((Новый Файл(ПутьКэша)).Путь);
	ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ПС), КодировкаТекста.UTF8, Ложь).Записать(ПутьКэша);
КонецПроцедуры

// Вызывается в конце сборки: поздние шаги (upOnlyCmFromRestored, appModuleBpCalls…) меняют тексты restored, и кэш,
// записанный в конце шага возврата, иначе не совпал бы со следующим запуском.
Процедура ОбновитьКэш(КаталогВосст, КореньБп, КаталогОтчёта) Экспорт
	Если КаталогОтчёта = "" Тогда
		Возврат;
	КонецЕсли;
	ЗаписатьКэш(ОбъединитьПути(ОбъединитьПути(КаталогОтчёта, "cache"), "return_bp_objects.txt"), КаталогВосст, КореньБп, КаталогОтчёта);
КонецПроцедуры

Функция КэшАктуален(ПутьКэша, КаталогВосст, КореньБп, КаталогОтчёта, ОснМ)
	Т = Вб.ПрочитатьТекст(ПутьКэша);
	Если Т = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Строки = СтрРазделить(СтрЗаменить(Т, Символы.ВК, ""), Символы.ПС, Истина);
	Если Строки.Количество() < 2 Или Строки[0] <> ШапкаКэша(КаталогВосст, КореньБп, КаталогОтчёта) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Им Из СтрРазделить(Строки[1], ",", Ложь) Цикл
		Если ОснМ.Получить(Им) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Было = Новый Соответствие;
	Для Н = 2 По Строки.ВГраница() Цикл
		Поз = СтрНайти(Строки[Н], Символы.Таб);
		Если Поз > 0 Тогда
			Было.Вставить(Лев(Строки[Н], Поз - 1), Сред(Строки[Н], Поз + 1));
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из ОтпечаткиBsl(КаталогВосст) Цикл
		Если Было.Получить(КЗ.Ключ) <> КЗ.Значение Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ПутьМодуля(Корень, Имя)
	Возврат ОбъединитьПути(Корень, "CommonModules", Имя, "Ext") + ПолучитьРазделительПути() + "Module.bsl";
КонецФункции

Процедура ДобавитьОм(Имя, Ктх, Откуда)
	Ключ = "CommonModule." + Имя;
	Если Ктх.Рез.added.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Ктх.Исключения.Получить(НРег(Имя)) <> Неопределено Тогда
		Если Ктх.Рез.excluded.Найти(Имя) = Неопределено Тогда
			Ктх.Рез.excluded.Добавить(Имя);
		КонецЕсли;
		ВTodo(Ктх, Откуда, 0, Ключ, "ОМ исключён (return_bp_exclude.txt)");
		Возврат;
	КонецЕсли;
	Ктх.Рез.added.Вставить(Ключ, Откуда);
	Ктх.Рез.order.Добавить(Ключ);
	Ктх.Очередь.Добавить(Ключ);
КонецПроцедуры

Процедура ВTodo(Ктх, Модуль, НомерСтроки, Ссылка, Вид)
	К = Модуль + "|" + НомерСтроки + "|" + Ссылка;
	Если Ктх.Рез.todoKeys.Получить(К) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ктх.Рез.todoKeys.Вставить(К, Истина);
	Ктх.Рез.todo.Добавить(Новый Структура("module, line, ref, kind", Модуль, НомерСтроки, Ссылка, Вид));
КонецПроцедуры

Процедура СсылкиИзКода(Текст, Ктх, Откуда, ТолькоМодули)
	Если Текст = Неопределено Или Текст = "" Тогда
		Возврат;
	КонецЕсли;
	Код = Вб.КодБезЛитералов(Текст);
	Для Каждого КЗ Из Вб.ИменаМодулейКакЗначения(Код, Ктх.Кандидаты) Цикл
		ДобавитьОм(КЗ.Значение, Ктх, Откуда);
	КонецЦикла;
	Для Каждого КЗ Из Вб.Квалификаторы(Код) Цикл
		Имя = Ктх.Кандидаты.Получить(КЗ.Ключ);
		Если Имя <> Неопределено Тогда
			ДобавитьОм(Имя, Ктх, Откуда);
		КонецЕсли;
	КонецЦикла;
	Если Ктх.ГлобМетоды.Количество() > 0 Тогда
		Свои = Вб.ОбъявленныеМетоды(Код);
		Для Каждого КЗ Из Вб.Вызовы(Код) Цикл
			Имя = Ктх.ГлобМетоды.Получить(КЗ.Ключ);
			Если Имя <> Неопределено И Свои.Получить(КЗ.Ключ) = Неопределено Тогда
				ДобавитьОм(Имя, Ктх, Откуда);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если ТолькоМодули Тогда
		Возврат;
	КонецЕсли;
	// todo: ссылки возвращённого модуля на отсутствующие в restored объекты и класс 3
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	СтрокиКода = СтрРазделить(СтрЗаменить(Код, Символы.ВК, ""), Символы.ПС, Истина);
	Для Н = 0 По Строки.ВГраница() Цикл
		Стр = Строки[Н];
		Если СтрНайти(Стр, ".") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из Вб.СсылкиНаОбъекты(Стр) Цикл
			Если С.Тег = "CommonModule" Тогда
				Продолжить;
			КонецЕсли;
			Если Вб.ИменаТега(Ктх.Осн, С.Тег).Получить(НРег(С.Имя)) = Неопределено Тогда
				ВTodo(Ктх, Откуда, Н + 1, С.Тег + "." + С.Имя, "объект отсутствует в restored" + ?(Вб.ИменаТега(Ктх.Бп, С.Тег).Получить(НРег(С.Имя)) = Неопределено, " (и в БП)", ""));
			КонецЕсли;
		КонецЦикла;
		Класс3(Стр, ?(Н <= СтрокиКода.ВГраница(), СтрокиКода[Н], ""), Ктх, Откуда, Н + 1);
	КонецЦикла;
КонецПроцедуры

// Класс 3: значение перечисления / реквизит, ТЧ, измерение, ресурс существующего в restored объекта, которого в нём нет.
Процедура Класс3(Стр, СтрКода, Ктх, Откуда, НомерСтроки)
	Для Каждого С Из (Новый РегулярноеВыражение("(?<![\wЁё.])Перечисления\.([\wЁё]+)\.([\wЁё]+)(?![\wЁё]*\s*\()")).НайтиСовпадения(СтрКода) Цикл
		ПроверитьДочерний("Enum", С.Группы[1].Значение, С.Группы[2].Значение, "значение перечисления", Ктх, Откуда, НомерСтроки);
	КонецЦикла;
	Для Каждого С Из (Новый РегулярноеВыражение("""Перечисление\.([\wЁё]+)\.([\wЁё]+)""")).НайтиСовпадения(Стр) Цикл
		ПроверитьДочерний("Enum", С.Группы[1].Значение, С.Группы[2].Значение, "значение перечисления", Ктх, Откуда, НомерСтроки);
	КонецЦикла;
	Карта = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Справочники=Catalog,Документы=Document,РегистрыСведений=InformationRegister,РегистрыНакопления=AccumulationRegister,"
		+ "РегистрыБухгалтерии=AccountingRegister,ПланыВидовХарактеристик=ChartOfCharacteristicTypes,ПланыСчетов=ChartOfAccounts,"
		+ "ПланыОбмена=ExchangePlan,БизнесПроцессы=BusinessProcess,Задачи=Task,Перечисления=Enum", ",") Цикл
		Ч2 = СтрРазделить(П, "=");
		Карта.Вставить(НРег(Ч2[0]), Ч2[1]);
	КонецЦикла;
	Для Каждого С Из (Новый РегулярноеВыражение("Метаданные\.([\wЁё]+)\.([\wЁё]+)\.(Реквизиты|ТабличныеЧасти|Измерения|Ресурсы|ЗначенияПеречисления)\.([\wЁё]+)")).НайтиСовпадения(СтрКода) Цикл
		Тег = Карта.Получить(НРег(С.Группы[1].Значение));
		Если Тег <> Неопределено И НРег(С.Группы[4].Значение) <> "найти" Тогда
			ПроверитьДочерний(Тег, С.Группы[2].Значение, С.Группы[4].Значение, НРег(С.Группы[3].Значение), Ктх, Откуда, НомерСтроки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ПроверитьДочерний(Тег, Объект, Дочерний, Вид, Ктх, Откуда, НомерСтроки)
	Канон = Вб.ИменаТега(Ктх.Осн, Тег).Получить(НРег(Объект));
	Если Канон = Неопределено Тогда
		Возврат; // объекта нет — уже в todo как отсутствующий объект
	КонецЕсли;
	Ключ = Тег + "." + Канон;
	Х = Ктх.КэшXml.Получить(Ключ);
	Если Х = Неопределено Тогда
		Х = Вб.ПрочитатьТекст(ОбъединитьПути(Ктх.КаталогВосст, ОТУ.КаталогПоКлассу(Тег), Канон + ".xml"));
		Х = ?(Х = Неопределено, "", НРег(Х));
		Ктх.КэшXml.Вставить(Ключ, Х);
	КонецЕсли;
	Если Х = "" Или СтрНайти(Х, "<name>" + НРег(Дочерний) + "</name>") > 0 Тогда
		Возврат;
	КонецЕсли;
	ВTodo(Ктх, Откуда, НомерСтроки, Ключ + "." + Дочерний, "класс 3: " + Вид + " отсутствует у объекта УП (не добавляется)");
КонецПроцедуры

Процедура ЗаписатьTodo(Каталог, Рез)
	Csv = Новый Массив;
	Csv.Добавить("Модуль;Строка;Ссылка;Вид");
	Md = Новый Массив;
	Md.Добавить("# Что исправить: возвращённые ОМ только БП");
	Md.Добавить("");
	Md.Добавить("Вернулось ОМ: " + Рез.order.Количество() + ", исключено: " + Рез.excluded.Количество() + ", строк todo: " + Рез.todo.Количество() + ".");
	Md.Добавить("");
	Md.Добавить("Правила: другие объекты БП (документы, регистры, справочники, перечисления, картинки, роли, подсистемы…) в restored не возвращаются;");
	Md.Добавить("класс 3 — реквизиты, ТЧ, измерения, ресурсы и значения перечислений у объектов УП не добавляются, только перечисляются здесь.");
	Md.Добавить("");
	Md.Добавить("| Модуль | Строка | Ссылка | Вид |");
	Md.Добавить("|---|---|---|---|");
	Для Каждого Т Из Рез.todo Цикл
		Csv.Добавить(Т.module + ";" + Т.line + ";" + Т.ref + ";" + Т.kind);
		Md.Добавить("| " + Т.module + " | " + Т.line + " | " + Т.ref + " | " + Т.kind + " |");
	КонецЦикла;
	ЗаписатьUtf8(ОбъединитьПути(Каталог, "todo_bp_modules_returned.csv"), СтрСоединить(Csv, Символы.ВК + Символы.ПС));
	ЗаписатьUtf8(ОбъединитьПути(Каталог, "todo_bp_modules_returned.md"), СтрСоединить(Md, Символы.ВК + Символы.ПС));
КонецПроцедуры

Процедура ЗаписатьUtf8(Путь, Текст)
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

Процедура КопироватьКаталог(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Ложь) Цикл
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталог(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		Иначе
			КопироватьФайл(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура Применить(КаталогВосст, КореньБп, КаталогРас, Рез)
	ПоТегу = Новый Соответствие;
	Для Каждого Ключ Из Рез.order Цикл
		Ч_ = СтрРазделить(Ключ, ".");
		Тег = Ч_[0];
		Имя = Ч_[1];
		Папка = ОТУ.КаталогПоКлассу(Тег);
		Откуда = ОбъединитьПути(КореньБп, Папка, Имя + ".xml");
		Если Папка = "" Или Не (Новый Файл(Откуда)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		СоздатьКаталог(ОбъединитьПути(КаталогВосст, Папка));
		КопироватьФайл(Откуда, ОбъединитьПути(КаталогВосст, Папка, Имя + ".xml"));
		Рез.files = Рез.files + 1;
		Кат = ОбъединитьПути(КореньБп, Папка, Имя);
		Если (Новый Файл(Кат)).Существует() Тогда
			КопироватьКаталог(Кат, ОбъединитьПути(КаталогВосст, Папка, Имя));
		КонецЕсли;
		Сп = ПоТегу.Получить(Тег);
		Если Сп = Неопределено Тогда
			Сп = Новый Массив;
			ПоТегу.Вставить(Тег, Сп);
		КонецЕсли;
		Сп.Добавить(Имя);
		Рез.extRemoved = Рез.extRemoved + УбратьИзРасширения(КаталогРас, Тег, Папка, Имя);
	КонецЦикла;
	Рез.configLines = ДобавитьСтрокиКонфигурации(ОбъединитьПути(КаталогВосст, "Configuration.xml"), ПоТегу);
	Если КаталогРас <> "" Тогда
		Удалять = Новый Соответствие;
		Для Каждого КЗ Из ПоТегу Цикл
			Для Каждого Имя Из КЗ.Значение Цикл
				Путь = ОбъединитьПути(КаталогРас, ОТУ.КаталогПоКлассу(КЗ.Ключ), Имя + ".xml");
				Если Не (Новый Файл(Путь)).Существует() Тогда
					Удалять.Вставить("<" + КЗ.Ключ + ">" + Имя + "</" + КЗ.Ключ + ">", Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		УдалитьСтрокиВФайле(ОбъединитьПути(КаталогРас, "Configuration.xml"), Удалять);
	КонецЕсли;
КонецПроцедуры

// Собственный объект/заглушка extension с тем же именем удаляется (заимствованный остаётся).
Функция УбратьИзРасширения(КаталогРас, Тег, Папка, Имя)
	Если КаталогРас = "" Тогда
		Возврат 0;
	КонецЕсли;
	Путь = ОбъединитьПути(КаталогРас, Папка, Имя + ".xml");
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат 0;
	КонецЕсли;
	Если СтрНайти(ОТУ.ПрочитатьТекст(Путь), "<ObjectBelonging>Adopted</ObjectBelonging>") > 0 Тогда
		Возврат 0;
	КонецЕсли;
	УдалитьФайлы(Путь);
	Кат = ОбъединитьПути(КаталогРас, Папка, Имя);
	Если (Новый Файл(Кат)).Существует() Тогда
		УдалитьФайлы(Кат);
	КонецЕсли;
	Возврат 1;
КонецФункции

Функция УдалитьСтрокиВФайле(Путь, Удалять)
	С = ДС.ПрочитатьСырой(Путь);
	Если С = Неопределено Или Удалять.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Нов = Новый Массив;
	Кол = 0;
	Для Каждого Стр Из СтрРазделить(С.Текст, Символы.ПС, Истина) Цикл
		Если Удалять.Получить(СокрЛП(Стр)) <> Неопределено Тогда
			Кол = Кол + 1;
			Продолжить;
		КонецЕсли;
		Нов.Добавить(Стр);
	КонецЦикла;
	Если Кол > 0 Тогда
		ДС.ЗаписатьСырой(Путь, СтрСоединить(Нов, Символы.ПС), С.BOM);
	КонецЕсли;
	Возврат Кол;
КонецФункции

// Вставка <Тег>Имя</Тег> после последней строки того же тега (иначе перед </ChildObjects>).
Функция ДобавитьСтрокиКонфигурации(ПутьКонф, ПоТегу)
	С = ДС.ПрочитатьСырой(ПутьКонф);
	Если С = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	ПС = ?(СтрНайти(С.Текст, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Строки = СтрРазделить(СтрЗаменить(С.Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Есть = Вб.СоставКонфигурации(ПутьКонф);
	Кол = 0;
	Для Каждого КЗ Из ПоТегу Цикл
		Тег = КЗ.Ключ;
		Им = Вб.ИменаТега(Есть, Тег);
		Вставка = Новый Массив;
		Для Каждого Имя Из КЗ.Значение Цикл
			Если Им.Получить(НРег(Имя)) = Неопределено Тогда
				Вставка.Добавить("			<" + Тег + ">" + Имя + "</" + Тег + ">");
			КонецЕсли;
		КонецЦикла;
		Если Вставка.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Поз = -1;
		Для Н = 0 По Строки.ВГраница() Цикл
			Если СтрНачинаетсяС(СокрЛП(Строки[Н]), "<" + Тег + ">") Тогда
				Поз = Н;
			КонецЕсли;
		КонецЦикла;
		Если Поз < 0 Тогда
			Для Н = 0 По Строки.ВГраница() Цикл
				Если СокрЛП(Строки[Н]) = "</ChildObjects>" Тогда
					Поз = Н - 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если Поз < 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Н = 0 По Вставка.ВГраница() Цикл
			Строки.Вставить(Поз + 1 + Н, Вставка[Н]);
		КонецЦикла;
		Кол = Кол + Вставка.Количество();
	КонецЦикла;
	Если Кол > 0 Тогда
		ДС.ЗаписатьСырой(ПутьКонф, СтрСоединить(Строки, ПС), С.BOM);
	КонецЕсли;
	Возврат Кол;
КонецФункции
