// Формирование summary.json, report.json и автономного HTML-отчёта
// (компактный JSON внутри <script type="application/json">, без полных текстов модулей).

// Сериализация значения в компактный JSON (одна строка).
//
// Параметры:
//   Значение — структура/массив/примитив, допустимый для ЗаписатьJSON.
//
// Возвращаемое значение:
//   Строка JSON без переносов.
Функция ВJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

// Сводка для summary.json: корзины, пути, агрегат хуков по методам.
//
// Параметры:
//   Модули — массив описаний модулей после Сравнение (поля bucket, path, methods).
//   Мета — произвольная структура (попадает в meta).
//
// Возвращаемое значение:
//   Структура meta, total, counts, hooks, paths. Побочных эффектов и записи файлов нет.
Функция СобратьСводку(Модули, Мета) Экспорт
	Корзины = СтрРазделить("identical,cosmetic,auto,manual,only_source,only_vendor", ",");
	Числа = Новый Структура;
	Списки = Новый Структура;
	Для Каждого К Из Корзины Цикл
		Числа.Вставить(К, 0);
		Списки.Вставить(К, Новый Массив);
	КонецЦикла;
	Хуки = Новый Структура("before, after, changeAndControl, instead, newMethod, none", 0, 0, 0, 0, 0, 0);
	Для Каждого М Из Модули Цикл
		Числа[М.bucket] = Числа[М.bucket] + 1;
		Списки[М.bucket].Добавить(М.path);
		УчестьМетодыВСводкеХуков(М, Хуки);
	КонецЦикла;
	Возврат Новый Структура("meta, total, counts, hooks, paths", Мета, Модули.Количество(), Числа, Хуки, Списки);
КонецФункции

Процедура УчестьМетодыВСводкеХуков(М, Хуки)
	Если Не М.Свойство("methods") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Мт Из М.methods Цикл
		Если Мт.status = "same" Тогда
			Продолжить;
		КонецЕсли;
		ИмяХука = "";
		Если Мт.Свойство("hook") Тогда
			ИмяХука = Мт.hook;
		КонецЕсли;
		УвеличитьСчетчикХука(Хуки, ИмяХука);
	КонецЦикла;
КонецПроцедуры

Процедура УвеличитьСчетчикХука(Хуки, ИмяХука)
	Если ИмяХука = "before" Тогда
		Хуки.before = Хуки.before + 1;
	ИначеЕсли ИмяХука = "after" Тогда
		Хуки.after = Хуки.after + 1;
	ИначеЕсли ИмяХука = "changeAndControl" Тогда
		Хуки.changeAndControl = Хуки.changeAndControl + 1;
	ИначеЕсли ИмяХука = "instead" Тогда
		Хуки.instead = Хуки.instead + 1;
	ИначеЕсли ИмяХука = "newMethod" Тогда
		Хуки.newMethod = Хуки.newMethod + 1;
	Иначе
		Хуки.none = Хуки.none + 1;
	КонецЕсли;
КонецПроцедуры

// Пишет summary.json, report.json и razbor_moduley.html.
//
// Параметры:
//   Модули — массив описаний; Сводка — результат СобратьСводку (может уже содержать timings);
//   КаталогВыхода — папка результата; КаталогШаблона — каталог с шаблон.html (обычно src/).
// Не изменяет переданные описания модулей (тексты нужны черновику расширения).
Процедура ЗаписатьОтчет(Модули, Сводка, КаталогВыхода, КаталогШаблона) Экспорт
	ЗаписатьФайл(ОбъединитьПути(КаталогВыхода, "summary.json"), ВJSON(Сводка));
	ЗаписатьHtml(Модули, Сводка, КаталогВыхода, КаталогШаблона);
КонецПроцедуры

// report.json и razbor_moduley.html (summary.json не трогает) — для --только-отчет.
// HTML — шаблон с встроенным компактным JSON (без полных текстов модулей).
//
// Параметры:
//   Модули — массив описаний; Сводка — meta, counts, hooks;
//   КаталогВыхода, КаталогШаблона — папка результата и каталог шаблон.html.
Процедура ЗаписатьHtml(Модули, Сводка, КаталогВыхода, КаталогШаблона) Экспорт

	Данные = СобратьДанныеОтчета(Модули, Сводка, КаталогВыхода);
	Json = ВJSON(Данные);
	ЗаписатьФайл(ОбъединитьПути(КаталогВыхода, "report.json"), Json);

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(КаталогШаблона, "шаблон.html"), "UTF-8");
	Шаблон = Чтение.Прочитать();
	Чтение.Закрыть();
	ДляHtml = СтрЗаменить(Json, "</", "\u003c/");
	ЗаписатьФайл(ОбъединитьПути(КаталогВыхода, "razbor_moduley.html"), СтрЗаменить(Шаблон, "/*__DATA__*/null", ДляHtml));

КонецПроцедуры

// Компактные данные отчёта: корзины, методы, хуки, причины, пометки «возвращён в типовой»,
// отличия только изменёнными фрагментами (не полные тексты модулей). Исходные Модули не меняет.
Функция СобратьДанныеОтчета(Модули, Сводка, КаталогВыхода) Экспорт

	СтавитьВозврат = Ложь;
	ЧислоВозвращённых = Неопределено;
	Если Сводка <> Неопределено И Сводка.Свойство("returnedToVendor") Тогда
		СтавитьВозврат = Истина;
		ЧислоВозвращённых = Сводка.returnedToVendor;
	КонецЕсли;
	Готовая = ПрочитатьСводку(КаталогВыхода);
	Если ЧислоВозвращённых = Неопределено И Готовая <> Неопределено И Готовая.Свойство("returnedToVendor") Тогда
		СтавитьВозврат = Истина;
		ЧислоВозвращённых = Готовая.returnedToVendor;
	КонецЕсли;

	ДляОтчета = Новый Массив;
	Для Каждого М Из Модули Цикл
		Если М.bucket <> "identical" Тогда
			ДляОтчета.Добавить(СжатьМодуль(М, СтавитьВозврат));
		КонецЕсли;
	КонецЦикла;

	Мета = Неопределено;
	Числа = Неопределено;
	Хуки = Неопределено;
	Если Сводка <> Неопределено Тогда
		Мета = Сводка.meta;
		Числа = Сводка.counts;
		Хуки = Сводка.hooks;
	КонецЕсли;
	Данные = Новый Структура("meta, counts, hooks, modules", Мета, Числа, Хуки, ДляОтчета);
	Если Сводка <> Неопределено И Сводка.Свойство("bsparser") Тогда
		Данные.Вставить("bsparser", Сводка.bsparser);
	КонецЕсли;
	Если ЧислоВозвращённых <> Неопределено Тогда
		Данные.Вставить("returnedToVendor", ЧислоВозвращённых);
	КонецЕсли;
	ЧислоЭкспорта = Неопределено;
	Если Сводка <> Неопределено И Сводка.Свойство("wrappersAdded") Тогда
		ЧислоЭкспорта = Сводка.wrappersAdded;
	КонецЕсли;
	Если ЧислоЭкспорта = Неопределено И Готовая <> Неопределено И Готовая.Свойство("wrappersAdded") Тогда
		ЧислоЭкспорта = Готовая.wrappersAdded;
	КонецЕсли;
	Если ЧислоЭкспорта = Неопределено Тогда
		ФайлЭксп = ПрочитатьJsonФайл(ОбъединитьПути(КаталогВыхода, "wrappers_added.json"));
		Если ФайлЭксп <> Неопределено И ФайлЭксп.Свойство("count") Тогда
			ЧислоЭкспорта = ФайлЭксп.count;
		КонецЕсли;
	КонецЕсли;
	Если ЧислоЭкспорта <> Неопределено Тогда
		Данные.Вставить("wrappersAdded", ЧислоЭкспорта);
	КонецЕсли;

	Обр = ПрочитатьJsonФайл(ОбъединитьПути(КаталогВыхода, "reverse_build.json"));
	Если Обр = Неопределено И Сводка <> Неопределено И Сводка.Свойство("reverseBuild") Тогда
		Обр = Новый Структура("summary", Сводка.reverseBuild);
	КонецЕсли;
	Если Обр <> Неопределено Тогда
		Данные.Вставить("reverseBuild", Обр);
	КонецЕсли;
	ДополнитьМеткиОтчета(Данные, КаталогВыхода);
	Возврат Данные;

КонецФункции

Функция СжатьМодуль(М, СтавитьВозврат)
	Р = Новый Структура("path, type, object, bucket, reason, outsideDiffers, methods, counts",
		СвойствоИли(М, "path", ""), СвойствоИли(М, "type", ""), СвойствоИли(М, "object", ""),
		М.bucket, СвойствоИли(М, "reason", ""), СвойствоИли(М, "outsideDiffers", Ложь),
		Новый Массив, Неопределено);
	Если М.Свойство("counts") Тогда
		Р.counts = М.counts;
	КонецЕсли;
	Если М.bucket = "only_source" Тогда
		Р.Вставить("text", СвойствоИли(М, "sourceText", ""));
	ИначеЕсли М.bucket = "only_vendor" Тогда
		Р.Вставить("text", СвойствоИли(М, "vendorText", ""));
	ИначеЕсли М.bucket = "cosmetic" Тогда
		Фр = ФрагментыОтличий(СвойствоИли(М, "vendorText", ""), СвойствоИли(М, "sourceText", ""));
		Если Фр.Количество() > 0 Тогда
			Р.Вставить("diff", Фр);
		КонецЕсли;
	КонецЕсли;
	Если Не М.Свойство("methods") Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Мт Из М.methods Цикл
		Р.methods.Добавить(СжатьМетод(Мт, СтавитьВозврат));
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция СжатьМетод(Мт, СтавитьВозврат)
	Р = Новый Структура("name, kind, status", СвойствоИли(Мт, "name", ""), СвойствоИли(Мт, "kind", ""), Мт.status);
	Если Мт.Свойство("explain") И Мт.explain <> "" Тогда
		Р.Вставить("explain", Мт.explain);
	КонецЕсли;
	Если Мт.Свойство("hook") И Мт.hook <> "" И Мт.hook <> "none" Тогда
		Р.Вставить("hook", Мт.hook);
	КонецЕсли;
	Если Мт.Свойство("hookBody") И Мт.hookBody <> "" Тогда
		Р.Вставить("hookBody", Мт.hookBody);
	КонецЕсли;
	Возвращён = (Мт.Свойство("returned") И Мт.returned = Истина)
		Или (СтавитьВозврат И Мт.status = "removed");
	Если Возвращён Тогда
		Р.Вставить("returned", Истина);
	КонецЕсли;
	Если Мт.status = "same" Или Возвращён Тогда
		Возврат Р;
	КонецЕсли;
	// Для авто-хука с телом полный текст метода не нужен: в отчёте показывается hookBody.
	Если Р.Свойство("hookBody") Тогда
		Возврат Р;
	КонецЕсли;
	Фр = ФрагментыОтличий(СвойствоИли(Мт, "vendorText", ""), СвойствоИли(Мт, "sourceText", ""));
	Если Фр.Количество() > 0 Тогда
		Р.Вставить("diff", Фр);
	КонецЕсли;
	Возврат Р;
КонецФункции

Функция СвойствоИли(Объект, Имя, ЗначениеПоУмолчанию)
	Если Объект.Свойство(Имя) Тогда
		Возврат Объект[Имя];
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Построчные отличия: только изменённые фрагменты с тремя строками контекста.
// Сравнение строк без учёта пробелов по краям (как в прежнем JS-отчёте).
//
// Параметры:
//   ТекстА — текст поставщика (БП); ТекстБ — текст исходной (УП).
//
// Возвращаемое значение:
//   Массив хунков: a, b — 1-based номера первых строк; l — массив пар [операция, строка],
//   операция: " " контекст, "-" удалено из БП, "+" добавлено в УП.
Функция ФрагментыОтличий(ТекстА, ТекстБ) Экспорт
	А = СтрокиТекста(ТекстА);
	Б = СтрокиТекста(ТекстБ);
	Если ТекстыСтрокРавны(А, Б) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Операции = СопоставитьСтроки(А, Б);
	Возврат УпаковатьХунки(Операции, 3);
КонецФункции

Функция СтрокиТекста(Текст)
	Возврат СтрРазделить(СтрЗаменить(Строка(Текст), Символы.ВК, ""), Символы.ПС, Истина);
КонецФункции

Функция ТекстыСтрокРавны(А, Б)
	Если А.Количество() <> Б.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Й = 0 По А.ВГраница() Цикл
		Если СокрЛП(А[Й]) <> СокрЛП(Б[Й]) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СопоставитьСтроки(А, Б)
	Операции = Новый Массив;
	ИндА = 0;
	Й = 0;
	КолА = А.Количество();
	КолБ = Б.Количество();
	Окно = 80;
	Пока ИндА < КолА Или Й < КолБ Цикл
		Если ИндА < КолА И Й < КолБ И СокрЛП(А[ИндА]) = СокрЛП(Б[Й]) Тогда
			ДобавитьОперацию(Операции, " ", А[ИндА], ИндА + 1, Й + 1);
			ИндА = ИндА + 1;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Сдвиг = НайтиБлижайшееСовпадение(А, Б, ИндА, Й, Окно);
		Если Сдвиг = Неопределено Тогда
			Если ИндА < КолА Тогда
				ДобавитьОперацию(Операции, "-", А[ИндА], ИндА + 1, 0);
				ИндА = ИндА + 1;
			Иначе
				ДобавитьОперацию(Операции, "+", Б[Й], 0, Й + 1);
				Й = Й + 1;
			КонецЕсли;
		Иначе
			Для К = 1 По Сдвиг.dA Цикл
				ДобавитьОперацию(Операции, "-", А[ИндА], ИндА + 1, 0);
				ИндА = ИндА + 1;
			КонецЦикла;
			Для К = 1 По Сдвиг.dB Цикл
				ДобавитьОперацию(Операции, "+", Б[Й], 0, Й + 1);
				Й = Й + 1;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Операции;
КонецФункции

Функция НайтиБлижайшееСовпадение(А, Б, ИндА, Й, Окно)
	КолА = А.Количество();
	КолБ = Б.Количество();
	ЛучшаяСумма = Окно * 2 + 1;
	Лучший = Неопределено;
	ПределА = Мин(Окно, КолА - ИндА);
	ПределБ = Мин(Окно, КолБ - Й);
	Для dA = 0 По ПределА Цикл
		Для dB = 0 По ПределБ Цикл
			Если dA + dB = 0 Или dA + dB >= ЛучшаяСумма Тогда
				Продолжить;
			КонецЕсли;
			ИА = ИндА + dA;
			ЙБ = Й + dB;
			Если ИА < КолА И ЙБ < КолБ И СокрЛП(А[ИА]) = СокрЛП(Б[ЙБ]) Тогда
				ЛучшаяСумма = dA + dB;
				Лучший = Новый Структура("dA, dB", dA, dB);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Лучший;
КонецФункции

Процедура ДобавитьОперацию(Операции, Вид, Текст, НомА, НомБ)
	Операции.Добавить(Новый Структура("op, s, a, b", Вид, Текст, НомА, НомБ));
КонецПроцедуры

Функция УпаковатьХунки(Операции, Контекст)
	Хунки = Новый Массив;
	Если Операции.Количество() = 0 Тогда
		Возврат Хунки;
	КонецЕсли;
	ИндексыИзменений = Новый Массив;
	Для Й = 0 По Операции.ВГраница() Цикл
		Если Операции[Й].op <> " " Тогда
			ИндексыИзменений.Добавить(Й);
		КонецЕсли;
	КонецЦикла;
	Если ИндексыИзменений.Количество() = 0 Тогда
		Возврат Хунки;
	КонецЕсли;
	Граница = Операции.ВГраница();
	Н = 0;
	Пока Н < ИндексыИзменений.Количество() Цикл
		Нач = Макс(0, ИндексыИзменений[Н] - Контекст);
		Кон = Мин(Граница, ИндексыИзменений[Н] + Контекст);
		Пока Н + 1 < ИндексыИзменений.Количество() И ИндексыИзменений[Н + 1] <= Кон + Контекст + 1 Цикл
			Н = Н + 1;
			Кон = Мин(Граница, ИндексыИзменений[Н] + Контекст);
		КонецЦикла;
		Хунки.Добавить(СобратьХунк(Операции, Нач, Кон));
		Н = Н + 1;
	КонецЦикла;
	Возврат Хунки;
КонецФункции

Функция СобратьХунк(Операции, Нач, Кон)
	Строки = Новый Массив;
	НомА = 0;
	НомБ = 0;
	Для Й = Нач По Кон Цикл
		Оп = Операции[Й];
		Если НомА = 0 И Оп.a > 0 Тогда
			НомА = Оп.a;
		КонецЕсли;
		Если НомБ = 0 И Оп.b > 0 Тогда
			НомБ = Оп.b;
		КонецЕсли;
		Пара = Новый Массив;
		Пара.Добавить(Оп.op);
		Пара.Добавить(Оп.s);
		Строки.Добавить(Пара);
	КонецЦикла;
	Если НомА = 0 Тогда
		НомА = 1;
	КонецЕсли;
	Если НомБ = 0 Тогда
		НомБ = 1;
	КонецЕсли;
	Возврат Новый Структура("a, b, l", НомА, НомБ, Строки);
КонецФункции

// Читает summary.json готового выхода (пути для --только-отчет).
//
// Параметры:
//   КаталогВыхода — папка с summary.json.
//
// Возвращаемое значение:
//   Структура сводки или Неопределено, если файла нет.
Функция ПрочитатьСводку(КаталогВыхода) Экспорт
	Возврат ПрочитатьJsonФайл(ОбъединитьПути(КаталогВыхода, "summary.json"));
КонецФункции

Функция ПрочитатьJsonФайл(Путь) Экспорт
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь, "UTF-8");
	Рез = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Рез;
КонецФункции

// Запись текста в файл UTF-8 (перезаписывает).
Процедура ЗаписатьФайл(Путь, Текст) Экспорт
	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры
// Помечает методы из wrappers_added.json и hooks_check.json (бейджи и фильтры отчёта).
Процедура ДополнитьМеткиОтчета(Данные, КаталогВыхода)
	Эксп = ПрочитатьJsonФайл(ОбъединитьПути(КаталогВыхода, "wrappers_added.json"));
	ХукПр = ПрочитатьJsonФайл(ОбъединитьПути(КаталогВыхода, "hooks_check.json"));
	Сиг = ПрочитатьJsonФайл(ОбъединитьПути(КаталогВыхода, "signatures_moved.json"));
	КартаЭксп = Новый Соответствие;
	Если Эксп <> Неопределено Тогда
		Если Данные.Свойство("wrappersAdded") = Ложь И Эксп.Свойство("count") Тогда
			Данные.Вставить("wrappersAdded", Эксп.count);
		КонецЕсли;
		Если Эксп.Свойство("items") Тогда
			Для Каждого Э Из Эксп.items Цикл
				КартаЭксп.Вставить(КлючМеткиОтчета(Э.path, Э.name), Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	КартаХук = Новый Соответствие;
	Если ХукПр <> Неопределено Тогда
		Ч = 0;
		С = 0;
		Р = 0;
		Если ХукПр.Свойство("checked") Тогда
			Ч = ХукПр.checked;
		КонецЕсли;
		Если ХукПр.Свойство("match") Тогда
			С = ХукПр.match;
		КонецЕсли;
		Если ХукПр.Свойство("mismatch") Тогда
			Р = ХукПр.mismatch;
		КонецЕсли;
		Данные.Вставить("hookCheck", Новый Структура("checked, match, mismatch", Ч, С, Р));
		Если ХукПр.Свойство("items") Тогда
			Для Каждого Э Из ХукПр.items Цикл
				КартаХук.Вставить(КлючМеткиОтчета(Э.path, Э.name), Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	КартаСиг = Новый Соответствие;
	Если Сиг <> Неопределено Тогда
		Если Сиг.Свойство("count") Тогда
			Данные.Вставить("signaturesMoved", Сиг.count);
		КонецЕсли;
		Если Сиг.Свойство("upCopies") Тогда
			Данные.Вставить("upSignatureCopies", Сиг.upCopies);
		КонецЕсли;
		Если Сиг.Свойство("items") Тогда
			Для Каждого Э Из Сиг.items Цикл
				КартаСиг.Вставить(КлючМеткиОтчета(Э.path, Э.name), Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Если КартаЭксп.Количество() = 0 И КартаХук.Количество() = 0 И КартаСиг.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ПокрытыеЭксп = Новый Соответствие;
	Если Данные.Свойство("modules") Тогда
		Для Каждого М Из Данные.modules Цикл
			Если Не М.Свойство("methods") Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Мт Из М.methods Цикл
				Ключ = КлючМеткиОтчета(М.path, Мт.name);
				Если КартаЭксп.Получить(Ключ) = Истина Тогда
					Мт.Вставить("wrapperAdded", Истина);
					ПокрытыеЭксп.Вставить(Ключ, Истина);
				КонецЕсли;
				Если КартаХук.Получить(Ключ) = Истина Тогда
					Мт.Вставить("hookCheckFail", Истина);
				КонецЕсли;
				Если КартаСиг.Получить(Ключ) = Истина Тогда
					Мт.Вставить("upSignatureMoved", Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	ДобавитьМодулиДобавленногоЭкспорта(Данные, Эксп, ПокрытыеЭксп);
КонецПроцедуры

Функция КлючМеткиОтчета(Путь, Имя)
	П = НРег(СтрЗаменить(Строка(Путь), "/", "\"));
	Возврат П + "|" + НРег(Строка(Имя));
КонецФункции

Процедура ДобавитьМодулиДобавленногоЭкспорта(Данные, Эксп, ПокрытыеЭксп)
	Если Эксп = Неопределено Или Не Эксп.Свойство("items") Тогда
		Возврат;
	КонецЕсли;
	ПоПутям = Новый Соответствие;
	Для Каждого Э Из Эксп.items Цикл
		Ключ = КлючМеткиОтчета(Э.path, Э.name);
		Если ПокрытыеЭксп.Получить(Ключ) = Истина Тогда
			Продолжить;
		КонецЕсли;
		П = СтрЗаменить(Строка(Э.path), "/", "\");
		Список = ПоПутям.Получить(НРег(П));
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			ПоПутям.Вставить(НРег(П), Список);
			Список.Добавить(П);
		КонецЕсли;
		Список.Добавить(Э.name);
	КонецЦикла;
	Если ПоПутям.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КЗ Из ПоПутям Цикл
		Список = КЗ.Значение;
		Путь = Список[0];
		Части = СтрРазделить(Путь, "\");
		Тип = ?(Части.Количество() > 0, Части[0], "");
		Объект = ?(Части.Количество() > 1, Части[1], "");
		Методы = Новый Массив;
		Для Й = 1 По Список.Количество() - 1 Цикл
			Мт = Новый Структура("name, kind, status, wrapperAdded", Список[Й], "", "same", Истина);
			Методы.Добавить(Мт);
		КонецЦикла;
		М = Новый Структура("path, type, object, bucket, reason, outsideDiffers, methods, counts",
			Путь, Тип, Объект, "wrappersAdded",
			"В расширение добавлена обёртка &Вместо (вызов неэкспортного метода).",
			Ложь, Методы, Неопределено);
		Данные.modules.Добавить(М);
	КонецЦикла;
КонецПроцедуры