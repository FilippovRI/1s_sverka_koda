// Формирование summary.json и автономного HTML-отчёта (данные — JSON внутри страницы).

Функция ВJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция СобратьСводку(Модули, Мета) Экспорт
	Корзины = СтрРазделить("identical,cosmetic,auto,manual,only_source,only_vendor", ",");
	Числа = Новый Структура;
	Списки = Новый Структура;
	Для Каждого К Из Корзины Цикл
		Числа.Вставить(К, 0);
		Списки.Вставить(К, Новый Массив);
	КонецЦикла;
	Хуки = Новый Структура("before, after, changeAndControl, instead, newMethod, none", 0, 0, 0, 0, 0, 0);
	Для Каждого М Из Модули Цикл
		Числа[М.bucket] = Числа[М.bucket] + 1;
		Списки[М.bucket].Добавить(М.path);
		Если М.Свойство("methods") Тогда
			Для Каждого Мт Из М.methods Цикл
				Если Мт.status = "same" Тогда
					Продолжить;
				КонецЕсли;
				Х = "";
				Если Мт.Свойство("hook") Тогда
					Х = Мт.hook;
				КонецЕсли;
				Если Х = "before" Тогда
					Хуки.before = Хуки.before + 1;
				ИначеЕсли Х = "after" Тогда
					Хуки.after = Хуки.after + 1;
				ИначеЕсли Х = "changeAndControl" Тогда
					Хуки.changeAndControl = Хуки.changeAndControl + 1;
				ИначеЕсли Х = "instead" Тогда
					Хуки.instead = Хуки.instead + 1;
				ИначеЕсли Х = "newMethod" Тогда
					Хуки.newMethod = Хуки.newMethod + 1;
				Иначе
					Хуки.none = Хуки.none + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("meta, total, counts, hooks, paths", Мета, Модули.Количество(), Числа, Хуки, Списки);
КонецФункции

Процедура ЗаписатьОтчет(Модули, Сводка, КаталогВыхода, КаталогШаблона) Экспорт

	ЗаписатьФайл(ОбъединитьПути(КаталогВыхода, "summary.json"), ВJSON(Сводка));

	ДляОтчета = Новый Массив;
	Для Каждого М Из Модули Цикл
		Если М.bucket <> "identical" Тогда
			ДляОтчета.Добавить(М);
		КонецЕсли;
	КонецЦикла;
	Данные = Новый Структура("meta, counts, hooks, modules", Сводка.meta, Сводка.counts, Сводка.hooks, ДляОтчета);
	Json = СтрЗаменить(ВJSON(Данные), "</", "<\/");

	Чтение = Новый ЧтениеТекста(ОбъединитьПути(КаталогШаблона, "шаблон.html"), "UTF-8");
	Шаблон = Чтение.Прочитать();
	Чтение.Закрыть();
	ЗаписатьФайл(ОбъединитьПути(КаталогВыхода, "razbor_moduley.html"), СтрЗаменить(Шаблон, "/*__DATA__*/null", Json));

КонецПроцедуры

Процедура ЗаписатьФайл(Путь, Текст) Экспорт
	Запись = Новый ЗаписьТекста(Путь, "UTF-8");
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры
