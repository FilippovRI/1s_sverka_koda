// Самопроверка «обратная сборка»: хуки extension накладываются на restored (ИиК: без #Удаление,
// с #Вставка; &Перед/&После вокруг тела restored; новые методы), и каждый метод сравнивается
// с исходным методом УП без учёта пробелов и комментариев // АПК:. Маркеры // УП_начало не используются.
// Отдельно: закомментированные в УП строки БП должны стоять под #Удаление.

Перем Разбор;
Перем Выгрузка;

Процедура Инициализировать(МодульРазбора) Экспорт
	Разбор = МодульРазбора;
	Выгрузка = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ЧтениеВыгрузки.os"));
КонецПроцедуры

// Возвращаемое значение:
//   Структура summary (счётчики), mismatches, commentOnly, commentedVendor (массивы структур).
Функция Проверить(Выход, КореньУп, КореньБп, Префикс) Экспорт
	КатРасш = ОбъединитьПути(Выход, "extension");
	КатВосст = ОбъединитьПути(Выход, "restored");
	Р = Новый Структура("summary, mismatches, commentOnly, commentedVendor",
		Новый Структура("modules, methods, ok, mismatches, commentOnly, lost, commentedVendorLines, commentedVendorProblems", 0, 0, 0, 0, 0, 0, 0, 0),
		Новый Массив, Новый Массив, Новый Массив);
	Если Не (Новый Файл(КатРасш)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(КатРасш, "*.bsl", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КатРасш) + 2);
		ПутьУп = ОбъединитьПути(КореньУп, Отн);
		Если Не (Новый Файл(ПутьУп)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		ПутьВ = ОбъединитьПути(КатВосст, Отн);
		ТекстУп = Выгрузка.ПрочитатьТекстМодуля(ПутьУп);
		ТекстВ = ?((Новый Файл(ПутьВ)).Существует(), Выгрузка.ПрочитатьТекстМодуля(ПутьВ), ТекстУп);
		ПутьБп = ОбъединитьПути(КореньБп, Отн);
		ТекстБп = ?(КореньБп <> "" И (Новый Файл(ПутьБп)).Существует(), Выгрузка.ПрочитатьТекстМодуля(ПутьБп), "");
		ПроверитьМодуль(Отн, Выгрузка.ПрочитатьТекстМодуля(Ф.ПолноеИмя), ТекстУп, ТекстВ, ТекстБп, Префикс, Р);
		Р.summary.modules = Р.summary.modules + 1;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция КартаМетодов(Текст)
	К = Новый Соответствие;
	Для Каждого Мт Из Разбор.РазобратьМодуль(Текст).Методы Цикл
		Если К.Получить(Мт.Ключ) = Неопределено Тогда
			К.Вставить(Мт.Ключ, Мт);
		КонецЕсли;
	КонецЦикла;
	Возврат К;
КонецФункции

// Аннотация хука: Структура(Вид, Цель) или Неопределено (новый метод).
Функция АннотацияХука(ТекстМетода)
	Для Каждого Стр Из СтрРазделить(ТекстМетода, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если Лев(С, 1) <> "&" Тогда
			Если Разбор.РазобратьОбъявление(Стр) <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Для Каждого Вид Из СтрРазделить("ИзменениеИКонтроль,Перед,После,Вместо", ",") Цикл
			Если СтрНачинаетсяС(НРег(С), НРег("&" + Вид + "(")) Тогда
				П1 = СтрНайти(С, """");
				П2 = ?(П1 = 0 Или П1 >= СтрДлина(С), 0, СтрНайти(С, """", НаправлениеПоиска.СНачала, П1 + 1));
				Если П1 > 0 И П2 > П1 Тогда
					Возврат Новый Структура("Вид, Цель", Вид, Сред(С, П1 + 1, П2 - П1 - 1));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Тело ИиК после наложения: без блоков #Удаление, без строк-маркеров #Вставка.
Функция ТелоИиКПослеНаложения(Тело) Экспорт
	Рез = Новый Массив;
	ВУдалении = Ложь;
	Для Каждого Стр Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		С = НРег(СокрЛП(Стр));
		Если С = "#удаление" Тогда
			ВУдалении = Истина;
		ИначеЕсли С = "#конецудаления" Тогда
			ВУдалении = Ложь;
		ИначеЕсли С = "#вставка" Или С = "#конецвставки" Тогда
			// маркер
		ИначеЕсли Не ВУдалении Тогда
			Рез.Добавить(Стр);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

// Нормализованные строки под #Удаление (множество).
Функция СтрокиУдаления(Тело)
	Рез = Новый Соответствие;
	ВУдалении = Ложь;
	Для Каждого Стр Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		С = НРег(СокрЛП(Стр));
		Если С = "#удаление" Тогда
			ВУдалении = Истина;
		ИначеЕсли С = "#конецудаления" Тогда
			ВУдалении = Ложь;
		ИначеЕсли ВУдалении Тогда
			Н = НормСтрока(Разбор.УбратьКомментарий(Стр));
			Если Н <> "" Тогда
				Рез.Вставить(Н, Истина);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Строка без пробельных символов; комментарий // АПК: отбрасывается.
Функция НормСтрока(Знач Стр) Экспорт
	П = СтрНайти(Стр, "//");
	Пока П > 0 Цикл
		Хв = СокрЛ(Сред(Стр, П + 2));
		Если СтрНачинаетсяС(ВРег(Хв), "АПК:") Тогда
			Стр = Лев(Стр, П - 1);
			Прервать;
		КонецЕсли;
		П = ?(П + 2 > СтрДлина(Стр), 0, СтрНайти(Стр, "//", НаправлениеПоиска.СНачала, П + 2));
	КонецЦикла;
	Для Каждого С Из СтрРазделить(" |" + Символы.Таб + "|" + Символы.ВК + "|" + Символ(160) + "|" + Символ(65279), "|") Цикл
		Стр = СтрЗаменить(Стр, С, "");
	КонецЦикла;
	Возврат Стр;
КонецФункции

Функция НормСтроки(Тело, Префикс, БезКомментариев = Ложь) Экспорт
	Рез = Новый Массив;
	Для Каждого Стр Из СтрРазделить(Тело, Символы.ПС, Истина) Цикл
		Н = НормСтрока(?(БезКомментариев, Разбор.УбратьКомментарий(Стр), Стр));
		Если Префикс <> "" Тогда
			Н = СтрЗаменить(Н, Префикс, "");
		КонецЕсли;
		Если Н <> "" Тогда
			Рез.Добавить(Н);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПерваяРазница(А, Б)
	Для Й = 0 По Макс(А.Количество(), Б.Количество()) - 1 Цикл
		СА = ?(Й < А.Количество(), А[Й], "<нет строки>");
		СБ = ?(Й < Б.Количество(), Б[Й], "<нет строки>");
		Если СА <> СБ Тогда
			Возврат Новый Структура("line, up, built", Й + 1, Лев(СА, 160), Лев(СБ, 160));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("line, up, built", 0, "", "");
КонецФункции

Процедура ПроверитьМодуль(Отн, ТекстР, ТекстУп, ТекстВ, ТекстБп, Префикс, Р) Экспорт
	Ии = Новый Соответствие;
	Пер = Новый Соответствие;
	Пос = Новый Соответствие;
	Нов = Новый Соответствие;
	Для Каждого Мт Из Разбор.РазобратьМодуль(ТекстР).Методы Цикл
		А = АннотацияХука(Мт.Текст);
		Тело = Разбор.ИзвлечьТелоМетода(Мт.Текст);
		Если А = Неопределено Тогда
			Имя = Мт.Имя;
			Если Префикс <> "" И СтрНачинаетсяС(НРег(Имя), НРег(Префикс)) Тогда
				Имя = Сред(Имя, СтрДлина(Префикс) + 1);
			КонецЕсли;
			Нов.Вставить(НРег(Имя), Тело);
		ИначеЕсли А.Вид = "ИзменениеИКонтроль" Или А.Вид = "Вместо" Тогда
			Ии.Вставить(НРег(А.Цель), Тело);
		ИначеЕсли А.Вид = "Перед" Тогда
			Пер.Вставить(НРег(А.Цель), Тело);
		Иначе
			Пос.Вставить(НРег(А.Цель), Тело);
		КонецЕсли;
	КонецЦикла;
	КартаВ = КартаМетодов(ТекстВ);
	КартаБ = КартаМетодов(ТекстБп);
	Для Каждого Му Из Разбор.РазобратьМодуль(ТекстУп).Методы Цикл
		Р.summary.methods = Р.summary.methods + 1;
		Ключ = Му.Ключ;
		ТелоУ = Разбор.ИзвлечьТелоМетода(Му.Текст);
		ТелоИи = Ии.Получить(Ключ);
		Мв = КартаВ.Получить(Ключ);
		ТелоВ = ?(Мв = Неопределено, Неопределено, Разбор.ИзвлечьТелоМетода(Мв.Текст));
		Способ = "";
		Если ТелоИи <> Неопределено Тогда
			Собрано = ТелоИиКПослеНаложения(ТелоИи);
			Способ = "ИзменениеИКонтроль";
		ИначеЕсли Пер.Получить(Ключ) <> Неопределено Или Пос.Получить(Ключ) <> Неопределено Тогда
			Части = Новый Массив;
			Если Пер.Получить(Ключ) <> Неопределено Тогда
				Части.Добавить(Пер.Получить(Ключ));
			КонецЕсли;
			Части.Добавить(?(ТелоВ = Неопределено, "", ТелоВ));
			Если Пос.Получить(Ключ) <> Неопределено Тогда
				Части.Добавить(Пос.Получить(Ключ));
			КонецЕсли;
			Собрано = СтрСоединить(Части, Символы.ПС);
			Способ = "Перед/После";
		ИначеЕсли ТелоВ <> Неопределено Тогда
			Собрано = ТелоВ;
			Способ = "restored";
		ИначеЕсли Нов.Получить(Ключ) <> Неопределено Тогда
			Собрано = Нов.Получить(Ключ);
			Способ = "новый метод";
		Иначе
			Собрано = Неопределено;
		КонецЕсли;
		Если Собрано = Неопределено Тогда
			Р.summary.lost = Р.summary.lost + 1;
			Р.summary.mismatches = Р.summary.mismatches + 1;
			Р.mismatches.Добавить(Новый Структура("path, method, via, kind, line, up, built",
				Отн, Му.Имя, "—", "метод УП потерян (нет ни в restored, ни в extension)", 0, "", ""));
		Иначе
			НУ = НормСтроки(ТелоУ, Префикс);
			НС = НормСтроки(Собрано, Префикс);
			Если СтрСоединить(НУ, Символы.ПС) = СтрСоединить(НС, Символы.ПС) Тогда
				Р.summary.ok = Р.summary.ok + 1;
			Иначе
				Р1 = ПерваяРазница(НУ, НС);
				Если СтрСоединить(НормСтроки(ТелоУ, Префикс, Истина), Символы.ПС)
						= СтрСоединить(НормСтроки(Собрано, Префикс, Истина), Символы.ПС) Тогда
					Р.summary.commentOnly = Р.summary.commentOnly + 1;
					Р.commentOnly.Добавить(Новый Структура("path, method, via, line, up, built", Отн, Му.Имя, Способ, Р1.line, Р1.up, Р1.built));
				Иначе
					Р.summary.mismatches = Р.summary.mismatches + 1;
					Р.mismatches.Добавить(Новый Структура("path, method, via, kind, line, up, built",
						Отн, Му.Имя, Способ, "код отличается", Р1.line, Р1.up, Р1.built));
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Мб = КартаБ.Получить(Ключ);
		Если Мб <> Неопределено Тогда
			ПроверитьЗакомментированныеСтрокиБп(Отн, Му.Имя, ТелоУ, Разбор.ИзвлечьТелоМетода(Мб.Текст),
				ТелоИи, ?(Собрано = Неопределено, "", Собрано), Р);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Строка БП, закомментированная в УП (в УП её нет как кода), должна стоять под #Удаление хука ИиК.
Процедура ПроверитьЗакомментированныеСтрокиБп(Отн, Имя, ТелоУ, ТелоБ, ТелоИи, Собрано, Р)
	КодБ = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(ТелоБ, Символы.ПС, Истина) Цикл
		Н = НормСтрока(Разбор.УбратьКомментарий(Стр));
		Если СтрДлина(Н) > 3 Тогда
			КодБ.Вставить(Н, Истина);
		КонецЕсли;
	КонецЦикла;
	КодУ = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(ТелоУ, Символы.ПС, Истина) Цикл
		КодУ.Вставить(НормСтрока(Разбор.УбратьКомментарий(Стр)), Истина);
	КонецЦикла;
	Удал = ?(ТелоИи = Неопределено, Новый Соответствие, СтрокиУдаления(ТелоИи));
	КодСобр = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(Собрано, Символы.ПС, Истина) Цикл
		КодСобр.Вставить(НормСтрока(Разбор.УбратьКомментарий(Стр)), Истина);
	КонецЦикла;
	Уже = Новый Соответствие;
	Для Каждого Стр Из СтрРазделить(ТелоУ, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если Не СтрНачинаетсяС(С, "//") Тогда
			Продолжить;
		КонецЕсли;
		Пока СтрНачинаетсяС(С, "/") Цикл
			С = Сред(С, 2);
		КонецЦикла;
		Н = НормСтрока(Разбор.УбратьКомментарий(С));
		Если КодБ.Получить(Н) = Неопределено Или КодУ.Получить(Н) <> Неопределено Или Уже.Получить(Н) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Н, Истина);
		Р.summary.commentedVendorLines = Р.summary.commentedVendorLines + 1;
		Если Удал.Получить(Н) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТелоИи <> Неопределено Тогда
			Вид = "в хуке ИиК, но не под #Удаление";
		ИначеЕсли КодСобр.Получить(Н) <> Неопределено Тогда
			Вид = "хука ИиК нет — строка БП выполняется после сборки";
		Иначе
			Продолжить; // строки нет в собранном коде: изменение УП сохранено
		КонецЕсли;
		Р.summary.commentedVendorProblems = Р.summary.commentedVendorProblems + 1;
		Р.commentedVendor.Добавить(Новый Структура("path, method, kind, line", Отн, Имя, Вид, Лев(СокрЛП(Стр), 160)));
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВЛог(Р, Лог, Лимит = 30) Экспорт
	С = Р.summary;
	Лог.Добавить("Обратная сборка: модулей " + С.modules + ", методов УП " + С.methods + ", совпало " + С.ok
		+ ", расхождений кода " + С.mismatches + " (из них потеряно методов " + С.lost + "), только комментарии " + С.commentOnly
		+ "; закомментированных в УП строк БП " + С.commentedVendorLines + ", из них не под #Удаление " + С.commentedVendorProblems);
	Н = 0;
	Для Каждого Э Из Р.mismatches Цикл
		Н = Н + 1;
		Если Н > Лимит Тогда
			Прервать;
		КонецЕсли;
		Лог.Добавить("  расхождение: " + Э.path + " " + Э.method + " [" + Э.via + "] " + Э.kind
			+ ?(Э.line > 0, " — стр. " + Э.line + ": УП «" + Э.up + "» / сборка «" + Э.built + "»", ""));
	КонецЦикла;
	Н = 0;
	Для Каждого Э Из Р.commentedVendor Цикл
		Н = Н + 1;
		Если Н > Лимит Тогда
			Прервать;
		КонецЕсли;
		Лог.Добавить("  закомм. БП: " + Э.path + " " + Э.method + " — " + Э.kind + ": " + Э.line);
	КонецЦикла;
КонецПроцедуры

Функция Экр(Знач С)
	С = СтрЗаменить(С, "&", "&amp;");
	С = СтрЗаменить(С, "<", "&lt;");
	Возврат СтрЗаменить(С, ">", "&gt;");
КонецФункции

Функция HtmlРаздела(Р, Лимит = 1000) Экспорт
	С = Р.summary;
	Ч = Новый Массив;
	Ч.Добавить("<!--RB--><details id=""reverseBuild"" style=""margin:6px""><summary>Обратная сборка (extension + restored → УП): методов УП "
		+ С.methods + ", совпало " + С.ok + ", расхождений " + С.mismatches + " (потеряно " + С.lost + "), только комментарии "
		+ С.commentOnly + "; закомментированные в УП строки БП не под #Удаление: " + С.commentedVendorProblems + " из " + С.commentedVendorLines + "</summary>");
	Ч.Добавить("<div style=""max-height:40vh;overflow:auto"">");
	Ч.Добавить("<div>Сравниваются тела методов без пробелов и комментариев // АПК:. «Сборка» — restored с наложенными хуками.</div>");
	Ч.Добавить("<h4>Расхождения (потерянные или искажённые изменения УП)</h4><ol>");
	Н = 0;
	Для Каждого Э Из Р.mismatches Цикл
		Н = Н + 1;
		Если Н > Лимит Тогда
			Прервать;
		КонецЕсли;
		Ч.Добавить("<li>" + Экр(Э.path + " — " + Э.method + " [" + Э.via + "] " + Э.kind)
			+ ?(Э.line > 0, "<br><small>стр. " + Э.line + ": УП <code>" + Экр(Э.up) + "</code> / сборка <code>" + Экр(Э.built) + "</code></small>", "") + "</li>");
	КонецЦикла;
	Ч.Добавить("</ol><h4>Закомментированные в УП строки БП не под #Удаление</h4><ol>");
	Н = 0;
	Для Каждого Э Из Р.commentedVendor Цикл
		Н = Н + 1;
		Если Н > Лимит Тогда
			Прервать;
		КонецЕсли;
		Ч.Добавить("<li>" + Экр(Э.path + " — " + Э.method + ": " + Э.kind) + "<br><small><code>" + Экр(Э.line) + "</code></small></li>");
	КонецЦикла;
	Ч.Добавить("</ol><h4>Отличаются только комментарии</h4><ol>");
	Н = 0;
	Для Каждого Э Из Р.commentOnly Цикл
		Н = Н + 1;
		Если Н > Лимит Тогда
			Прервать;
		КонецЕсли;
		Ч.Добавить("<li>" + Экр(Э.path + " — " + Э.method + " [" + Э.via + "]") + "<br><small>стр. " + Э.line + ": УП <code>" + Экр(Э.up) + "</code> / сборка <code>" + Экр(Э.built) + "</code></small></li>");
	КонецЦикла;
	Ч.Добавить("</ol></div></details><!--/RB-->");
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

// Вставляет (или заменяет) раздел обратной сборки в готовый razbor_moduley.html.
Процедура ВставитьВHtml(Р, ПутьHtml) Экспорт
	Если Не (Новый Файл(ПутьHtml)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Чт = Новый ЧтениеТекста(ПутьHtml, "UTF-8");
	Т = Чт.Прочитать();
	Чт.Закрыть();
	Н = СтрНайти(Т, "<!--RB-->");
	Если Н > 0 Тогда
		К = СтрНайти(Т, "<!--/RB-->");
		Т = Лев(Т, Н - 1) + Сред(Т, К + СтрДлина("<!--/RB-->"));
	КонецЕсли;
	Блок = HtmlРаздела(Р);
	П = СтрНайти(Т, "<body>");
	Если П > 0 Тогда
		Т = Лев(Т, П + 5) + Блок + Сред(Т, П + 6);
	Иначе
		Т = Блок + Т;
	КонецЕсли;
	Зп = Новый ЗаписьТекста(ПутьHtml, "UTF-8");
	Зп.Записать(Т);
	Зп.Закрыть();
КонецПроцедуры
