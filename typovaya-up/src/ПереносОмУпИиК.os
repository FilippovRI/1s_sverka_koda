// Перенос ошибок «Переменная не определена» (ОМ только УП) из модулей форм typovaya
// в расширение УП_Доработки через &ИзменениеИКонтроль (дифф typovaya→УП, тело УП).
// Применить() пишет только расширение. ЗаменитьТелаRestoredНаБп() подменяет
// тела перехваченных ИиК-методов в restored на тела БП и перестраивает ИиК как БП→УП.

Перем Прот;
Перем Синтез;
Перем Дозап;
Перем МодулиПодключены;
Перем КэшОписанийФормXml;

Процедура ПодключитьМодули()
	Если МодулиПодключены = Истина Тогда
		Возврат;
	КонецЕсли;
	К = ТекущийСценарий().Каталог;
	Прот = ЗагрузитьСценарий(ОбъединитьПути(К, "ФормыБпПрототип.os"));
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(К, "РазборМетодов.os"));
	Синтез = ЗагрузитьСценарий(ОбъединитьПути(К, "СинтезХуков.os"));
	Попытка
		Синтез.Инициализировать(Разбор, ЗагрузитьСценарий(ОбъединитьПути(К, "БезопасностьПереноса.os")));
	Исключение
		Синтез.Инициализировать(Разбор);
	КонецПопытки;
	Дозап = ЗагрузитьСценарий(ОбъединитьПути(К, "ДозаполнениеМодуля.os"));
	Дозап.Инициализировать(Разбор);
	МодулиПодключены = Истина;
КонецПроцедуры

Функция ТегПоПапке(Папка)
	Если Папка = "Catalogs" Тогда
		Возврат "Catalog";
	ИначеЕсли Папка = "Documents" Тогда
		Возврат "Document";
	ИначеЕсли Папка = "DataProcessors" Тогда
		Возврат "DataProcessor";
	ИначеЕсли Папка = "Reports" Тогда
		Возврат "Report";
	ИначеЕсли Папка = "InformationRegisters" Тогда
		Возврат "InformationRegister";
	ИначеЕсли Папка = "CommonForms" Тогда
		Возврат "CommonForm";
	ИначеЕсли Папка = "ChartsOfCharacteristicTypes" Тогда
		Возврат "ChartOfCharacteristicTypes";
	ИначеЕсли Папка = "ChartsOfCalculationTypes" Тогда
		Возврат "ChartOfCalculationTypes";
	ИначеЕсли Папка = "BusinessProcesses" Тогда
		Возврат "BusinessProcess";
	ИначеЕсли Папка = "Tasks" Тогда
		Возврат "Task";
	ИначеЕсли Папка = "ExchangePlans" Тогда
		Возврат "ExchangePlan";
	Иначе
		Возврат Папка;
	КонецЕсли;
КонецФункции

Функция ТекстUtf8(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Если Т = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Т, 1) = Символ(65279) Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	Возврат СтрЗаменить(Т, Символы.ВК, "");
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст) Экспорт
	// Потоковая запись: без полного строкового разворота ПС→CRLF (иначе OOM на больших модулях).
	// ЗаписьТекста на Windows переводит ПС в CRLF; явный ВК перед ПС даёт CR CR LF
	// и пустую строку между &НаКлиенте/&НаСервере и Процедура (форма теряет Объект и реквизиты).
	СоздатьКаталог((Новый Файл(Путь)).Путь);
	Т = Текст;
	Если СтрНайти(Т, Символы.ВК) > 0 Тогда
		Т = СтрЗаменить(Т, Символы.ВК, "");
	КонецЕсли;
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Нач = 1;
	Длина = СтрДлина(Т);
	Пока Нач <= Длина Цикл
		Поз = СтрНайти(Т, Символы.ПС, , Нач);
		Если Поз = 0 Тогда
			Запись.Записать(Сред(Т, Нач));
			Прервать;
		КонецЕсли;
		Если Поз > Нач Тогда
			Запись.Записать(Сред(Т, Нач, Поз - Нач));
		КонецЕсли;
		Запись.Записать(Символы.ПС);
		Нач = Поз + 1;
	КонецЦикла;
	Запись.Закрыть();
	Т = "";
КонецПроцедуры

Функция ЕстьВМассиве(Массив, Значение)
	Для Каждого Э Из Массив Цикл
		Если Э = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция СобратьФормыСВызовамиОмУп(КореньТип, КореньУп) Экспорт
	ПодключитьМодули();
	Рез = Новый Массив;
	ОмУп = Прот.ОбщиеМодулиТолькоВПервой(КореньУп, КореньТип);
	Если ОмУп.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Тела = Прот.ПеречислитьТелаФорм(КореньТип);
	Для Каждого КЗ Из Тела Цикл
		Отн = ?(ТипЗнч(КЗ) = Тип("КлючИЗначение"), КЗ.Ключ, КЗ);
		ПутьМ = Прот.ПутьМодуляФормы(ОбъединитьПути(КореньТип, Отн));
		Если Не (Новый Файл(ПутьМ)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Если Прот.МетодСсылаетсяНаОм(ТекстUtf8(ПутьМ), ОмУп) Тогда
			Рез.Добавить(Отн);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ОбеспечитьЗаимствованиеФормы(Отн, КореньТип, КатРасш) Экспорт
	ПодключитьМодули();
	Ключ = Прот.КлючОбъектаФормы(Отн);
	ИмяФормы = Прот.ИмяФормыИзПути(Отн);
	Если Ключ = "" Или ИмяФормы = "" Тогда
		Возврат "не разобран путь формы";
	КонецЕсли;
	УидФормы = Прот.UuidИзМета(Прот.ПутьМетаФормы(КореньТип, Отн));
	ПутьМетаРасш = Прот.ПутьМетаФормы(КатРасш, Отн);
	Если ПутьМетаРасш = "" Тогда
		Возврат "нет пути метаданных формы";
	КонецЕсли;
	Если Не (Новый Файл(ПутьМетаРасш)).Существует() Тогда
		СоздатьКаталог((Новый Файл(ПутьМетаРасш)).Путь);
		ЗаписатьТекст(ПутьМетаРасш, Прот.МетаЗаимствованнойФормы(ИмяФормы, УидФормы, Ключ));
	КонецЕсли;
	Если СтрНачинаетсяС(Прот.НормПуть(Ключ), "CommonForms\") Тогда
		Прот.ДобавитьУзелВConfiguration(ОбъединитьПути(КатРасш, "Configuration.xml"), "CommonForm", ИмяФормы);
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(Ключ, "\", Ложь);
	Если Части.Количество() < 2 Тогда
		Возврат "короткий ключ объекта";
	КонецЕсли;
	ПутьМетаРасшОб = ОбъединитьПути(КатРасш, Ключ + ".xml");
	Если (Новый Файл(ПутьМетаРасшОб)).Существует() Тогда
		Прот.ДобавитьФормуВChildObjects(ПутьМетаРасшОб, ИмяФормы);
	Иначе
		УидОб = Прот.UuidИзМета(Прот.ПутьМетаОбъекта(КореньТип, Ключ));
		Имена = Новый Массив;
		Имена.Добавить(ИмяФормы);
		СоздатьКаталог((Новый Файл(ПутьМетаРасшОб)).Путь);
		ЗаписатьТекст(ПутьМетаРасшОб, Прот.МетаЗаимствованногоОбъекта(Части[0], Части[1], УидОб, Имена, Прот.ПутьМетаОбъекта(КореньТип, Ключ)));
	КонецЕсли;
	Прот.ДобавитьУзелВConfiguration(ОбъединитьПути(КатРасш, "Configuration.xml"), ТегПоПапке(Части[0]), Части[1]);
	Возврат "";
КонецФункции

Функция ЭтоЗаголовокМетода(С)
	Т = НРег(СокрЛП(С));
	Возврат СтрНачинаетсяС(Т, "процедура") Или СтрНачинаетсяС(Т, "функция") Или СтрНачинаетсяС(Т, "асинх ");
КонецФункции

Функция ИмяИВидИзЗаголовка(СтрЗаголовка)
	Т = СокрЛП(СтрЗаголовка);
	Вид = "Процедура";
	ТН = НРег(Т);
	Если СтрНачинаетсяС(ТН, "асинх") Тогда
		Т = СокрЛП(Сред(Т, СтрДлина("Асинх") + 1));
		ТН = НРег(Т);
	КонецЕсли;
	Если СтрНачинаетсяС(ТН, "функция") Тогда
		Вид = "Функция";
		Т = СокрЛП(Сред(Т, СтрДлина("Функция") + 1));
	ИначеЕсли СтрНачинаетсяС(ТН, "процедура") Тогда
		Т = СокрЛП(Сред(Т, СтрДлина("Процедура") + 1));
	КонецЕсли;
	Имя = "";
	Для Й = 1 По СтрДлина(Т) Цикл
		С = Сред(Т, Й, 1);
		Если С = "(" Или С = " " Или С = Символы.Таб Тогда
			Прервать;
		КонецЕсли;
		Имя = Имя + С;
	КонецЦикла;
	Возврат Новый Структура("name, kind", Имя, Вид);
КонецФункции

Функция РазобратьМодульНаМетоды(Текст) Экспорт
	Рез = Новый Структура("methods, outside, byName", Новый Массив, "", Новый Соответствие);
	Т = СтрЗаменить(Текст, Символы.ВК, "");
	Строки = СтрРазделить(Т, Символы.ПС, Истина);
	Вне = Новый Массив;
	Й = 0;
	Пока Й <= Строки.ВГраница() Цикл
		С = Строки[Й];
		Сп = СокрЛП(С);
		Если СтрНачинаетсяС(Сп, "&") Или ЭтоЗаголовокМетода(Сп) Тогда
			НачДир = Й;
			Пока Й <= Строки.ВГраница() И Не ЭтоЗаголовокМетода(Строки[Й]) Цикл
				Сп2 = СокрЛП(Строки[Й]);
				Если Сп2 <> "" И Не СтрНачинаетсяС(Сп2, "&") И Не СтрНачинаетсяС(Сп2, "//") И Не СтрНачинаетсяС(Сп2, "#") Тогда
					Прервать;
				КонецЕсли;
				Й = Й + 1;
			КонецЦикла;
			Если Й > Строки.ВГраница() Или Не ЭтоЗаголовокМетода(Строки[Й]) Тогда
				Для К = НачДир По Мин(Й, Строки.ВГраница()) Цикл
					Вне.Добавить(Строки[К]);
				КонецЦикла;
				Продолжить;
			КонецЕсли;
			Ив = ИмяИВидИзЗаголовка(Строки[Й]);
			ЙЗаг = Й;
			Конец = ?(Ив.kind = "Функция", "КонецФункции", "КонецПроцедуры");
			Й = Й + 1;
			Пока Й <= Строки.ВГраница() И Не ЭтоКонецМетода(Строки[Й], Ив.kind) Цикл
				Й = Й + 1;
			КонецЦикла;
			ЙКон = ?(Й <= Строки.ВГраница(), Й, Строки.ВГраница());
			Кусок = Новый Массив;
			Для К = НачДир По ЙКон Цикл
				Кусок.Добавить(Строки[К]);
			КонецЦикла;
			ЙКонЗаг = ЙЗаг;
			Для К = ЙЗаг По ЙКон - 1 Цикл
				ЙКонЗаг = К;
				Если СтрНайти(Строки[К], ")") > 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Заг = Новый Массив;
			Для К = ЙЗаг По ЙКонЗаг Цикл
				Заг.Добавить(Строки[К]);
			КонецЦикла;
			Тело = Новый Массив;
			Для К = ЙКонЗаг + 1 По ЙКон - 1 Цикл
				Тело.Добавить(Строки[К]);
			КонецЦикла;
			Дир = Новый Массив;
			Для К = НачДир По ЙЗаг - 1 Цикл
				Сп3 = СокрЛП(Строки[К]);
				Если СтрНачинаетсяС(Сп3, "&") И Не СтрНачинаетсяС(Сп3, "&ИзменениеИКонтроль")
					И Не СтрНачинаетсяС(Сп3, "&Вместо") И Не СтрНачинаетсяС(Сп3, "&Перед")
					И Не СтрНачинаетсяС(Сп3, "&После") Тогда
					Дир.Добавить(Сп3);
				КонецЕсли;
			КонецЦикла;
			Мт = Новый Структура("name, kind, text, header, body, directives",
				Ив.name, Ив.kind, СтрСоединить(Кусок, Символы.ПС),
				СтрСоединить(Заг, Символы.ПС), СтрСоединить(Тело, Символы.ПС),
				СтрСоединить(Дир, Символы.ПС));
			Рез.methods.Добавить(Мт);
			Если Ив.name <> "" Тогда
				Рез.byName.Вставить(Ив.name, Мт);
			КонецЕсли;
			Й = ЙКон + 1;
			Продолжить;
		КонецЕсли;
		Вне.Добавить(С);
		Й = Й + 1;
	КонецЦикла;
	Рез.outside = СтрСоединить(Вне, Символы.ПС);
	Возврат Рез;
КонецФункции

Функция СобратьТекстИиК(МтТип, МтУп) Экспорт
	ПодключитьМодули();
	ТелоТип = МтТип.body;
	ТелоУп = МтУп.body;
	П = Синтез.ПостроитьТелоИкДляРасширения(ТелоТип, ТелоУп, "", МтТип.name);
	ТелоИк = "";
	Если П.hook = "changeAndControl" И П.decision = "auto" И СокрЛП(П.hookBody) <> "" Тогда
		ТелоИк = П.hookBody;
	Иначе
		П2 = Синтез.ПолнаяЗаменаИк(ТелоТип, ТелоУп, "дифф typovaya→УП", Истина);
		Если П2.decision <> "auto" Или СокрЛП(П2.hookBody) = "" Тогда
			Прич = П2.reason;
			Если Прич = "" Тогда
				Прич = П.reason;
			КонецЕсли;
			Возврат Новый Структура("ok, text, reason", Ложь, "", Прич);
		КонецЕсли;
		ТелоИк = П2.hookBody;
	КонецЕсли;
	Дир = МтТип.directives;
	Конец = ?(МтТип.kind = "Функция", "КонецФункции", "КонецПроцедуры");
	Преф = "&ИзменениеИКонтроль(""" + МтТип.name + """)";
	Текст = ?(Дир = "", "", Дир + Символы.ПС)
		+ Преф + Символы.ПС
		+ МтТип.header + Символы.ПС
		+ ТелоИк + Символы.ПС
		+ Конец;
	Возврат Новый Структура("ok, text, reason", Истина, Текст, "");
КонецФункции

Функция ИменаВызванныеИзТекста(Текст, МетодыПоИмени)
	Р = Новый Массив;
	Т = Прот.ТекстМетодаБезСтрокИКомментариев(Текст);
	Для Каждого КЗ Из МетодыПоИмени Цикл
		Имя = КЗ.Ключ;
		Если Прот.ЕстьИдентификаторВТексте(Т, Имя) Тогда
			Р.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ДобавитьБлокиФормыРасширения(ПутьФормыТип, ПутьФормыУп, ПутьФормыРасш, Имена) Экспорт
	Если Имена.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	ТекстУп = ТекстUtf8(ПутьФормыУп);
	Если ТекстУп = "" Тогда
		Возврат 0;
	КонецЕсли;
	Добавлено = 0;
	Атрибуты = Новый Массив;
	Команды = Новый Массив;
	Элементы = Новый Массив;
	Для Каждого Имя Из Имена Цикл
		Бл = ИзвлечьБлокXmlПоИмени(ТекстУп, "Attribute", Имя);
		Если Бл <> "" Тогда
			Атрибуты.Добавить(Бл);
			Добавлено = Добавлено + 1;
			Продолжить;
		КонецЕсли;
		Бл = ИзвлечьБлокXmlПоИмени(ТекстУп, "Command", Имя);
		Если Бл <> "" Тогда
			Команды.Добавить(Бл);
			Добавлено = Добавлено + 1;
			Продолжить;
		КонецЕсли;
		Бл = ИзвлечьЭлементXmlПоИмени(ТекстУп, Имя);
		Если Бл <> "" Тогда
			Элементы.Добавить(Бл);
			Добавлено = Добавлено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Добавлено = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если (Новый Файл(ПутьФормыРасш)).Существует() Тогда
		Текст = ТекстUtf8(ПутьФормыРасш);
	Иначе
		Текст = ЗаготовкаFormXmlРасширения(ТекстУп);
	КонецЕсли;
	Текст = ВставитьБлокиВFormXml(Текст, "Attributes", Атрибуты);
	Текст = ВставитьБлокиВFormXml(Текст, "Commands", Команды);
	Текст = ВставитьБлокиВFormXml(Текст, "ChildItems", Элементы);
	ЗаписатьТекст(ПутьФормыРасш, Текст);
	Возврат Добавлено;
КонецФункции

Функция ТекстФормыЕслиЕсть(Путь)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Возврат ТекстUtf8(Путь);
КонецФункции

Функция БлокМетаФормыПоИмени(Текст, Имя)
	Если Текст = "" Или Имя = "" Тогда
		Возврат "";
	КонецЕсли;
	Бл = ИзвлечьБлокXmlПоИмени(Текст, "Attribute", Имя);
	Если Бл <> "" Тогда
		Возврат Бл;
	КонецЕсли;
	Бл = ИзвлечьБлокXmlПоИмени(Текст, "Command", Имя);
	Если Бл <> "" Тогда
		Возврат Бл;
	КонецЕсли;
	Возврат ИзвлечьЭлементXmlПоИмени(Текст, Имя);
КонецФункции

Функция СекцияБлокаМетаФормы(Блок)
	С = СокрЛ(Блок);
	Если СтрНачинаетсяС(С, "<Attribute") Тогда
		Возврат "Attributes";
	ИначеЕсли СтрНачинаетсяС(С, "<Command") Тогда
		Возврат "Commands";
	КонецЕсли;
	Возврат "ChildItems";
КонецФункции

Функция ЭтоДинамическийСписокФормы(Блок)
	Возврат СтрНайти(Блок, "<MainTable>") > 0 Или СтрНайти(Блок, "cfg:DynamicList") > 0 Или СтрНайти(Блок, "DynamicList") > 0;
КонецФункции

Функция УбратьУзелXml(Текст, Тег)
	Откр = "<" + Тег + ">";
	Закр = "</" + Тег + ">";
	Пока Истина Цикл
		П = СтрНайти(Текст, Откр);
		Если П = 0 Тогда
			Возврат Текст;
		КонецЕсли;
		П2 = СтрНайти(Текст, Закр, , П);
		Если П2 = 0 Тогда
			Возврат Текст;
		КонецЕсли;
		Текст = Лев(Текст, П - 1) + Сред(Текст, П2 + СтрДлина(Закр));
	КонецЦикла;
	Возврат Текст;
КонецФункции

// Реквизиты/команды/элементы, на которые ссылается модуль формы расширения:
// типовые (есть в typovaya/БП или уже в restored/главной) — блок из заимствованной формы;
// только УП и их нет в главной — собственные, блок из УП.
Функция ДополнитьFormXmlРасшПоМодулю(ПутьФормыТип, ПутьФормыУп, ПутьФормыБп, ПутьФормыВосст, ПутьФормыРасш, ТекстМодуляРасш) Экспорт
	ПодключитьМодули();
	Если ПутьФормыРасш = "" Или СокрЛП(ТекстМодуляРасш) = "" Тогда
		Возврат 0;
	КонецЕсли;
	ТекстТип = ТекстФормыЕслиЕсть(ПутьФормыТип);
	ТекстУп = ТекстФормыЕслиЕсть(ПутьФормыУп);
	ТекстБп = ТекстФормыЕслиЕсть(ПутьФормыБп);
	ТекстВосст = ТекстФормыЕслиЕсть(ПутьФормыВосст);
	ТекстКод = Прот.ТекстМетодаБезСтрокИКомментариев(ТекстМодуляРасш);
	ИменаТип = ИменаМетаФормыИзТекста(ТекстТип);
	ИменаУп = ИменаМетаФормыИзТекста(ТекстУп);
	ИменаБп = ИменаМетаФормыИзТекста(ТекстБп);
	ИменаВосст = ИменаМетаФормыИзТекста(ТекстВосст);
	ВсеИмена = Новый Соответствие;
	Для Каждого КЗ Из ИменаТип Цикл
		ВсеИмена.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из ИменаУп Цикл
		ВсеИмена.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из ИменаБп Цикл
		ВсеИмена.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из ИменаВосст Цикл
		ВсеИмена.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Если (Новый Файл(ПутьФормыРасш)).Существует() Тогда
		ТекстРасшФ = ТекстUtf8(ПутьФормыРасш);
	Иначе
		Основа = ?(ТекстУп <> "", ТекстУп, ?(ТекстВосст <> "", ТекстВосст, ТекстТип));
		ТекстРасшФ = ЗаготовкаFormXmlРасширения(Основа);
	КонецЕсли;
	ИменаУже = ИменаМетаФормыИзТекста(ТекстРасшФ);
	Атрибуты = Новый Массив;
	Команды = Новый Массив;
	Элементы = Новый Массив;
	Добавлено = 0;
	Для Каждого КЗ Из ВсеИмена Цикл
		Имя = КЗ.Ключ;
		Если ИменаУже.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если Не Прот.ЕстьИдентификаторВТексте(ТекстКод, Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЕстьВГлавной = ИменаВосст.Получить(Имя) = Истина Или ИменаТип.Получить(Имя) = Истина Или ИменаБп.Получить(Имя) = Истина;
		Бл = "";
		Если ЕстьВГлавной Тогда
			Если ИменаВосст.Получить(Имя) = Истина Тогда
				Бл = БлокМетаФормыПоИмени(ТекстВосст, Имя);
			ИначеЕсли ИменаТип.Получить(Имя) = Истина Тогда
				Бл = БлокМетаФормыПоИмени(ТекстТип, Имя);
			Иначе
				Бл = БлокМетаФормыПоИмени(ТекстБп, Имя);
			КонецЕсли;
		ИначеЕсли ИменаУп.Получить(Имя) = Истина Тогда
			Бл = БлокМетаФормыПоИмени(ТекстУп, Имя);
		КонецЕсли;
		Если Бл = "" Тогда
			Продолжить;
		КонецЕсли;
		Сек = СекцияБлокаМетаФормы(Бл);
		// Типовые элементы (ChildItems) уже есть на заимствованной форме.
		// Полная копия XML ломает загрузку: «Неверный путь к данным» / «Неверное имя команды».
		Если ЕстьВГлавной И Сек = "ChildItems" Тогда
			// Типовой элемент не копируем; если в БП/УП есть одноимённый реквизит — берём его как свой.
			БлАтр = ИзвлечьБлокXmlПоИмени(ТекстБп, "Attribute", Имя);
			Если БлАтр = "" Тогда
				БлАтр = ИзвлечьБлокXmlПоИмени(ТекстУп, "Attribute", Имя);
			КонецЕсли;
			Если БлАтр = "" Тогда
				Продолжить;
			КонецЕсли;
			Бл = БлАтр;
			Сек = "Attributes";
		КонецЕсли;
		Если ЭтоДинамическийСписокФормы(Бл) Тогда
			Продолжить;
		КонецЕсли;
		Если Сек = "Attributes" Тогда
			Бл = УбратьУзелXml(Бл, "FunctionalOptions");
			Если ЕстьВГлавной Тогда
				Бл = УбратьУзелXml(Бл, "UseAlways");
				Бл = УбратьУзелXml(Бл, "Columns");
			КонецЕсли;
			Атрибуты.Добавить(Бл);
		ИначеЕсли Сек = "Commands" Тогда
			Команды.Добавить(Бл);
		Иначе
			Элементы.Добавить(Бл);
		КонецЕсли;
		ИменаУже.Вставить(Имя, Истина);
		Добавлено = Добавлено + 1;
	КонецЦикла;
	Если Добавлено = 0 Тогда
		Возврат 0;
	КонецЕсли;
	ТекстРасшФ = ВставитьБлокиВFormXml(ТекстРасшФ, "Attributes", Атрибуты);
	ТекстРасшФ = ВставитьБлокиВFormXml(ТекстРасшФ, "Commands", Команды);
	ТекстРасшФ = ВставитьБлокиВFormXml(ТекстРасшФ, "ChildItems", Элементы);
	СоздатьКаталог((Новый Файл(ПутьФормыРасш)).Путь);
	ЗаписатьТекст(ПутьФормыРасш, ТекстРасшФ);
	Возврат Добавлено;
КонецФункции

Функция ЗаготовкаFormXmlРасширения(ТекстУп)
	П = СтрНайти(ТекстУп, "<Form");
	П2 = 0;
	Если П > 0 Тогда
		П2 = СтрНайти(ТекстУп, ">", , П);
	КонецЕсли;
	Откр = "<Form xmlns=""http://v8.1c.ru/8.3/xcf/logform"" version=""2.21"">";
	Если П > 0 И П2 > П Тогда
		Откр = Сред(ТекстУп, П, П2 - П + 1);
	КонецЕсли;
	Возврат "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС
		+ Откр + Символы.ПС
		+ "	<AutoCommandBar name=""ФормаКоманднаяПанель"" id=""-1""/>" + Символы.ПС
		+ "	<Attributes/>" + Символы.ПС
		+ "	<Commands/>" + Символы.ПС
		+ "	<ChildItems/>" + Символы.ПС
		+ "</Form>" + Символы.ПС;
КонецФункции

Функция ВставитьБлокиВFormXml(Текст, Секция, Блоки)
	Если Блоки.Количество() = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Кусок = СтрСоединить(Блоки, Символы.ПС);
	Пустая = "<" + Секция + "/>";
	Если СтрНайти(Текст, Пустая) > 0 Тогда
		Возврат СтрЗаменить(Текст, Пустая, "<" + Секция + ">" + Символы.ПС + Кусок + Символы.ПС + "	</" + Секция + ">");
	КонецЕсли;
	Маркер = "</" + Секция + ">";
	Поз = СтрНайти(Текст, Маркер, НаправлениеПоиска.СКонца);
	Если Поз > 0 Тогда
		Возврат Лев(Текст, Поз - 1) + Кусок + Символы.ПС + Сред(Текст, Поз);
	КонецЕсли;
	ПозК = СтрНайти(Текст, "</Form>", НаправлениеПоиска.СКонца);
	Если ПозК = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозК - 1) + "	<" + Секция + ">" + Символы.ПС + Кусок + Символы.ПС + "	</" + Секция + ">" + Символы.ПС + Сред(Текст, ПозК);
КонецФункции

Функция ИзвлечьБлокXmlПоИмени(Текст, Тег, Имя) Экспорт
	Маркер = "<" + Тег + " name=""" + Имя + """";
	П = СтрНайти(Текст, Маркер);
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат ИзвлечьСбалансированныйБлок(Текст, П, Тег);
КонецФункции

Функция ИзвлечьЭлементXmlПоИмени(Текст, Имя)
	Игл = " name=""" + Имя + """";
	П = 1;
	Пока П > 0 Цикл
		П = СтрНайти(Текст, Игл, , П);
		Если П = 0 Тогда
			Возврат "";
		КонецЕсли;
		Откр = СтрНайти(Лев(Текст, П), "<", НаправлениеПоиска.СКонца);
		Если Откр = 0 Тогда
			П = П + СтрДлина(Игл);
			Продолжить;
		КонецЕсли;
		Тег = Сред(Текст, Откр + 1, П - Откр - 1);
		Тег = СокрЛП(Тег);
		Если Тег = "Attribute" Или Тег = "Command" Или Тег = "" Тогда
			П = П + СтрДлина(Игл);
			Продолжить;
		КонецЕсли;
		Возврат ИзвлечьСбалансированныйБлок(Текст, Откр, Тег);
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИзвлечьСбалансированныйБлок(Текст, Нач, Тег)
	ПКонТега = СтрНайти(Текст, ">", , Нач);
	Если ПКонТега > 0 И Сред(Текст, ПКонТега - 1, 2) = "/>" Тогда
		Возврат Сред(Текст, Нач, ПКонТега - Нач + 1);
	КонецЕсли;
	Закр = "</" + Тег + ">";
	ОткрИгл = "<" + Тег;
	Глуб = 0;
	Й = Нач;
	Дл = СтрДлина(Текст);
	Пока Й <= Дл Цикл
		ПОткр = СтрНайти(Текст, ОткрИгл, , Й);
		ПЗакр = СтрНайти(Текст, Закр, , Й);
		Если ПОткр = 0 И ПЗакр = 0 Тогда
			Прервать;
		КонецЕсли;
		Если ПОткр > 0 И (ПЗакр = 0 Или ПОткр < ПЗакр) Тогда
			След = Сред(Текст, ПОткр + СтрДлина(ОткрИгл), 1);
			Если След <> " " И След <> ">" И След <> "/" И След <> Символы.ПС И След <> Символы.Таб Тогда
				Й = ПОткр + СтрДлина(ОткрИгл);
				Продолжить;
			КонецЕсли;
			Глуб = Глуб + 1;
			Й = ПОткр + СтрДлина(ОткрИгл);
		Иначе
			Глуб = Глуб - 1;
			Й = ПЗакр + СтрДлина(Закр);
			Если Глуб = 0 Тогда
				Возврат Сред(Текст, Нач, Й - Нач);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ОбработатьМодульФормы(Отн, КореньТип, КореньУп, КатРасш, ОмУп, Рез) Экспорт
	ПодключитьМодули();
	ПутьТип = ОбъединитьПути(КореньТип, Отн);
	ПутьУп = ОбъединитьПути(КореньУп, Отн);
	ПутьМТип = Прот.ПутьМодуляФормы(ПутьТип);
	ПутьМУп = Прот.ПутьМодуляФормы(ПутьУп);
	Если Не (Новый Файл(ПутьМТип)).Существует() Тогда
		Рез.todo.Добавить(Отн + ": нет модуля typovaya");
		Возврат;
	КонецЕсли;
	Если Не (Новый Файл(ПутьМУп)).Существует() Тогда
		Рез.todo.Добавить(Отн + ": нет модуля УП");
		Возврат;
	КонецЕсли;
	РаздТип = РазобратьМодульНаМетоды(ТекстUtf8(ПутьМТип));
	РаздУп = РазобратьМодульНаМетоды(ТекстUtf8(ПутьМУп));
	Если Прот.МетодСсылаетсяНаОм(РаздТип.outside, ОмУп) Тогда
		Рез.todo.Добавить(Отн + ": код вне процедур ссылается на ОМ только УП, оставлено в todo");
	КонецЕсли;
	Части = Новый Массив;
	НужныеУп = Новый Соответствие;
	ИменаДляФормы = Новый Массив;
	УжеИменаФормы = Новый Соответствие;
	ИменаТипФормы = Прот.ИменаВсехИменФормыXml(ПутьТип);
	ИменаУпФормы = Прот.ИменаВсехИменФормыXml(ПутьУп);
	Для Каждого МтТип Из РаздТип.methods Цикл
		Если Не Прот.МетодСсылаетсяНаОм(МтТип.text, ОмУп) Тогда
			Продолжить;
		КонецЕсли;
		МтУп = РаздУп.byName.Получить(МтТип.name);
		Если МтУп = Неопределено Тогда
			Рез.todo.Добавить(Отн + " метод " + МтТип.name + " — нет в УП, оставлено в todo");
			Продолжить;
		КонецЕсли;
		Соб = СобратьТекстИиК(МтТип, МтУп);
		Если Не Соб.ok Тогда
			Рез.todo.Добавить(Отн + " метод " + МтТип.name + " — " + Соб.reason + ", оставлено в todo");
			Продолжить;
		КонецЕсли;
		Части.Добавить(Соб.text);
		Рез.closed.Добавить(МтТип.name);
		Для Каждого ИмяВыз Из ИменаВызванныеИзТекста(МтУп.text, РаздУп.byName) Цикл
			Если РаздТип.byName.Получить(ИмяВыз) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			НужныеУп.Вставить(ИмяВыз, Истина);
		КонецЦикла;
		ТелоУпКод = Прот.ТекстМетодаБезСтрокИКомментариев(МтУп.text);
		Для Каждого КЗ Из ИменаУпФормы Цикл
			Имя = КЗ.Ключ;
			Если ИменаТипФормы.Получить(Имя) <> Неопределено Или Прот.ЭтоСтандартноеПолеФормы(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Если Не Прот.ЕстьИдентификаторВТексте(ТелоУпКод, Имя) Тогда
				Продолжить;
			КонецЕсли;
			Если УжеИменаФормы.Получить(Имя) = Истина Тогда
				Продолжить;
			КонецЕсли;
			УжеИменаФормы.Вставить(Имя, Истина);
			ИменаДляФормы.Добавить(Имя);
		КонецЦикла;
	КонецЦикла;
	// замыкание UP-only методов
	Изменилось = Истина;
	Пока Изменилось Цикл
		Изменилось = Ложь;
		Текущие = Новый Массив;
		Для Каждого КЗ Из НужныеУп Цикл
			Текущие.Добавить(КЗ.Ключ);
		КонецЦикла;
		Для Каждого Имя Из Текущие Цикл
			МтУп = РаздУп.byName.Получить(Имя);
			Если МтУп = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого ИмяВыз Из ИменаВызванныеИзТекста(МтУп.text, РаздУп.byName) Цикл
				Если РаздТип.byName.Получить(ИмяВыз) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если НужныеУп.Получить(ИмяВыз) = Истина Тогда
					Продолжить;
				КонецЕсли;
				НужныеУп.Вставить(ИмяВыз, Истина);
				Изменилось = Истина;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Для Каждого КЗ Из НужныеУп Цикл
		МтУп = РаздУп.byName.Получить(КЗ.Ключ);
		Если МтУп = Неопределено Или СокрЛП(МтУп.text) = "" Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(СокрП(МтУп.text));
		Если Не ЕстьВМассиве(Рез.moved, МтУп.name) Тогда
			Рез.moved.Добавить(МтУп.name);
		КонецЕсли;
	КонецЦикла;
	Если ИменаДляФормы.Количество() > 0 Тогда
		Н = ДобавитьБлокиФормыРасширения(ПутьТип, ПутьУп, ОбъединитьПути(КатРасш, Отн), ИменаДляФормы);
		Рез.formItems = Рез.formItems + Н;
		Если Н > 0 Тогда
			Рез.attrs.Добавить(Отн + ": " + СтрСоединить(ИменаДляФормы, ", "));
		Иначе
			Рез.todo.Добавить(Отн + " — не удалось добавить в Form.xml расширения: " + СтрСоединить(ИменаДляФормы, ", "));
		КонецЕсли;
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ХвостМ = Лев(Отн, СтрДлина(Отн) - СтрДлина("Form.xml")) + "Form\Module.bsl";
	ПутьМРасш = ОбъединитьПути(КатРасш, ХвостМ);
	ТекстРасш = "";
	Если (Новый Файл(ПутьМРасш)).Существует() Тогда
		ТекстРасш = ТекстUtf8(ПутьМРасш);
	КонецЕсли;
	Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (ОМ только УП)";
	Поз = СтрНайти(ТекстРасш, Маркер);
	Если Поз > 0 Тогда
		ТекстРасш = СокрП(Лев(ТекстРасш, Поз - 1));
	КонецЕсли;
	ТекстРасш = СокрП(ТекстРасш) + ?(СокрЛП(ТекстРасш) = "", "", Символы.ПС + Символы.ПС)
		+ Маркер + Символы.ПС + СтрСоединить(Части, Символы.ПС + Символы.ПС) + Символы.ПС;
	ЗаписатьТекст(ПутьМРасш, ТекстРасш);
	Рез.hooks = Рез.hooks + Части.Количество();
КонецПроцедуры

Функция Применить(КореньТип, КореньУп, КатРасш, СписокФорм, Лог, КаталогОтчёта = "") Экспорт
	ПодключитьМодули();
	Рез = Новый Структура("forms, closed, moved, todo, hooks, formItems, attrs, rows",
		0, Новый Массив, Новый Массив, Новый Массив, 0, 0, Новый Массив, Новый Массив);
	ОмУп = Прот.ОбщиеМодулиТолькоВПервой(КореньУп, КореньТип);
	Если Лог <> Неопределено Тогда
		Лог.Добавить("ОМ только УП: " + ОмУп.Количество() + ", форм в списке: " + СписокФорм.Количество());
	КонецЕсли;
	СоздатьКаталог(КатРасш);
	Для Каждого ОтнСырой Из СписокФорм Цикл
		Отн = Прот.НормПуть(ОтнСырой);
		Зак0 = Рез.closed.Количество();
		Пер0 = Рез.moved.Количество();
		Тод0 = Рез.todo.Количество();
		Прич = ОбеспечитьЗаимствованиеФормы(Отн, КореньТип, КатРасш);
		Если Прич <> "" Тогда
			Рез.todo.Добавить(Отн + " — заимствование: " + Прич);
			Продолжить;
		КонецЕсли;
		ОбработатьМодульФормы(Отн, КореньТип, КореньУп, КатРасш, ОмУп, Рез);
		Было = (Рез.closed.Количество() - Зак0) + (Рез.moved.Количество() - Пер0);
		Если Было > 0 Тогда
			Рез.forms = Рез.forms + 1;
		КонецЕсли;
		Рез.rows.Добавить(Отн);
		Если Лог <> Неопределено Тогда
			Лог.Добавить("  " + Отн + " iik=" + (Рез.closed.Количество() - Зак0)
				+ " added=" + (Рез.moved.Количество() - Пер0)
				+ " todo=" + (Рез.todo.Количество() - Тод0));
		КонецЕсли;
	КонецЦикла;
	Если КаталогОтчёта <> "" Тогда
		ЗаписатьОтчёт(КаталогОтчёта, Рез);
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("DONE forms=" + Рез.forms + " iikMethods=" + Рез.closed.Количество()
			+ " upOnlyMethods=" + Рез.moved.Количество() + " formItems=" + Рез.formItems
			+ " todo=" + Рез.todo.Количество() + " hooks=" + Рез.hooks);
	КонецЕсли;
	Возврат Рез;
КонецФункции

Процедура ЗаписатьОтчёт(Каталог, Рез)
	СоздатьКаталог(Каталог);
	Стат = "{""forms"":" + Рез.forms
		+ ",""iikMethods"":" + Рез.closed.Количество()
		+ ",""upOnlyMethods"":" + Рез.moved.Количество()
		+ ",""formItems"":" + Рез.formItems
		+ ",""hooks"":" + Рез.hooks
		+ ",""todo"":" + Рез.todo.Количество() + "}";
	ЗаписатьТекст(ОбъединитьПути(Каталог, "iik_stat.json"), Стат);
	Если Рез.todo.Количество() > 0 Тогда
		ЗаписатьТекст(ОбъединитьПути(Каталог, "iik_todo.txt"), СтрСоединить(Рез.todo, Символы.ПС) + Символы.ПС);
	КонецЕсли;
	Если Рез.attrs.Количество() > 0 Тогда
		ЗаписатьТекст(ОбъединитьПути(Каталог, "iik_form_items.txt"), СтрСоединить(Рез.attrs, Символы.ПС) + Символы.ПС);
	КонецЕсли;
КонецПроцедуры

Функция НормПрефиксПути(Путь)
	П = СокрЛП(Путь);
	П = СтрЗаменить(П, "/", "\");
	Пока СтрЗаканчиваетсяНа(П, "\") Цикл
		П = Лев(П, СтрДлина(П) - 1);
	КонецЦикла;
	Возврат НРег(П);
КонецФункции

Функция ПутьЗапрещёнДляЗаписи(Путь) Экспорт
	П = НормПрефиксПути(Путь);
	Если П = "" Тогда
		Возврат Истина;
	КонецЕсли;
	Запрет = Новый Массив;
	Запрет.Добавить("d:\typovaya-up-forms-cm-meta56\load");
	Запрет.Добавить("d:\typovaya-up-forms-cm-classa");
	Запрет.Добавить("d:\typovaya-up-forms-cm-uprest");
	Запрет.Добавить("d:\выгрузка уп");
	Запрет.Добавить("d:\выгрузка бп");
	Запрет.Добавить("d:\typovaya-up-out-20261118u");
	Запрет.Добавить("d:\dtypovaya-up-load-e");
	Запрет.Добавить("d:\typovaya-up-out-mf2-manual");
	Запрет.Добавить("d:\typovaya-up-tmp-check2");
	Запрет.Добавить("d:\typovaya-up-forms-cm-classa\load");
	Для Каждого З Из Запрет Цикл
		Если П = З Или СтрНачинаетсяС(П, З + "\") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции


Функция ЭтоКонецМетода(С, Вид)
	// 1С не чувствителен к регистру ключевых слов: «Конецфункции» = «КонецФункции».
	Т = СокрЛП(С);
	Конец = ?(Вид = "Функция", "КонецФункции", "КонецПроцедуры");
	ТН = НРег(Т);
	КН = НРег(Конец);
	Если ТН = КН Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНачинаетсяС(ТН, КН) Тогда
		Если СтрДлина(ТН) = СтрДлина(КН) Тогда
			Возврат Истина;
		КонецЕсли;
		След = Сред(Т, СтрДлина(КН) + 1, 1);
		Возврат След = " " Или След = Символы.Таб Или След = ";" Или След = "/";
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция МетодВызываетсяВОставшемсяТексте(ТекстОстатка, Имя)
	Если Имя = "" Или ТекстОстатка = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(ТекстОстатка, Имя + "(") > 0 Или СтрНайти(ТекстОстатка, Имя + " (") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Прот.ЕстьИдентификаторВТексте(ТекстОстатка, Имя);
КонецФункции

Функция БалансОбластейМодуля(Текст)
	Б = 0;
	Т = СтрЗаменить(Строка(Текст), Символы.ВК, "");
	Для Каждого С Из СтрРазделить(Т, Символы.ПС, Истина) Цикл
		Сп = СокрЛП(С);
		Если СтрНачинаетсяС(Сп, "#Область") Или СтрНачинаетсяС(НРег(Сп), "#region") Тогда
			Б = Б + 1;
		ИначеЕсли СтрНачинаетсяС(Сп, "#КонецОбласти") Или СтрНачинаетсяС(НРег(Сп), "#endregion") Тогда
			Б = Б - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Б;
КонецФункции

Функция ВосстановитьДирективыМетодов(ТекстНов, ТекстИсх)
	Если ТекстНов = "" Или ТекстИсх = "" Или ТекстНов = ТекстИсх Тогда
		Возврат ТекстНов;
	КонецЕсли;
	РаздИсх = РазобратьМодульНаМетоды(ТекстИсх);
	РаздНов = РазобратьМодульНаМетоды(ТекстНов);
	Рез = ТекстНов;
	Для Каждого МтНов Из РаздНов.methods Цикл
		МтИсх = РаздИсх.byName.Получить(МтНов.name);
		Если МтИсх = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ДирИсх = СокрЛП(МтИсх.directives);
		Если ДирИсх = "" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(МтНов.text, ДирИсх) > 0 Тогда
			Продолжить;
		КонецЕсли;
		НовыйТекст = ДирИсх + Символы.ПС + МтНов.text;
		З = ЗаменитьУникальныйФрагмент(Рез, МтНов.text, НовыйТекст);
		Если З.ok Тогда
			Рез = З.text;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ОткатитьЕслиНарушенБалансОбластей(ТекстНов, ТекстИсх, Отн, Рез, Что)
	Если БалансОбластейМодуля(ТекстИсх) = БалансОбластейМодуля(ТекстНов) Тогда
		Возврат ТекстНов;
	КонецЕсли;
	Если БалансОбластейМодуля(ТекстНов) = 0 Тогда
		Возврат ТекстНов;
	КонецЕсли;
	Рез.todo.Добавить(Отн + " — нарушен баланс #Область после " + Что + ", модуль restored откатан");
	Возврат ТекстИсх;
КонецФункции

Функция ЗаменитьУникальныйФрагмент(Текст, Старый, НовыйТекст)
	Если Старый = "" Тогда
		Возврат Новый Структура("ok, text, reason", Ложь, Текст, "пустой фрагмент");
	КонецЕсли;
	Сч = СтрЧислоВхождений(Текст, Старый);
	Если Сч <> 1 Тогда
		Возврат Новый Структура("ok, text, reason", Ложь, Текст, "фрагмент встречается " + Сч + " раз");
	КонецЕсли;
	Возврат Новый Структура("ok, text, reason", Истина, СтрЗаменить(Текст, Старый, НовыйТекст), "");
КонецФункции

Функция ИменаМетодовИиКИзТекста(Текст) Экспорт
	Рез = Новый Соответствие;
	Если Текст = "" Тогда
		Возврат Рез;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("&ИзменениеИКонтроль\(""([^""]+)""\)");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Имя = СокрЛП(С.Группы[1].Значение);
		Если Имя <> "" Тогда
			Рез.Вставить(Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ИменаОбработчиковFormXml(ПутьFormXml) Экспорт
	Рез = Новый Соответствие;
	Если ПутьFormXml = "" Или Не (Новый Файл(ПутьFormXml)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("<(Event|Action)\b[^>]*>([^<]+)</(Event|Action)>");
	Для Каждого С Из Рв.НайтиСовпадения(ТекстUtf8(ПутьFormXml)) Цикл
		Имя = СокрЛП(С.Группы[2].Значение);
		Если Имя <> "" Тогда
			Рез.Вставить(Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ЭтоОбработчикФормы(Имя, ПутьФормыВосст, ПутьФормыРасш)
	Если Имя = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Обр = ИменаОбработчиковFormXml(ПутьФормыВосст);
	Если Обр.Получить(Имя) = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	ОбрР = ИменаОбработчиковFormXml(ПутьФормыРасш);
	Возврат ОбрР.Получить(Имя) = Истина;
КонецФункции


Функция НормТекст(Текст)
	Т = СтрЗаменить(Строка(Текст), Символы.ВК, "");
	Пока СтрДлина(Т) > 0 Цикл
		С = Лев(Т, 1);
		Если С = Символы.ПС Или С = " " Или С = Символы.Таб Тогда
			Т = Сред(Т, 2);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Пока СтрДлина(Т) > 0 Цикл
		С = Прав(Т, 1);
		Если С = Символы.ПС Или С = " " Или С = Символы.Таб Тогда
			Т = Лев(Т, СтрДлина(Т) - 1);
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Т;
КонецФункции


Функция НормБлок(Текст)
	Т = НормТекст(Текст);
	Пока СтрНайти(Т, Символы.ПС + Символы.ПС) > 0 Цикл
		Т = СтрЗаменить(Т, Символы.ПС + Символы.ПС, Символы.ПС);
	КонецЦикла;
	Возврат Т;
КонецФункции


Функция НормДирективыКомпиляции(Дир)
	Т = СтрЗаменить(Строка(Дир), Символы.ВК, "");
	Части = Новый Массив;
	Для Каждого С Из СтрРазделить(Т, Символы.ПС, Ложь) Цикл
		Сп = СокрЛП(С);
		Если Сп = "" Тогда
			Продолжить;
		КонецЕсли;
		Н = НРег(Сп);
		Если СтрНачинаетсяС(Н, "&изменениеиконтроль") Или СтрНачинаетсяС(Н, "&вместо")
			Или СтрНачинаетсяС(Н, "&перед") Или СтрНачинаетсяС(Н, "&после") Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(Н);
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

Функция НормСигнатураМетода(Мт)
	Заг = СтрЗаменить(СтрЗаменить(СтрЗаменить(Строка(Мт.header), Символы.ВК, ""), Символы.ПС, " "), Символы.Таб, " ");
	Поз1 = СтрНайти(Заг, "(");
	Поз2 = 0;
	Для Й = 1 По СтрДлина(Заг) Цикл
		Если Сред(Заг, Й, 1) = ")" Тогда
			Поз2 = Й;
		КонецЕсли;
	КонецЦикла;
	Парамы = "";
	Если Поз1 > 0 И Поз2 > Поз1 Тогда
		Парамы = Сред(Заг, Поз1 + 1, Поз2 - Поз1 - 1);
	КонецЕсли;
	Имена = Новый Массив;
	Для Каждого Кусок Из СтрРазделить(Парамы, ",", Ложь) Цикл
		К = СокрЛП(Кусок);
		Если К = "" Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(НРег(К), "знач ") Тогда
			К = СокрЛП(Сред(К, 6));
		КонецЕсли;
		Пр = СтрНайти(К, "=");
		Если Пр > 0 Тогда
			К = СокрЛП(Лев(К, Пр - 1));
		КонецЕсли;
		Имена.Добавить(НРег(К));
	КонецЦикла;
	Возврат НРег(Строка(Мт.kind)) + "|" + СтрСоединить(Имена, ",");
КонецФункции

Функция СтороныДирективы(Дир)
	Н = НормДирективыКомпиляции(Дир);
	Р = Новый Структура("Клиент, Сервер, БезКонтекста", Ложь, Ложь, Ложь);
	Если СтрНайти(Н, "наклиентенасерверебезконтекста") > 0 Тогда
		Р.Клиент = Истина;
		Р.Сервер = Истина;
		Р.БезКонтекста = Истина;
	ИначеЕсли СтрНайти(Н, "насерверебезконтекста") > 0 Тогда
		Р.Сервер = Истина;
		Р.БезКонтекста = Истина;
	ИначеЕсли СтрНайти(Н, "наклиентенасервере") > 0 Тогда
		Р.Клиент = Истина;
		Р.Сервер = Истина;
	ИначеЕсли СтрНайти(Н, "наклиенте") > 0 Тогда
		Р.Клиент = Истина;
	ИначеЕсли СтрНайти(Н, "насервере") > 0 Тогда
		Р.Сервер = Истина;
	Иначе
		Р.Клиент = Истина;
		Р.Сервер = Истина;
	КонецЕсли;
	Возврат Р;
КонецФункции

Функция ВызовДопустимПоДирективам(ДирВыз, ДирЦели)
	В = СтороныДирективы(ДирВыз);
	Ц = СтороныДирективы(ДирЦели);
	Если В.БезКонтекста Тогда
		Если Не Ц.БезКонтекста Тогда
			Возврат Ложь;
		КонецЕсли;
		Если В.Клиент И Не Ц.Клиент Тогда
			Возврат Ложь;
		КонецЕсли;
		Если В.Сервер И Не Ц.Сервер Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Если В.Сервер И Не В.Клиент И Не Ц.Сервер Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПричинаКонфликтаПодменыНаБп(МтВосст, МтБп, РаздВосст) Экспорт
	Если НормСигнатураМетода(МтВосст) <> НормСигнатураМетода(МтБп) Тогда
		Возврат "сигнатура БП отличается от typovaya, конфликт с вызовами/ИиК-хуком";
	КонецЕсли;
	Если НормДирективыКомпиляции(МтВосст.directives) = НормДирективыКомпиляции(МтБп.directives) Тогда
		Возврат "";
	КонецЕсли;
	Если РаздВосст <> Неопределено Тогда
		Для Каждого Мт Из РаздВосст.methods Цикл
			Если Мт.name = МтВосст.name Тогда
				Продолжить;
			КонецЕсли;
			Если МетодВызываетсяВОставшемсяТексте(Мт.text, МтВосст.name)
				И Не ВызовДопустимПоДирективам(Мт.directives, МтБп.directives) Тогда
				Возврат "директива БП конфликтует с вызовом из " + Мт.name;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат "";
КонецФункции

Функция СобратьМетодСТелом(МтКаркас, НовоеТело)
	Конец = ?(МтКаркас.kind = "Функция", "КонецФункции", "КонецПроцедуры");
	Дир = МтКаркас.directives;
	Возврат НормТекст(?(Дир = "", "", Дир + Символы.ПС) + МтКаркас.header + Символы.ПС + НормТекст(НовоеТело) + Символы.ПС + Конец);
КонецФункции

Процедура ОбработатьЗаменуТелФормы(Отн, КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, Рез)
	ПодключитьМодули();
	СброситьКэшФормXml();
	ПутьТип = ОбъединитьПути(КореньТип, Отн);
	ПутьУп = ОбъединитьПути(КореньУп, Отн);
	ПутьБп = ОбъединитьПути(КореньБп, Отн);
	ПутьВосстФ = ОбъединитьПути(КатВосст, Отн);
	ПутьРасшФ = ОбъединитьПути(КатРасш, Отн);
	ПутьМТип = Прот.ПутьМодуляФормы(ПутьТип);
	ПутьМУп = Прот.ПутьМодуляФормы(ПутьУп);
	ПутьМБп = Прот.ПутьМодуляФормы(ПутьБп);
	ХвостМ = Лев(Отн, СтрДлина(Отн) - СтрДлина("Form.xml")) + "Form\Module.bsl";
	ПутьМВосст = ОбъединитьПути(КатВосст, ХвостМ);
	ПутьМРасш = ОбъединитьПути(КатРасш, ХвостМ);
	Если Не (Новый Файл(ПутьМВосст)).Существует() Тогда
		Если (Новый Файл(ПутьМТип)).Существует() Тогда
			СоздатьКаталог((Новый Файл(ПутьМВосст)).Путь);
			КопироватьФайл(ПутьМТип, ПутьМВосст);
		Иначе
			Рез.todo.Добавить(Отн + ": нет модуля restored");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если Не (Новый Файл(ПутьМРасш)).Существует() Тогда
		Рез.todo.Добавить(Отн + ": нет модуля расширения с ИиК");
		Возврат;
	КонецЕсли;
	Если ПутьЗапрещёнДляЗаписи(ПутьМВосст) Или ПутьЗапрещёнДляЗаписи(ПутьМРасш) Тогда
		Рез.todo.Добавить(Отн + ": отказ записать в защищённое дерево");
		Возврат;
	КонецЕсли;
	ТекстВосст = ТекстUtf8(ПутьМВосст);
	ТекстРасш = ТекстUtf8(ПутьМРасш);
	ТекстБпМ = ТекстUtf8(ПутьМБп);
	ТекстУпМ = ТекстUtf8(ПутьМУп);
	РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
	РаздБп = РазобратьМодульНаМетоды(ТекстБпМ);
	РаздУп = РазобратьМодульНаМетоды(ТекстУпМ);
	РаздРасш = РазобратьМодульНаМетоды(ТекстРасш);
	ИменаИиК = ИменаМетодовИиКИзТекста(ТекстРасш);
	ТекстВосстНов = ТекстВосст;
	ТекстРасшНов = ТекстРасш;
	Для Каждого КЗ Из ИменаИиК Цикл
		Имя = КЗ.Ключ;
		МтВосст = РаздВосст.byName.Получить(Имя);
		МтБп = РаздБп.byName.Получить(Имя);
		МтУп = РаздУп.byName.Получить(Имя);
		Если МтБп = Неопределено Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — нет в БП, тело restored и ИиК не менялись");
			Продолжить;
		КонецЕсли;
		Если МтУп = Неопределено Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — нет в УП, тело restored и ИиК не менялись");
			Продолжить;
		КонецЕсли;
		Если МтВосст = Неопределено Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — нет в restored, ИиК не менялся");
			Продолжить;
		КонецЕсли;
		Если МтБп.kind <> МтВосст.kind Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — вид БП/restored не совпадает, оставлено в todo");
			Продолжить;
		КонецЕсли;
		Прич = Прот.ПричинаТелоБпНебезопасноДляTypovaya(МтБп.text, ТекстВосст, ТекстБпМ, ПутьВосстФ, ПутьБп, КатВосст);
		Если Прич <> "" Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — " + Прич + ", тело restored и ИиК не менялись");
			Продолжить;
		КонецЕсли;
		ПричКонф = ПричинаКонфликтаПодменыНаБп(МтВосст, МтБп, РаздВосст);
		Если ПричКонф <> "" Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — " + ПричКонф + ", тело restored и ИиК не менялись");
			Продолжить;
		КонецЕсли;
		ПричВыз = ПричинаКонфликтаВызововТелаБп(МтБп.body, РаздВосст, РаздБп);
		Если ПричВыз <> "" Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — " + ПричВыз + ", тело restored и ИиК не менялись");
			Продолжить;
		КонецЕсли;
		НовыйМетодВосст = СобратьМетодСТелом(МтБп, МтБп.body);
		МтДляИк = Новый Структура("name, kind, text, header, body, directives",
			МтБп.name, МтБп.kind, НовыйМетодВосст, МтБп.header, МтБп.body, МтБп.directives);
		Соб = СобратьТекстИиК(МтДляИк, МтУп);
		Если Не Соб.ok Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — не перестроен ИиК от тела БП (" + Соб.reason + "), тело restored не менялось");
			Продолжить;
		КонецЕсли;
		МтРасш = Неопределено;
		Для Каждого МтР Из РаздРасш.methods Цикл
			Если МтР.name = Имя И СтрНайти(МтР.text, "&ИзменениеИКонтроль") > 0 Тогда
				МтРасш = МтР;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если МтРасш = Неопределено Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — не найден фрагмент ИиК в расширении, тело restored не менялось");
			Продолжить;
		КонецЕсли;
		ТелоУжеБп = НормТекст(МтВосст.body) = НормТекст(МтБп.body);
		ХукУжеНовый = НормБлок(МтРасш.text) = НормБлок(Соб.text);
		Если ТелоУжеБп И ХукУжеНовый Тогда
			Продолжить;
		КонецЕсли;
		Если Не ТелоУжеБп Тогда
			Зв = ЗаменитьУникальныйФрагмент(ТекстВосстНов, МтВосст.text, НовыйМетодВосст);
			Если Не Зв.ok Тогда
				Рез.todo.Добавить(Отн + " метод " + Имя + " — не заменено тело в restored (" + Зв.reason + "), ИиК не менялся");
				Продолжить;
			КонецЕсли;
			ТекстВосстНов = Зв.text;
			Рез.replaced.Добавить(Имя);
		КонецЕсли;
		Если Не ХукУжеНовый Тогда
			Зр = ЗаменитьУникальныйФрагмент(ТекстРасшНов, МтРасш.text, Соб.text);
			Если Не Зр.ok Тогда
				Рез.todo.Добавить(Отн + " метод " + Имя + " — не заменён ИиК в расширении (" + Зр.reason + ")");
				Продолжить;
			КонецЕсли;
			ТекстРасшНов = Зр.text;
			Рез.rebuilt.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	// UP-only относительно БП: в расширение (если ещё нет), из restored убрать, если не обработчик Form.xml.
	Для Каждого МтВосст Из РаздВосст.methods Цикл
		Имя = МтВосст.name;
		Если РаздБп.byName.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЭтоОбработчикФормы(Имя, ПутьВосстФ, ПутьРасшФ) Тогда
			Рез.handlers.Добавить(Отн + " метод " + Имя + " — обработчик Form.xml, оставлен в restored");
			Продолжить;
		КонецЕсли;
		ОстатокПробы = ЗаменитьУникальныйФрагмент(ТекстВосстНов, МтВосст.text, "");
		ТекстОстатка = ?(ОстатокПробы.ok, ОстатокПробы.text, ТекстВосстНов);
		Если МетодВызываетсяВОставшемсяТексте(ТекстОстатка, Имя) Тогда
			Рез.handlers.Добавить(Отн + " метод " + Имя + " — вызывается из оставшегося кода restored, не удалён");
			Продолжить;
		КонецЕсли;
		Если РаздРасш.byName.Получить(Имя) = Неопределено Тогда
			ТекстДляРасш = МтВосст.text;
			МтУпТолько = РаздУп.byName.Получить(Имя);
			Если МтУпТолько <> Неопределено И СокрП(МтУпТолько.text) <> "" Тогда
				ТекстДляРасш = СокрП(МтУпТолько.text);
			КонецЕсли;
			Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (ОМ только УП)";
			Если СтрНайти(ТекстРасшНов, Маркер) = 0 Тогда
				ТекстРасшНов = СокрП(ТекстРасшНов) + ?(СокрЛП(ТекстРасшНов) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
			КонецЕсли;
			ТекстРасшНов = СокрП(ТекстРасшНов) + Символы.ПС + Символы.ПС + СокрП(ТекстДляРасш) + Символы.ПС;
			РаздРасш.byName.Вставить(Имя, МтВосст);
		КонецЕсли;
		Зу = ЗаменитьУникальныйФрагмент(ТекстВосстНов, МтВосст.text, "");
		Если Не Зу.ok Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — не удалось удалить UP-only из restored (" + Зу.reason + ")");
			Продолжить;
		КонецЕсли;
		ТекстВосстНов = Зу.text;
		Рез.removed.Добавить(Имя);
	КонецЦикла;
		ТекстВосстНов = ВосстановитьДирективыМетодов(ТекстВосстНов, ТекстВосст);
	ТекстВосстНов = ОткатитьЕслиНарушенБалансОбластей(ТекстВосстНов, ТекстВосст, Отн, Рез, "замены тел/удаления UP-only");
ТекстРасшНов = ДополнитьМодульРасшКаллерамиХуков(ТекстРасшНов, ТекстВосстНов, ТекстУпМ);
	ТекстРасшНов = ДополнитьМодульРасшКаллерамиХуков(ТекстРасшНов, ТекстВосстНов, ТекстУпМ);
	ТекстРасшНов = ДополнитьРасшУпПрефиксПоСигнатурам(ТекстРасшНов, ТекстУпМ, ТекстВосстНов, ТекстБпМ);
	Если ТекстВосстНов <> ТекстВосст Тогда
		ЗаписатьТекст(ПутьМВосст, ТекстВосстНов);
	КонецЕсли;
	Если ТекстРасшНов <> ТекстРасш Тогда
		ЗаписатьТекст(ПутьМРасш, ТекстРасшНов);
	КонецЕсли;
КонецПроцедуры

Функция ЗаменитьТелаRestoredНаБп(КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, СписокФорм, Лог, КаталогОтчёта = "") Экспорт
	ПодключитьМодули();
	Рез = Новый Структура("forms, replaced, rebuilt, removed, handlers, todo, rows",
		0, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив);
	Если ПутьЗапрещёнДляЗаписи(КатВосст) Тогда
		Если Лог <> Неопределено Тогда
			Лог.Добавить("ОТКАЗ: restored-приёмник в защищённом дереве: " + КатВосст);
		КонецЕсли;
		Рез.todo.Добавить("защищённый путь restored: " + КатВосст);
		Возврат Рез;
	КонецЕсли;
	Если ПутьЗапрещёнДляЗаписи(КатРасш) Тогда
		Если Лог <> Неопределено Тогда
			Лог.Добавить("ОТКАЗ: расширение-приёмник в защищённом дереве: " + КатРасш);
		КонецЕсли;
		Рез.todo.Добавить("защищённый путь extension: " + КатРасш);
		Возврат Рез;
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("Замена тел restored на БП, форм: " + СписокФорм.Количество());
	КонецЕсли;
	Для Каждого ОтнСырой Из СписокФорм Цикл
		Отн = Прот.НормПуть(ОтнСырой);
		Зам0 = Рез.replaced.Количество();
		Уд0 = Рез.removed.Количество();
		Тод0 = Рез.todo.Количество();
		ОбработатьЗаменуТелФормы(Отн, КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, Рез);
		Если (Рез.replaced.Количество() - Зам0) + (Рез.removed.Количество() - Уд0) > 0 Тогда
			Рез.forms = Рез.forms + 1;
		КонецЕсли;
		Рез.rows.Добавить(Отн);
		Если Лог <> Неопределено Тогда
			Лог.Добавить("  " + Отн + " bp=" + (Рез.replaced.Количество() - Зам0)
				+ " removed=" + (Рез.removed.Количество() - Уд0)
				+ " todo=" + (Рез.todo.Количество() - Тод0));
		КонецЕсли;
	КонецЦикла;
	Если КаталогОтчёта <> "" Тогда
		СоздатьКаталог(КаталогОтчёта);
		Стат = "{""forms"":" + Рез.forms
			+ ",""replaced"":" + Рез.replaced.Количество()
			+ ",""rebuiltIik"":" + Рез.rebuilt.Количество()
			+ ",""removedUpOnly"":" + Рез.removed.Количество()
			+ ",""handlersKept"":" + Рез.handlers.Количество()
			+ ",""todo"":" + Рез.todo.Количество() + "}";
		ЗаписатьТекст(ОбъединитьПути(КаталогОтчёта, "iik_bp_stat.json"), Стат);
		Если Рез.todo.Количество() > 0 Тогда
			ЗаписатьТекст(ОбъединитьПути(КаталогОтчёта, "iik_bp_todo.txt"), СтрСоединить(Рез.todo, Символы.ПС) + Символы.ПС);
		КонецЕсли;
		Если Рез.handlers.Количество() > 0 Тогда
			ЗаписатьТекст(ОбъединитьПути(КаталогОтчёта, "iik_bp_handlers.txt"), СтрСоединить(Рез.handlers, Символы.ПС) + Символы.ПС);
		КонецЕсли;
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("DONE forms=" + Рез.forms + " replaced=" + Рез.replaced.Количество()
			+ " rebuiltIik=" + Рез.rebuilt.Количество() + " removedUpOnly=" + Рез.removed.Количество()
			+ " handlersKept=" + Рез.handlers.Количество() + " todo=" + Рез.todo.Количество());
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция ИменаМетаФормыИзТекста(Текст)
	Рез = Новый Соответствие;
	Если Текст = "" Тогда
		Возврат Рез;
	КонецЕсли;
	// Без «[A-Za-z]+ [^>]*» — на больших Form.xml такой шаблон катастрофически медленный.
	Рв = Новый РегулярноеВыражение("\bname=""([^""]+)""");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Имя = СокрЛП(С.Группы[1].Значение);
		Если Имя <> "" Тогда
			Рез.Вставить(Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ОписаниеФормыXml(Путь)
	Если КэшОписанийФормXml = Неопределено Тогда
		КэшОписанийФормXml = Новый Соответствие;
	КонецЕсли;
	Если Путь = "" Тогда
		Возврат Новый Структура("text, names", "", Новый Соответствие);
	КонецЕсли;
	Есть = КэшОписанийФормXml.Получить(Путь);
	Если Есть <> Неопределено Тогда
		Возврат Есть;
	КонецЕсли;
	Текст = ТекстUtf8(Путь);
	Оп = Новый Структура("text, names", Текст, ИменаМетаФормыИзТекста(Текст));
	КэшОписанийФормXml.Вставить(Путь, Оп);
	Возврат Оп;
КонецФункции

Процедура СброситьКэшФормXml()
	КэшОписанийФормXml = Новый Соответствие;
КонецПроцедуры

Функция ИменаОбработчиковУпТолькоМетаданных(ПутьФормыВосст, ПутьФормыБп)
	// Один проход по Form.xml: методы, привязанные только к команде/элементу, которого нет в БП.
	Если КэшОписанийФормXml = Неопределено Тогда
		КэшОписанийФормXml = Новый Соответствие;
	КонецЕсли;
	Ключ = ПутьФормыВосст + "|" + ПутьФормыБп + "|upOnlyH";
	Есть = КэшОписанийФормXml.Получить(Ключ);
	Если Есть <> Неопределено Тогда
		Возврат Есть;
	КонецЕсли;
	Рез = Новый Соответствие;
	Если ПутьФормыВосст = "" Тогда
		КэшОписанийФормXml.Вставить(Ключ, Рез);
		Возврат Рез;
	КонецЕсли;
	ОпВосст = ОписаниеФормыXml(ПутьФормыВосст);
	ИменаБп = ОписаниеФормыXml(ПутьФормыБп).names;
	ТекстВосст = ОпВосст.text;
	РвДейст = Новый РегулярноеВыражение("<(Action|Event)[^>]*>([^<]+)</(Action|Event)>");
	Для Каждого КЗ Из ОпВосст.names Цикл
		Если ИменаБп.Получить(КЗ.Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Бл = ИзвлечьБлокXmlПоИмени(ТекстВосст, "Command", КЗ.Ключ);
		Если Бл = "" Тогда
			Бл = ИзвлечьЭлементXmlПоИмени(ТекстВосст, КЗ.Ключ);
		КонецЕсли;
		Если Бл = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из РвДейст.НайтиСовпадения(Бл) Цикл
			Имя = СокрЛП(С.Группы[2].Значение);
			Если Имя <> "" Тогда
				Рез.Вставить(Имя, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	КэшОписанийФормXml.Вставить(Ключ, Рез);
	Возврат Рез;
КонецФункции

Функция ЭтоОбработчикУпТолькоМетаданных(ИмяМетода, ПутьФормыВосст, ПутьФормыБп)
	Если ИмяМетода = "" Или ПутьФормыВосст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ИменаОбработчиковУпТолькоМетаданных(ПутьФормыВосст, ПутьФормыБп).Получить(ИмяМетода) = Истина;
КонецФункции

Функция ДобавитьСобытияМетодаВFormXmlРасш(ПутьФормыВосст, ПутьФормыРасш, ИмяМетода)
	ТекстИст = ТекстUtf8(ПутьФормыВосст);
	Если ТекстИст = "" Тогда
		Возврат 0;
	КонецЕсли;
	События = Новый Массив;
	Рв = Новый РегулярноеВыражение("<Event\s+name=""([^""]+)""[^>]*>" + ИмяМетода + "</Event>");
	Для Каждого С Из Рв.НайтиСовпадения(ТекстИст) Цикл
		События.Добавить(СокрП(С.Значение));
	КонецЦикла;
	Если События.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Если (Новый Файл(ПутьФормыРасш)).Существует() Тогда
		Текст = ТекстUtf8(ПутьФормыРасш);
	Иначе
		Текст = ЗаготовкаFormXmlРасширения(ТекстИст);
	КонецЕсли;
	Добавлено = 0;
	Для Каждого Бл Из События Цикл
		Если СтрНайти(Текст, Бл) = 0 Тогда
			Добавлено = Добавлено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Добавлено = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Текст = ВставитьБлокиВFormXml(Текст, "Events", События);
	Если ПутьЗапрещёнДляЗаписи(ПутьФормыРасш) Тогда
		Возврат 0;
	КонецЕсли;
	ЗаписатьТекст(ПутьФормыРасш, Текст);
	Возврат Добавлено;
КонецФункции

Функция СобратьНедостающиеХелперыБп(МтБп, РаздВосст, РаздБп, ПутьВосстФ, ПутьБп, КатВосст, Прот)
	Очередь = Новый Массив;
	Уже = Новый Соответствие;
	Вызовы = Прот.ЛокальныеВызовыВТекстеМетода(МтБп.text);
	Для Каждого КЗ Из Вызовы Цикл
		Имя = КЗ.Ключ;
		Если РаздВосст.byName.Получить(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если РаздБп.byName.Получить(Имя) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Очередь.Добавить(Имя);
		Уже.Вставить(Имя, Истина);
	КонецЦикла;
	Результат = Новый Массив;
	Й = 0;
	Пока Й < Очередь.Количество() Цикл
		Имя = Очередь[Й];
		Й = Й + 1;
		Мт = РаздБп.byName.Получить(Имя);
		Если Мт = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Прич = Прот.ПричинаТелоБпНебезопасноДляTypovaya(Мт.text, "", ТекстМодуляИзРазбораБез(РаздБп, Новый Массив), ПутьВосстФ, ПутьБп, КатВосст);
		// для хелпера отсутствие других процедур BP в restored не повод отказывать — добавим транзитивно
		Если Прич <> "" И СтрНайти(Прич, "процедуры модуля формы") = 0 Тогда
			// реквизиты/метаданные — не добавляем
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Мт);
		Выз2 = Прот.ЛокальныеВызовыВТекстеМетода(Мт.text);
		Для Каждого КЗ2 Из Выз2 Цикл
			Имя2 = КЗ2.Ключ;
			Если Уже.Получить(Имя2) = Истина Тогда
				Продолжить;
			КонецЕсли;
			Если РаздВосст.byName.Получить(Имя2) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если РаздБп.byName.Получить(Имя2) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уже.Вставить(Имя2, Истина);
			Очередь.Добавить(Имя2);
		КонецЦикла;
	КонецЦикла;
	Возврат УбратьХелперыСВисячимиВызовами(Результат, РаздВосст, РаздБп);
КонецФункции

Функция УбратьХелперыСВисячимиВызовами(Методы, РаздВосст, РаздБп)
	ПодключитьМодули();
	Результат = Методы;
	Пока Истина Цикл
		Имена = Новый Соответствие;
		Для Каждого Мт Из Результат Цикл
			Имена.Вставить(Мт.name, Истина);
		КонецЦикла;
		Нов = Новый Массив;
		Удалили = Ложь;
		Для Каждого Мт Из Результат Цикл
			Висячий = Ложь;
			Для Каждого КЗ Из Прот.ЛокальныеВызовыВТекстеМетода(Мт.text) Цикл
				Имя = КЗ.Ключ;
				Если РаздВосст.byName.Получить(Имя) <> Неопределено Или Имена.Получить(Имя) = Истина Тогда
					Продолжить;
				КонецЕсли;
				Если РаздБп.byName.Получить(Имя) <> Неопределено Тогда
					Висячий = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Висячий Тогда
				Удалили = Истина;
			Иначе
				Нов.Добавить(Мт);
			КонецЕсли;
		КонецЦикла;
		Результат = Нов;
		Если Не Удалили Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТекстМодуляИзРазбораБез(Разд, Игнор)
	Возврат "";
КонецФункции

Функция ДобавитьМетодыВМодуль(ТекстМодуля, Методы)
	Т = СокрП(ТекстМодуля);
	Для Каждого Мт Из Методы Цикл
		Если СтрНайти(Т, "Процедура " + Мт.name + "(") > 0 Или СтрНайти(Т, "Функция " + Мт.name + "(") > 0
			Или СтрНайти(Т, "Процедура " + Мт.name + " ") > 0 Или СтрНайти(Т, "Функция " + Мт.name + " ") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Т = Т + Символы.ПС + Символы.ПС + СокрП(Мт.text) + Символы.ПС;
	КонецЦикла;
	Возврат Т;
КонецФункции

Функция УбратьДирективуИиК(ТекстМетода)
	Т = СтрЗаменить(ТекстМетода, Символы.ВК, "");
	Строки = СтрРазделить(Т, Символы.ПС, Истина);
	Р = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Если СтрНачинаетсяС(СокрЛП(Стр), "&ИзменениеИКонтроль") Тогда
			Продолжить;
		КонецЕсли;
		Р.Добавить(Стр);
	КонецЦикла;
	Возврат СокрП(СтрСоединить(Р, Символы.ПС));
КонецФункции

Процедура ОбработатьДополнениеИВыносФормы(Отн, КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, Рез, Исключения = Неопределено, ФормыFormXml = Неопределено)
	ПодключитьМодули();
	СброситьКэшФормXml();
	Если ФормаИсключенаИзПрохода(Отн, Исключения) Тогда
		Рез.todo.Добавить(Отн + " — исключён из прохода 2 (список исключений), модуль не менялся");
		Возврат;
	КонецЕсли;
	ПутьУп = ОбъединитьПути(КореньУп, Отн);
	ПутьБп = ОбъединитьПути(КореньБп, Отн);
	ПутьВосстФ = ОбъединитьПути(КатВосст, Отн);
	ПутьРасшФ = ОбъединитьПути(КатРасш, Отн);
	ПутьМБп = Прот.ПутьМодуляФормы(ПутьБп);
	ПутьМУп = Прот.ПутьМодуляФормы(ПутьУп);
	ХвостМ = Лев(Отн, СтрДлина(Отн) - СтрДлина("Form.xml")) + "Form\Module.bsl";
	ПутьМВосст = ОбъединитьПути(КатВосст, ХвостМ);
	ПутьМРасш = ОбъединитьПути(КатРасш, ХвостМ);
	Если Не (Новый Файл(ПутьМВосст)).Существует() Тогда
		Рез.todo.Добавить(Отн + ": нет модуля restored");
		Возврат;
	КонецЕсли;
	Если ПутьЗапрещёнДляЗаписи(ПутьМВосст) Или ПутьЗапрещёнДляЗаписи(ПутьМРасш) Тогда
		Рез.todo.Добавить(Отн + ": защищённый путь");
		Возврат;
	КонецЕсли;
	ТекстВосст = ТекстUtf8(ПутьМВосст);
	ТекстРасш = ?( (Новый Файл(ПутьМРасш)).Существует(), ТекстUtf8(ПутьМРасш), "");
	ТекстБпМ = ТекстUtf8(ПутьМБп);
	ТекстУпМ = ТекстUtf8(ПутьМУп);
	РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
	РаздБп = РазобратьМодульНаМетоды(ТекстБпМ);
	РаздУп = РазобратьМодульНаМетоды(ТекстУпМ);
	РаздРасш = РазобратьМодульНаМетоды(ТекстРасш);
	ТекстВосстНов = ТекстВосст;
	ТекстРасшНов = ТекстРасш;
	// 1) транзитивно добавить в restored процедуры БП, которых зовут тела-кандидаты
	Добавленные = Новый Массив;
	Кандидаты = Новый Массив;
	ИменаИиК = ИменаМетодовИиКИзТекста(ТекстРасш);
	Для Каждого МтВосст Из РаздВосст.methods Цикл
		МтБп = РаздБп.byName.Получить(МтВосст.name);
		Если МтБп = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Кандидаты.Добавить(МтБп);
	КонецЦикла;
	Для Каждого МтБп Из Кандидаты Цикл
		Хелперы = СобратьНедостающиеХелперыБп(МтБп, РаздВосст, РаздБп, ПутьВосстФ, ПутьБп, КатВосст, Прот);
		Для Каждого МтХ Из Хелперы Цикл
			Если РаздВосст.byName.Получить(МтХ.name) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТекстВосстНов = ДобавитьМетодыВМодуль(ТекстВосстНов, ОбщийМассив(МтХ));
			РаздВосст.byName.Вставить(МтХ.name, МтХ);
			Если Не ЕстьВМассиве(Добавленные, МтХ.name) Тогда
				Добавленные.Добавить(МтХ.name);
				Рез.helpers.Добавить(МтХ.name);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ТекстВосстНов <> ТекстВосст Тогда
		ЗаписатьТекст(ПутьМВосст, ТекстВосстНов);
		ТекстВосст = ТекстВосстНов;
		РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
	КонецЕсли;
	// 2) повторно подменить тела ИиК / типовых вызывающих на БП
	Если (Новый Файл(ПутьМРасш)).Существует() Тогда
		ОбработатьЗаменуТелФормы(Отн, КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, Рез);
		ТекстВосст = ТекстUtf8(ПутьМВосст);
		ТекстРасш = ТекстUtf8(ПутьМРасш);
		ТекстВосстНов = ТекстВосст;
		ТекстРасшНов = ТекстРасш;
		РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
		РаздРасш = РазобратьМодульНаМетоды(ТекстРасш);
	КонецЕсли;
	// дополнительно: типовые методы restored, которые есть в БП, зовут методы только УП — дать тело БП + ИиК
	Для Каждого МтВосст Из РаздВосст.methods Цикл
		МтБп = РаздБп.byName.Получить(МтВосст.name);
		МтУп = РаздУп.byName.Получить(МтВосст.name);
		Если МтБп = Неопределено Или МтУп = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НормТекст(МтВосст.body) = НормТекст(МтБп.body) Тогда
			Продолжить;
		КонецЕсли;
		ЗовётУп = Ложь;
		Вызовы = Прот.ЛокальныеВызовыВТекстеМетода(МтВосст.text);
		Для Каждого КЗ Из Вызовы Цикл
			Если РаздБп.byName.Получить(КЗ.Ключ) = Неопределено И РаздВосст.byName.Получить(КЗ.Ключ) <> Неопределено Тогда
				ЗовётУп = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ЗовётУп Тогда
			Продолжить;
		КонецЕсли;
		Прич = Прот.ПричинаТелоБпНебезопасноДляTypovaya(МтБп.text, ТекстВосстНов, ТекстБпМ, ПутьВосстФ, ПутьБп, КатВосст);
		Если Прич <> "" Тогда
			Рез.todo.Добавить(Отн + " метод " + МтВосст.name + " — не заменено тело вызывающего: " + Прич);
			Продолжить;
		КонецЕсли;
		ПричКонф = ПричинаКонфликтаПодменыНаБп(МтВосст, МтБп, РаздВосст);
		Если ПричКонф <> "" Тогда
			Рез.todo.Добавить(Отн + " метод " + МтВосст.name + " — " + ПричКонф + ", тело restored и ИиК не менялись");
			Продолжить;
		КонецЕсли;
		ПричВыз = ПричинаКонфликтаВызововТелаБп(МтБп.body, РаздВосст, РаздБп);
		Если ПричВыз <> "" Тогда
			Рез.todo.Добавить(Отн + " метод " + МтВосст.name + " — " + ПричВыз + ", тело restored не менялось");
			Продолжить;
		КонецЕсли;
		НовыйМетодВосст = СобратьМетодСТелом(МтБп, МтБп.body);
		МтДляИк = Новый Структура("name, kind, text, header, body, directives",
			МтБп.name, МтБп.kind, НовыйМетодВосст, МтБп.header, МтБп.body, МтБп.directives);
		Соб = СобратьТекстИиК(МтДляИк, МтУп);
		Если Не Соб.ok Тогда
			Рез.todo.Добавить(Отн + " метод " + МтВосст.name + " — не собран ИиК вызывающего: " + Соб.reason);
			Продолжить;
		КонецЕсли;
		Зв = ЗаменитьУникальныйФрагмент(ТекстВосстНов, МтВосст.text, НовыйМетодВосст);
		Если Не Зв.ok Тогда
			Рез.todo.Добавить(Отн + " метод " + МтВосст.name + " — " + Зв.reason);
			Продолжить;
		КонецЕсли;
		ТекстВосстНов = Зв.text;
		Если РаздРасш.byName.Получить(МтВосст.name) <> Неопределено Тогда
			Для Каждого МтР Из РаздРасш.methods Цикл
				Если МтР.name = МтВосст.name Тогда
					Зр = ЗаменитьУникальныйФрагмент(ТекстРасшНов, МтР.text, Соб.text);
					Если Зр.ok Тогда
						ТекстРасшНов = Зр.text;
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (ОМ только УП)";
			Если СтрНайти(ТекстРасшНов, Маркер) = 0 Тогда
				ТекстРасшНов = СокрП(ТекстРасшНов) + ?(СокрЛП(ТекстРасшНов) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
			КонецЕсли;
			ТекстРасшНов = СокрП(ТекстРасшНов) + Символы.ПС + Символы.ПС + Соб.text + Символы.ПС;
		КонецЕсли;
		Если Не ЕстьВМассиве(Рез.replaced, МтВосст.name) Тогда
			Рез.replaced.Добавить(МтВосст.name);
		КонецЕсли;
	КонецЦикла;
	РаздВосст = РазобратьМодульНаМетоды(ТекстВосстНов);
	РаздРасш = РазобратьМодульНаМетоды(ТекстРасшНов);
	// 3) методы только УП (нет в БП) — в расширение, из restored убрать (кроме УП-метаданных формы)
	Если РаздБп.methods.Количество() = 0 Тогда
		Рез.todo.Добавить(Отн + " — нет модуля формы в выгрузке БП, массовый вынос UP-only пропущен");
	КонецЕсли;
	Для Каждого МтВосст Из РаздВосст.methods Цикл
		Если РаздБп.methods.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Если РаздБп.byName.Получить(МтВосст.name) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имя = МтВосст.name;
		Если ЭтоОбработчикУпТолькоМетаданных(Имя, ПутьВосстФ, ПутьБп) Тогда
			Рез.metaKept.Добавить(Отн + " метод " + Имя + " — обработчик УП-элемента/команды Form.xml (метаданные формы), оставлен в restored");
			Продолжить;
		КонецЕсли;
		ОстатокПробы = ЗаменитьУникальныйФрагмент(ТекстВосстНов, МтВосст.text, "");
		ТекстОстатка = ?(ОстатокПробы.ok, ОстатокПробы.text, ТекстВосстНов);
		Если МетодВызываетсяВОставшемсяТексте(ТекстОстатка, Имя) Тогда
			Рез.todo.Добавить(Отн + " метод " + Имя + " — нет в БП, но вызывается из оставшегося typovaya-кода restored");
			Продолжить;
		КонецЕсли;
		ТекстДляРасш = МтВосст.text;
		МтУпТолько = РаздУп.byName.Получить(Имя);
		Если МтУпТолько <> Неопределено И СокрП(МтУпТолько.text) <> "" Тогда
			ТекстДляРасш = СокрП(МтУпТолько.text);
		КонецЕсли;
		ТекстДляРасш = УбратьДирективуИиК(ТекстДляРасш);
		Если РаздРасш.byName.Получить(Имя) <> Неопределено Тогда
			Для Каждого МтР Из РаздРасш.methods Цикл
				Если МтР.name = Имя Тогда
					Зр = ЗаменитьУникальныйФрагмент(ТекстРасшНов, МтР.text, ТекстДляРасш);
					Если Зр.ok Тогда
						ТекстРасшНов = Зр.text;
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (ОМ только УП)";
			Если СтрНайти(ТекстРасшНов, Маркер) = 0 Тогда
				ТекстРасшНов = СокрП(ТекстРасшНов) + ?(СокрЛП(ТекстРасшНов) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
			КонецЕсли;
			ТекстРасшНов = СокрП(ТекстРасшНов) + Символы.ПС + Символы.ПС + ТекстДляРасш + Символы.ПС;
		КонецЕсли;
		Если ОстатокПробы.ok Тогда
			ТекстВосстНов = ОстатокПробы.text;
		КонецЕсли;
		ДобавитьСобытияМетодаВFormXmlРасш(ПутьВосстФ, ПутьРасшФ, Имя);
		Если Не ЕстьВМассиве(Рез.moved, Имя) Тогда
			Рез.moved.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
		ТекстВосстНов = ВосстановитьДирективыМетодов(ТекстВосстНов, ТекстВосст);
	ТекстВосстНов = ОткатитьЕслиНарушенБалансОбластей(ТекстВосстНов, ТекстВосст, Отн, Рез, "выноса методов только УП");
	ТекстРасшНов = ДополнитьРасшУпПрефиксПоСигнатурам(ТекстРасшНов, ТекстУпМ, ТекстВосстНов, ТекстБпМ);
Если ТекстВосстНов <> ТекстВосст Тогда
		ЗаписатьТекст(ПутьМВосст, ТекстВосстНов);
	КонецЕсли;
	Если ФормаВСписке(Отн, ФормыFormXml) Тогда
		ПутьТип = ОбъединитьПути(КореньТип, Отн);
		ДополнитьFormXmlРасшПоМодулю(ПутьТип, ПутьУп, ПутьБп, ПутьВосстФ, ПутьРасшФ, ТекстРасшНов);
		ТекстИк = ДополнитьРасшИиКТиповыхКаллеров(ТекстРасшНов, ТекстВосстНов);
		Если ТекстИк <> ТекстРасшНов Тогда
			ТекстРасшНов = ТекстИк;
		КонецЕсли;
	КонецЕсли;
	Если ТекстРасшНов <> ТекстРасш Тогда
		ЗаписатьТекст(ПутьМРасш, ТекстРасшНов);
	КонецЕсли;
КонецПроцедуры

Функция ОбщийМассив(Элемент)
	М = Новый Массив;
	М.Добавить(Элемент);
	Возврат М;
КонецФункции



Функция ДополнитьМодульРасшКаллерамиХуков(ТекстРасш, ТекстВосст, ТекстУп)
	ПодключитьМодули();
	Если СокрЛП(ТекстРасш) = "" Тогда
		Возврат ТекстРасш;
	КонецЕсли;
	РаздРасш = РазобратьМодульНаМетоды(ТекстРасш);
	РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
	РаздУп = РазобратьМодульНаМетоды(ТекстУп);
	Т = ТекстРасш;
	Очередь = Новый Массив;
	Для Каждого Мт Из РаздРасш.methods Цикл
		Очередь.Добавить(Мт);
	КонецЦикла;
	Й = 0;
	Пока Й < Очередь.Количество() Цикл
		Мт = Очередь[Й];
		Й = Й + 1;
		Вызовы = Прот.ЛокальныеВызовыВТекстеМетода(Мт.text);
		Для Каждого КЗ Из Вызовы Цикл
			Имя = КЗ.Ключ;
			Если РаздРасш.byName.Получить(Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Ист = РаздУп.byName.Получить(Имя);
			Если Ист = Неопределено Тогда
				Ист = РаздВосст.byName.Получить(Имя);
			КонецЕсли;
			Если Ист = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ТекстМ = УбратьДирективуИиК(СокрП(Ист.text));
			Если СокрЛП(ТекстМ) = "" Тогда
				Продолжить;
			КонецЕсли;
			Маркер = "// typovaya-up: каллер ИиК/УП, типовой метод формы в расширение";
			Если СтрНайти(Т, Маркер) = 0 Тогда
				Т = СокрП(Т) + ?(СокрЛП(Т) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
			КонецЕсли;
			Т = СокрП(Т) + Символы.ПС + Символы.ПС + ТекстМ + Символы.ПС;
			РаздРасш.byName.Вставить(Имя, Ист);
			Нов = Новый Структура("name, text", Имя, ТекстМ);
			Очередь.Добавить(Нов);
		КонецЦикла;
	КонецЦикла;
	Возврат Т;
КонецФункции

Функция МетодОбъявленВТексте(Текст, Имя)
	Если СокрЛП(Текст) = "" Или СокрЛП(Имя) = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат СтрНайти(Текст, "Процедура " + Имя + "(") > 0
		Или СтрНайти(Текст, "Функция " + Имя + "(") > 0;
КонецФункции

Функция ИмяСПрефиксомУп(Имя)
	Если СтрНачинаетсяС(Имя, "УП_") Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат "УП_" + Имя;
КонецФункции

Функция ЗаголовокСПрефиксомУп(Заголовок, Имя)
	ИмяНов = ИмяСПрефиксомУп(Имя);
	ПозСк = СтрНайти(Заголовок, "(");
	Если ПозСк = 0 Тогда
		Возврат Заголовок;
	КонецЕсли;
	До = Лев(Заголовок, ПозСк - 1);
	Поз = СтрНайти(НРег(До), НРег(Имя), НаправлениеПоиска.СКонца);
	Если Поз = 0 Тогда
		Возврат Заголовок;
	КонецЕсли;
	Возврат Лев(До, Поз - 1) + ИмяНов + Сред(До, Поз + СтрДлина(Имя)) + Сред(Заголовок, ПозСк);
КонецФункции

Функция СобратьМетодУпСПрефиксом(МтУп)
	Если МтУп = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ИмяНов = ИмяСПрефиксомУп(МтУп.name);
	Конец = ?(МтУп.kind = "Функция", "КонецФункции", "КонецПроцедуры");
	Дир = СокрП(МтУп.directives);
	Заг = ЗаголовокСПрефиксомУп(МтУп.header, МтУп.name);
	Тело = МтУп.body;
	Если Тело = Неопределено Тогда
		Тело = "";
	КонецЕсли;
	Если Тело <> "" И Не СтрЗаканчиваетсяНа(Тело, Символы.ПС) Тогда
		Тело = Тело + Символы.ПС;
	КонецЕсли;
	Текст = "";
	Если Дир <> "" Тогда
		Текст = Дир + Символы.ПС;
	КонецЕсли;
	Возврат Текст + Заг + Символы.ПС + Тело + Конец;
КонецФункции

Функция ПричинаКонфликтаВызововТелаБп(ТекстТелаБп, РаздВосст, РаздБп) Экспорт
	ПодключитьМодули();
	Если СокрЛП(ТекстТелаБп) = "" Или РаздВосст = Неопределено Или РаздБп = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Вызовы = Прот.ЛокальныеВызовыВТекстеМетода(ТекстТелаБп);
	Для Каждого КЗ Из Вызовы Цикл
		Имя = КЗ.Ключ;
		МтВосст = РаздВосст.byName.Получить(Имя);
		МтБпЦели = РаздБп.byName.Получить(Имя);
		Если МтВосст = Неопределено Или МтБпЦели = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если НормСигнатураМетода(МтВосст) <> НормСигнатураМетода(МтБпЦели) Тогда
			Возврат "тело БП вызывает " + Имя + " с сигнатурой, отличной от restored";
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ДополнитьРасшУпПрефиксПоСигнатурам(ТекстРасш, ТекстУп, ТекстВосст, ТекстБп) Экспорт
	ПодключитьМодули();
	Если СокрЛП(ТекстУп) = "" Или СокрЛП(ТекстВосст) = "" Или СокрЛП(ТекстБп) = "" Тогда
		Возврат ТекстРасш;
	КонецЕсли;
	РаздУп = РазобратьМодульНаМетоды(ТекстУп);
	РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
	РаздБп = РазобратьМодульНаМетоды(ТекстБп);
	РаздРасш = РазобратьМодульНаМетоды(ТекстРасш);
	УжеИиК = ИменаМетодовИиКИзТекста(ТекстРасш);
	Переименования = Новый Соответствие;
	ДобавитьМетоды = Новый Массив;
	Для Каждого КЗ Из РаздУп.byName Цикл
		Имя = КЗ.Ключ;
		Если СтрНачинаетсяС(Имя, "УП_") Тогда
			Продолжить;
		КонецЕсли;
		МтУп = КЗ.Значение;
		МтБп = РаздБп.byName.Получить(Имя);
		МтВосст = РаздВосст.byName.Получить(Имя);
		Если МтБп = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СигУп = НормСигнатураМетода(МтУп);
		СигБп = НормСигнатураМетода(МтБп);
		СигВосст = ?(МтВосст = Неопределено, "", НормСигнатураМетода(МтВосст));
		Если СигУп = СигБп И (СигВосст = "" Или СигВосст = СигБп) Тогда
			Продолжить;
		КонецЕсли;
		ИмяНов = ИмяСПрефиксомУп(Имя);
		Переименования.Вставить(Имя, ИмяНов);
		Если РаздРасш.byName.Получить(ИмяНов) = Неопределено И Не МетодОбъявленВТексте(ТекстРасш, ИмяНов) Тогда
			ДобавитьМетоды.Добавить(МтУп);
		КонецЕсли;
	КонецЦикла;
	Если Переименования.Количество() = 0 Тогда
		Возврат ТекстРасш;
	КонецЕсли;
	Т = ТекстРасш;
	Если ДобавитьМетоды.Количество() > 0 Тогда
		Маркер = "// typovaya-up: УП-версия метода под префиксом УП_ (сигнатура БП/restored не совпадает с вызовом УП)";
		Если СтрНайти(Т, Маркер) = 0 Тогда
			Т = СокрП(Т) + ?(СокрЛП(Т) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
		КонецЕсли;
		Для Каждого МтУп Из ДобавитьМетоды Цикл
			ТекстМ = СобратьМетодУпСПрефиксом(МтУп);
			Если СокрЛП(ТекстМ) = "" Тогда
				Продолжить;
			КонецЕсли;
			Т = СокрП(Т) + Символы.ПС + Символы.ПС + ТекстМ + Символы.ПС;
		КонецЦикла;
	КонецЕсли;
	Для Каждого КЗ Из Переименования Цикл
		Имя = КЗ.Ключ;
		МтУп = РаздУп.byName.Получить(Имя);
		МтВосст = РаздВосст.byName.Получить(Имя);
		Если МтУп = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если РаздРасш.byName.Получить(Имя) <> Неопределено Или УжеИиК.Получить(Имя) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Если МтВосст = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Соб = СобратьТекстИиК(МтВосст, МтУп);
		Если Не Соб.ok Тогда
			Продолжить;
		КонецЕсли;
		Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya→УП (вызывающий при конфликте сигнатуры)";
		Если СтрНайти(Т, Маркер) = 0 Тогда
			Т = СокрП(Т) + ?(СокрЛП(Т) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
		КонецЕсли;
		Т = СокрП(Т) + Символы.ПС + Символы.ПС + Соб.text + Символы.ПС;
	КонецЦикла;
	Если Дозап <> Неопределено Тогда
		Т = Дозап.ПереписатьВызовыВоВставках(Т, Переименования);
		РаздНов = РазобратьМодульНаМетоды(Т);
		Для Каждого Мт Из РаздНов.methods Цикл
			Если СтрНайти(Мт.text, "&ИзменениеИКонтроль") > 0 Или СтрНайти(Мт.text, "#Удаление") > 0 Тогда
				Продолжить;
			КонецЕсли;
			НовМ = Дозап.ПереписатьЛокальныеВызовы(Мт.text, Переименования);
			Если НовМ <> Мт.text Тогда
				Зм = ЗаменитьУникальныйФрагмент(Т, Мт.text, НовМ);
				Если Зм.ok Тогда
					Т = Зм.text;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Т;
КонецФункции

Функция ФормаВСписке(Отн, Список) Экспорт
	Возврат ФормаИсключенаИзПрохода(Отн, Список);
КонецФункции

Функция СобратьТекстИиКБезИзменений(Мт) Экспорт
	Если Мт = Неопределено Или СокрЛП(Мт.name) = "" Тогда
		Возврат "";
	КонецЕсли;
	Дир = СокрП(Мт.directives);
	Конец = ?(Мт.kind = "Функция", "КонецФункции", "КонецПроцедуры");
	Тело = Мт.body;
	Если Тело = Неопределено Тогда
		Тело = "";
	КонецЕсли;
	Если Тело <> "" И Не СтрЗаканчиваетсяНа(Тело, Символы.ПС) Тогда
		Тело = Тело + Символы.ПС;
	КонецЕсли;
	Текст = "";
	Если Дир <> "" Тогда
		Текст = Дир + Символы.ПС;
	КонецЕсли;
	Текст = Текст + "&ИзменениеИКонтроль(""" + Мт.name + """)" + Символы.ПС
		+ Мт.header + Символы.ПС
		+ "#Удаление" + Символы.ПС
		+ Тело
		+ "#КонецУдаления" + Символы.ПС
		+ "#Вставка" + Символы.ПС
		+ Тело
		+ "#КонецВставки" + Символы.ПС
		+ Конец;
	Возврат Текст;
КонецФункции

Функция ДополнитьРасшИиКТиповыхКаллеров(ТекстРасш, ТекстВосст) Экспорт
	ПодключитьМодули();
	Если СокрЛП(ТекстРасш) = "" Или СокрЛП(ТекстВосст) = "" Тогда
		Возврат ТекстРасш;
	КонецЕсли;
	РаздРасш = РазобратьМодульНаМетоды(ТекстРасш);
	РаздВосст = РазобратьМодульНаМетоды(ТекстВосст);
	УжеИиК = ИменаМетодовИиКИзТекста(ТекстРасш);
	ТекстКод = Прот.ТекстМетодаБезСтрокИКомментариев(ТекстРасш);
	Т = ТекстРасш;
	Добавленные = Новый Массив;
	Изменилось = Истина;
	Пока Изменилось Цикл
		Изменилось = Ложь;
		Для Каждого КЗ Из РаздВосст.byName Цикл
			Имя = КЗ.Ключ;
			Если РаздРасш.byName.Получить(Имя) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если УжеИиК.Получить(Имя) = Истина Тогда
				Продолжить;
			КонецЕсли;
			Если Не Прот.ЕстьИдентификаторВТексте(ТекстКод, Имя) Тогда
				Продолжить;
			КонецЕсли;
			Мт = КЗ.Значение;
			Хук = СобратьТекстИиКБезИзменений(Мт);
			Если СокрЛП(Хук) = "" Тогда
				Продолжить;
			КонецЕсли;
			Маркер = "// typovaya-up: &ИзменениеИКонтроль typovaya-каллер (тело restored без изменений)";
			Если СтрНайти(Т, Маркер) = 0 Тогда
				Т = СокрП(Т) + ?(СокрЛП(Т) = "", "", Символы.ПС + Символы.ПС) + Маркер + Символы.ПС;
			КонецЕсли;
			Т = СокрП(Т) + Символы.ПС + Символы.ПС + Хук + Символы.ПС;
			УжеИиК.Вставить(Имя, Истина);
			РаздРасш.byName.Вставить(Имя, Мт);
			ТекстКод = Прот.ТекстМетодаБезСтрокИКомментариев(Т);
			Добавленные.Добавить(Имя);
			Изменилось = Истина;
		КонецЦикла;
	КонецЦикла;
	Возврат Т;
КонецФункции

Функция СоответствиеИсключённыхФорм(СписокИсключений)
	Р = Новый Соответствие;
	Если СписокИсключений = Неопределено Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого С Из СписокИсключений Цикл
		Н = НРег(Прот.НормПуть(Строка(С)));
		Если Н <> "" Тогда
			Р.Вставить(Н, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ФормаИсключенаИзПрохода(Отн, Исключения)
	Если Исключения = Неопределено Или Исключения.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Н = НРег(Прот.НормПуть(Отн));
	Если Исключения.Получить(Н) = Истина Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого КЗ Из Исключения Цикл
		Ключ = КЗ.Ключ;
		Если Ключ <> "" И (СтрЗаканчиваетсяНа(Н, Ключ) Или СтрЗаканчиваетсяНа(Ключ, Н)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДополнитьБпХелперыИВынестиУп(КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, СписокФорм, Лог, КаталогОтчёта = "", ИсключенияФорм = Неопределено, ФормыFormXml = Неопределено) Экспорт
	ПодключитьМодули();
	Рез = Новый Структура("forms, helpers, replaced, rebuilt, removed, handlers, moved, metaKept, todo, rows, formItems, attrs",
		0, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, 0, Новый Массив);
	Если ПутьЗапрещёнДляЗаписи(КатВосст) Или ПутьЗапрещёнДляЗаписи(КатРасш) Тогда
		Рез.todo.Добавить("защищённый путь");
		Если Лог <> Неопределено Тогда
			Лог.Добавить("ОТКАЗ: защищённый путь restored/extension");
		КонецЕсли;
		Возврат Рез;
	КонецЕсли;
	Исключения = СоответствиеИсключённыхФорм(ИсключенияФорм);
	СписокFormXml = СоответствиеИсключённыхФорм(ФормыFormXml);
	Если Лог <> Неопределено Тогда
		Лог.Добавить("Дополнение хелперов БП и вынос методов только УП, форм: " + СписокФорм.Количество()
			+ ?(Исключения.Количество() > 0, ", исключений: " + Исключения.Количество(), ""));
	КонецЕсли;
	Для Каждого ОтнСырой Из СписокФорм Цикл
		Отн = Прот.НормПуть(ОтнСырой);
		Х0 = Рез.helpers.Количество();
		З0 = Рез.replaced.Количество();
		В0 = Рез.moved.Количество();
		Т0 = Рез.todo.Количество();
		ОбработатьДополнениеИВыносФормы(Отн, КореньТип, КореньУп, КореньБп, КатВосст, КатРасш, Рез, Исключения, СписокFormXml);
		Если (Рез.helpers.Количество() - Х0) + (Рез.replaced.Количество() - З0) + (Рез.moved.Количество() - В0) > 0 Тогда
			Рез.forms = Рез.forms + 1;
		КонецЕсли;
		Рез.rows.Добавить(Отн);
		Если Лог <> Неопределено Тогда
			Лог.Добавить("  " + Отн + " helpers=" + (Рез.helpers.Количество() - Х0)
				+ " bp=" + (Рез.replaced.Количество() - З0)
				+ " moved=" + (Рез.moved.Количество() - В0)
				+ " todo=" + (Рез.todo.Количество() - Т0));
		КонецЕсли;
	КонецЦикла;
	Если КаталогОтчёта <> "" Тогда
		СоздатьКаталог(КаталогОтчёта);
		Стат = "{""forms"":" + Рез.forms
			+ ",""helpers"":" + Рез.helpers.Количество()
			+ ",""replaced"":" + Рез.replaced.Количество()
			+ ",""movedUpOnly"":" + Рез.moved.Количество()
			+ ",""metaKept"":" + Рез.metaKept.Количество()
			+ ",""todo"":" + Рез.todo.Количество() + "}";
		ЗаписатьТекст(ОбъединитьПути(КаталогОтчёта, "iik_pass2_stat.json"), Стат);
		Если Рез.todo.Количество() > 0 Тогда
			ЗаписатьТекст(ОбъединитьПути(КаталогОтчёта, "iik_pass2_todo.txt"), СтрСоединить(Рез.todo, Символы.ПС) + Символы.ПС);
		КонецЕсли;
		Если Рез.metaKept.Количество() > 0 Тогда
			ЗаписатьТекст(ОбъединитьПути(КаталогОтчёта, "iik_pass2_meta.txt"), СтрСоединить(Рез.metaKept, Символы.ПС) + Символы.ПС);
		КонецЕсли;
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("DONE forms=" + Рез.forms + " helpers=" + Рез.helpers.Количество()
			+ " replaced=" + Рез.replaced.Количество() + " movedUpOnly=" + Рез.moved.Количество()
			+ " metaKept=" + Рез.metaKept.Количество() + " todo=" + Рез.todo.Количество());
	КонецЕсли;
	Возврат Рез;
КонецФункции
