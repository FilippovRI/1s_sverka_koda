// Офлайн-сканер Form.xml расширения: известные паттерны, ломающие XDTO import ibcmd 8.5.
// Запуск: oscript ПроверкаFormXdto.os [каталог extension]
Перем Счёт;

Функция ПозицияBaseForm(Текст)
	Возврат СтрНайти(Текст, "<BaseForm");
КонецФункции

Процедура ЗаписатьНарушение(Код, Путь, ИмяАтр)
	Счёт[Код] = Счёт[Код] + 1;
	Сообщить(Код + "	" + Путь + "	" + ИмяАтр);
КонецПроцедуры

Процедура СканироватьКаталог(Корень)
	Счёт = Новый Соответствие;
	Счёт.Вставить("SAVED_DATA", 0);
	Счёт.Вставить("RECORD_REG_BASE", 0);
	Счёт.Вставить("TYPE_SET", 0);
	Счёт.Вставить("V8UI_ATTR_TYPE", 0);
	Счёт.Вставить("TYPE_DESCRIPTION", 0);
	Счёт.Вставить("VALUE_LIST_ROOT", 0);
	Счёт.Вставить("VALUE_LIST_UP", 0);
	Счёт.Вставить("STYLE_COLOR", 0);
	Счёт.Вставить("CFG_UP_ROOT", 0);
	Счёт.Вставить("MAIN_SAVED", 0);
	Счёт.Вставить("XML_MALFORM", 0);
	Счёт.Вставить("BASE_MAIN_OBJECT", 0);
	Счёт.Вставить("VALUE_TABLE_COL", 0);
	Счёт.Вставить("CFG_COL", 0);
	Счёт.Вставить("FILES", 0);
	Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Forms\") = 0 Или СтрНайти(Ф.ПолноеИмя, "\Ext\") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Т = "";
		Попытка
			ДД = Новый ДвоичныеДанные(Ф.ПолноеИмя);
			Т = ПолучитьСтрокуИзДвоичныхДанных(ДД, "UTF-8");
		Исключение
			Продолжить;
		КонецПопытки;
		Если СтрНайти(Т, "<BaseForm") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(Корень) + 2);
		Если СтрНайти(Т, "<<BaseForm") > 0 Тогда
			ЗаписатьНарушение("XML_MALFORM", Отн, "<<BaseForm");
		КонецЕсли;
		Счёт["FILES"] = Счёт["FILES"] + 1;
		ПозБ = ПозицияBaseForm(Т);
		РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]*)""[^>]*>.*?</Attribute>");
		Для Каждого С Из РвА.НайтиСовпадения(Т) Цикл
			Имя = С.Группы[1].Значение;
			Блок = С.Значение;
			Гл = СтрНайти(Блок, "<MainAttribute>true</MainAttribute>") > 0;
			ВКорне = ПозБ > 0 И СтрНайти(Т, Блок) < ПозБ;
			Если Гл И СтрНайти(Блок, "<SavedData>") > 0 Тогда
				ЗаписатьНарушение("MAIN_SAVED", Отн, Имя);
			КонецЕсли;
			Если СтрНайти(Блок, "<SavedData>") > 0 Или СтрНайти(Блок, "<UseAlways>") > 0 Тогда
				ЗаписатьНарушение("SAVED_DATA", Отн, Имя);
			КонецЕсли;
			Если Не Гл И ПозБ > 0 И СтрНайти(Т, Блок) >= ПозБ И СтрНайти(Блок, "InformationRegisterRecord") > 0 Тогда
				ЗаписатьНарушение("RECORD_REG_BASE", Отн, Имя);
			КонецЕсли;
			Если СтрНайти(Блок, "<v8:TypeSet>") > 0 Тогда
				ЗаписатьНарушение("TYPE_SET", Отн, Имя);
			КонецЕсли;
			Если СтрНайти(Блок, "v8ui:Color") > 0 Или СтрНайти(Блок, "v8ui:FormattedString") > 0 Тогда
				ЗаписатьНарушение("V8UI_ATTR_TYPE", Отн, Имя);
			КонецЕсли;
			Если СтрНайти(Блок, "v8:TypeDescription") > 0 Тогда
				ЗаписатьНарушение("TYPE_DESCRIPTION", Отн, Имя);
			КонецЕсли;
			Если ВКорне И СтрНайти(Блок, "v8:ValueListType") > 0 Тогда
				Если Лев(Имя, 3) = "УП_" Тогда
					ЗаписатьНарушение("VALUE_LIST_UP", Отн, Имя);
				Иначе
					ЗаписатьНарушение("VALUE_LIST_ROOT", Отн, Имя);
				КонецЕсли;
			КонецЕсли;
			Если ВКорне И Лев(Имя, 3) = "УП_" Тогда
				РвТ = Новый РегулярноеВыражение("<v8:Type>([^<]+)</v8:Type>");
				СТ = РвТ.НайтиСовпадения(Блок);
				Если СТ.Количество() > 0 Тогда
					Тип = СТ[0].Группы[1].Значение;
					Если Тип <> "xs:string" И Тип <> "xs:boolean" И Тип <> "xs:decimal" И Тип <> "xs:dateTime" Тогда
						ЗаписатьНарушение("CFG_UP_ROOT", Отн, Имя + " -> " + Тип);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		РвСт = Новый РегулярноеВыражение("<dcscor:value xsi:type=""v8ui:Color"">style:[^<]+</dcscor:value>");
		Если РвСт.НайтиСовпадения(Т).Количество() > 0 Тогда
			ЗаписатьНарушение("STYLE_COLOR", Отн, "");
		КонецЕсли;
		РвСт2 = Новый РегулярноеВыражение("(?s)<(?:TextColor|BackColor|BorderColor|TitleTextColor)>\s*style:");
		Если РвСт2.НайтиСовпадения(Т).Количество() > 0 Тогда
			ЗаписатьНарушение("STYLE_COLOR", Отн, "");
		КонецЕсли;
		ПозБ = ПозицияBaseForm(Т);
		Если ПозБ > 0 Тогда
			База = Сред(Т, ПозБ);
			РвОбъ = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]*)""[^>]*>.*?<MainAttribute>true</MainAttribute>.*?<v8:Type>cfg:(?:CatalogObject|DocumentObject|DataProcessorObject)");
			Для Каждого СОб Из РвОбъ.НайтиСовпадения(База) Цикл
				ИмяГл = СОб.Группы[1].Значение;
				Преф = ИмяГл + ".";
				ЕстьПуть = СтрНайти(База, "<DataPath>" + Преф) > 0
					Или СтрНайти(База, "<DataPath>" + ИмяГл + "</DataPath>") > 0
					Или СтрНайти(База, "<DataPath>~" + Преф) > 0;
				Если Не ЕстьПуть Тогда
					ЗаписатьНарушение("BASE_MAIN_OBJECT", Отн, ИмяГл);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		РвКолCfg = Новый РегулярноеВыражение("(?s)<Column\b[^>]*>(?:(?!</Column>).)*<v8:Type>cfg:(?:EnumRef|CatalogRef|DocumentRef)");
		Если РвКолCfg.НайтиСовпадения(Т).Количество() > 0 Тогда
			ЗаписатьНарушение("CFG_COL", Отн, "");
		КонецЕсли;
		РвКолВт = Новый РегулярноеВыражение("(?s)<Column\b[^>]*>(?:(?!</Column>).)*<Type>(?:(?!</Type>).)*<v8:Type>v8:ValueTable</v8:Type>");
		Если РвКолВт.НайтиСовпадения(Т).Количество() > 0 Тогда
			ЗаписатьНарушение("VALUE_TABLE_COL", Отн, "");
		КонецЕсли;
	КонецЦикла;
	Сообщить("---");
	Сообщить("forms scanned: " + Счёт["FILES"]);
	Для Каждого КЗ Из Счёт Цикл
		Если КЗ.Ключ = "FILES" Тогда
			Продолжить;
		КонецЕсли;
		Если КЗ.Значение > 0 Тогда
			Сообщить(КЗ.Ключ + ": " + КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Итого = 0;
	Для Каждого КЗ Из Счёт Цикл
		Если КЗ.Ключ <> "FILES" Тогда
			Итого = Итого + КЗ.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Итого > 0 Тогда
		ВызватьИсключение "form_xdto_scan: " + Итого + " issues";
	КонецЕсли;
	Сообщить("OK form_xdto_scan");
КонецПроцедуры

Корень = "D:\typovaya-up-out-20261118u\extension";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Корень = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
СканироватьКаталог(Корень);