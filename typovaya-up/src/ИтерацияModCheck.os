// Быстрый цикл: import → дозаготовки по логу → import (без полной пересборки).
// oscript ИтерацияModCheck.os [выход] [макс_итераций_на_фазу]
КореньСк = ТекущийСценарий().Каталог;
Oscript = "C:\Users\rst_filippov\OneScript\bin\oscript.exe";
Выход = "D:\typovaya-up-out-20261118u";
Макс = 12;
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Выход = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	Макс = Число(АргументыКоманднойСтроки[1]);
КонецЕсли;
ЛогОсн = ОбъединитьПути(Выход, "modcheck-import-main.log");
ЛогРасш = ОбъединитьПути(Выход, "modcheck-import-ext.log");
СуммарноЗагл = Новый Структура("stubs, fragments", 0, 0);
Для Ит = 1 По Макс Цикл
	Сообщить("=== MAIN iter " + Ит + " / " + Макс + " ===");
	Код = 0;
	ЗапуститьПриложение("""" + Oscript + """ """ + ОбъединитьПути(КореньСк, "ИмпортModCheck.os") + """ """ + Выход + """ --only-main --allow-fail", "", Истина, Код);
	Сообщить("import main exit " + Код);
	Если Код = 0 Тогда
		Прервать;
	КонецЕсли;
	Если Не (Новый Файл(ЛогОсн)).Существует() Тогда
		ВызватьИсключение "нет лога " + ЛогОсн;
	КонецЕсли;
	Кд = 0;
	ЗапуститьПриложение("""" + Oscript + """ """ + ОбъединитьПути(КореньСк, "ДозаготовкиБыстро.os") + """ --лог """ + ЛогОсн + """ --out """ + Выход + """ --цель restored", "", Истина, Кд);
	Сообщить("dogruzka restored exit " + Кд);
КонецЦикла;
Если Код <> 0 Тогда
	ВызватьИсключение "main import not zero after " + Макс + " iterations";
КонецЕсли;
Сообщить("=== MAIN OK — full pipeline ===");
Кп = 0;
ЗапуститьПриложение("""" + Oscript + """ """ + ОбъединитьПути(КореньСк, "ИмпортModCheck.os") + """ """ + Выход + """ --only-main", "", Истина, Кп);
Для Ит = 1 По Макс Цикл
	Сообщить("=== EXT iter " + Ит + " / " + Макс + " ===");
	Кэ = 0;
	ЗапуститьПриложение("""" + Oscript + """ """ + ОбъединитьПути(КореньСк, "ИмпортModCheck.os") + """ """ + Выход + """ --only-ext --allow-fail", "", Истина, Кэ);
	Сообщить("import ext exit " + Кэ);
	Если Кэ = 0 Тогда
		Прервать;
	КонецЕсли;
	Если (Новый Файл(ЛогРасш)).Существует() Тогда
		Кд = 0;
		ЗапуститьПриложение("""" + Oscript + """ """ + ОбъединитьПути(КореньСк, "ДозаготовкиБыстро.os") + """ --лог """ + ЛогРасш + """ --out """ + Выход + """ --цель restored", "", Истина, Кд);
		Сообщить("dogruzka ext→restored exit " + Кд);
	КонецЕсли;
КонецЦикла;
Если Кэ <> 0 Тогда
	ВызватьИсключение "extension import not zero after " + Макс + " iterations";
КонецЕсли;
Кф = 0;
ЗапуститьПриложение("""" + Oscript + """ """ + ОбъединитьПути(КореньСк, "ИмпортModCheck.os") + """ """ + Выход + """", "", Истина, Кф);
Сообщить("final pipeline exit " + Кф);
ЗавершитьРаботу(Кф);