// Цикл: сборка → import restored → (при ошибке догрузка по логу) → import extension → CheckModules.
// oscript ИтерацияModCheck.os [выход] [макс_итераций]
КореньСк = ТекущийСценарий().Каталог;
Oscript = "C:\Users\rst_filippov\OneScript\bin\oscript.exe";
Кав = Символ(34);
Выход = "D:\typovaya-up-out-20261118u";
Макс = 4;
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Выход = СокрЛП(АргументыКоманднойСтроки[0]);
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	Макс = Число(АргументыКоманднойСтроки[1]);
КонецЕсли;
Главный = ОбъединитьПути(КореньСк, "Главный.os");
ЛогИмп = "";
Для Ит = 1 По Макс Цикл
	Сообщить("=== iteration " + Ит + " / " + Макс + " ===");
	Кс = Новый КомандаОС();
	АргСборки = Кав + Oscript + Кав + " " + Кав + Главный + Кав
		+ " --source " + Кав + "D:\Выгрузка УП" + Кав
		+ " --vendor " + Кав + "D:\выгрузка БП" + Кав
		+ " --settings " + Кав + "C:\Users\rst_filippov\config_merge_settings.xml" + Кав
		+ " --out " + Кав + Выход + Кав + " --no-report --no-syntax";
	Если ЛогИмп <> "" Тогда
		АргСборки = АргСборки + " --лог-импорта " + Кав + ЛогИмп + Кав;
	КонецЕсли;
	Кс.УстановитьКоманду(АргСборки + " > " + Кав + "D:\typovaya-up-glavny-rebuild-inplace.log" + Кав + " 2>&1");
	Кс.ИспользоватьВыводКакРезультат = Ложь;
	Кс.Исполнить();
	Если Кс.КодВозврата <> 0 Тогда
		ВызватьИсключение "build failed " + Кс.КодВозврата;
	КонецЕсли;
	Км = Новый КомандаОС();
	Км.УстановитьКоманду(Кав + Oscript + Кав + " " + Кав + ОбъединитьПути(КореньСк, "ИмпортModCheck.os") + Кав + " " + Кав + Выход + Кав);
	Км.ИспользоватьВыводКакРезультат = Ложь;
	Км.Исполнить();
	Если Км.КодВозврата = 0 Тогда
		Сообщить("OK: import + CheckModules");
		ЗавершитьРаботу(0);
	КонецЕсли;
	ЛогИмп = ОбъединитьПути(Выход, "modcheck-import-main.log");
	Если Не (Новый Файл(ЛогИмп)).Существует() Тогда
		ЛогИмп = "D:\typovaya-up-modcheck-import-restored-66.log";
	КонецЕсли;
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "РазборЛогаИмпорта.os"));
	Лог = Новый Массив;
	КореньВосст = ОбъединитьПути(Выход, "restored");
	КореньБп = "D:\выгрузка БП";
	КореньУп = "D:\Выгрузка УП";
	Р = Разбор.ДополнитьЗаготовкиПоЛогу(КореньВосст, КореньБп, КореньУп, ЛогИмп, Лог);
	Сообщить("dogruzka paths=" + Р.paths + " stubs=" + Р.stubs + " fragments=" + Р.fragments);
КонецЦикла;
ВызватьИсключение "max iterations exceeded";