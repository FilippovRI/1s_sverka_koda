// Пустые заготовки объектов БП для ссылок из Form.xml (без реквизитов, форм, модулей).

Перем ВозвратБп;
Перем ConfigDump;

Функция Инициализировать() Экспорт
	ВозвратБп = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратОбщихМодулейБп.os"));
	ConfigDump = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ConfigDumpInfoБп.os"));
КонецФункции

Функция ПапкиМетаданных() Экспорт
	Р = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Catalog:Catalogs,Document:Documents,Enum:Enums,InformationRegister:InformationRegisters,"
		+ "AccumulationRegister:AccumulationRegisters,ChartOfAccounts:ChartsOfAccounts,DocumentJournal:DocumentJournals,"
		+ "ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,ChartOfCalculationTypes:ChartsOfCalculationTypes,"
		+ "AccountingRegister:AccountingRegisters,Task:Tasks,DataProcessor:DataProcessors,Report:Reports,"
		+ "CommonPicture:CommonPictures,StyleItem:StyleItems,Style:Styles,CommonCommand:CommonCommands,"
		+ "CommandGroup:CommandGroups,CommonTemplate:CommonTemplates,FilterCriterion:FilterCriteria,"
		+ "DefinedType:DefinedTypes,FunctionalOption:FunctionalOptions,CommonForm:CommonForms,CommonModule:CommonModules", ",") Цикл
		Ч = СтрРазделить(П, ":");
		Р.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ТегИзИмениТипа(ИмяТипа)
	Если Лев(НРег(ИмяТипа), 3) = "cfg" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ИмяТипа = "StdPicture" Тогда
		Возврат Неопределено;
	КонецЕсли;
	П = СтрНайти(ИмяТипа, "Ref");
	Если П > 0 Тогда
		Возврат Лев(ИмяТипа, П - 1);
	КонецЕсли;
	Суф = Новый Соответствие;
	Для Каждого С Из СтрРазделить("Object,Manager,List,Selection,RecordSet,RecordManager,RecordKey,Record,ValueManager,Folder,TabularSection", ",") Цикл
		Суф.Вставить(С, Истина);
	КонецЦикла;
	Для Каждого КЗ Из Суф Цикл
		П2 = СтрНайти(ИмяТипа, КЗ.Ключ);
		Если П2 > 1 И П2 + СтрДлина(КЗ.Ключ) - 1 = СтрДлина(ИмяТипа) Тогда
			Возврат Лев(ИмяТипа, П2 - 1);
		КонецЕсли;
	КонецЦикла;
	Если ПапкиМетаданных().Получить(ИмяТипа) <> Неопределено Тогда
		Возврат ИмяТипа;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция РазборCfg(Знач ТипCfg) Экспорт
	ТипCfg = СокрЛП(ТипCfg);
	Если Лев(НРег(ТипCfg), 4) <> "cfg:" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Х = Сред(ТипCfg, 5);
	П = СтрНайти(Х, ".");
	Если П = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вид = Лев(Х, П - 1);
	Хвост = Сред(Х, П + 1);
	Если Вид = "EnumValue" Тогда
		П2 = СтрНайти(Хвост, ".");
		Если П2 = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Режим, Тег, Имя, Значение", "EnumValue", "Enum", Лев(Хвост, П2 - 1), Сред(Хвост, П2 + 1));
	КонецЕсли;
	Тег = ТегИзИмениТипа(Вид);
	Если Тег = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Режим, Тег, Имя", "Объект", Тег, Хвост);
КонецФункции

Функция СобратьИзФорм(Корень, Состав, КореньУп) Экспорт
	Объекты = Новый Соответствие;
	ЗначПер = Новый Соответствие;
	РвXr = Новый РегулярноеВыражение("<xr:Ref>([^<]+)</xr:Ref>");
	РвDt = Новый РегулярноеВыражение("Enum\.([^.]+)\.EnumValue\.([^.<""]+)");
	РвCfg = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
	Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
		Т = ВозвратБп.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из РвXr.НайтиСовпадения(Т) Цикл
			ДобОбъект(Объекты, С.Группы[1].Значение, Состав, КореньУп, Ложь, Корень);
		КонецЦикла;
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			Р = РазборCfg(С.Группы[1].Значение);
			Если Р = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Р.Режим = "EnumValue" Тогда
				ДобЗначПер(ЗначПер, Р.Имя, Р.Значение);
			Иначе
				ДобОбъектПоТегу(Объекты, Р.Тег, Р.Имя, Состав, КореньУп, Ложь, Корень);
			КонецЕсли;
		КонецЦикла;
		Для Каждого С Из РвDt.НайтиСовпадения(Т) Цикл
			ДобЗначПер(ЗначПер, С.Группы[1].Значение, С.Группы[2].Значение);
			ДобОбъектПоТегу(Объекты, "Enum", С.Группы[1].Значение, Состав, КореньУп, Ложь, Корень);
		КонецЦикла;
	КонецЦикла;
	СобратьОтсутствующиеCfgСсылки(Корень, Объекты, Состав, КореньУп);
	Возврат Новый Структура("objects, enumValues", Объекты, ЗначПер);
КонецФункции

// cfg:-типы по Form.xml и метаданным объектов (реквизиты и т.д.), которых нет в составе restored.
Процедура СобратьОтсутствующиеCfgСсылки(Корень, Объекты, Состав, КореньУп) Экспорт
	РвV8 = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
	РвCfg = Новый РегулярноеВыражение("cfg:([A-Za-zА-Яа-яЁё]+)\.([^\s""<]+)");
	Для Каждого Ф Из НайтиФайлы(Корень, "*.xml", Истина) Цикл
		Т = ВозвратБп.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Или СтрНайти(Т, "cfg:") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из РвV8.НайтиСовпадения(Т) Цикл
			Р = РазборCfg(С.Группы[1].Значение);
			Если Р <> Неопределено И Р.Режим = "Объект" Тогда
				ДобОбъектПоТегу(Объекты, Р.Тег, Р.Имя, Состав, КореньУп, Ложь, Корень);
			КонецЕсли;
		КонецЦикла;
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			Р = РазборCfg("cfg:" + С.Группы[1].Значение + "." + С.Группы[2].Значение);
			Если Р <> Неопределено И Р.Режим = "Объект" Тогда
				ДобОбъектПоТегу(Объекты, Р.Тег, Р.Имя, Состав, КореньУп, Ложь, Корень);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ДобОбъект(Объекты, СтрСсылка, Состав, КореньУп, Принудительно = Ложь, КореньВосст = "")
	П = СтрНайти(СтрСсылка, ".");
	Если П = 0 Тогда
		Возврат;
	КонецЕсли;
	ДобОбъектПоТегу(Объекты, Лев(СтрСсылка, П - 1), Сред(СтрСсылка, П + 1), Состав, КореньУп, Принудительно, КореньВосст);
КонецПроцедуры

Процедура ДобОбъектПоТегу(Объекты, Тег, Имя, Состав, КореньУп, Принудительно = Ложь, КореньВосст = "")
	Если Тег = "StdPicture" Тогда
		Возврат;
	КонецЕсли;
	С = ВозвратБп.ИменаТега(Состав, Тег);
	Если Не Принудительно И С.Получить(НРег(Имя)) <> Неопределено Тогда
		ПапПр = ПапкиМетаданных().Получить(Тег);
		Если КореньВосст <> "" И ПапПр <> Неопределено Тогда
			ПутьВосст = ОбъединитьПути(КореньВосст, ПапПр, Имя + ".xml");
			Если (Новый Файл(ПутьВосст)).Существует() И Не ЭтоПустаяЗаготовка(ПутьВосст) Тогда
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Пап = ПапкиМетаданных().Получить(Тег);
	// DefinedType в restored берётся из УП целиком, даже если тип есть в выгрузке УП.
	Если КореньУп <> "" И Пап <> Неопределено И Тег <> "DefinedType" Тогда
		ПУ = ОбъединитьПути(КореньУп, Пап, Имя + ".xml");
		Если (Новый Файл(ПУ)).Существует() Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Объекты.Вставить(Тег + "|" + Имя, Новый Структура("Тег, Имя, Принудительно", Тег, Имя, Принудительно));
КонецПроцедуры

Процедура ДобЗначПер(ЗначПер, ИмяПер, ИмяЗнач)
	К = НРег(ИмяПер);
	М = ЗначПер.Получить(К);
	Если М = Неопределено Тогда
		М = Новый Соответствие;
		ЗначПер.Вставить(К, М);
	КонецЕсли;
	М.Вставить(НРег(ИмяЗнач), ИмяЗнач);
КонецПроцедуры

Функция ОчиститьСвойства(Свойства)
	Рв = Новый РегулярноеВыражение("(?s)<(Default\w+Form|Auxiliary\w+Form)>[^<]*</\1>");
	Свойства = Рв.Заменить(Свойства, "");
	Рв0 = Новый РегулярноеВыражение("(?s)<(Default\w+Form|Auxiliary\w+Form)/>");
	Свойства = Рв0.Заменить(Свойства, "");
	Для Каждого Т Из СтрРазделить("Owners,BasedOn,CharacteristicTypes,CharacteristicValues,RegisterRecords,ChoiceHistoryOnInput", ",") Цикл
		Рв2 = Новый РегулярноеВыражение("(?s)<" + Т + ">(.*?)</" + Т + ">");
		Свойства = Рв2.Заменить(Свойства, "<" + Т + "/>");
	КонецЦикла;
	Рв3 = Новый РегулярноеВыражение("(?s)<InputByString>.*?</InputByString>");
	Свойства = Рв3.Заменить(Свойства, "");
	Рв4 = Новый РегулярноеВыражение("(?s)<StandardAttributes>.*?</StandardAttributes>");
	Свойства = Рв4.Заменить(Свойства, "");
	Рв5 = Новый РегулярноеВыражение("(?s)<xr:ChoiceHistoryOnInput>\s*</xr:ChoiceHistoryOnInput>");
	Свойства = Рв5.Заменить(Свойства, "");
	Рв6 = Новый РегулярноеВыражение("(?s)<ChoiceHistoryOnInput>.*?</ChoiceHistoryOnInput>");
	Свойства = Рв6.Заменить(Свойства, "");
	Свойства = СтрЗаменить(Свойства, "<ChoiceHistoryOnInput/>", "");
	Возврат Свойства;
КонецФункции

Функция ПустоеТребование() Экспорт
	Возврат Новый Структура("attrs, ts, forms, templates, dims, res, fullMeta",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие, Ложь);
КонецФункции

Функция ПолныйВозвратМетаданныхУпБп(Тег) Экспорт
	Для Каждого Т Из СтрРазделить("Task,BusinessProcess,InformationRegister,ChartOfCharacteristicTypes", ",") Цикл
		Если Тег = Т Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПутьЛогаТребуетПолногоМетаданных(Путь) Экспорт
	Возврат СтрНайти(Путь, ".AddressingAttribute.") > 0;
КонецФункции

Функция КорневойОбъектИзПутиЛога(Путь) Экспорт
	Рв = Новый РегулярноеВыражение("^(Task|BusinessProcess|InformationRegister|Catalog|Document|AccumulationRegister|DataProcessor|Report)\.([^.]+)");
	С = Рв.НайтиСовпадения(СокрЛП(Путь));
	Если С.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("tag, name", С[0].Группы[1].Значение, С[0].Группы[2].Значение);
КонецФункции

Функция НуженПолныйВозвратМетаданных(Тег, Тр) Экспорт
	Если ПолныйВозвратМетаданныхУпБп(Тег) Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат ТипЗнч(Тр) = Тип("Структура") И Тр.fullMeta = Истина;
КонецФункции

Функция ТребованиеОбъекта(Требования, Тег, Имя) Экспорт
	К = Тег + "|" + Имя;
	Т = Требования.Получить(К);
	Если Т = Неопределено Тогда
		Т = ПустоеТребование();
		Требования.Вставить(К, Т);
	КонецЕсли;
	Возврат Т;
КонецФункции

Процедура ДобПутьМетаданных(Требования, Объекты, Состав, КореньУп, Знач СтрПуть, ДобавлятьОбъекты = Истина, КореньВосст = "")
	СтрПуть = СтрЗаменить(СтрПуть, "DocumentObject.", "Document.");
	СтрПуть = СтрЗаменить(СтрПуть, "CatalogObject.", "Catalog.");
	СтрПуть = СтрЗаменить(СтрПуть, "ChartOfCharacteristicTypesObject.", "ChartOfCharacteristicTypes.");
	СтрПуть = СтрЗаменить(СтрПуть, "ChartOfCalculationTypesObject.", "ChartOfCalculationTypes.");
	Рв = Новый РегулярноеВыражение("(Catalog|Document|InformationRegister|AccumulationRegister|ChartOfAccounts|ChartOfCharacteristicTypes|ChartOfCalculationTypes|DocumentJournal|DataProcessor|Report|Task|BusinessProcess)\.([\wЁёА-Яа-яA-Za-z0-9_]+)(?:\.(TabularSection|Attribute|Form|Template|Dimension|Resource|AddressingAttribute)\.([\wЁёА-Яа-яA-Za-z0-9_]+)(?:\.(Attribute|StandardAttribute)\.([\wЁёА-Яа-яA-Za-z0-9_]+))?)?");
	Для Каждого С Из Рв.НайтиСовпадения(СтрПуть) Цикл
		Тег = С.Группы[1].Значение;
		Имя = С.Группы[2].Значение;
		Если ДобавлятьОбъекты И Объекты.Количество() < 400 Тогда
			ДобОбъектПоТегу(Объекты, Тег, Имя, Состав, КореньУп, Ложь, КореньВосст);
		КонецЕсли;
		Т = ТребованиеОбъекта(Требования, Тег, Имя);
		Вид = С.Группы[3].Значение;
		Им2 = С.Группы[4].Значение;
		Если Вид = "" Тогда
			Продолжить;
		ИначеЕсли Вид = "Attribute" Тогда
			Т.attrs.Вставить(НРег(Им2), Им2);
		ИначеЕсли Вид = "Form" Тогда
			Т.forms.Вставить(НРег(Им2), Им2);
		ИначеЕсли Вид = "Template" Тогда
			Т.templates.Вставить(НРег(Им2), Им2);
		ИначеЕсли Вид = "TabularSection" Тогда
			Если Т.ts.Получить(Им2) = Неопределено Тогда
				Т.ts.Вставить(Им2, Новый Соответствие);
			КонецЕсли;
			Если С.Группы[6].Значение <> "" Тогда
				Т.ts.Получить(Им2).Вставить(НРег(С.Группы[6].Значение), С.Группы[6].Значение);
			КонецЕсли;
		ИначеЕсли Вид = "Dimension" Тогда
			Т.dims.Вставить(НРег(Им2), Им2);
		ИначеЕсли Вид = "Resource" Тогда
			Т.res.Вставить(НРег(Им2), Им2);
		ИначеЕсли Вид = "AddressingAttribute" Тогда
			Т.fullMeta = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СобратьТребованияПоКорню(Корень, Объекты, Состав, КореньУп) Экспорт
	Треб = Новый Соответствие;
	РвCfg = Новый РегулярноеВыражение("cfg:([^\s""<]+)");
	РвXr = Новый РегулярноеВыражение("<xr:Ref>([^<]+)</xr:Ref>");
	Для Каждого Ф Из НайтиФайлы(Корень, "*.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Forms\") > 0 И Не Ф.Имя = "Form.xml" И Не Ф.Имя = "Configuration.xml" Тогда
			// метаданные форм на объекте
		КонецЕсли;
		Разм = 0;
		Попытка
			Разм = (Новый Файл(Ф.ПолноеИмя)).Размер();
		Исключение
		КонецПопытки;
		Если Разм > 15000000 Тогда
			Продолжить;
		КонецЕсли;
		Т = ВозвратБп.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Т, "TabularSection") = 0 И СтрНайти(Т, "cfg:") = 0 И СтрНайти(Т, "xr:Ref") = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобПутьМетаданных(Треб, Объекты, Состав, КореньУп, Т, Ложь, Корень);
		Для Каждого С Из РвCfg.НайтиСовпадения(Т) Цикл
			ДобПутьМетаданных(Треб, Объекты, Состав, КореньУп, С.Группы[1].Значение, Ложь, Корень);
			Р = РазборCfg("cfg:" + С.Группы[1].Значение);
			Если Р <> Неопределено И Р.Режим = "Объект" Тогда
				ДобОбъектПоТегу(Объекты, Р.Тег, Р.Имя, Состав, КореньУп, Ложь, Корень);
			КонецЕсли;
		КонецЦикла;
		Для Каждого С Из РвXr.НайтиСовпадения(Т) Цикл
			ДобПутьМетаданных(Треб, Объекты, Состав, КореньУп, С.Группы[1].Значение, Ложь, Корень);
		КонецЦикла;
	КонецЦикла;
	Возврат Треб;
КонецФункции

Функция ВырезатьКороткуюСсылку(Ч, ИмяТега, ИмяСвойства) Экспорт
	Рв = Новый РегулярноеВыражение("(?m)^\s*<" + ИмяТега + ">" + ИмяСвойства + "</" + ИмяТега + ">");
	С = Рв.НайтиСовпадения(Ч);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + "		" + СокрЛП(С[0].Значение);
КонецФункции

Функция ВырезатьЭлементChildObjects(Ч, ИмяТега, ИмяСвойства) Экспорт
	Рв = Новый РегулярноеВыражение("(?s)<" + ИмяТега + "\s+uuid=""[^""]+"">(?:(?!</" + ИмяТега + ">).)*?<Name>" + ИмяСвойства + "</Name>(?:(?!</" + ИмяТега + ">).)*?</" + ИмяТега + ">");
	С = Рв.НайтиСовпадения(Ч);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Символы.ПС + "		" + С[0].Значение;
КонецФункции

Функция ВырезатьТабличнуюЧасть(Ч, ИмяТС, АтрибутыТС)
	Рв = Новый РегулярноеВыражение("(?s)<TabularSection\s+uuid=""[^""]+"">(?:(?!</TabularSection>).)*?<Name>" + ИмяТС + "</Name>(?:(?!</TabularSection>).)*?</TabularSection>");
	С = Рв.НайтиСовпадения(Ч);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Блок = С[0].Значение;
	Если АтрибутыТС.Количество() = 0 Тогда
		Возврат Символы.ПС + "		" + Блок;
	КонецЕсли;
	Внутр = ИзвлечьБлок(Блок, "ChildObjects");
	Если Внутр = "" Тогда
		Возврат Символы.ПС + "		" + Блок;
	КонецЕсли;
	АтрБ = "";
	Для Каждого КЗ Из АтрибутыТС Цикл
		Ф = ВырезатьЭлементChildObjects(Внутр, "Attribute", КЗ.Значение);
		Если Ф <> "" Тогда
			АтрБ = АтрБ + Ф;
		КонецЕсли;
	КонецЦикла;
	Если АтрБ = "" Тогда
		Возврат Символы.ПС + "		" + Блок;
	КонецЕсли;
	Рв2 = Новый РегулярноеВыражение("(?s)<ChildObjects>.*?</ChildObjects>");
	Блок = Рв2.Заменить(Блок, "<ChildObjects>" + АтрБ + Символы.ПС + "		</ChildObjects>");
	Возврат Символы.ПС + "		" + Блок;
КонецФункции

Функция ChildObjectsИзТребований(Тег, Исх, Треб, ИмяПер, ЗначПер)
	Если Тег = "Enum" Тогда
		Возврат ChildObjectsЗаготовки(Тег, Исх, ИмяПер, ЗначПер);
	КонецЕсли;
	Ч = ИзвлечьChildObjectsОбъекта(Исх, Тег);
	Блок = "";
	Сч = 0;
	Для Каждого КЗ Из Треб.attrs Цикл
		Ф = ВырезатьЭлементChildObjects(Ч, "Attribute", КЗ.Значение);
		Если Ф <> "" Тогда
			Блок = Блок + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Треб.ts Цикл
		Ф = ВырезатьТабличнуюЧасть(Ч, КЗ.Ключ, КЗ.Значение);
		Если Ф <> "" Тогда
			Блок = Блок + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Треб.templates Цикл
		Ф = ВырезатьКороткуюСсылку(Ч, "Template", КЗ.Значение);
		Если Ф = "" Тогда
			Ф = ВырезатьЭлементChildObjects(Ч, "Template", КЗ.Значение);
		КонецЕсли;
		Если Ф <> "" Тогда
			Блок = Блок + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Треб.forms Цикл
		Ф = ВырезатьЭлементChildObjects(Ч, "Form", КЗ.Значение);
		Если Ф = "" Тогда
			Ф = ВырезатьКороткуюСсылку(Ч, "Form", КЗ.Значение);
		КонецЕсли;
		Если Ф <> "" Тогда
			Блок = Блок + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Треб.dims Цикл
		Ф = ВырезатьЭлементChildObjects(Ч, "Dimension", КЗ.Значение);
		Если Ф <> "" Тогда
			Блок = Блок + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Треб.res Цикл
		Ф = ВырезатьЭлементChildObjects(Ч, "Resource", КЗ.Значение);
		Если Ф <> "" Тогда
			Блок = Блок + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Если Блок = "" Тогда
		ПустТреб = Треб.attrs.Количество() + Треб.ts.Количество() + Треб.forms.Количество() + Треб.templates.Количество() + Треб.dims.Количество() + Треб.res.Количество() = 0;
		Если ПустТреб Тогда
			Возврат Новый Структура("xml, parts", ChildObjectsЗаготовки(Тег, Исх, ИмяПер, ЗначПер), 0);
		КонецЕсли;
		Для Каждого КЗ Из Треб.ts Цикл
			Ф = ВырезатьТабличнуюЧасть(Ч, КЗ.Ключ, Новый Соответствие);
			Если Ф <> "" Тогда
				Блок = Блок + Ф;
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
		Если Блок = "" Тогда
			Возврат Новый Структура("xml, parts", ChildObjectsЗаготовки(Тег, Исх, ИмяПер, ЗначПер), 0);
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("xml, parts", "		<ChildObjects>" + Блок + Символы.ПС + "		</ChildObjects>", Сч);
КонецФункции

Процедура КопироватьФормуБезМодулей(КореньБп, Корень, Пап, ИмяОбъекта, ИмяФормы)
	База = ОбъединитьПути(ОбъединитьПути(КореньБп, Пап, ИмяОбъекта), "Forms", ИмяФормы);
	Если Не (Новый Файл(База)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Назн = ОбъединитьПути(ОбъединитьПути(Корень, Пап, ИмяОбъекта), "Forms", ИмяФормы);
	СоздатьКаталог(Назн);
	Для Каждого Ф Из НайтиФайлы(База, "*", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(База) + 2);
		Если НРег(Ф.Имя) = "module.bsl" Тогда
			Продолжить;
		КонецЕсли;
		К = ОбъединитьПути(Назн, Отн);
		Если Ф.ЭтоКаталог() Тогда
			СоздатьКаталог(К);
		Иначе
			СоздатьКаталог((Новый Файл(К)).Путь);
			КопироватьФайл(Ф.ПолноеИмя, К);
		КонецЕсли;
	КонецЦикла;
	Мета = ОбъединитьПути(ОбъединитьПути(КореньБп, Пап, ИмяОбъекта), "Forms", ИмяФормы + ".xml");
	Если (Новый Файл(Мета)).Существует() Тогда
		СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(Корень, Пап, ИмяОбъекта), "Forms"));
		КопироватьФайл(Мета, ОбъединитьПути(ОбъединитьПути(Корень, Пап, ИмяОбъекта), "Forms", ИмяФормы + ".xml"));
	КонецЕсли;
КонецПроцедуры

Процедура КопироватьШаблонБезМодулей(КореньБп, Корень, Пап, ИмяОбъекта, ИмяШаблона)
	База = ОбъединитьПути(ОбъединитьПути(КореньБп, Пап, ИмяОбъекта), "Templates", ИмяШаблона);
	Если Не (Новый Файл(База)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Назн = ОбъединитьПути(ОбъединитьПути(Корень, Пап, ИмяОбъекта), "Templates", ИмяШаблона);
	СоздатьКаталог(Назн);
	Для Каждого Ф Из НайтиФайлы(База, "*", Истина) Цикл
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(База) + 2);
		Если НРег(Ф.Имя) = "module.bsl" Тогда
			Продолжить;
		КонецЕсли;
		К = ОбъединитьПути(Назн, Отн);
		Если Ф.ЭтоКаталог() Тогда
			СоздатьКаталог(К);
		Иначе
			СоздатьКаталог((Новый Файл(К)).Путь);
			КопироватьФайл(Ф.ПолноеИмя, К);
		КонецЕсли;
	КонецЦикла;
	Мета = ОбъединитьПути(ОбъединитьПути(КореньБп, Пап, ИмяОбъекта), "Templates", ИмяШаблона + ".xml");
	Если (Новый Файл(Мета)).Существует() Тогда
		СоздатьКаталог(ОбъединитьПути(ОбъединитьПути(Корень, Пап, ИмяОбъекта), "Templates"));
		КопироватьФайл(Мета, ОбъединитьПути(ОбъединитьПути(Корень, Пап, ИмяОбъекта), "Templates", ИмяШаблона + ".xml"));
	КонецЕсли;
КонецПроцедуры

Функция ЕстьВChildObjects(Внутр, ИмяТега, ИмяСвойства) Экспорт
	РвК = Новый РегулярноеВыражение("(?m)^\s*<" + ИмяТега + ">" + ИмяСвойства + "</" + ИмяТега + ">");
	Если РвК.НайтиСовпадения(Внутр).Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("(?s)<" + ИмяТега + "\s+uuid=""[^""]+"">(?:(?!</" + ИмяТега + ">).)*?<Name>" + ИмяСвойства + "</Name>");
	Возврат Рв.НайтиСовпадения(Внутр).Количество() > 0;
КонецФункции

Функция ДополнитьФрагментамиОбъект(Корень, КореньБп, Пап, Тег, Имя, Треб, Лог) Экспорт
	Ключ = Тег + "|" + Имя;
	Если ТипЗнч(Треб) = Тип("Соответствие") Тогда
		Тр = Треб.Получить(Ключ);
	Иначе
		Тр = Треб;
	КонецЕсли;
	Если Тр = Неопределено Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	Назн = ОбъединитьПути(Корень, Пап, Имя + ".xml");
	Исх = ОбъединитьПути(КореньБп, Пап, Имя + ".xml");
	Если Не (Новый Файл(Назн)).Существует() Или Не (Новый Файл(Исх)).Существует() Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	ТекНазн = ВозвратБп.ПрочитатьТекст(Назн);
	ТекБп = ВозвратБп.ПрочитатьТекст(Исх);
	Если ТекНазн = Неопределено Или ТекБп = Неопределено Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	ВнутрНазн = ИзвлечьChildObjectsОбъекта(ТекНазн, Тег);
	Пока СтрДлина(ВнутрНазн) > 0 И Лев(СокрЛ(ВнутрНазн), 1) = ">" Цикл
		ВнутрНазн = СокрЛП(Сред(СокрЛ(ВнутрНазн), 2));
	КонецЦикла;
	ЧБп = ИзвлечьChildObjectsОбъекта(ТекБп, Тег);
	Доб = "";
	Сч = 0;
	Для Каждого КЗ Из Тр.attrs Цикл
		Если ЕстьВChildObjects(ВнутрНазн, "Attribute", КЗ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Ф = ВырезатьЭлементChildObjects(ЧБп, "Attribute", КЗ.Значение);
		Если Ф <> "" Тогда
			Доб = Доб + Ф;
			Сч = Сч + 1;
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Тр.forms Цикл
		Если ЕстьВChildObjects(ВнутрНазн, "Form", КЗ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Ф = ВырезатьЭлементChildObjects(ЧБп, "Form", КЗ.Значение);
		Если Ф = "" Тогда
			Ф = ВырезатьКороткуюСсылку(ЧБп, "Form", КЗ.Значение);
		КонецЕсли;
		Если Ф <> "" Тогда
			Доб = Доб + Ф;
			Сч = Сч + 1;
			КопироватьФормуБезМодулей(КореньБп, Корень, Пап, Имя, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КЗ Из Тр.templates Цикл
		Если ЕстьВChildObjects(ВнутрНазн, "Template", КЗ.Значение) Тогда
			Продолжить;
		КонецЕсли;
		Ф = ВырезатьКороткуюСсылку(ЧБп, "Template", КЗ.Значение);
		Если Ф = "" Тогда
			Ф = ВырезатьЭлементChildObjects(ЧБп, "Template", КЗ.Значение);
		КонецЕсли;
		Если Ф <> "" Тогда
			Доб = Доб + Ф;
			Сч = Сч + 1;
			КопироватьШаблонБезМодулей(КореньБп, Корень, Пап, Имя, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Если Тр.Свойство("ts") Тогда
		Для Каждого КЗ Из Тр.ts Цикл
			Если ЕстьВChildObjects(ВнутрНазн, "TabularSection", КЗ.Ключ) Тогда
				Ф = ВырезатьТабличнуюЧасть(ЧБп, КЗ.Ключ, КЗ.Значение);
				Если Ф <> "" Тогда
					РвУд = Новый РегулярноеВыражение("(?s)<TabularSection\s+uuid=""[^""]+"">(?:(?!</TabularSection>).)*?<Name>" + КЗ.Ключ + "</Name>(?:(?!</TabularSection>).)*?</TabularSection>");
					ВнутрНазн = РвУд.Заменить(ВнутрНазн, СокрЛ(Ф));
					Сч = Сч + 1;
				КонецЕсли;
			Иначе
				Ф = ВырезатьТабличнуюЧасть(ЧБп, КЗ.Ключ, КЗ.Значение);
				Если Ф = "" Тогда
					Ф = ВырезатьТабличнуюЧасть(ЧБп, КЗ.Ключ, Новый Соответствие);
				КонецЕсли;
				Если Ф <> "" Тогда
					Доб = Доб + Ф;
					Сч = Сч + 1;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Тр.Свойство("dims") Тогда
		Для Каждого КЗ Из Тр.dims Цикл
			Если ЕстьВChildObjects(ВнутрНазн, "Dimension", КЗ.Значение) Тогда
				Продолжить;
			КонецЕсли;
			Ф = ВырезатьЭлементChildObjects(ЧБп, "Dimension", КЗ.Значение);
			Если Ф <> "" Тогда
				Доб = Доб + Ф;
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Тр.Свойство("res") Тогда
		Для Каждого КЗ Из Тр.res Цикл
			Если ЕстьВChildObjects(ВнутрНазн, "Resource", КЗ.Значение) Тогда
				Продолжить;
			КонецЕсли;
			Ф = ВырезатьЭлементChildObjects(ЧБп, "Resource", КЗ.Значение);
			Если Ф <> "" Тогда
				Доб = Доб + Ф;
				Сч = Сч + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Доб = "" Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	НовыйВнутр = ВнутрНазн + Доб;
	ТекНазн = ЗаменитьChildObjectsКорняОбъекта(ТекНазн, Тег, НовыйВнутр);
	ПолучитьДвоичныеДанныеИзСтроки(ТекНазн, КодировкаТекста.UTF8, Истина).Записать(Назн);
	Лог.Добавить("frag: " + Тег + "." + Имя + " +" + Сч);
	Возврат Новый Структура("stubs, parts", 0, Сч);
КонецФункции

Функция ОбеспечитьПеречисленияCfg(Корень, КореньБп, ПутьКонф, Осн, Префиксы, Лог)
	Рв = Новый РегулярноеВыражение("cfg:EnumRef\.([^\s<>""]+)");
	Нужны = Новый Соответствие;
	Для Каждого КЗ Из Префиксы Цикл
		Ч = СтрРазделить(КЗ.Ключ, ".");
		Если Ч.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Пап = ПапкиМетаданных().Получить(Ч[0]);
		Если Пап = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Путь = ОбъединитьПути(Корень, Пап, Ч[1] + ".xml");
		Если Не (Новый Файл(Путь)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Т = ВозвратБп.ПрочитатьТекст(Путь);
		Если Т = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
			Нужны.Вставить(С.Группы[1].Значение, Истина);
		КонецЦикла;
	КонецЦикла;
	Доб = 0;
	Для Каждого КЗ Из Нужны Цикл
		Имя = КЗ.Ключ;
		Если ВозвратБп.ИменаТега(Осн, "Enum").Получить(НРег(Имя)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Исх = ОбъединитьПути(КореньБп, "Enums", Имя + ".xml");
		Если Не (Новый Файл(Исх)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Назн = ОбъединитьПути(Корень, "Enums", Имя + ".xml");
		СоздатьКаталог(ОбъединитьПути(Корень, "Enums"));
		КопироватьФайл(Исх, Назн);
		ДобавитьВКонфигурацию(ПутьКонф, "Enum", Имя, Осн);
		Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
		Префиксы.Вставить("Enum." + Имя, Истина);
		Лог.Добавить("enum: " + Имя);
		Доб = Доб + 1;
	КонецЦикла;
	Возврат Доб;
КонецФункции

Функция ПрефиксИзПутиМета(Путь)
	Ч = СтрРазделить(Путь, ".");
	Если Ч.Количество() < 2 Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Ч[0] + "." + Ч[1];
КонецФункции

Процедура ДобПрефикс(П, Путь)
	П.Вставить(ПрефиксИзПутиМета(СокрЛП(Путь)), Истина);
КонецПроцедуры

Функция ВернутьFormXmlИзБп(Корень, КореньБп) Экспорт
	Если ВозвратБп = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Зам = 0;
	Для Каждого Ф Из НайтиФайлы(Корень, "Form.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Ext\Form.xml") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(Корень) + 2);
		Исх = ОбъединитьПути(КореньБп, Отн);
		Если (Новый Файл(Исх)).Существует() Тогда
			СоздатьКаталог(Ф.Путь);
			КопироватьФайл(Исх, Ф.ПолноеИмя);
			Зам = Зам + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Зам;
КонецФункции

Функция ИзвлечьБлок(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<" + Имя + ">(.*?)</" + Имя + ">");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Группы[1].Значение;
КонецФункции

Функция ИзвлечьChildObjectsОбъекта(Текст, Тег) Экспорт
	РвКор = Новый РегулярноеВыражение("(?s)<" + Тег + "\s+uuid=""[^""]+"">(.*)</" + Тег + ">");
	Ск = РвКор.НайтиСовпадения(Текст);
	Если Ск.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Внутр = Ск[0].Группы[1].Значение;
	Проп = СтрНайти(Внутр, "</Properties>");
	Если Проп = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Внутр, Проп + СтрДлина("</Properties>"));
	Нач = СтрНайти(Хвост, "<ChildObjects");
	Если Нач = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Хвост, Нач);
	Если Лев(Хвост, 14) = "<ChildObjects/>" Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Хвост, 14) <> "<ChildObjects>" Тогда
		Возврат "";
	КонецЕсли;
	Глуб = 1;
	Для П = 15 По СтрДлина(Хвост) Цикл
		Кус = Сред(Хвост, П, 14);
		Если Кус = "<ChildObjects>" Тогда
			Глуб = Глуб + 1;
		ИначеЕсли Лев(Сред(Хвост, П, 15), 15) = "<ChildObjects/>" Тогда
			Глуб = Глуб + 1;
			Глуб = Глуб - 1;
		ИначеЕсли Лев(Сред(Хвост, П, 15), 15) = "</ChildObjects>" Тогда
			Глуб = Глуб - 1;
			Если Глуб = 0 Тогда
				Возврат Сред(Хвост, 15, П - 15);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция НайтиГраницыChildObjectsКорня(Текст, Тег)
	РвКор = Новый РегулярноеВыражение("(?s)<" + Тег + "\s+uuid=""[^""]+"">(.*)</" + Тег + ">");
	Ск = РвКор.НайтиСовпадения(Текст);
	Если Ск.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	СмещКор = Ск[0].Индекс;
	Внутр = Ск[0].Группы[1].Значение;
	Проп = СтрНайти(Внутр, "</Properties>");
	Если Проп = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Отн = Проп + СтрДлина("</Properties>");
	Хвост = Сред(Внутр, Отн);
	Нач = СтрНайти(Хвост, "<ChildObjects");
	Если Нач = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДлОткр = СтрДлина(Ск[0].Значение) - СтрДлина(Внутр) - СтрДлина("</" + Тег + ">");
	АбсНач = СмещКор + ДлОткр + Отн + Нач;
	Лок = Сред(Хвост, Нач);
	Если Лев(Лок, 14) = "<ChildObjects/>" Тогда
		Возврат Новый Структура("start, end", АбсНач, АбсНач + 14);
	КонецЕсли;
	Если Лев(Лок, 14) <> "<ChildObjects>" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Глуб = 1;
	Для П = 15 По СтрДлина(Лок) Цикл
		Кус = Сред(Лок, П, 14);
		Если Кус = "<ChildObjects>" Тогда
			Глуб = Глуб + 1;
		ИначеЕсли Лев(Сред(Лок, П, 15), 15) = "<ChildObjects/>" Тогда
			Глуб = Глуб + 1;
			Глуб = Глуб - 1;
		ИначеЕсли Лев(Сред(Лок, П, 15), 15) = "</ChildObjects>" Тогда
			Глуб = Глуб - 1;
			Если Глуб = 0 Тогда
				Возврат Новый Структура("start, end", АбсНач, АбсНач + П + 14);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЗаменитьChildObjectsКорняОбъекта(Текст, Тег, ВнутрБезТегов) Экспорт
	Гр = НайтиГраницыChildObjectsКорня(Текст, Тег);
	Если Гр = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Пока СтрДлина(ВнутрБезТегов) > 0 И Лев(СокрЛ(ВнутрБезТегов), 1) = ">" Цикл
		ВнутрБезТегов = СокрЛП(Сред(СокрЛ(ВнутрБезТегов), 2));
	КонецЦикла;
	ВнутрБезТегов = СокрЛП(ВнутрБезТегов);
	Если ВнутрБезТегов = "" Тогда
		НовыйБлок = "		<ChildObjects/>";
	Иначе
		НовыйБлок = "		<ChildObjects>" + ВнутрБезТегов + Символы.ПС + "		</ChildObjects>";
	КонецЕсли;
	Возврат Лев(Текст, Гр.start - 1) + НовыйБлок + Сред(Текст, Гр.end);
КонецФункции

Функция ЗаготовкаРегистраИзмерение()
	Возврат Символы.ПС + "		<Dimension uuid=""00000000-0000-0000-0000-000000000001"">" + Символы.ПС
		+ "			<Properties>" + Символы.ПС + "				<Name>ЗаглКлюч</Name>" + Символы.ПС
		+ "				<Type><v8:Type>xs:string</v8:Type><v8:StringQualifiers><v8:Length>10</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers></Type>" + Символы.ПС
		+ "			</Properties>" + Символы.ПС + "		</Dimension>";
КонецФункции

Функция ЗаготовкаРегистраРесурс()
	Возврат Символы.ПС + "		<Resource uuid=""00000000-0000-0000-0000-000000000002"">" + Символы.ПС
		+ "			<Properties>" + Символы.ПС + "				<Name>ЗаглРесурс</Name>" + Символы.ПС
		+ "				<Type><v8:Type>xs:decimal</v8:Type><v8:NumberQualifiers><v8:Digits>10</v8:Digits><v8:FractionDigits>2</v8:FractionDigits><v8:AllowedSign>Any</v8:AllowedSign></v8:NumberQualifiers></Type>" + Символы.ПС
		+ "			</Properties>" + Символы.ПС + "		</Resource>";
КонецФункции

Функция ТегСChildObjects(Тег)
	Для Каждого ТегКо Из СтрРазделить("Catalog,Document,Enum,Report,DataProcessor,InformationRegister,AccumulationRegister,"
		+ "ChartOfAccounts,DocumentJournal,ChartOfCharacteristicTypes,ChartOfCalculationTypes,Task,AccountingRegister,CommonForm,FilterCriterion", ",") Цикл
		Если Тег = ТегКо Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция UuidИзФайлаМетаданных(Путь)
	Т = ВозвратБп.ПрочитатьТекст(Путь);
	Если Т = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("\s+uuid=""([^""]+)""");
	С = Рв.НайтиСовпадения(Т);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Группы[1].Значение;
КонецФункции

Функция ИмяВУпПоUuid(КореньУп, Пап, Uuid, ИмяБп)
	Если КореньУп = "" Или Uuid = "" Тогда
		Возврат "";
	КонецЕсли;
	Кат = ОбъединитьПути(КореньУп, Пап);
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Кат, "*.xml", Ложь) Цикл
		Если НРег(Ф.Имя) = НРег(ИмяБп + ".xml") Тогда
			Продолжить;
		КонецЕсли;
		Если UuidИзФайлаМетаданных(Ф.ПолноеИмя) = Uuid Тогда
			Возврат Лев(Ф.Имя, СтрДлина(Ф.Имя) - 4);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ChildObjectsЗаготовки(Тег, ИсхТекст, ИмяПер, ЗначПер)
	Если Не ТегСChildObjects(Тег) Тогда
		Возврат "";
	КонецЕсли;
	Если Тег = "Enum" Тогда
		Ч = ИзвлечьБлок(ИсхТекст, "ChildObjects");
		Если Ч = "" Тогда
			Возврат "		<ChildObjects/>";
		КонецЕсли;
		Нужн = ЗначПер.Получить(НРег(ИмяПер));
		Если Нужн = Неопределено Или Нужн.Количество() = 0 Тогда
			Рв = Новый РегулярноеВыражение("(?s)<EnumValue\s+uuid=""[^""]+"">.*?</EnumValue>");
			Все = Рв.НайтиСовпадения(Ч);
			Блок = "";
			Для Каждого С Из Все Цикл
				Блок = Блок + Символы.ПС + "		" + С.Значение;
			КонецЦикла;
			Если Блок = "" Тогда
				Возврат "		<ChildObjects/>";
			КонецЕсли;
			Возврат "		<ChildObjects>" + Блок + Символы.ПС + "		</ChildObjects>";
		КонецЕсли;
		Рв = Новый РегулярноеВыражение("(?s)<EnumValue\s+uuid=""([^""]+)"">(.*?)</EnumValue>");
		Блок = "";
		Для Каждого С Из Рв.НайтиСовпадения(Ч) Цикл
			РвИм = Новый РегулярноеВыражение("<Name>([^<]+)</Name>");
			Им = РвИм.НайтиСовпадения(С.Группы[2].Значение);
			Если Им.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Если Нужн.Получить(НРег(Им[0].Группы[1].Значение)) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Блок = Блок + Символы.ПС + "		<EnumValue uuid=""" + С.Группы[1].Значение + """>" + С.Группы[2].Значение + Символы.ПС + "		</EnumValue>";
		КонецЦикла;
		Если Блок = "" Тогда
			Возврат "		<ChildObjects/>";
		КонецЕсли;
		Возврат "		<ChildObjects>" + Блок + Символы.ПС + "		</ChildObjects>";
	КонецЕсли;
	Если Тег = "InformationRegister" Тогда
		Возврат "		<ChildObjects>" + ЗаготовкаРегистраИзмерение() + Символы.ПС + "		</ChildObjects>";
	КонецЕсли;
	Если Тег = "AccumulationRegister" Тогда
		Возврат "		<ChildObjects>" + ЗаготовкаРегистраИзмерение() + ЗаготовкаРегистраРесурс() + Символы.ПС + "		</ChildObjects>";
	КонецЕсли;
	Возврат "		<ChildObjects/>";
КонецФункции

Функция ПостроитьЗаготовку(ПутьИсх, Тег, ИмяПер, ЗначПер, Треб = Неопределено) Экспорт
	Исх = ВозвратБп.ПрочитатьТекст(ПутьИсх);
	Если Исх = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	РвКор = Новый РегулярноеВыражение("(?s)<" + Тег + "\s+uuid=""([^""]+)"">");
	К = РвКор.НайтиСовпадения(Исх);
	Если К.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Uuid = К[0].Группы[1].Значение;
	Внутр = ИзвлечьБлок(Исх, "InternalInfo");
	Свойства = ОчиститьСвойства(ИзвлечьБлок(Исх, "Properties"));
	Если Треб = Неопределено Тогда
		Доч = ChildObjectsЗаготовки(Тег, Исх, ИмяПер, ЗначПер);
		Части = 0;
	Иначе
		Р = ChildObjectsИзТребований(Тег, Исх, Треб, ИмяПер, ЗначПер);
		Доч = Р.xml;
		Части = Р.parts;
	КонецЕсли;
	Дочерние = Доч;
	НМд = СтрНайти(Исх, "<MetaDataObject");
	Пре = ?(НМд > 0, Лев(Исх, НМд - 1) + Сред(Исх, НМд, СтрНайти(Исх, ">", , НМд) - НМд + 1) + Символы.ПС, "<?xml version=""1.0"" encoding=""UTF-8""?>" + Символы.ПС + "<MetaDataObject version=""2.21"">" + Символы.ПС);
	Текст = Пре + "	<" + Тег + " uuid=""" + Uuid + """>" + Символы.ПС
		+ "		<InternalInfo>" + Внутр + Символы.ПС + "		</InternalInfo>" + Символы.ПС
		+ "		<Properties>" + Свойства + Символы.ПС + "		</Properties>" + Символы.ПС
		+ Дочерние + Символы.ПС + "	</" + Тег + ">" + Символы.ПС + "</MetaDataObject>";
	Возврат Новый Структура("text, parts", Текст, ?(Треб = Неопределено, 0, Части));
КонецФункции

// Полная копия из БП (картинки, язык и т.д.). DefinedType — отдельно, из УП (см. ПолныйВозвратDefinedType).
Функция ПолныйВозвратТег(Тег) Экспорт
	Для Каждого Т Из СтрРазделить("CommonPicture,StyleItem,Style,CommonTemplate,FilterCriterion,Language,CommandGroup,CommonCommand", ",") Цикл
		Если Тег = Т Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПолныйВозвратDefinedType(Тег) Экспорт
	Возврат Тег = "DefinedType";
КонецФункции

// Источник полной копии DefinedType: УП, при отсутствии — БП. Структура(корень, исх, имяКаталога).
Функция ИсточникПолногоВозврата(КореньБп, КореньУп, Пап, Имя)
	ПБ = ОбъединитьПути(КореньБп, Пап, Имя + ".xml");
	Если КореньУп <> "" Тогда
		ПУ = ОбъединитьПути(КореньУп, Пап, Имя + ".xml");
		Если (Новый Файл(ПУ)).Существует() Тогда
			Возврат Новый Структура("корень, исх, имяКаталога", КореньУп, ПУ, Имя);
		КонецЕсли;
		Если (Новый Файл(ПБ)).Существует() Тогда
			ИмяУп = ИмяВУпПоUuid(КореньУп, Пап, UuidИзФайлаМетаданных(ПБ), Имя);
			Если ИмяУп <> "" Тогда
				ПУ2 = ОбъединитьПути(КореньУп, Пап, ИмяУп + ".xml");
				Если (Новый Файл(ПУ2)).Существует() Тогда
					Возврат Новый Структура("корень, исх, имяКаталога", КореньУп, ПУ2, ИмяУп);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Если (Новый Файл(ПБ)).Существует() Тогда
		Возврат Новый Структура("корень, исх, имяКаталога", КореньБп, ПБ, Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура ДобавитьСоставМетаданныхВОбъекты(ПутьТипа, Объекты, Состав, КореньУп, Корень) Экспорт
	Т = ВозвратБп.ПрочитатьТекст(ПутьТипа);
	Если Т = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
	Для Каждого С Из Рв.НайтиСовпадения(Т) Цикл
		Р = РазборCfg(С.Группы[1].Значение);
		Если Р <> Неопределено И Р.Режим = "Объект" Тогда
			ДобОбъектПоТегу(Объекты, Р.Тег, Р.Имя, Состав, КореньУп, Ложь, Корень);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьИзКонфигурации(ПутьКонф, Тег, Имя)
	Если Не (Новый Файл(ПутьКонф)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Дв = Новый ДвоичныеДанные(ПутьКонф);
	Т = ПолучитьСтрокуИзДвоичныхДанных(Дв, "UTF-8");
	БОМ = СтрДлина(Т) > 0 И КодСимвола(Т, 1) = 65279;
	Если БОМ Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	ПС = ?(СтрНайти(Т, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Стр = Символы.Таб + Символы.Таб + Символы.Таб + "<" + Тег + ">" + Имя + "</" + Тег + ">" + ПС;
	Т = СтрЗаменить(Т, Стр, "");
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, БОМ).Записать(ПутьКонф);
КонецПроцедуры

// Состав типа из УП, имя и GeneratedType — как в ссылках БП (форма cfg:DefinedType.ИмяБп).
Процедура ПривестиDefinedTypeКИмени(ПутьФайла, ИмяЦель, ИмяИсх)
	Т = ВозвратБп.ПрочитатьТекст(ПутьФайла);
	Если Т = Неопределено Или ИмяЦель = "" Или ИмяИсх = "" Или НРег(ИмяЦель) = НРег(ИмяИсх) Тогда
		Возврат;
	КонецЕсли;
	Т = СтрЗаменить(Т, "DefinedType." + ИмяИсх, "DefinedType." + ИмяЦель);
	Т = СтрЗаменить(Т, "<Name>" + ИмяИсх + "</Name>", "<Name>" + ИмяЦель + "</Name>");
	БОМ = СтрДлина(Т) > 0 И КодСимвола(Т, 1) = 65279;
	Если БОМ Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, Ложь).Записать(ПутьФайла);
КонецПроцедуры

Процедура ЗаменитьПсевдонимDefinedTypeВМетаданных(Корень, ИмяБп, ИмяУп) Экспорт
	Если ИмяУп = "" Или НРег(ИмяБп) = НРег(ИмяУп) Тогда
		Возврат;
	КонецЕсли;
	От = "DefinedType." + ИмяУп;
	До = "DefinedType." + ИмяБп;
	Для Каждого Ф Из НайтиФайлы(Корень, "*.xml", Истина) Цикл
		Если СтрНайти(Ф.ПолноеИмя, "\Forms\") > 0 И Ф.Имя = "Form.xml" Тогда
			Продолжить;
		КонецЕсли;
		Т = ВозвратБп.ПрочитатьТекст(Ф.ПолноеИмя);
		Если Т = Неопределено Или СтрНайти(Т, От) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Т = СтрЗаменить(Т, От, До);
		ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, Ложь).Записать(Ф.ПолноеИмя);
	КонецЦикла;
КонецПроцедуры

Процедура УстранитьПсевдонимDefinedType(Корень, Пап, ИмяЦель, ИмяИсх)
	Если ИмяИсх = "" Или НРег(ИмяЦель) = НРег(ИмяИсх) Тогда
		Возврат;
	КонецЕсли;
	ЗаменитьПсевдонимDefinedTypeВМетаданных(Корень, ИмяЦель, ИмяИсх);
	ПутьДубл = ОбъединитьПути(Корень, Пап, ИмяИсх + ".xml");
	Если (Новый Файл(ПутьДубл)).Существует() Тогда
		УдалитьФайлы(ПутьДубл);
	КонецЕсли;
	УдалитьИзКонфигурации(ОбъединитьПути(Корень, "Configuration.xml"), "DefinedType", ИмяИсх);
КонецПроцедуры

Процедура КопироватьПолныйОбъект(Корень, Источник, Пап, ИмяНазн, БезФорм = Ложь) Экспорт
	КатНазн = ОбъединитьПути(Корень, Пап);
	СоздатьКаталог(КатНазн);
	Назн = ОбъединитьПути(КатНазн, ИмяНазн + ".xml");
	КопироватьФайл(Источник.исх, Назн);
	КатИсх = ОбъединитьПути(Источник.корень, Пап, Источник.имяКаталога);
	Если (Новый Файл(КатИсх)).Существует() Тогда
		КатНазн = ОбъединитьПути(Корень, Пап, ИмяНазн);
		Если БезФорм Тогда
			Для Каждого Ф Из НайтиФайлы(КатИсх, "*", Ложь) Цикл
				Если Ф.ЭтоКаталог() И НРег(Ф.Имя) = "forms" Тогда
					Продолжить;
				КонецЕсли;
				Если Ф.ЭтоКаталог() Тогда
					КопироватьКаталогРек(Ф.ПолноеИмя, ОбъединитьПути(КатНазн, Ф.Имя));
				Иначе
					КопироватьФайл(Ф.ПолноеИмя, ОбъединитьПути(КатНазн, Ф.Имя));
				КонецЕсли;
			КонецЦикла;
		Иначе
			КопироватьКаталогРек(КатИсх, КатНазн);
		КонецЕсли;
	КонецЕсли;
	Если Пап = "DefinedTypes" И Источник.имяКаталога <> "" И НРег(Источник.имяКаталога) <> НРег(ИмяНазн) Тогда
		ПривестиDefinedTypeКИмени(Назн, ИмяНазн, Источник.имяКаталога);
		УстранитьПсевдонимDefinedType(Корень, Пап, ИмяНазн, Источник.имяКаталога);
	КонецЕсли;
КонецПроцедуры

Функция ВыполнитьПолныйВозвратМетаданных(Корень, КореньБп, КореньУп, Пап, Тег, Имя, Осн, Объекты, Лог, БезФорм = Истина) Экспорт
	Ист = ИсточникПолногоВозврата(КореньБп, КореньУп, Пап, Имя);
	Если Ист = Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	КопироватьПолныйОбъект(Корень, Ист, Пап, Имя, БезФорм);
	ПутьМд = ОбъединитьПути(Корень, Пап, Имя + ".xml");
	Если Объекты <> Неопределено Тогда
		ДобавитьСоставМетаданныхВОбъекты(ПутьМд, Объекты, Осн, КореньУп, Корень);
	КонецЕсли;
	Если ВозвратБп.ИменаТега(Осн, Тег).Получить(НРег(Имя)) = Неопределено Тогда
		ДобавитьВКонфигурацию(ПутьКонф, Тег, Имя, Осн);
	КонецЕсли;
	Лог.Добавить("full: " + Тег + "." + Имя + ?(Ист.корень = КореньУп, " (УП)", " (БП)"));
	Возврат 1;
КонецФункции

// ConfigDumpInfo, Languages, Ext — из выгрузки УП, если каркас restored обрезан.
Процедура ОбеспечитьКаркасRestored(Корень, КореньУп, Лог) Экспорт
	Если КореньУп = "" Тогда
		Возврат;
	КонецЕсли;
	ПутьDump = ОбъединитьПути(Корень, "ConfigDumpInfo.xml");
	Если Не (Новый Файл(ПутьDump)).Существует() Тогда
		ПУ = ОбъединитьПути(КореньУп, "ConfigDumpInfo.xml");
		Если (Новый Файл(ПУ)).Существует() Тогда
			КопироватьФайл(ПУ, ПутьDump);
			Лог.Добавить("restored: восстановлен ConfigDumpInfo.xml из УП");
		КонецЕсли;
	КонецЕсли;
	КатЯз = ОбъединитьПути(Корень, "Languages");
	Если Не (Новый Файл(КатЯз)).Существует() Тогда
		КатЯзУп = ОбъединитьПути(КореньУп, "Languages");
		Если (Новый Файл(КатЯзУп)).Существует() Тогда
			КопироватьКаталогРек(КатЯзУп, КатЯз);
			Лог.Добавить("restored: восстановлена папка Languages из УП");
		КонецЕсли;
	КонецЕсли;
	КатExt = ОбъединитьПути(Корень, "Ext");
	Если Не (Новый Файл(КатExt)).Существует() Тогда
		КатExtУп = ОбъединитьПути(КореньУп, "Ext");
		Если (Новый Файл(КатExtУп)).Существует() Тогда
			КопироватьКаталогРек(КатExtУп, КатExt);
			Лог.Добавить("restored: восстановлена папка Ext из УП");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьПодкаталогОбъекта(Корень, Пап, Имя)
	Кат = ОбъединитьПути(Корень, Пап, Имя);
	Если (Новый Файл(Кат)).Существует() Тогда
		УдалитьФайлы(Кат);
	КонецЕсли;
КонецПроцедуры

Процедура КопироватьКаталогРекСохранитьExtForm(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Ложь) Цикл
		Назн = ОбъединитьПути(Куда, Ф.Имя);
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталогРекСохранитьExtForm(Ф.ПолноеИмя, Назн);
		Иначе
			Если НРег(Ф.Имя) = "form.xml" И (СтрНайти(НРег(Ф.ПолноеИмя), "\ext\form.xml") > 0 Или СтрНайти(НРег(Ф.ПолноеИмя), "/ext/form.xml") > 0) Тогда
				Если (Новый Файл(Назн)).Существует() Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			СоздатьКаталог((Новый Файл(Назн)).Путь);
			КопироватьФайл(Ф.ПолноеИмя, Назн);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура КопироватьКаталогРек(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Ложь) Цикл
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталогРек(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		Иначе
			КопироватьФайл(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьИзСписка(Объекты, ПутьСписка, Состав, КореньУп)
	Если ПутьСписка = "" Или Не (Новый Файл(ПутьСписка)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Т = ВозвратБп.ПрочитатьТекст(ПутьСписка);
	Если Т = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Флаг = Ложь;
	Рв = Новый РегулярноеВыражение("^([A-Za-zА-Яа-яЁё0-9_]+)\.([^\s]+)\s+");
	Для Каждого Стр Из СтрРазделить(Т, Символы.ПС) Цикл
		Если СтрНайти(Стр, "Прямые ссылки из форм") > 0 Тогда
			Флаг = Истина;
			Продолжить;
		КонецЕсли;
		Если Флаг И СтрНачинаетсяС(Стр, "===") Тогда
			Прервать;
		КонецЕсли;
		Если Не Флаг Тогда
			Продолжить;
		КонецЕсли;
		С = Рв.НайтиСовпадения(Стр);
		Если С.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДобОбъектПоТегу(Объекты, С[0].Группы[1].Значение, С[0].Группы[2].Значение, Состав, КореньУп, Истина, "");
	КонецЦикла;
КонецПроцедуры

Функция ЭтоПустаяЗаготовка(Путь) Экспорт
	Т = ВозвратБп.ПрочитатьТекст(Путь);
	Если Т = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если СтрНайти(Т, "<ChildObjects/>") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("(?s)<ChildObjects>\s*</ChildObjects>");
	Если Рв.НайтиСовпадения(Т).Количество() > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ЗаписатьЗаготовкуОбъекта(Корень, КореньБп, Пап, Р, Треб, ЗначПер, Лог)
	Исх = ОбъединитьПути(КореньБп, Пап, Р.Имя + ".xml");
	Если Не (Новый Файл(Исх)).Существует() Тогда
		Лог.Добавить("stub: нет в БП " + Р.Тег + "." + Р.Имя);
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	Ключ = Р.Тег + "|" + Р.Имя;
	Тр = Треб.Получить(Ключ);
	Пз = ПостроитьЗаготовку(Исх, Р.Тег, Р.Имя, ЗначПер, Тр);
	Если Пз.text = "" Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	КатНазн = ОбъединитьПути(Корень, Пап);
	СоздатьКаталог(КатНазн);
	Назн = ОбъединитьПути(КатНазн, Р.Имя + ".xml");
	ПолучитьДвоичныеДанныеИзСтроки(Пз.text, КодировкаТекста.UTF8, Истина).Записать(Назн);
	УдалитьПодкаталогОбъекта(Корень, Пап, Р.Имя);
	Если Тр <> Неопределено Тогда
		Для Каждого Фр Из Тр.forms Цикл
			КопироватьФормуБезМодулей(КореньБп, Корень, Пап, Р.Имя, Фр.Значение);
		КонецЦикла;
		Для Каждого Ш Из Тр.templates Цикл
			КопироватьШаблонБезМодулей(КореньБп, Корень, Пап, Р.Имя, Ш.Значение);
		КонецЦикла;
	КонецЕсли;
	Лог.Добавить("stub: " + Р.Тег + "." + Р.Имя);
	Возврат Новый Структура("stubs, parts", 1, Пз.parts);
КонецФункции

Процедура ДобИмяИзСтроки(Треб, Состав, КореньУп, Объекты, Стр)
	Стр = СокрЛП(Стр);
	Если Стр = "" Или СтрНачинаетсяС(Стр, "#") Тогда
		Возврат;
	КонецЕсли;
	РвОб = Новый РегулярноеВыражение("^(Catalog|Document|Task|InformationRegister|AccumulationRegister|ChartOfAccounts|ChartOfCharacteristicTypes|ChartOfCalculationTypes|DocumentJournal|DataProcessor|Report|Enum)\.([\wЁёА-Яа-яA-Za-z0-9_]+)");
	Со = РвОб.НайтиСовпадения(Стр);
	Если Со.Количество() > 0 Тогда
		ДобОбъектПоТегу(Объекты, Со[0].Группы[1].Значение, Со[0].Группы[2].Значение, Состав, КореньУп, Истина);
		// Полный каталог — только для предопределённых / полей из лога, не для cfg:CatalogRef из форм.
		Если Со[0].Группы[1].Значение = "Catalog"
			И (СтрНайти(Стр, ".EmptyRef") > 0 Или СтрНайти(Стр, ".Attribute.") > 0 Или СтрНайти(Стр, ".TabularSection.") > 0) Тогда
			ТребованиеОбъекта(Треб, "Catalog", Со[0].Группы[2].Значение).fullMeta = Истина;
		КонецЕсли;
	КонецЕсли;
	РвПр = Новый РегулярноеВыражение("^(DefinedType|CommandGroup|CommonPicture|CommonCommand|StyleItem|Enum)\.([\wЁёА-Яа-яA-Za-z0-9_]+)$");
	Сп = РвПр.НайтиСовпадения(Стр);
	Если Сп.Количество() > 0 Тогда
		ДобОбъектПоТегу(Объекты, Сп[0].Группы[1].Значение, Сп[0].Группы[2].Значение, Состав, КореньУп, Истина);
	КонецЕсли;
	Кор = КорневойОбъектИзПутиЛога(Стр);
	Если Кор <> Неопределено И ПутьЛогаТребуетПолногоМетаданных(Стр) Тогда
		ДобОбъектПоТегу(Объекты, Кор.tag, Кор.name, Состав, КореньУп, Истина);
		Тр = ТребованиеОбъекта(Треб, Кор.tag, Кор.name);
		Тр.fullMeta = Истина;
	КонецЕсли;
	ДобПутьМетаданных(Треб, Объекты, Состав, КореньУп, Стр, Ложь);
КонецПроцедуры

Функция ДополнитьЗаготовки(Корень, КореньБп, Лог, КореньУп = "", ПутьДогрузки = "", ТолькоПоЛогу = Ложь) Экспорт
	Если ВозвратБп = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Папки = ПапкиМетаданных();
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
	ПустыеОбъекты = Новый Соответствие;
	Если ТолькоПоЛогу Тогда
		Треб = Новый Соответствие;
	Иначе
		Треб = СобратьТребованияПоКорню(Корень, ПустыеОбъекты, Осн, КореньУп);
	КонецЕсли;
	Если Не ТолькоПоЛогу Тогда
	Для Каждого Им Из СтрРазделить("Document.Встреча,Document.ТелефонныйЗвонок,Document.ЭлектронноеПисьмоВходящее,"
		+ "Document.ЭлектронноеПисьмоИсходящее,Document.ЗапланированноеВзаимодействие,Document.СообщениеSMS,"
		+ "Document.ПрочееВзаимодействие,DocumentJournal.Взаимодействия,"
		+ "DocumentJournal.Взаимодействия.Form.ФормаСпискаБП,"
		+ "Catalog.УбыткиПрошлыхЛет.Attribute.ГодУбытка,Catalog.РассылкиОтчетов.Attribute.ТипПолучателейРассылки,"
		+ "Catalog.НастройкиПодключенияКСистемеБыстрыхПлатежей.Attribute.УдалитьИдентификатор,"
		+ "Catalog.НастройкиПодключенияКСистемеБыстрыхПлатежей.Attribute.УдалитьПлатежнаяСистема,"
		+ "Document.ОперацияСБилетом.Attribute.Организация", ",") Цикл
		ДобИмяИзСтроки(Треб, Осн, КореньУп, ПустыеОбъекты, Им);
	КонецЦикла;
	КонецЕсли;
	Если ПутьДогрузки <> "" И (Новый Файл(ПутьДогрузки)).Существует() Тогда
		ТД = ВозвратБп.ПрочитатьТекст(ПутьДогрузки);
		Если ТД <> Неопределено Тогда
			Для Каждого Стр Из СтрРазделить(ТД, Символы.ПС) Цикл
				ДобИмяИзСтроки(Треб, Осн, КореньУп, ПустыеОбъекты, Стр);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Заготовки = 0;
	Фрагм = 0;
	ЗнПер = Новый Соответствие;
	Обработанные = Новый Соответствие;
	Для Каждого КЗ Из Треб Цикл
		Обработанные.Вставить(КЗ.Ключ, Истина);
		Ч = СтрРазделить(КЗ.Ключ, "|");
		Если Ч.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Зз = ПопыткаДополнитьОбъект(Корень, КореньБп, КореньУп, Папки, Ч[0], Ч[1], Треб, ЗнПер, Лог);
		Заготовки = Заготовки + Зз.stubs;
		Фрагм = Фрагм + Зз.parts;
	КонецЦикла;
	Если ТолькоПоЛогу Тогда
		Для Каждого КЗ Из ПустыеОбъекты Цикл
			Если Обработанные.Получить(КЗ.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Обработанные.Вставить(КЗ.Ключ, Истина);
			Ч = СтрРазделить(КЗ.Ключ, "|");
			Если Ч.Количество() < 2 Тогда
				Продолжить;
			КонецЕсли;
			Зз = ПопыткаДополнитьОбъект(Корень, КореньБп, КореньУп, Папки, Ч[0], Ч[1], Треб, ЗнПер, Лог);
			Заготовки = Заготовки + Зз.stubs;
			Фрагм = Фрагм + Зз.parts;
		КонецЦикла;
	КонецЕсли;
	Если ПутьДогрузки = "" И Не ТолькоПоЛогу Тогда
	Для Каждого ПапИмя Из СтрРазделить("Catalogs,Documents,DocumentJournals,DataProcessors,Reports", ",") Цикл
		Кат = ОбъединитьПути(Корень, ПапИмя);
		Если Не (Новый Файл(Кат)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Тег = ?(ПапИмя = "Catalogs", "Catalog", ?(ПапИмя = "Documents", "Document", ?(ПапИмя = "DocumentJournals", "DocumentJournal", ?(ПапИмя = "DataProcessors", "DataProcessor", "Report"))));
		Для Каждого Ф Из НайтиФайлы(Кат, "*.xml", Ложь) Цикл
			Имя = Лев(Ф.Имя, СтрДлина(Ф.Имя) - 4);
			Ключ = Тег + "|" + Имя;
			Если Обработанные.Получить(Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если Не ЭтоПустаяЗаготовка(Ф.ПолноеИмя) Тогда
				Продолжить;
			КонецЕсли;
			Зз = ПопыткаДополнитьОбъект(Корень, КореньБп, КореньУп, Папки, Тег, Имя, Треб, ЗнПер, Лог);
			Заготовки = Заготовки + Зз.stubs;
			Фрагм = Фрагм + Зз.parts;
		КонецЦикла;
	КонецЦикла;
	КонецЕсли;
	Преф = Новый Соответствие;
	Если Не ТолькоПоЛогу Тогда
	Для Каждого Им Из СтрРазделить("Document.Встреча,Document.ТелефонныйЗвонок,Document.ЭлектронноеПисьмоВходящее,"
		+ "Document.ЭлектронноеПисьмоИсходящее,Document.ЗапланированноеВзаимодействие,Document.СообщениеSMS,"
		+ "Document.ПрочееВзаимодействие,DocumentJournal.Взаимодействия,"
		+ "Catalog.УбыткиПрошлыхЛет,Catalog.РассылкиОтчетов,Catalog.НастройкиПодключенияКСистемеБыстрыхПлатежей,"
		+ "Document.ОперацияСБилетом", ",") Цикл
		ДобПрефикс(Преф, Им);
	КонецЦикла;
	КонецЕсли;
	Если ПутьДогрузки <> "" И (Новый Файл(ПутьДогрузки)).Существует() Тогда
		ТД = ВозвратБп.ПрочитатьТекст(ПутьДогрузки);
		Если ТД <> Неопределено Тогда
			Для Каждого Стр Из СтрРазделить(ТД, Символы.ПС) Цикл
				ДобПрефикс(Преф, Стр);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	ОбеспечитьПеречисленияCfg(Корень, КореньБп, ПутьКонф, Осн, Преф, Лог);
	Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
	Если ConfigDump = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	ConfigDump.ДополнитьConfigDumpInfoИзБп(Корень, КореньБп, Преф, Лог);
	Лог.Добавить("дополнение: требований " + Треб.Количество() + ", заготовок " + Заготовки + ", фрагментов " + Фрагм + ?(ТолькоПоЛогу, " (только лог)", ""));
	Возврат Новый Структура("stubs, fragments, requirements", Заготовки, Фрагм, Треб.Количество());
КонецФункции

Функция ДополнитьЗаготовкиТолькоПоЛогу(Корень, КореньБп, КореньУп, ПутьЛога, Лог) Экспорт
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "РазборЛогаИмпорта.os"));
	Пути = Разбор.ПутиНеизвестныхМетаданных(ПутьЛога);
	Если Пути.Количество() = 0 Тогда
		Возврат Новый Структура("stubs, fragments, requirements, paths, dogruzka", 0, 0, 0, 0, "");
	КонецЕсли;
	ФайлСписка = ОбъединитьПути(Корень, "import_dogruzka_fast.txt");
	Разбор.ЗаписатьСписокДогрузки(Пути, ФайлСписка);
	Р = ДополнитьЗаготовки(Корень, КореньБп, Лог, КореньУп, ФайлСписка, Истина);
	Р.Вставить("paths", Пути.Количество());
	Р.Вставить("dogruzka", ФайлСписка);
	Р.Вставить("stats", Разбор.СтатистикаПутей(Пути));
	Возврат Р;
КонецФункции

Функция ПопыткаДополнитьОбъект(Корень, КореньБп, КореньУп, Папки, Тег, Имя, Треб, ЗнПер, Лог)
	Пап = Папки.Получить(Тег);
	Если Пап = Неопределено Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
	Если ТипЗнч(Треб) = Тип("Соответствие") Тогда
		Тр = Треб.Получить(Тег + "|" + Имя);
	Иначе
		Тр = Треб;
	КонецЕсли;
	Если ПолныйВозвратDefinedType(Тег) Или ПолныйВозвратТег(Тег) Тогда
		Исх = ОбъединитьПути(КореньБп, Пап, Имя + ".xml");
		Если ПолныйВозвратDefinedType(Тег) Тогда
			Ист = ИсточникПолногоВозврата(КореньБп, КореньУп, Пап, Имя);
			Если Ист <> Неопределено Тогда
				КопироватьПолныйОбъект(Корень, Ист, Пап, Имя);
				ДобавитьСоставМетаданныхВОбъекты(ОбъединитьПути(Корень, Пап, Имя + ".xml"), Новый Соответствие, Осн, КореньУп, Корень);
			КонецЕсли;
		Иначе
			Если Не (Новый Файл(Исх)).Существует() Тогда
				Возврат Новый Структура("stubs, parts", 0, 0);
			КонецЕсли;
			Назн = ОбъединитьПути(Корень, Пап, Имя + ".xml");
			КопироватьФайл(Исх, Назн);
			КатБп = ОбъединитьПути(КореньБп, Пап, Имя);
			Если (Новый Файл(КатБп)).Существует() Тогда
				КопироватьКаталогРек(КатБп, ОбъединитьПути(Корень, Пап, Имя));
			КонецЕсли;
		КонецЕсли;
		Если ВозвратБп.ИменаТега(Осн, Тег).Получить(НРег(Имя)) = Неопределено Тогда
			ДобавитьВКонфигурацию(ПутьКонф, Тег, Имя, Осн);
		КонецЕсли;
		Лог.Добавить("full: " + Тег + "." + Имя);
		Возврат Новый Структура("stubs, parts", 1, 0);
	ИначеЕсли НуженПолныйВозвратМетаданных(Тег, Тр) Тогда
		Н = ВыполнитьПолныйВозвратМетаданных(Корень, КореньБп, КореньУп, Пап, Тег, Имя, Осн, Новый Соответствие, Лог, Истина);
		Возврат Новый Структура("stubs, parts", Н, 0);
	КонецЕсли;
	Назн = ОбъединитьПути(Корень, Пап, Имя + ".xml");
	НовыйОбъект = Не (Новый Файл(Назн)).Существует();
	Если Не НовыйОбъект И Не ЭтоПустаяЗаготовка(Назн) Тогда
		Если НуженПолныйВозвратМетаданных(Тег, Тр) Тогда
			Н = ВыполнитьПолныйВозвратМетаданных(Корень, КореньБп, КореньУп, Пап, Тег, Имя, Осн, Новый Соответствие, Лог, Истина);
			Возврат Новый Структура("stubs, parts", Н, 0);
		КонецЕсли;
		Возврат ДополнитьФрагментамиОбъект(Корень, КореньБп, Пап, Тег, Имя, Треб, Лог);
	КонецЕсли;
	Исх = ОбъединитьПути(КореньБп, Пап, Имя + ".xml");
	Если Не (Новый Файл(Исх)).Существует() Тогда
		Возврат Новый Структура("stubs, parts", 0, 0);
	КонецЕсли;
	UuidБп = UuidИзФайлаМетаданных(Исх);
	ИмяУп = ИмяВУпПоUuid(КореньУп, Пап, UuidБп, Имя);
	Если ИмяУп <> "" Тогда
		ПутьУп = ОбъединитьПути(Корень, Пап, ИмяУп + ".xml");
		Если (Новый Файл(ПутьУп)).Существует() И Не ЭтоПустаяЗаготовка(ПутьУп) Тогда
			Возврат Новый Структура("stubs, parts", 0, 0);
		КонецЕсли;
	КонецЕсли;
	Р = Новый Структура("Тег, Имя", Тег, Имя);
	Зз = ЗаписатьЗаготовкуОбъекта(Корень, КореньБп, Пап, Р, Треб, ЗнПер, Лог);
	Если Зз.stubs > 0 И НовыйОбъект Тогда
		ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
		Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
		Если ВозвратБп.ИменаТега(Осн, Тег).Получить(НРег(Имя)) = Неопределено Тогда
			ДобавитьВКонфигурацию(ПутьКонф, Тег, Имя, Осн);
		КонецЕсли;
	КонецЕсли;
	Возврат Зз;
КонецФункции

Функция Применить(Корень, КореньБп, Лог, ПутьСписка = "", КореньУп = "") Экспорт
	Если ВозвратБп = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	Папки = ПапкиМетаданных();
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
	Собр = СобратьИзФорм(Корень, Осн, КореньУп);
	ДобавитьИзСписка(Собр.objects, ПутьСписка, Осн, КореньУп);
	Треб = СобратьТребованияПоКорню(Корень, Собр.objects, Осн, КореньУп);
	Лимит = 400;
	ЗамыканиеСтоп = Ложь;
	Если Собр.objects.Количество() > Лимит Тогда
		ЗамыканиеСтоп = Истина;
		Лог.Добавить("stub: замыкание остановлено, объектов " + Собр.objects.Количество());
	КонецЕсли;
	Заготовки = 0;
	Полные = 0;
	СтрокКонф = 0;
	Фрагм = 0;
	Для Каждого КЗ Из Собр.objects Цикл
		Р = КЗ.Значение;
		УжеВСоставе = ВозвратБп.ИменаТега(Осн, Р.Тег).Получить(НРег(Р.Имя)) <> Неопределено;
		Пап = Папки.Получить(Р.Тег);
		Если Пап = Неопределено Тогда
			Лог.Добавить("stub: неизвестный тег " + Р.Тег + "." + Р.Имя);
			Продолжить;
		КонецЕсли;
		Исх = ОбъединитьПути(КореньБп, Пап, Р.Имя + ".xml");
		ИстПр = ИсточникПолногоВозврата(КореньБп, КореньУп, Пап, Р.Имя);
		Если Не (Новый Файл(Исх)).Существует() И ИстПр = Неопределено Тогда
			Лог.Добавить("stub: нет в БП " + Р.Тег + "." + Р.Имя);
			Продолжить;
		КонецЕсли;
		UuidБп = UuidИзФайлаМетаданных(Исх);
		ИмяУп = ИмяВУпПоUuid(КореньУп, Пап, UuidБп, Р.Имя);
		Если ИмяУп <> "" Тогда
			ПутьУп = ОбъединитьПути(Корень, Пап, ИмяУп + ".xml");
			Если (Новый Файл(ПутьУп)).Существует() Тогда
				Лог.Добавить("stub: пропуск " + Р.Тег + "." + Р.Имя + " — в УП " + ИмяУп + " (uuid)");
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		КатНазн = ОбъединитьПути(Корень, Пап);
		СоздатьКаталог(КатНазн);
		Назн = ОбъединитьПути(КатНазн, Р.Имя + ".xml");
		Если ПолныйВозвратDefinedType(Р.Тег) Тогда
			Ист = ИсточникПолногоВозврата(КореньБп, КореньУп, Пап, Р.Имя);
			Если Ист <> Неопределено Тогда
				КопироватьПолныйОбъект(Корень, Ист, Пап, Р.Имя);
				ДобавитьСоставМетаданныхВОбъекты(ОбъединитьПути(Корень, Пап, Р.Имя + ".xml"), Собр.objects, Осн, КореньУп, Корень);
				Полные = Полные + 1;
			КонецЕсли;
		ИначеЕсли ПолныйВозвратМетаданныхУпБп(Р.Тег) Тогда
			Н = ВыполнитьПолныйВозвратМетаданных(Корень, КореньБп, КореньУп, Пап, Р.Тег, Р.Имя, Осн, Собр.objects, Лог, Истина);
			Полные = Полные + Н;
		ИначеЕсли ПолныйВозвратТег(Р.Тег) Тогда
			КопироватьФайл(Исх, Назн);
			КатБп = ОбъединитьПути(КореньБп, Пап, Р.Имя);
			Если (Новый Файл(КатБп)).Существует() Тогда
				КопироватьКаталогРек(КатБп, ОбъединитьПути(Корень, Пап, Р.Имя));
			КонецЕсли;
			Полные = Полные + 1;
		Иначе
			Зз = ЗаписатьЗаготовкуОбъекта(Корень, КореньБп, Пап, Р, Треб, Собр.enumValues, Лог);
			Заготовки = Заготовки + Зз.stubs;
			Фрагм = Фрагм + Зз.parts;
		КонецЕсли;
		Если Не УжеВСоставе Тогда
			СтрокКонф = СтрокКонф + ДобавитьВКонфигурацию(ПутьКонф, Р.Тег, Р.Имя, Осн);
			Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
		КонецЕсли;
		Лог.Добавить(?(ПолныйВозвратТег(Р.Тег) Или ПолныйВозвратDefinedType(Р.Тег), "full: ", "stub: ") + Р.Тег + "." + Р.Имя);
	КонецЦикла;
	Для Каждого КЗ Из Треб Цикл
		Ч = СтрРазделить(КЗ.Ключ, "|");
		Если Ч.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Тег = Ч[0];
		Имя = Ч[1];
		Пап = Папки.Получить(Тег);
		Если Пап = Неопределено Или ПолныйВозвратТег(Тег) Или ПолныйВозвратDefinedType(Тег) Тогда
			Продолжить;
		КонецЕсли;
		Назн = ОбъединитьПути(Корень, Пап, Имя + ".xml");
		Если Не (Новый Файл(Назн)).Существует() Или Не ЭтоПустаяЗаготовка(Назн) Тогда
			Продолжить;
		КонецЕсли;
		Р = Новый Структура("Тег, Имя", Тег, Имя);
		Зз = ЗаписатьЗаготовкуОбъекта(Корень, КореньБп, Пап, Р, Треб, Собр.enumValues, Лог);
		Заготовки = Заготовки + Зз.stubs;
		Фрагм = Фрагм + Зз.parts;
	КонецЦикла;
	ФормБп = ВернутьFormXmlИзБп(Корень, КореньБп);
	Преф = Новый Соответствие;
	Для Каждого КЗ Из Собр.objects Цикл
		Р = КЗ.Значение;
		Преф.Вставить(Р.Тег + "." + Р.Имя, Истина);
	КонецЦикла;
	ПутьКонф = ОбъединитьПути(Корень, "Configuration.xml");
	Осн = ВозвратБп.СоставКонфигурации(ПутьКонф);
	ОбеспечитьПеречисленияCfg(Корень, КореньБп, ПутьКонф, Осн, Преф, Лог);
	Если ConfigDump = Неопределено Тогда
		Инициализировать();
	КонецЕсли;
	ConfigDump.ДополнитьConfigDumpInfoИзБп(Корень, КореньБп, Преф, Лог);
	Возврат Новый Структура("stubs, full, configLines, fragments, closureStop, objects, formsBp", Заготовки, Полные, СтрокКонф, Фрагм, ЗамыканиеСтоп, Собр.objects.Количество(), ФормБп);
КонецФункции

Функция ДобавитьВКонфигурацию(ПутьКонф, Тег, Имя, Осн) Экспорт
	С = ВозвратБп.ИменаТега(Осн, Тег);
	Если С.Получить(НРег(Имя)) <> Неопределено Тогда
		Возврат 0;
	КонецЕсли;
	Если Не (Новый Файл(ПутьКонф)).Существует() Тогда
		Возврат 0;
	КонецЕсли;
	Дв = Новый ДвоичныеДанные(ПутьКонф);
	Т = ПолучитьСтрокуИзДвоичныхДанных(Дв, "UTF-8");
	БОМ = СтрДлина(Т) > 0 И КодСимвола(Т, 1) = 65279;
	Если БОМ Тогда
		Т = Сред(Т, 2);
	КонецЕсли;
	ПС = ?(СтрНайти(Т, Символы.ВК + Символы.ПС) > 0, Символы.ВК + Символы.ПС, Символы.ПС);
	Метка = "</" + Тег + ">" + ПС;
	Стр = Символы.Таб + Символы.Таб + Символы.Таб + "<" + Тег + ">" + Имя + "</" + Тег + ">" + ПС;
	Н = СтрНайти(Т, Метка, НаправлениеПоиска.СКонца);
	Если Н > 0 Тогда
		Поз = Н + СтрДлина(Метка);
	Иначе
		Н = СтрНайти(Т, "</ChildObjects>");
		Поз = СтрНайти(Сред(Т, 1, Н), ПС, НаправлениеПоиска.СКонца) + СтрДлина(ПС);
	КонецЕсли;
	Т = Лев(Т, Поз - 1) + Стр + Сред(Т, Поз);
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, БОМ).Записать(ПутьКонф);
	Возврат 1;
КонецФункции

ВозвратБп = Неопределено;