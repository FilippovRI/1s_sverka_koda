// Задача 10: хук &Перед/&После, тело которого использует локальные переменные метода основной
// (вставка УП была в начале/конце тела), даёт «Переменная не определена». Правило typovaya-up — ИиК везде:
// такой хук переписывается в &ИзменениеИКонтроль: заголовок и тело метода основной дословно, код хука в #Вставка.
// Генератор (СинтезХуков.ОбщиеЛокальные) такие хуки уже не выводит; модуль чинит готовый выход на месте.

Перем Синтез;
Перем Дубли;

Функция ПрочитатьТекст(Путь)
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат СтрЗаменить(Т.ПолучитьТекст(), Символы.ВК, "");
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
	З = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8, Символы.ПС, Ложь, Символы.ВК + Символы.ПС);
	З.Записать(СтрЗаменить(Текст, Символы.ВК, ""));
	З.Закрыть();
КонецПроцедуры

// Число строк заголовка метода (до закрывающей скобки списка параметров) в массиве строк метода.
Функция СтрокЗаголовка(Строки)
	Баланс = 0;
	Было = Ложь;
	Для Й = 0 По Строки.ВГраница() Цикл
		С = (Новый РегулярноеВыражение("""[^""]*""|//.*")).Заменить(Строки[Й], "");
		Для Н = 1 По СтрДлина(С) Цикл
			Сим = Сред(С, Н, 1);
			Если Сим = "(" Тогда
				Баланс = Баланс + 1;
				Было = Истина;
			ИначеЕсли Сим = ")" Тогда
				Баланс = Баланс - 1;
			КонецЕсли;
		КонецЦикла;
		Если Было И Баланс <= 0 Тогда
			Возврат Й + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат 1;
КонецФункции

// Части метода: Заголовок, Тело (строки между заголовком и Конец…), Конец.
Функция ЧастиМетода(ТекстМетода) Экспорт
	Строки = СтрРазделить(ТекстМетода, Символы.ПС, Истина);
	К = СтрокЗаголовка(Строки);
	Заг = Новый Массив;
	Тело = Новый Массив;
	Для Й = 0 По К - 1 Цикл
		Заг.Добавить(Строки[Й]);
	КонецЦикла;
	Для Й = К По Строки.ВГраница() - 1 Цикл
		Тело.Добавить(Строки[Й]);
	КонецЦикла;
	Возврат Новый Структура("Заголовок, Тело, Конец", СтрСоединить(Заг, Символы.ПС), СтрСоединить(Тело, Символы.ПС),
		Строки[Строки.ВГраница()]);
КонецФункции

// Переписывает подходящие хуки в тексте модуля. Структура(Текст, Переписаны, Пропущены).
Функция ПереписатьТекст(ТекстРасш, ТекстОсн, Глобальный = Ложь) Экспорт
	Рез = Новый Структура("Текст, Переписаны, Пропущены", ТекстРасш, Новый Массив, Новый Массив);
	Осн = Новый Соответствие;
	Для Каждого М Из Дубли.МетодыМодуля(ТекстОсн) Цикл
		Осн.Вставить(НРег(М.Имя), М);
	КонецЦикла;
	Строки = СтрРазделить(ТекстРасш, Символы.ПС, Истина);
	РвАнн = Новый РегулярноеВыражение("^\s*&(После|Перед)\s*\(\s*""([\wЁё]+)""\s*\)\s*$");
	Замены = Новый Соответствие; // номер первой строки (с 1) -> Структура(До, Текст)
	Для Каждого М Из Дубли.МетодыМодуля(ТекстРасш) Цикл
		Если М.Аннотация <> "После" И М.Аннотация <> "Перед" Тогда
			Продолжить;
		КонецЕсли;
		НомАнн = 0;
		Цель = "";
		Й = М.Начало - 2;
		Пока Й >= 0 И СтрНачинаетсяС(СокрЛ(Строки[Й]), "&") Цикл
			С = РвАнн.НайтиСовпадения(Строки[Й]);
			Если С.Количество() > 0 Тогда
				НомАнн = Й + 1;
				Цель = С[0].Группы[2].Значение;
			КонецЕсли;
			Й = Й - 1;
		КонецЦикла;
		МО = Осн.Получить(НРег(Цель));
		Если НомАнн = 0 Или МО = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЧО = ЧастиМетода(МО.Текст);
		ЧХ = ЧастиМетода(М.Текст);
		ВКонце = (М.Аннотация = "После");
		Общие = Синтез.ОбщиеЛокальные(ЧО.Тело, ЧХ.Тело, ВКонце);
		Если Общие.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Метка = М.Имя + " (" + СтрСоединить(Общие, ",") + ")";
		Если Глобальный Тогда
			Рез.Пропущены.Добавить(Метка + ": глобальный модуль, ИиК недопустим");
			Продолжить;
		КонецЕсли;
		Заг = (Новый РегулярноеВыражение("(?i)((?:Процедура|Функция)\s+)" + Цель + "(\s*\()")).Заменить(ЧО.Заголовок, "$1" + М.Имя + "$2");
		Вставка = "#Вставка" + Символы.ПС + ЧХ.Тело + Символы.ПС + "#КонецВставки";
		Тело = ?(ВКонце, ЧО.Тело + Символы.ПС + Вставка, Вставка + Символы.ПС + ЧО.Тело);
		Замены.Вставить(НомАнн, Новый Структура("До, Текст", М.Конец,
			"&ИзменениеИКонтроль(""" + Цель + """)" + Символы.ПС + СтрСоединить(ДиректорыМеждуАннИМетодом(Строки, НомАнн, М.Начало), "")
			+ Заг + Символы.ПС + Тело + Символы.ПС + ЧО.Конец));
		Рез.Переписаны.Добавить(Метка);
	КонецЦикла;
	Если Замены.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Новые = Новый Массив;
	Н = 1;
	Пока Н <= Строки.Количество() Цикл
		З = Замены.Получить(Н);
		Если З = Неопределено Тогда
			Новые.Добавить(Строки[Н - 1]);
			Н = Н + 1;
		Иначе
			Новые.Добавить(З.Текст);
			Н = З.До + 1;
		КонецЕсли;
	КонецЦикла;
	Рез.Текст = СтрСоединить(Новые, Символы.ПС);
	Возврат Рез;
КонецФункции

// Строки-аннотации между &Перед/&После и объявлением (напр. директивы компиляции), каждая с переводом строки.
Функция ДиректорыМеждуАннИМетодом(Строки, НомАнн, НачалоМетода)
	Р = Новый Массив;
	Для Й = НомАнн + 1 По НачалоМетода - 1 Цикл
		Р.Добавить(Строки[Й - 1] + Символы.ПС);
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЭтоГлобальныйМодуль(КаталогРасш, Отн)
	Части = СтрРазделить(СтрЗаменить(Отн, "\", "/"), "/");
	Если Части.Количество() < 2 Или Части[0] <> "CommonModules" Тогда
		Возврат Ложь;
	КонецЕсли;
	Т = ПрочитатьТекст(ОбъединитьПути(КаталогРасш, "CommonModules", Части[1] + ".xml"));
	Возврат Т <> Неопределено И СтрНайти(Т, "<Global>true</Global>") > 0;
КонецФункции

// Обходит *.bsl расширения; основной модуль — первый найденный по тому же пути в КорниОсновной.
Функция Применить(КаталогРасш, КорниОсновной, Записывать = Истина) Экспорт
	Рез = Новый Структура("files, rewritten, skipped", 0, Новый Массив, Новый Массив);
	Для Каждого Ф Из НайтиФайлы(КаталогРасш, "*.bsl", Истина) Цикл
		Т = ПрочитатьТекст(Ф.ПолноеИмя);
		Если СтрНайти(Т, "&После") = 0 И СтрНайти(Т, "&Перед") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отн = Сред(Ф.ПолноеИмя, СтрДлина(КаталогРасш) + 2);
		ТекстОсн = Неопределено;
		Для Каждого Кор Из КорниОсновной Цикл
			ТекстОсн = ПрочитатьТекст(ОбъединитьПути(Кор, Отн));
			Если ТекстОсн <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ТекстОсн = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Р = ПереписатьТекст(Т, ТекстОсн, ЭтоГлобальныйМодуль(КаталогРасш, Отн));
		Для Каждого С Из Р.Пропущены Цикл
			Рез.skipped.Добавить(Отн + ": " + С);
		КонецЦикла;
		Если Р.Переписаны.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Рез.files = Рез.files + 1;
		Для Каждого С Из Р.Переписаны Цикл
			Рез.rewritten.Добавить(Отн + ": " + С);
		КонецЦикла;
		Если Записывать Тогда
			ЗаписатьТекст(Ф.ПолноеИмя, Р.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Синтез = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "СинтезХуков.os"));
Дубли = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ДублиМетодовОсновной.os"));
