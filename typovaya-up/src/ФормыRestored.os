// Form.xml: restored = основная (load-e); заимствованная форма — BaseForm (тело основной) + слой УП (added, префикс).
// Реквизиты основной выносим в корень Form (не в BaseForm) — иначе ibcmd: «Неверный путь к данным» на регистрах/списках.

Функция КаталогМодулей()
	К = ОбъединитьПути(ТекущийСценарий().Каталог, "АнализФорм.os");
	Если (Новый Файл(К)).Существует() Тогда
		Возврат ТекущийСценарий().Каталог;
	КонецЕсли;
	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
КонецФункции

Функция Подключить(ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(КаталогМодулей(), ИмяФайла));
КонецФункции

Функция ПеречислитьFormXmlПолный(Корень) Экспорт
	Аф = Подключить("АнализФорм.os");
	Р = Аф.ПеречислитьFormXml(Корень);
	Доп = ПеречислитьCommonForms(Корень);
	Для Каждого КЗ Из Доп Цикл
		Если Р.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПеречислитьCommonForms(Корень)
	Р = Новый Соответствие;
	Кат = ОбъединитьПути(Корень, "CommonForms");
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого П Из НайтиФайлы(Кат, "Form.xml", Истина) Цикл
		Отн = Сред(П.ПолноеИмя, СтрДлина(Корень) + 2);
		Р.Вставить(СтрЗаменить(Отн, "/", "\"), П.ПолноеИмя);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Пишет Form.xml БП в restored для всех форм БП, существующих в УП (по пути). Пропускает уже записанные dynlist.
Функция ЗаписатьFormXmlБпВRestored(КореньУп, КореньБп, КаталогВосст, ПропускПутей, Лог) Экспорт
	ДС = Подключить("ЗапросыДинСписков.os");
	ДС.УстановитьКореньМетаданных(КореньУп);
	Раздел = ПолучитьРазделительПути();
	ФБп = ПеречислитьFormXmlПолный(КореньБп);
	ФУп = ПеречислитьFormXmlПолный(КореньУп);
	Стат = Новый Структура("written, cleaned, skippedDynlist, skippedNoUp", 0, 0, 0, 0);
	Для Каждого КЗ Из ФБп Цикл
		Отн = КЗ.Ключ;
		Если ФУп.Получить(Отн) = Неопределено Тогда
			Стат.skippedNoUp = Стат.skippedNoUp + 1;
			Продолжить;
		КонецЕсли;
		Если ПропускПутей <> Неопределено И ПропускПутей.Получить(Отн) <> Неопределено Тогда
			Стат.skippedDynlist = Стат.skippedDynlist + 1;
			Продолжить;
		КонецЕсли;
		Р = ДС.ПрочитатьСырой(КЗ.Значение);
		Если Р = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Оч = ОчиститьFormXmlОтсутствующиеТипы(Р.Текст, КореньУп, Отн, Лог);
		Текст = Оч.Текст;
		Если Оч.Удалено > 0 Тогда
			Стат.cleaned = Стат.cleaned + 1;
		КонецЕсли;
		ДС.ЗаписатьСырой(ОбъединитьПути(КаталогВосст, СтрЗаменить(Отн, "\", Раздел)), Текст, Р.BOM);
		Стат.written = Стат.written + 1;
	КонецЦикла;
	Лог.Добавить("forms restored: Form.xml БП записано " + Стат.written + ", очищено от ссылок нет в УП " + Стат.cleaned
		+ ", пропуск dynlist " + Стат.skippedDynlist + ", нет в УП " + Стат.skippedNoUp);
	Возврат Стат;
КонецФункции

Функция ОчиститьFormXmlОтсутствующиеТипы(Текст, КореньУп, ОтнПуть, Лог)
	Рез = Новый Структура("Текст, Удалено", Текст, 0);
	РвТип = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
	РвАтр = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]+)""[^>]*>.*?</Attribute>");
	Для Каждого С Из РвАтр.НайтиСовпадения(Текст) Цикл
		Фраг = С.Значение;
		Невал = Ложь;
		Для Каждого Т Из РвТип.НайтиСовпадения(Фраг) Цикл
			Если Не ТипСуществуетВУп(КореньУп, Т.Группы[1].Значение) Тогда
				Невал = Истина;
				Лог.Добавить("forms clean: " + ОтнПуть + " — удалён реквизит " + С.Группы[1].Значение + " (тип " + Т.Группы[1].Значение + " нет в УП)");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Невал Тогда
			Рез.Текст = СтрЗаменить(Рез.Текст, Фраг, "");
			Рез.Удалено = Рез.Удалено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ТипСуществуетВУп(КореньУп, Знач ТипCfg)
	ТипCfg = СокрЛП(ТипCfg);
	Если Лев(НРег(ТипCfg), 4) <> "cfg:" Тогда
		Возврат Истина;
	КонецЕсли;
	Х = Сред(ТипCfg, 5);
	П = СтрНайти(Х, ".");
	Если П = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Вид = Лев(Х, П - 1);
	Имя = Сред(Х, П + 1);
	Карта = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("Catalog:Catalogs,Document:Documents,Enum:Enums,InformationRegister:InformationRegisters,"
		+ "AccumulationRegister:AccumulationRegisters,ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,ChartOfAccounts:ChartsOfAccounts,"
		+ "ChartOfCalculationTypes:ChartsOfCalculationTypes,ExchangePlan:ExchangePlans,BusinessProcess:BusinessProcesses,Task:Tasks,"
		+ "CommonForm:CommonForms,Constant:Constants", ",") Цикл
		Ч = СтрРазделить(Пара, ":");
		Карта.Вставить(НРег(Ч[0]), Ч[1]);
	КонецЦикла;
	Кат = Карта.Получить(НРег(Вид));
	Если Кат = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Путь = ОбъединитьПути(КореньУп, Кат, Имя + ".xml");
	Возврат (Новый Файл(Путь)).Существует();
КонецФункции

// Раньше вырезали ссылки; теперь формы БП не режем — заготовки объектов вместо вырезания.
Функция ОчиститьFormXmlМетаданных(Текст, Корень, КореньУп, СоставОсн, ОтнПуть, Лог) Экспорт
	Возврат Новый Структура("Текст, Удалено, Изменён", Текст, 0, Ложь);
КонецФункции

// Заимствованная форма: BaseForm = тело Form основной; слой расширения — added УП (реквизиты, команды, фрагменты UI) с префиксом.
// ПутьFormXmlОсн — Form.xml основной конфигурации (load-e); при отсутствии допустима выгрузка БП.
Функция XmlТелаЗаимствованнойФормыБпУп(ПутьFormXmlУп, ПутьFormXmlОсн, Префикс) Экспорт
	Если ПутьFormXmlОсн = "" Или Не (Новый Файл(ПутьFormXmlОсн)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	ТУ = ПрочитатьТекстUtf8(ПутьFormXmlУп);
	ТБ = ПрочитатьТекстUtf8(ПутьFormXmlОсн);
	Если ТБ = "" Тогда
		Возврат "";
	КонецЕсли;
	Аф = Подключить("АнализФорм.os");
	КУ = Аф.КартаРеквизитовFormXml(ПутьFormXmlУп);
	КБ = Аф.КартаРеквизитовFormXml(ПутьFormXmlОсн);
	ДобАтр = Аф.ИменаТолькоВПервой(КУ, КБ);
	СлойАтр = "";
	Если ДобАтр.Количество() > 0 Тогда
		Блоки = Новый Массив;
		СледИдУп = МаксИдВТекстеForm(ТБ) + 1000;
		Для Каждого Имя Из ДобАтр Цикл
			Б = ВырезатьАтрибут(ТУ, Имя);
			Если Б <> "" Тогда
				Б = ПрефиксироватьАтрибут(Б, Имя, Префикс);
				Б = ЗаменитьИдАтрибута(Б, СледИдУп);
				СледИдУп = СледИдУп + 1;
				Блоки.Добавить(Б);
			КонецЕсли;
		КонецЦикла;
		Если Блоки.Количество() > 0 Тогда
			СлойАтр = "	<Attributes>" + Символы.ПС + СтрСоединить(Блоки, Символы.ПС) + Символы.ПС + "	</Attributes>";
		КонецЕсли;
	КонецЕсли;
	СлойКом = СлойКомандыТолькоУп(ТУ, ТБ, Префикс);
	СлойЭл = СлойЭлементыУп(ПутьFormXmlУп, ДобАтр, Префикс);
	ТелоВнутр = ВнутренностьForm(ТБ);
	СлойБазаАтр = "";
	Если НужноВыноситьАтрибутыВКорень(ТБ, СлойАтр <> "") Тогда
		РаздАтр = РазделитьАтрибутыТелаForm(ТелоВнутр);
		ТелоВнутр = РаздАтр.Тело;
		СлойБазаАтр = РаздАтр.Атрибуты;
	КонецЕсли;
	ТелоБп = НормализоватьPictureLoadTransparent(ТелоВнутр);
	Версия = ВерсияForm(ТБ);
	Корень = СтрокаКорняForm(ТБ);
	СлойАтрИтог = ОбъединитьСлоиАтрибутов(СлойАтр, СлойБазаАтр);
	Ч = Новый Массив;
	Ч.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Ч.Добавить(Корень);
	Если СлойКом <> "" Тогда
		Ч.Добавить(СлойКом);
	КонецЕсли;
	Если СлойАтрИтог <> "" Тогда
		Ч.Добавить(СлойАтрИтог);
	КонецЕсли;
	Если СлойЭл <> "" Тогда
		Ч.Добавить(СлойЭл);
	КонецЕсли;
	Ч.Добавить("	<BaseForm" + ?(Версия = "", "", " version=""" + Версия + """") + ">");
	Для Каждого Стр Из СтрРазделить(ТелоБп, Символы.ПС, Истина) Цикл
		Ч.Добавить("	" + Стр);
	КонецЦикла;
	Ч.Добавить("	</BaseForm>");
	Ч.Добавить("</Form>");
	Т = СтрСоединить(Ч, Символы.ПС) + Символы.ПС;
	Возврат ПостобработкаИтоговогоForm(Т);
КонецФункции

// Точечная допостобработка уже записанных Form.xml (CommonForms и т.п.).
Функция ДопостобработкаFormXmlНаДиске(Текст) Экспорт
	Т = ИсправитьValueListTypeВАтрибутахForm(Текст);
	Т = ИсправитьValueListTypeВТипахForm(Т);
	Т = УбратьTypeDescriptionУАтрибутовФормы(Т);
	Т = ЗаменитьV8uiТипыВАтрибутах(Т);
	Т = ЗаменитьValueTableВАтрибутах(Т);
	Т = ЗаменитьТипыСхемКомпоновкиВForm(Т);
	Т = УпроститьМножественныеТипыВType(Т);
	Т = СинхронизироватьТипDynamicListПоSettings(Т);
	Т = УпроститьТипыПараметровForm(Т);
	Возврат Т;
КонецФункции

// Единая постобработка Form.xml расширения (ibcmd XDTO + пустые узлы).
Функция ПостобработкаИтоговогоForm(Текст) Экспорт
	Т = НормализоватьPictureLoadTransparent(Текст);
	Т = ДобавитьTransparentPixelВPicture(Т);
	Т = ИсправитьПустыеPicture(Т);
	Т = ИсправитьПустыеТипыАтрибутов(Т);
	Т = ОчиститьПустыеFunctionalOptionsВАтрибутах(Т);
	Т = УпроститьКомандыУпВКорне(Т);
	Т = УбратьPictureИзКоманд(Т);
	Т = УпроститьАтрибутыВКорнеСViewEdit(Т);
	Т = УбратьFillCheckИзКорневыхАтрибутов(Т);
	Т = НормализоватьГраницыСлоевForm(Т);
	Т = ДополнитьСтроковыеТипыАтрибутов(Т);
	Т = ИсправитьValueListTypeВКорнеForm(Т);
	Т = ИсправитьValueListTypeВАтрибутахForm(Т);
	Т = ИсправитьValueListTypeВТипахForm(Т);
	Т = ЗаменитьCommonPictureНаStdВPicture(Т);
	Т = УпроститьСоставныеТипыКолонок(Т);
	Т = ЗаменитьV8uiТипыВАтрибутах(Т);
	Т = ЗаменитьСистемныеV8ТипыВType(Т);
	Т = ЗаменитьValueTableВАтрибутах(Т);
	Т = ЗаменитьТипыСхемКомпоновкиВForm(Т);
	Т = УпроститьМножественныеТипыВType(Т);
	Т = УбратьTypeDescriptionУАтрибутовФормы(Т);
	Т = ЗаменитьСтилевыеЦветаВФорме(Т);
	Т = УпроститьСлужебныеУзлыГлавногоРеквизита(Т);
	Т = УбратьSavedDataУАтрибутовЗаимствованной(Т);
	Т = ИсправитьRecordManagerRecordSetВBaseFormНеГлавных(Т);
	Т = УпроститьTypeSetВТипахФормы(Т);
	Т = УпроститьТипыУпАтрибутовВКорне(Т);
	Т = СинхронизироватьТипDynamicListПоSettings(Т);
	Т = УпроститьТипыПараметровForm(Т);
	Т = УпроститьEnumRefВBaseFormБезГлавного(Т);
	РвПуст = Новый РегулярноеВыражение("(?s)\t<ChildItems>\s*</ChildItems>\s*");
	Возврат РвПуст.Заменить(Т, "");
КонецФункции

Функция НормализоватьГраницыСлоевForm(Текст)
	Текст = СтрЗаменить(Текст, "</Attributes><BaseForm", "</Attributes>" + Символы.ПС + "	<BaseForm");
	Текст = СтрЗаменить(Текст, "</Commands><Attributes", "</Commands>" + Символы.ПС + "	<Attributes");
	Текст = СтрЗаменить(Текст, "</Attributes><ChildItems", "</Attributes>" + Символы.ПС + "	<ChildItems");
	Возврат Текст;
КонецФункции

// xs:string без StringQualifiers в корневых атрибутах — XDTO Type.
// ValueListType в корневых атрибутах расширения — XDTO Type (ibcmd).
// CommonPicture в Picture — XDTO при отсутствии картинки в расширении (ibcmd).
// Двойной xs:string + xs:dateTime в Type колонки — XDTO Type (ibcmd).
Функция УпроститьСоставныеТипыКолонок(Текст)
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*<v8:Type>xs:string</v8:Type>\s*<v8:StringQualifiers>.*?</v8:StringQualifiers>\s*<v8:Type>xs:dateTime</v8:Type>");
	Зам = "<Type>" + Символы.ПС + "						<v8:Type>xs:dateTime</v8:Type>";
	Возврат Рв.Заменить(Текст, Зам);
КонецФункции

Функция ЗаменитьCommonPictureНаStdВPicture(Текст)
	Рв = Новый РегулярноеВыражение("<xr:Ref>CommonPicture\.[^<]+</xr:Ref>");
	Возврат Рв.Заменить(Текст, "<xr:Ref>StdPicture.Information</xr:Ref>");
КонецФункции

// ValueListType в любом Attribute — XDTO import; замена Type + снятие Settings/TypeDescription в том же блоке.
Функция ИсправитьValueListTypeВАтрибутахForm(Текст)
	Если СтрНайти(Текст, "v8:ValueListType") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ЗамТ = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	РвС = Новый РегулярноеВыражение("(?s)\s*<Settings[^>]*>.*?</Settings>\s*");
	РвСП = Новый РегулярноеВыражение("(?s)\s*<Settings\s+xsi:type=""v8:TypeDescription""\s*/>\s*");
	Рез = Текст;
	Для Каждого С Из РвА.НайтиСовпадения(Текст) Цикл
		Если СтрНайти(С.Значение, "v8:ValueListType") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвТ.Заменить(С.Значение, ЗамТ);
		Нов = РвС.Заменить(Нов, Символы.ПС);
		Нов = РвСП.Заменить(Нов, Символы.ПС);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Любой узел Type с v8:ValueListType (Parameter, колонки и т.д.) — XDTO import.
Функция ИсправитьValueListTypeВТипахForm(Текст)
	Если СтрНайти(Текст, "v8:ValueListType") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Зам = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*<v8:Type>v8:ValueListType</v8:Type>\s*</Type>");
	Возврат Рв.Заменить(Текст, Зам);
КонецФункции

// ValueListType → string только у корневых УП_-реквизитов (глобальная замена ломает BaseForm + Settings).
Функция ИсправитьValueListTypeВКорнеForm(Текст)
	Если СтрНайти(Текст, "v8:ValueListType") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""УП_[^""]*""[^>]*>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	ЗамТ = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	Рез = Текст;
	Для Каждого С Из РвА.НайтиСовпадения(Текст) Цикл
		Если СтрНайти(С.Значение, "v8:ValueListType") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвТ.Заменить(С.Значение, ЗамТ);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Settings DynamicList при Type xs:string (после упрощения УП_) — XDTO Settings.
Функция УпроститьТипыПараметровForm(Текст)
	ЗамСтр = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	РвП = Новый РегулярноеВыражение("(?s)<Parameter\s+name=""[^""]*""[^>]*>.*?</Parameter>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	РвCfg = Новый РегулярноеВыражение("<v8:Type>cfg:");
	Рез = Текст;
	Для Каждого С Из РвП.НайтиСовпадения(Текст) Цикл
		Если РвCfg.НайтиСовпадения(С.Значение).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвТ.Заменить(С.Значение, ЗамСтр);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Вспомогательные формы без главного реквизита: EnumRef в BaseForm — XDTO Type.
Функция УпроститьEnumRefВBaseFormБезГлавного(Текст)
	Если СтрНайти(Текст, "<MainAttribute>true</MainAttribute>") > 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозБ = СтрНайти(Текст, "<BaseForm");
	Если ПозБ = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	База = Сред(Текст, ПозБ);
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	Зам = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	НовБ = База;
	Для Каждого С Из РвА.НайтиСовпадения(База) Цикл
		Если СтрНайти(С.Значение, "cfg:EnumRef") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвТ.Заменить(С.Значение, Зам);
		НовБ = СтрЗаменить(НовБ, С.Значение, Нов);
	КонецЦикла;
	Если НовБ = База Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозБ - 1) + НовБ;
КонецФункции

Функция СинхронизироватьТипDynamicListПоSettings(Текст)
	ЗамТ = "<Type>" + Символы.ПС + "				<v8:Type>cfg:DynamicList</v8:Type>" + Символы.ПС + "			</Type>";
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	Рез = Текст;
	Для Каждого С Из РвА.НайтиСовпадения(Текст) Цикл
		Если СтрНайти(С.Значение, "xsi:type=""DynamicList""") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(С.Значение, "cfg:DynamicList") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвТ.Заменить(С.Значение, ЗамТ);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ЗаменитьТипыСхемКомпоновкиВForm(Текст)
	Зам = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*<v8:Type>dcsset:[^<]+</v8:Type>\s*</Type>");
	Возврат Рв.Заменить(Текст, Зам);
КонецФункции

// Несколько v8:Type в одном Type (Parameter и т.д.) — XDTO import.
Функция УпроститьМножественныеТипыВType(Текст)
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*((?:<v8:Type>[^<]+</v8:Type>\s*){2,})</Type>");
	Рв1 = Новый РегулярноеВыражение("<v8:Type>([^<]+)</v8:Type>");
	Рез = Текст;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Типы = Рв1.НайтиСовпадения(С.Группы[1].Значение);
		Если Типы.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Выб = Типы[0].Группы[1].Значение;
		Для Каждого Т Из Типы Цикл
			Если Лев(Т.Группы[1].Значение, 4) = "cfg:" Тогда
				Выб = Т.Группы[1].Значение;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Нов = "<Type>" + Символы.ПС + "					<v8:Type>" + Выб + "</v8:Type>" + Символы.ПС + "				</Type>";
		Если Лев(Выб, 3) = "xs:" Тогда
			Если Выб = "xs:string" Тогда
				Нов = "<Type>" + Символы.ПС + "					<v8:Type>xs:string</v8:Type>" + Символы.ПС
					+ "					<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
					+ "				</Type>";
			ИначеЕсли Выб = "xs:decimal" Тогда
				Нов = "<Type>" + Символы.ПС + "					<v8:Type>xs:decimal</v8:Type>" + Символы.ПС
					+ "					<v8:NumberQualifiers><v8:Digits>15</v8:Digits><v8:FractionDigits>2</v8:FractionDigits><v8:AllowedSign>Any</v8:AllowedSign></v8:NumberQualifiers>" + Символы.ПС
					+ "				</Type>";
			КонецЕсли;
		КонецЕсли;
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ЗаменитьValueTableВАтрибутах(Текст)
	ЗамТ = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	РвК = Новый РегулярноеВыражение("(?s)\s*<Columns>.*?</Columns>\s*");
	Рез = Текст;
	Для Каждого С Из РвА.НайтиСовпадения(Текст) Цикл
		Если СтрНайти(С.Значение, "v8:ValueTable") = 0 И СтрНайти(С.Значение, "<Columns>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвТ.Заменить(С.Значение, ЗамТ);
		Нов = РвК.Заменить(Нов, Символы.ПС);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ЗаменитьСистемныеV8ТипыВType(Текст)
	Зам = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*<v8:Type>v8:(?:StandardPeriod|UUID)</v8:Type>\s*</Type>");
	Возврат Рв.Заменить(Текст, Зам);
КонецФункции

Функция ЗаменитьV8uiТипыВАтрибутах(Текст)
	Зам = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*<v8:Type>v8ui:(?:Color|FormattedString)</v8:Type>\s*</Type>");
	Возврат Рв.Заменить(Текст, Зам);
КонецФункции

Функция УбратьTypeDescriptionУАтрибутовФормы(Текст)
	РвС = Новый РегулярноеВыражение("(?s)\s*<Settings\s+xsi:type=""v8:TypeDescription""\s*/>\s*");
	Текст = РвС.Заменить(Текст, Символы.ПС);
	РвП = Новый РегулярноеВыражение("(?s)\s*<Settings\s+xsi:type=""v8:TypeDescription""\s*>.*?</Settings>\s*");
	Возврат РвП.Заменить(Текст, Символы.ПС);
КонецФункции

// ibcmd: style:* в Color-узлах формы — подставляем web:/# (не трогаем Font ref/style: и xmlns:style).
Функция ЗаменитьСтилевыеЦветаВФорме(Текст)
	ЗаменыWeb = Новый Соответствие;
	ЗаменыWeb.Вставить("ПользовательВыбранный", "web:339966");
	ЗаменыWeb.Вставить("ГруппаВариантовОтчетовЦвет", "web:5B7FA6");
	ЗаменыWeb.Вставить("ГиперссылкаЦвет", "web:0066CC");
	ЗаменыWeb.Вставить("ДосьеГиперссылкаЦвет", "web:0066CC");
	ЗаменыHex = Новый Соответствие;
	ЗаменыHex.Вставить("ПользовательВыбранный", "#339966");
	ЗаменыHex.Вставить("ГруппаВариантовОтчетовЦвет", "#5B7FA6");
	ЗаменыHex.Вставить("ГиперссылкаЦвет", "#0066CC");
	ЗаменыHex.Вставить("ДосьеГиперссылкаЦвет", "#0066CC");
	ЗаменыHex.Вставить("ТекстЗапрещеннойЯчейкиЦвет", "#FF0000");
	РвТ = Новый РегулярноеВыражение("(?s)<(TextColor|BackColor|BorderColor|TitleTextColor)>\s*style:([^<]+)\s*</(TextColor|BackColor|BorderColor|TitleTextColor)>");
	РвD = Новый РегулярноеВыражение("<dcscor:value xsi:type=""v8ui:Color"">style:([^<]+)</dcscor:value>");
	Рез = Текст;
	Для Каждого С Из РвТ.НайтиСовпадения(Рез) Цикл
		ИмяСт = С.Группы[2].Значение;
		Зам = ЗаменыWeb.Получить(ИмяСт);
		Если Зам = Неопределено Тогда
			Зам = "web:000000";
		КонецЕсли;
		Нов = "<" + С.Группы[1].Значение + ">" + Зам + "</" + С.Группы[1].Значение + ">";
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Для Каждого С Из РвD.НайтиСовпадения(Рез) Цикл
		ИмяСт = С.Группы[1].Значение;
		Зам = ЗаменыHex.Получить(ИмяСт);
		Если Зам = Неопределено Тогда
			Зам = "#000000";
		КонецЕсли;
		Нов = "<dcscor:value xsi:type=""v8ui:Color"">" + Зам + "</dcscor:value>";
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат СтрЗаменить(Рез, "<Font ref=""web:000000""", "<Font ref=""style:NormalTextFont""");
КонецФункции

Функция УпроститьСлужебныеУзлыГлавногоРеквизита(Текст)
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?<MainAttribute>true</MainAttribute>.*?</Attribute>");
	РвУ = Новый РегулярноеВыражение("(?s)\s*<UseAlways>.*?</UseAlways>\s*");
	РвС = Новый РегулярноеВыражение("(?s)\s*<SavedData>.*?</SavedData>\s*");
	Рез = Текст;
	Для Каждого С Из РвА.НайтиСовпадения(Текст) Цикл
		Нов = РвУ.Заменить(С.Значение, Символы.ПС);
		Нов = РвС.Заменить(Нов, Символы.ПС);
		Если Нов <> С.Значение Тогда
			Рез = СтрЗаменить(Рез, С.Значение, Нов);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// SavedData/UseAlways в заимствованной форме — XDTO Type (ibcmd).
Функция УбратьSavedDataУАтрибутовЗаимствованной(Текст)
	Если СтрНайти(Текст, "<BaseForm") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	РвУ = Новый РегулярноеВыражение("(?s)\s*<UseAlways>.*?</UseAlways>\s*");
	РвС = Новый РегулярноеВыражение("(?s)\s*<SavedData>.*?</SavedData>\s*");
	РвМ = Новый РегулярноеВыражение("(?s)\s*<ModifiesSavedData>.*?</ModifiesSavedData>\s*");
	Текст = РвУ.Заменить(Текст, Символы.ПС);
	Текст = РвС.Заменить(Текст, Символы.ПС);
	Возврат РвМ.Заменить(Текст, Символы.ПС);
КонецФункции

Функция УпроститьTypeSetВТипахФормы(Текст)
	Зам = "<Type><v8:Type>xs:string</v8:Type><v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers></Type>";
	Возврат (Новый РегулярноеВыражение("(?s)<Type>\s*(?:<v8:TypeSet>[^<]+</v8:TypeSet>\s*)+</Type>")).Заменить(Текст, Зам);
КонецФункции

Функция УпроститьТипыУпАтрибутовВКорне(Текст)
	ПозБ = СтрНайти(Текст, "<BaseForm");
	Если ПозБ = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Корень = Лев(Текст, ПозБ - 1);
	Хвост = Сред(Текст, ПозБ);
	ЗамТ = "<Type>" + Символы.ПС + "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""УП_[^""]*""[^>]*>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("(?s)<Type>.*?</Type>");
	РвCfg = Новый РегулярноеВыражение("<v8:Type>cfg:");
	НовК = Корень;
	Для Каждого С Из РвА.НайтиСовпадения(Корень) Цикл
		Блок = С.Значение;
		Совп = РвТ.НайтиСовпадения(Блок);
		Если Совп.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если РвCfg.НайтиСовпадения(Совп[0].Значение).Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Блок, "xsi:type=""DynamicList""") > 0 Тогда
			Продолжить;
		КонецЕсли;
		НовБ = РвТ.Заменить(Блок, ЗамТ);
		НовК = СтрЗаменить(НовК, Блок, НовБ);
	КонецЦикла;
	Возврат НовК + Хвост;
КонецФункции

// RecordManager/RecordSet у вспомогательных реквизитов BaseForm — XDTO Type.
Функция ИсправитьRecordManagerRecordSetВBaseFormНеГлавных(Текст)
	ПозБ = СтрНайти(Текст, "<BaseForm");
	Если ПозБ = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ПозК = СтрНайти(Текст, "</BaseForm>", , ПозБ);
	Если ПозК = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	ХвБ = ПозК + СтрДлина("</BaseForm>");
	База = Сред(Текст, ПозБ, ХвБ - ПозБ);
	РвА = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	НовБ = База;
	Для Каждого С Из РвА.НайтиСовпадения(База) Цикл
		Если СтрНайти(С.Значение, "<MainAttribute>true</MainAttribute>") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = ЗаменитьV8ТипПоПрефиксу(ЗаменитьV8ТипПоПрефиксу(С.Значение, "cfg:InformationRegisterRecordManager"), "cfg:InformationRegisterRecordSet");
		Если Нов <> С.Значение Тогда
			НовБ = СтрЗаменить(НовБ, С.Значение, Нов);
		КонецЕсли;
	КонецЦикла;
	Если НовБ = База Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозБ - 1) + НовБ + Сред(Текст, ХвБ);
КонецФункции

Функция ЗаменитьV8ТипПоПрефиксу(Текст, Префикс)
	Рез = Текст;
	Иск = "<v8:Type>" + Префикс;
	Хв = "</v8:Type>";
	Пока СтрНайти(Рез, Иск) > 0 Цикл
		Н1 = СтрНайти(Рез, Иск);
		Н2 = СтрНайти(Рез, Хв, , Н1);
		Если Н2 = 0 Тогда
			Прервать;
		КонецЕсли;
		Рез = Лев(Рез, Н1 - 1) + "<v8:Type>xs:string</v8:Type>" + Сред(Рез, Н2 + СтрДлина(Хв));
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ДополнитьСтроковыеТипыАтрибутов(Текст)
	Зам = "<Type>" + Символы.ПС
		+ "				<v8:Type>xs:string</v8:Type>" + Символы.ПС
		+ "				<v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers>" + Символы.ПС
		+ "			</Type>";
	Рв = Новый РегулярноеВыражение("(?s)<Type>\s*<v8:Type>xs:string</v8:Type>\s*</Type>");
	Возврат Рв.Заменить(Текст, Зам);
КонецФункции

// FillCheck на реквизитах слоя расширения в корне — XDTO Type.
Функция УбратьFillCheckИзКорневыхАтрибутов(Текст)
	ПозА = СтрНайти(Текст, "	<Attributes>");
	ПозБ = СтрНайти(Текст, "	</Attributes>");
	Если ПозА = 0 Или ПозБ <= ПозА Тогда
		Возврат Текст;
	КонецЕсли;
	После = Сред(Текст, ПозБ + СтрДлина("	</Attributes>"));
	Если СтрНайти(После, "<BaseForm") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Корень = Сред(Текст, ПозА, ПозБ - ПозА + СтрДлина("	</Attributes>"));
	РвФ = Новый РегулярноеВыражение("(?s)\s*<FillCheck>.*?</FillCheck>\s*");
	НовК = РвФ.Заменить(Корень, Символы.ПС);
	Если НовК = Корень Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, ПозА - 1) + НовК + Сред(Текст, ПозБ + СтрДлина("	</Attributes>") + 1);
КонецФункции

// View/Edit/FO на заимствованных реквизитах в корне Form — XDTO Type (ibcmd), кроме главного реквизита.
Функция УпроститьАтрибутыВКорнеСViewEdit(Текст)
	ПозА = СтрНайти(Текст, "	<Attributes>");
	ПозБ = СтрНайти(Текст, "	</Attributes>");
	Если ПозА = 0 Или ПозБ <= ПозА Тогда
		Возврат Текст;
	КонецЕсли;
	Корень = Сред(Текст, ПозА, ПозБ - ПозА + СтрДлина("	</Attributes>"));
	После = Сред(Текст, ПозБ + СтрДлина("	</Attributes>"));
	Если СтрНайти(После, "<BaseForm") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	РвВ = Новый РегулярноеВыражение("(?s)\s*<View>.*?</View>\s*");
	РвЕ = Новый РегулярноеВыражение("(?s)\s*<Edit>.*?</Edit>\s*");
	РвФ = Новый РегулярноеВыражение("(?s)\s*<FunctionalOptions>.*?</FunctionalOptions>\s*");
	РезК = Корень;
	Для Каждого С Из Рв.НайтиСовпадения(Корень) Цикл
		Если СтрНайти(С.Значение, "<MainAttribute>true</MainAttribute>") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(С.Значение, "<View>") = 0 И СтрНайти(С.Значение, "<Edit>") = 0 И СтрНайти(С.Значение, "<FunctionalOptions>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Нов = РвВ.Заменить(С.Значение, Символы.ПС);
		Нов = РвЕ.Заменить(Нов, Символы.ПС);
		Нов = РвФ.Заменить(Нов, Символы.ПС);
		РезК = СтрЗаменить(РезК, С.Значение, Нов);
	КонецЦикла;
	Возврат Лев(Текст, ПозА - 1) + РезК + Сред(Текст, ПозБ + СтрДлина("	</Attributes>") + 1);
КонецФункции

// Picture в Command — XDTO в расширении (ibcmd).
Функция УбратьPictureИзКоманд(Текст)
	РвК = Новый РегулярноеВыражение("(?s)<Command\s+name=""[^""]*""[^>]*>.*?</Command>");
	РвП = Новый РегулярноеВыражение("(?s)\s*<Picture>.*?</Picture>\s*");
	Рез = Текст;
	Для Каждого С Из РвК.НайтиСовпадения(Текст) Цикл
		Нов = РвП.Заменить(С.Значение, Символы.ПС);
		Нов = СтрЗаменить(Нов, "<Representation>TextPicture</Representation>", "<Representation>Text</Representation>");
		Нов = СтрЗаменить(Нов, "<Representation>Picture</Representation>", "<Representation>Text</Representation>");
		Если Нов <> С.Значение Тогда
			Рез = СтрЗаменить(Рез, С.Значение, Нов);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция УпроститьКомандыУпВКорне(Текст)
	Рв = Новый РегулярноеВыражение("(?s)<Command\s+name=""УП_[^""]*""[^>]*>.*?</Command>");
	РвИсп = Новый РегулярноеВыражение("(?s)\s*<Use>.*?</Use>\s*");
	РвФо = Новый РегулярноеВыражение("(?s)\s*<FunctionalOptions>.*?</FunctionalOptions>\s*");
	Рез = Текст;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Нов = РвИсп.Заменить(С.Значение, Символы.ПС);
		Нов = РвФо.Заменить(Нов, Символы.ПС);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция НужноВыноситьАтрибутыВКорень(ТекстForm, ЕстьСлойАтрибутовУп)
	ТипГл = ТипГлавногоРеквизитаФормы(ТекстForm);
	Если ТипГл = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	// ibcmd: главный реквизит в корне Form (исключение — два DynamicList: Список + УП_…).
	Если ТипГл = "cfg:DynamicList" И ЕстьСлойАтрибутовУп Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипГл = "cfg:DynamicList" И СтрНайти(ТекстForm, "<ManualQuery>true</ManualQuery>") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипГл = "cfg:DynamicList" Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипГл = "cfg:ConstantsSet" Тогда
		Возврат Истина;
	КонецЕсли;
	Если СтрНайти(ТипГл, "RecordManager") > 0 Или СтрНайти(ТипГл, "RecordSet") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	// ibcmd XDTO: объектные главные реквизиты — в корне Form (в BaseForm ломается Type).
	Если СтрНайти(ТипГл, "ChartOfCharacteristicTypesObject") > 0
		Или СтрНайти(ТипГл, "CatalogObject") > 0
		Или СтрНайти(ТипГл, "DocumentObject") > 0
		Или СтрНайти(ТипГл, "DataProcessorObject") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ТипГлавногоРеквизитаФормы(ТекстФормы)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?<MainAttribute>true</MainAttribute>.*?</Attribute>");
	РвТ = Новый РегулярноеВыражение("<v8:Type>([^<]*)</v8:Type>");
	Для Каждого С Из Рв.НайтиСовпадения(СтрЗаменить(ТекстФормы, Символы.ВК, "")) Цикл
		СТ = РвТ.НайтиСовпадения(С.Значение);
		Если СТ.Количество() > 0 Тогда
			Возврат СТ[0].Группы[1].Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ИсправитьПустыеТипыАтрибутов(Текст)
	Зам = "<Type><v8:Type>xs:string</v8:Type><v8:StringQualifiers><v8:Length>0</v8:Length><v8:AllowedLength>Variable</v8:AllowedLength></v8:StringQualifiers></Type>";
	Текст = СтрЗаменить(Текст, "<Type/>", Зам);
	Текст = СтрЗаменить(Текст, "<v8:Type>v8ui:Picture</v8:Type>", "<v8:Type>xs:string</v8:Type>");
	Возврат Текст;
КонецФункции

Функция ОчиститьПустыеFunctionalOptionsВАтрибутах(Текст)
	Рв = Новый РегулярноеВыражение("(?s)\s*<FunctionalOptions>(\s*<Item\s*/>\s*)+</FunctionalOptions>\s*");
	Текст = Рв.Заменить(Текст, Символы.ПС);
	РвП = Новый РегулярноеВыражение("(?s)\s*<FunctionalOptions>\s*</FunctionalOptions>\s*");
	Текст = РвП.Заменить(Текст, Символы.ПС);
	Возврат УпроститьАтрибутыУпВКорне(Текст);
КонецФункции

// View/Edit/FO с пустым name у УП_-реквизитов в корне Form — XDTO Type (ibcmd).
Функция УпроститьАтрибутыУпВКорне(Текст)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""УП_[^""]*""[^>]*>.*?</Attribute>");
	Рез = Текст;
	РвВ = Новый РегулярноеВыражение("(?s)\s*<View>.*?</View>\s*");
	РвЕ = Новый РегулярноеВыражение("(?s)\s*<Edit>.*?</Edit>\s*");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Нов = РвВ.Заменить(С.Значение, Символы.ПС);
		Нов = РвЕ.Заменить(Нов, Символы.ПС);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПрочитатьТекстUtf8(Путь) Экспорт
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат СтрЗаменить(Т.ПолучитьТекст(), Символы.ВК, "");
КонецФункции

Функция СтрокаКорняForm(Текст)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Каждого С Из Строки Цикл
		Если СтрНачинаетсяС(СокрЛ(С), "<Form ") Или СокрЛП(С) = "<Form>" Тогда
			Возврат С;
		КонецЕсли;
	КонецЦикла;
	Возврат "<Form>";
КонецФункции

Функция ВерсияForm(Текст)
	К = СтрокаКорняForm(Текст);
	П = СтрНайти(К, "version=""");
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Х = Сред(К, П + 9);
	Возврат Лев(Х, СтрНайти(Х, """") - 1);
КонецФункции

Функция ОбъединитьСлоиАтрибутов(СлойУп, СлойБаза)
	ВнутрУп = "";
	ВнутрБаза = "";
	Если СлойУп <> "" Тогда
		ВнутрУп = СтрЗаменить(СтрЗаменить(СлойУп, "	<Attributes>", ""), "	</Attributes>", "");
	КонецЕсли;
	Если СлойБаза <> "" Тогда
		ВнутрБаза = СтрЗаменить(СтрЗаменить(СлойБаза, "	<Attributes>", ""), "	</Attributes>", "");
	КонецЕсли;
	Если СокрЛП(ВнутрУп + ВнутрБаза) = "" Тогда
		Возврат "";
	КонецЕсли;
	Возврат "	<Attributes>" + Символы.ПС + ВнутрУп + ВнутрБаза + Символы.ПС + "	</Attributes>";
КонецФункции

// Главный реквизит (MainAttribute) — в корень Form; прочие реквизиты остаются в BaseForm (ibcmd: пути к данным).
Функция РазделитьАтрибутыТелоForm(Тело)
	Рез = Новый Структура("Тело, Атрибуты", Тело, "");
	Если СокрЛП(Тело) = "" Тогда
		Возврат Рез;
	КонецЕсли;
	РвБлок = Новый РегулярноеВыражение("(?s)\s*<Attributes>(.*?)</Attributes>\s*");
	С = РвБлок.НайтиСовпадения(Тело);
	Если С.Количество() = 0 Тогда
		Возврат Рез;
	КонецЕсли;
	Послед = С[С.Количество() - 1];
	Внутр = Послед.Группы[1].Значение;
	РвАтр = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""[^""]*""[^>]*>.*?</Attribute>");
	ВКорень = Новый Массив;
	ВБазе = Новый Массив;
	Для Каждого А Из РвАтр.НайтиСовпадения(Внутр) Цикл
		Если СтрНайти(А.Значение, "<MainAttribute>true</MainAttribute>") > 0 Тогда
			ВКорень.Добавить(А.Значение);
		Иначе
			ВБазе.Добавить(А.Значение);
		КонецЕсли;
	КонецЦикла;
	Если ВКорень.Количество() > 0 Тогда
		Рез.Атрибуты = "	<Attributes>" + Символы.ПС + СтрСоединить(ВКорень, Символы.ПС) + Символы.ПС + "	</Attributes>";
	КонецЕсли;
	НовБлок = "";
	Если ВБазе.Количество() > 0 Тогда
		НовБлок = Символы.ПС + "	<Attributes>" + Символы.ПС + СтрСоединить(ВБазе, Символы.ПС) + Символы.ПС + "	</Attributes>" + Символы.ПС;
	КонецЕсли;
	Рез.Тело = СтрЗаменить(Тело, Послед.Значение, НовБлок);
	Возврат Рез;
КонецФункции

Функция РазделитьАтрибутыТелаForm(Тело)
	Возврат РазделитьАтрибутыТелоForm(Тело);
КонецФункции

Функция ВнутренностьForm(Текст)
	Н = СтрНайти(Текст, "<Form");
	Если Н = 0 Тогда
		Возврат "";
	КонецЕсли;
	П1 = СтрНайти(Текст, ">", , Н);
	Если П1 = 0 Тогда
		Возврат "";
	КонецЕсли;
	П2 = 0;
	С = 1;
	Пока Истина Цикл
		След = СтрНайти(Текст, "</Form>", , С);
		Если След = 0 Тогда
			Прервать;
		КонецЕсли;
		П2 = След;
		С = След + 1;
	КонецЦикла;
	Если П2 = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Текст, П1 + 1, П2 - П1 - 1);
КонецФункции

Функция ВырезатьАтрибут(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Attribute>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция ИмяСПрефиксом(Имя, Префикс)
	Если Префикс <> "" И СтрНачинаетсяС(Имя, Префикс) Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат Префикс + Имя;
КонецФункции

// В заимствованной форме ibcmd строже к Picture: true без TransparentPixel — XDTO-ошибка.
// Пустой <Picture/> в заимствованных формах — XDTO Picture (ibcmd 8.5+).
Функция ИсправитьПустыеPicture(Текст) Экспорт
	Рв = Новый РегулярноеВыражение("(?s)<Picture>\s*</Picture>");
	Текст = Рв.Заменить(Текст, "");
	Возврат УбратьPictureDecorationБезPicture(Текст);
КонецФункции

Функция УбратьPictureDecorationБезPicture(Текст)
	Рв = Новый РегулярноеВыражение("(?s)<PictureDecoration\b[^>]*>.*?</PictureDecoration>");
	Рез = Текст;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Если СтрНайти(С.Значение, "<Picture>") = 0 Тогда
			Рез = СтрЗаменить(Рез, С.Значение, "");
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция НормализоватьPictureLoadTransparent(Текст) Экспорт
	Рез = Текст;
	Для Каждого ИмТег Из СтрРазделить("Picture,RowsPicture,HeaderPicture,ValuesPicture", ",") Цикл
		Рв = Новый РегулярноеВыражение("(?s)<" + ИмТег + ">\s*(.*?)\s*</" + ИмТег + ">");
		Для Каждого С Из Рв.НайтиСовпадения(Рез) Цикл
			Внутр = С.Группы[1].Значение;
			Если СтрНайти(Внутр, "LoadTransparent") = 0 Или СтрНайти(Внутр, "TransparentPixel") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(Внутр, "<xr:LoadTransparent>true</xr:LoadTransparent>") = 0 Тогда
				Продолжить;
			КонецЕсли;
			НовВнутр = СтрЗаменить(Внутр, "<xr:LoadTransparent>true</xr:LoadTransparent>", "<xr:LoadTransparent>false</xr:LoadTransparent>");
			БлокНов = СтрЗаменить(С.Значение, Внутр, НовВнутр);
			Рез = СтрЗаменить(Рез, С.Значение, БлокНов);
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

// ibcmd XDTO Picture: при LoadTransparent=false нужен TransparentPixel.
Функция ДобавитьTransparentPixelВPicture(Текст)
	Рез = Текст;
	Для Каждого Тег Из СтрРазделить("Picture,RowsPicture,HeaderPicture,ValuesPicture", ",") Цикл
		Рез = ДобавитьTransparentPixelВТегКартинки(Рез, Тег);
	КонецЦикла;
	Рез = СтрЗаменить(Рез, "<xr:LoadTransparent>true</xr:LoadTransparent>", "<xr:LoadTransparent>false</xr:LoadTransparent>");
	РвСл = Новый РегулярноеВыражение("(?m)(^(\s*)<xr:LoadTransparent>false</xr:LoadTransparent>)\r?\n<xr:TransparentPixel");
	Возврат РвСл.Заменить(Рез, "$1" + Символы.ПС + "$2<xr:TransparentPixel");
КонецФункции

Функция ДобавитьTransparentPixelВТегКартинки(Текст, ИмяТега)
	Рв = Новый РегулярноеВыражение("(?s)<" + ИмяТега + ">\s*(.*?)\s*</" + ИмяТега + ">");
	Рез = Текст;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		В = С.Группы[1].Значение;
		Если СтрНайти(В, "<xr:Ref>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(В, "TransparentPixel") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(В, "LoadTransparent") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Отступ = Символы.Таб + Символы.Таб;
		РвОт = Новый РегулярноеВыражение("(?m)^(\s*)<xr:Ref>");
		СО = РвОт.НайтиСовпадения(В);
		Если СО.Количество() > 0 Тогда
			Отступ = СО[0].Группы[1].Значение;
		КонецЕсли;
		Вн = В + Символы.ПС + Отступ + "<xr:TransparentPixel x=""0"" y=""0""/>";
		Нов = СтрЗаменить(С.Значение, В, Вн);
		Рез = СтрЗаменить(Рез, С.Значение, Нов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция МаксИдВТекстеForm(Текст)
	Рв = Новый РегулярноеВыражение(" id=""(\d+)""");
	Макс = 0;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Н = Число(С.Группы[1].Значение);
		Если Н > Макс Тогда
			Макс = Н;
		КонецЕсли;
	КонецЦикла;
	Возврат Макс;
КонецФункции

Функция ЗаменитьИдКоманды(Блок, НовИд)
	Рв = Новый РегулярноеВыражение("(<Command\s+name=""[^""]*"")\s+id=""\d+""");
	С = Рв.НайтиСовпадения(Блок);
	Если С.Количество() = 0 Тогда
		Возврат Блок;
	КонецЕсли;
	Возврат Рв.Заменить(Блок, "$1 id=""" + Формат(НовИд, "ЧГ=") + """");
КонецФункции

Функция ЗаменитьИдАтрибута(Блок, НовИд)
	Рв = Новый РегулярноеВыражение("(<Attribute\s+name=""[^""]*"")\s+id=""\d+""");
	С = Рв.НайтиСовпадения(Блок);
	Если С.Количество() = 0 Тогда
		Возврат Блок;
	КонецЕсли;
	Возврат Рв.Заменить(Блок, "$1 id=""" + Формат(НовИд, "ЧГ=") + """");
КонецФункции

Функция ПрефиксироватьАтрибут(Блок, СтароеИмя, Префикс)
	Нов = ИмяСПрефиксом(СтароеИмя, Префикс);
	Б = СтрЗаменить(Блок, "name=""" + СтароеИмя + """", "name=""" + Нов + """");
	Б = СтрЗаменить(Б, "<DataPath>" + СтароеИмя, "<DataPath>" + Нов);
	Б = СтрЗаменить(Б, "<DataPath>" + СтароеИмя + ".", "<DataPath>" + Нов + ".");
	Возврат Б;
КонецФункции

Функция СлойКомандыТолькоУп(ТУ, ТБ, Префикс)
	ИУ = ИменаКомандForm(ТУ);
	ИБ = ИменаКомандForm(ТБ);
	Доб = Новый Массив;
	Для Каждого ИмК Из ИУ Цикл
		Если ИБ.Найти(ИмК) = Неопределено Тогда
			Доб.Добавить(ИмК);
		КонецЕсли;
	КонецЦикла;
	Если Доб.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Блоки = Новый Массив;
	СледИд = МаксИдВТекстеForm(ТБ) + 2000;
	Для Каждого ИмК Из Доб Цикл
		Б = ВырезатьКоманду(ТУ, ИмК);
		Если Б <> "" Тогда
			Нов = ИмяСПрефиксом(ИмК, Префикс);
			Б = СтрЗаменить(Б, "name=""" + ИмК + """", "name=""" + Нов + """");
			Б = ЗаменитьИдКоманды(Б, СледИд);
			СледИд = СледИд + 1;
			Блоки.Добавить(Б);
		КонецЕсли;
	КонецЦикла;
	Если Блоки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "	<Commands>" + Символы.ПС + СтрСоединить(Блоки, Символы.ПС) + Символы.ПС + "	</Commands>";
КонецФункции

Функция ИменаКомандForm(Текст)
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("<Command\s+name=""([^""]+)""");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		ИмК = С.Группы[1].Значение;
		Если Р.Найти(ИмК) = Неопределено Тогда
			Р.Добавить(ИмК);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ВырезатьКоманду(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Command\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Command>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция СлойЭлементыУп(ПутьУп, ДобАтр, Префикс)
	Если ДобАтр.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Пр = Подключить("ПереносРеквизитовФормы.os");
	Фраг = Новый Массив;
	Уже = Новый Соответствие;
	Для Каждого Имя Из ДобАтр Цикл
		Для Каждого Э Из Пр.ЭлементыUiПоРеквизиту(ПутьУп, Имя) Цикл
			Если СокрЛП(Э) = "" Тогда
				Продолжить;
			КонецЕсли;
			К = Лев(Э, 200);
			Если Уже.Получить(К) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уже.Вставить(К, Истина);
			Фраг.Добавить(ПрефиксироватьФрагментUi(Э, Имя, ИмяСПрефиксом(Имя, Префикс)));
		КонецЦикла;
	КонецЦикла;
	Если Фраг.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "	<ChildItems>" + Символы.ПС + СтрСоединить(Фраг, Символы.ПС) + Символы.ПС + "	</ChildItems>";
КонецФункции

Функция ПрефиксироватьФрагментUi(Фраг, Старое, Новое)
	Р = Фраг;
	Р = СтрЗаменить(Р, "name=""" + Старое, "name=""" + Новое);
	Р = СтрЗаменить(Р, "<DataPath>" + Старое, "<DataPath>" + Новое);
	Р = СтрЗаменить(Р, "<DataPath>" + Старое + ".", "<DataPath>" + Новое + ".");
	Возврат "		" + СтрЗаменить(Р, Символы.ПС, Символы.ПС + "		");
КонецФункции

Функция ЭкранРв(С)
	Возврат СтрЗаменить(СтрЗаменить(С, "\", "\\"), """", "\""");
КонецФункции