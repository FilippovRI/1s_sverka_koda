// Form.xml: restored = БП; заимствованная форма расширения — BaseForm (полный БП) + слой УП (added, префикс).

Функция КаталогМодулей()
	К = ОбъединитьПути(ТекущийСценарий().Каталог, "АнализФорм.os");
	Если (Новый Файл(К)).Существует() Тогда
		Возврат ТекущийСценарий().Каталог;
	КонецЕсли;
	Возврат ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src");
КонецФункции

Функция Подключить(ИмяФайла)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(КаталогМодулей(), ИмяФайла));
КонецФункции

Функция ПеречислитьFormXmlПолный(Корень) Экспорт
	Аф = Подключить("АнализФорм.os");
	Р = Аф.ПеречислитьFormXml(Корень);
	Доп = ПеречислитьCommonForms(Корень);
	Для Каждого КЗ Из Доп Цикл
		Если Р.Получить(КЗ.Ключ) = Неопределено Тогда
			Р.Вставить(КЗ.Ключ, КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ПеречислитьCommonForms(Корень)
	Р = Новый Соответствие;
	Кат = ОбъединитьПути(Корень, "CommonForms");
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого П Из НайтиФайлы(Кат, "Form.xml", Истина) Цикл
		Отн = Сред(П.ПолноеИмя, СтрДлина(Корень) + 2);
		Р.Вставить(СтрЗаменить(Отн, "/", "\"), П.ПолноеИмя);
	КонецЦикла;
	Возврат Р;
КонецФункции

// Пишет Form.xml БП в restored для всех форм БП, существующих в УП (по пути). Пропускает уже записанные dynlist.
Функция ЗаписатьFormXmlБпВRestored(КореньУп, КореньБп, КаталогВосст, ПропускПутей, Лог) Экспорт
	ДС = Подключить("ЗапросыДинСписков.os");
	ДС.УстановитьКореньМетаданных(КореньУп);
	Раздел = ПолучитьРазделительПути();
	ФБп = ПеречислитьFormXmlПолный(КореньБп);
	ФУп = ПеречислитьFormXmlПолный(КореньУп);
	Стат = Новый Структура("written, cleaned, skippedDynlist, skippedNoUp", 0, 0, 0, 0);
	Для Каждого КЗ Из ФБп Цикл
		Отн = КЗ.Ключ;
		Если ФУп.Получить(Отн) = Неопределено Тогда
			Стат.skippedNoUp = Стат.skippedNoUp + 1;
			Продолжить;
		КонецЕсли;
		Если ПропускПутей <> Неопределено И ПропускПутей.Получить(Отн) <> Неопределено Тогда
			Стат.skippedDynlist = Стат.skippedDynlist + 1;
			Продолжить;
		КонецЕсли;
		Р = ДС.ПрочитатьСырой(КЗ.Значение);
		Если Р = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Оч = ОчиститьFormXmlОтсутствующиеТипы(Р.Текст, КореньУп, Отн, Лог);
		Текст = Оч.Текст;
		Если Оч.Удалено > 0 Тогда
			Стат.cleaned = Стат.cleaned + 1;
		КонецЕсли;
		ДС.ЗаписатьСырой(ОбъединитьПути(КаталогВосст, СтрЗаменить(Отн, "\", Раздел)), Текст, Р.BOM);
		Стат.written = Стат.written + 1;
	КонецЦикла;
	Лог.Добавить("forms restored: Form.xml БП записано " + Стат.written + ", очищено от ссылок нет в УП " + Стат.cleaned
		+ ", пропуск dynlist " + Стат.skippedDynlist + ", нет в УП " + Стат.skippedNoUp);
	Возврат Стат;
КонецФункции

Функция ОчиститьFormXmlОтсутствующиеТипы(Текст, КореньУп, ОтнПуть, Лог)
	Рез = Новый Структура("Текст, Удалено", Текст, 0);
	РвТип = Новый РегулярноеВыражение("<v8:Type>(cfg:[^<]+)</v8:Type>");
	РвАтр = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""([^""]+)""[^>]*>.*?</Attribute>");
	Для Каждого С Из РвАтр.НайтиСовпадения(Текст) Цикл
		Фраг = С.Значение;
		Невал = Ложь;
		Для Каждого Т Из РвТип.НайтиСовпадения(Фраг) Цикл
			Если Не ТипСуществуетВУп(КореньУп, Т.Группы[1].Значение) Тогда
				Невал = Истина;
				Лог.Добавить("forms clean: " + ОтнПуть + " — удалён реквизит " + С.Группы[1].Значение + " (тип " + Т.Группы[1].Значение + " нет в УП)");
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Невал Тогда
			Рез.Текст = СтрЗаменить(Рез.Текст, Фраг, "");
			Рез.Удалено = Рез.Удалено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ТипСуществуетВУп(КореньУп, Знач ТипCfg)
	ТипCfg = СокрЛП(ТипCfg);
	Если Лев(НРег(ТипCfg), 4) <> "cfg:" Тогда
		Возврат Истина;
	КонецЕсли;
	Х = Сред(ТипCfg, 5);
	П = СтрНайти(Х, ".");
	Если П = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Вид = Лев(Х, П - 1);
	Имя = Сред(Х, П + 1);
	Карта = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("Catalog:Catalogs,Document:Documents,Enum:Enums,InformationRegister:InformationRegisters,"
		+ "AccumulationRegister:AccumulationRegisters,ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,ChartOfAccounts:ChartsOfAccounts,"
		+ "ChartOfCalculationTypes:ChartsOfCalculationTypes,ExchangePlan:ExchangePlans,BusinessProcess:BusinessProcesses,Task:Tasks,"
		+ "CommonForm:CommonForms,Constant:Constants", ",") Цикл
		Ч = СтрРазделить(Пара, ":");
		Карта.Вставить(НРег(Ч[0]), Ч[1]);
	КонецЦикла;
	Кат = Карта.Получить(НРег(Вид));
	Если Кат = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Путь = ОбъединитьПути(КореньУп, Кат, Имя + ".xml");
	Возврат (Новый Файл(Путь)).Существует();
КонецФункции

// Раньше вырезали ссылки; теперь формы БП не режем — заготовки объектов вместо вырезания.
Функция ОчиститьFormXmlМетаданных(Текст, Корень, КореньУп, СоставОсн, ОтнПуть, Лог) Экспорт
	Возврат Новый Структура("Текст, Удалено, Изменён", Текст, 0, Ложь);
КонецФункции

// Заимствованная форма: BaseForm = полное тело Form БП; слой расширения — added УП (реквизиты, команды, фрагменты UI) с префиксом.
Функция XmlТелаЗаимствованнойФормыБпУп(ПутьFormXmlУп, ПутьFormXmlБп, Префикс) Экспорт
	Если ПутьFormXmlБп = "" Или Не (Новый Файл(ПутьFormXmlБп)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	ТУ = ПрочитатьТекстUtf8(ПутьFormXmlУп);
	ТБ = ПрочитатьТекстUtf8(ПутьFormXmlБп);
	Если ТБ = "" Тогда
		Возврат "";
	КонецЕсли;
	Аф = Подключить("АнализФорм.os");
	КУ = Аф.КартаРеквизитовFormXml(ПутьFormXmlУп);
	КБ = Аф.КартаРеквизитовFormXml(ПутьFormXmlБп);
	ДобАтр = Аф.ИменаТолькоВПервой(КУ, КБ);
	СлойАтр = "";
	Если ДобАтр.Количество() > 0 Тогда
		Блоки = Новый Массив;
		Для Каждого Имя Из ДобАтр Цикл
			Б = ВырезатьАтрибут(ТУ, Имя);
			Если Б <> "" Тогда
				Блоки.Добавить(ПрефиксироватьАтрибут(Б, Имя, Префикс));
			КонецЕсли;
		КонецЦикла;
		Если Блоки.Количество() > 0 Тогда
			СлойАтр = "	<Attributes>" + Символы.ПС + СтрСоединить(Блоки, Символы.ПС) + Символы.ПС + "	</Attributes>";
		КонецЕсли;
	КонецЕсли;
	СлойКом = СлойКомандыТолькоУп(ТУ, ТБ, Префикс);
	СлойЭл = СлойЭлементыУп(ПутьFormXmlУп, ДобАтр, Префикс);
	ТелоБп = НормализоватьPictureLoadTransparent(ВнутренностьForm(ТБ));
	Версия = ВерсияForm(ТБ);
	Корень = СтрокаКорняForm(ТБ);
	Ч = Новый Массив;
	Ч.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Ч.Добавить(Корень);
	Если СлойКом <> "" Тогда
		Ч.Добавить(СлойКом);
	КонецЕсли;
	Если СлойАтр <> "" Тогда
		Ч.Добавить(СлойАтр);
	КонецЕсли;
	Если СлойЭл <> "" Тогда
		Ч.Добавить(СлойЭл);
	КонецЕсли;
	Ч.Добавить("	<BaseForm" + ?(Версия = "", "", " version=""" + Версия + """") + ">");
	Для Каждого Стр Из СтрРазделить(ТелоБп, Символы.ПС, Истина) Цикл
		Ч.Добавить("	" + Стр);
	КонецЦикла;
	Ч.Добавить("	</BaseForm>");
	Ч.Добавить("</Form>");
	Т = СтрСоединить(Ч, Символы.ПС) + Символы.ПС;
	Т = НормализоватьPictureLoadTransparent(Т);
	РвПуст = Новый РегулярноеВыражение("(?s)\t<ChildItems>\s*</ChildItems>\s*");
	Возврат РвПуст.Заменить(Т, "");
КонецФункции

Функция ПрочитатьТекстUtf8(Путь)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат СтрЗаменить(Т.ПолучитьТекст(), Символы.ВК, "");
КонецФункции

Функция СтрокаКорняForm(Текст)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Каждого С Из Строки Цикл
		Если СтрНачинаетсяС(СокрЛ(С), "<Form ") Или СокрЛП(С) = "<Form>" Тогда
			Возврат С;
		КонецЕсли;
	КонецЦикла;
	Возврат "<Form>";
КонецФункции

Функция ВерсияForm(Текст)
	К = СтрокаКорняForm(Текст);
	П = СтрНайти(К, "version=""");
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Х = Сред(К, П + 9);
	Возврат Лев(Х, СтрНайти(Х, """") - 1);
КонецФункции

Функция ВнутренностьForm(Текст)
	Н = СтрНайти(Текст, "<Form");
	Если Н = 0 Тогда
		Возврат "";
	КонецЕсли;
	П1 = СтрНайти(Текст, ">", , Н);
	Если П1 = 0 Тогда
		Возврат "";
	КонецЕсли;
	П2 = 0;
	С = 1;
	Пока Истина Цикл
		След = СтрНайти(Текст, "</Form>", , С);
		Если След = 0 Тогда
			Прервать;
		КонецЕсли;
		П2 = След;
		С = След + 1;
	КонецЦикла;
	Если П2 = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Текст, П1 + 1, П2 - П1 - 1);
КонецФункции

Функция ВырезатьАтрибут(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Attribute\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Attribute>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция ИмяСПрефиксом(Имя, Префикс)
	Если Префикс <> "" И СтрНачинаетсяС(Имя, Префикс) Тогда
		Возврат Имя;
	КонецЕсли;
	Возврат Префикс + Имя;
КонецФункции

// В заимствованной форме ibcmd строже к Picture: true без TransparentPixel — XDTO-ошибка.
Функция НормализоватьPictureLoadTransparent(Текст) Экспорт
	Рв = Новый РегулярноеВыражение("(?s)<Picture>\s*(.*?)\s*</Picture>");
	Рез = Текст;
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		Внутр = С.Группы[1].Значение;
		Если СтрНайти(Внутр, "LoadTransparent") = 0 Или СтрНайти(Внутр, "TransparentPixel") > 0 Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(Внутр, "<xr:LoadTransparent>true</xr:LoadTransparent>") = 0 Тогда
			Продолжить;
		КонецЕсли;
		НовВнутр = СтрЗаменить(Внутр, "<xr:LoadTransparent>true</xr:LoadTransparent>", "<xr:LoadTransparent>false</xr:LoadTransparent>");
		БлокНов = СтрЗаменить(С.Значение, Внутр, НовВнутр);
		Рез = СтрЗаменить(Рез, С.Значение, БлокНов);
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПрефиксироватьАтрибут(Блок, СтароеИмя, Префикс)
	Нов = ИмяСПрефиксом(СтароеИмя, Префикс);
	Б = СтрЗаменить(Блок, "name=""" + СтароеИмя + """", "name=""" + Нов + """");
	Б = СтрЗаменить(Б, "<DataPath>" + СтароеИмя, "<DataPath>" + Нов);
	Б = СтрЗаменить(Б, "<DataPath>" + СтароеИмя + ".", "<DataPath>" + Нов + ".");
	Возврат Б;
КонецФункции

Функция СлойКомандыТолькоУп(ТУ, ТБ, Префикс)
	ИУ = ИменаКомандForm(ТУ);
	ИБ = ИменаКомандForm(ТБ);
	Доб = Новый Массив;
	Для Каждого ИмК Из ИУ Цикл
		Если ИБ.Найти(ИмК) = Неопределено Тогда
			Доб.Добавить(ИмК);
		КонецЕсли;
	КонецЦикла;
	Если Доб.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Блоки = Новый Массив;
	Для Каждого ИмК Из Доб Цикл
		Б = ВырезатьКоманду(ТУ, ИмК);
		Если Б <> "" Тогда
			Нов = ИмяСПрефиксом(ИмК, Префикс);
			Б = СтрЗаменить(Б, "name=""" + ИмК + """", "name=""" + Нов + """");
			Блоки.Добавить(Б);
		КонецЕсли;
	КонецЦикла;
	Если Блоки.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "	<Commands>" + Символы.ПС + СтрСоединить(Блоки, Символы.ПС) + Символы.ПС + "	</Commands>";
КонецФункции

Функция ИменаКомандForm(Текст)
	Р = Новый Массив;
	Рв = Новый РегулярноеВыражение("<Command\s+name=""([^""]+)""");
	Для Каждого С Из Рв.НайтиСовпадения(Текст) Цикл
		ИмК = С.Группы[1].Значение;
		Если Р.Найти(ИмК) = Неопределено Тогда
			Р.Добавить(ИмК);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ВырезатьКоманду(Текст, Имя)
	Рв = Новый РегулярноеВыражение("(?s)<Command\s+name=""" + ЭкранРв(Имя) + """[^>]*>.*?</Command>");
	С = Рв.НайтиСовпадения(Текст);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Значение;
КонецФункции

Функция СлойЭлементыУп(ПутьУп, ДобАтр, Префикс)
	Если ДобАтр.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Пр = Подключить("ПереносРеквизитовФормы.os");
	Фраг = Новый Массив;
	Уже = Новый Соответствие;
	Для Каждого Имя Из ДобАтр Цикл
		Для Каждого Э Из Пр.ЭлементыUiПоРеквизиту(ПутьУп, Имя) Цикл
			Если СокрЛП(Э) = "" Тогда
				Продолжить;
			КонецЕсли;
			К = Лев(Э, 200);
			Если Уже.Получить(К) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Уже.Вставить(К, Истина);
			Фраг.Добавить(ПрефиксироватьФрагментUi(Э, Имя, ИмяСПрефиксом(Имя, Префикс)));
		КонецЦикла;
	КонецЦикла;
	Если Фраг.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат "	<ChildItems>" + Символы.ПС + СтрСоединить(Фраг, Символы.ПС) + Символы.ПС + "	</ChildItems>";
КонецФункции

Функция ПрефиксироватьФрагментUi(Фраг, Старое, Новое)
	Р = Фраг;
	Р = СтрЗаменить(Р, "name=""" + Старое, "name=""" + Новое);
	Р = СтрЗаменить(Р, "<DataPath>" + Старое, "<DataPath>" + Новое);
	Р = СтрЗаменить(Р, "<DataPath>" + Старое + ".", "<DataPath>" + Новое + ".");
	Возврат "		" + СтрЗаменить(Р, Символы.ПС, Символы.ПС + "		");
КонецФункции

Функция ЭкранРв(С)
	Возврат СтрЗаменить(СтрЗаменить(С, "\", "\\"), """", "\""");
КонецФункции