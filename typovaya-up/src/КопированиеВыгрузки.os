// Массовое копирование дерева выгрузки (cp/rsync/robocopy); откат — рекурсия пофайлово.

Функция Кав(Путь)
	Возврат """" + СтрЗаменить(Путь, """", "\""") + """";
КонецФункции

Функция ЭтоWindows()
	Попытка
		С = Новый СистемнаяИнформация;
		Возврат СтрНайти(НРег(Строка(С.ВерсияОС)), "windows") > 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция КодВозвратаОК(Код, Robocopy = Ложь)
	Если Robocopy Тогда
		Возврат Код >= 0 И Код <= 7;
	КонецЕсли;
	Возврат Код = 0;
КонецФункции

// СтрокаКоманды — одна строка для sh -c / cmd.
Функция ИсполнитьShell(СтрокаКоманды, Robocopy = Ложь)
	Код = 0;
	Попытка
		К = Новый КомандаОС();
		К.УстановитьКоманду(СтрокаКоманды);
		К.ИспользоватьВыводКакРезультат = Истина;
		К.Исполнить();
		Код = К.КодВозврата;
	Исключение
		Если ЭтоWindows() Тогда
			ЗапуститьПриложение("cmd.exe /c " + СтрокаКоманды, "", Истина, Код);
		Иначе
			ЗапуститьПриложение(СтрокаКоманды, "", Истина, Код);
		КонецЕсли;
	КонецПопытки;
	Возврат КодВозвратаОК(Код, Robocopy);
КонецФункции

Процедура СкопироватьРекурсивно(Откуда, Куда) Экспорт
	КопироватьКаталогРек(Откуда, Куда);
КонецПроцедуры

Процедура КопироватьКаталогРек(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Ложь) Цикл
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталогРек(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		Иначе
			КопироватьФайл(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Истина — сработала внешняя команда; Ложь — откат на КопироватьКаталогРек.
Функция ПопытатьсяShellКопию(Откуда, Куда, Лог)
	СоздатьКаталог(Куда);
	Если ЭтоWindows() Тогда
		Стр = "robocopy " + Кав(Откуда) + " " + Кав(Куда) + " /E /NFL /NDL /NJH /NJS /nc /ns /np /R:2 /W:1";
		Ок = ИсполнитьShell(Стр, Истина);
	Иначе
		Стр = "cp -a " + Кав(Откуда) + "/. " + Кав(Куда);
		Ок = ИсполнитьShell(Стр);
		Если Не Ок Тогда
			Стр = "rsync -a " + Кав(Откуда) + "/" + " " + Кав(Куда) + "/";
			Ок = ИсполнитьShell(Стр);
		КонецЕсли;
	КонецЕсли;
	Если Ок Тогда
		Если Лог <> Неопределено Тогда
			Лог.Добавить("копирование: shell " + ?(ЭтоWindows(), "robocopy", "cp/rsync") + " " + Откуда + " → " + Куда);
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
	Если Лог <> Неопределено Тогда
		Лог.Добавить("ПРЕДУПРЕЖДЕНИЕ: shell-копия не удалась — пофайловое копирование");
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Копирует всю выгрузку Откуда в существующий/пустой Куда.
Функция СкопироватьДерево(Откуда, Куда, Лог = Неопределено) Экспорт
	Если Не (Новый Файл(Откуда)).Существует() Тогда
		ВызватьИсключение "КопированиеВыгрузки: нет каталога " + Откуда;
	КонецЕсли;
	Если ПопытатьсяShellКопию(Откуда, Куда, Лог) Тогда
		Возврат "shell";
	КонецЕсли;
	КопироватьКаталогРек(Откуда, Куда);
	Если Лог <> Неопределено Тогда
		Лог.Добавить("копирование: рекурсия пофайлово " + Откуда + " → " + Куда);
	КонецЕсли;
	Возврат "recursive";
КонецФункции