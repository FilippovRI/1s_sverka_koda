// Чтение XML настроек сравнения/объединения Конфигуратора
// (xmlns http://v8.1c.ru/8.3/config/merge/settings).
// Нас интересуют объекты, у которых отмечены свойства-модули: из них строится периметр сравнения.

Перем КаталогиТипов;
Перем СвойстваМодулей;

// Читает merge settings XML и строит периметр путей .bsl.
//
// Параметры:
//   Путь — полный путь к XML; файл должен существовать (иначе исключение ЧтениеXML).
//   Лог — Массив; при нестандартной связи конфигураций добавляется предупреждение.
//
// Возвращаемое значение:
//   Структура: Основная, Вторая, Связь, Пути (Соответствие отн.путь → описание),
//   ВсегоОбъектов, НеСопоставлено (число Property без разрешённого пути).
Функция ПрочитатьНастройки(Знач Путь, Лог) Экспорт
	Результат = НовыйРезультатНастроек();
	Контекст = Новый Структура("Раздел, ТекущийОбъект", "", Неопределено);
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Путь);
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ОбработатьНачалоЭлемента(Чтение, Результат, Контекст);
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ОбработатьКонецЭлемента(Чтение.ЛокальноеИмя, Контекст);
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();
	ЗафиксироватьСвязьВЛоге(Результат.Связь, Лог);
	Возврат Результат;
КонецФункции

Функция НовыйРезультатНастроек()
	Возврат Новый Структура("Основная, Вторая, Связь, Пути, ВсегоОбъектов, НеСопоставлено", "", "", "",
		Новый Соответствие, 0, 0);
КонецФункции

Процедура ЗафиксироватьСвязьВЛоге(Связь, Лог)
	Если Связь = "" Или Связь = "ConfigurationsNotRelated" Тогда
		Возврат;
	КонецЕсли;
	Лог.Добавить("Связь конфигураций в настройках: " + Связь + " (сопоставление всё равно по полным именам).");
КонецПроцедуры

Процедура ОбработатьНачалоЭлемента(Чтение, Результат, Контекст)
	Имя = Чтение.ЛокальноеИмя;
	Если ЭтоРазделКонфигурации(Имя) Тогда
		Контекст.Раздел = Имя;
		Возврат;
	КонецЕсли;
	Если Имя = "Name" И Контекст.Раздел <> "" И Контекст.ТекущийОбъект = Неопределено Тогда
		ПрочитатьИмяКонфигурацииИзУзла(Чтение, Контекст.Раздел, Результат);
		Возврат;
	КонецЕсли;
	Если Имя = "ConfigurationsRelation" Тогда
		Чтение.Прочитать();
		Результат.Связь = Чтение.Значение;
		Возврат;
	КонецЕсли;
	Если Имя = "Object" Тогда
		Контекст.ТекущийОбъект = НовыйОбъектНастроек(Чтение);
		Результат.ВсегоОбъектов = Результат.ВсегоОбъектов + 1;
		Возврат;
	КонецЕсли;
	Если Имя = "Configuration" И Контекст.Раздел = "" Тогда
		Контекст.ТекущийОбъект = Новый Структура("ИмяОбъекта, Сторона", "Configuration", "исходная");
		Возврат;
	КонецЕсли;
	Если Имя = "Property" И Контекст.ТекущийОбъект <> Неопределено Тогда
		ДобавитьСвойствоМодуля(Чтение, Контекст.ТекущийОбъект, Результат);
	КонецЕсли;
КонецПроцедуры

Функция ЭтоРазделКонфигурации(Имя)
	Возврат Имя = "MainConfiguration" Или Имя = "SecondConfiguration";
КонецФункции

Процедура ПрочитатьИмяКонфигурацииИзУзла(Чтение, Раздел, Результат)
	Чтение.Прочитать();
	Если Раздел = "MainConfiguration" Тогда
		Результат.Основная = Чтение.Значение;
	Иначе
		Результат.Вторая = Чтение.Значение;
	КонецЕсли;
КонецПроцедуры

Функция НовыйОбъектНастроек(Чтение)
	ИмяОбъекта = Чтение.ЗначениеАтрибута("fullName");
	Сторона = "исходная";
	Если ИмяОбъекта = Неопределено Тогда
		ИмяОбъекта = Чтение.ЗначениеАтрибута("fullNameInSecondConfiguration");
		Сторона = "поставщик";
	КонецЕсли;
	Возврат Новый Структура("ИмяОбъекта, Сторона", ИмяОбъекта, Сторона);
КонецФункции

Процедура ДобавитьСвойствоМодуля(Чтение, ТекущийОбъект, Результат)
	ИмяСвойства = Чтение.ЗначениеАтрибута("name");
	Если СвойстваМодулей.Найти(ИмяСвойства) = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОтнПуть = ПутьМодуля(ТекущийОбъект.ИмяОбъекта, ИмяСвойства);
	Если ОтнПуть = Неопределено Тогда
		Результат.НеСопоставлено = Результат.НеСопоставлено + 1;
		Возврат;
	КонецЕсли;
	Результат.Пути.Вставить(ОтнПуть, Новый Структура("object, property, side",
		ТекущийОбъект.ИмяОбъекта, ИмяСвойства, ТекущийОбъект.Сторона));
КонецПроцедуры

Процедура ОбработатьКонецЭлемента(Имя, Контекст)
	Если Имя = "Object" Или (Имя = "Configuration" И Контекст.Раздел = "") Тогда
		Контекст.ТекущийОбъект = Неопределено;
	ИначеЕсли ЭтоРазделКонфигурации(Имя) Тогда
		Контекст.Раздел = "";
	КонецЕсли;
КонецПроцедуры

// Преобразует fullName объекта метаданных и имя свойства-модуля в относительный путь .bsl.
//
// Параметры:
//   ИмяОбъекта — например Catalog.Банки или Document.Счет.Command.Печать.
//   Свойство — Module, ObjectModule, CommandModule, …
//
// Возвращаемое значение:
//   Строка пути или Неопределено, если тип/структура не поддерживается.
Функция ПутьМодуля(Знач ИмяОбъекта, Знач Свойство) Экспорт
	Если ИмяОбъекта = "Configuration" Тогда
		Возврат "Ext\" + Свойство + ".bsl";
	КонецЕсли;
	Части = СтрРазделить(ИмяОбъекта, ".");
	Каталог = КаталогиТипов.Получить(Части[0]);
	Если Каталог = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	База = Каталог + "\" + Части[1];
	Если Части.Количество() = 2 Тогда
		Возврат База + "\Ext\" + Свойство + ".bsl";
	ИначеЕсли Части.Количество() = 4 И Части[2] = "Command" Тогда
		Возврат База + "\Commands\" + Части[3] + "\Ext\" + Свойство + ".bsl";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Каталог выгрузки (Catalogs, Documents, …) → тип метаданных для отчёта.
Функция ТипПоКаталогу(Знач Каталог) Экспорт
	Для Каждого КЗ Из КаталогиТипов Цикл
		Если КЗ.Значение = Каталог Тогда
			Возврат КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	Если Каталог = "Ext" Тогда
		Возврат "Configuration";
	КонецЕсли;
	Возврат Каталог;
КонецФункции

КаталогиТипов = Новый Соответствие;
Для Каждого Пара Из СтрРазделить("WSReference:WSReferences,Constant:Constants,CommonCommand:CommonCommands,CommonForm:CommonForms,"
	+ "ExchangePlan:ExchangePlans,ChartOfAccounts:ChartsOfAccounts,Report:Reports,Enum:Enums,DocumentJournal:DocumentJournals,"
	+ "Catalog:Catalogs,FilterCriterion:FilterCriteria,Task:Tasks,Subsystem:Subsystems,InformationRegister:InformationRegisters,"
	+ "Document:Documents,ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,ChartOfCalculationTypes:ChartsOfCalculationTypes,"
	+ "DataProcessor:DataProcessors,CalculationRegister:CalculationRegisters,HTTPService:HTTPServices,BusinessProcess:BusinessProcesses,"
	+ "WebService:WebServices,CommonModule:CommonModules,AccumulationRegister:AccumulationRegisters,AccountingRegister:AccountingRegisters,"
	+ "SettingsStorage:SettingsStorages", ",") Цикл
	КЗ = СтрРазделить(Пара, ":");
	КаталогиТипов.Вставить(КЗ[0], КЗ[1]);
КонецЦикла;
СвойстваМодулей = СтрРазделить("Module,ManagerModule,ObjectModule,CommandModule,RecordSetModule,ValueManagerModule,"
	+ "ManagedApplicationModule,OrdinaryApplicationModule,SessionModule,ExternalConnectionModule", ",");
