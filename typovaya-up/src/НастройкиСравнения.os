// Чтение XML настроек сравнения/объединения Конфигуратора
// (xmlns http://v8.1c.ru/8.3/config/merge/settings).
// Нас интересуют объекты, у которых отмечены свойства-модули: из них строится периметр сравнения.

Перем КаталогиТипов;
Перем СвойстваМодулей;

// Возвращает структуру: Основная, Вторая, Связь, Пути (Соответствие ОтнПуть -> Описание), ВсегоОбъектов.
Функция ПрочитатьНастройки(Знач Путь, Лог) Экспорт

	Результат = Новый Структура("Основная, Вторая, Связь, Пути, ВсегоОбъектов, НеСопоставлено", "", "", "", Новый Соответствие, 0, 0);
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(Путь);

	ТекущийОбъект = Неопределено; // Структура ИмяОбъекта, Сторона
	Раздел = "";
	ТекущееСвойство = "";
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "MainConfiguration" ИЛИ Имя = "SecondConfiguration" Тогда
				Раздел = Имя;
			ИначеЕсли Имя = "Name" И Раздел <> "" И ТекущийОбъект = Неопределено Тогда
				Чтение.Прочитать();
				Если Раздел = "MainConfiguration" Тогда
					Результат.Основная = Чтение.Значение;
				Иначе
					Результат.Вторая = Чтение.Значение;
				КонецЕсли;
			ИначеЕсли Имя = "ConfigurationsRelation" Тогда
				Чтение.Прочитать();
				Результат.Связь = Чтение.Значение;
			ИначеЕсли Имя = "Object" Тогда
				Результат.ВсегоОбъектов = Результат.ВсегоОбъектов + 1;
				ИмяОбъекта = Чтение.ЗначениеАтрибута("fullName");
				Сторона = "исходная";
				Если ИмяОбъекта = Неопределено Тогда
					ИмяОбъекта = Чтение.ЗначениеАтрибута("fullNameInSecondConfiguration");
					Сторона = "поставщик";
				КонецЕсли;
				ТекущийОбъект = Новый Структура("ИмяОбъекта, Сторона", ИмяОбъекта, Сторона);
			ИначеЕсли Имя = "Configuration" И Раздел = "" Тогда
				ТекущийОбъект = Новый Структура("ИмяОбъекта, Сторона", "Configuration", "исходная");
			ИначеЕсли Имя = "Property" И ТекущийОбъект <> Неопределено Тогда
				ИмяСвойства = Чтение.ЗначениеАтрибута("name");
				Если СвойстваМодулей.Найти(ИмяСвойства) <> Неопределено Тогда
					ОтнПуть = ПутьМодуля(ТекущийОбъект.ИмяОбъекта, ИмяСвойства);
					Если ОтнПуть = Неопределено Тогда
						Результат.НеСопоставлено = Результат.НеСопоставлено + 1;
					Иначе
						Результат.Пути.Вставить(ОтнПуть, Новый Структура("object, property, side",
							ТекущийОбъект.ИмяОбъекта, ИмяСвойства, ТекущийОбъект.Сторона));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Имя = Чтение.ЛокальноеИмя;
			Если Имя = "Object" ИЛИ (Имя = "Configuration" И Раздел = "") Тогда
				ТекущийОбъект = Неопределено;
			ИначеЕсли Имя = "MainConfiguration" ИЛИ Имя = "SecondConfiguration" Тогда
				Раздел = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Чтение.Закрыть();

	Если Результат.Связь <> "" И Результат.Связь <> "ConfigurationsNotRelated" Тогда
		Лог.Добавить("Связь конфигураций в настройках: " + Результат.Связь + " (сопоставление всё равно по полным именам).");
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Catalog.Банки + ObjectModule -> Catalogs\Банки\Ext\ObjectModule.bsl
Функция ПутьМодуля(Знач ИмяОбъекта, Знач Свойство) Экспорт
	Если ИмяОбъекта = "Configuration" Тогда
		Возврат "Ext\" + Свойство + ".bsl";
	КонецЕсли;
	Части = СтрРазделить(ИмяОбъекта, ".");
	Каталог = КаталогиТипов.Получить(Части[0]);
	Если Каталог = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	База = Каталог + "\" + Части[1];
	Если Части.Количество() = 2 Тогда
		Возврат База + "\Ext\" + Свойство + ".bsl";
	ИначеЕсли Части.Количество() = 4 И Части[2] = "Command" Тогда
		Возврат База + "\Commands\" + Части[3] + "\Ext\" + Свойство + ".bsl";
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Каталог выгрузки -> тип метаданных (для дерева в отчёте).
Функция ТипПоКаталогу(Знач Каталог) Экспорт
	Для Каждого КЗ Из КаталогиТипов Цикл
		Если КЗ.Значение = Каталог Тогда
			Возврат КЗ.Ключ;
		КонецЕсли;
	КонецЦикла;
	Если Каталог = "Ext" Тогда
		Возврат "Configuration";
	КонецЕсли;
	Возврат Каталог;
КонецФункции

КаталогиТипов = Новый Соответствие;
Для Каждого Пара Из СтрРазделить("WSReference:WSReferences,Constant:Constants,CommonCommand:CommonCommands,CommonForm:CommonForms,"
	+ "ExchangePlan:ExchangePlans,ChartOfAccounts:ChartsOfAccounts,Report:Reports,Enum:Enums,DocumentJournal:DocumentJournals,"
	+ "Catalog:Catalogs,FilterCriterion:FilterCriteria,Task:Tasks,Subsystem:Subsystems,InformationRegister:InformationRegisters,"
	+ "Document:Documents,ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,ChartOfCalculationTypes:ChartsOfCalculationTypes,"
	+ "DataProcessor:DataProcessors,CalculationRegister:CalculationRegisters,HTTPService:HTTPServices,BusinessProcess:BusinessProcesses,"
	+ "WebService:WebServices,CommonModule:CommonModules,AccumulationRegister:AccumulationRegisters,AccountingRegister:AccountingRegisters,"
	+ "SettingsStorage:SettingsStorages", ",") Цикл
	КЗ = СтрРазделить(Пара, ":");
	КаталогиТипов.Вставить(КЗ[0], КЗ[1]);
КонецЦикла;
СвойстваМодулей = СтрРазделить("Module,ManagerModule,ObjectModule,CommandModule,RecordSetModule,ValueManagerModule,"
	+ "ManagedApplicationModule,OrdinaryApplicationModule,SessionModule,ExternalConnectionModule", ",");
