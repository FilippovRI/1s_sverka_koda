// Реквизиты/ТЧ/значения перечислений, на которые ссылается код модулей объекта/менеджера ЗАИМСТВОВАННЫХ объектов
// расширения: модуль заимствованного объекта видит только заимствованные дочерние элементы («Переменная не
// определена» в CheckModules расширения). Заимствуются только элементы, которые ЕСТЬ в основной (restored);
// отсутствующие в основной не добавляются (правило 23.11 — они в todo_missing_metadata). Типы заимствованных
// реквизитов заимствуются объектами основной. Механизм — ЗаимствованиеПолейСписков (режим модулей).

Функция Применить(КаталогРасш, КаталогВосст, ИмяРасширения, Лог, КаталогОтчёта = "") Экспорт
	Кат = ТекущийСценарий().Каталог;
	Зп = ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЗаимствованиеПолейСписков.os"));
	Зп.УстановитьЧерновик(ЗагрузитьСценарий(ОбъединитьПути(Кат, "ЧерновикРасширения.os")));
	Корни = Новый Массив;
	Корни.Добавить(КаталогВосст);
	Р = Зп.Применить(КаталогРасш, КаталогВосст, ИмяРасширения, Истина, Корни);
	Лог.Добавить("Модули заимствованных объектов: заимствовано реквизитов/ТЧ/значений " + Р.addedChildren.Количество()
		+ ", объектов (типы реквизитов) " + Р.addedObjects.Количество());
	Если КаталогОтчёта <> "" Тогда
		Строки = Новый Массив;
		Для Каждого С Из Р.addedChildren Цикл
			Строки.Добавить("child;" + С);
		КонецЦикла;
		Для Каждого С Из Р.addedObjects Цикл
			Строки.Добавить("object;" + С);
		КонецЦикла;
		Если Строки.Количество() > 0 Тогда
			ПолучитьДвоичныеДанныеИзСтроки(СтрСоединить(Строки, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС, КодировкаТекста.UTF8, Истина)
				.Записать(ОбъединитьПути(КаталогОтчёта, "extension_module_fields_adopted.csv"));
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("children, objects", Р.addedChildren.Количество(), Р.addedObjects.Количество());
КонецФункции
