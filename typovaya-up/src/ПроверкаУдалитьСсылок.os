// Ссылки в .bsl на метаданные, у которых сегмент начинается с «Удалить».
// Источник истины — Configuration.xml и XML объектов цели и расширения.
// Автозамена имён в коде не делается. Хуки &Вместо — только по явному флагу.

Перем Разбор;
Перем ТипыСлов; // НРег(слово) -> Структура(Тег, Папка)
Перем Навигация; // НРег(слово) -> режим разбора пути
Перем Объекты; // НРег(Тег)|НРег(Имя) -> Истина
Перем КэшДетей; // Папка|НРег(Имя) -> дети объекта
Перем КэшРазбора; // норм. путь -> методы и вызовы
Перем Корни; // массив структур Корень, Метка
Перем СписокОбработчиков; // регистрации Обработчик.Процедура из *ОбновлениеИнформационнойБазы*

// Ищет ссылки, пишет report/deleted_refs.md и .csv.
// ГенерироватьХуки — &Вместо обработчиков обновления, которые доходят до отсутствующего Удалить*
// (без ПродолжитьВызов). По умолчанию выключено.
//
// Параметры:
//   КореньЦели — каталог выгрузки, в которую загружают обновление (restored).
//   КореньРасширения — каталог расширения; пустая строка, если расширения нет.
//   КаталогВывода — куда положить report/.
//   ГенерироватьХуки — Истина: дописать хуки в расширение.
//
// Возвращаемое значение:
//   Структура withAnalog, noAnalog, hooks — числа строк отчёта и записанных хуков.
Функция Проверить(КореньЦели, КореньРасширения, КаталогВывода, ГенерироватьХуки = Ложь) Экспорт
	Разбор = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "РазборМетодов.os"));
	ИнициализироватьТипы();
	Объекты = Новый Соответствие;
	КэшДетей = Новый Соответствие;
	КэшРазбора = Новый Соответствие;
	Корни = Новый Массив;
	Если КореньЦели <> "" И (Новый Файл(ОбъединитьПути(КореньЦели, "Configuration.xml"))).Существует() Тогда
		Корни.Добавить(Новый Структура("Корень, Метка", КореньЦели, "цель"));
	КонецЕсли;
	Если КореньРасширения <> "" И (Новый Файл(ОбъединитьПути(КореньРасширения, "Configuration.xml"))).Существует() Тогда
		Корни.Добавить(Новый Структура("Корень, Метка", КореньРасширения, "расширение"));
	КонецЕсли;
	Для Каждого Кр Из Корни Цикл
		ПрочитатьСостав(Кр.Корень);
	КонецЦикла;
	Попадания = Новый Массив;
	СписокОбработчиков = Новый Массив;
	Для Каждого Кр Из Корни Цикл
		Сообщить("удалить-ссылки: обход " + Кр.Метка + " " + Кр.Корень);
		Файлы = НайтиФайлы(Кр.Корень, "*.bsl", Истина);
		Сообщить("удалить-ссылки: модулей " + Файлы.Количество());
		Для Каждого Ф Из Файлы Цикл
			ОбойтиМодуль(Ф.ПолноеИмя, Кр, Попадания);
		КонецЦикла;
	КонецЦикла;
	Сообщить("удалить-ссылки: вхождений " + Попадания.Количество() + ", обработчиков обновления " + СписокОбработчиков.Количество());
	ПривязатьОбработчики(Попадания, СписокОбработчиков);
	СтрокиОтчёта = ОтобратьСтроки(Попадания);
	ЗаписатьОтчёт(КаталогВывода, СтрокиОтчёта);
	ЧислоХуков = 0;
	Если ГенерироватьХуки = Истина И КореньРасширения <> "" Тогда
		ЧислоХуков = ЗаписатьХуки(КореньЦели, КореньРасширения, СтрокиОтчёта);
	КонецЕсли;
	САналогом = 0;
	БезАналога = 0;
	Для Каждого Стр Из СтрокиОтчёта Цикл
		Если Стр.Секция = "analog" Тогда
			САналогом = САналогом + 1;
		Иначе
			БезАналога = БезАналога + 1;
		КонецЕсли;
	КонецЦикла;
	Сообщить("удалить-ссылки: нет в метаданных, аналог есть — " + САналогом + "; без аналога — " + БезАналога
		+ "; хуков " + ЧислоХуков);
	Возврат Новый Структура("withAnalog, noAnalog, hooks", САналогом, БезАналога, ЧислоХуков);
КонецФункции

Процедура ИнициализироватьТипы()
	ТипыСлов = Новый Соответствие;
	Навигация = Новый Соответствие;
	ДобавитьТип("Document", "Documents", "Документ,Документы,Document,Documents");
	ДобавитьТип("Catalog", "Catalogs", "Справочник,Справочники,Catalog,Catalogs");
	ДобавитьТип("Enum", "Enums", "Перечисление,Перечисления,Enum,Enums");
	ДобавитьТип("InformationRegister", "InformationRegisters", "РегистрСведений,РегистрыСведений,InformationRegister,InformationRegisters");
	ДобавитьТип("AccumulationRegister", "AccumulationRegisters", "РегистрНакопления,РегистрыНакопления,AccumulationRegister,AccumulationRegisters");
	ДобавитьТип("AccountingRegister", "AccountingRegisters", "РегистрБухгалтерии,РегистрыБухгалтерии,AccountingRegister,AccountingRegisters");
	ДобавитьТип("CalculationRegister", "CalculationRegisters", "РегистрРасчета,РегистрыРасчета,CalculationRegister,CalculationRegisters");
	ДобавитьТип("ChartOfAccounts", "ChartsOfAccounts", "ПланСчетов,ПланыСчетов,ChartOfAccounts,ChartsOfAccounts");
	ДобавитьТип("ChartOfCharacteristicTypes", "ChartsOfCharacteristicTypes", "ПланВидовХарактеристик,ПланыВидовХарактеристик,ChartOfCharacteristicTypes,ChartsOfCharacteristicTypes");
	ДобавитьТип("ChartOfCalculationTypes", "ChartsOfCalculationTypes", "ПланВидовРасчета,ПланыВидовРасчета,ChartOfCalculationTypes,ChartsOfCalculationTypes");
	ДобавитьТип("BusinessProcess", "BusinessProcesses", "БизнесПроцесс,БизнесПроцессы,BusinessProcess,BusinessProcesses");
	ДобавитьТип("Task", "Tasks", "Задача,Задачи,Task,Tasks");
	ДобавитьТип("Report", "Reports", "Отчет,Отчеты,Отчёт,Отчёты,Report,Reports");
	ДобавитьТип("DataProcessor", "DataProcessors", "Обработка,Обработки,DataProcessor,DataProcessors");
	ДобавитьТип("CommonModule", "CommonModules", "ОбщийМодуль,ОбщиеМодули,CommonModule,CommonModules");
	ДобавитьТип("Constant", "Constants", "Константа,Константы,Constant,Constants");
	ДобавитьТип("ExchangePlan", "ExchangePlans", "ПланОбмена,ПланыОбмена,ExchangePlan,ExchangePlans");
	ДобавитьТип("DocumentJournal", "DocumentJournals", "ЖурналДокументов,ЖурналыДокументов,DocumentJournal,DocumentJournals");
	ДобавитьТип("FilterCriterion", "FilterCriteria", "КритерийОтбора,КритерииОтбора,FilterCriterion,FilterCriteria");
	ДобавитьТип("Sequence", "Sequences", "Последовательность,Последовательности,Sequence,Sequences");
	ДобавитьТип("CommonForm", "CommonForms", "ОбщаяФорма,ОбщиеФормы,CommonForm,CommonForms");
	ДобавитьТип("CommonPicture", "CommonPictures", "ОбщаяКартинка,ОбщиеКартинки,CommonPicture,CommonPictures");
	ДобавитьТип("CommonTemplate", "CommonTemplates", "ОбщийМакет,ОбщиеМакеты,CommonTemplate,CommonTemplates");
	ДобавитьТип("CommonCommand", "CommonCommands", "ОбщаяКоманда,ОбщиеКоманды,CommonCommand,CommonCommands");
	ДобавитьТип("CommandGroup", "CommandGroups", "ГруппаКоманд,ГруппыКоманд,CommandGroup,CommandGroups");
	ДобавитьТип("DefinedType", "DefinedTypes", "ОпределяемыйТип,ОпределяемыеТипы,DefinedType,DefinedTypes");
	ДобавитьТип("FunctionalOption", "FunctionalOptions", "ФункциональнаяОпция,ФункциональныеОпции,FunctionalOption,FunctionalOptions");
	ДобавитьТип("SessionParameter", "SessionParameters", "ПараметрСеанса,ПараметрыСеанса,SessionParameter,SessionParameters");
	ДобавитьТип("SettingsStorage", "SettingsStorages", "ХранилищеНастроек,ХранилищаНастроек,SettingsStorage,SettingsStorages");
	ДобавитьТип("ExternalDataSource", "ExternalDataSources", "ВнешнийИсточникДанных,ВнешниеИсточникиДанных,ExternalDataSource,ExternalDataSources");
	ДобавитьТип("Role", "Roles", "Роль,Роли,Role,Roles");
	ДобавитьТип("Subsystem", "Subsystems", "Подсистема,Подсистемы,Subsystem,Subsystems");
	ДобавитьТип("WebService", "WebServices", "WebСервис,WebСервисы,ВебСервис,ВебСервисы,WebService,WebServices");
	ДобавитьТип("HTTPService", "HTTPServices", "HTTPСервис,HTTPСервисы,HTTPService,HTTPServices");
	ДобавитьТип("WSReference", "WSReferences", "WSСсылка,WSСсылки,WSReference,WSReferences");
	ДобавитьТип("XDTOPackage", "XDTOPackages", "ПакетXDTO,ПакетыXDTO,XDTOPackage,XDTOPackages");
	ДобавитьТип("DocumentNumerator", "DocumentNumerators", "НумераторДокументов,НумераторыДокументов,DocumentNumerator,DocumentNumerators");
	ДобавитьТип("CommonAttribute", "CommonAttributes", "ОбщийРеквизит,ОбщиеРеквизиты,CommonAttribute,CommonAttributes");
	ДобавитьСуффиксыТипа();
	Для Каждого Пара Из СтрРазделить("ЗначенияПеречисления:значение,EnumValues:значение,ЗначениеПеречисления:значение,"
		+ "Реквизиты:реквизит,Attributes:реквизит,Реквизит:реквизит,Attribute:реквизит,"
		+ "Измерения:реквизит,Dimensions:реквизит,Измерение:реквизит,Dimension:реквизит,"
		+ "Ресурсы:реквизит,Resources:реквизит,Ресурс:реквизит,Resource:реквизит,"
		+ "ТабличныеЧасти:тч,TabularSections:тч,ТабличнаяЧасть:тч,TabularSection:тч,"
		+ "Формы:форма,Forms:форма,Команды:команда,Commands:команда,Макеты:макет,Templates:макет,"
		+ "Предопределенные:предопр,Predefined:предопр", ",") Цикл
		КЗ = СтрРазделить(Пара, ":");
		Навигация.Вставить(НРег(КЗ[0]), КЗ[1]);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьТип(Тег, Папка, Имена)
	Описание = Новый Структура("Тег, Папка", Тег, Папка);
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		ТипыСлов.Вставить(НРег(Имя), Описание);
	КонецЦикла;
КонецПроцедуры

// ДокументСсылка / DocumentRef и соседние формы типа — тот же объект метаданных.
Процедура ДобавитьСуффиксыТипа()
	Суффиксы = Новый Соответствие;
	Суффиксы.Вставить("Document", "Документ:Document");
	Суффиксы.Вставить("Catalog", "Справочник:Catalog");
	Суффиксы.Вставить("Enum", "Перечисление:Enum");
	Суффиксы.Вставить("InformationRegister", "РегистрСведений:InformationRegister");
	Суффиксы.Вставить("AccumulationRegister", "РегистрНакопления:AccumulationRegister");
	Суффиксы.Вставить("AccountingRegister", "РегистрБухгалтерии:AccountingRegister");
	Суффиксы.Вставить("CalculationRegister", "РегистрРасчета:CalculationRegister");
	Суффиксы.Вставить("ChartOfAccounts", "ПланСчетов:ChartOfAccounts");
	Суффиксы.Вставить("ChartOfCharacteristicTypes", "ПланВидовХарактеристик:ChartOfCharacteristicTypes");
	Суффиксы.Вставить("ChartOfCalculationTypes", "ПланВидовРасчета:ChartOfCalculationTypes");
	Суффиксы.Вставить("BusinessProcess", "БизнесПроцесс:BusinessProcess");
	Суффиксы.Вставить("Task", "Задача:Task");
	Суффиксы.Вставить("ExchangePlan", "ПланОбмена:ExchangePlan");
	ХвостыРу = СтрРазделить("Ссылка,Объект,Менеджер,Выборка,Список", ",");
	ХвостыEn = СтрРазделить("Ref,Object,Manager,Selection,List", ",");
	Для Каждого КЗ Из Суффиксы Цикл
		База = ТипыСлов.Получить(НРег(СтрРазделить(КЗ.Значение, ":")[1]));
		Если База = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Основы = СтрРазделить(КЗ.Значение, ":");
		Для Каждого Хвост Из ХвостыРу Цикл
			ТипыСлов.Вставить(НРег(Основы[0] + Хвост), База);
		КонецЦикла;
		Для Каждого Хвост Из ХвостыEn Цикл
			ТипыСлов.Вставить(НРег(Основы[1] + Хвост), База);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ПрочитатьСостав(Корень)
	Путь = ОбъединитьПути(Корень, "Configuration.xml");
	Текст = ПрочитатьТекст(Путь);
	Нач = СтрНайти(Текст, "<ChildObjects>");
	Кон = 0;
	Курсор = 1;
	Пока Курсор <= СтрДлина(Текст) Цикл
		Н = НайтиС(Текст, "</ChildObjects>", Курсор);
		Если Н = 0 Тогда
			Прервать;
		КонецЕсли;
		Кон = Н;
		Курсор = Н + 1;
	КонецЦикла;
	Если Нач = 0 Или Кон = 0 Или Кон < Нач Тогда
		Возврат;
	КонецЕсли;
	Блок = Сред(Текст, Нач, Кон - Нач);
	Рв = Новый РегулярноеВыражение("<([A-Za-z]+)>([^<]+)</\1>");
	Для Каждого Совп Из Рв.НайтиСовпадения(Блок) Цикл
		Тег = Совп.Группы[1].Значение;
		Имя = СокрЛП(Совп.Группы[2].Значение);
		Если Имя <> "" И ТипыСлов.Получить(НРег(Тег)) <> Неопределено Тогда
			Объекты.Вставить(НРег(Тег) + "|" + НРег(Имя), Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбойтиМодуль(Путь, Кр, Попадания)
	Текст = ПрочитатьТекст(Путь);
	Если Текст = "" Тогда
		Возврат;
	КонецЕсли;
	ФайлОбработчиков = СтрНайти(НРег(Путь), НРег("ОбновлениеИнформационнойБазы")) > 0;
	ЕстьУдалить = СтрНайти(Текст, "далит") > 0 Или СтрНайти(Текст, "ДАЛИТ") > 0;
	Если Не ФайлОбработчиков И Не ЕстьУдалить Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Если ФайлОбработчиков Тогда
		СобратьОбработчики(Строки, Путь);
	КонецЕсли;
	Если Не ЕстьУдалить Тогда
		Возврат;
	КонецЕсли;
	ТекМетод = "";
	ТекВид = "";
	Отн = ОтносительныйПуть(Кр.Корень, Путь);
	Для Й = 0 По Строки.ВГраница() Цикл
		Объявление = ОбъявлениеМетода(Строки, Й);
		Если Объявление <> Неопределено Тогда
			ТекМетод = Объявление.Имя;
			ТекВид = Объявление.Вид;
		ИначеЕсли ТекМетод <> "" И Разбор.ЭтоМаркерКонцаМетода(Строки[Й], ?(ТекВид = "Функция", "конецфункции", "конецпроцедуры")) Тогда
			ТекМетод = "";
			ТекВид = "";
			Продолжить;
		КонецЕсли;
		Код = Разбор.УбратьКомментарий(Строки[Й]);
		Если СтрНайти(НРег(Код), "удалить") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Цепочка Из ЦепочкиВСтроке(Код) Цикл
			РазборЦепочки = РазобратьСсылку(Цепочка.Цепочка, Цепочка.Хвост);
			Если РазборЦепочки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Попадания.Добавить(Новый Структура(
				"Путь, НормПуть, Метка, Модуль, Строка, Метод, Ссылка, Аналог, Есть, ЕстьАналог, Обработчик",
				Путь, НормПуть(Путь), Кр.Метка, Кр.Метка + "/" + Отн, Й + 1, ТекМетод,
				РазборЦепочки.Ссылка, РазборЦепочки.Аналог, РазборЦепочки.Есть, РазборЦепочки.ЕстьАналог, ""));
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ОбъявлениеМетода(Строки, Й)
	Стр = Строки[Й];
	Код = СокрЛП(Разбор.УбратьКомментарий(Стр));
	Н = НРег(Код);
	Если Не (СтрНачинаетсяС(Н, "процедура ") Или СтрНачинаетсяС(Н, "функция ") Или СтрНачинаетсяС(Н, "асинх ")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СтрНайти(Код, "(") = 0 Тогда
		Лимит = Мин(Й + 4, Строки.ВГраница());
		Для К = Й + 1 По Лимит Цикл
			Стр = Стр + " " + СокрЛП(Разбор.УбратьКомментарий(Строки[К]));
			Если СтрНайти(Стр, "(") > 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Разбор.РазобратьОбъявление(Стр);
КонецФункции

Функция ЦепочкиВСтроке(Код)
	Рез = Новый Массив;
	Низ = НРег(Код);
	Поз = 1;
	Дл = СтрДлина(Код);
	Пока Поз <= Дл Цикл
		Н = НайтиС(Низ, ".удалить", Поз);
		Если Н = 0 Тогда
			Прервать;
		КонецЕсли;
		Начало = Н;
		Пока Начало > 1 Цикл
			Сим = Сред(Код, Начало - 1, 1);
			Если Не ЭтоСимволИмени(Сим) И Сим <> "." Тогда
				Прервать;
			КонецЕсли;
			Начало = Начало - 1;
		КонецЦикла;
		Если Сред(Код, Начало, 1) = "." Тогда
			Начало = Начало + 1;
		КонецЕсли;
		Конец = Н + 1;
		Пока Конец <= Дл Цикл
			Сим = Сред(Код, Конец, 1);
			Если Не ЭтоСимволИмени(Сим) И Сим <> "." Тогда
				Прервать;
			КонецЕсли;
			Конец = Конец + 1;
		КонецЦикла;
		Цепочка = Сред(Код, Начало, Конец - Начало);
		Пока СтрЗаканчиваетсяНа(Цепочка, ".") Цикл
			Цепочка = Лев(Цепочка, СтрДлина(Цепочка) - 1);
		КонецЦикла;
		Рез.Добавить(Новый Структура("Цепочка, Хвост", Цепочка, Сред(Код, Конец)));
		Поз = Конец;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция РазобратьСсылку(Цепочка, Хвост)
	Части = СтрРазделить(Цепочка, ".");
	Если Части.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если НРег(Части[0]) = "метаданные" Или НРег(Части[0]) = "metadata" Тогда
		Части.Удалить(0);
	КонецЕсли;
	Если Части.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Описание = ТипыСлов.Получить(НРег(Части[0]));
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	СловоТипа = Части[0];
	Части.Удалить(0);
	Если ЭтоВызов(Хвост) И СтрНачинаетсяС(НРег(Части[Части.ВГраница()]), "удалить") Тогда
		Части.Удалить(Части.ВГраница());
	КонецЕсли;
	Если Части.Количество() = 0 Или Не ЕстьСегментУдалить(Части) Тогда
		Возврат Неопределено;
	КонецЕсли;
	АналогЧасти = Новый Массив;
	ПустойАналог = Ложь;
	Для Каждого Сег Из Части Цикл
		Снятый = СнятьПрефиксУдалить(Сег);
		Если СтрНачинаетсяС(НРег(Сег), "удалить") И Снятый = "" Тогда
			ПустойАналог = Истина;
		КонецЕсли;
		АналогЧасти.Добавить(Снятый);
	КонецЦикла;
	Есть = ПутьЕсть(Описание, Части, Части);
	ЕстьАналог = Не ПустойАналог И ПутьЕсть(Описание, АналогЧасти, Части);
	Если Есть И ЕстьАналог Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ссылка = СловоТипа + "." + СтрСоединить(Части, ".");
	Аналог = "";
	Если ЕстьАналог Тогда
		Аналог = СловоТипа + "." + СтрСоединить(АналогЧасти, ".");
	КонецЕсли;
	Возврат Новый Структура("Ссылка, Аналог, Есть, ЕстьАналог", Ссылка, Аналог, Есть, ЕстьАналог);
КонецФункции

Функция ЕстьСегментУдалить(Части)
	Для Каждого Сег Из Части Цикл
		Если СтрНачинаетсяС(НРег(Сег), "удалить") Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ЭтоВызов(Хвост)
	Возврат СтрНачинаетсяС(СокрЛ(Хвост), "(");
КонецФункции

Функция СнятьПрефиксУдалить(Имя)
	Если СтрДлина(Имя) > 7 И СтрНачинаетсяС(НРег(Имя), "удалить") Тогда
		Возврат Сред(Имя, 8);
	КонецЕсли;
	Возврат Имя;
КонецФункции

Функция ПутьЕсть(Описание, Сегменты, Оригинал)
	Если Сегменты.Количество() = 0 Или Сегменты.Количество() <> Оригинал.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Сегменты[0] = "" Или Не ОбъектЕсть(Описание.Тег, Сегменты[0]) Тогда
		Возврат Ложь;
	КонецЕсли;
	Дети = Неопределено;
	Режим = "свободно";
	ИмяТЧ = "";
	Й = 1;
	Пока Й < Сегменты.Количество() Цикл
		Сег = Сегменты[Й];
		Обязателен = СтрНачинаетсяС(НРег(Оригинал[Й]), "удалить");
		Нав = Навигация.Получить(НРег(Сег));
		Если Нав <> Неопределено И Не Обязателен Тогда
			Если Режим = "послеТЧ" И Нав = "реквизит" Тогда
				Режим = "реквизитТЧ";
			Иначе
				Режим = Нав;
			КонецЕсли;
			Й = Й + 1;
			Продолжить;
		КонецЕсли;
		Если Дети = Неопределено Тогда
			Дети = ДетиОбъекта(Описание.Папка, Сегменты[0]);
		КонецЕсли;
		Если Режим = "значение" Или (Описание.Тег = "Enum" И (Режим = "свободно" Или Режим = "послеТЧ")) Тогда
			Если Не ИмяВ(Дети.Значения, Сег) Тогда
				Возврат Ложь;
			КонецЕсли;
			Режим = "хвост";
		ИначеЕсли Режим = "реквизит" Тогда
			Если Не ИмяВ(Дети.Реквизиты, Сег) Тогда
				Возврат Ложь;
			КонецЕсли;
			Режим = "хвост";
		ИначеЕсли Режим = "тч" Тогда
			Если Дети.Табличные.Получить(НРег(Сег)) = Неопределено Тогда
				Возврат Ложь;
			КонецЕсли;
			ИмяТЧ = Сег;
			Режим = "послеТЧ";
		ИначеЕсли Режим = "реквизитТЧ" Тогда
			Реки = Дети.Табличные.Получить(НРег(ИмяТЧ));
			Если Реки = Неопределено Или Не ИмяВ(Реки, Сег) Тогда
				Возврат Ложь;
			КонецЕсли;
			Режим = "хвост";
		ИначеЕсли Режим = "форма" Или Режим = "команда" Или Режим = "макет" Или Режим = "предопр" Тогда
			Карта = КартаРежима(Дети, Режим);
			Если Не ИмяВ(Карта, Сег) Тогда
				Возврат Ложь;
			КонецЕсли;
			Режим = "хвост";
		ИначеЕсли Режим = "свободно" Или Режим = "послеТЧ" Тогда
			Если Обязателен И Режим = "послеТЧ" Тогда
				Реки = Дети.Табличные.Получить(НРег(ИмяТЧ));
				Если Реки = Неопределено Или Не ИмяВ(Реки, Сег) Тогда
					Возврат Ложь;
				КонецЕсли;
				Режим = "хвост";
			ИначеЕсли Обязателен Тогда
				Если Не РебёнокЕсть(Дети, Сег) Тогда
					Возврат Ложь;
				КонецЕсли;
				Если Дети.Табличные.Получить(НРег(Сег)) <> Неопределено Тогда
					ИмяТЧ = Сег;
					Режим = "послеТЧ";
				Иначе
					Режим = "хвост";
				КонецЕсли;
			ИначеЕсли Режим = "свободно" И Дети.Табличные.Получить(НРег(Сег)) <> Неопределено Тогда
				ИмяТЧ = Сег;
				Режим = "послеТЧ";
			ИначеЕсли РебёнокЕсть(Дети, Сег) Тогда
				Режим = "хвост";
			Иначе
				Возврат Истина;
			КонецЕсли;
		Иначе
			Если Обязателен Тогда
				Возврат Ложь;
			КонецЕсли;
			Возврат Истина;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция КартаРежима(Дети, Режим)
	Если Режим = "форма" Тогда
		Возврат Дети.Формы;
	ИначеЕсли Режим = "команда" Тогда
		Возврат Дети.Команды;
	ИначеЕсли Режим = "макет" Тогда
		Возврат Дети.Макеты;
	КонецЕсли;
	Возврат Дети.Предопределенные;
КонецФункции

Функция РебёнокЕсть(Дети, Имя)
	Возврат ИмяВ(Дети.Реквизиты, Имя) Или Дети.Табличные.Получить(НРег(Имя)) <> Неопределено
		Или ИмяВ(Дети.Предопределенные, Имя) Или ИмяВ(Дети.Формы, Имя)
		Или ИмяВ(Дети.Команды, Имя) Или ИмяВ(Дети.Макеты, Имя);
КонецФункции

Функция ИмяВ(Карта, Имя)
	Возврат Карта <> Неопределено И Карта.Получить(НРег(Имя)) <> Неопределено;
КонецФункции

Функция ОбъектЕсть(Тег, Имя)
	Возврат Объекты.Получить(НРег(Тег) + "|" + НРег(Имя)) <> Неопределено;
КонецФункции

Функция ДетиОбъекта(Папка, Имя)
	Ключ = НРег(Папка) + "|" + НРег(Имя);
	Готово = КэшДетей.Получить(Ключ);
	Если Готово <> Неопределено Тогда
		Возврат Готово;
	КонецЕсли;
	Дети = НовыеДети();
	Для Каждого Кр Из Корни Цикл
		ДочитатьДетей(ОбъединитьПути(Кр.Корень, Папка, Имя + ".xml"), Дети);
		ДочитатьПредопределенные(ОбъединитьПути(ОбъединитьПути(Кр.Корень, Папка, Имя, "Ext"), "Predefined.xml"), Дети);
	КонецЦикла;
	КэшДетей.Вставить(Ключ, Дети);
	Возврат Дети;
КонецФункции

Функция НовыеДети()
	Возврат Новый Структура("Значения, Реквизиты, Табличные, Предопределенные, Формы, Команды, Макеты",
		Новый Соответствие, Новый Соответствие, Новый Соответствие, Новый Соответствие,
		Новый Соответствие, Новый Соответствие, Новый Соответствие);
КонецФункции

Процедура ДочитатьДетей(Путь, Дети)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Текст = ПрочитатьТекст(Путь);
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь);
	Стек = Новый Массив;
	ЖдуИмя = Ложь;
	Для Каждого Стр Из Строки Цикл
		Низ = НРег(СокрЛ(Стр));
		Если СтрНачинаетсяС(Низ, "<enumvalue") Тогда
			Стек.Добавить(Новый Структура("Вид, Имя", "enum", ""));
			ЖдуИмя = Истина;
		ИначеЕсли СтрНачинаетсяС(Низ, "<attribute") Или СтрНачинаетсяС(Низ, "<dimension") Или СтрНачинаетсяС(Низ, "<resource") Тогда
			Стек.Добавить(Новый Структура("Вид, Имя", "attr", ""));
			ЖдуИмя = Истина;
		ИначеЕсли СтрНачинаетсяС(Низ, "<tabularsection") Тогда
			Стек.Добавить(Новый Структура("Вид, Имя", "ts", ""));
			ЖдуИмя = Истина;
		ИначеЕсли СтрНачинаетсяС(Низ, "<form ") Или Низ = "<form>" Тогда
			ИмяКратко = ИмяОдногоТега(Стр, "Form");
			Если ИмяКратко <> "" Тогда
				Дети.Формы.Вставить(НРег(ИмяКратко), ИмяКратко);
			Иначе
				Стек.Добавить(Новый Структура("Вид, Имя", "form", ""));
				ЖдуИмя = Истина;
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Низ, "<command ") Или Низ = "<command>" Тогда
			ИмяКратко = ИмяОдногоТега(Стр, "Command");
			Если ИмяКратко <> "" Тогда
				Дети.Команды.Вставить(НРег(ИмяКратко), ИмяКратко);
			Иначе
				Стек.Добавить(Новый Структура("Вид, Имя", "command", ""));
				ЖдуИмя = Истина;
			КонецЕсли;
		ИначеЕсли СтрНачинаетсяС(Низ, "<template ") Или Низ = "<template>" Тогда
			ИмяКратко = ИмяОдногоТега(Стр, "Template");
			Если ИмяКратко <> "" Тогда
				Дети.Макеты.Вставить(НРег(ИмяКратко), ИмяКратко);
			Иначе
				Стек.Добавить(Новый Структура("Вид, Имя", "template", ""));
				ЖдуИмя = Истина;
			КонецЕсли;
		ИначеЕсли ЖдуИмя И СтрНайти(Низ, "<name>") > 0 И Стек.Количество() > 0 Тогда
			Имя = ТекстТега(Стр, "Name");
			Если Имя <> "" Тогда
				Верх = Стек[Стек.ВГраница()];
				Верх.Имя = Имя;
				Если Верх.Вид = "enum" Тогда
					Дети.Значения.Вставить(НРег(Имя), Имя);
				ИначеЕсли Верх.Вид = "attr" Тогда
					Приёмник = Дети.Реквизиты;
					Й = Стек.ВГраница() - 1;
					Пока Й >= 0 Цикл
						Если Стек[Й].Вид = "ts" И Стек[Й].Имя <> "" Тогда
							Если Дети.Табличные.Получить(НРег(Стек[Й].Имя)) = Неопределено Тогда
								Дети.Табличные.Вставить(НРег(Стек[Й].Имя), Новый Соответствие);
							КонецЕсли;
							Приёмник = Дети.Табличные.Получить(НРег(Стек[Й].Имя));
							Прервать;
						КонецЕсли;
						Й = Й - 1;
					КонецЦикла;
					Приёмник.Вставить(НРег(Имя), Имя);
				ИначеЕсли Верх.Вид = "ts" Тогда
					Если Дети.Табличные.Получить(НРег(Имя)) = Неопределено Тогда
						Дети.Табличные.Вставить(НРег(Имя), Новый Соответствие);
					КонецЕсли;
				ИначеЕсли Верх.Вид = "form" Тогда
					Дети.Формы.Вставить(НРег(Имя), Имя);
				ИначеЕсли Верх.Вид = "command" Тогда
					Дети.Команды.Вставить(НРег(Имя), Имя);
				ИначеЕсли Верх.Вид = "template" Тогда
					Дети.Макеты.Вставить(НРег(Имя), Имя);
				КонецЕсли;
			КонецЕсли;
			ЖдуИмя = Ложь;
		ИначеЕсли СтрНачинаетсяС(Низ, "</enumvalue>") Или СтрНачинаетсяС(Низ, "</attribute>")
			Или СтрНачинаетсяС(Низ, "</dimension>") Или СтрНачинаетсяС(Низ, "</resource>")
			Или СтрНачинаетсяС(Низ, "</tabularsection>") Или СтрНачинаетсяС(Низ, "</form>")
			Или СтрНачинаетсяС(Низ, "</command>") Или СтрНачинаетсяС(Низ, "</template>") Тогда
			Если Стек.Количество() > 0 Тогда
				Стек.Удалить(Стек.ВГраница());
			КонецЕсли;
			ЖдуИмя = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ДочитатьПредопределенные(Путь, Дети)
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Текст = ПрочитатьТекст(Путь);
	Рв = Новый РегулярноеВыражение("<Name>([^<]*)</Name>");
	Для Каждого Совп Из Рв.НайтиСовпадения(Текст) Цикл
		Имя = СокрЛП(Совп.Группы[1].Значение);
		Если Имя <> "" Тогда
			Дети.Предопределенные.Вставить(НРег(Имя), Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИмяОдногоТега(Стр, ИмяТега)
	Рв = Новый РегулярноеВыражение("<" + ИмяТега + ">([^<]*)</" + ИмяТега + ">");
	Совп = Рв.НайтиСовпадения(Стр);
	Если Совп.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Совп[0].Группы[1].Значение);
КонецФункции

Функция ТекстТега(Стр, ИмяТега)
	Низ = НРег(Стр);
	Отк = "<" + НРег(ИмяТега) + ">";
	Зак = "</" + НРег(ИмяТега) + ">";
	П = СтрНайти(Низ, Отк);
	Если П = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Стр, П + СтрДлина(Отк));
	К = СтрНайти(НРег(Хвост), Зак);
	Если К = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Лев(Хвост, К - 1));
КонецФункции

Процедура СобратьОбработчики(Строки, Путь)
	Версия = "";
	ЖдуПроцедуру = Ложь;
	Для Каждого Стр Из Строки Цикл
		Код = Разбор.УбратьКомментарий(Стр);
		Низ = НРег(Код);
		Если СтрНайти(Низ, "обработчики.добавить") > 0 Тогда
			Версия = "";
			ЖдуПроцедуру = Ложь;
		КонецЕсли;
		Если СтрНайти(Низ, "обработчик.версия") > 0 Тогда
			Кавычка = ТекстВКавычках(Код);
			Если Кавычка <> Неопределено Тогда
				Версия = Кавычка;
			КонецЕсли;
		КонецЕсли;
		Если ЖдуПроцедуру Тогда
			Кавычка = ТекстВКавычках(Код);
			Если Кавычка <> Неопределено Тогда
				ЗапомнитьОбработчик(Кавычка, Версия, Путь);
				ЖдуПроцедуру = Ложь;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Если СтрНайти(Низ, "обработчик.процедура") > 0 Тогда
			Кавычка = ТекстВКавычках(Код);
			Если Кавычка = Неопределено Тогда
				ЖдуПроцедуру = Истина;
			Иначе
				ЗапомнитьОбработчик(Кавычка, Версия, Путь);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗапомнитьОбработчик(ИмяПроцедуры, Версия, ПутьФайла)
	Имя = СокрЛП(ИмяПроцедуры);
	Если Имя = "" Тогда
		Возврат;
	КонецЕсли;
	СписокОбработчиков.Добавить(Новый Структура("ИмяПроцедуры, Версия, Файл", Имя, СокрЛП(Версия), ПутьФайла));
КонецПроцедуры

Функция ТекстВКавычках(Код)
	П = СтрНайти(Код, """");
	Если П = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Хвост = Сред(Код, П + 1);
	К = СтрНайти(Хвост, """");
	Если К = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Лев(Хвост, К - 1);
КонецФункции

Процедура ПривязатьОбработчики(Попадания, СписокОбработчиков)
	Достижимость = Новый Соответствие;
	Для Каждого Обр Из СписокОбработчиков Цикл
		Цель = РазрешитьПроцедуру(Обр.ИмяПроцедуры);
		Если Цель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОбойтиВызовы(Цель.Путь, Цель.Метод, Обр, Достижимость);
	КонецЦикла;
	Для Каждого Попад Из Попадания Цикл
		Ключ = НормПуть(Попад.Путь) + "|" + НРег(Попад.Метод);
		Список = Достижимость.Получить(Ключ);
		Текст = "";
		Если Список <> Неопределено Тогда
			Имена = Новый Массив;
			Для Каждого Обр Из Список Цикл
				Если Обр.Версия = "" Тогда
					Имена.Добавить(Обр.ИмяПроцедуры);
				Иначе
					Имена.Добавить(Обр.Версия + "/" + Обр.ИмяПроцедуры);
				КонецЕсли;
			КонецЦикла;
			Текст = СтрСоединить(Имена, "; ");
		КонецЕсли;
		Попад.Обработчик = Текст;
	КонецЦикла;
КонецПроцедуры

Процедура ОбойтиВызовы(Путь, ИмяМетода, Обр, Достижимость)
	Очередь = Новый Массив;
	Очередь.Добавить(Новый Структура("Путь, Метод, Глубина", Путь, ИмяМетода, 0));
	Посещено = Новый Соответствие;
	Шаг = 0;
	Пока Очередь.Количество() > 0 И Шаг < 400 Цикл
		Эл = Очередь[0];
		Очередь.Удалить(0);
		Ключ = НормПуть(Эл.Путь) + "|" + НРег(Эл.Метод);
		Если Посещено.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Посещено.Вставить(Ключ, Истина);
		Шаг = Шаг + 1;
		Список = Достижимость.Получить(Ключ);
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Достижимость.Вставить(Ключ, Список);
		КонецЕсли;
		Уже = Ложь;
		Для Каждого Было Из Список Цикл
			Если Было.ИмяПроцедуры = Обр.ИмяПроцедуры И Было.Версия = Обр.Версия Тогда
				Уже = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не Уже Тогда
			Список.Добавить(Обр);
		КонецЕсли;
		Если Эл.Глубина >= 8 Или НеРаскрыватьМодуль(Эл.Путь) Тогда
			Продолжить;
		КонецЕсли;
		РазборФ = РазборФайла(Эл.Путь);
		Если РазборФ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вызовы = РазборФ.Вызовы.Получить(НРег(Эл.Метод));
		Если Вызовы = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Вызов Из Вызовы Цикл
			Куда = РазрешитьВызов(Эл.Путь, РазборФ, Вызов);
			Если Куда <> Неопределено Тогда
				Очередь.Добавить(Новый Структура("Путь, Метод, Глубина", Куда.Путь, Куда.Метод, Эл.Глубина + 1));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция РазборФайла(Путь)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ключ = НормПуть(Путь);
	Готово = КэшРазбора.Получить(Ключ);
	Если Готово <> Неопределено Тогда
		Возврат Готово;
	КонецЕсли;
	Дерево = Разбор.РазобратьМодуль(ПрочитатьТекст(Путь));
	Вызовы = Новый Соответствие;
	Имена = Новый Соответствие;
	Для Каждого Мт Из Дерево.Методы Цикл
		Имена.Вставить(Мт.Ключ, Мт);
		Вызовы.Вставить(Мт.Ключ, ВызовыМетода(Мт.Текст));
	КонецЦикла;
	Готово = Новый Структура("Методы, Вызовы, Имена", Дерево.Методы, Вызовы, Имена);
	КэшРазбора.Вставить(Ключ, Готово);
	Возврат Готово;
КонецФункции

Функция ВызовыМетода(Текст)
	Рез = Новый Массив;
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Для Каждого Стр Из Строки Цикл
		Код = Разбор.УбратьКомментарий(Стр);
		Дл = СтрДлина(Код);
		Й = 1;
		Пока Й <= Дл Цикл
			Если Сред(Код, Й, 1) <> "(" Тогда
				Й = Й + 1;
				Продолжить;
			КонецЕсли;
			К = Й - 1;
			Пока К >= 1 И (Сред(Код, К, 1) = " " Или Сред(Код, К, 1) = Символы.Таб) Цикл
				К = К - 1;
			КонецЦикла;
			КонецИмени = К;
			Пока К >= 1 И ЭтоСимволИмени(Сред(Код, К, 1)) Цикл
				К = К - 1;
			КонецЦикла;
			Если КонецИмени < К + 1 Тогда
				Й = Й + 1;
				Продолжить;
			КонецЕсли;
			Метод = Сред(Код, К + 1, КонецИмени - К);
			Владелец = "";
			ТипСлово = "";
			Если К >= 1 И Сред(Код, К, 1) = "." Тогда
				К = К - 1;
				КонецВл = К;
				Пока К >= 1 И ЭтоСимволИмени(Сред(Код, К, 1)) Цикл
					К = К - 1;
				КонецЦикла;
				Владелец = Сред(Код, К + 1, КонецВл - К);
				Если К >= 1 И Сред(Код, К, 1) = "." Тогда
					К = К - 1;
					КонецТ = К;
					Пока К >= 1 И ЭтоСимволИмени(Сред(Код, К, 1)) Цикл
						К = К - 1;
					КонецЦикла;
					ТипСлово = Сред(Код, К + 1, КонецТ - К);
				КонецЕсли;
			КонецЕсли;
			Если Метод <> "" Тогда
				Рез.Добавить(Новый Структура("ТипСлово, Владелец, Метод", ТипСлово, Владелец, Метод));
			КонецЕсли;
			Й = Й + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция РазрешитьВызов(ПутьФайла, РазборФ, Вызов)
	Если Вызов.Владелец = "" Тогда
		Если РазборФ.Имена.Получить(НРег(Вызов.Метод)) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Путь, Метод", ПутьФайла, Вызов.Метод);
	КонецЕсли;
	Если Вызов.ТипСлово <> "" Тогда
		Описание = ТипыСлов.Получить(НРег(Вызов.ТипСлово));
		Если Описание = Неопределено Или Не ОбъектЕсть(Описание.Тег, Вызов.Владелец) Тогда
			Возврат Неопределено;
		КонецЕсли;
		Файл = НайтиМодульОбъекта(Описание.Папка, Вызов.Владелец, "ManagerModule.bsl");
		Если Файл = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Путь, Метод", Файл, Вызов.Метод);
	КонецЕсли;
	Если ТипыСлов.Получить(НРег(Вызов.Владелец)) <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ОбъектЕсть("CommonModule", Вызов.Владелец) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Файл = НайтиМодульОбъекта("CommonModules", Вызов.Владелец, "Module.bsl");
	Если Файл = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Путь, Метод", Файл, Вызов.Метод);
КонецФункции

Функция РазрешитьПроцедуру(ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".");
	Чистые = Новый Массив;
	Для Каждого Ч Из Части Цикл
		Т = СокрЛП(Ч);
		Если Т <> "" Тогда
			Чистые.Добавить(Т);
		КонецЕсли;
	КонецЦикла;
	Если Чистые.Количество() < 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Чистые.Количество() = 2 И ТипыСлов.Получить(НРег(Чистые[0])) = Неопределено Тогда
		Файл = НайтиМодульОбъекта("CommonModules", Чистые[0], "Module.bsl");
		Если Файл = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Путь, Метод, Папка, ИмяОбъекта, Тег", Файл, Чистые[1], "CommonModules", Чистые[0], "CommonModule");
	КонецЕсли;
	Описание = ТипыСлов.Получить(НРег(Чистые[0]));
	Если Описание = Неопределено Тогда
		Файл = НайтиМодульОбъекта("CommonModules", Чистые[0], "Module.bsl");
		Если Файл = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Путь, Метод, Папка, ИмяОбъекта, Тег", Файл, Чистые[Чистые.ВГраница()], "CommonModules", Чистые[0], "CommonModule");
	КонецЕсли;
	Файл = НайтиМодульОбъекта(Описание.Папка, Чистые[1], "ManagerModule.bsl");
	Если Файл = "" Тогда
		Файл = НайтиМодульОбъекта(Описание.Папка, Чистые[1], "Module.bsl");
	КонецЕсли;
	Если Файл = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Путь, Метод, Папка, ИмяОбъекта, Тег", Файл, Чистые[Чистые.ВГраница()], Описание.Папка, Чистые[1], Описание.Тег);
КонецФункции

Функция НайтиМодульОбъекта(Папка, Имя, ИмяФайла)
	Для Каждого Кр Из Корни Цикл
		Путь = ОбъединитьПути(ОбъединитьПути(Кр.Корень, Папка, Имя, "Ext"), ИмяФайла);
		Если (Новый Файл(Путь)).Существует() Тогда
			Возврат Путь;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ДобитьНулями(Знач Н, Знач Ширина)
	Т = Строка(Н);
	Пока СтрДлина(Т) < Ширина Цикл
		Т = "0" + Т;
	КонецЦикла;
	Возврат Т;
КонецФункции

Функция ОтобратьСтроки(Попадания)
	Рез = Новый Массив;
	Виденные = Новый Соответствие;
	Для Каждого Попад Из Попадания Цикл
		Ключ = Попад.Модуль + "|" + Строка(Попад.Строка) + "|" + Попад.Ссылка;
		Если Виденные.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Виденные.Вставить(Ключ, Истина);
		Секция = ?(Не Попад.Есть И Попад.ЕстьАналог, "analog", "no");
		Обработчик = "";
		Если Попад.Свойство("Обработчик") Тогда
			Обработчик = Попад.Обработчик;
		КонецЕсли;
		Рез.Добавить(Новый Структура(
			"Модуль, Строка, Метод, Ссылка, Аналог, Обработчик, Секция, Есть",
			Попад.Модуль, Попад.Строка, Попад.Метод, Попад.Ссылка, Попад.Аналог, Обработчик, Секция, Попад.Есть));
	КонецЦикла;
	Список = Новый СписокЗначений;
	Для Й = 0 По Рез.ВГраница() Цикл
		Стр = Рез[Й];
		Порядок = ?(Стр.Секция = "analog", "0", "1");
		КлючСорт = Порядок + "|" + Стр.Модуль + "|" + ДобитьНулями(Стр.Строка, 9) + "|" + Стр.Ссылка + "|" + ДобитьНулями(Й, 6);
		Список.Добавить(КлючСорт, Строка(Й));
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Отсорт = Новый Массив;
	Для Каждого Эл Из Список Цикл
		Отсорт.Добавить(Рез[Число(Эл.Представление)]);
	КонецЦикла;
	Возврат Отсорт;
КонецФункции

Процедура ЗаписатьОтчёт(КаталогВывода, СтрокиОтчёта)
	Если КаталогВывода = "" Тогда
		Возврат;
	КонецЕсли;
	Каталог = ОбъединитьПути(КаталогВывода, "report");
	СоздатьКаталог(Каталог);
	САналогом = 0;
	Без = 0;
	Для Каждого Стр Из СтрокиОтчёта Цикл
		Если Стр.Секция = "analog" Тогда
			САналогом = САналогом + 1;
		Иначе
			Без = Без + 1;
		КонецЕсли;
	КонецЦикла;
	Мд = Новый Массив;
	Мд.Добавить("# Ссылки на метаданные Удалить*");
	Мд.Добавить("");
	Мд.Добавить("Автозамена в коде не выполнялась. В отчёт попали только ссылки, которых нет в цели и расширении при живом аналоге без префикса, и отдельно ссылки, у которых аналога нет.");
	Мд.Добавить("");
	Мд.Добавить("Нет в метаданных, аналог есть: " + Строка(САналогом) + ". Без аналога: " + Строка(Без) + ".");
	Мд.Добавить("");
	Мд.Добавить("## Нет в метаданных, аналог есть");
	Мд.Добавить("");
	Мд.Добавить("| модуль | строка | метод | ссылка | аналог без Удалить | обработчик |");
	Мд.Добавить("| --- | --- | --- | --- | --- | --- |");
	Для Каждого Стр Из СтрокиОтчёта Цикл
		Если Стр.Секция = "analog" Тогда
			Мд.Добавить("| " + Ячейка(Стр.Модуль) + " | " + Строка(Стр.Строка) + " | " + Ячейка(Стр.Метод)
				+ " | " + Ячейка(Стр.Ссылка) + " | " + Ячейка(Стр.Аналог) + " | " + Ячейка(Стр.Обработчик) + " |");
		КонецЕсли;
	КонецЦикла;
	Мд.Добавить("");
	Мд.Добавить("## Без аналога");
	Мд.Добавить("");
	Мд.Добавить("Ссылки на Удалить*, для которых вариант без префикса в метаданных не найден.");
	Мд.Добавить("");
	Мд.Добавить("| модуль | строка | метод | ссылка | аналог без Удалить | обработчик |");
	Мд.Добавить("| --- | --- | --- | --- | --- | --- |");
	Для Каждого Стр Из СтрокиОтчёта Цикл
		Если Стр.Секция <> "analog" Тогда
			Мд.Добавить("| " + Ячейка(Стр.Модуль) + " | " + Строка(Стр.Строка) + " | " + Ячейка(Стр.Метод)
				+ " | " + Ячейка(Стр.Ссылка) + " | " + Ячейка(Стр.Аналог) + " | " + Ячейка(Стр.Обработчик) + " |");
		КонецЕсли;
	КонецЦикла;
	Мд.Добавить("");
	ЗаписатьТекст(ОбъединитьПути(Каталог, "deleted_refs.md"), СтрСоединить(Мд, Символы.ПС) + Символы.ПС);
	Ксв = Новый Массив;
	Ксв.Добавить("модуль,строка,метод,ссылка,аналог без Удалить,обработчик");
	Для Каждого Стр Из СтрокиОтчёта Цикл
		Ксв.Добавить(ПолеCsv(Стр.Модуль) + "," + ПолеCsv(Строка(Стр.Строка)) + "," + ПолеCsv(Стр.Метод)
			+ "," + ПолеCsv(Стр.Ссылка) + "," + ПолеCsv(Стр.Аналог) + "," + ПолеCsv(Стр.Обработчик));
	КонецЦикла;
	ЗаписатьТекст(ОбъединитьПути(Каталог, "deleted_refs.csv"), СтрСоединить(Ксв, Символы.ПС) + Символы.ПС);
КонецПроцедуры

Функция Ячейка(Знач Текст)
	Возврат СтрЗаменить(СтрЗаменить(Текст, "|", "\|"), Символы.ПС, " ");
КонецФункции

Функция ПолеCsv(Знач Текст)
	Если СтрНайти(Текст, ",") > 0 Или СтрНайти(Текст, """") > 0 Или СтрНайти(Текст, Символы.ПС) > 0 Тогда
		Возврат """" + СтрЗаменить(Текст, """", """""") + """";
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ЗаписатьХуки(КореньЦели, КореньРасширения, СтрокиОтчёта) Экспорт
	ПоХукам = Новый Соответствие;
	Для Каждого Стр Из СтрокиОтчёта Цикл
		Если Стр.Есть Или Стр.Обработчик = "" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кусок Из СтрРазделить(Стр.Обработчик, ";") Цикл
			ТекстОбр = СокрЛП(Кусок);
			Если ТекстОбр = "" Тогда
				Продолжить;
			КонецЕсли;
			ИмяПроцедуры = ТекстОбр;
			Поз = СтрНайти(ТекстОбр, "/");
			Если Поз > 0 Тогда
				ИмяПроцедуры = Сред(ТекстОбр, Поз + 1);
			КонецЕсли;
			Набор = ПоХукам.Получить(ИмяПроцедуры);
			Если Набор = Неопределено Тогда
				Набор = Новый Массив;
				ПоХукам.Вставить(ИмяПроцедуры, Набор);
			КонецЕсли;
			Набор.Добавить(Стр);
		КонецЦикла;
	КонецЦикла;
	Число = 0;
	Для Каждого КЗ Из ПоХукам Цикл
		Если ДобавитьХук(КореньЦели, КореньРасширения, КЗ.Ключ, КЗ.Значение) Тогда
			Число = Число + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Число;
КонецФункции

Функция ДобавитьХук(КореньЦели, КореньРасширения, ПолноеИмя, СтрокиСсылок)
	Цель = РазрешитьПроцедуру(ПолноеИмя);
	Части = СтрРазделить(ПолноеИмя, ".");
	ИмяМетода = СокрЛП(Части[Части.ВГраница()]);
	Если Цель = Неопределено Тогда
		Если Части.Количество() < 2 Тогда
			Сообщить("удалить-ссылки: хук не записан, не разобрана процедура " + ПолноеИмя);
			Возврат Ложь;
		КонецЕсли;
		Описание = ТипыСлов.Получить(НРег(Части[0]));
		Если Описание = Неопределено Тогда
			Цель = Новый Структура("Путь, Метод, Папка, ИмяОбъекта, Тег", "", ИмяМетода, "CommonModules", Части[0], "CommonModule");
		ИначеЕсли Части.Количество() >= 3 Тогда
			Цель = Новый Структура("Путь, Метод, Папка, ИмяОбъекта, Тег", "", ИмяМетода, Описание.Папка, Части[1], Описание.Тег);
		Иначе
			Сообщить("удалить-ссылки: хук не записан, нет модуля " + ПолноеИмя);
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Не ОбеспечитьЗаимствование(КореньРасширения, КореньЦели, Цель) Тогда
		Сообщить("удалить-ссылки: хук не записан, нет uuid " + Цель.ИмяОбъекта);
		Возврат Ложь;
	КонецЕсли;
	ИмяФайлаМодуля = ?(Цель.Тег = "CommonModule", "Module.bsl", "ManagerModule.bsl");
	ПутьМодуля = ОбъединитьПути(ОбъединитьПути(КореньРасширения, Цель.Папка, Цель.ИмяОбъекта, "Ext"), ИмяФайлаМодуля);
	БылФайл = (Новый Файл(ПутьМодуля)).Существует();
	Текст = "";
	СБом = Ложь;
	СCR = Ложь;
	Если БылФайл Тогда
		Текст = ПрочитатьСырой(ПутьМодуля);
		СБом = ФайлСBOM(ПутьМодуля);
		СCR = СтрНайти(Текст, Символы.ВК) > 0;
		Текст = СтрЗаменить(Текст, Символы.ВК, "");
	КонецЕсли;
	Если ХукУжеЕсть(Текст, ИмяМетода) Тогда
		Возврат Ложь;
	КонецЕсли;
	Сиг = СигнатураМетода(Цель.Путь, ИмяМетода);
	Префикс = ПрефиксРасширения(КореньРасширения);
	ИмяХука = ИмяМетода;
	Если Не СтрНачинаетсяС(НРег(ИмяХука), НРег(Префикс)) Тогда
		ИмяХука = Префикс + ИмяМетода;
	КонецЕсли;
	Кусок = ТекстХука(ИмяМетода, ИмяХука, Сиг, СтрокиСсылок);
	Если Текст <> "" И Не СтрЗаканчиваетсяНа(Текст, Символы.ПС) Тогда
		Текст = Текст + Символы.ПС;
	КонецЕсли;
	Если Текст <> "" Тогда
		Текст = Текст + Символы.ПС;
	КонецЕсли;
	Если БылФайл Тогда
		ЗаписатьСохраняя(ПутьМодуля, Текст + Кусок, СБом, СCR);
	Иначе
		ЗаписатьТекст(ПутьМодуля, Текст + Кусок);
	КонецЕсли;
	Сообщить("удалить-ссылки: хук &Вместо(""" + ИмяМетода + """) в " + Цель.ИмяОбъекта);
	Возврат Истина;
КонецФункции

Функция ТекстХука(ИмяМетода, ИмяХука, Сиг, СтрокиСсылок)
	Вид = "Процедура";
	Параметры = "";
	Если Сиг <> Неопределено Тогда
		Вид = Сиг.Вид;
		Параметры = Сиг.Параметры;
	КонецЕсли;
	Т = Новый Массив;
	Т.Добавить("&Вместо(""" + ИмяМетода + """)");
	Т.Добавить(Вид + " " + ИмяХука + "(" + Параметры + ")");
	Т.Добавить(Символы.Таб + "// Причина: обработчик обновления отключён. В УП эти данные уже перенесены.");
	Т.Добавить(Символы.Таб + "// Исходное тело не выполняется: по пути есть ссылки на отсутствующие метаданные с префиксом Удалить.");
	Уже = Новый Соответствие;
	Счёт = 0;
	Для Каждого Стр Из СтрокиСсылок Цикл
		Если Уже.Получить(Стр.Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Стр.Ссылка, Истина);
		Счёт = Счёт + 1;
		Если Счёт > 40 Тогда
			Т.Добавить(Символы.Таб + "// - …");
			Прервать;
		КонецЕсли;
		Хвост = Стр.Ссылка;
		Если Стр.Аналог <> "" Тогда
			Хвост = Хвост + " (аналог: " + Стр.Аналог + ")";
		КонецЕсли;
		Т.Добавить(Символы.Таб + "// - " + Хвост);
	КонецЦикла;
	Если Вид = "Функция" Тогда
		Т.Добавить(Символы.Таб + "Возврат Неопределено;");
		Т.Добавить("КонецФункции");
	Иначе
		Т.Добавить("КонецПроцедуры");
	КонецЕсли;
	Возврат СтрСоединить(Т, Символы.ПС) + Символы.ПС;
КонецФункции

Функция СигнатураМетода(Путь, ИмяМетода)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Строки = СтрРазделить(СтрЗаменить(ПрочитатьТекст(Путь), Символы.ВК, ""), Символы.ПС, Истина);
	Для Й = 0 По Строки.ВГраница() Цикл
		Стр = Строки[Й];
		Код = СокрЛП(Разбор.УбратьКомментарий(Стр));
		Н = НРег(Код);
		Если Не (СтрНачинаетсяС(Н, "процедура ") Или СтрНачинаетсяС(Н, "функция ") Или СтрНачинаетсяС(Н, "асинх ")) Тогда
			Продолжить;
		КонецЕсли;
		Собранная = Стр;
		Если СтрНайти(Собранная, ")") = 0 Тогда
			Лимит = Мин(Й + 8, Строки.ВГраница());
			Для К = Й + 1 По Лимит Цикл
				Собранная = Собранная + " " + СокрЛП(Разбор.УбратьКомментарий(Строки[К]));
				Если СтрНайти(Собранная, ")") > 0 Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Об = Разбор.РазобратьОбъявление(Собранная);
		Если Об = Неопределено Или НРег(Об.Имя) <> НРег(ИмяМетода) Тогда
			Продолжить;
		КонецЕсли;
		П = СтрНайти(Собранная, "(");
		Кск = СтрНайти(Собранная, ")");
		Параметры = "";
		Если П > 0 И Кск > П Тогда
			Параметры = СокрЛП(Сред(Собранная, П + 1, Кск - П - 1));
		КонецЕсли;
		Возврат Новый Структура("Вид, Параметры", Об.Вид, Параметры);
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ХукУжеЕсть(Текст, ИмяМетода)
	Низ = НРег(Текст);
	Метка = "&вместо(""";
	Поз = 1;
	Пока Поз <= СтрДлина(Низ) Цикл
		Н = НайтиС(Низ, Метка, Поз);
		Если Н = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Начало = Н + СтрДлина(Метка);
		Хвост = Сред(Текст, Начало);
		К = СтрНайти(Хвост, """");
		Если К = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Если НРег(Лев(Хвост, К - 1)) = НРег(ИмяМетода) Тогда
			Возврат Истина;
		КонецЕсли;
		Поз = Начало + К;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция НеРаскрыватьМодуль(Путь)
	Н = НРег(СтрЗаменить(Путь, "/", "\"));
	Возврат СтрНайти(Н, "\commonmodules\общегоназначения") > 0
		Или СтрНайти(Н, "\commonmodules\строковыефункции") > 0
		Или СтрНайти(Н, "\commonmodules\файловаясистема") > 0;
КонецФункции

Функция ОбеспечитьЗаимствование(КореньРасширения, КореньЦели, Цель)
	ПутьXml = ОбъединитьПути(КореньРасширения, Цель.Папка, Цель.ИмяОбъекта + ".xml");
	Если (Новый Файл(ПутьXml)).Существует() Тогда
		ВставитьИмяВКонфигурацию(КореньРасширения, Цель.Тег, Цель.ИмяОбъекта);
		Возврат Истина;
	КонецЕсли;
	ПутьИсх = "";
	Если КореньЦели <> "" Тогда
		ПутьИсх = ОбъединитьПути(КореньЦели, Цель.Папка, Цель.ИмяОбъекта + ".xml");
	КонецЕсли;
	УидБазы = УидОбъекта(ПутьИсх);
	Если УидБазы = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	СвойУид = ДетерминированныйUuid(Цель.Тег + Символы.ПС + Цель.ИмяОбъекта);
	Т = Новый Массив;
	Т.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Т.Добавить("<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xr=""http://v8.1c.ru/8.3/xcf/readable"" version=""2.21"">");
	Т.Добавить(Символы.Таб + "<" + Цель.Тег + " uuid=""" + СвойУид + """>");
	Если Цель.Тег <> "CommonModule" И ПутьИсх <> "" Тогда
		Блок = ВырезатьБлок(ПрочитатьТекст(ПутьИсх), "InternalInfo");
		Если Блок <> "" Тогда
			Для Каждого Стр Из СтрРазделить(Блок, Символы.ПС, Ложь) Цикл
				Т.Добавить(Символы.Таб + Символы.Таб + Стр);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Т.Добавить(Символы.Таб + Символы.Таб + "<Properties>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<ObjectBelonging>Adopted</ObjectBelonging>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + ЭкранироватьXml(Цель.ИмяОбъекта) + "</Name>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<ExtendedConfigurationObject>" + ЭкранироватьXml(УидБазы) + "</ExtendedConfigurationObject>");
	Если Цель.Тег = "CommonModule" Тогда
		Для Каждого Стр Из СвойстваОбщегоМодуля(ПутьИсх) Цикл
			Т.Добавить(Стр);
		КонецЦикла;
	КонецЕсли;
	Т.Добавить(Символы.Таб + Символы.Таб + "</Properties>");
	Т.Добавить(Символы.Таб + "</" + Цель.Тег + ">");
	Т.Добавить("</MetaDataObject>");
	ЗаписатьТекст(ПутьXml, СтрСоединить(Т, Символы.ПС) + Символы.ПС);
	ВставитьИмяВКонфигурацию(КореньРасширения, Цель.Тег, Цель.ИмяОбъекта);
	Возврат Истина;
КонецФункции

Функция СвойстваОбщегоМодуля(ПутьИсх)
	Р = Новый Массив;
	Текст = ПрочитатьТекст(ПутьИсх);
	Для Каждого Имя Из СтрРазделить("Global,ClientManagedApplication,Server,ExternalConnection,ClientOrdinaryApplication,ServerCall,Privileged,ReturnValuesReuse", ",") Цикл
		ЗначТега = ТекстТега(Текст, Имя);
		Если ЗначТега <> "" Тогда
			Р.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<" + Имя + ">" + ЗначТега + "</" + Имя + ">");
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ВставитьИмяВКонфигурацию(КореньРасширения, Тег, Имя)
	Путь = ОбъединитьПути(КореньРасширения, "Configuration.xml");
	Сырой = ПрочитатьСырой(Путь);
	Если Сырой = "" Тогда
		Возврат;
	КонецЕсли;
	Метка = "<" + Тег + ">" + Имя + "</" + Тег + ">";
	Если СтрНайти(Сырой, Метка) > 0 Тогда
		Возврат;
	КонецЕсли;
	СБом = ФайлСBOM(Путь);
	СCR = СтрНайти(Сырой, Символы.ВК) > 0;
	Строки = СтрРазделить(СтрЗаменить(Сырой, Символы.ВК, ""), Символы.ПС, Истина);
	ИндексЗакрытия = -1;
	Отступ = Символы.Таб + Символы.Таб + Символы.Таб;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если СтрНайти(Строки[Й], "</ChildObjects>") > 0 Тогда
			ИндексЗакрытия = Й;
		КонецЕсли;
	КонецЦикла;
	Если ИндексЗакрытия < 0 Тогда
		Возврат;
	КонецЕсли;
	Место = ИндексЗакрытия;
	Для Й = 0 По ИндексЗакрытия - 1 Цикл
		ИмяСтроки = ИмяОдногоТега(Строки[Й], Тег);
		Если ИмяСтроки = "" Тогда
			Продолжить;
		КонецЕсли;
		Отступ = Лев(Строки[Й], СтрДлина(Строки[Й]) - СтрДлина(СокрЛ(Строки[Й])));
		Если НРег(ИмяСтроки) > НРег(Имя) И Место = ИндексЗакрытия Тогда
			Место = Й;
		ИначеЕсли НРег(ИмяСтроки) <= НРег(Имя) Тогда
			Место = Й + 1;
		КонецЕсли;
	КонецЦикла;
	Строки.Вставить(Место, Отступ + Метка);
	ЗаписатьСохраняя(Путь, СтрСоединить(Строки, Символы.ПС), СБом, СCR);
КонецПроцедуры

Функция ПрефиксРасширения(Корень)
	ЗначТега = ТекстТега(ПрочитатьТекст(ОбъединитьПути(Корень, "Configuration.xml")), "NamePrefix");
	Если ЗначТега = "" Тогда
		Возврат "УП_";
	КонецЕсли;
	Возврат ЗначТега;
КонецФункции

Функция УидОбъекта(Путь)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("uuid=""([^""]+)""");
	Совп = Рв.НайтиСовпадения(ПрочитатьТекст(Путь));
	Если Совп.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Совп[0].Группы[1].Значение;
КонецФункции

Функция ВырезатьБлок(Текст, ИмяБлока)
	Открывающий = "<" + ИмяБлока;
	Закрывающий = "</" + ИмяБлока + ">";
	Нач = СтрНайти(Текст, Открывающий);
	Если Нач = 0 Тогда
		Возврат "";
	КонецЕсли;
	Хвост = Сред(Текст, Нач);
	Кон = СтрНайти(Хвост, Закрывающий);
	Если Кон = 0 Тогда
		Возврат "";
	КонецЕсли;
	Блок = Лев(Хвост, Кон + СтрДлина(Закрывающий) - 1);
	Строки = СтрРазделить(СтрЗаменить(Блок, Символы.ВК, ""), Символы.ПС, Ложь);
	Рез = Новый Массив;
	Для Каждого Стр Из Строки Цикл
		Рез.Добавить(СокрЛП(Стр));
	КонецЦикла;
	Возврат СтрСоединить(Рез, Символы.ПС);
КонецФункции

Функция ДетерминированныйUuid(СтрокаКлюч)
	Хеш = Новый ХешированиеДанных(ХешФункция.MD5);
	Хеш.Добавить(СтрокаКлюч);
	Х = НРег(Хеш.ХешСуммаСтрокой);
	Возврат Сред(Х, 1, 8) + "-" + Сред(Х, 9, 4) + "-" + Сред(Х, 13, 4) + "-" + Сред(Х, 17, 4) + "-" + Сред(Х, 21, 12);
КонецФункции

Функция ЭкранироватьXml(Знач З)
	З = СтрЗаменить(З, "&", "&amp;");
	З = СтрЗаменить(З, "<", "&lt;");
	З = СтрЗаменить(З, ">", "&gt;");
	Возврат СтрЗаменить(З, """", "&quot;");
КонецФункции

Функция ЭтоСимволИмени(Сим)
	Если Сим = "" Или Сим = "_" Тогда
		Возврат Сим = "_";
	КонецЕсли;
	К = КодСимвола(Сим);
	Возврат (К >= 48 И К <= 57) Или (К >= 65 И К <= 90) Или (К >= 97 И К <= 122)
		Или (К >= 1040 И К <= 1103) Или К = 1025 Или К = 1105;
КонецФункции

Функция НайтиС(Текст, Что, Старт)
	Если Старт <= 1 Тогда
		Возврат СтрНайти(Текст, Что);
	КонецЕсли;
	Хвост = Сред(Текст, Старт);
	Н = СтрНайти(Хвост, Что);
	Если Н = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Старт + Н - 1;
КонецФункции

Функция ОтносительныйПуть(Корень, Полный)
	К = СтрЗаменить(Корень, "/", "\");
	П = СтрЗаменить(Полный, "/", "\");
	Если Не СтрНачинаетсяС(НРег(П), НРег(К)) Тогда
		Возврат СтрЗаменить(П, "\", "/");
	КонецЕсли;
	Отн = Сред(П, СтрДлина(К) + 1);
	Пока СтрНачинаетсяС(Отн, "\") Цикл
		Отн = Сред(Отн, 2);
	КонецЦикла;
	Возврат СтрЗаменить(Отн, "\", "/");
КонецФункции

Функция НормПуть(Путь)
	Возврат НРег(СтрЗаменить(Путь, "/", "\"));
КонецФункции

Функция ПрочитатьСырой(Путь)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), "UTF-8");
	Если Текст = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ФайлСBOM(Путь)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Текст = ПолучитьСтрокуИзДвоичныхДанных(Новый ДвоичныеДанные(Путь), "UTF-8");
	Возврат Текст <> Неопределено И Лев(Текст, 1) = Символ(65279);
КонецФункции

Процедура ЗаписатьСохраняя(Путь, ТекстЛФ, СБом, СCR)
	Текст = ТекстЛФ;
	Если СCR Тогда
		Текст = СтрЗаменить(Текст, Символы.ПС, Символы.ВК + Символы.ПС);
	КонецЕсли;
	Ф = Новый Файл(Путь);
	Каталог = Ф.Путь;
	Если Каталог <> "" И Не (Новый Файл(Каталог)).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, СБом).Записать(Путь);
КонецПроцедуры

Функция ПрочитатьТекст(Путь)
	Если Путь = "" Или Не (Новый Файл(Путь)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	Т = Новый ТекстовыйДокумент;
	Т.Прочитать(Путь, КодировкаТекста.UTF8);
	Возврат Т.ПолучитьТекст();
КонецФункции

Процедура ЗаписатьТекст(Путь, Текст)
	Ф = Новый Файл(Путь);
	Каталог = Ф.Путь;
	Если Каталог <> "" И Не (Новый Файл(Каталог)).Существует() Тогда
		СоздатьКаталог(Каталог);
	КонецЕсли;
	Д = ПолучитьДвоичныеДанныеИзСтроки(СтрЗаменить(Текст, Символы.ВК, ""), КодировкаТекста.UTF8NoBOM);
	Д.Записать(Путь);
КонецПроцедуры

// Замена по разделу «аналог есть» отчёта deleted_refs.md.
// В уже заимствованном тексте расширения меняется исполняемая часть (не блок #Удаление).
// Для модуля цели в расширение пишется &ИзменениеИКонтроль: исходная строка в #Удаление, аналог в #Вставка.
Функция ЗаменитьАналогиИзОтчёта(КореньЦели, КореньРасширения, ПутьОтчёта) Экспорт
	ПодготовитьРазбор();
	Возврат ЗаменитьАналоги(КореньЦели, КореньРасширения, ПрочитатьТаблицуАналогов(ПутьОтчёта));
КонецФункции

Функция ЗаменитьАналоги(КореньЦели, КореньРасширения, СтрокиАналогов) Экспорт
	ПодготовитьРазбор();
	УбратьПустыеПодмены(КореньРасширения);
	ПоФайлам = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого Стр Из СтрокиАналогов Цикл
		Если СокрЛП(Стр.Аналог) = "" Тогда
			Продолжить;
		КонецЕсли;
		Набор = ПоФайлам.Получить(Стр.Модуль);
		Если Набор = Неопределено Тогда
			Набор = Новый Массив;
			ПоФайлам.Вставить(Стр.Модуль, Набор);
			Порядок.Добавить(Стр.Модуль);
		КонецЕсли;
		Набор.Добавить(Стр);
	КонецЦикла;
	ИиК = 0;
	Заменено = 0;
	Контроль = 0;
	Пропущено = 0;
	Для Каждого Модуль Из Порядок Цикл
		Если СтрНачинаетсяС(Модуль, "расширение/") Тогда
			Рез = ЗаменитьВМодулеРасширения(КореньРасширения, Сред(Модуль, 12), ПоФайлам.Получить(Модуль));
		ИначеЕсли СтрНачинаетсяС(Модуль, "цель/") Тогда
			Рез = ЗаписатьИиКМодуля(КореньЦели, КореньРасширения, Сред(Модуль, 6), ПоФайлам.Получить(Модуль));
		Иначе
			Продолжить;
		КонецЕсли;
		ИиК = ИиК + Рез.ИиК;
		Заменено = Заменено + Рез.Заменено;
		Контроль = Контроль + Рез.Контроль;
		Пропущено = Пропущено + Рез.Пропущено;
	КонецЦикла;
	Сообщить("удалить-ссылки: замена аналогов — методов &ИзменениеИКонтроль " + Строка(ИиК)
		+ ", строк в расширении " + Строка(Заменено)
		+ ", только в #Удаление " + Строка(Контроль)
		+ ", пропущено " + Строка(Пропущено));
	Возврат Новый Структура("ik, replaced, control, skipped", ИиК, Заменено, Контроль, Пропущено);
КонецФункции

Процедура ПодготовитьРазбор()
	Если Разбор = Неопределено Тогда
		Разбор = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "РазборМетодов.os"));
	КонецЕсли;
	Если ТипыСлов = Неопределено Тогда
		ИнициализироватьТипы();
	КонецЕсли;
КонецПроцедуры

Функция ПрочитатьТаблицуАналогов(ПутьОтчёта)
	Рез = Новый Массив;
	Текст = ПрочитатьТекст(ПутьОтчёта);
	ВРазделе = Ложь;
	Для Каждого Стр Из СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Ложь) Цикл
		Если Стр = "## Нет в метаданных, аналог есть" Тогда
			ВРазделе = Истина;
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Стр, "## ") Тогда
			ВРазделе = Ложь;
		КонецЕсли;
		Если Не ВРазделе Или Не СтрНачинаетсяС(Стр, "|") Или СтрНачинаетсяС(Стр, "| ---") Или СтрНачинаетсяС(Стр, "| модуль") Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(Стр, "|", Истина);
		Если Части.Количество() < 6 Тогда
			Продолжить;
		КонецЕсли;
		Аналог = СокрЛП(Части[5]);
		Если Аналог = "" Тогда
			Продолжить;
		КонецЕсли;
		Рез.Добавить(Новый Структура("Модуль, Строка, Метод, Ссылка, Аналог",
			СокрЛП(Части[1]), Число(СокрЛП(Части[2])), СокрЛП(Части[3]), СокрЛП(Части[4]), Аналог));
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПустойИтогЗамены()
	Возврат Новый Структура("ИиК, Заменено, Контроль, Пропущено", 0, 0, 0, 0);
КонецФункции

Функция ЗаменитьВМодулеРасширения(КореньРасширения, Относительный, СтрокиФайла)
	Итог = ПустойИтогЗамены();
	Путь = ПутьОтКорня(КореньРасширения, Относительный);
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Сообщить("удалить-ссылки: нет файла расширения " + Относительный);
		Итог.Пропущено = СтрокиФайла.Количество();
		Возврат Итог;
	КонецЕсли;
	СБом = ФайлСBOM(Путь);
	Сырой = ПрочитатьСырой(Путь);
	СCR = СтрНайти(Сырой, Символы.ВК) > 0;
	Строки = СтрРазделить(СтрЗаменить(Сырой, Символы.ВК, ""), Символы.ПС, Истина);
	ВУдалении = Ложь;
	Номера = Новый Соответствие;
	Для Каждого Стр Из СтрокиФайла Цикл
		Номера.Вставить(Стр.Строка, Истина);
	КонецЦикла;
	Для Й = 0 По Строки.ВГраница() Цикл
		Маркер = СокрЛП(Строки[Й]);
		Если Маркер = "#Удаление" Тогда
			ВУдалении = Истина;
		ИначеЕсли Маркер = "#КонецУдаления" Тогда
			ВУдалении = Ложь;
		КонецЕсли;
		Номер = Й + 1;
		Если Номера.Получить(Номер) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ВУдалении И Маркер <> "#Удаление" И Маркер <> "#КонецУдаления" Тогда
			Итог.Контроль = Итог.Контроль + 1;
			Продолжить;
		КонецЕсли;
		Нов = ПрименитьПары(Строки[Й], СтрокиФайла, Номер);
		Если Нов <> Строки[Й] Тогда
			Строки[Й] = Нов;
			Итог.Заменено = Итог.Заменено + 1;
		Иначе
			Итог.Пропущено = Итог.Пропущено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Итог.Заменено > 0 Тогда
		ЗаписатьСохраняя(Путь, СтрСоединить(Строки, Символы.ПС), СБом, СCR);
	КонецЕсли;
	Возврат Итог;
КонецФункции

Функция ЗаписатьИиКМодуля(КореньЦели, КореньРасширения, Относительный, СтрокиФайла)
	Итог = ПустойИтогЗамены();
	Описание = ОписаниеМодуля(Относительный);
	Если Описание = Неопределено Тогда
		Сообщить("удалить-ссылки: не разобран путь " + Относительный);
		Итог.Пропущено = СтрокиФайла.Количество();
		Возврат Итог;
	КонецЕсли;
	ПутьЦели = ПутьОтКорня(КореньЦели, Относительный);
	Если Не (Новый Файл(ПутьЦели)).Существует() Тогда
		Сообщить("удалить-ссылки: нет модуля цели " + Относительный);
		Итог.Пропущено = СтрокиФайла.Количество();
		Возврат Итог;
	КонецЕсли;
	ТекстЦели = СтрЗаменить(ПрочитатьТекст(ПутьЦели), Символы.ВК, "");
	СтрокиЦели = СтрРазделить(ТекстЦели, Символы.ПС, Истина);
	Дерево = Разбор.РазобратьМодуль(ТекстЦели);
	ПоМетодам = Новый Соответствие;
	ПорядокМетодов = Новый Массив;
	Для Каждого Стр Из СтрокиФайла Цикл
		Набор = ПоМетодам.Получить(НРег(Стр.Метод));
		Если Набор = Неопределено Тогда
			Набор = Новый Массив;
			ПоМетодам.Вставить(НРег(Стр.Метод), Набор);
			ПорядокМетодов.Добавить(Стр.Метод);
		КонецЕсли;
		Набор.Добавить(Стр);
	КонецЦикла;
	Цель = Новый Структура("Путь, Метод, Папка, ИмяОбъекта, Тег", ПутьЦели, "", Описание.Папка, Описание.Имя, Описание.Тег);
	Если Не ОбеспечитьЗаимствование(КореньРасширения, КореньЦели, Цель) Тогда
		Сообщить("удалить-ссылки: нет uuid " + Описание.Имя);
		Итог.Пропущено = СтрокиФайла.Количество();
		Возврат Итог;
	КонецЕсли;
	Если Описание.Форма <> "" Тогда
		ОбеспечитьФорму(КореньРасширения, КореньЦели, Описание);
	КонецЕсли;
	ПутьРасш = ПутьОтКорня(КореньРасширения, Относительный);
	БылФайл = (Новый Файл(ПутьРасш)).Существует();
	СБом = Ложь;
	СCR = Ложь;
	ТекстРасш = "";
	Если БылФайл Тогда
		ТекстРасш = ПрочитатьСырой(ПутьРасш);
		СБом = ФайлСBOM(ПутьРасш);
		СCR = СтрНайти(ТекстРасш, Символы.ВК) > 0;
		ТекстРасш = СтрЗаменить(ТекстРасш, Символы.ВК, "");
	КонецЕсли;
	Куски = Новый Массив;
	Префикс = ПрефиксРасширения(КореньРасширения);
	Для Каждого ИмяМетода Из ПорядокМетодов Цикл
		Мт = НайтиМетодДерева(Дерево, ИмяМетода);
		Если Мт = Неопределено Тогда
			Сообщить("удалить-ссылки: нет метода " + ИмяМетода + " в " + Относительный);
			Итог.Пропущено = Итог.Пропущено + ПоМетодам.Получить(НРег(ИмяМетода)).Количество();
			Продолжить;
		КонецЕсли;
		Пары = ПоМетодам.Получить(НРег(ИмяМетода));
		Если АннотацияМетодаЕсть(ТекстРасш, ИмяМетода) Тогда
			Нов = ЗаменитьВСуществующемМетоде(ТекстРасш, ИмяМетода, Пары);
			Если Нов <> ТекстРасш Тогда
				ТекстРасш = Нов;
				Итог.Заменено = Итог.Заменено + Пары.Количество();
			Иначе
				Итог.Контроль = Итог.Контроль + Пары.Количество();
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Куски.Добавить(ТекстИиК(СтрокиЦели, Мт, ИмяМетода, Префикс, Пары, ПутьЦели));
		Итог.ИиК = Итог.ИиК + 1;
	КонецЦикла;
	Если Куски.Количество() = 0 И ТекстРасш = ПрочитатьСыройБезCR(ПутьРасш, БылФайл) Тогда
		Возврат Итог;
	КонецЕсли;
	Если ТекстРасш <> "" И Не СтрЗаканчиваетсяНа(ТекстРасш, Символы.ПС) Тогда
		ТекстРасш = ТекстРасш + Символы.ПС;
	КонецЕсли;
	Если ТекстРасш <> "" И Куски.Количество() > 0 Тогда
		ТекстРасш = ТекстРасш + Символы.ПС;
	КонецЕсли;
	ТекстРасш = ТекстРасш + СтрСоединить(Куски, Символы.ПС);
	Если БылФайл Тогда
		ЗаписатьСохраняя(ПутьРасш, ТекстРасш, СБом, СCR);
	Иначе
		ЗаписатьТекст(ПутьРасш, ТекстРасш);
	КонецЕсли;
	Возврат Итог;
КонецФункции

Функция ПрочитатьСыройБезCR(Путь, БылФайл)
	Если Не БылФайл Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрЗаменить(ПрочитатьСырой(Путь), Символы.ВК, "");
КонецФункции

Функция ТекстИиК(СтрокиЦели, Мт, ИмяМетода, Префикс, Пары, ПутьЦели)
	Сиг = СигнатураМетода(ПутьЦели, ИмяМетода);
	Вид = "Процедура";
	Параметры = "";
	Если Сиг <> Неопределено Тогда
		Вид = Сиг.Вид;
		Параметры = Сиг.Параметры;
	КонецЕсли;
	ИмяХука = ИмяМетода;
	Если Не СтрНачинаетсяС(НРег(ИмяХука), НРег(Префикс)) Тогда
		ИмяХука = Префикс + ИмяМетода;
	КонецЕсли;
	ЭкспортМетода = Ложь;
	Т = Новый Массив;
	Т.Добавить("&ИзменениеИКонтроль(""" + ИмяМетода + """)");
	ВЗаголовке = Истина;
	ВиделиОбъявление = Ложь;
	Для Номер = Мт.Начало По Мт.Конец Цикл
		ТекстСтроки = СтрокиЦели[Номер - 1];
		Если ВЗаголовке Тогда
			Код = СокрЛП(Разбор.УбратьКомментарий(ТекстСтроки));
			Низ = НРег(Код);
			Если СтрНачинаетсяС(Низ, "процедура ") Или СтрНачинаетсяС(Низ, "функция ") Или СтрНачинаетсяС(Низ, "асинх ") Тогда
				ВиделиОбъявление = Истина;
			КонецЕсли;
			Если СтрНайти(Низ, "экспорт") > 0 Тогда
				ЭкспортМетода = Истина;
			КонецЕсли;
			Если ВиделиОбъявление И СтрНайти(Код, ")") > 0 Тогда
				ВЗаголовке = Ложь;
				Хвост = "";
				Если ЭкспортМетода Тогда
					Хвост = " Экспорт";
				КонецЕсли;
				Т.Добавить(Вид + " " + ИмяХука + "(" + Параметры + ")" + Хвост);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Разбор.ЭтоМаркерКонцаМетода(ТекстСтроки, ?(Вид = "Функция", "конецфункции", "конецпроцедуры")) Тогда
			Прервать;
		КонецЕсли;
		Нов = ПрименитьПары(ТекстСтроки, Пары, Номер);
		Если Нов = ТекстСтроки Тогда
			Т.Добавить(ТекстСтроки);
		Иначе
			Т.Добавить("#Удаление");
			Т.Добавить(ТекстСтроки);
			Т.Добавить("#КонецУдаления");
			Т.Добавить("#Вставка");
			Т.Добавить(Нов);
			Т.Добавить("#КонецВставки");
		КонецЕсли;
	КонецЦикла;
	Если Вид = "Функция" Тогда
		Т.Добавить("КонецФункции");
	Иначе
		Т.Добавить("КонецПроцедуры");
	КонецЕсли;
	Возврат СтрСоединить(Т, Символы.ПС) + Символы.ПС;
КонецФункции

Функция ЗаменитьВСуществующемМетоде(Текст, ИмяМетода, Пары)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Начало = НомерАннотации(Строки, ИмяМетода);
	Если Начало < 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Внутри = Ложь;
	ВУдалении = Ложь;
	ВидКонца = "конецпроцедуры";
	Для Й = Начало По Строки.ВГраница() Цикл
		Код = НРег(СокрЛП(Разбор.УбратьКомментарий(Строки[Й])));
		Если Не Внутри И (СтрНачинаетсяС(Код, "процедура ") Или СтрНачинаетсяС(Код, "функция ")) Тогда
			Внутри = Истина;
			Если СтрНачинаетсяС(Код, "функция ") Тогда
				ВидКонца = "конецфункции";
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Не Внутри Тогда
			Продолжить;
		КонецЕсли;
		Маркер = СокрЛП(Строки[Й]);
		Если Маркер = "#Удаление" Тогда
			ВУдалении = Истина;
			Продолжить;
		КонецЕсли;
		Если Маркер = "#КонецУдаления" Тогда
			ВУдалении = Ложь;
			Продолжить;
		КонецЕсли;
		Если Разбор.ЭтоМаркерКонцаМетода(Строки[Й], ВидКонца) Тогда
			Прервать;
		КонецЕсли;
		Если ВУдалении Тогда
			Продолжить;
		КонецЕсли;
		Строки[Й] = ПрименитьПары(Строки[Й], Пары, 0);
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция НомерАннотации(Строки, ИмяМетода)
	Для Й = 0 По Строки.ВГраница() Цикл
		Низ = НРег(СокрЛП(Строки[Й]));
		Если СтрНачинаетсяС(Низ, "&изменениеиконтроль(") Или СтрНачинаетсяС(Низ, "&вместо(") Тогда
			Если СтрНайти(Низ, """" + НРег(ИмяМетода) + """") > 0 Тогда
				Возврат Й;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции

Функция АннотацияМетодаЕсть(Текст, ИмяМетода)
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат НомерАннотации(СтрРазделить(Текст, Символы.ПС, Истина), ИмяМетода) >= 0;
КонецФункции

Функция НайтиМетодДерева(Дерево, ИмяМетода)
	Для Каждого Мт Из Дерево.Методы Цикл
		Если НРег(Мт.Имя) = НРег(ИмяМетода) Тогда
			Возврат Мт;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПрименитьПары(ТекстСтроки, Пары, Номер)
	Список = Новый Массив;
	Для Каждого Стр Из Пары Цикл
		Если Номер <> 0 И Стр.Строка <> Номер Тогда
			Продолжить;
		КонецЕсли;
		Список.Добавить(Стр);
	КонецЦикла;
	Если Номер = 0 Тогда
		Список = Пары;
	КонецЕсли;
	УпорядочитьПоДлинеСсылки(Список);
	Нов = ТекстСтроки;
	Для Каждого Стр Из Список Цикл
		Нов = ЗаменитьОграниченно(Нов, Стр.Ссылка, Стр.Аналог);
	КонецЦикла;
	Возврат Нов;
КонецФункции

Процедура УпорядочитьПоДлинеСсылки(Список)
	Для А = 0 По Список.ВГраница() Цикл
		Для Б = А + 1 По Список.ВГраница() Цикл
			Если СтрДлина(Список[Б].Ссылка) > СтрДлина(Список[А].Ссылка) Тогда
				Врем = Список[А];
				Список[А] = Список[Б];
				Список[Б] = Врем;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ЗаменитьОграниченно(ТекстСтроки, Что, НаЧто)
	Если Что = "" Или Что = НаЧто Или СтрНайти(ТекстСтроки, Что) = 0 Тогда
		Возврат ТекстСтроки;
	КонецЕсли;
	Рез = "";
	Поз = 1;
	Дл = СтрДлина(ТекстСтроки);
	ДлЧто = СтрДлина(Что);
	Пока Поз <= Дл Цикл
		Н = НайтиС(ТекстСтроки, Что, Поз);
		Если Н = 0 Тогда
			Рез = Рез + Сред(ТекстСтроки, Поз);
			Прервать;
		КонецЕсли;
		До = "";
		Если Н > 1 Тогда
			До = Сред(ТекстСтроки, Н - 1, 1);
		КонецЕсли;
		ПослеПоз = Н + ДлЧто;
		После = "";
		Если ПослеПоз <= Дл Тогда
			После = Сред(ТекстСтроки, ПослеПоз, 1);
		КонецЕсли;
		Если ЭтоСимволИмени(До) Или ЭтоСимволИмени(После) Тогда
			Рез = Рез + Сред(ТекстСтроки, Поз, Н - Поз + 1);
			Поз = Н + 1;
			Продолжить;
		КонецЕсли;
		Рез = Рез + Сред(ТекстСтроки, Поз, Н - Поз) + НаЧто;
		Поз = ПослеПоз;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ОписаниеМодуля(Относительный)
	Части = СтрРазделить(СтрЗаменить(Относительный, "\", "/"), "/");
	Если Части.Количество() < 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Папка = Части[0];
	Тег = ТегПоПапке(Папка);
	Если Тег = "" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Форма = "";
	Для Й = 0 По Части.ВГраница() Цикл
		Если НРег(Части[Й]) = "forms" И Й + 1 <= Части.ВГраница() Тогда
			Форма = Части[Й + 1];
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Папка, Имя, Тег, Форма", Папка, Части[1], Тег, Форма);
КонецФункции

Функция ТегПоПапке(Папка)
	Для Каждого КЗ Из ТипыСлов Цикл
		Если КЗ.Значение.Папка = Папка Тогда
			Возврат КЗ.Значение.Тег;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Процедура ОбеспечитьФорму(КореньРасширения, КореньЦели, Описание)
	ПутьОбъекта = ОбъединитьПути(КореньРасширения, Описание.Папка, Описание.Имя + ".xml");
	ВставитьДочерний(ПутьОбъекта, "Form", Описание.Форма, Описание.Тег);
	ПутьФормы = ОбъединитьПути(ОбъединитьПути(КореньРасширения, Описание.Папка, Описание.Имя, "Forms"), Описание.Форма + ".xml");
	Если (Новый Файл(ПутьФормы)).Существует() Тогда
		Возврат;
	КонецЕсли;
	ПутьИсх = ОбъединитьПути(ОбъединитьПути(КореньЦели, Описание.Папка, Описание.Имя, "Forms"), Описание.Форма + ".xml");
	УидБазы = УидОбъекта(ПутьИсх);
	Если УидБазы = "" Тогда
		Сообщить("удалить-ссылки: нет uuid формы " + Описание.Имя + "." + Описание.Форма);
		Возврат;
	КонецЕсли;
	ТипФормы = ТекстТега(ПрочитатьТекст(ПутьИсх), "FormType");
	Если ТипФормы = "" Тогда
		ТипФормы = "Managed";
	КонецЕсли;
	СвойУид = ДетерминированныйUuid("Form" + Символы.ПС + Описание.Имя + Символы.ПС + Описание.Форма);
	Т = Новый Массив;
	Т.Добавить("<?xml version=""1.0"" encoding=""UTF-8""?>");
	Т.Добавить("<MetaDataObject xmlns=""http://v8.1c.ru/8.3/MDClasses"" xmlns:xsi=""http://www.w3.org/2001/XMLSchema-instance"" version=""2.21"">");
	Т.Добавить(Символы.Таб + "<Form uuid=""" + СвойУид + """>");
	Т.Добавить(Символы.Таб + Символы.Таб + "<InternalInfo/>");
	Т.Добавить(Символы.Таб + Символы.Таб + "<Properties>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<ObjectBelonging>Adopted</ObjectBelonging>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<Name>" + ЭкранироватьXml(Описание.Форма) + "</Name>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<Comment/>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<ExtendedConfigurationObject>" + ЭкранироватьXml(УидБазы) + "</ExtendedConfigurationObject>");
	Т.Добавить(Символы.Таб + Символы.Таб + Символы.Таб + "<FormType>" + ЭкранироватьXml(ТипФормы) + "</FormType>");
	Т.Добавить(Символы.Таб + Символы.Таб + "</Properties>");
	Т.Добавить(Символы.Таб + "</Form>");
	Т.Добавить("</MetaDataObject>");
	ЗаписатьТекст(ПутьФормы, СтрСоединить(Т, Символы.ПС) + Символы.ПС);
КонецПроцедуры

Процедура ВставитьДочерний(ПутьXml, ТегДочернего, Имя, ТегОбъекта)
	Если ПутьXml = "" Или Не (Новый Файл(ПутьXml)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Метка = "<" + ТегДочернего + ">" + Имя + "</" + ТегДочернего + ">";
	Сырой = ПрочитатьСырой(ПутьXml);
	Если СтрНайти(Сырой, Метка) > 0 Тогда
		Возврат;
	КонецЕсли;
	СБом = ФайлСBOM(ПутьXml);
	СCR = СтрНайти(Сырой, Символы.ВК) > 0;
	Строки = СтрРазделить(СтрЗаменить(Сырой, Символы.ВК, ""), Символы.ПС, Истина);
	ИндексДетей = -1;
	ИндексОбъекта = -1;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если СтрНайти(Строки[Й], "</ChildObjects>") > 0 Тогда
			ИндексДетей = Й;
		КонецЕсли;
		Если СтрНайти(Строки[Й], "</" + ТегОбъекта + ">") > 0 Тогда
			ИндексОбъекта = Й;
		КонецЕсли;
	КонецЦикла;
	Если ИндексДетей >= 0 Тогда
		Отступ = Лев(Строки[ИндексДетей], СтрДлина(Строки[ИндексДетей]) - СтрДлина(СокрЛ(Строки[ИндексДетей])));
		Строки.Вставить(ИндексДетей, Отступ + Символы.Таб + Метка);
	ИначеЕсли ИндексОбъекта >= 0 Тогда
		Отступ = Лев(Строки[ИндексОбъекта], СтрДлина(Строки[ИндексОбъекта]) - СтрДлина(СокрЛ(Строки[ИндексОбъекта])));
		Строки.Вставить(ИндексОбъекта, Отступ + "</ChildObjects>");
		Строки.Вставить(ИндексОбъекта, Отступ + Символы.Таб + Метка);
		Строки.Вставить(ИндексОбъекта, Отступ + "<ChildObjects>");
	Иначе
		Возврат;
	КонецЕсли;
	ЗаписатьСохраняя(ПутьXml, СтрСоединить(Строки, Символы.ПС), СБом, СCR);
КонецПроцедуры

Функция ПутьОтКорня(Корень, Относительный)
	К = Корень;
	Если Не СтрЗаканчиваетсяНа(К, "\") И Не СтрЗаканчиваетсяНа(К, "/") Тогда
		К = К + "\";
	КонецЕсли;
	Возврат К + СтрЗаменить(Относительный, "/", "\");
КонецФункции

Процедура УбратьПустыеПодмены(КореньРасширения)
	Если КореньРасширения = "" Или Не (Новый Файл(КореньРасширения)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Маркер = "обработчик обновления отключён";
	Файлы = НайтиФайлы(КореньРасширения, "*.bsl", Истина);
	Для Каждого Ф Из Файлы Цикл
		Сырой = ПрочитатьСырой(Ф.ПолноеИмя);
		Если СтрНайти(Сырой, Маркер) = 0 Тогда
			Продолжить;
		КонецЕсли;
		СБом = ФайлСBOM(Ф.ПолноеИмя);
		СCR = СтрНайти(Сырой, Символы.ВК) > 0;
		Строки = СтрРазделить(СтрЗаменить(Сырой, Символы.ВК, ""), Символы.ПС, Истина);
		Нов = ВырезатьПустыеПодмены(Строки, Маркер);
		Если Нов <> Неопределено Тогда
			ЗаписатьСохраняя(Ф.ПолноеИмя, СтрСоединить(Нов, Символы.ПС), СБом, СCR);
			Сообщить("удалить-ссылки: убрана пустая подмена " + Ф.Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ВырезатьПустыеПодмены(Строки, Маркер)
	Удалять = Новый Соответствие;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если СтрНайти(Строки[Й], Маркер) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Начало = Й;
		Пока Начало > 0 Цикл
			Низ = НРег(СокрЛП(Строки[Начало]));
			Если СтрНачинаетсяС(Низ, "&вместо(") Или СтрНачинаетсяС(Низ, "&изменениеиконтроль(") Тогда
				Прервать;
			КонецЕсли;
			Начало = Начало - 1;
		КонецЦикла;
		Если Начало > 0 И СокрЛП(Строки[Начало - 1]) = "" Тогда
			Начало = Начало - 1;
		КонецЕсли;
		Конец = Й;
		Пока Конец < Строки.ВГраница() Цикл
			Если Разбор.ЭтоМаркерКонцаМетода(Строки[Конец], "конецпроцедуры")
				Или Разбор.ЭтоМаркерКонцаМетода(Строки[Конец], "конецфункции") Тогда
				Прервать;
			КонецЕсли;
			Конец = Конец + 1;
		КонецЦикла;
		Для К = Начало По Конец Цикл
			Удалять.Вставить(К, Истина);
		КонецЦикла;
	КонецЦикла;
	Если Удалять.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Рез = Новый Массив;
	Для Й = 0 По Строки.ВГраница() Цикл
		Если Удалять.Получить(Й) = Неопределено Тогда
			Рез.Добавить(Строки[Й]);
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции
