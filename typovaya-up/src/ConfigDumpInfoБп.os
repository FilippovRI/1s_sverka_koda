// Дополнение ConfigDumpInfo.xml записями из выгрузки БП (иерархический format).

Функция ВозвратТекст(Путь)
	Дв = Новый ДвоичныеДанные(Путь);
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Дв, "UTF-8");
КонецФункции

Функция ИмяИзСтрокиMetadata(Стр)
	Рв = Новый РегулярноеВыражение("name=""([^""]+)""");
	С = Рв.НайтиСовпадения(Стр);
	Если С.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат С[0].Группы[1].Значение;
КонецФункции

Функция ПодходитЛюбойПрефикс(Имя, Префиксы)
	Если Префиксы.Получить(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Ч = СтрРазделить(Имя, ".");
	Если Ч.Количество() >= 2 Тогда
		Кор = Ч[0] + "." + Ч[1];
		Если Префиксы.Получить(Кор) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция ИменаConfigDumpПотоком(Путь)
	Р = Новый Соответствие;
	Чт = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Пока Не Чт.КонецПотока() Цикл
		Стр = Чт.ПрочитатьСтроку();
		Если СтрНайти(Стр, "<Metadata") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Имя = ИмяИзСтрокиMetadata(Стр);
		Если Имя <> "" Тогда
			Р.Вставить(Имя, Истина);
		КонецЕсли;
	КонецЦикла;
	Чт.Закрыть();
	Возврат Р;
КонецФункции

Функция ИзвлечьБлокиЗаОдинПроход(ПутьБп, Префиксы, УжеВНазн, УжеДобавлены)
	Рез = Новый Массив;
	Если Не (Новый Файл(ПутьБп)).Существует() Тогда
		Возврат Рез;
	КонецЕсли;
	Чт = Новый ЧтениеТекста(ПутьБп, КодировкаТекста.UTF8);
	Буфер = Неопределено;
	Собираем = Ложь;
	Глуб = 0;
	Пока Не Чт.КонецПотока() Цикл
		Стр = Чт.ПрочитатьСтроку();
		Если Лев(Стр, 10) <> Символы.Таб + Символы.Таб + "<Metadata" Тогда
			Если Собираем Тогда
				Буфер.Добавить(Стр);
				Если СтрНайти(Стр, "</Metadata>") > 0 Тогда
					Глуб = Глуб - 1;
					Если Глуб = 0 Тогда
						Рез.Добавить(СтрСоединить(Буфер, Символы.ПС));
						Буфер = Неопределено;
						Собираем = Ложь;
					КонецЕсли;
				ИначеЕсли Прав(СокрП(Стр), 2) <> "/>" И СтрНайти(Стр, "<Metadata") > 0 Тогда
					Глуб = Глуб + 1;
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Имя = ИмяИзСтрокиMetadata(Стр);
		Если Имя = "" Или Не ПодходитЛюбойПрефикс(Имя, Префиксы) Или УжеВНазн.Получить(Имя) <> Неопределено Или УжеДобавлены.Получить(Имя) <> Неопределено Тогда
			Если Собираем Тогда
				Буфер.Добавить(Стр);
				Если СтрНайти(Стр, "</Metadata>") > 0 Тогда
					Глуб = Глуб - 1;
					Если Глуб = 0 Тогда
						Буфер = Неопределено;
						Собираем = Ложь;
					КонецЕсли;
				ИначеЕсли Прав(СокрП(Стр), 2) <> "/>" И СтрНайти(Стр, "<Metadata") > 0 Тогда
					Глуб = Глуб + 1;
				КонецЕсли;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		УжеДобавлены.Вставить(Имя, Истина);
		Если Прав(СокрП(Стр), 2) = "/>" Тогда
			Рез.Добавить(Стр);
		Иначе
			Буфер = Новый Массив;
			Буфер.Добавить(Стр);
			Собираем = Истина;
			Глуб = 1;
		КонецЕсли;
	КонецЦикла;
	Чт.Закрыть();
	Возврат Рез;
КонецФункции

Функция ДополнитьConfigDumpInfoИзБп(Корень, КореньБп, Префиксы, Лог) Экспорт
	Путь = ОбъединитьПути(Корень, "ConfigDumpInfo.xml");
	ПутьБп = ОбъединитьПути(КореньБп, "ConfigDumpInfo.xml");
	Если Не (Новый Файл(Путь)).Существует() Или Не (Новый Файл(ПутьБп)).Существует() Тогда
		Возврат 0;
	КонецЕсли;
	Имена = ИменаConfigDumpПотоком(Путь);
	Блоки = ИзвлечьБлокиЗаОдинПроход(ПутьБп, Префиксы, Имена, Новый Соответствие);
	Если Блоки.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Т = ВозвратТекст(Путь);
	Вставка = "";
	Для Каждого Б Из Блоки Цикл
		Вставка = Вставка + Б + Символы.ПС;
	КонецЦикла;
	Метка = Символы.Таб + "</ConfigVersions>";
	П = СтрНайти(Т, Метка, НаправлениеПоиска.СКонца);
	Если П = 0 Тогда
		Лог.Добавить("configdump: нет </ConfigVersions>");
		Возврат 0;
	КонецЕсли;
	Т = Лев(Т, П - 1) + Вставка + Символы.ПС + Сред(Т, П);
	ПолучитьДвоичныеДанныеИзСтроки(Т, КодировкаТекста.UTF8, Истина).Записать(Путь);
	Лог.Добавить("configdump: добавлено блоков " + Блоки.Количество());
	Возврат Блоки.Количество();
КонецФункции