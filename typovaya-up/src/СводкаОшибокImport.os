// Группировка ошибок ibcmd import из лога (stdout/stderr сохранён в файл).
Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	ВызватьИсключение "usage: oscript СводкаОшибокImport.os <log>";
КонецЕсли;
Путь = АргументыКоманднойСтроки[0];
Тм = Новый ТекстовыйДокумент;
Тм.Прочитать(Путь, КодировкаТекста.UTF8);
Т = Тм.ПолучитьТекст();
Группы = Новый Соответствие;
Группы.Вставить("XDTO_TYPE", 0);
Группы.Вставить("DATA_PATH", 0);
Группы.Вставить("UNKNOWN_COLOR", 0);
Группы.Вставить("BAD_COMMAND", 0);
	Группы.Вставить("UNKNOWN_METADATA", 0);
	Группы.Вставить("UNKNOWN_TYPE_NAME", 0);
Группы.Вставить("ENUM_PREDEFINED", 0);
Группы.Вставить("FILE_NOT_FOUND", 0);
Группы.Вставить("WARN_EVENT", 0);
Группы.Вставить("XDTO_PICTURE", 0);
Группы.Вставить("XDTO_COLOR", 0);
Группы.Вставить("XDTO_DYNAMICLIST", 0);
Файлы = Новый Соответствие;
Для Каждого Стр Из СтрРазделить(Т, Символы.ПС, Истина) Цикл
	Если СтрНайти(Стр, "XDTO") > 0 И СтрНайти(Стр, "DynamicList") > 0 Тогда
		Группы["XDTO_DYNAMICLIST"] = Группы["XDTO_DYNAMICLIST"] + 1;
	ИначеЕсли СтрНайти(Стр, "XDTO") > 0 И СтрНайти(Стр, "Свойство: 'Picture'") > 0 Тогда
		Группы["XDTO_PICTURE"] = Группы["XDTO_PICTURE"] + 1;
	ИначеЕсли СтрНайти(Стр, "XDTO") > 0 И СтрНайти(Стр, "Тип: {http://v8.1c.ru/8.1/data/ui}Color") > 0 Тогда
		Группы["XDTO_COLOR"] = Группы["XDTO_COLOR"] + 1;
	ИначеЕсли СтрНайти(Стр, "XDTO") > 0 И СтрНайти(Стр, "Свойство: 'Type'") > 0 Тогда
		Группы["XDTO_TYPE"] = Группы["XDTO_TYPE"] + 1;
	ИначеЕсли СтрНайти(Стр, "Неверный путь к данным") > 0 Тогда
		Группы["DATA_PATH"] = Группы["DATA_PATH"] + 1;
	ИначеЕсли СтрНайти(Стр, "неизвестный цвет") > 0 Тогда
		Группы["UNKNOWN_COLOR"] = Группы["UNKNOWN_COLOR"] + 1;
	ИначеЕсли СтрНайти(Стр, "Неверное имя команды") > 0 Тогда
		Группы["BAD_COMMAND"] = Группы["BAD_COMMAND"] + 1;
	ИначеЕсли СтрНайти(Стр, "Неизвестный объект метаданных") > 0 Тогда
		Группы["UNKNOWN_METADATA"] = Группы["UNKNOWN_METADATA"] + 1;
	ИначеЕсли СтрНайти(Стр, "Неизвестное имя типа") > 0 Тогда
		Группы["UNKNOWN_TYPE_NAME"] = Группы["UNKNOWN_TYPE_NAME"] + 1;
	ИначеЕсли СтрНайти(Стр, "предопределенный элемент") > 0 Тогда
		Группы["ENUM_PREDEFINED"] = Группы["ENUM_PREDEFINED"] + 1;
	ИначеЕсли СтрНайти(Стр, "Файл не найден") > 0 Тогда
		Группы["FILE_NOT_FOUND"] = Группы["FILE_NOT_FOUND"] + 1;
	ИначеЕсли СтрНайти(Стр, "[WARN]") > 0 Тогда
		Группы["WARN_EVENT"] = Группы["WARN_EVENT"] + 1;
	КонецЕсли;
КонецЦикла;
Сообщить("--- import error summary ---");
Для Каждого КЗ Из Группы Цикл
	Сообщить(КЗ.Ключ + ": " + КЗ.Значение);
КонецЦикла;