// Разбор модуля в АСД через vendored bsparser (vendor/bsparser, MIT):
// методы с точными позициями, отпечатки тел без пробелов/переносов/комментариев (в т.ч. // АПК:),
// отбор изменённых методов и проверка готовых хуков &ИзменениеИКонтроль.

Перем Парсер;
Перем ПарсерЗагружен;

Функция ЗагрузитьПарсер()
	Если ПарсерЗагружен <> Неопределено Тогда
		Возврат ПарсерЗагружен;
	КонецЕсли;
	ПарсерЗагружен = Ложь;
	Путь = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "vendor");
	Путь = ОбъединитьПути(Путь, "bsparser", "src");
	Путь = ОбъединитьПути(Путь, "ПарсерВстроенногоЯзыка", "Ext");
	Путь = ОбъединитьПути(Путь, "ObjectModule.bsl");
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Парсер = ЗагрузитьСценарий(Путь);
		ПарсерЗагружен = Истина;
	Исключение
		Парсер = Неопределено;
	КонецПопытки;
	Возврат ПарсерЗагружен;
КонецФункции

// Истина, если vendored bsparser загружается.
Функция Доступен() Экспорт
	Возврат ЗагрузитьПарсер();
КонецФункции

// Разбор модуля.
//
// Параметры:
//   Текст — исходный текст модуля (позиции считаются по нему, 1-based).
//
// Возвращаемое значение:
//   Структура ok, available, errors (массив строк), methods (массив ОписаниеМетода):
//   name, kind (Процедура/Функция), export, async, annotations (name, target), directives,
//   declStart/sigStart (line, column, pos — первый символ), sigEnd/end (последний символ включительно),
//   bodyStart/bodyEnd (pos тела между сигнатурой и КонецПроцедуры/КонецФункции),
//   signatureText/bodyText (байт в байт из Текст), signatureFingerprint, fingerprint.
Функция РазобратьМодульAST(Знач Текст) Экспорт
	Рез = Новый Структура("ok, available, errors, methods, outsideFingerprint", Ложь, ЗагрузитьПарсер(), Новый Массив, Новый Массив, "");
	Если Не Рез.available Тогда
		Возврат Рез;
	КонецЕсли;
	Модуль = Неопределено;
	Попытка
		Модуль = Парсер.Разобрать(Текст);
	Исключение
		Рез.errors.Добавить("Внутренняя ошибка парсера: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Для Каждого О Из Парсер.ТаблицаОшибок() Цикл
		Рез.errors.Добавить("L" + О.НомерСтрокиНачала + ":" + О.НомерКолонкиНачала + " " + О.Текст);
	КонецЦикла;
	Если Модуль = Неопределено Тогда
		Возврат Рез;
	КонецЕсли;
	Токены = Парсер.ТаблицаТокенов();
	Для Каждого Об Из Модуль.Объявления Цикл
		Если Об.Тип = "ОбъявлениеМетода" Тогда
			Рез.methods.Добавить(ОписаниеМетода(Текст, Токены, Об));
		КонецЕсли;
	КонецЦикла;
	Рез.outsideFingerprint = ОтпечатокВне(Текст, Токены, Рез.methods);
	Рез.ok = Рез.errors.Количество() = 0;
	Возврат Рез;
КонецФункции

// Отпечаток кода вне методов (переменные модуля, инициализация); комментарии не учитываются.
Функция ОтпечатокВне(Текст, Токены, Методы)
	Части = Новый Массив;
	Всего = Токены.Количество();
	Й = 0;
	Н = 0;
	Пока Й < Всего Цикл
		Если Н < Методы.Количество() И Й >= Методы[Н].tokFrom Тогда
			Й = Макс(Й, Методы[Н].tokTo + 1);
			Н = Н + 1;
			Продолжить;
		КонецЕсли;
		Фр = Отпечаток(Текст, Токены, Й, Й);
		Если Фр <> "" Тогда
			Части.Добавить(Фр);
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");
КонецФункции

Функция ОписаниеМетода(Текст, Токены, Об)
	Сиг = Об.Сигнатура;
	Нач = Об.Начало;
	Кон = Об.Конец;
	СигКон = Сиг.Конец;
	ДеклНач = Нач;
	Аннот = Новый Массив;
	Дир = Новый Массив;
	Если Сиг.Аннотации <> Неопределено Тогда
		Для Каждого А Из Сиг.Аннотации Цикл
			Аннот.Добавить(Новый Структура("name, target", А.Аннотация, ?(А.ИмяМетода = Неопределено, "", А.ИмяМетода)));
			Если А.Начало.Индекс < ДеклНач.Индекс Тогда
				ДеклНач = А.Начало;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Сиг.Директивы <> Неопределено Тогда
		Для Каждого Д Из Сиг.Директивы Цикл
			Дир.Добавить(Д.Директива);
			Если Д.Начало.Индекс < ДеклНач.Индекс Тогда
				ДеклНач = Д.Начало;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	ТелоС = СигКон.Позиция + СигКон.Длина;
	ТелоПо = Кон.Позиция - 1;
	М = Новый Структура("name, kind, export, async, annotations, directives, declStart, sigStart, sigEnd, bodyStart, bodyEnd, end, signatureText, bodyText, signatureFingerprint, fingerprint, tokFrom, tokTo");
	М.name = Сиг.Имя;
	М.kind = ?(Сиг.Тип = "ОбъявлениеСигнатурыФункции", "Функция", "Процедура");
	М.export = Сиг.Экспорт = Истина;
	М.async = Сиг.Асинх = Истина;
	М.annotations = Аннот;
	М.directives = Дир;
	М.declStart = Место(ДеклНач, Ложь);
	М.sigStart = Место(Нач, Ложь);
	М.sigEnd = Место(СигКон, Истина);
	М.bodyStart = ТелоС;
	М.bodyEnd = ТелоПо;
	М.end = Место(Кон, Истина);
	М.signatureText = Сред(Текст, Нач.Позиция, ТелоС - Нач.Позиция);
	М.bodyText = Сред(Текст, ТелоС, ТелоПо - ТелоС + 1);
	М.signatureFingerprint = НРег(СтрСоединить(Дир, ",")) + "|" + Отпечаток(Текст, Токены, Нач.Индекс, СигКон.Индекс);
	М.fingerprint = Отпечаток(Текст, Токены, СигКон.Индекс + 1, Кон.Индекс - 1);
	М.tokFrom = ДеклНач.Индекс;
	М.tokTo = Кон.Индекс;
	Возврат М;
КонецФункции

Функция Место(Токен, Последний)
	Сдвиг = ?(Последний, Макс(Токен.Длина, 1) - 1, 0);
	Возврат Новый Структура("line, column, pos", Токен.НомерСтроки, Токен.НомерКолонки + Сдвиг, Токен.Позиция + Сдвиг);
КонецФункции

// Нормализованный текст токенов: без пробелов, переносов и комментариев; регистр не важен, кроме строк.
Функция Отпечаток(Текст, Токены, Знач Перв, Знач Посл)
	Части = Новый Массив;
	Для Й = Перв По Посл Цикл
		Т = Токены[Й];
		Если Т.Токен = "Комментарий" Тогда
			Продолжить;
		КонецЕсли;
		Фр = Сред(Текст, Т.Позиция, Т.Длина);
		Если Т.Токен = "Строка" Или Т.Токен = "НачалоСтроки" Или Т.Токен = "ПродолжениеСтроки" Или Т.Токен = "ОкончаниеСтроки" Тогда
			Части.Добавить(Фр);
		Иначе
			Части.Добавить(НРег(Фр));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");
КонецФункции

// Разбор одного метода по фрагменту модуля (строки метода из быстрого разбора);
// позиции (line/pos, bodyStart/bodyEnd) пересчитываются в координаты всего модуля.
//
// Параметры:
//   Фрагмент — текст метода, точная подстрока модуля; НомерСтроки, Позиция — где он начинается (1-based).
//
// Возвращаемое значение:
//   Структура ok, errors, method (ОписаниеМетода как в РазобратьМодульAST). ok = Ложь — ошибка разбора или не один метод.
Функция РазобратьМетодФрагмента(Знач Фрагмент, НомерСтроки, Позиция) Экспорт
	Р = РазобратьМодульAST(Фрагмент);
	Рез = Новый Структура("ok, errors, method", Ложь, Новый Массив, Неопределено);
	Для Каждого Е Из Р.errors Цикл
		Рез.errors.Добавить("фрагмент с L" + НомерСтроки + ": " + Е);
	КонецЦикла;
	Если Не Р.available Тогда
		Рез.errors.Добавить("bsparser недоступен");
		Возврат Рез;
	ИначеЕсли Не Р.ok Тогда
		Возврат Рез;
	ИначеЕсли Р.methods.Количество() <> 1 Тогда
		Рез.errors.Добавить("фрагмент с L" + НомерСтроки + ": методов " + Р.methods.Количество() + " вместо одного");
		Возврат Рез;
	КонецЕсли;
	М = Р.methods[0];
	Для Каждого Ключ Из СтрРазделить("declStart,sigStart,sigEnd,end", ",") Цикл
		Т = М[Ключ];
		М[Ключ] = Новый Структура("line, column, pos", Т.line + НомерСтроки - 1, Т.column, Т.pos + Позиция - 1);
	КонецЦикла;
	М.bodyStart = М.bodyStart + Позиция - 1;
	М.bodyEnd = М.bodyEnd + Позиция - 1;
	Рез.method = М;
	Рез.ok = Истина;
	Возврат Рез;
КонецФункции

// Отбор изменённых методов: сравнение по отпечаткам (пробелы/переносы/комментарии не важны).
//
// Параметры:
//   ТекстИсх — модуль доработанной конфигурации (УП); ТекстПост — модуль поставщика (БП).
//
// Возвращаемое значение:
//   Структура ok, errors, same (число), changed — массив Структура(name, reason, source, vendor);
//   reason: onlySource | signature | body. ok = Ложь — разбор не удался, нужен старый маршрут.
//   removed — методы только у поставщика; source/vendor — все методы (РазобратьМодульAST);
//   outsideDiffers — отличается код вне методов (без комментариев и пробелов).
Функция ИзмененныеМетоды(Знач ТекстИсх, Знач ТекстПост) Экспорт
	Рез = Новый Структура("ok, errors, same, changed, removed, source, vendor, outsideDiffers",
		Ложь, Новый Массив, 0, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Ложь);
	А = РазобратьМодульAST(ТекстИсх);
	Б = РазобратьМодульAST(ТекстПост);
	Для Каждого Е Из А.errors Цикл
		Рез.errors.Добавить("source " + Е);
	КонецЦикла;
	Для Каждого Е Из Б.errors Цикл
		Рез.errors.Добавить("vendor " + Е);
	КонецЦикла;
	Если Не (А.ok И Б.ok) Тогда
		Возврат Рез;
	КонецЕсли;
	ПоИмени = Новый Соответствие;
	Для Каждого М Из Б.methods Цикл
		ПоИмени.Вставить(НРег(М.name), М);
	КонецЦикла;
	Для Каждого М Из А.methods Цикл
		В = ПоИмени.Получить(НРег(М.name));
		Если В = Неопределено Тогда
			Причина = "onlySource";
		ИначеЕсли М.signatureFingerprint <> В.signatureFingerprint Тогда
			Причина = "signature";
		ИначеЕсли М.fingerprint <> В.fingerprint Тогда
			Причина = "body";
		Иначе
			Рез.same = Рез.same + 1;
			Продолжить;
		КонецЕсли;
		Рез.changed.Добавить(Новый Структура("name, reason, source, vendor", М.name, Причина, М, В));
	КонецЦикла;
	ВИсх = Новый Соответствие;
	Для Каждого М Из А.methods Цикл
		ВИсх.Вставить(НРег(М.name), Истина);
	КонецЦикла;
	Для Каждого М Из Б.methods Цикл
		Если ВИсх.Получить(НРег(М.name)) = Неопределено Тогда
			Рез.removed.Добавить(М);
		КонецЕсли;
	КонецЦикла;
	Рез.source = А.methods;
	Рез.vendor = Б.methods;
	Рез.outsideDiffers = А.outsideFingerprint <> Б.outsideFingerprint;
	Рез.ok = Истина;
	Возврат Рез;
КонецФункции

Функция ВидДирективы(Знач Д)
	Если СтрНачинаетсяС(Д, "#конецвставки") Или СтрНачинаетсяС(Д, "#endinsert") Тогда
		Возврат "endins";
	ИначеЕсли СтрНачинаетсяС(Д, "#вставка") Или СтрНачинаетсяС(Д, "#insert") Тогда
		Возврат "ins";
	ИначеЕсли СтрНачинаетсяС(Д, "#конецудаления") Или СтрНачинаетсяС(Д, "#enddelete") Тогда
		Возврат "enddel";
	ИначеЕсли СтрНачинаетсяС(Д, "#удаление") Или СтрНачинаетсяС(Д, "#delete") Тогда
		Возврат "del";
	КонецЕсли;
	Возврат "";
КонецФункции

// Контроль готового хука: парность #Вставка/#Удаление, директивы с колонки 0,
// разбор обеих проекций (типовая — без вставок, итог — без удалений),
// сигнатура метода ровно один раз и не внутри #Удаление.
//
// Возвращаемое значение:
//   Структура ok, problems (массив строк; непустой — на ручной разбор).
Функция ПроверитьХук(Знач Текст) Экспорт
	Рез = Новый Структура("ok, problems", Истина, Новый Массив);
	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Виды = Новый Массив;
	Удаления = Новый Массив;
	Открыт = "";
	НачБлока = 0;
	Пары = Истина;
	Для Н = 0 По Строки.ВГраница() Цикл
		Ст = Строки[Н];
		Дир = ВидДирективы(НРег(СокрЛП(Ст)));
		Если Дир = "" Тогда
			Виды.Добавить(Открыт);
			Продолжить;
		КонецЕсли;
		Виды.Добавить("dir");
		Если Лев(Ст, 1) <> "#" Тогда
			Рез.problems.Добавить("L" + (Н + 1) + ": директива " + СокрЛП(Ст) + " не с колонки 0");
		КонецЕсли;
		Если Дир = "ins" Или Дир = "del" Тогда
			Если Открыт <> "" Тогда
				Рез.problems.Добавить("L" + (Н + 1) + ": вложенная " + СокрЛП(Ст) + " (блок открыт в L" + НачБлока + ")");
				Пары = Ложь;
			КонецЕсли;
			Открыт = Дир;
			НачБлока = Н + 1;
		Иначе
			Если Открыт <> Сред(Дир, 4) Тогда
				Рез.problems.Добавить("L" + (Н + 1) + ": непарная " + СокрЛП(Ст));
				Пары = Ложь;
			ИначеЕсли Открыт = "del" Тогда
				Удаления.Добавить(Новый Структура("from, to", НачБлока + 1, Н));
			КонецЕсли;
			Открыт = "";
		КонецЕсли;
	КонецЦикла;
	Если Открыт <> "" Тогда
		Рез.problems.Добавить("L" + НачБлока + ": блок не закрыт");
		Пары = Ложь;
	КонецЕсли;
	Если Пары Тогда
		Типовая = Новый Массив;
		Итог = Новый Массив;
		Для Н = 0 По Строки.ВГраница() Цикл
			В = Виды[Н];
			Типовая.Добавить(?(В = "ins" Или В = "dir", "", Строки[Н]));
			Итог.Добавить(?(В = "del" Или В = "dir", "", Строки[Н]));
		КонецЦикла;
		ПроверитьПроекцию(Рез, "типовая", СтрСоединить(Типовая, Символы.ПС), Удаления);
		ПроверитьПроекцию(Рез, "итог", СтрСоединить(Итог, Символы.ПС), Новый Массив);
	КонецЕсли;
	Рез.ok = Рез.problems.Количество() = 0;
	Возврат Рез;
КонецФункции

Процедура ПроверитьПроекцию(Рез, Имя, Текст, Удаления)
	Р = РазобратьМодульAST(Текст);
	Если Не Р.available Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Е Из Р.errors Цикл
		Рез.problems.Добавить("разбор (" + Имя + "): " + Е);
	КонецЦикла;
	Счет = Новый Соответствие;
	Для Каждого М Из Р.methods Цикл
		К = НРег(М.name);
		Счет.Вставить(К, ?(Счет[К] = Неопределено, 0, Счет[К]) + 1);
		Если Счет[К] = 2 Тогда
			Рез.problems.Добавить("сигнатура " + М.name + " встречается более одного раза (" + Имя + ")");
		КонецЕсли;
		Для Каждого У Из Удаления Цикл
			Если М.sigEnd.line >= У.from И М.sigStart.line <= У.to Тогда
				Рез.problems.Добавить("сигнатура " + М.name + " внутри #Удаление (L" + У.from + "-" + У.to + ")");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Проверяет все *.bsl каталога с &ИзменениеИКонтроль через ПроверитьХук.
//
// Возвращаемое значение:
//   Структура available, files, checked, failed, items (file, problems), ms.
Функция ПроверитьХукиКаталога(Каталог) Экспорт
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Р = Новый Структура("available, files, checked, failed, items, ms", ЗагрузитьПарсер(), 0, 0, 0, Новый Массив, 0);
	Если Не Р.available Или Не (Новый Файл(Каталог)).Существует() Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Каталог, "*.bsl", Истина) Цикл
		Р.files = Р.files + 1;
		Ч = Новый ЧтениеТекста(Ф.ПолноеИмя, КодировкаТекста.UTF8);
		Т = Ч.Прочитать();
		Ч.Закрыть();
		Если Т = Неопределено Или СтрНайти(НРег(Т), "&изменениеиконтроль") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Р.checked = Р.checked + 1;
		Пр = ПроверитьХук(Т);
		Если Не Пр.ok Тогда
			Р.failed = Р.failed + 1;
			Р.items.Добавить(Новый Структура("file, problems", Сред(Ф.ПолноеИмя, СтрДлина(Каталог) + 2), Пр.problems));
		КонецЕсли;
	КонецЦикла;
	Р.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Возврат Р;
КонецФункции