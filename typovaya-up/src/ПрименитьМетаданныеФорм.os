// Точечное применение возврата метаданных форм БП (без полного прогона typovaya-up).
// oscript src/ПрименитьМетаданныеФорм.os --основная <путь> --бп <путь> --уп <путь>

Основная = "";
Бп = "";
Уп = "";
Список = "C:\Users\rst_filippov\missing-bp-objects.txt";

Для Й = 0 По АргументыКоманднойСтроки.ВГраница() Цикл
	Если НРег(АргументыКоманднойСтроки[Й]) = "--основная" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Основная = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли НРег(АргументыКоманднойСтроки[Й]) = "--бп" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Бп = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли НРег(АргументыКоманднойСтроки[Й]) = "--уп" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Уп = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли НРег(АргументыКоманднойСтроки[Й]) = "--список" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Список = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	КонецЕсли;
КонецЦикла;

Если Основная = "" Или Бп = "" Тогда
	Сообщить("Нужны --основная и --бп");
	ВызватьИсключение "args";
КонецЕсли;
Если Уп = "" Тогда
	Уп = "D:\Выгрузка УП";
КонецЕсли;

Вм = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ВозвратМетаданныхФормБп.os"));
Лог = Новый Массив;
До = Вм.Сканировать(Основная, Бп);
Сообщить("До: missing refs (уник. теги): " + До.missing.Количество() + ", всего xr/cfg упоминаний " + До.refs);
Р = Вм.Исправить(Основная, Бп, Уп, Лог, Список);
Сообщить("Заготовок: " + Р.stubs + ", полный возврат: " + Р.full + ", строк Configuration: " + Р.configLines);
Отч = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "ОтчетHTML.os"));
Отч.ЗаписатьФайл(ОбъединитьПути(Основная, "forms_meta_apply.json"),
	Отч.ВJSON(Новый Структура("before, after, log", До, Р, Лог)));