// Заимствование полей по DataPath/запросам списков в готовом каталоге extension.
КореньСк = ТекущийСценарий().Каталог;
З = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ЗаимствованиеПолейСписков.os"));
Ч = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ЧерновикРасширения.os"));
КаталогРасш = "D:\typovaya-up-out-20261118u\extension";
КореньУп = "D:\Dtypovaya-up-load-e";
ИмяРасш = "УП_Доработки";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	КаталогРасш = АргументыКоманднойСтроки[0];
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	КореньУп = АргументыКоманднойСтроки[1];
КонецЕсли;
З.УстановитьЧерновик(Ч);
Р = З.Применить(КаталогРасш, КореньУп, ИмяРасш, Истина);
Сообщить("forms: " + Р.forms + ", addedObjects: " + Р.addedObjects.Количество() + ", addedChildren: " + Р.addedChildren.Количество());
Сообщить("missing: " + Р.missing.Количество());