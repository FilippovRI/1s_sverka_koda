// Сверка модулей двух выгрузок конфигурации 1С (УП vs типовая БП).
// Запуск: oscript src/Главный.os --исходная <папка> --поставщик <папка> [--настройки merge.xml] [--выход out]

Перем Каталог;

Функция Справка()
	Возврат "Сверка модулей выгрузок 1С: исходная (доработанная) vs поставщик (типовая).
	|
	|Использование:
	|  oscript src/Главный.os --исходная ""D:\Выгрузка УП"" --поставщик ""D:\Выгрузка БП"" --настройки merge.xml --выход out
	|
	|Параметры:
	|  --исходная, --source, -и     папка выгрузки доработанной конфигурации (с Configuration.xml)
	|  --поставщик, --vendor, -п    папка выгрузки типовой конфигурации поставщика
	|  --настройки, --settings, -н  XML настроек сравнения/объединения Конфигуратора (необязательно)
	|  --выход, --out, -в           папка результата (по умолчанию out)
	|  --расширение, --extension, -р  имя черновика расширения (по умолчанию УП_Доработки)
	|  --префикс, --prefix          префикс имён расширения (по умолчанию УП_)
	|
	|Результат: <выход>\razbor_moduley.html, <выход>\summary.json, <выход>\log.txt,
	|  <выход>\extension\ (черновик расширения, см. README.txt), <выход>\restored\ (типовые тексты модулей)";
КонецФункции

Функция РазобратьАргументы(Аргументы) Экспорт
	Синонимы = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("--исходная:source,--source:source,-и:source,--поставщик:vendor,--vendor:vendor,-п:vendor,"
		+ "--настройки:settings,--settings:settings,-н:settings,--выход:out,--out:out,-в:out,"
		+ "--расширение:extension,--extension:extension,-р:extension,--префикс:prefix,--prefix:prefix,"
		+ "--анализ-форм:__flag_forms,--forms-analysis:__flag_forms,--программа-форм:__flag_forms_program", ",") Цикл
		КЗ = СтрРазделить(Пара, ":");
		Синонимы.Вставить(КЗ[0], КЗ[1]);
	КонецЦикла;
	Результат = Новый Структура("source, vendor, settings, out, extension, prefix, analyzeForms, formsProgram, errors", "", "", "", "out", "УП_Доработки", "УП_", Ложь, Ложь, Новый Массив);
	Й = 0;
	Пока Й < Аргументы.Количество() Цикл
		Ключ = Синонимы.Получить(НРег(Аргументы[Й]));
		Если Ключ = "__flag_forms" Тогда
			Результат.analyzeForms = Истина;
		ИначеЕсли Ключ = "__flag_forms_program" Тогда
			Результат.analyzeForms = Истина;
			Результат.formsProgram = Истина;
		ИначеЕсли Ключ = Неопределено Тогда
			Результат.errors.Добавить("Неизвестный параметр: " + Аргументы[Й]);
		ИначеЕсли Й + 1 >= Аргументы.Количество() Тогда
			Результат.errors.Добавить("Нет значения для " + Аргументы[Й]);
		Иначе
			Результат[Ключ] = Аргументы[Й + 1];
			Й = Й + 1;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Если Результат.source = "" Тогда
		Результат.errors.Добавить("Не указана папка исходной конфигурации (--исходная).");
	КонецЕсли;
	Если Результат.vendor = "" Тогда
		Результат.errors.Добавить("Не указана папка конфигурации поставщика (--поставщик).");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция Загрузить(Имя)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Каталог, Имя + ".os"));
КонецФункции

Процедура Выполнить_(Аргументы)

	Если Аргументы.Количество() = 0 Тогда
		Сообщить(Справка());
		ЗавершитьРаботу(1);
	КонецЕсли;
	П = РазобратьАргументы(Аргументы);
	Если П.errors.Количество() > 0 Тогда
		Сообщить(СтрСоединить(П.errors, Символы.ПС));
		Сообщить("");
		Сообщить(Справка());
		ЗавершитьРаботу(1);
	КонецЕсли;
	Если Не (Новый Файл(П.source)).Существует() ИЛИ Не (Новый Файл(П.vendor)).Существует() Тогда
		Сообщить("Папка выгрузки не найдена: " + П.source + " / " + П.vendor);
		ЗавершитьРаботу(2);
	КонецЕсли;

	ПолныйВыход = НРег((Новый Файл(П.out)).ПолноеИмя) + "\";
	Для Каждого Вход Из СтрРазделить(П.source + "|" + П.vendor, "|") Цикл
		ПолныйВход = НРег((Новый Файл(Вход)).ПолноеИмя) + "\";
		Если СтрНачинаетсяС(СтрЗаменить(ПолныйВыход, "/", "\"), СтрЗаменить(ПолныйВход, "/", "\")) Тогда
			Сообщить("Папка результата не может лежать внутри выгрузки: " + П.out);
			ЗавершитьРаботу(2);
		КонецЕсли;
	КонецЦикла;

	Лог = Новый Массив;
	Выгрузка = Загрузить("ЧтениеВыгрузки");
	Настройки = Загрузить("НастройкиСравнения");
	Разбор = Загрузить("РазборМетодов");
	Синтез = Загрузить("СинтезХуков");
	Синтез.Инициализировать(Разбор);
	Сравнение = Загрузить("Сравнение");
	Отчет = Загрузить("ОтчетHTML");
	Сравнение.Инициализировать(Разбор, Выгрузка, Настройки, Синтез);

	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Исходная = Выгрузка.ПрочитатьВыгрузку(П.source, Лог);
	Поставщик = Выгрузка.ПрочитатьВыгрузку(П.vendor, Лог);
	Лог.Добавить("Исходная: " + Исходная.Имя + " " + Исходная.Версия + ", модулей без форм/макетов: " + Исходная.Модули.Количество());
	Лог.Добавить("Поставщик: " + Поставщик.Имя + " " + Поставщик.Версия + ", модулей без форм/макетов: " + Поставщик.Модули.Количество());

	Периметр = Неопределено;
	ИнфоНастроек = "";
	Если П.settings <> "" Тогда
		Если (Новый Файл(П.settings)).Существует() Тогда
			Н = Настройки.ПрочитатьНастройки(П.settings, Лог);
			Периметр = Н.Пути;
			ИнфоНастроек = Н.Основная + " <- " + Н.Вторая + " (" + Н.Связь + ")";
			Лог.Добавить("Настройки: объектов " + Н.ВсегоОбъектов + ", модулей в периметре " + Н.Пути.Количество() + ", не сопоставлено свойств " + Н.НеСопоставлено);
		Иначе
			Лог.Добавить("ПРЕДУПРЕЖДЕНИЕ: файл настроек не найден: " + П.settings + " — сравниваю все модули.");
		КонецЕсли;
	КонецЕсли;

	Модули = Сравнение.СравнитьВыгрузки(Исходная, Поставщик, Периметр, Лог);

	Если П.analyzeForms Тогда
		АнализФорм = Загрузить("АнализФорм");
		ФВыход = Новый Файл(П.out);
		Если Не ФВыход.Существует() Тогда
			СоздатьКаталог(П.out);
		КонецЕсли;
		АнализФорм.СравнитьФормы(Исходная.Корень, Поставщик.Корень, Периметр, П.out, Лог,
			Новый Структура("program", П.formsProgram));
	КонецЕсли;

	Мета = Новый Структура("source, vendor, sourceName, vendorName, settings, settingsInfo, generated",
		П.source, П.vendor, Исходная.Имя + " " + Исходная.Версия, Поставщик.Имя + " " + Поставщик.Версия,
		П.settings, ИнфоНастроек, Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm'"));
	Сводка = Отчет.СобратьСводку(Модули, Мета);

	ФВыход = Новый Файл(П.out);
	Если Не ФВыход.Существует() Тогда
		СоздатьКаталог(П.out);
	КонецЕсли;
	Отчет.ЗаписатьОтчет(Модули, Сводка, П.out, Каталог);

	Черновик = Загрузить("ЧерновикРасширения");
	Черновик.Инициализировать(Разбор, Настройки);
	ИтогЧ = Черновик.Записать(Модули, Исходная.Корень, П.out, П.extension, П.prefix, Лог);
	Лог.Добавить("Черновик расширения " + П.extension + " (префикс " + П.prefix + "): " + Отчет.ВJSON(ИтогЧ));
	Лог.Добавить("Итог: " + Отчет.ВJSON(Сводка.counts));
	Лог.Добавить("Время, с: " + Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт) / 1000, "ЧДЦ=1; ЧН=0"));
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "log.txt"), СтрСоединить(Лог, Символы.ПС));
	Сообщить(СтрСоединить(Лог, Символы.ПС));
	Сообщить("Отчёт: " + ОбъединитьПути(П.out, "razbor_moduley.html"));

КонецПроцедуры

Каталог = ТекущийСценарий().Каталог;
Выполнить_(АргументыКоманднойСтроки);
