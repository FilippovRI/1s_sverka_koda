// Сверка модулей двух выгрузок конфигурации 1С (УП vs типовая БП).
// Запуск: oscript src/Главный.os --исходная <папка> --поставщик <папка> [--настройки merge.xml] [--выход out]

Перем Каталог;
Перем Замеры; // Структура: ключ шага -> секунды (summary.json timings)
Перем ЛогЗамеров; // Массив строк log.txt
Перем НомерШага;
Перем КлючШага;
Перем НачалоШага;
Перем Прогресс;

// Текст справки CLI (пути, флаги отчёта/синтаксиса, ibcmd).
Функция Справка()
	Возврат "Сверка модулей выгрузок 1С: исходная (доработанная) vs поставщик (типовая).
	|
	|Использование:
	|  oscript src/Главный.os --исходная ""D:\Выгрузка УП"" --поставщик ""D:\Выгрузка БП"" --настройки merge.xml --выход out
	|
	|Параметры:
	|  --исходная, --source, -и     папка выгрузки доработанной конфигурации (с Configuration.xml)
	|  --поставщик, --vendor, -п    папка выгрузки типовой конфигурации поставщика
	|  --настройки, --settings, -н  XML настроек сравнения/объединения Конфигуратора (необязательно)
	|  --выход, --out, -в           папка результата (по умолчанию out)
	|  --расширение, --extension, -р  имя черновика расширения (по умолчанию УП_Доработки)
	|  --префикс, --prefix          префикс имён расширения (по умолчанию УП_)
	|  --только-модули-и-формы, --modules-forms-only  быстрый режим: restored = копия УП + дословно .bsl и Form.xml из БП;
	|                               без заготовок/stub, замкнутости, bsparser по всему выходу (extension — как обычно)
	|  --формы-из-уп, --forms-from-up  с --только-модули-и-формы: Form.xml и модули форм только из УП; из БП — прочие .bsl;
	|                               заимствованные формы в extension не пишутся (предчек overlay форм не нужен)
	|  --без-отчета, --no-report    не писать razbor_moduley.html (summary.json хранит пути для --только-отчет)
	|  --только-отчет, --report-only  только razbor_moduley.html в готовом --выход (без extension/restored/самопроверки);
	|                               --исходная/--поставщик/--настройки берутся из <выход>\summary.json, если не заданы
	|  --без-синтаксиса             не проверять модули extension/restored через bsparser (self_check syntax_errors)
	|  --синтаксис-лимит N          проверить не больше N модулей (0 — все; ~1–3 тыс. строк/с)
	|  --парсер, --parser          old (по умолчанию) | bsparser: отбор изменённых методов и сигнатуры по дереву bsparser, контроль хуков ИиК (ast_check.json)
	|  --лог-проверки, --check-log  лог CheckConfig основной: методы БП с ошибками компиляции -> заглушки (stubbed_methods.json)
	|  --корень-проверки            каталог, загруженный в базу при проверке (номера строк лога; по умолчанию <выход>\restored)
	|  --без-кэша, --no-cache      не брать/не писать кэш шага compare (<выход>\cache\compare.json)
	|  --только-restored, --only-restored  пересобрать только restored (compare из кэша; extension не трогается)
	|  --только-extension, --only-extension  только extension (compare из кэша; restored не трогается; включает --формы-из-уп;
	|                               в расширение — собственные общие модули/заглушки БП для ссылок из кода основной)
	|  --полная-проверка, --full-check  bsparser (syntax, astCheck) по всем модулям, без кэша по хешам (<выход>\cache)
	|  --ibcmd-загрузка             (opt-in) загрузить черновик в ИБ через ibcmd 8.5+
	|  --ibcmd-план                только план команд (без ibcmd import/apply)
	|  --ibcmd-путь                путь к ibcmd.exe (по умолчанию ibcmd в PATH)
	|  --ibcmd-база, --ibcmd-db    каталог файловой ИБ (--db-path)
	|  --ibcmd-data               каталог данных автономного сервера (--data)
	|  --ibcmd-пользователь        пользователь ИБ (--user)
	|  --ibcmd-пароль              пароль ИБ (--password)
	|
	|Результат: <выход>\razbor_moduley.html, <выход>\summary.json, <выход>\log.txt / report_only_log.txt,
	|  <выход>\extension\ (черновик), <выход>\restored\, <выход>\self_check.json;
	|  прогресс [шаг N] в log; timings в summary.json. Полная УП: копия выгрузки + overlay restored (см. README).";
КонецФункции

// Разбор argv в структуру параметров прогона.
//
// Параметры:
//   Аргументы — массив строк командной строки (как АргументыКоманднойСтроки).
//
// Возвращаемое значение:
//   Структура: source, vendor, settings, out, extension, prefix, флаги форм/отчёта/синтаксиса/ibcmd, errors (Массив).
Функция РазобратьАргументы(Аргументы) Экспорт
	Синонимы = Новый Соответствие;
	Для Каждого Пара Из СтрРазделить("--исходная:source,--source:source,-и:source,--поставщик:vendor,--vendor:vendor,-п:vendor,"
		+ "--настройки:settings,--settings:settings,-н:settings,--выход:out,--out:out,-в:out,"
		+ "--расширение:extension,--extension:extension,-р:extension,--префикс:prefix,--prefix:prefix,--анализ-форм:__flag_forms,--forms-analysis:__flag_forms,"
		+ "--превью-форм:__flag_forms_preview,--forms-preview:__flag_forms_preview,"
		+ "--перенос-форм:__flag_forms_transfer,--forms-transfer:__flag_forms_transfer,"
		+ "--без-отчета:__flag_no_report,--no-report:__flag_no_report,--только-отчет:__flag_report_only,--report-only:__flag_report_only,"
		+ "--только-модули-и-формы:__flag_modules_forms_only,--modules-forms-only:__flag_modules_forms_only,"
		+ "--формы-из-уп:__flag_forms_from_up,--forms-from-up:__flag_forms_from_up,"
		+ "--парсер:parser,--parser:parser,--без-синтаксиса:__flag_no_syntax,--no-syntax:__flag_no_syntax,--синтаксис-лимит:syntaxLimit,--syntax-limit:syntaxLimit,"
		+ "--проверить-скелет:skeleton,--validate-skeleton:skeleton,"
		+ "--лог-проверки:checkLog,--check-log:checkLog,--корень-проверки:checkRoot,--check-root:checkRoot,"
		+ "--лог-импорта:importLog,--import-log:importLog,"
		+ "--без-кэша:__flag_no_cache,--no-cache:__flag_no_cache,--только-restored:__flag_only_restored,--only-restored:__flag_only_restored,"
		+ "--только-extension:__flag_only_extension,--only-extension:__flag_only_extension,"
		+ "--полная-проверка:__flag_full_check,--full-check:__flag_full_check,"
		+ "--ibcmd-загрузка:__flag_ibcmd,--ibcmd-load:__flag_ibcmd,"
		+ "--ibcmd-план:__flag_ibcmd_plan,--ibcmd-plan:__flag_ibcmd_plan,"
		+ "--ibcmd-путь:ibcmdPath,--ibcmd-path:ibcmdPath,--ibcmd-база:ibcmdDb,--ibcmd-db:ibcmdDb,"
		+ "--ibcmd-data:ibcmdData,--ibcmd-пользователь:ibcmdUser,--ibcmd-user:ibcmdUser,"
		+ "--ibcmd-пароль:ibcmdPassword,--ibcmd-password:ibcmdPassword,"
		+ "--ibcmd-сервер:ibcmdServer,--ibcmd-dbms:ibcmdDbms,--ibcmd-имя-бд:ibcmdDbName,--ibcmd-db-name:ibcmdDbName", ",") Цикл
		КЗ = СтрРазделить(Пара, ":");
		Синонимы.Вставить(КЗ[0], КЗ[1]);
	КонецЦикла;
	Результат = Новый Структура(
		"source, vendor, settings, out, extension, prefix, analyzeForms, formsPreview, formsTransfer, noReport, reportOnly, modulesFormsOnly, formsFromUp, onlyRestored, onlyExtension, noSyntax, syntaxLimit, skeleton, ibcmdLoad, ibcmdPlan, ibcmdPath, ibcmdDb, ibcmdData, ibcmdUser, ibcmdPassword, ibcmdServer, ibcmdDbms, ibcmdDbName, parser, checkLog, checkRoot, importLog, noCache, fullCheck, errors",
		"", "", "", "out", "УП_Доработки", "УП_", Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь, "0", "", Ложь, Ложь, "", "", "", "", "", "", "", "", "old", "", "", "", Ложь, Ложь, Новый Массив);
	Й = 0;
	Пока Й < Аргументы.Количество() Цикл
		Ключ = Синонимы.Получить(НРег(Аргументы[Й]));
		Если Ключ = "__flag_forms" Тогда
			Результат.analyzeForms = Истина;
		ИначеЕсли Ключ = "__flag_forms_preview" Тогда
			Результат.formsPreview = Истина;
			Результат.analyzeForms = Истина;
		ИначеЕсли Ключ = "__flag_forms_transfer" Тогда
			Результат.formsTransfer = Истина;
			Результат.analyzeForms = Истина;
		ИначеЕсли Ключ = "__flag_no_report" Тогда
			Результат.noReport = Истина;
		ИначеЕсли Ключ = "__flag_report_only" Тогда
			Результат.reportOnly = Истина;
		ИначеЕсли Ключ = "__flag_modules_forms_only" Тогда
			Результат.modulesFormsOnly = Истина;
		ИначеЕсли Ключ = "__flag_forms_from_up" Тогда
			Результат.formsFromUp = Истина;
		ИначеЕсли Ключ = "__flag_only_restored" Тогда
			Результат.onlyRestored = Истина;
		ИначеЕсли Ключ = "__flag_only_extension" Тогда
			Результат.onlyExtension = Истина;
		ИначеЕсли Ключ = "__flag_no_syntax" Тогда
			Результат.noSyntax = Истина;
		ИначеЕсли Ключ = "__flag_no_cache" Тогда
			Результат.noCache = Истина;
		ИначеЕсли Ключ = "__flag_full_check" Тогда
			Результат.fullCheck = Истина;
		ИначеЕсли Ключ = "__flag_ibcmd" Тогда
			Результат.ibcmdLoad = Истина;
		ИначеЕсли Ключ = "__flag_ibcmd_plan" Тогда
			Результат.ibcmdLoad = Истина;
			Результат.ibcmdPlan = Истина;
		ИначеЕсли Ключ = Неопределено Тогда
			Результат.errors.Добавить("Неизвестный параметр: " + Аргументы[Й]);
		ИначеЕсли Й + 1 >= Аргументы.Количество() Тогда
			Результат.errors.Добавить("Нет значения для " + Аргументы[Й]);
		Иначе
			Результат[Ключ] = Аргументы[Й + 1];
			Й = Й + 1;
		КонецЕсли;
		Й = Й + 1;
	КонецЦикла;
	Если Результат.reportOnly Тогда
		ДополнитьИзСводки(Результат);
	КонецЕсли;
	Если Результат.reportOnly И Результат.noReport Тогда
		Результат.errors.Добавить("--только-отчет и --без-отчета несовместимы.");
	КонецЕсли;
	Если Результат.onlyExtension Тогда
		Результат.modulesFormsOnly = Истина;
		Результат.formsFromUp = Истина;
		Результат.noSyntax = Истина;
		Результат.noReport = Истина;
	КонецЕсли;
	Если Результат.modulesFormsOnly Тогда
		Результат.noSyntax = Истина;
		Результат.noReport = Истина;
	КонецЕсли;
	Если Результат.formsFromUp И Не Результат.modulesFormsOnly Тогда
		Результат.errors.Добавить("--формы-из-уп требует --только-модули-и-формы.");
	КонецЕсли;
	Если Результат.onlyRestored И Результат.onlyExtension Тогда
		Результат.errors.Добавить("--только-restored и --только-extension несовместимы.");
	КонецЕсли;
	Если (Результат.onlyRestored Или Результат.onlyExtension) И Результат.noCache Тогда
		Результат.errors.Добавить("--только-restored/--только-extension несовместимы с --без-кэша: нужен cache/compare.json.");
	КонецЕсли;
	Результат.parser = НРег(Результат.parser);
	Если Результат.parser <> "old" И Результат.parser <> "bsparser" Тогда
		Результат.errors.Добавить("--парсер: ожидается old или bsparser, получено " + Результат.parser);
	КонецЕсли;
	Если Результат.source = "" Тогда
		Результат.errors.Добавить("Не указана папка исходной конфигурации (--исходная).");
	КонецЕсли;
	Если Результат.vendor = "" Тогда
		Результат.errors.Добавить("Не указана папка конфигурации поставщика (--поставщик).");
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Режим --только-отчет: незаданные source/vendor/settings берутся из meta готового summary.json.
//
// Параметры:
//   Результат — структура РазобратьАргументы (поля out/source/vendor/settings/errors изменяются).
Процедура ДополнитьИзСводки(Результат)
	Сводка = Загрузить("ОтчетHTML").ПрочитатьСводку(Результат.out);
	Если Сводка = Неопределено Тогда
		Результат.errors.Добавить("Нет summary.json в " + Результат.out + " (сначала обычный прогон, можно с --без-отчета).");
		Возврат;
	КонецЕсли;
	Для Каждого Поле Из СтрРазделить("source,vendor,settings", ",") Цикл
		Если Результат[Поле] = "" И Сводка.meta.Свойство(Поле) Тогда
			Результат[Поле] = Сводка.meta[Поле];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Закрывает текущий шаг (секунды в Замеры) и открывает новый с выводом прогресса в консоль и лог.
//
// Параметры:
//   Ключ — идентификатор шага для timings (readDumps, compare, …).
//   Имя — человекочитаемая подпись в строке «[шаг N] …».
Процедура НачатьШаг(Ключ, Имя)
	ЗавершитьШаг();
	НомерШага = НомерШага + 1;
	КлючШага = Ключ;
	НачалоШага = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Стр = "[шаг " + НомерШага + "] " + Имя + " — " + Формат(ТекущаяДата(), "ДФ=HH:mm:ss");
	ЛогЗамеров.Добавить(Стр);
	Если Прогресс <> Неопределено Тогда
		Прогресс.Вывести(Стр);
	Иначе
		Сообщить(Стр);
	КонецЕсли;
КонецПроцедуры

Процедура ЗавершитьШаг()
	Если КлючШага = "" Тогда
		Возврат;
	КонецЕсли;
	ДобавитьЗамер(КлючШага, ТекущаяУниверсальнаяДатаВМиллисекундах() - НачалоШага);
	КлючШага = "";
КонецПроцедуры

Процедура ДобавитьЗамер(Ключ, Мс)
	Сек = Окр(Мс / 1000, 1);
	Если Замеры.Свойство(Ключ) Тогда
		Замеры[Ключ] = Замеры[Ключ] + Сек;
	Иначе
		Замеры.Вставить(Ключ, Сек);
	КонецЕсли;
КонецПроцедуры

// Делит замер Целое на часть Часть (мс внутри шага), не уходя в минус.
Процедура ВыделитьЗамер(Целое, Часть, Мс)
	Сек = Окр(Мс / 1000, 1);
	Замеры.Вставить(Часть, Сек);
	Если Замеры.Свойство(Целое) Тогда
		Замеры[Целое] = Макс(0, Окр(Замеры[Целое] - Сек, 1));
	КонецЕсли;
КонецПроцедуры

Функция ТекстЗамеров()
	Ч = Новый Массив;
	Для Каждого КЗ Из Замеры Цикл
		Ч.Добавить(КЗ.Ключ + "=" + Формат(КЗ.Значение, "ЧДЦ=1; ЧН=0; ЧРД=."));
	КонецЦикла;
	Возврат "Время по шагам, с: " + СтрСоединить(Ч, ", ");
КонецФункции

// Шаг stubbedMethods: методы БП, на которых основная не компилируется (лог CheckConfig, --лог-проверки),
// глушатся в restored; хуки &ИзменениеИКонтроль расширения переписываются под заглушку. Номера строк
// лога — по каталогу --корень-проверки (что было загружено в базу; по умолчанию restored). stubbed_methods.json.
Функция ЗаглушитьМетодыБпПоЛогу(П, КореньБп, Лог) Экспорт
	Зм = Загрузить("ЗаглушкиМетодовБп");
	Зм.Инициализировать(Загрузить("РазборМетодов"));
	КаталогВосст = ОбъединитьПути(П.out, "restored");
	КореньПроверки = ?(П.checkRoot = "", КаталогВосст, П.checkRoot);
	ФЛог = Зм.ПрочитатьФайл(П.checkLog);
	Ошибки = ?(ФЛог = Неопределено, Новый Массив, Зм.ОшибкиОсновнойИзЛога(ФЛог.Текст));
	Отбор = Зм.Отобрать(Ошибки, КореньПроверки, КореньБп);
	Ит = Зм.Применить(Отбор, КаталогВосст, КореньБп, ОбъединитьПути(П.out, "extension"));
	Загрузить("ОтчетHTML").ЗаписатьФайл(ОбъединитьПути(П.out, "stubbed_methods.json"), Загрузить("ОтчетHTML").ВJSON(
		Новый Структура("count, stubbed, already, notVendor, hooksRewritten, items, skipped",
		Отбор.items.Количество(), Ит.stubbed, Ит.already, Ит.notVendor, Ит.hooksRewritten, Отбор.items, Отбор.skipped)));
	Лог.Добавить("Заглушки методов БП по логу проверки: ошибок основной " + Ошибки.Количество() + ", методов " + Отбор.items.Количество()
		+ " (заглушено " + Ит.stubbed + ", уже " + Ит.already + ", хуков ИиК переписано " + Ит.hooksRewritten
		+ "), пропущено " + Отбор.skipped.Количество() + " — stubbed_methods.json");
	Возврат Новый Структура("errors, methods, stubbed, hooksRewritten, skipped", Ошибки.Количество(), Отбор.items.Количество(),
		Ит.stubbed, Ит.hooksRewritten, Отбор.skipped.Количество());
КонецФункции

Функция Загрузить(Имя)
	Возврат ЗагрузитьСценарий(ОбъединитьПути(Каталог, Имя + ".os"));
КонецФункции

// Итоговое время, замеры в log и (если передана Сводка) в summary.json → timings.
//
// Параметры:
//   П — структура CLI; Лог — массив строк; Отчет — модуль ОтчетHTML;
//   Старт — универсальные мс старта прогона; ИмяЛога — log.txt или report_only_log.txt;
//   Сводка — структура summary или Неопределено (не перезаписывать summary.json).
Процедура ЗавершитьРаботуСЛогом(П, Лог, Отчет, Старт, ИмяЛога, Сводка)
	ЗавершитьШаг();
	Замеры.Вставить("total", Окр((ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт) / 1000, 1));
	Лог.Добавить(ТекстЗамеров());
	Лог.Добавить("Время, с: " + Формат(Замеры.total, "ЧДЦ=1; ЧН=0"));
	Если Сводка <> Неопределено Тогда
		Сводка.Вставить("timings", Замеры);
		Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
	КонецЕсли;
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, ИмяЛога), СтрСоединить(Лог, Символы.ПС));
	Сообщить(СтрСоединить(Лог, Символы.ПС));
	Если П.noReport Тогда
		Сообщить("Отчёт не формировался (--без-отчета).");
	Иначе
		Сообщить("Отчёт: " + ОбъединитьПути(П.out, "razbor_moduley.html"));
	КонецЕсли;
КонецПроцедуры

// Модули, сравнённые по АСД (parser = bsparser), и откаты на старый маршрут (path, errors).
Функция СтатистикаBsparser(Модули)
	Рез = Новый Структура("ast, fallbacks", 0, Новый Массив);
	Для Каждого М Из Модули Цикл
		Если Не М.Свойство("parser") Тогда
			Продолжить;
		ИначеЕсли М.parser = "fallback" Тогда
			Рез.fallbacks.Добавить(Новый Структура("path, errors", М.path, М.parserErrors));
		Иначе
			Рез.ast = Рез.ast + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Процедура Выполнить_(Аргументы)

	Если Аргументы.Количество() = 0 Тогда
		Сообщить(Справка());
		ЗавершитьРаботу(1);
	КонецЕсли;
	П = РазобратьАргументы(Аргументы);
	Если П.errors.Количество() > 0 Тогда
		Сообщить(СтрСоединить(П.errors, Символы.ПС));
		Сообщить("");
		Сообщить(Справка());
		ЗавершитьРаботу(1);
	КонецЕсли;
	Если Не (Новый Файл(П.source)).Существует() ИЛИ Не (Новый Файл(П.vendor)).Существует() Тогда
		Сообщить("Папка выгрузки не найдена: " + П.source + " / " + П.vendor);
		ЗавершитьРаботу(2);
	КонецЕсли;

	ПолныйВыход = НРег((Новый Файл(П.out)).ПолноеИмя) + "\";
	Для Каждого Вход Из СтрРазделить(П.source + "|" + П.vendor, "|") Цикл
		ПолныйВход = НРег((Новый Файл(Вход)).ПолноеИмя) + "\";
		Если СтрНачинаетсяС(СтрЗаменить(ПолныйВыход, "/", "\"), СтрЗаменить(ПолныйВход, "/", "\")) Тогда
			Сообщить("Папка результата не может лежать внутри выгрузки: " + П.out);
			ЗавершитьРаботу(2);
		КонецЕсли;
	КонецЦикла;

	Лог = Новый Массив;
	Замеры = Новый Структура;
	ЛогЗамеров = Лог;
	НомерШага = 0;
	КлючШага = "";
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ФВыходРанний = Новый Файл(П.out);
	Если Не ФВыходРанний.Существует() Тогда
		СоздатьКаталог(П.out);
	КонецЕсли;
	Прогресс = Загрузить("ПрогрессПрогона");
	Прогресс.УстановитьПутьЛога(ОбъединитьПути(П.out, "log.txt"));
	Выгрузка = Загрузить("ЧтениеВыгрузки");
	Настройки = Загрузить("НастройкиСравнения");
	Разбор = Загрузить("РазборМетодов");
	Синтез = Загрузить("СинтезХуков");
	Синтез.Инициализировать(Разбор, Загрузить("БезопасностьПереноса"));
	Сравнение = Загрузить("Сравнение");
	Отчет = Загрузить("ОтчетHTML");
	Сравнение.Инициализировать(Разбор, Выгрузка, Настройки, Синтез,
		Загрузить("КонтрактМетода"), Загрузить("БезопасностьПереноса"));
	Аст = Неопределено;
	Если П.parser = "bsparser" Тогда
		Аст = Загрузить("РазборAST");
		Сравнение.ВключитьBsparser(Аст);
	КонецЕсли;

	НачатьШаг("readDumps", "Чтение выгрузок");
	Исходная = Выгрузка.ПрочитатьВыгрузку(П.source, Лог);
	Поставщик = Выгрузка.ПрочитатьВыгрузку(П.vendor, Лог);
	Лог.Добавить("Исходная: " + Исходная.Имя + " " + Исходная.Версия + ", модулей без форм/макетов: " + Исходная.Модули.Количество());
	Лог.Добавить("Поставщик: " + Поставщик.Имя + " " + Поставщик.Версия + ", модулей без форм/макетов: " + Поставщик.Модули.Количество());

	НачатьШаг("readSettings", "Чтение настроек сравнения");
	Периметр = Неопределено;
	ИнфоНастроек = "";
	Если П.settings <> "" Тогда
		Если (Новый Файл(П.settings)).Существует() Тогда
			Н = Настройки.ПрочитатьНастройки(П.settings, Лог);
			Периметр = Н.Пути;
			ИнфоНастроек = Н.Основная + " <- " + Н.Вторая + " (" + Н.Связь + ")";
			Лог.Добавить("Настройки: объектов " + Н.ВсегоОбъектов + ", модулей в периметре " + Н.Пути.Количество() + ", не сопоставлено свойств " + Н.НеСопоставлено);
		Иначе
			Лог.Добавить("ПРЕДУПРЕЖДЕНИЕ: файл настроек не найден: " + П.settings + " — сравниваю все модули.");
		КонецЕсли;
	КонецЕсли;

	НачатьШаг("compare", "Сравнение модулей и синтез хуков/&ИзменениеИКонтроль");
	КэшП = Загрузить("КэшПроверок");
	ПутьКэшаСр = ОбъединитьПути(П.out, "cache", "compare.json");
	КлючСр = "";
	Модули = Неопределено;
	СтрокиBsparser = Неопределено;
	КэшСравнения = Ложь;
	Если Не П.noCache Тогда
		КлючСр = КэшП.КлючСравнения(Исходная, Поставщик, П.settings, Каталог, П.parser);
		Сохр = КэшП.ПрочитатьСравнение(ПутьКэшаСр, КлючСр);
		Если Сохр <> Неопределено Тогда
			Модули = Сохр.modules;
			СтрокиBsparser = Сохр.bsparserReport;
			КэшСравнения = Истина;
			Лог.Добавить("compare: результат взят из кэша " + ПутьКэшаСр + " (ключ совпал; отключить — --без-кэша)");
		КонецЕсли;
	КонецЕсли;
	Если (П.onlyRestored Или П.onlyExtension) И Не КэшСравнения И (Новый Файл(ПутьКэшаСр)).Существует() Тогда
		Сохр = КэшП.ПрочитатьСравнениеЛюбой(ПутьКэшаСр);
		Если Сохр <> Неопределено Тогда
			Модули = Сохр.modules;
			СтрокиBsparser = Сохр.bsparserReport;
			КэшСравнения = Истина;
			Лог.Добавить("compare: кэш " + ПутьКэшаСр + " (ключ не проверялся — only restored/extension)");
		КонецЕсли;
	КонецЕсли;
	Если (П.onlyRestored Или П.onlyExtension) И Модули = Неопределено Тогда
		Сообщить("--только-restored/--только-extension: нет cache/compare.json в " + П.out);
		ЗавершитьРаботу(2);
	КонецЕсли;
	Если П.onlyExtension И Не (Новый Файл(ОбъединитьПути(П.out, "restored", "Configuration.xml"))).Существует() Тогда
		Сообщить("--только-extension: нет restored/Configuration.xml в " + П.out);
		ЗавершитьРаботу(2);
	КонецЕсли;
	Если Модули = Неопределено Тогда
		Модули = Сравнение.СравнитьВыгрузки(Исходная, Поставщик, Периметр, Лог);
		СтрокиBsparser = Сравнение.ОтчетBsparser();
		Если Не П.noCache Тогда
			КэшП.ЗаписатьСравнение(ПутьКэшаСр, КлючСр, Модули, СтрокиBsparser);
		КонецЕсли;
	КонецЕсли;
	Замеры.Вставить("compareCached", ?(КэшСравнения, 1, 0));
	Стат = СтатистикаBsparser(Модули);
	Если Аст <> Неопределено Тогда
		Лог.Добавить("bsparser: модулей сравнено по дереву разбора " + Стат.ast + ", откат на старый маршрут " + Стат.fallbacks.Количество());
		Для Каждого Стр Из СтрокиBsparser Цикл
			Лог.Добавить(Стр);
		КонецЦикла;
	КонецЕсли;

	Если П.reportOnly Тогда
		НачатьШаг("reportHtml", "HTML-отчёт (только отчёт)");
		Сводка = Отчет.СобратьСводку(Модули, Неопределено);
		Готовая = Отчет.ПрочитатьСводку(П.out);
		Сводка.meta = Готовая.meta;
		Если Аст <> Неопределено Тогда
			РхГ = Неопределено;
			Если Готовая.Свойство("bsparser") Тогда
				РхГ = Готовая.bsparser.astCheck;
			КонецЕсли;
			Сводка.Вставить("bsparser", Новый Структура("astCheck, fallbacks", РхГ, Стат.fallbacks));
		КонецЕсли;
		Отчет.ЗаписатьHtml(Модули, Сводка, П.out, Каталог);
		РезОбр = Отчет.ПрочитатьJsonФайл(ОбъединитьПути(П.out, "reverse_build.json"));
		Если РезОбр <> Неопределено Тогда
			ОбрО = Загрузить("ОбратнаяСборка");
			ОбрО.Инициализировать(Разбор);
			ОбрО.ВставитьВHtml(РезОбр, ОбъединитьПути(П.out, "razbor_moduley.html"));
		КонецЕсли;
		ЗавершитьРаботуСЛогом(П, Лог, Отчет, Старт, "report_only_log.txt", Неопределено);
		Возврат;
	КонецЕсли;

	Если П.analyzeForms Тогда
		НачатьШаг("forms", "Анализ форм");
		АнализФорм = Загрузить("АнализФорм");
		АнализФорм.СравнитьФормы(Исходная.Корень, Поставщик.Корень, Периметр, П.out, Лог, П.formsPreview, П.formsTransfer);
	КонецЕсли;

	Мета = Новый Структура("source, vendor, sourceName, vendorName, settings, settingsInfo, generated",
		П.source, П.vendor, Исходная.Имя + " " + Исходная.Версия, Поставщик.Имя + " " + Поставщик.Версия,
		П.settings, ИнфоНастроек, Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm'"));
	Сводка = Отчет.СобратьСводку(Модули, Мета);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
	Если П.noReport Тогда
		Лог.Добавить("HTML-отчёт не формировался (--без-отчета); построить позже: --только-отчет --выход " + П.out);
	ИначеЕсли П.parser <> "bsparser" Тогда
		// С bsparser отчёт пишется один раз после контроля хуков (итоговая сводка), без промежуточных записей.
		НачатьШаг("reportHtml", "HTML-отчёт");
		Отчет.ЗаписатьHtml(Модули, Сводка, П.out, Каталог);
	КонецЕсли;

	НачатьШаг("extension", "Запись extension и restored (с замыканием хелперов)");
	Черновик = Загрузить("ЧерновикРасширения");
	Черновик.Инициализировать(Разбор, Настройки);
	Черновик.УстановитьТолькоМодулиИФормы(П.modulesFormsOnly);
	Черновик.УстановитьФормыИзУп(П.formsFromUp);
	Черновик.УстановитьТолькоRestored(П.onlyRestored);
	Черновик.УстановитьТолькоExtension(П.onlyExtension);
	ИтогЧ = Черновик.Записать(Модули, Исходная.Корень, П.out, П.extension, П.prefix, Лог, Поставщик.Корень);
	Лог.Добавить("Черновик расширения " + П.extension + " (префикс " + П.prefix + "): " + Отчет.ВJSON(ИтогЧ));
	ЗавершитьШаг();
	ЗамЧ = Черновик.ЗамерыМс();
	ВыделитьЗамер("extension", "helpers", ЗамЧ.helpersMs);
	ВыделитьЗамер("extension", "restored", ЗамЧ.restoredMs);
	ВыделитьЗамер("extension", "scaffold", ЗамЧ.scaffoldMs);
	ВыделитьЗамер("extension", "moduleLoop", ЗамЧ.modulesLoopMs);
	ВыделитьЗамер("extension", "dynlist", ЗамЧ.dynlistMs);
	ВыделитьЗамер("extension", "finalize", ЗамЧ.finalizeMs);
	Сводка.Вставить("returnedToVendor", ИтогЧ.returnedToVendor);
	Доз = Загрузить("ДозаполнениеМодуля");
	Доз.Инициализировать(Разбор);
	Если П.onlyRestored Тогда
		ИтогОб = Новый Структура("count", 0);
		Замеры.Вставить("wrappersAdded", 0);
		Сводка.Вставить("wrappersAdded", 0);
		Лог.Добавить("--только-restored: шаг обёрток &Вместо пропущен (extension не менялся)");
	ИначеЕсли П.onlyExtension Тогда
		ИтогОб = Новый Структура("count", 0);
		Замеры.Вставить("wrappersAdded", 0);
		Сводка.Вставить("wrappersAdded", 0);
		Лог.Добавить("--только-extension: обёртки &Вместо пропущены (restored не меняется)");
	Иначе
		НачатьШаг("wrappersAdded", "Обёртки &Вместо в расширении по вызовам неэкспортных методов");
		ИтогОб = Доз.ОбработатьОбёрткиВместо(П.out, П.prefix);
		Сводка.Вставить("wrappersAdded", ИтогОб.count);
		Лог.Добавить("В расширение добавлены обёртки &Вместо: " + ИтогОб.count + " методов (wrappers_added.json)");
		ЗавершитьШаг();
	КонецЕсли;
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
	Если Не П.noReport И П.parser <> "bsparser" Тогда
		Отчет.ЗаписатьHtml(Модули, Сводка, П.out, Каталог);
	КонецЕсли;

	Если П.onlyExtension Тогда
		ПровФ = Загрузить("ПроверкаРасширенияБезФорм");
		Рф = ПровФ.ПроверитьКаталог(ОбъединитьПути(П.out, "extension"));
		Сводка.Вставить("extensionNoForms", Рф);
		Лог.Добавить("extensionNoForms: dirs=" + Рф.formsDirs + " bodies=" + Рф.formExtXml + " cfgFormRefs=" + Рф.formRefsInConfiguration);
		Если Не Рф.ok Тогда
			Сообщить("ПРЕДУПРЕЖДЕНИЕ: extension содержит формы при --формы-из-уп");
		КонецЕсли;
	КонецЕсли;
	Если П.modulesFormsOnly Тогда
		Мф = Загрузить("МодулиИФормыБыстро");
		КаталогВосст = ОбъединитьПути(П.out, "restored");
		Если П.onlyExtension Тогда
			Сводка.Вставить("formsFromUp", П.formsFromUp);
			Лог.Добавить("--только-extension: restored не пересобирался (меняется только шагом upOnlyCmFromRestored: ОМ только УП)");
			ВозвращённыеОм = Новый Соответствие;
			Если Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосст, "Configuration.xml"))).Существует() Тогда
				// Решение 24.11 («давай вернем»): ОМ только БП, на которые ссылается restored, + транзитивная цепочка объектов БП — в restored.
				НачатьШаг("returnBpObjects", "Возврат ОМ только БП и их цепочки объектов БП в restored");
				Рво = Загрузить("ВозвратОбъектовБпВRestored").Вернуть(КаталогВосст, Поставщик.Корень, ОбъединитьПути(П.out, "extension"), Лог, П.out);
				ВозвращённыеОм = ОмИзВозврата(Рво);
				Сводка.Вставить("returnBpObjects", Новый Структура("count, byTag, files, configLines, extRemoved",
					Рво.order.Количество(), Рво.byTag, Рво.files, Рво.configLines, Рво.extRemoved));
				ЗавершитьШаг();
			КонецЕсли;
			Если Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосст, "Configuration.xml"))).Существует() Тогда
				НачатьШаг("bpModulesExtension", "Заглушки общих модулей БП в extension (restored не меняется)");
				ВозвратБп = Загрузить("ВозвратОбщихМодулейБп");
				МбРасш = Загрузить("МодулиБпВРасширении");
				МбРасш.Инициализировать(ВозвратБп);
				Рмб = МбРасш.Обеспечить(КаталогВосст, ОбъединитьПути(П.out, "extension"), Поставщик.Корень, Лог, П.out);
				Сводка.Вставить("bpModulesExtension", Рмб);
				ЗавершитьШаг();
			КонецЕсли;
			Если Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосст, "Configuration.xml"))).Существует() Тогда
				// Вариант А (24.11): вызовы ОМ только БП в модулях приложения/сеанса — из restored в extension (&ИзменениеИКонтроль).
				НачатьШаг("appModuleBpCalls", "Вызовы ОМ только БП в модулях приложения: restored → extension");
				Рпм = Загрузить("ВызовыОмБпМодулейПриложения").Применить(КаталогВосст, ОбъединитьПути(П.out, "extension"), Поставщик.Корень, П.prefix, Лог, П.out, ВозвращённыеОм);
				Сводка.Вставить("appModuleBpCalls", Новый Структура("restoredFiles, extensionMethods, statements, skipped",
					Рпм.restoredFiles, Рпм.extensionMethods, Рпм.statements, Рпм.skipped.Количество()));
				ЗавершитьШаг();
			КонецЕсли;
			Если Исходная.Корень <> "" И Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосст, "Configuration.xml"))).Существует() Тогда
				// Решение 23.11: ОМ только УП (нет в БП) — только собственными объектами extension, из restored убираются.
				НачатьШаг("upOnlyCmFromRestored", "Общие модули только УП: из restored в extension");
				Чр = Загрузить("ЧерновикРасширения");
				Пер = Загрузить("ПереносОбъектовУп");
				ОТУ = Загрузить("ОбъектыТолькоУп");
				Пер.Инициализировать(Чр, ОТУ);
				Руо = Пер.УбратьОбщиеМодулиТолькоУпИзRestored(ОбъединитьПути(П.out, "extension"), КаталогВосст, Исходная.Корень, Поставщик.Корень,
					Новый Соответствие, П.extension, Лог, П.out);
				Сводка.Вставить("upOnlyCmFromRestored", Новый Структура("removed, extAdded, extHad, extReplacedAdopted, refsFiles, refsLines, xmlRefs",
					Руо.removed, Руо.extAdded, Руо.extHad, Руо.extReplacedAdopted, Руо.refsFiles, Руо.refsLines, Руо.xmlRefs));
				ЗавершитьШаг();
				// Решение 24.11 (t724s2564): мелкие объекты только УП со ссылками на убранные ОМ — в extension; прочее — todo.
				НачатьШаг("smallUpOnlyObjects", "Мелкие объекты только УП (обработки, отчёты, общие команды/формы) → extension");
				Рмо = Загрузить("ПереносМелкихОбъектовУп").Применить(ОбъединитьПути(П.out, "extension"), КаталогВосст, Исходная.Корень, Поставщик.Корень,
					П.extension, Лог, П.out);
				Сводка.Вставить("smallUpOnlyObjects", Новый Структура("moved, files, todoA, todoB", Рмо.moved, Рмо.files, Рмо.todoA, Рмо.todoB));
				ЗавершитьШаг();
			КонецЕсли;
			Если Исходная.Корень <> "" И Поставщик.Корень <> "" Тогда
				НачатьШаг("upModulesExtension", "Общие модули УП в extension по ссылкам из кода расширения");
				Чр = Загрузить("ЧерновикРасширения");
				Пер = Загрузить("ПереносОбъектовУп");
				ОТУ = Загрузить("ОбъектыТолькоУп");
				Пер.Инициализировать(Чр, ОТУ);
				КаталогРасш = ОбъединитьПути(П.out, "extension");
				Ру = Пер.ДополнитьОбщиеМодулиПоСсылкам(КаталогРасш, КаталогВосст, Исходная.Корень, Поставщик.Корень, Новый Соответствие, П.extension, Лог, П.out);
				Сводка.Вставить("upModulesExtension", Ру);
				ЗавершитьШаг();
			КонецЕсли;
			Если Исходная.Корень <> "" И Поставщик.Корень <> "" Тогда
				НачатьШаг("extensionAlignMain", "Дубли методов, хелперы, todo класса 3");
				Чр = Загрузить("ЧерновикРасширения");
				Чр.Инициализировать(Разбор, Настройки);
				КаталогРасш = ОбъединитьПути(П.out, "extension");
				КорниОсн = Новый Массив;
				КорниОсн.Добавить(КаталогВосст);
				КорниОсн.Добавить(Поставщик.Корень);
				Чр.ПривестиМодулиКОсновной(КаталогРасш, КорниОсн, П.extension, Лог);
				Тодо = Загрузить("TodoMissingMetadata");
				РТодо = Тодо.Сформировать(КаталогВосст, Исходная.Корень, Поставщик.Корень, П.out, "", Лог);
				Сводка.Вставить("todoMissingMetadata", РТодо);
				Доз = Загрузить("ДозаполнениеМодуля");
				Рх = Доз.ИсправитьВызовыПрефиксныхХелперов(КаталогРасш, П.prefix);
				Сводка.Вставить("helperCallsFixed", Рх);
				Лог.Добавить("extension: исправлены вызовы локальных хелперов с префиксом в файлах " + Рх.files + " (замен " + Рх.replacements + ")");
				Пер = Загрузить("ПереносОбъектовУп");
				ОТУ = Загрузить("ОбъектыТолькоУп");
				Пер.Инициализировать(Чр, ОТУ);
				Ру2 = Пер.ДополнитьОбщиеМодулиПоСсылкам(КаталогРасш, КаталогВосст, Исходная.Корень, Поставщик.Корень, Новый Соответствие, П.extension, Лог, П.out);
				Сводка.Вставить("upModulesExtensionPass2", Ру2);
				ЗавершитьШаг();
			КонецЕсли;
			Сводка.Вставить("todoManualMethods", Загрузить("TodoРучныеМетоды").Записать(Модули, ОбъединитьПути(П.out, "extension"), КаталогВосст, П.out, Лог).methods);
			ПроверитьСсылкиRestored(КаталогВосст, Лог, Сводка);
			Загрузить("ВозвратОбъектовБпВRestored").ОбновитьКэш(КаталогВосст, Поставщик.Корень, П.out);
			ЗавершитьРаботуСЛогом(П, Лог, Отчет, Старт, "log.txt", Сводка);
			Возврат;
		ИначеЕсли П.formsFromUp Тогда
			НачатьШаг("modulesForms", "Подмена не-форменных .bsl из БП; формы целиком из УП");
			Рмф = Мф.ПрименитьМодулиБпФормыИзУп(КаталогВосст, Поставщик.Корень, Исходная.Корень, Лог, П.out);
			Сводка.Вставить("engine", "modules-forms-only-forms-from-up");
		Иначе
			НачатьШаг("modulesForms", "Дословная подмена .bsl и Form.xml в restored из БП");
			Рмф = Мф.ПрименитьДословноБпКRestored(КаталогВосст, Поставщик.Корень, Исходная.Корень, Лог, П.out);
			Сводка.Вставить("engine", "modules-forms-only");
		КонецЕсли;
		Сводка.Вставить("formsFromUp", П.formsFromUp);
		Сводка.Вставить("formsKeptUp", Рмф.formsKeptUp);
		Сводка.Вставить("formPrecheck", Новый Структура("checked, incompatible, topReasons",
			Рмф.formPrecheck.checked, Рмф.formPrecheck.incompatible, Рмф.formPrecheck.topReasons));
		Сводка.Вставить("modulesForms", Новый Структура("modulesBsl, formsXml, formsKeptUp, formsUpRestored, hooks, wrappersAdded, extensionMethods",
			Рмф.modulesBsl, Рмф.formsXml, Рмф.formsKeptUp.Количество(),
			?(Рмф.Свойство("formsUpRestored"), Рмф.formsUpRestored, 0), ИтогЧ.hooks, ИтогОб.count, ИтогЧ.methods));
		Если Не П.onlyRestored И Исходная.Корень <> "" И Поставщик.Корень <> ""
			И (Новый Файл(ОбъединитьПути(КаталогВосст, "Configuration.xml"))).Существует()
			И (Новый Файл(ОбъединитьПути(П.out, "extension", "Configuration.xml"))).Существует() Тогда
			НачатьШаг("upOnlyCmFromRestored", "Общие модули только УП: из restored в extension");
			Пер = Загрузить("ПереносОбъектовУп");
			Пер.Инициализировать(Загрузить("ЧерновикРасширения"), Загрузить("ОбъектыТолькоУп"));
			Руо = Пер.УбратьОбщиеМодулиТолькоУпИзRestored(ОбъединитьПути(П.out, "extension"), КаталогВосст, Исходная.Корень, Поставщик.Корень,
				Новый Соответствие, П.extension, Лог, П.out);
			Сводка.Вставить("upOnlyCmFromRestored", Новый Структура("removed, extAdded, extHad, extReplacedAdopted, refsFiles, refsLines, xmlRefs",
				Руо.removed, Руо.extAdded, Руо.extHad, Руо.extReplacedAdopted, Руо.refsFiles, Руо.refsLines, Руо.xmlRefs));
			Рмо = Загрузить("ПереносМелкихОбъектовУп").Применить(ОбъединитьПути(П.out, "extension"), КаталогВосст, Исходная.Корень, Поставщик.Корень,
				П.extension, Лог, П.out);
			Сводка.Вставить("smallUpOnlyObjects", Новый Структура("moved, files, todoA, todoB", Рмо.moved, Рмо.files, Рмо.todoA, Рмо.todoB));
			НачатьШаг("returnBpObjects", "Возврат ОМ только БП и их цепочки объектов БП в restored");
			Рво = Загрузить("ВозвратОбъектовБпВRestored").Вернуть(КаталогВосст, Поставщик.Корень, ОбъединитьПути(П.out, "extension"), Лог, П.out);
			Сводка.Вставить("returnBpObjects", Новый Структура("count, byTag, files, configLines, extRemoved",
				Рво.order.Количество(), Рво.byTag, Рво.files, Рво.configLines, Рво.extRemoved));
		КонецЕсли;
		Если (Новый Файл(ОбъединитьПути(КаталогВосст, "Configuration.xml"))).Существует() Тогда
			ПроверитьСсылкиRestored(КаталогВосст, Лог, Сводка);
			Загрузить("ВозвратОбъектовБпВRestored").ОбновитьКэш(КаталогВосст, Поставщик.Корень, П.out);
		КонецЕсли;
		Лог.Добавить("modulesForms: итог — модулей .bsl " + Рмф.modulesBsl + ", Form.xml БП " + Рмф.formsXml
			+ ", форм УП " + ?(Рмф.Свойство("formsUpRestored"), Рмф.formsUpRestored, Рмф.formsKeptUp.Количество())
			+ "; хуков в расширении " + ИтогЧ.hooks + ", обёрток &Вместо " + ИтогОб.count);
		ЗавершитьРаботуСЛогом(П, Лог, Отчет, Старт, "log.txt", Сводка);
		Возврат;
	КонецЕсли;

	НачатьШаг("selfCheck", "Самопроверка (в т.ч. синтаксис bsparser)");
	Самопров = Загрузить("СамопроверкаВыхода");
	Самопров.Инициализировать(Разбор, Доз, Синтез);
	ПарСинт = Новый Структура("enabled, limit, cachePath", Не П.noSyntax, Число(П.syntaxLimit),
		?(П.fullCheck, "", ОбъединитьПути(П.out, "cache", "syntax.json")));
	Рсп = Самопров.ПроверитьКаталогВыхода(П.out, Модули, Сводка, Исходная.Корень, ПарСинт);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "self_check.json"), Отчет.ВJSON(Рсп));
	Лог.Добавить("Самопроверка: " + ?(Рсп.ok, "OK", "ЗАМЕЧАНИЯ") + " — " + Отчет.ВJSON(Рсп.categories));
	Лог.Добавить("Итог: " + Отчет.ВJSON(Сводка.counts));
	ЗавершитьШаг();
	ВыделитьЗамер("selfCheck", "syntax", Самопров.МсСинтаксиса());
	НачатьШаг("arity", "Проверка арности вызовов (restored + extension)");
	Арн = Загрузить("ПроверкаАрности");
	ПереносА = Загрузить("ПереносСигнатур");
	КонтрактА = Загрузить("КонтрактМетода");
	ПереносА.Инициализировать(Разбор, КонтрактА);
	Арн.Инициализировать(Разбор, КонтрактА, ПереносА);
	Рарн = Арн.Проверить(П.out, Исходная.Корень);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "arity_check.json"), Отчет.ВJSON(Рарн));
	Лог.Добавить("Арность вызовов: проверено " + Рарн.checked + ", несовпадений " + Рарн.broken
		+ " (слишком много " + Рарн.too_many + ", недостаточно " + Рарн.too_few + "; restored " + Рарн.restored
		+ ", extension " + Рарн.extension + ") — arity_check.json");
	Сводка.Вставить("arity", Новый Структура("checked, broken, too_many, too_few, restored, extension",
		Рарн.checked, Рарн.broken, Рарн.too_many, Рарн.too_few, Рарн.restored, Рарн.extension));
	ЗавершитьШаг();
	НачатьШаг("uponly", "Объекты только в УП (перенос в расширение / объекты с данными)");
	Если ИтогЧ.Свойство("uponly") Тогда
		Рту = ИтогЧ.uponly; // анализ и перенос сделаны при записи extension/restored (ЧерновикРасширения)
	Иначе
		Рту = Загрузить("ОбъектыТолькоУп").Проверить(Исходная.Корень, Поставщик.Корень, П.out, Лог, ОбъединитьПути(П.out, "restored"));
	КонецЕсли;
	Сводка.Вставить("uponly", Рту);
	ЗавершитьШаг();
	НачатьШаг("bpModules", "Общие модули только БП, на которые ссылается код restored (возврат в основную)");
	КаталогВосстБп = ОбъединитьПути(П.out, "restored");
	ЗагКаркас = Загрузить("ЗаготовкиОбъектовБп");
	ЗагКаркас.ОбеспечитьКаркасRestored(КаталогВосстБп, Исходная.Корень, Лог);
	Если Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосстБп, "Configuration.xml"))).Существует() Тогда
		ВозвратБп = Загрузить("ВозвратОбщихМодулейБп");
		РвБп = ВозвратБп.Анализ(КаталогВосстБп, Поставщик.Корень);
		ДобБп = ВозвратБп.Вернуть(РвБп.clean, Поставщик.Корень, КаталогВосстБп);
		БлокБп = Новый Массив;
		Для Каждого КЗ Из РвБп.blocked Цикл
			БлокБп.Добавить(КЗ.Ключ + " ← " + КЗ.Значение);
		КонецЦикла;
		Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "bp_modules.json"), Отчет.ВJSON(Новый Структура("returned, blocked, closure, missingObjects",
			РвБп.clean, БлокБп, РвБп.modules.Количество(), РвБп.objects)));
		Лог.Добавить("Общие модули БП: возвращено в restored " + РвБп.clean.Количество() + " (в Configuration.xml добавлено " + ДобБп
			+ "); не возвращено (тянут объекты, которых нет в основной) " + РвБп.blocked.Количество() + ", замыкание " + РвБп.modules.Количество()
			+ ", отсутствующих объектов " + РвБп.objects.Количество() + " — bp_modules.json");
		Сводка.Вставить("bpModules", Новый Структура("returned, blocked, missingObjects", РвБп.clean.Количество(), РвБп.blocked.Количество(), РвБп.objects.Количество()));
		// заглушки для модулей, которые нельзя вернуть как есть (код restored БП остаётся без изменений)
		ЗаглБп = Загрузить("ЗаглушкиОбщихМодулейБп");
		ЗаглБп.Инициализировать(ВозвратБп);
		ИменаЗаглБп = Новый Массив;
		Для Каждого КЗ Из РвБп.blocked Цикл
			ИменаЗаглБп.Добавить(КЗ.Ключ);
		КонецЦикла;
		КатТекстовБп = Новый Массив;
		КатТекстовБп.Добавить(КаталогВосстБп);
		КатТекстовБп.Добавить(ОбъединитьПути(П.out, "extension"));
		РзБп = ЗаглБп.Создать(ИменаЗаглБп, Поставщик.Корень, КаталогВосстБп, КатТекстовБп);
		СсБп = ЗаглБп.СсылкиНаОтсутствующиеОбъекты(КаталогВосстБп, КаталогВосстБп);
		Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "stubs.json"), Отчет.ВJSON(Новый Структура("modules, methods, notExported, missingObjectRefs",
			РзБп.modules, РзБп.methods, РзБп.notExported, СсБп)));
		Лог.Добавить("Заглушки общих модулей БП: модулей " + РзБп.modules.Количество() + ", методов " + РзБп.methods
			+ "; прямые ссылки restored на отсутствующие объекты: модулей " + СсБп.modules + ", строк " + СсБп.lines
			+ ", объектов " + СсБп.objects.Количество() + " — stubs.json");
		Сводка.Вставить("bpStubs", Новый Структура("modules, methods, refModules, refLines", РзБп.modules.Количество(), РзБп.methods, СсБп.modules, СсБп.lines));
	КонецЕсли;
	ЗавершитьШаг();
	Если Поставщик.Корень <> "" И (Новый Файл(ОбъединитьПути(КаталогВосстБп, "Configuration.xml"))).Существует() Тогда
		НачатьШаг("restoredStubs", "Заготовки и фрагменты БП в restored (скан + догрузка по логу import)");
		ПутьДогрузки = "";
		КолПутейИмп = 0;
		Если П.importLog <> "" И (Новый Файл(П.importLog)).Существует() Тогда
			РазборИмп = Загрузить("РазборЛогаИмпорта");
			ПутиИмп = РазборИмп.ПутиНеизвестныхМетаданных(П.importLog);
			КолПутейИмп = ПутиИмп.Количество();
			ПутьДогрузки = ОбъединитьПути(П.out, "import_dogruzka_build.txt");
			РазборИмп.ЗаписатьСписокДогрузки(ПутиИмп, ПутьДогрузки);
			Лог.Добавить("import log: путей для догрузки " + КолПутейИмп + " — " + П.importLog);
		КонецЕсли;
		РзЗаг = ЗагКаркас.ДополнитьЗаготовки(КаталогВосстБп, Поставщик.Корень, Лог, Исходная.Корень, ПутьДогрузки);
		РДоп = Новый Структура("files, meta, fragments, commands, metaCmd", 0, 0, 0, 0, 0);
		ФормБп = 0;
		Если П.importLog <> "" И (Новый Файл(П.importLog)).Существует() Тогда
			Доп = Загрузить("ДополненияПоЛогуImport");
			РДоп = Доп.Применить(КаталогВосстБп, Поставщик.Корень, П.importLog, Лог, Ложь);
		КонецЕсли;
		ЗагКаркас.Инициализировать();
		ФормБп = ЗагКаркас.ВернутьFormXmlИзБп(КаталогВосстБп, Поставщик.Корень);
		ДопКр = Загрузить("ДополненияПоЛогуImport");
		ДопКр.КопироватьCommonPictureПоЛогу("", КаталогВосстБп, Поставщик.Корень, Лог);
		Лог.Добавить("restored: Form.xml дословно из БП, файлов " + ФормБп);
		Сводка.Вставить("restoredStubs", Новый Структура("stubs, fragments, requirements, importPaths, logExtras, formsLiteral",
			РзЗаг.stubs, РзЗаг.fragments, РзЗаг.requirements, КолПутейИмп, РДоп, ФормБп));
		Лог.Добавить("restored: заготовок " + РзЗаг.stubs + ", фрагментов ChildObjects " + РзЗаг.fragments + ", требований " + РзЗаг.requirements);
		ЗавершитьШаг();
	КонецЕсли;
	Если П.checkLog <> "" И Поставщик.Корень <> "" Тогда
		НачатьШаг("stubbedMethods", "Заглушки методов БП по логу проверки основной (объекты/реквизиты нет в УП)");
		Рзм = ЗаглушитьМетодыБпПоЛогу(П, Поставщик.Корень, Лог);
		Сводка.Вставить("stubbedMethods", Рзм);
		ЗавершитьШаг();
	КонецЕсли;
	НачатьШаг("formsCheck", "Формы: модули restored (БП) против Form.xml restored (БП)");
	Рф = Загрузить("ПроверкаФорм").Проверить(П.out, Исходная.Корень, Разбор);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "forms_check.json"), Отчет.ВJSON(Рф));
	Лог.Добавить("Формы: модулей форм в restored " + Рф.formModules + ", заимствовано в расширение " + Рф.adoptedForms
		+ ", с обработчиками Form.xml, которых нет в модуле БП, " + Рф.withMissingHandlers + " (ручной разбор) — forms_check.json");
	Сводка.Вставить("formsCheck", Новый Структура("formModules, adoptedForms, withMissingHandlers",
		Рф.formModules, Рф.adoptedForms, Рф.withMissingHandlers));
	ЗавершитьШаг();
	НачатьШаг("dynlistCheck", "Динамические списки: поля DataPath есть в запросе/основной таблице (restored, extension)");
	ДСп = Загрузить("ЗапросыДинСписков");
	Рдр = ДСп.ПроверитьКаталог(ОбъединитьПути(П.out, "restored"), Исходная.Корень, Исходная.Корень);
	Рдх = ДСп.ПроверитьКаталог(ОбъединитьПути(П.out, "extension"), Исходная.Корень, Исходная.Корень);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "dynlist_check.json"), Отчет.ВJSON(Новый Структура("restored, extension", Рдр, Рдх)));
	Лог.Добавить("Динамические списки: форм restored " + Рдр.forms + ", списков " + Рдр.lists + ", с неверными путями к данным/запросом вне метаданных УП " + Рдр.bad
		+ "; extension " + Рдх.forms + "/" + Рдх.lists + ", неверных " + Рдх.bad + " — dynlist_check.json");
	Для Каждого Э Из Рдр.items Цикл
		Лог.Добавить("  ОШИБКА dynlist restored: " + Э.form + " / " + Э.list + ": поля " + СтрСоединить(Э.missingFields, ", ") + "; запрос " + СтрСоединить(Э.queryProblems, ", "));
	КонецЦикла;
	Сводка.Вставить("dynlistCheck", Новый Структура("forms, lists, bad, extensionForms, extensionLists, extensionBad",
		Рдр.forms, Рдр.lists, Рдр.bad, Рдх.forms, Рдх.lists, Рдх.bad));
	ЗавершитьШаг();
	НачатьШаг("extFormsCheck", "Формы и общие модули расширения: стандартные команды, свойства-ссылки, флаги контекста модулей, поля динсписков собственных форм");
	ЧрП = Загрузить("ЧерновикРасширения");
	ЗпП = Загрузить("ЗаимствованиеПолейСписков");
	ЗпП.УстановитьЧерновик(ЧрП);
	КаталогРасшП = ОбъединитьПути(П.out, "extension");
	КомандыП = ЧрП.НевалидныеКомандыЗаимствованных(КаталогРасшП, Исходная.Корень);
	Для Каждого С Из ЧрП.НесовпаденияСвойствОбщихМодулей(КаталогРасшП, Исходная.Корень) Цикл
		КомандыП.Добавить(С);
	КонецЦикла;
	ПоляП = ЗпП.Применить(КаталогРасшП, Исходная.Корень, "", Ложь);
	ФрСтд = Загрузить("ФормыRestored");
	РСтд = ФрСтд.ОчиститьСтандартныеКомандыВКаталоге(КаталогРасшП, Лог);
	Сводка.Вставить("stdCommandsRemoved", РСтд.forms);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "ext_forms_check.json"), Отчет.ВJSON(Новый Структура("badCommands, ownForms, missing, notes, stdCommandsRemoved",
		КомандыП, ПоляП.forms, ПоляП.missing, ПоляП.notes, РСтд.forms)));
	Лог.Добавить("Формы расширения: очищено от недопустимых стандартных команд " + РСтд.forms);
	Лог.Добавить("Формы расширения: невалидных стандартных команд " + КомандыП.Количество() + ", собственных форм с динсписками " + ПоляП.forms.Количество()
		+ ", незаимствованных полей/объектов " + ПоляП.missing.Количество() + " — ext_forms_check.json");
	Для Каждого С Из КомандыП Цикл
		Лог.Добавить("  ОШИБКА команда формы расширения: " + С);
	КонецЦикла;
	Для Каждого С Из ПоляП.missing Цикл
		Лог.Добавить("  ОШИБКА не заимствовано для динсписка: " + С);
	КонецЦикла;
	Сводка.Вставить("extFormsCheck", Новый Структура("badCommands, ownDynlistForms, missing, notes",
		КомандыП.Количество(), ПоляП.forms.Количество(), ПоляП.missing.Количество(), ПоляП.notes.Количество()));
	ЗавершитьШаг();
	Если П.parser = "bsparser" Тогда
		НачатьШаг("astCheck", "bsparser: контроль хуков &ИзменениеИКонтроль");
		Аст.УстановитьКэш(?(П.fullCheck, "", ОбъединитьПути(П.out, "cache", "ast.json")));
		Рх = Аст.ПроверитьХукиКаталога(ОбъединитьПути(П.out, "extension"));
		Аст.УстановитьКэш("");
		Лог.Добавить("bsparser: хуков ИиК из кэша " + Рх.cached + " (полная проверка — --полная-проверка)");
		Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "ast_check.json"), Отчет.ВJSON(Рх));
		Лог.Добавить("bsparser: хуков ИиК проверено " + Рх.checked + ", на ручной разбор " + Рх.failed + " (ast_check.json)");
		Сводка.Вставить("bsparser", Новый Структура("astCheck, fallbacks", Рх, Стат.fallbacks));
		Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
		ЗавершитьШаг();
	КонецЕсли;
	НачатьШаг("reverseBuild", "Обратная сборка: extension + restored против УП");
	Обр = Загрузить("ОбратнаяСборка");
	Обр.Инициализировать(Разбор);
	Робр = Обр.Проверить(П.out, Исходная.Корень, Поставщик.Корень, П.prefix);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "reverse_build.json"), Отчет.ВJSON(Робр));
	Обр.ДобавитьВЛог(Робр, Лог);
	Сводка.Вставить("reverseBuild", Робр.summary);
	Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "summary.json"), Отчет.ВJSON(Сводка));
	Если Не П.noReport Тогда
		// Отчёт пишется один раз по итоговой сводке (с reverseBuild) — как при --только-отчет.
		Отчет.ЗаписатьHtml(Модули, Сводка, П.out, Каталог);
		Обр.ВставитьВHtml(Робр, ОбъединитьПути(П.out, "razbor_moduley.html"));
	КонецЕсли;
	ЗавершитьШаг();
	Если П.skeleton <> "" Тогда
		НачатьШаг("skeleton", "Проверка скелета");
		Ск = Загрузить("ПроверкаСкелетаРасширения");
		Рск = Ск.ПроверитьКаталогСкелета(П.skeleton);
		Ск.ЗаписатьОтчетВалидации(Рск, П.out);
		Лог.Добавить("Скелет (validator-only): " + ?(Рск.ОК, "OK", "ОТКАЗ") + " — " + Рск.Причина);
	КонецЕсли;
	Если П.ibcmdLoad Тогда
		НачатьШаг("ibcmd", "ibcmd");
		Иб = Загрузить("IbcmdРасширения");
		Пи = Новый Структура("ibcmdPath, dbPath, dbms, dbServer, dbName, dataPath, user, password",
			П.ibcmdPath, П.ibcmdDb, П.ibcmdDbms, П.ibcmdServer, П.ibcmdDbName, П.ibcmdData, П.ibcmdUser, П.ibcmdPassword);
		Кч = ОбъединитьПути(П.out, "extension");
		Ри = Иб.ВыполнитьЗагрузку(Пи, П.extension, Кч, Лог, П.ibcmdPlan);
		Если Не Ри.ok Тогда
			Лог.Добавить("ibcmd ОТКАЗ: " + Ри.message);
			ЗавершитьРаботу(3);
		КонецЕсли;
		Если Ри.plan <> Неопределено Тогда
			Отчет.ЗаписатьФайл(ОбъединитьПути(П.out, "ibcmd_load_plan.json"), Отчет.ВJSON(Иб.ПланДляJson(Ри.plan)));
			Лог.Добавить("ibcmd: план записан в ibcmd_load_plan.json");
		КонецЕсли;
	КонецЕсли;
	ЗавершитьРаботуСЛогом(П, Лог, Отчет, Старт, "log.txt", Сводка);

КонецПроцедуры

// Перед ibcmd import: ссылки restored на отсутствующие объекты (restored_missing_refs.txt в каталоге выхода).
Процедура ПроверитьСсылкиRestored(КаталогВосст, Лог, Сводка)
	НачатьШаг("restoredRefsCheck", "Проверка ссылок restored на отсутствующие объекты (до загрузки)");
	Рпс = Загрузить("ПроверкаСсылокRestored").Проверить(КаталогВосст, Лог, (Новый Файл(КаталогВосст)).Путь);
	Сводка.Вставить("restoredMissingRefs", Рпс.missing.Количество());
	Если Рпс.missing.Количество() > 0 Тогда
		Сообщить("ПРЕДУПРЕЖДЕНИЕ: в restored ссылки на отсутствующие объекты: " + Рпс.missing.Количество() + " (restored_missing_refs.txt) — ibcmd import упадёт");
	КонецЕсли;
	ЗавершитьШаг();
КонецПроцедуры

Функция ОмИзВозврата(Рво)
	Р = Новый Соответствие;
	Для Каждого Ключ Из Рво.order Цикл
		Если СтрНачинаетсяС(Ключ, "CommonModule.") Тогда
			Имя = Сред(Ключ, 14);
			Р.Вставить(НРег(Имя), Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Р;
КонецФункции

Каталог = ТекущийСценарий().Каталог;
// Не выполнять CLI при ЗагрузитьСценарий/Подключить (m4_full иначе дублирует весь прогон v1).
Если АргументыКоманднойСтроки.Количество() > 0
	И НРег((Новый Файл(ТекущийСценарий().Источник)).Имя) = "главный.os" Тогда
	Выполнить_(АргументыКоманднойСтроки);
КонецЕсли;
