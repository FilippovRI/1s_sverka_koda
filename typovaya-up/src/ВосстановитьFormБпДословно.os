// Form.xml в restored — дословно из D:\выгрузка БП (без постобработки смысла).
// oscript ВосстановитьFormБпДословно.os [restored] [корень БП]
КореньСк = ТекущийСценарий().Каталог;
Корень = "D:\typovaya-up-out-20261118u\restored";
КореньБп = "D:\выгрузка БП";
Если АргументыКоманднойСтроки.Количество() > 0 Тогда
	Корень = АргументыКоманднойСтроки[0];
КонецЕсли;
Если АргументыКоманднойСтроки.Количество() > 1 Тогда
	КореньБп = АргументыКоманднойСтроки[1];
КонецЕсли;
Заг = ЗагрузитьСценарий(ОбъединитьПути(КореньСк, "ЗаготовкиОбъектовБп.os"));
Заг.Инициализировать();
Зам = Заг.ВернутьFormXmlИзБп(Корень, КореньБп);
Сообщить("form literal from BP: " + Зам);