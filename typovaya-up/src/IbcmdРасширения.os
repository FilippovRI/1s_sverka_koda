// ibcmd 8.5+: список расширений и выбор create vs update (без удаления).
// Команды: см. руководство администратора 8.5, §4.10.4.7.12 (extension list/create)
// и §4.10.4.7.9 (config import --extension).

Функция РазобратьСписокРасширений(ТекстВывода) Экспорт
	Имена = Новый Массив;
	Если СокрЛП(ТекстВывода) = "" Тогда
		Возврат Имена;
	КонецЕсли;
	НетРасширений = Ложь;
	Для Каждого Стр Из СтрРазделить(ТекстВывода, Символы.ПС, Истина) Цикл
		С = СокрЛП(Стр);
		Если С = "" Тогда
			Продолжить;
		КонецЕсли;
		Нс = НРег(С);
		Если Нс = "установленных расширений нет" Или Нс = "no configuration extensions" Тогда
			НетРасширений = Истина;
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Нс, "extension") Или СтрНачинаетсяС(Нс, "расширен") Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНайти(С, "|") > 0 Тогда
			С = СокрЛП(СтрРазделить(С, "|")[0]);
		ИначеЕсли СтрНайти(С, Символы.Таб) > 0 Тогда
			С = СокрЛП(СтрРазделить(С, Символы.Таб)[0]);
		КонецЕсли;
		Если Лев(С, 1) = "-" Или СтрНачинаетсяС(НРег(С), "name") Тогда
			Продолжить;
		КонецЕсли;
		Имена.Добавить(С);
	КонецЦикла;
	Если НетРасширений И Имена.Количество() = 0 Тогда
		Возврат Имена;
	КонецЕсли;
	Возврат Имена;
КонецФункции

Функция РешитьСтратегиюЗагрузки(ЦелевоеИмя, ИменаВБазе) Экспорт
	Рез = Новый Структура("mode, extensionName, message, similar",
		"", "", "", Новый Массив);
	Если СокрЛП(ЦелевоеИмя) = "" Тогда
		Рез.mode = "abort";
		Рез.message = "Не задано имя расширения.";
		Возврат Рез;
	КонецЕсли;
	Точное = 0;
	Для Каждого Имя Из ИменаВБазе Цикл
		Если Имя = ЦелевоеИмя Тогда
			Точное = Точное + 1;
		КонецЕсли;
	КонецЦикла;
	Если Точное = 1 Тогда
		Рез.mode = "update";
		Рез.extensionName = ЦелевоеИмя;
		Рез.message = "Расширение """ + ЦелевоеИмя + """ уже в базе — будет обновление (import), не create.";
		Возврат Рез;
	КонецЕсли;
	Если Точное > 1 Тогда
		Рез.mode = "abort";
		Рез.message = "В базе несколько расширений с именем """ + ЦелевоеИмя + """ — остановка.";
		Возврат Рез;
	КонецЕсли;
	Похожие = Новый Массив;
	Для Каждого Имя Из ИменаВБазе Цикл
		Если Имя = ЦелевоеИмя Тогда
			Продолжить;
		КонецЕсли;
		Если СтрНачинаетсяС(Имя, ЦелевоеИмя) Тогда
			Похожие.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Если Похожие.Количество() > 0 Тогда
		Рез.mode = "abort";
		Рез.similar = Похожие;
		Рез.message = "Найдены похожие расширения (" + СтрСоединить(Похожие, ", ")
			+ "), а """ + ЦелевоеИмя + """ нет — выберите имя вручную, автоудаление не выполняется.";
		Возврат Рез;
	КонецЕсли;
	Рез.mode = "create";
	Рез.extensionName = ЦелевоеИмя;
	Рез.message = "Расширение """ + ЦелевоеИмя + """ не найдено — сначала create, затем import.";
	Возврат Рез;
КонецФункции

Функция ДобавитьПараметрыПодключения(Команда, П)
	Команда.Добавить("infobase");
	Если П.dbPath <> "" Тогда
		Команда.Добавить("--db-path=" + П.dbPath);
	КонецЕсли;
	Если П.dbms <> "" Тогда
		Команда.Добавить("--dbms=" + П.dbms);
	КонецЕсли;
	Если П.dbServer <> "" Тогда
		Команда.Добавить("--db-server=" + П.dbServer);
	КонецЕсли;
	Если П.dbName <> "" Тогда
		Команда.Добавить("--db-name=" + П.dbName);
	КонецЕсли;
	Если П.dataPath <> "" Тогда
		Команда.Добавить("--data=" + П.dataPath);
	КонецЕсли;
	Если П.user <> "" Тогда
		Команда.Добавить("--user=" + П.user);
	КонецЕсли;
	Если П.password <> "" Тогда
		Команда.Добавить("--password=" + П.password);
	КонецЕсли;
КонецФункции

// Шаги ibcmd (токены argv после ibcmd.exe).
Функция КомандаСписокРасширений(П) Экспорт
	К = Новый Массив;
	ДобавитьПараметрыПодключения(К, П);
	К.Добавить("config");
	К.Добавить("extension");
	К.Добавить("list");
	Возврат К;
КонецФункции

Функция КомандаСоздатьРасширение(П, ИмяРасширения) Экспорт
	К = Новый Массив;
	ДобавитьПараметрыПодключения(К, П);
	К.Добавить("config");
	К.Добавить("extension");
	К.Добавить("create");
	К.Добавить(ИмяРасширения);
	К.Добавить("--purpose=customization");
	Возврат К;
КонецФункции

Функция КомандаИмпортКаталога(П, ИмяРасширения, КаталогXml) Экспорт
	К = Новый Массив;
	ДобавитьПараметрыПодключения(К, П);
	К.Добавить("config");
	К.Добавить("import");
	К.Добавить("--extension=" + ИмяРасширения);
	К.Добавить(КаталогXml);
	Возврат К;
КонецФункции

Функция КомандаПроверить(П, ИмяРасширения) Экспорт
	К = Новый Массив;
	ДобавитьПараметрыПодключения(К, П);
	К.Добавить("config");
	К.Добавить("check");
	К.Добавить("--extension=" + ИмяРасширения);
	К.Добавить("--force");
	Возврат К;
КонецФункции

Функция КомандаПрименить(П, ИмяРасширения) Экспорт
	К = Новый Массив;
	ДобавитьПараметрыПодключения(К, П);
	К.Добавить("config");
	К.Добавить("apply");
	К.Добавить("--extension=" + ИмяРасширения);
	К.Добавить("--force");
	Возврат К;
КонецФункции

Функция ПостроитьПланЗагрузки(П, Стратегия, КаталогЧерновика) Экспорт
	Имя = Стратегия.extensionName;
	Шаги = Новый Массив;
	Шаги.Добавить(Новый Структура("step, argv", "extension list", КомандаСписокРасширений(П)));
	Если Стратегия.mode = "create" Тогда
		Шаги.Добавить(Новый Структура("step, argv", "extension create", КомандаСоздатьРасширение(П, Имя)));
	КонецЕсли;
	Шаги.Добавить(Новый Структура("step, argv", "config import", КомандаИмпортКаталога(П, Имя, КаталогЧерновика)));
	Шаги.Добавить(Новый Структура("step, argv", "config check", КомандаПроверить(П, Имя)));
	Шаги.Добавить(Новый Структура("step, argv", "config apply", КомандаПрименить(П, Имя)));
	Возврат Новый Структура("mode, extensionName, steps", Стратегия.mode, Имя, Шаги);
КонецФункции

// Файловая ИБ: *.cfl рядом с 1Cv8.1CD — признак открытого Конфигуратора/сеанса (не гасим чужие процессы).
Функция ПризнакиБлокировкиФайловойБазы(КаталогБазы) Экспорт
	Рез = Новый Структура("busy, message, lockFiles", Ложь, "", Новый Массив);
	Кат = СокрЛП(КаталогБазы);
	Если Кат = "" Тогда
		Возврат Рез;
	КонецЕсли;
	ФКат = Новый Файл(Кат);
	Если Не ФКат.Существует() Тогда
		Рез.busy = Истина;
		Рез.message = "Каталог файловой базы не найден: " + Кат + ". Загрузка не выполняется.";
		Возврат Рез;
	КонецЕсли;
	Для Каждого Ф Из НайтиФайлы(Кат, "*.cfl", Ложь) Цикл
		Рез.lockFiles.Добавить(Ф.Имя);
	КонецЦикла;
	П1 = ОбъединитьПути(Кат, "1Cv8.1CD.cfl");
	Если (Новый Файл(П1)).Существует() И Не СодержитСтроку(Рез.lockFiles, "1Cv8.1CD.cfl") Тогда
		Рез.lockFiles.Добавить("1Cv8.1CD.cfl");
	КонецЕсли;
	П2 = ОбъединитьПути(Кат, "1Cv8.cfl");
	Если (Новый Файл(П2)).Существует() И Не СодержитСтроку(Рез.lockFiles, "1Cv8.cfl") Тогда
		Рез.lockFiles.Добавить("1Cv8.cfl");
	КонецЕсли;
	Если Рез.lockFiles.Количество() > 0 Тогда
		Рез.busy = Истина;
		Рез.message = "Файловая база занята (файлы блокировки: " + СтрСоединить(Рез.lockFiles, ", ")
			+ "). Закройте Конфигуратор и сеансы 1С. Сеансы не завершаются автоматически; import/apply не выполняются.";
	КонецЕсли;
	Возврат Рез;
КонецФункции

Функция СодержитСтроку(М, Значение)
	Для Каждого Э Из М Цикл
		Если Э = Значение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Распознавание ошибки занятости/блокировки по stdout/stderr ibcmd (без выдуманных команд).
Функция ВыводIbcmdУказываетБазуЗанята(ТекстВывода) Экспорт
	Рез = Новый Структура("busy, message", Ложь, "");
	Если СокрЛП(ТекстВывода) = "" Тогда
		Возврат Рез;
	КонецЕсли;
	Н = НРег(ТекстВывода);
	Шаблоны = Новый Массив;
	Шаблоны.Добавить("база данных заблокирован");
	Шаблоны.Добавить("база данных занят");
	Шаблоны.Добавить("база занят");
	Шаблоны.Добавить("information base is locked");
	Шаблоны.Добавить("database is locked");
	Шаблоны.Добавить("cannot obtain lock");
	Шаблоны.Добавить("failed to lock");
	Шаблоны.Добавить("файл заблокирован");
	Шаблоны.Добавить("file is locked");
	Шаблоны.Добавить("1cv8.1cd");
	Шаблоны.Добавить("конфигуратор");
	Шаблоны.Добавить("designer");
	Шаблоны.Добавить("exclusive lock");
	Шаблоны.Добавить("database file is locked");
	Для Каждого Ш Из Шаблоны Цикл
		Если СтрНайти(Н, Ш) > 0 Тогда
			Рез.busy = Истина;
			Рез.message = "Информационная база занята (сеансы или Конфигуратор). ibcmd не загружает расширение; чужие сеансы не завершаются.";
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ПроверитьБазаСвободнаПередЗагрузкой(П) Экспорт
	Если СокрЛП(П.dbPath) <> "" Тогда
		Возврат ПризнакиБлокировкиФайловойБазы(П.dbPath);
	КонецЕсли;
	Возврат Новый Структура("busy, message, lockFiles", Ложь, "", Новый Массив);
КонецФункции

Функция ОтказЗанятость(Сообщение, Лог)
	Если Лог <> Неопределено Тогда
		Лог.Добавить(Сообщение);
	КонецЕсли;
	Возврат Новый Структура("ok, message, busy", Ложь, Сообщение, Истина);
КонецФункции

Функция ArgvВСтроку(Argv)
	Части = Новый Массив;
	Для Каждого А Из Argv Цикл
		Если СтрНайти(А, " ") > 0 Тогда
			Части.Добавить("""" + А + """");
		Иначе
			Части.Добавить(А);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, " ");
КонецФункции

Функция СпланироватьЗагрузку(П, ЦелевоеИмя, КаталогЧерновика, ТекстСпискаРасширений) Экспорт
	Имена = РазобратьСписокРасширений(ТекстСпискаРасширений);
	Стр = РешитьСтратегиюЗагрузки(ЦелевоеИмя, Имена);
	Если Стр.mode = "abort" Тогда
		Возврат Новый Структура("ok, strategy, plan, message", Ложь, Стр, Неопределено, Стр.message);
	КонецЕсли;
	План = ПостроитьПланЗагрузки(П, Стр, КаталогЧерновика);
	Возврат Новый Структура("ok, strategy, plan, message, extensionNames", Истина, Стр, План, Стр.message, Имена);
КонецФункции

Функция ЗапуститьIbcmd(ПутьIbcmd, Argv, КаталогВремени, ПоУмолчаниюВывод = "")
	ИмяBat = ОбъединитьПути(КаталогВремени, "ibcmd_run.cmd");
	СтрокаКоманды = """" + ПутьIbcmd + """ " + ArgvВСтроку(Argv);
	З = Новый ЗаписьТекста(ИмяBat, "UTF-8");
	З.ЗаписатьСтроку("@echo off");
	З.ЗаписатьСтроку(СтрокаКоманды + " > """ + ОбъединитьПути(КаталогВремени, "ibcmd_out.txt") + """ 2>&1");
	З.ЗаписатьСтроку("exit /b %ERRORLEVEL%");
	З.Закрыть();
	Код = 0;
	ЗапуститьПриложение(ИмяBat, КаталогВремени, Истина, Код);
	ФВывода = ОбъединитьПути(КаталогВремени, "ibcmd_out.txt");
	Если (Новый Файл(ФВывода)).Существует() Тогда
		Т = Новый ТекстовыйДокумент;
		Т.Прочитать(ФВывода);
		Возврат Новый Структура("exitCode, output", Код, Т.ПолучитьТекст());
	КонецЕсли;
	Возврат Новый Структура("exitCode, output", Код, ПоУмолчаниюВывод);
КонецФункции

Функция ПланДляJson(План)
	Строки = Новый Массив;
	Для Каждого Ш Из План.steps Цикл
		Строки.Добавить(Новый Структура("step, command", Ш.step, ArgvВСтроку(Ш.argv)));
	КонецЦикла;
	Возврат Новый Структура("mode, extensionName, steps", План.mode, План.extensionName, Строки);
КонецФункции

Функция ВыполнитьЗагрузку(П, ЦелевоеИмя, КаталогЧерновика, Лог, ТолькоПлан = Ложь) Экспорт
	Если П.dbPath = "" И (П.dbServer = "" Или П.dbName = "") Тогда
		Возврат Новый Структура("ok, message", Ложь, "Для ibcmd укажите --ibcmd-база (файловая) или --ibcmd-сервер и --ibcmd-имя-бд.");
	КонецЕсли;
	ПровБлок = ПроверитьБазаСвободнаПередЗагрузкой(П);
	Если ПровБлок.busy Тогда
		Возврат ОтказЗанятость(ПровБлок.message, Лог);
	КонецЕсли;
	ПутьIbcmd = ?(П.ibcmdPath = "", "ibcmd", П.ibcmdPath);
	Врем = ОбъединитьПути(КаталогЧерновика, "..", "_ibcmd_work");
	СоздатьКаталог(Врем);
	Список = ЗапуститьIbcmd(ПутьIbcmd, КомандаСписокРасширений(П), Врем);
	Если Список.exitCode <> 0 Тогда
		Зан = ВыводIbcmdУказываетБазуЗанята(Список.output);
		Если Зан.busy Тогда
			Лог.Добавить("ibcmd extension list: база занята.");
			Лог.Добавить(Список.output);
			Возврат ОтказЗанятость(Зан.message, Лог);
		КонецЕсли;
		Лог.Добавить("ibcmd extension list завершился с кодом " + Список.exitCode);
		Лог.Добавить(Список.output);
		Возврат Новый Структура("ok, message, busy", Ложь, "Не удалось получить список расширений (ibcmd infobase config extension list).", Ложь);
	КонецЕсли;
	Сплан = СпланироватьЗагрузку(П, ЦелевоеИмя, КаталогЧерновика, Список.output);
	Лог.Добавить("ibcmd: " + Сплан.message);
	Если Не Сплан.ok Тогда
		Возврат Новый Структура("ok, message, strategy", Ложь, Сплан.message, Сплан.strategy);
	КонецЕсли;
	Если ТолькоПлан Тогда
		Лог.Добавить("ibcmd: режим только план, команды не запускаются.");
		Возврат Новый Структура("ok, message, plan", Истина, Сплан.message, Сплан.plan);
	КонецЕсли;
	Для Каждого Ш Из Сплан.plan.steps Цикл
		Если Ш.step = "extension list" Тогда
			Продолжить;
		КонецЕсли;
		Р = ЗапуститьIbcmd(ПутьIbcmd, Ш.argv, Врем);
		Лог.Добавить("ibcmd " + Ш.step + " → код " + Р.exitCode);
		Если Р.exitCode <> 0 Тогда
			Зан = ВыводIbcmdУказываетБазуЗанята(Р.output);
			Если Зан.busy Тогда
				Лог.Добавить(Р.output);
				Возврат ОтказЗанятость(Зан.message + " (шаг """ + Ш.step + """).", Лог);
			КонецЕсли;
			Лог.Добавить(Р.output);
			Возврат Новый Структура("ok, message, plan, busy", Ложь, "Ошибка на шаге """ + Ш.step + """.", Сплан.plan, Ложь);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("ok, message, plan", Истина, "Загрузка расширения завершена.", Сплан.plan);
КонецФункции
