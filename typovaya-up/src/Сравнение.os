// Сравнение модулей двух выгрузок и раскладка по корзинам.
// Корзины: identical, cosmetic, auto, manual, only_source, only_vendor.

Перем Разбор;
Перем Выгрузка;
Перем Настройки;
Перем Синтез;

Процедура Инициализировать(МодульРазбора, МодульВыгрузки, МодульНастроек, МодульСинтеза) Экспорт
	Разбор = МодульРазбора;
	Выгрузка = МодульВыгрузки;
	Настройки = МодульНастроек;
	Синтез = МодульСинтеза;
КонецПроцедуры

// Периметр: Соответствие путей из настроек или Неопределено. Возвращает Массив описаний модулей.
Функция СравнитьВыгрузки(Исходная, Поставщик, Периметр, Лог) Экспорт

	ВсеПути = Новый Соответствие;
	Для Каждого КЗ Из Исходная.Модули Цикл
		ВсеПути.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;
	Для Каждого КЗ Из Поставщик.Модули Цикл
		ВсеПути.Вставить(КЗ.Ключ, Истина);
	КонецЦикла;

	Отбор = Неопределено;
	Если Периметр <> Неопределено Тогда
		Пересечение = 0;
		Для Каждого КЗ Из Периметр Цикл
			Если ВсеПути.Получить(КЗ.Ключ) <> Неопределено Тогда
				Пересечение = Пересечение + 1;
			КонецЕсли;
		КонецЦикла;
		Если Пересечение = 0 Тогда
			Лог.Добавить("ПРЕДУПРЕЖДЕНИЕ: ни один модуль из настроек не найден в выгрузках — сравниваю все общие .bsl.");
		Иначе
			Отбор = Периметр;
			Лог.Добавить("Модулей в периметре настроек: " + Периметр.Количество() + ", найдено в выгрузках: " + Пересечение);
		КонецЕсли;
	КонецЕсли;

	Пути = Новый Массив;
	Для Каждого КЗ Из ВсеПути Цикл
		Пути.Добавить(КЗ.Ключ);
	КонецЦикла;
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(Пути);
	Список.СортироватьПоЗначению();

	Результат = Новый Массив;
	Для Каждого Элемент Из Список Цикл
		Путь = Элемент.Значение;
		ПутьИсх = Исходная.Модули.Получить(Путь);
		ПутьПост = Поставщик.Модули.Получить(Путь);
		Если Отбор <> Неопределено Тогда
			Если Отбор.Получить(Путь) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		ИначеЕсли Периметр <> Неопределено И (ПутьИсх = Неопределено ИЛИ ПутьПост = Неопределено) Тогда
			Продолжить; // запасной режим: только общие модули
		КонецЕсли;
		Результат.Добавить(СравнитьМодуль(Путь, ПутьИсх, ПутьПост));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция СравнитьМодуль(Путь, ПутьИсх, ПутьПост) Экспорт

	Части = СтрРазделить(Путь, "\");
	Тип = Настройки.ТипПоКаталогу(Части[0]);
	Объект = ?(Части.Количество() > 2 И Части[0] <> "Ext", Тип + "." + Части[1], "Configuration");
	М = Новый Структура("path, type, object, bucket, reason, vendorText, sourceText, outsideDiffers, methods, counts",
		Путь, Тип, Объект, "", "", "", "", Ложь, Новый Массив, Новый Структура("same, changed, added, removed", 0, 0, 0, 0));

	Если ПутьПост = Неопределено Тогда
		М.bucket = "only_source";
		М.reason = "Модуль есть только в исходной конфигурации (доработка УП). Целиком кандидат на перенос в расширение (новый объект или модуль).";
		М.sourceText = Выгрузка.ПрочитатьТекстМодуля(ПутьИсх);
		Возврат М;
	ИначеЕсли ПутьИсх = Неопределено Тогда
		М.bucket = "only_vendor";
		М.reason = "Модуль есть только у поставщика: в УП его нет. Решите, нужен ли он (объект удалён/переименован в УП или модуль просто не создан).";
		М.vendorText = Выгрузка.ПрочитатьТекстМодуля(ПутьПост);
		Возврат М;
	КонецЕсли;

	Если Выгрузка.ХешФайла(ПутьИсх) = Выгрузка.ХешФайла(ПутьПост) Тогда
		М.bucket = "identical";
		Возврат М;
	КонецЕсли;

	ТекстИсх = Выгрузка.ПрочитатьТекстМодуля(ПутьИсх);
	ТекстПост = Выгрузка.ПрочитатьТекстМодуля(ПутьПост);
	Если ТекстИсх = ТекстПост Тогда
		М.bucket = "identical"; // отличаются только кодировка/переводы строк
		Возврат М;
	КонецЕсли;
	М.sourceText = ТекстИсх;
	М.vendorText = ТекстПост;
	Если Разбор.Нормализовать(ТекстИсх) = Разбор.Нормализовать(ТекстПост) Тогда
		М.bucket = "cosmetic";
		М.reason = "Отличаются только комментарии, пустые строки или отступы. Доработки нет — можно брать текст поставщика.";
		Возврат М;
	КонецЕсли;

	РазборИсх = Разбор.РазобратьМодуль(ТекстИсх);
	РазборПост = Разбор.РазобратьМодуль(ТекстПост);
	М.outsideDiffers = (РазборИсх.ВнеМетодов <> РазборПост.ВнеМетодов);

	СчетХуков = Новый Структура("before, after, changeAndControl, instead, newMethod, none, manualChanged", 0, 0, 0, 0, 0, 0, 0);
	ЕстьРучнойХук = Ложь;

	ПоКлючу = Новый Соответствие;
	Для Каждого Мт Из РазборИсх.Методы Цикл
		ПоКлючу.Вставить(Мт.Ключ, Мт);
	КонецЦикла;
	Учтенные = Новый Соответствие;
	// Порядок — как у поставщика, затем добавленные в исходной.
	Для Каждого МтП Из РазборПост.Методы Цикл
		МтИ = ПоКлючу.Получить(МтП.Ключ);
		Учтенные.Вставить(МтП.Ключ, Истина);
		Если МтИ = Неопределено Тогда
			М.methods.Добавить(ОписаниеМетода(МтП.Имя, МтП.Вид, "removed", МтП.Текст, "", 1, "none", "manual", "", ""));
			М.counts.removed = М.counts.removed + 1;
		ИначеЕсли МтИ.Норм = МтП.Норм Тогда
			М.methods.Добавить(ОписаниеМетода(МтП.Имя, МтП.Вид, "same", "", "", 0, "none", "skip", "", ""));
			М.counts.same = М.counts.same + 1;
		Иначе
			Доля = Разбор.ДоляОтличий(МтП.Норм, МтИ.Норм);
			ТелоП = Разбор.ИзвлечьТелоМетода(МтП.Текст);
			ТелоИ = Разбор.ИзвлечьТелоМетода(МтИ.Текст);
			Предл = Синтез.ПредложитьХук(ТелоП, ТелоИ);
			М.methods.Добавить(ОписаниеМетода(МтП.Имя, МтП.Вид, "changed", МтП.Текст, МтИ.Текст, Доля,
				Предл.hook, Предл.decision, Предл.reason, Предл.hookBody));
			М.counts.changed = М.counts.changed + 1;
			УчестьХук(СчетХуков, Предл.hook, Предл.decision);
			Если Предл.decision = "manual" Тогда
				ЕстьРучнойХук = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого МтИ Из РазборИсх.Методы Цикл
		Если Учтенные.Получить(МтИ.Ключ) = Неопределено Тогда
			Учтенные.Вставить(МтИ.Ключ, Истина);
			М.methods.Добавить(ОписаниеМетода(МтИ.Имя, МтИ.Вид, "added", "", МтИ.Текст, 1,
				"newMethod", "auto", "Метод есть только в исходной (доработка УП). Перенести в расширение как новый метод; проверьте, кто его вызывает из типовых методов.", ""));
			М.counts.added = М.counts.added + 1;
			СчетХуков.newMethod = СчетХуков.newMethod + 1;
		КонецЕсли;
	КонецЦикла;

	К = М.counts;
	МожноАвто = (К.removed = 0) И (Не М.outsideDiffers) И (Не ЕстьРучнойХук)
		И (К.changed > 0 ИЛИ К.added > 0);
	Если МожноАвто Тогда
		М.bucket = "auto";
		М.reason = "Можно унести автоматически: " + ТекстСчетаХуков(СчетХуков) + ".";
	Иначе
		М.bucket = "manual";
		Причины = Новый Массив;
		Если К.removed > 0 Тогда
			Причины.Добавить("удалены типовые методы: " + К.removed);
		КонецЕсли;
		Если М.outsideDiffers Тогда
			Причины.Добавить("отличается код вне процедур (переменные модуля, инициализация)");
		КонецЕсли;
		Если ЕстьРучнойХук Тогда
			Причины.Добавить("есть изменённые методы без безопасного хука: " + СчетХуков.manualChanged);
		КонецЕсли;
		Хвост = ТекстСчетаХуков(СчетХуков);
		Если Хвост <> "" Тогда
			Причины.Добавить("остальные хуки: " + Хвост);
		ИначеЕсли К.changed > 0 Тогда
			Причины.Добавить("изменено типовых методов: " + К.changed);
		КонецЕсли;
		Если К.added > 0 И СчетХуков.newMethod = 0 Тогда
			Причины.Добавить("добавлено в УП: " + К.added);
		КонецЕсли;
		М.reason = "Ручной разбор: " + СтрСоединить(Причины, "; ") + ".";
	КонецЕсли;
	Если М.bucket = "auto" Тогда
		М.vendorText = ""; // для auto достаточно методов и hookBody
	КонецЕсли;
	Возврат М;

КонецФункции

Процедура УчестьХук(СчетХуков, Хук, Решение)
	Если Решение = "manual" Тогда
		СчетХуков.manualChanged = СчетХуков.manualChanged + 1;
		СчетХуков.none = СчетХуков.none + 1;
		Возврат;
	КонецЕсли;
	Если Хук = "before" Тогда
		СчетХуков.before = СчетХуков.before + 1;
	ИначеЕсли Хук = "after" Тогда
		СчетХуков.after = СчетХуков.after + 1;
	ИначеЕсли Хук = "changeAndControl" Тогда
		СчетХуков.changeAndControl = СчетХуков.changeAndControl + 1;
	ИначеЕсли Хук = "instead" Тогда
		СчетХуков.instead = СчетХуков.instead + 1;
	Иначе
		СчетХуков.none = СчетХуков.none + 1;
	КонецЕсли;
КонецПроцедуры

Функция ТекстСчетаХуков(Счет)
	Части = Новый Массив;
	Если Счет.changeAndControl > 0 Тогда
		Части.Добавить("&ИзменениеИКонтроль " + Счет.changeAndControl);
	КонецЕсли;
	Если Счет.after > 0 Тогда
		Части.Добавить("&После " + Счет.after);
	КонецЕсли;
	Если Счет.before > 0 Тогда
		Части.Добавить("&Перед " + Счет.before);
	КонецЕсли;
	Если Счет.instead > 0 Тогда
		Части.Добавить("&Вместо " + Счет.instead);
	КонецЕсли;
	Если Счет.newMethod > 0 Тогда
		Части.Добавить("новых методов " + Счет.newMethod);
	КонецЕсли;
	Возврат СтрСоединить(Части, ", ");
КонецФункции

Функция ОписаниеМетода(Имя, Вид, Статус, ТекстПост, ТекстИсх, Доля, Хук, Решение, ПричинаХука, ТелоХука)
	Мт = Новый Структура("name, kind, status, vendorText, sourceText, diffShare, explain, hook, hookDecision, hookBody",
		Имя, Вид, Статус, ТекстПост, ТекстИсх, Окр(Доля * 100), "", Хук, Решение, ТелоХука);
	Если Статус = "changed" Тогда
		Если ПричинаХука <> "" Тогда
			Мт.explain = ПричинаХука;
			Если Решение = "auto" Тогда
				Мт.explain = Мт.explain + " (~" + Мт.diffShare + "% строк отличается).";
			КонецЕсли;
		ИначеЕсли Доля <= 0.2 Тогда
			Мт.explain = "Небольшое отличие (~" + Мт.diffShare + "% строк).";
		Иначе
			Мт.explain = "Тело переписано (~" + Мт.diffShare + "% строк отличается).";
		КонецЕсли;
	ИначеЕсли Статус = "added" Тогда
		Мт.explain = ?(ПричинаХука <> "", ПричинаХука,
			"Метод есть только в исходной (доработка УП). Перенести в расширение как новый метод; проверьте, кто его вызывает из типовых методов.");
	ИначеЕсли Статус = "removed" Тогда
		Мт.explain = "Метод есть только у поставщика: в УП удалён или переименован. Не возвращайте и не удаляйте вслепую — проверьте вызовы и не заменён ли он другим методом.";
	КонецЕсли;
	Возврат Мт;
КонецФункции
