// Синтаксическая проверка модулей .bsl через vendored bsparser (vendor/bsparser, MIT).

Перем Парсер;
Перем ПарсерЗагружен;

// Полный путь к ObjectModule.bsl vendored bsparser.
//
// Возвращаемое значение:
//   Строка пути; существование файла не проверяется.
Функция ПутьПарсера() Экспорт
	Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "vendor", "bsparser");
	Возврат ОбъединитьПути(Корень, "src", "ПарсерВстроенногоЯзыка", ОбъединитьПути("Ext", "ObjectModule.bsl"));
КонецФункции

// Ленивая загрузка парсера; Ложь — парсер недоступен.
Функция ЗагрузитьПарсер()
	Если ПарсерЗагружен <> Неопределено Тогда
		Возврат ПарсерЗагружен;
	КонецЕсли;
	ПарсерЗагружен = Ложь;
	Путь = ПутьПарсера();
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Парсер = ЗагрузитьСценарий(Путь);
		ПарсерЗагружен = Истина;
	Исключение
		Парсер = Неопределено;
	КонецПопытки;
	Возврат ПарсерЗагружен;
КонецФункции

// Разбор одного текста модулем bsparser.
//
// Параметры:
//   Текст — содержимое .bsl.
//
// Возвращаемое значение:
//   Массив Структура(line, column, text); пустой — разобран или парсер недоступен.
Функция ОшибкиТекста(Текст) Экспорт
	Рез = Новый Массив;
	Если Не ЗагрузитьПарсер() Тогда
		Возврат Рез;
	КонецЕсли;
	Попытка
		Парсер.Пуск(Текст, Новый Массив);
	Исключение
		Если Парсер.ТаблицаОшибок().Количество() = 0 Тогда
			Рез.Добавить(Новый Структура("line, column, text", 0, 0,
				"Внутренняя ошибка парсера: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Возврат Рез;
		КонецЕсли;
	КонецПопытки;
	Для Каждого О Из Парсер.ТаблицаОшибок() Цикл
		Рез.Добавить(Новый Структура("line, column, text", О.НомерСтрокиНачала, О.НомерКолонкиНачала, О.Текст));
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Проверяет *.bsl в каталогах через bsparser.
//
// Параметры:
//   Каталоги — массив корней; Лимит — макс. число файлов (0 — все);
//   МаксОбразцов — длина samples.
//
// Возвращаемое значение:
//   Структура available, files, checked, skipped, errors, samples, ms.
Функция ПроверитьКаталоги(Каталоги, Лимит = 0, МаксОбразцов = 20) Экспорт
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Р = Новый Структура("available, files, checked, skipped, errors, samples, ms",
		ЗагрузитьПарсер(), 0, 0, 0, 0, Новый Массив, 0);
	Если Не Р.available Тогда
		Возврат Р;
	КонецЕсли;
	Для Каждого Корень Из Каталоги Цикл
		Если Не (Новый Файл(Корень)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Корень, "*.bsl", Истина) Цикл
			Р.files = Р.files + 1;
			Если Лимит > 0 И Р.checked >= Лимит Тогда
				Р.skipped = Р.skipped + 1;
				Продолжить;
			КонецЕсли;
			Р.checked = Р.checked + 1;
			Ошибки = ОшибкиТекста(ПрочитатьТекст(Ф.ПолноеИмя));
			Р.errors = Р.errors + Ошибки.Количество();
			Для Каждого О Из Ошибки Цикл
				Если Р.samples.Количество() >= МаксОбразцов Тогда
					Прервать;
				КонецЕсли;
				Р.samples.Добавить(Новый Структура("file, line, text",
					ОтносительныйПуть(Ф.ПолноеИмя, Корень), О.line, О.text));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Р.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Возврат Р;
КонецФункции

Функция ПрочитатьТекст(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

Функция ОтносительныйПуть(Полный, Корень)
	Род = (Новый Файл(Корень)).Имя;
	Поз = СтрНайти(Полный, Род);
	Возврат ?(Поз > 0, Сред(Полный, Поз), Полный);
КонецФункции
