// Синтаксическая проверка модулей .bsl через vendored bsparser (vendor/bsparser, MIT).

Перем Парсер;
Перем ПарсерЗагружен;
Перем РвИсключение;
Перем КэшФайлов; // кэш результатов по хешу текста (КэшПроверок) или Неопределено
Перем МодульКэша;

// Полный путь к ObjectModule.bsl vendored bsparser.
//
// Возвращаемое значение:
//   Строка пути; существование файла не проверяется.
Функция ПутьПарсера() Экспорт
	Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..", "vendor", "bsparser");
	Возврат ОбъединитьПути(Корень, "src", "ПарсерВстроенногоЯзыка", ОбъединитьПути("Ext", "ObjectModule.bsl"));
КонецФункции

// Ленивая загрузка парсера; Ложь — парсер недоступен.
Функция ЗагрузитьПарсер()
	Если ПарсерЗагружен <> Неопределено Тогда
		Возврат ПарсерЗагружен;
	КонецЕсли;
	ПарсерЗагружен = Ложь;
	Путь = ПутьПарсера();
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Парсер = ЗагрузитьСценарий(Путь);
		ПарсерЗагружен = Истина;
	Исключение
		Парсер = Неопределено;
	КонецПопытки;
	Возврат ПарсерЗагружен;
КонецФункции

// Разбор одного текста модулем bsparser.
//
// Параметры:
//   Текст — содержимое .bsl.
//
// Возвращаемое значение:
//   Массив Структура(line, column, text); пустой — разобран или парсер недоступен.
Функция ОшибкиТекста(Текст) Экспорт
	Рез = Новый Массив;
	Если Не ЗагрузитьПарсер() Тогда
		Возврат Рез;
	КонецЕсли;
	Попытка
		Парсер.Пуск(БезКонструкцийВнеПарсера(Текст), Новый Массив);
	Исключение
		Если Парсер.ТаблицаОшибок().Количество() = 0 Тогда
			Рез.Добавить(Новый Структура("line, column, text", 0, 0,
				"Внутренняя ошибка парсера: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
			Возврат Рез;
		КонецЕсли;
	КонецПопытки;
	Для Каждого О Из Парсер.ТаблицаОшибок() Цикл
		Рез.Добавить(Новый Структура("line, column, text", О.НомерСтрокиНачала, О.НомерКолонкиНачала, О.Текст));
	КонецЦикла;
	Возврат Рез;
КонецФункции

// Конструкции платформы 8.3.21+, которых нет в грамматике bsparser (ложные ошибки синтаксиса),
// приводятся к разбираемому виду с сохранением номеров строк:
//   ВызватьИсключение(Текст, Категория, …) — вызов с параметрами → ВызватьИсключение Ф(…);
//   #Область/#КонецОбласти — строки очищаются (bsparser не принимает Перем после #Область внутри метода).
Функция БезКонструкцийВнеПарсера(Знач Текст) Экспорт
	Если РвИсключение = Неопределено Тогда
		РвИсключение = Новый РегулярноеВыражение("(ВызватьИсключение|Raise)([ \t]*)\(");
	КонецЕсли;
	Если СтрНайти(НРег(Текст), "вызватьисключение") > 0 Или СтрНайти(НРег(Текст), "raise") > 0 Тогда
		Текст = РвИсключение.Заменить(Текст, "$1$2ПараметрыИсключения(");
	КонецЕсли;
	Если СтрНайти(Текст, "#") = 0 Тогда
		Возврат Текст;
	КонецЕсли;
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Для Й = 0 По Строки.ВГраница() Цикл
		С = НРег(СокрЛ(Строки[Й]));
		Если СтрНачинаетсяС(С, "#область") Или СтрНачинаетсяС(С, "#конецобласти")
			Или СтрНачинаетсяС(С, "#region") Или СтрНачинаетсяС(С, "#endregion") Тогда
			Строки[Й] = "";
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Проверяет *.bsl в каталогах через bsparser.
//
// Параметры:
//   Каталоги — массив корней; Лимит — макс. число файлов (0 — все);
//   МаксОбразцов — длина samples.
//
// Возвращаемое значение:
//   Структура available, files, checked, skipped, errors, samples, ms.
Функция ПроверитьКаталоги(Каталоги, Лимит = 0, МаксОбразцов = 20) Экспорт
	Старт = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Р = Новый Структура("available, files, checked, skipped, errors, samples, ms, cached",
		ЗагрузитьПарсер(), 0, 0, 0, 0, Новый Массив, 0, 0);
	Если Не Р.available Тогда
		Возврат Р;
	КонецЕсли;
	Новые = Новый Соответствие;
	Для Каждого Корень Из Каталоги Цикл
		Если Не (Новый Файл(Корень)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Корень, "*.bsl", Истина) Цикл
			Р.files = Р.files + 1;
			Если Лимит > 0 И Р.checked >= Лимит Тогда
				Р.skipped = Р.skipped + 1;
				Продолжить;
			КонецЕсли;
			Р.checked = Р.checked + 1;
			Ошибки = ОшибкиСКэшем(ПрочитатьТекст(Ф.ПолноеИмя), Новые, Р);
			Р.errors = Р.errors + Ошибки.Количество();
			Для Каждого О Из Ошибки Цикл
				Если Р.samples.Количество() >= МаксОбразцов Тогда
					Прервать;
				КонецЕсли;
				Р.samples.Добавить(Новый Структура("file, line, text",
					ОтносительныйПуть(Ф.ПолноеИмя, Корень), О.line, О.text));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Если КэшФайлов <> Неопределено Тогда
		МодульКэша.Сохранить(КэшФайлов, Новые);
	КонецЕсли;
	Р.ms = ТекущаяУниверсальнаяДатаВМиллисекундах() - Старт;
	Возврат Р;
КонецФункции

// Включает кэш по хешу текста модуля: ПутьКэша — <выход>\cache\syntax.json; "" — выключить.
// Версия кэша — хеш этого модуля и парсера bsparser (смена кода проверки сбрасывает кэш).
Процедура УстановитьКэш(ПутьКэша) Экспорт
	Если ПутьКэша = "" Тогда
		КэшФайлов = Неопределено;
		Возврат;
	КонецЕсли;
	МодульКэша = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "КэшПроверок.os"));
	Версия = МодульКэша.Хеш(МодульКэша.ТекстФайла(ТекущийСценарий().Источник) + МодульКэша.ТекстФайла(ПутьПарсера()));
	КэшФайлов = МодульКэша.ОткрытьКэшФайлов(ПутьКэша, Версия);
КонецПроцедуры

Функция ОшибкиСКэшем(Текст, Новые, Р)
	Если КэшФайлов = Неопределено Тогда
		Возврат ОшибкиТекстаСМаркерами(Текст);
	КонецЕсли;
	Х = МодульКэша.Хеш(Текст);
	Сохр = МодульКэша.НайтиВКэше(КэшФайлов, Х);
	Если Сохр <> Неопределено Тогда
		Р.cached = Р.cached + 1;
		Ошибки = Новый Массив;
		Для Каждого О Из Сохр Цикл
			Ошибки.Добавить(Новый Структура("line, column, text", О.Получить("line"), О.Получить("column"), О.Получить("text")));
		КонецЦикла;
	Иначе
		Ошибки = ОшибкиТекстаСМаркерами(Текст);
	КонецЕсли;
	Новые.Вставить(Х, Ошибки);
	Возврат Ошибки;
КонецФункции

// Ошибки текста с учётом маркеров &ИзменениеИКонтроль (#Удаление/#Вставка): платформа компилирует
// результат (без блоков #Удаление, с #Вставка) и сверяет исходный вариант (с #Удаление, без #Вставка).
// Маркеры внутри выражения (условие на нескольких строках) корректны для 1С, но не для bsparser —
// поэтому разбираются оба варианта (строки маркеров и вырезанные строки заменяются пустыми, номера строк сохраняются).
//
// Параметры:
//   Текст — содержимое .bsl.
//
// Возвращаемое значение:
//   Массив Структура(line, column, text) без повторов.
Функция ОшибкиТекстаСМаркерами(Текст) Экспорт
	Если СтрНайти(Текст, "#") = 0 Или Не ЕстьМаркерыИиК(Текст) Тогда
		Возврат ОшибкиТекста(Текст);
	КонецЕсли;
	Рез = Новый Массив;
	Были = Новый Соответствие;
	Для Каждого Вариант Из СтрРазделить("result,base", ",") Цикл
		Для Каждого О Из ОшибкиТекста(ВариантТекстаИиК(Текст, Вариант = "result")) Цикл
			Ключ = Строка(О.line) + "|" + О.text;
			Если Были.Получить(Ключ) = Неопределено Тогда
				Были.Вставить(Ключ, Истина);
				Рез.Добавить(О);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Рез;
КонецФункции

Функция ВидМаркераИиК(Стр)
	С = НРег(СокрЛП(Стр));
	Если Не СтрНачинаетсяС(С, "#") Тогда
		Возврат "";
	КонецЕсли;
	С = СокрЛП(Сред(С, 2));
	Если СтрНачинаетсяС(С, "конецудаления") Или СтрНачинаетсяС(С, "enddelete") Тогда
		Возврат "endDelete";
	ИначеЕсли СтрНачинаетсяС(С, "конецвставки") Или СтрНачинаетсяС(С, "endinsert") Тогда
		Возврат "endInsert";
	ИначеЕсли СтрНачинаетсяС(С, "удаление") Или СтрНачинаетсяС(С, "delete") Тогда
		Возврат "delete";
	ИначеЕсли СтрНачинаетсяС(С, "вставка") Или СтрНачинаетсяС(С, "insert") Тогда
		Возврат "insert";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЕстьМаркерыИиК(Текст)
	Для Каждого Стр Из СтрРазделить(Текст, Символы.ПС, Истина) Цикл
		Если ВидМаркераИиК(Стр) <> "" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Результат (Итог = Истина): строки #Удаление-блоков пустые; исходный: пустые строки #Вставка-блоков.
Функция ВариантТекстаИиК(Текст, Итог)
	Строки = СтрРазделить(Текст, Символы.ПС, Истина);
	Блок = "";
	Для Й = 0 По Строки.ВГраница() Цикл
		Вид = ВидМаркераИиК(Строки[Й]);
		Если Вид <> "" Тогда
			Блок = ?(Вид = "delete" Или Вид = "insert", Вид, "");
			Строки[Й] = "";
			Продолжить;
		КонецЕсли;
		Если (Итог И Блок = "delete") Или (Не Итог И Блок = "insert") Тогда
			Строки[Й] = "";
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

Функция ПрочитатьТекст(Путь)
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Текст = Неопределено, "", Текст);
КонецФункции

Функция ОтносительныйПуть(Полный, Корень)
	Род = (Новый Файл(Корень)).Имя;
	Поз = СтрНайти(Полный, Род);
	Возврат ?(Поз > 0, Сред(Полный, Поз), Полный);
КонецФункции
