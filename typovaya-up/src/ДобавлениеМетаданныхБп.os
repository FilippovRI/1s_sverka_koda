// Класс 3 (решение 24.11, t744u): реквизиты, ТЧ, колонки ТЧ и значения перечислений БП, которых нет в restored (УП),
// добавляются в XML объекта restored из выгрузки БП (с UUID БП), если на них ссылается код restored:
//   — реквизит/ТЧ/колонка: имя встречается словом в коде модулей самого объекта (включая формы, без комментариев);
//   — значение перечисления: «Перечисления.Имя.Значение» / «Перечисление.Имя.Значение» в любом модуле restored
//     или имя в модулях самого перечисления.
// (Поиск «Объект.Имя» по всем модулям для реквизитов отключён: на полной выгрузке слишком долгий; ошибки компиляции
// «Переменная не определена» дают только модули самого объекта.)
// Не добавляется (todo, причина в metadata_bp_added.csv): нет ссылок из кода; тип/ссылка XML ведёт на объект или
// подчинённый элемент, которого нет в restored; совпадение UUID; не найден фрагмент в БП или место вставки.
// Если тип реквизита/ТЧ ссылается на объект, которого нет в restored, он копируется из XML БП (только файл объекта, без форм и модулей) и регистрируется в Configuration.xml; транзитивно добавляются типы-зависимости (перечисления, определяемые типы, справочники). Не переносятся документы, регистры и планы счетов (Хозрасчетный: нет плана счетов в typovaya, ExtDimensionTypes=ВидыСубконтоХозрасчетные, полная цепочка — сотни объектов включая регистры; реквизит СчетБанк остаётся в todo). Если UUID объекта или TypeId/ValueId в InternalInfo уже заняты объектом того же класса в restored (переименование, как DefinedType.ТерриторияВыполненияРаботВОрганизации → ТерриторииВыполненияРаботВОрганизации), файл не копируется: тип сопоставляется с существующим, ссылки в реквизите подменяются. Исходные выгрузки только читаются.

Перем Тмм;
Перем КлассыПапки;
Перем РвСсылка;

Процедура Инициализировать()
	Тмм = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "TodoMissingMetadata.os"));
	Тмм.ИнициализироватьРегексп();
	КлассыПапки = Новый Соответствие;
	Для Каждого П Из СтрРазделить("Catalog:Catalogs,Document:Documents,Enum:Enums,ChartOfCharacteristicTypes:ChartsOfCharacteristicTypes,"
		+ "Characteristic:ChartsOfCharacteristicTypes,ChartOfAccounts:ChartsOfAccounts,ChartOfCalculationTypes:ChartsOfCalculationTypes,"
		+ "InformationRegister:InformationRegisters,AccumulationRegister:AccumulationRegisters,AccountingRegister:AccountingRegisters,"
		+ "CalculationRegister:CalculationRegisters,BusinessProcess:BusinessProcesses,Task:Tasks,ExchangePlan:ExchangePlans,"
		+ "DataProcessor:DataProcessors,Report:Reports,DefinedType:DefinedTypes,CommonModule:CommonModules,Constant:Constants,"
		+ "DocumentJournal:DocumentJournals,FunctionalOption:FunctionalOptions,CommonForm:CommonForms,Sequence:Sequences,"
		+ "FilterCriterion:FilterCriteria,SettingsStorage:SettingsStorages,CommonAttribute:CommonAttributes,CommonPicture:CommonPictures,"
		+ "CommonTemplate:CommonTemplates,CommonCommand:CommonCommands,CommandGroup:CommandGroups,DocumentNumerator:DocumentNumerators,"
		+ "SessionParameter:SessionParameters,XDTOPackage:XDTOPackages,StyleItem:StyleItems,Role:Roles,Subsystem:Subsystems", ",") Цикл
		Ч = СтрРазделить(П, ":");
		КлассыПапки.Вставить(Ч[0], Ч[1]);
	КонецЦикла;
	РвСсылка = Новый РегулярноеВыражение("(?<![\wЁё])(?:cfg:)?(DocumentJournal|DocumentNumerator|Document|Catalog|Enum|ChartOfCharacteristicTypes|Characteristic|ChartOfAccounts|ChartOfCalculationTypes"
		+ "|InformationRegister|AccumulationRegister|AccountingRegister|CalculationRegister|BusinessProcess|Task|ExchangePlan|DataProcessor|Report|DefinedType"
		+ "|CommonModule|Constant|FunctionalOption|CommonForm|Sequence|FilterCriterion|SettingsStorage|CommonAttribute|CommonPicture|CommonTemplate"
		+ "|CommonCommand|CommandGroup|SessionParameter|XDTOPackage|StyleItem|Role|Subsystem)"
		+ "(Ref|Object|Manager|RecordSet|RecordKey|RecordManager|List|Selection|ValueManager|TabularSectionRow|TabularSection|ValueKey|ExtDimensions|RecalculationsManager|BaseTypes)?"
		+ "\.([\wЁё]+)((?:\.[A-Za-z]+\.[\wЁё]+)*)");
	РвСсылка.ИгнорироватьРегистр = Ложь;
КонецПроцедуры

Функция Прочитать(Путь) Экспорт
	Ф = Новый Файл(Путь);
	Если Не Ф.Существует() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Ч = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Т = Ч.Прочитать();
	Ч.Закрыть();
	Возврат ?(Т = Неопределено, "", Т);
КонецФункции

Процедура Записать(Путь, Текст)
	ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Истина).Записать(Путь);
КонецПроцедуры

// Блок «<Тег …>…</Тег>» с отступом Отступ (табы), у которого Properties/Name = Имя, в диапазоне [Нач, Кон) текста.
// Структура(Нач, Кон — позиции 1-based начала строки блока и конца закрывающего тега, Текст) или Неопределено.
Функция НайтиБлок(Текст, Тег, Отступ, Имя, Знач Нач = 1, Знач Кон = 0) Экспорт
	Если Кон = 0 Тогда
		Кон = СтрДлина(Текст) + 1;
	КонецЕсли;
	Таб = "";
	Для Й = 1 По Отступ Цикл Таб = Таб + Символы.Таб; КонецЦикла;
	Откр = Символы.ПС + Таб + "<" + Тег + " ";
	Закр = Символы.ПС + Таб + "</" + Тег + ">";
	ИмяСтр = "<Name>" + Имя + "</Name>";
	Поз = Нач;
	Пока Истина Цикл
		Н = СтрНайти(Текст, Откр, , Поз);
		Если Н = 0 Или Н >= Кон Тогда
			Возврат Неопределено;
		КонецЕсли;
		К = СтрНайти(Текст, Закр, , Н + 1);
		Если К = 0 Или К >= Кон Тогда
			Возврат Неопределено;
		КонецЕсли;
		КонБлока = К + СтрДлина(Закр);
		Блок = Сред(Текст, Н + 1, КонБлока - Н - 1);
		// имя — первое <Name> блока (до вложенных ChildObjects)
		Пч = СтрНайти(Блок, "<ChildObjects");
		Шапка = ?(Пч > 0, Лев(Блок, Пч), Блок);
		Если СтрНайти(Шапка, ИмяСтр) > 0 Тогда
			Возврат Новый Структура("Нач, Кон, Текст", Н + 1, КонБлока, Блок);
		КонецЕсли;
		Поз = КонБлока;
	КонецЦикла;
КонецФункции

// Вставка Фрагмента (строки с отступом, без завершающего ПС) в ChildObjects с отступом Отступ в диапазоне [Нач, Кон):
// после последнего блока одного из тегов ПослеТегов (через запятую, по порядку приоритета), иначе сразу после <ChildObjects>.
// Возвращает новый текст или Неопределено.
Функция Вставить(Текст, Фрагмент, Отступ, ПослеТегов, Знач Нач = 1, Знач Кон = 0) Экспорт
	Если Кон = 0 Тогда
		Кон = СтрДлина(Текст) + 1;
	КонецЕсли;
	Таб = "";
	Для Й = 1 По Отступ Цикл Таб = Таб + Символы.Таб; КонецЦикла;
	Пусто = Символы.ПС + Таб + "<ChildObjects/>";
	Откр = Символы.ПС + Таб + "<ChildObjects>";
	Закр = Символы.ПС + Таб + "</ChildObjects>";
	Н = СтрНайти(Текст, Откр, , Нач);
	Если Н = 0 Или Н >= Кон Тогда
		П = СтрНайти(Текст, Пусто, , Нач);
		Если П = 0 Или П >= Кон Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Лев(Текст, П - 1) + Откр + Символы.ПС + Фрагмент + Закр + Сред(Текст, П + СтрДлина(Пусто));
	КонецЕсли;
	К = СтрНайти(Текст, Закр, , Н);
	Если К = 0 Или К >= Кон Тогда
		Возврат Неопределено;
	КонецЕсли;
	Место = 0;
	Для Каждого Тег Из СтрРазделить(ПослеТегов, ",", Ложь) Цикл
		ЗакрТег = Символы.ПС + Таб + Символы.Таб + "</" + Тег + ">";
		Поз = Н;
		Пока Истина Цикл
			П = СтрНайти(Текст, ЗакрТег, , Поз + 1);
			Если П = 0 Или П > К Тогда
				Прервать;
			КонецЕсли;
			Место = П + СтрДлина(ЗакрТег);
			Поз = П;
		КонецЦикла;
		Если Место > 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Место = 0 Тогда
		Место = Н + СтрДлина(Откр);
	КонецЕсли;
	Возврат Лев(Текст, Место - 1) + Символы.ПС + Фрагмент + Сред(Текст, Место);
КонецФункции

// Ссылки фрагмента XML на метаданные, которых нет в restored: Массив строк-причин.
Функция НедостающиеСсылки(Фрагмент, КаталогВосст, ТекстОбъекта, КэшXml)
	Р = Новый Массив;
	Для Каждого С Из РвСсылка.НайтиСовпадения(Фрагмент) Цикл
		Класс = С.Группы[1].Значение;
		Имя = С.Группы[3].Значение;
		Папка = КлассыПапки.Получить(Класс);
		Если Папка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Путь = ОбъединитьПути(КаталогВосст, Папка, Имя + ".xml");
		Xml = КэшXml.Получить(Путь);
		Если Xml = Неопределено Тогда
			Xml = Прочитать(Путь);
			КэшXml.Вставить(Путь, ?(Xml = Неопределено, "", Xml));
			Xml = КэшXml.Получить(Путь);
		КонецЕсли;
		Если Xml = "" Тогда
			Р.Добавить("нет в restored: " + Класс + "." + Имя);
			Продолжить;
		КонецЕсли;
		Хвост = С.Группы[4].Значение;
		Если Хвост = "" Тогда
			Продолжить;
		КонецЕсли;
		Ч = СтрРазделить(Сред(Хвост, 2), ".");
		Й = 0;
		Пока Й + 1 <= Ч.ВГраница() Цикл
			Кл = Ч[Й];
			Им = Ч[Й + 1];
			Й = Й + 2;
			Если СтрНачинаетсяС(Кл, "Standard") Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(Xml, ">" + Им + "<") = 0 И СтрНайти(ТекстОбъекта, ">" + Им + "<") = 0 Тогда
				Р.Добавить("нет в restored: " + Класс + "." + Имя + "." + Кл + "." + Им);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция ЗанятыеUuid(Фрагмент, Текст)
	Рв = Новый РегулярноеВыражение("[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}");
	Для Каждого С Из Рв.НайтиСовпадения(Фрагмент) Цикл
		Если С.Значение <> "00000000-0000-0000-0000-000000000000" И СтрНайти(Текст, С.Значение) > 0 Тогда
			Возврат С.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция КодПапки(Кат)
	Ч = Новый Массив;
	Если Не (Новый Файл(Кат)).Существует() Тогда
		Возврат "";
	КонецЕсли;
	РвКом = Новый РегулярноеВыражение("//[^\n]*");
	Для Каждого Ф Из НайтиФайлы(Кат, "*.bsl", Истина) Цикл
		Т = Прочитать(Ф.ПолноеИмя);
		Если Т <> Неопределено Тогда
			Ч.Добавить(РвКом.Заменить(Т, ""));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Ч, Символы.ПС);
КонецФункции

Функция ЕстьСлово(Код, Имя)
	Если СтрНайти(НРег(Код), НРег(Имя)) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Рв = Новый РегулярноеВыражение("(?<![\wЁё])" + Имя + "(?![\wЁё])");
	Возврат Рв.Совпадает(Код);
КонецФункции

// Глобальные ссылки на значения перечислений «Перечисления.Имя.Значение» по всем модулям restored:
// Соответствие НРег("перечисления.Имя.Значение") → Истина (только для перечислений-кандидатов).
Функция ГлобальныеСсылки(КаталогВосст, Кандидаты)
	Р = Новый Соответствие;
	Перечисления = Новый Соответствие;
	Для Каждого З Из Кандидаты Цикл
		Если З.kind = "значение перечисления" Тогда
			Перечисления.Вставить(НРег(СтрРазделить(З.object, ".")[1]), Истина);
		КонецЕсли;
	КонецЦикла;
	Если Перечисления.Количество() = 0 Тогда
		Возврат Р;
	КонецЕсли;
	РвП = Новый РегулярноеВыражение("Перечислени[ея]\.([\wЁё]+)\.([\wЁё]+)");
	Для Каждого Ф Из НайтиФайлы(КаталогВосст, "*.bsl", Истина) Цикл
		Т = Прочитать(Ф.ПолноеИмя);
		Если Т = Неопределено Или СтрНайти(Т, "еречислени") = 0 Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого С Из РвП.НайтиСовпадения(Т) Цикл
			Имя = НРег(С.Группы[1].Значение);
			Если Перечисления.Получить(Имя) <> Неопределено Тогда
				Р.Вставить("перечисления." + Имя + "." + НРег(С.Группы[2].Значение), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Р;
КонецФункции

Функция Применить(КаталогВосст, КореньБп, Лог, КаталогОтчёта = "") Экспорт
	Инициализировать();
	Кандидаты = Тмм.РазличияМетаданных(КаталогВосст, КореньБп);
	Рез = Новый Структура("candidates, added, skipped, typesAdded, rows", Кандидаты.Количество(), 0, 0, 0, Новый Массив);
	Рез.Вставить("typesTried", Новый Соответствие);
	Рез.Вставить("typesAlias", Новый Соответствие);
	Рез.Вставить("uuidIndex", Неопределено);
	Глоб = ГлобальныеСсылки(КаталогВосст, Кандидаты);
	// по объектам
	ПоОбъектам = Новый Соответствие;
	Порядок = Новый Массив;
	Для Каждого З Из Кандидаты Цикл
		М = ПоОбъектам.Получить(З.folder);
		Если М = Неопределено Тогда
			М = Новый Массив;
			ПоОбъектам.Вставить(З.folder, М);
			Порядок.Добавить(З.folder);
		КонецЕсли;
		М.Добавить(З);
	КонецЦикла;
	КэшXml = Новый Соответствие;
	Для Каждого Папка Из Порядок Цикл
		Записи = ПоОбъектам.Получить(Папка);
		ПапкаП = СтрЗаменить(Папка, "\", "/");
		ПутьВ = ОбъединитьПути(КаталогВосст, ПапкаП + ".xml");
		ПутьБ = ОбъединитьПути(КореньБп, ПапкаП + ".xml");
		ТекстВ = Прочитать(ПутьВ);
		ТекстБ = Прочитать(ПутьБ);
		ЕстьВК = ТекстВ <> Неопределено И СтрНайти(ТекстВ, Символы.ВК + Символы.ПС) > 0;
		Если ТекстВ <> Неопределено Тогда ТекстВ = СтрЗаменить(ТекстВ, Символы.ВК, ""); КонецЕсли;
		Если ТекстБ <> Неопределено Тогда ТекстБ = СтрЗаменить(ТекстБ, Символы.ВК, ""); КонецЕсли;
		КодОбъекта = КодПапки(ОбъединитьПути(КаталогВосст, ПапкаП));
		ИмяОбъекта = СтрРазделить(ПапкаП, "/")[1];
		Исх = ТекстВ;
		Отложенные = Новый Массив;
		Для Проход = 1 По 2 Цикл
			Очередь = ?(Проход = 1, Записи, Отложенные);
			Отложенные = Новый Массив;
			Для Каждого З Из Очередь Цикл
				Причина = "";
				Части = СтрРазделить(З.name, ".");
				Имя = Части[Части.ВГраница()];
				// TodoMissingMetadata считает колонки ТЧ и реквизитами объекта — такие записи пропускаются (есть отдельная запись ТЧ/колонки)
				Если З.kind = "реквизит" И ТекстБ <> Неопределено И НайтиБлок(ТекстБ, "Attribute", 3, Имя) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если З.kind = "значение перечисления" Тогда
					Ссылка = ЕстьСлово(КодОбъекта, Имя) Или Глоб.Получить(НРег("перечисления." + ИмяОбъекта + "." + Имя)) <> Неопределено;
				Иначе
					Ссылка = ЕстьСлово(КодОбъекта, Имя);
				КонецЕсли;
				Блок = Неопределено;
				Если Не Ссылка Тогда
					Причина = "нет ссылок из кода restored";
				ИначеЕсли ТекстВ = Неопределено Или ТекстБ = Неопределено Тогда
					Причина = "нет XML объекта в restored или БП";
				Иначе
					Если З.kind = "реквизит" Тогда
						Блок = НайтиБлок(ТекстБ, "Attribute", 3, Имя);
					ИначеЕсли З.kind = "ТЧ" Тогда
						Блок = НайтиБлок(ТекстБ, "TabularSection", 3, Имя);
					ИначеЕсли З.kind = "значение перечисления" Тогда
						Блок = НайтиБлок(ТекстБ, "EnumValue", 3, Имя);
					ИначеЕсли З.kind = "колонка ТЧ" Тогда
						ТчБ = НайтиБлок(ТекстБ, "TabularSection", 3, Части[0]);
						Блок = ?(ТчБ = Неопределено, Неопределено, НайтиБлок(ТекстБ, "Attribute", 5, Имя, ТчБ.Нач - 1, ТчБ.Кон));
					КонецЕсли;
					Если Блок = Неопределено Тогда
						Причина = "фрагмент не найден в XML БП";
					КонецЕсли;
				КонецЕсли;
				ТекстФрагмента = "";
				Если Причина = "" Тогда
					Нет = НедостающиеСсылки(Блок.Текст, КаталогВосст, ТекстВ, КэшXml);
					Если Нет.Количество() > 0 Тогда
						ОбеспечитьТипыИзПричин(Нет, КаталогВосст, КореньБп, КэшXml, Рез);
						ТекстФрагмента = ПодменитьАлиасыТипов(Блок.Текст, Рез);
						Нет = НедостающиеСсылки(ТекстФрагмента, КаталогВосст, ТекстВ, КэшXml);
					Иначе
						ТекстФрагмента = Блок.Текст;
					КонецЕсли;
					Если Нет.Количество() > 0 Тогда
						Причина = "тип/ссылка: " + СтрСоединить(Нет, ", ");
					Иначе
						Занят = ЗанятыеUuid(ТекстФрагмента, ТекстВ);
						Если Занят <> "" Тогда
							Причина = "UUID уже есть в объекте restored: " + Занят;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				Новый_ = Неопределено;
				Если Причина = "" Тогда
					Если З.kind = "реквизит" Тогда
						Новый_ = Вставить(ТекстВ, ТекстФрагмента, 2, "Attribute");
					ИначеЕсли З.kind = "ТЧ" Тогда
						Новый_ = Вставить(ТекстВ, ТекстФрагмента, 2, "TabularSection,Attribute");
					ИначеЕсли З.kind = "значение перечисления" Тогда
						Новый_ = Вставить(ТекстВ, ТекстФрагмента, 2, "EnumValue");
					Иначе
						ТчВ = НайтиБлок(ТекстВ, "TabularSection", 3, Части[0]);
						Если ТчВ <> Неопределено Тогда
							Новый_ = Вставить(ТекстВ, ТекстФрагмента, 4, "Attribute", ТчВ.Нач - 1, ТчВ.Кон);
						КонецЕсли;
					КонецЕсли;
					Если Новый_ = Неопределено Тогда
						Причина = "не найдено место вставки в XML restored";
					КонецЕсли;
				КонецЕсли;
				Если Причина <> "" И Проход = 1 И СтрНачинаетсяС(Причина, "тип/ссылка") Тогда
					// может ссылаться на элемент, добавляемый позже в этом же объекте
					Отложенные.Добавить(З);
					Продолжить;
				КонецЕсли;
				Если Причина = "" Тогда
					ТекстВ = Новый_;
					Рез.added = Рез.added + 1;
				Иначе
					Рез.skipped = Рез.skipped + 1;
				КонецЕсли;
				Рез.rows.Добавить(Новый Структура("object, kind, name, status, reason", З.object, З.kind, З.name, ?(Причина = "", "добавлено", "todo"), Причина));
			КонецЦикла;
		КонецЦикла;
		Если ТекстВ <> Исх И ТекстВ <> Неопределено Тогда
			Записать(ПутьВ, ?(ЕстьВК, СтрЗаменить(ТекстВ, Символы.ПС, Символы.ВК + Символы.ПС), ТекстВ));
		КонецЕсли;
	КонецЦикла;
	Если КаталогОтчёта <> "" Тогда
		ЗаписатьОтчёт(КаталогОтчёта, Рез);
	КонецЕсли;
	Лог.Добавить("Метаданные БП в restored (класс 3 со ссылками из кода): кандидатов " + Рез.candidates + ", добавлено " + Рез.added
		+ ", объектов типов " + Рез.typesAdded + ", в todo " + Рез.skipped + " (metadata_bp_added.csv)");
	Возврат Рез;
КонецФункции

Процедура ЗаписатьОтчёт(Каталог, Рез)
	Csv = Новый Массив;
	Csv.Добавить("Объект;Вид;Имя;Статус;Причина");
	Причины = Новый Соответствие;
	Для Каждого С Из Рез.rows Цикл
		Csv.Добавить(С.object + ";" + С.kind + ";" + С.name + ";" + С.status + ";" + С.reason);
		Ключ = ?(С.status = "добавлено", "добавлено", ?(СтрНачинаетсяС(С.reason, "тип/ссылка"), "todo: тип/ссылка на отсутствующее в restored",
			?(СтрНачинаетсяС(С.reason, "UUID"), "todo: UUID уже есть в объекте restored (элемент УП с тем же UUID)", "todo: " + С.reason)));
		Причины.Вставить(Ключ, ?(Причины.Получить(Ключ) = Неопределено, 0, Причины.Получить(Ключ)) + 1);
	КонецЦикла;
	Записать(ОбъединитьПути(Каталог, "metadata_bp_added.csv"), СтрСоединить(Csv, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС);
	Md = Новый Массив;
	Md.Добавить("# Метаданные БП, добавленные в restored (класс 3 со ссылками из кода)");
	Md.Добавить("");
	Md.Добавить("Кандидатов: " + Рез.candidates + ", добавлено: " + Рез.added + ", в todo: " + Рез.skipped);
	Md.Добавить("");
	Md.Добавить("| Итог | Количество |");
	Md.Добавить("|---|---|");
	Для Каждого КЗ Из Причины Цикл
		Md.Добавить("| " + КЗ.Ключ + " | " + КЗ.Значение + " |");
	КонецЦикла;
	Md.Добавить("");
	Md.Добавить("Подробно — metadata_bp_added.csv.");
	Записать(ОбъединитьПути(Каталог, "metadata_bp_added.md"), СтрСоединить(Md, Символы.ВК + Символы.ПС) + Символы.ВК + Символы.ПС);
КонецПроцедуры

Функция ЭтоТяжёлыйКлассТипа(Класс)
	Возврат Класс = "Document" Или Класс = "InformationRegister" Или Класс = "AccumulationRegister"
		Или Класс = "AccountingRegister" Или Класс = "CalculationRegister" Или Класс = "BusinessProcess"
		Или Класс = "Task" Или Класс = "DocumentJournal" Или Класс = "Sequence" Или Класс = "ChartOfAccounts";
КонецФункции

Функция СсылкиТиповИзXml(Текст) Экспорт
	Р = Новый Массив;
	Уже = Новый Соответствие;
	Куски = Новый Массив;
	Куски.Добавить(Текст);
	Для Каждого С Из РвСсылка.НайтиСовпадения(Текст) Цикл
		Класс = С.Группы[1].Значение;
		Имя = С.Группы[3].Значение;
		Если Класс = "Characteristic" Тогда
			Класс = "ChartOfCharacteristicTypes";
		КонецЕсли;
		Ключ = Класс + "." + Имя;
		Если Уже.Получить(Ключ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Уже.Вставить(Ключ, Истина);
		Р.Добавить(Ключ);
	КонецЦикла;
	Возврат Р;
КонецФункции

Процедура ДобавитьУзелТипаВConfiguration(КаталогВосст, Тег, Имя)
	Путь = ОбъединитьПути(КаталогВосст, "Configuration.xml");
	Если Не (Новый Файл(Путь)).Существует() Тогда
		Возврат;
	КонецЕсли;
	Узел = "<" + Тег + ">" + Имя + "</" + Тег + ">";
	Текст = Прочитать(Путь);
	Если Текст = Неопределено Или СтрНайти(Текст, Узел) > 0 Тогда
		Возврат;
	КонецЕсли;
	Маркер = "</ChildObjects>";
	Поз = СтрНайти(Текст, Маркер, НаправлениеПоиска.СКонца);
	Если Поз = 0 Тогда
		Возврат;
	КонецЕсли;
	ЕстьВК = СтрНайти(Текст, Символы.ВК + Символы.ПС) > 0;
	Текст = СтрЗаменить(Текст, Символы.ВК, "");
	Поз = СтрНайти(Текст, Маркер, НаправлениеПоиска.СКонца);
	Текст = Лев(Текст, Поз - 1) + "		" + Узел + Символы.ПС + Сред(Текст, Поз);
	Записать(Путь, ?(ЕстьВК, СтрЗаменить(Текст, Символы.ПС, Символы.ВК + Символы.ПС), Текст));
КонецПроцедуры

Функция УидыОбъектаМетаданных(Текст)
	Р = Новый Массив;
	РвКор = Новый РегулярноеВыражение("<(?:DefinedType|Catalog|Enum|ChartOfCharacteristicTypes|ChartOfAccounts|ChartOfCalculationTypes|ExchangePlan|FilterCriterion|Document|InformationRegister|AccumulationRegister|AccountingRegister|CalculationRegister|BusinessProcess|Task|DocumentJournal|Sequence|DataProcessor|Report|CommonModule|Constant|FunctionalOption|CommonForm|SettingsStorage|CommonAttribute|CommonPicture|CommonTemplate|CommonCommand|CommandGroup|DocumentNumerator|SessionParameter|XDTOPackage|StyleItem|Role|Subsystem)\s+uuid=""([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})""");
	Для Каждого С Из РвКор.НайтиСовпадения(Текст) Цикл
		Если С.Группы[1].Значение <> "00000000-0000-0000-0000-000000000000" Тогда
			Р.Добавить(НРег(С.Группы[1].Значение));
		КонецЕсли;
		Прервать;
	КонецЦикла;
	П1 = СтрНайти(Текст, "<InternalInfo>");
	П2 = СтрНайти(Текст, "</InternalInfo>");
	Если П1 > 0 И П2 > П1 Тогда
		РвИд = Новый РегулярноеВыражение("<xr:(?:TypeId|ValueId)>([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})</xr:(?:TypeId|ValueId)>");
		Для Каждого Сид Из РвИд.НайтиСовпадения(Сред(Текст, П1, П2 - П1)) Цикл
			Р.Добавить(НРег(Сид.Группы[1].Значение));
		КонецЦикла;
	КонецЕсли;
	Возврат Р;
КонецФункции

Процедура ДобавитьУидыВИндекс(Текст, Ключ, Индекс)
	Для Каждого У Из УидыОбъектаМетаданных(Текст) Цикл
		Если Индекс.Получить(У) = Неопределено Тогда
			Индекс.Вставить(У, Ключ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбеспечитьИндексUuid(КаталогВосст, Рез)
	Если Рез.uuidIndex <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Индекс = Новый Соответствие;
	Папки = Новый Соответствие;
	Для Каждого П Из КлассыПапки Цикл
		Если Папки.Получить(П.Значение) = Неопределено Тогда
			Папки.Вставить(П.Значение, П.Ключ);
		КонецЕсли;
	КонецЦикла;
	РвКор = Новый РегулярноеВыражение("<([A-Za-z]+)\s+uuid=""([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})""");
	Для Каждого Пп Из Папки Цикл
		Кат = ОбъединитьПути(КаталогВосст, Пп.Ключ);
		Если Не (Новый Файл(Кат)).Существует() Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Ф Из НайтиФайлы(Кат, "*.xml") Цикл
			Текст = Прочитать(Ф.ПолноеИмя);
			Если Текст = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Класс = Пп.Значение;
			Для Каждого С Из РвКор.НайтиСовпадения(Текст) Цикл
				Класс = С.Группы[1].Значение;
				Прервать;
			КонецЦикла;
			Имя = Ф.ИмяБезРасширения;
			ДобавитьУидыВИндекс(Текст, Класс + "." + Имя, Индекс);
		КонецЦикла;
	КонецЦикла;
	Рез.uuidIndex = Индекс;
КонецПроцедуры

Функция ПодменитьАлиасыТипов(Текст, Рез) Экспорт
	Если Рез.typesAlias = Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Для Каждого П Из Рез.typesAlias Цикл
		ЧС = СтрРазделить(П.Ключ, ".");
		ЧН = СтрРазделить(П.Значение, ".");
		Если ЧС.Количество() < 2 Или ЧН.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		Рв = Новый РегулярноеВыражение("(?<![\wЁё])" + ЧС[0]
			+ "(Ref|Object|Manager|RecordSet|RecordKey|RecordManager|List|Selection|ValueManager|TabularSectionRow|TabularSection|ValueKey|ExtDimensions|RecalculationsManager|BaseTypes)?"
			+ "\." + ЧС[1] + "(?![\wЁё])");
		Текст = Рв.Заменить(Текст, ЧН[0] + "$1." + ЧН[1]);
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция СопоставитьПоUuid(Ключ, Класс, ТекстБ, КаталогВосст, Рез)
	ОбеспечитьИндексUuid(КаталогВосст, Рез);
	Для Каждого У Из УидыОбъектаМетаданных(ТекстБ) Цикл
		Сущ = Рез.uuidIndex.Получить(У);
		Если Сущ = Неопределено Или Сущ = Ключ Тогда
			Продолжить;
		КонецЕсли;
		Ч = СтрРазделить(Сущ, ".");
		Если Ч.Количество() >= 2 И Ч[0] = Класс Тогда
			Рез.typesAlias.Вставить(Ключ, Сущ);
			Рез.typesTried.Вставить(Ключ, Истина);
			ЧастиКлюча = СтрРазделить(Ключ, ".");
			ИмяБп = ?(ЧастиКлюча.Количество() >= 2, ЧастиКлюча[1], Ключ);
			Рез.rows.Добавить(Новый Структура("object, kind, name, status, reason", Ключ, "объект типа", ИмяБп, "сопоставлен", "UUID InternalInfo совпадает с " + Сущ));
			Возврат "алиас";
		КонецЕсли;
		Возврат "конфликт";
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ОбеспечитьОбъектТипаИзБп(Ключ, КаталогВосст, КореньБп, КэшXml, Стек, Рез, Знач Глубина = 0) Экспорт
	Части = СтрРазделить(Ключ, ".");
	Если Части.Количество() < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Класс = Части[0];
	Имя = Части[1];
	Если Класс = "Characteristic" Тогда
		Класс = "ChartOfCharacteristicTypes";
		Ключ = Класс + "." + Имя;
	КонецЕсли;
	Папка = КлассыПапки.Получить(Класс);
	Если Папка = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПутьВ = ОбъединитьПути(КаталогВосст, Папка, Имя + ".xml");
	Если (Новый Файл(ПутьВ)).Существует() Тогда
		Рез.typesTried.Вставить(Ключ, Истина);
		Возврат Истина;
	КонецЕсли;
	Если Рез.typesTried.Получить(Ключ) <> Неопределено Тогда
		Возврат Рез.typesTried.Получить(Ключ) = Истина;
	КонецЕсли;
	Если ЭтоТяжёлыйКлассТипа(Класс) Тогда
		Рез.typesTried.Вставить(Ключ, Ложь);
		Возврат Ложь;
	КонецЕсли;
	Если Глубина > 20 Или Стек.Получить(Ключ) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	ПутьБ = ОбъединитьПути(КореньБп, Папка, Имя + ".xml");
	ТекстБ = Прочитать(ПутьБ);
	Если ТекстБ = Неопределено Тогда
		Рез.typesTried.Вставить(Ключ, Ложь);
		Возврат Ложь;
	КонецЕсли;
	Соп = СопоставитьПоUuid(Ключ, Класс, ТекстБ, КаталогВосст, Рез);
	Если Соп = "алиас" Тогда
		Возврат Истина;
	ИначеЕсли Соп = "конфликт" Тогда
		Рез.typesTried.Вставить(Ключ, Ложь);
		Возврат Ложь;
	КонецЕсли;
	Стек.Вставить(Ключ, Истина);
	Для Каждого Зав Из СсылкиТиповИзXml(ТекстБ) Цикл
		Если Зав = Ключ Тогда
			Продолжить;
		КонецЕсли;
		Если Не ОбеспечитьОбъектТипаИзБп(Зав, КаталогВосст, КореньБп, КэшXml, Стек, Рез, Глубина + 1) Тогда
			Стек.Удалить(Ключ);
			Рез.typesTried.Вставить(Ключ, Ложь);
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Стек.Удалить(Ключ);
	ЕстьВК = СтрНайти(ТекстБ, Символы.ВК + Символы.ПС) > 0;
	ТекстБ = СтрЗаменить(ТекстБ, Символы.ВК, "");
	СоздатьКаталог((Новый Файл(ПутьВ)).Путь);
	Записать(ПутьВ, ?(ЕстьВК, СтрЗаменить(ТекстБ, Символы.ПС, Символы.ВК + Символы.ПС), ТекстБ));
	КэшXml.Вставить(ПутьВ, ТекстБ);
	ДобавитьУзелТипаВConfiguration(КаталогВосст, Класс, Имя);
	Если Рез.uuidIndex <> Неопределено Тогда
		ДобавитьУидыВИндекс(ТекстБ, Класс + "." + Имя, Рез.uuidIndex);
	КонецЕсли;
	Рез.typesAdded = Рез.typesAdded + 1;
	Рез.typesTried.Вставить(Ключ, Истина);
	Рез.rows.Добавить(Новый Структура("object, kind, name, status, reason", Ключ, "объект типа", Имя, "добавлено", ""));
	Возврат Истина;
КонецФункции

Процедура ОбеспечитьТипыИзПричин(Нет, КаталогВосст, КореньБп, КэшXml, Рез)
	Стек = Новый Соответствие;
	Для Каждого Стр Из Нет Цикл
		Маркер = "нет в restored: ";
		П = СтрНайти(Стр, Маркер);
		Если П = 0 Тогда
			Продолжить;
		КонецЕсли;
		Ключ = СокрЛП(Сред(Стр, П + СтрДлина(Маркер)));
		Части = СтрРазделить(Ключ, ".");
		Если Части.Количество() > 2 Тогда
			// Catalog.X.TabularSection.Col — сам объект уже должен быть; это не корневой тип
			Продолжить;
		КонецЕсли;
		ОбеспечитьОбъектТипаИзБп(Ключ, КаталогВосст, КореньБп, КэшXml, Стек, Рез);
	КонецЦикла;
КонецПроцедуры
