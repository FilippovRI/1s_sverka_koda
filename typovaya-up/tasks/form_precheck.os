// oscript tasks/form_precheck.os <restored> --бп ... --уп ... [--json out.json]
Корень = "";
Кб = "";
Ку = "";
ПJson = "";
Если АргументыКоманднойСтроки.Количество() = 0 Тогда
	Сообщить("usage: oscript tasks/form_precheck.os <restored> --бп path --уп path [--json path]");
	ЗавершитьРаботу(2);
КонецЕсли;
Корень = АргументыКоманднойСтроки[0];
Для Й = 1 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
	Если (А = "--бп" Или А = "--bp") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Кб = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--уп" Или А = "--up") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Ку = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли А = "--json" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		ПJson = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	КонецЕсли;
КонецЦикла;
Пров = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ПроверкаЗамкнутости.os"));
Р = Пров.ПредчекOverlayFormBp(Корень, Кб, Ку);
Отч = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ОтчетHTML.os"));
Если ПJson = "" Тогда
	ПJson = ОбъединитьПути(Корень, "form_precheck.json");
КонецЕсли;
Отч.ЗаписатьФайл(ПJson, Отч.ВJSON(Р));
Сообщить("form_precheck: checked=" + Р.checked + " incompatible=" + Р.incompatible);
Для Каждого Т Из Р.topReasons Цикл
	Сообщить("  " + Т.reason + ": " + Т.count);
КонецЦикла;
ЗавершитьРаботу(0);