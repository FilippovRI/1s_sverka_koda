// Пересборка только restored-слоя: --из готовый mf-out --в новый out [--уп] [--бп]
Процедура КопироватьКаталог(Откуда, Куда)
	СоздатьКаталог(Куда);
	Для Каждого Ф Из НайтиФайлы(Откуда, "*", Истина) Цикл
		Если Ф.ЭтоКаталог() Тогда
			КопироватьКаталог(Ф.ПолноеИмя, ОбъединитьПути(Куда, Ф.Имя));
		Иначе
			Н = ОбъединитьПути(Куда, Ф.Имя);
			СоздатьКаталог((Новый Файл(Н)).Путь);
			КопироватьФайл(Ф.ПолноеИмя, Н);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Отчет = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ОтчетHTML.os"));
Мф = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "МодулиИФормыБыстро.os"));

КатИз = "";
В = "";
Ку = "";
Кб = "";
Для Й = 0 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
	Если (А = "--из" Или А = "--from") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		КатИз = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--в" Или А = "--out") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		В = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--уп" Или А = "--up") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Ку = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--бп" Или А = "--bp") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Кб = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	КонецЕсли;
КонецЦикла;
Если КатИз = "" Или В = "" Тогда
	ВызватьИсключение "mf_reapply: нужны --из и --в";
КонецЕсли;
Сводка = Отчет.ПрочитатьСводку(КатИз);
Если Ку = "" Тогда
	Ку = Сводка.meta.source;
КонецЕсли;
Если Кб = "" Тогда
	Кб = Сводка.meta.vendor;
КонецЕсли;
СоздатьКаталог(В);
Для Каждого Имя Из СтрРазделить("extension,summary.json,log.txt,cache", ",") Цикл
	П = ОбъединитьПути(КатИз, СокрЛП(Имя));
	Н = ОбъединитьПути(В, СокрЛП(Имя));
	Если (Новый Файл(П)).Существует() Тогда
		Если (Новый Файл(П)).ЭтоКаталог() Тогда
			КопироватьКаталог(П, Н);
		Иначе
			КопироватьФайл(П, Н);
		КонецЕсли;
	КонецЕсли;
КонецЦикла;
КопироватьКаталог(ОбъединитьПути(КатИз, "restored"), ОбъединитьПути(В, "restored"));
Лог = Новый Массив;
Рмф = Мф.ПрименитьДословноБпКRestored(ОбъединитьПути(В, "restored"), Кб, Ку, Лог, В);
Сводка.Вставить("formsKeptUp", Рмф.formsKeptUp);
Сводка.Вставить("formPrecheck", Новый Структура("checked, incompatible, topReasons",
	Рмф.formPrecheck.checked, Рмф.formPrecheck.incompatible, Рмф.formPrecheck.topReasons));
Мфм = Новый Структура;
Если Сводка.Свойство("modulesForms") Тогда
	Мфм = Сводка.modulesForms;
КонецЕсли;
Мфм.Вставить("formsKeptUp", Рмф.formsKeptUp.Количество());
Мфм.Вставить("formsXml", Рмф.formsXml);
Сводка.Вставить("modulesForms", Мфм);
Сводка.Вставить("reapplyRestored", Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm'"));
Отчет.ЗаписатьФайл(ОбъединитьПути(В, "summary.json"), Отчет.ВJSON(Сводка));
Отчет.ЗаписатьФайл(ОбъединитьПути(В, "reapply_restored.log"), СтрСоединить(Лог, Символы.ПС));
Сообщить("reapply: formsBp=" + Рмф.formsXml + " keptUp=" + Рмф.formsKeptUp.Количество()
	+ " precheck incomp=" + Рмф.formPrecheck.incompatible);