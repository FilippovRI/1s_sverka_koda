// Разбор load_restored.log → import_errors.json (все [ERROR], классификация)
ПернJson = "";
Для Й = 0 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
	Если А = "--json" И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		ПернJson = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	КонецЕсли;
КонецЦикла;
Лог = "D:\typovaya-up-out-mf2\load\load_restored.log";
Если АргументыКоманднойСтроки.Количество() > 0 И (Новый Файл(АргументыКоманднойСтроки[0])).Существует() Тогда
	Лог = АргументыКоманднойСтроки[0];
КонецЕсли;
Если ПернJson = "" Тогда
	ПернJson = ОбъединитьПути((Новый Файл(Лог)).Путь, "import_errors.json");
КонецЕсли;
Строки = Новый Массив;
Т = Новый ТекстовыйДокумент;
Т.Прочитать(Лог, КодировкаТекста.UTF8);
Для К = 1 По Т.КоличествоСтрок() Цикл
	С = Т.ПолучитьСтроку(К);
	Если СтрНайти(С, "[ERROR]") > 0 Тогда
		Строки.Добавить(С);
	КонецЕсли;
КонецЦикла;
Ош = Новый Массив;
Классы = Новый Соответствие;
Для Каждого С Из Строки Цикл
	Кл = "other";
	Если СтрНайти(С, "Неверный путь к данным") > 0 Тогда
		Кл = "DataPath";
	ИначеЕсли СтрНайти(С, "XDTO") > 0 Тогда
		Кл = "XDTO";
	ИначеЕсли СтрНайти(С, "импорт") > 0 Тогда
		Кл = "import";
	КонецЕсли;
	Классы.Вставить(Кл, ?(Классы.Получить(Кл) = Неопределено, 1, Классы.Получить(Кл) + 1));
	Ош.Добавить(Новый Структура("class, line", Кл, С));
КонецЦикла;
Отч = ЗагрузитьСценарий(ОбъединитьПути(ТекущийСценарий().Каталог, "..", "src", "ОтчетHTML.os"));
Отч.ЗаписатьФайл(ПернJson, Отч.ВJSON(Новый Структура("count, byClass, errors", Ош.Количество(), Классы, Ош)));
Сообщить("import_errors: " + Ош.Количество());