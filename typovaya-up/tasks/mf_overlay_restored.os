// Только overlay restored в готовом out: --в D:\typovaya-up-out-mf2 [--бп] [--уп] [--forms-from-up|--bp-forms-overlay]
Корень = ОбъединитьПути(ТекущийСценарий().Каталог, "..");
Отчет = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "ОтчетHTML.os"));
Мф = ЗагрузитьСценарий(ОбъединитьПути(Корень, "src", "МодулиИФормыБыстро.os"));
В = "";
Ку = "";
Кб = "";
ФормыИзУп = Истина;
Для Й = 0 По АргументыКоманднойСтроки.ВГраница() Цикл
	А = НРег(СокрЛП(АргументыКоманднойСтроки[Й]));
	Если (А = "--в" Или А = "--out") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		В = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--уп" Или А = "--up") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Ку = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли (А = "--бп" Или А = "--bp") И Й + 1 <= АргументыКоманднойСтроки.ВГраница() Тогда
		Кб = АргументыКоманднойСтроки[Й + 1];
		Й = Й + 1;
	ИначеЕсли А = "--forms-from-up" Или А = "--формы-из-уп" Тогда
		ФормыИзУп = Истина;
	ИначеЕсли А = "--bp-forms-overlay" Или А = "--overlay-form-bp" Тогда
		ФормыИзУп = Ложь;
	КонецЕсли;
КонецЦикла;
Если В = "" Тогда
	ВызватьИсключение "mf_overlay: нужен --в";
КонецЕсли;
Сводка = Отчет.ПрочитатьСводку(В);
Если Ку = "" Тогда
	Ку = Сводка.meta.source;
КонецЕсли;
Если Кб = "" Тогда
	Кб = Сводка.meta.vendor;
КонецЕсли;
Лог = Новый Массив;
Если ФормыИзУп Тогда
	Рмф = Мф.ПрименитьМодулиБпФормыИзУп(ОбъединитьПути(В, "restored"), Кб, Ку, Лог, В);
Иначе
	Рмф = Мф.ПрименитьДословноБпКRestored(ОбъединитьПути(В, "restored"), Кб, Ку, Лог, В);
КонецЕсли;
Сводка.Вставить("formsFromUp", ФормыИзУп);
Сводка.Вставить("formsKeptUp", Рмф.formsKeptUp);
Сводка.Вставить("formPrecheck", Новый Структура("checked, incompatible, topReasons",
	Рмф.formPrecheck.checked, Рмф.formPrecheck.incompatible, Рмф.formPrecheck.topReasons));
Мфм = Новый Структура;
Если Сводка.Свойство("modulesForms") Тогда
	Мфм = Сводка.modulesForms;
КонецЕсли;
Мфм.Вставить("formsKeptUp", Рмф.formsKeptUp.Количество());
Мфм.Вставить("formsXml", Рмф.formsXml);
Мфм.Вставить("formsUpRestored", ?(Рмф.Свойство("formsUpRestored"), Рмф.formsUpRestored, 0));
Сводка.Вставить("modulesForms", Мфм);
Сводка.Вставить("reapplyRestored", Формат(ТекущаяДата(), "ДФ='yyyy-MM-dd HH:mm'"));
Отчет.ЗаписатьФайл(ОбъединитьПути(В, "summary.json"), Отчет.ВJSON(Сводка));
Отчет.ЗаписатьФайл(ОбъединитьПути(В, "reapply_restored.log"), СтрСоединить(Лог, Символы.ПС));
Сообщить("overlay: formsFromUp=" + ?(ФормыИзУп, "true", "false")
	+ " keptUp=" + Рмф.formsKeptUp.Количество() + " formsBp=" + Рмф.formsXml
	+ " formsUp=" + ?(Рмф.Свойство("formsUpRestored"), Рмф.formsUpRestored, 0));