<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Sverka.App.MainWindow"
        Title="Сверка 1С"
        Width="1280"
        Height="820"
        MinWidth="960"
        MinHeight="640">
  <DockPanel Margin="12">
    <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,6,0,0">
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Выберите каталоги кнопками «Обзор…» и нажмите «Сверить»." />
    </Border>

    <TabControl x:Name="MainPages">
      <!-- Раздел 1: сверка обновления — шапка + конфигурация/расширения -->
      <TabItem Header="Сверка обновления">
        <DockPanel Margin="0,8,0,0">
          <StackPanel DockPanel.Dock="Top" Spacing="8">
            <Grid ColumnDefinitions="120,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
              <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Выгрузка ДО" />
              <TextBox Grid.Row="0" Grid.Column="1" x:Name="BeforeBox" Margin="0,0,8,8" IsReadOnly="True" Watermark="Папка выгрузки конфигурации" />
              <Button Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" Content="Обзор…" Click="OnBrowseBefore" />
              <Button Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Content="Очистить" Click="OnClearBefore" />

              <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Выгрузка ПОСЛЕ" />
              <TextBox Grid.Row="1" Grid.Column="1" x:Name="AfterBox" Margin="0,0,8,8" IsReadOnly="True" Watermark="Папка выгрузки конфигурации" />
              <Button Grid.Row="1" Grid.Column="2" Margin="0,0,8,8" Content="Обзор…" Click="OnBrowseAfter" />
              <Button Grid.Row="1" Grid.Column="3" Margin="0,0,0,8" Content="Очистить" Click="OnClearAfter" />

              <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Расширения" />
              <TextBox Grid.Row="2" Grid.Column="1" x:Name="ExtensionsBox" Margin="0,0,8,0" IsReadOnly="True" Watermark="Необязательно" />
              <Button Grid.Row="2" Grid.Column="2" Margin="0,0,8,0" Content="Обзор…" Click="OnBrowseExtensions" />
              <Button Grid.Row="2" Grid.Column="3" Content="Очистить" Click="OnClearExtensions" />
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="CompareButton" Content="Сверить" MinWidth="120" Click="OnCompare" />
              <Button x:Name="SaveButton" Content="Сохранить отчёт" IsEnabled="False" Click="OnSave" />
              <Button Content="Инструкция" Click="OnShowHelp" />
              <TextBox x:Name="FilterBox" Width="320" Watermark="Фильтр по объекту, методу, уровню" TextChanged="OnFilterChanged" />
            </StackPanel>
          </StackPanel>

          <TabControl x:Name="ComparePages" Margin="0,12,0,0">
            <TabItem Header="Инструкция">
              <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="14" MaxWidth="820" HorizontalAlignment="Left">
                  <TextBlock FontSize="20" FontWeight="SemiBold" Text="Как сверить обновление" />
                  <TextBlock TextWrapping="Wrap" Text="Программа сравнивает две папки с выгрузкой конфигурации 1С. Сначала показывает, что изменилось в самой конфигурации. Если указаны расширения, отдельно отмечает места, где эти изменения затрагивают ваш код. Базу данных программа не открывает и ничего в ней не меняет." />

                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="1. Подготовьте папки в Конфигураторе" />
                  <TextBlock TextWrapping="Wrap" Text="Для версии до обновления: Конфигурация → Выгрузить конфигурацию в файлы. Укажите пустую папку. В ней должен появиться файл Configuration.xml." />
                  <TextBlock TextWrapping="Wrap" Text="Для версии после обновления повторите выгрузку в другую пустую папку. Не складывайте две версии в один каталог." />
                  <TextBlock TextWrapping="Wrap" Text="Расширение выгружается так же, отдельной папкой: откройте расширение и снова выберите «Выгрузить конфигурацию в файлы». Несколько расширений можно положить соседними папками внутрь одной общей. В программе тогда указывается эта общая папка." />

                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="2. Укажите папки в окне" />
                  <TextBlock TextWrapping="Wrap" Text="На вкладке «Сверка обновления»: «Выгрузка ДО», «Выгрузка ПОСЛЕ» и при необходимости «Расширения». Затем нажмите «Сверить»." />

                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="3. Прочитайте вкладку «Конфигурация»" />
                  <TextBlock TextWrapping="Wrap" Text="Каждая строка — одно отличие. Щелчок по строке метода показывает его текст слева как «Было» и справа как «Стало» с маркерами −/+. Комментарии и пустые строки отличием не считаются." />

                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="4. Прочитайте вкладку «Расширения»" />
                  <TextBlock TextWrapping="Wrap" Text="Сюда попадают только те изменения конфигурации, до которых дотягивается расширение. Уровни: Критично, Адаптация, Предупреждение, Не проверено." />

                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="5. Сохраните отчёт и сравните прогоны" />
                  <TextBlock TextWrapping="Wrap" Text="«Сохранить отчёт» пишет config.html/json (и impact при наличии расширений). Сравнение двух прогонов — на верхней вкладке «К типовой / История» → «История»." />

                  <TextBlock FontSize="16" FontWeight="SemiBold" Text="6. Вынос доработок в расширение" />
                  <TextBlock TextWrapping="Wrap" Text="Верхняя вкладка «К типовой / История»: фильтр по подсистемам, реестр доработок, черновик extension/ и migration/ПереносДанных.bsl." />
                </StackPanel>
              </ScrollViewer>
            </TabItem>
            <TabItem Header="Конфигурация">
              <Grid RowDefinitions="*,180" Margin="0,8,0,0">
                <DataGrid x:Name="ChangesGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          SelectionChanged="OnChangeSelected">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="3*" MinWidth="180" />
                    <DataGridTextColumn Header="Модуль" Binding="{Binding Module}" Width="2*" MinWidth="120" />
                    <DataGridTextColumn Header="Метод" Binding="{Binding Method}" Width="2*" MinWidth="120" />
                    <DataGridTextColumn Header="Вид" Binding="{Binding Kind}" Width="120" MinWidth="90" />
                    <DataGridTextColumn Header="Что изменилось" Binding="{Binding Summary}" Width="4*" MinWidth="200" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,8,0,0">
                  <DockPanel Margin="0,0,8,0">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="Было  − удалено" />
                    <TextBox x:Name="BeforeText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" />
                  </DockPanel>
                  <DockPanel Grid.Column="1">
                    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="Стало  + добавлено" />
                    <TextBox x:Name="AfterText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" />
                  </DockPanel>
                </Grid>
              </Grid>
            </TabItem>
            <TabItem Header="Расширения">
              <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                  <TextBlock FontWeight="SemiBold" Text="Сводка по расширениям" />
                  <DataGrid x:Name="SummaryGrid"
                            MaxHeight="160"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            CanUserResizeColumns="True"
                            GridLinesVisibility="Horizontal"
                            SelectionMode="Single">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Расширение" Binding="{Binding Extension}" Width="2*" MinWidth="140" />
                      <DataGridTextColumn Header="Критично" Binding="{Binding Critical}" Width="*" />
                      <DataGridTextColumn Header="Адаптация" Binding="{Binding Adaptation}" Width="*" />
                      <DataGridTextColumn Header="Предупреждение" Binding="{Binding Warning}" Width="*" />
                      <DataGridTextColumn Header="Не проверено" Binding="{Binding Unchecked}" Width="*" />
                      <DataGridTextColumn Header="Всего" Binding="{Binding Total}" Width="*" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Text="Находки" />
                </StackPanel>
                <DataGrid x:Name="FindingsGrid"
                          IsReadOnly="True"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Расширение" Binding="{Binding Extension}" Width="*" MinWidth="100" />
                    <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="2*" MinWidth="160" />
                    <DataGridTextColumn Header="Метод" Binding="{Binding Method}" Width="*" MinWidth="100" />
                    <DataGridTextColumn Header="Вмешательство" Binding="{Binding Intervention}" Width="*" MinWidth="100" />
                    <DataGridTextColumn Header="Уровень" Binding="{Binding Severity}" Width="120" MinWidth="90" />
                    <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="3*" MinWidth="180" />
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </TabItem>
          </TabControl>
        </DockPanel>
      </TabItem>

      <!-- Раздел 2: перенос к типовой + история -->
      <TabItem Header="К типовой / История">
        <TabControl x:Name="TransferPages" Margin="0,8,0,0">
          <TabItem Header="К типовой">
            <Grid ColumnDefinitions="260,6,*" Margin="0,8,0,0">
              <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Область" />
                  <WrapPanel Orientation="Horizontal">
                    <Button Margin="0,0,6,6" Content="Загрузить" Click="OnLoadSubsystems" />
                    <Button Margin="0,0,6,6" Content="Из файла…" Click="OnLoadScopeFile" />
                    <Button Margin="0,0,6,6" Content="Все" Click="OnSelectAllSubsystems" />
                    <Button Margin="0,0,6,6" Content="Снять" Click="OnClearSubsystems" />
                  </WrapPanel>
                  <CheckBox x:Name="IncludeDescendantsBox" IsChecked="True" Content="Включать вложенные" />
                  <TextBlock x:Name="SubsystemStatusText" TextWrapping="Wrap" FontSize="12" Text="Подсистемы не загружены — вся конфигурация." />
                </StackPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" MaxHeight="140">
                  <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,4" Text="Доп. объекты" />
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6">
                    <TextBox x:Name="ExtraObjectBox" Width="160" Watermark="CommonModule.Имя" />
                    <Button Content="+" MinWidth="28" Click="OnAddExtraObject" />
                    <Button Content="−" MinWidth="28" Click="OnRemoveExtraObject" />
                  </StackPanel>
                  <ListBox x:Name="ExtraObjectsList" SelectionMode="Single" />
                </DockPanel>
                <TreeView x:Name="SubsystemTree" Margin="0,8,0,0">
                  <TreeView.ItemTemplate>
                    <TreeDataTemplate ItemsSource="{Binding Children}">
                      <CheckBox Content="{Binding Title}"
                                IsThreeState="True"
                                IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                    </TreeDataTemplate>
                  </TreeView.ItemTemplate>
                </TreeView>
              </DockPanel>

              <GridSplitter Grid.Column="1" Width="6" ResizeDirection="Columns" />

              <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                  <TextBlock FontWeight="SemiBold" FontSize="15" Text="К переносу в расширение" />
                  <Grid ColumnDefinitions="130,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="В типовой" />
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TypicalBox" Margin="0,0,8,6" IsReadOnly="True" Watermark="Выгрузка типовой конфигурации" />
                    <Button Grid.Row="0" Grid.Column="2" Margin="0,0,8,6" Content="Обзор…" Click="OnBrowseTypical" />
                    <Button Grid.Row="0" Grid.Column="3" Margin="0,0,0,6" Content="Очистить" Click="OnClearTypical" />

                    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="В доработанной" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="CustomizedBox" Margin="0,0,8,6" IsReadOnly="True" Watermark="Выгрузка доработанной конфигурации" />
                    <Button Grid.Row="1" Grid.Column="2" Margin="0,0,8,6" Content="Обзор…" Click="OnBrowseCustomized" />
                    <Button Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" Content="Очистить" Click="OnClearCustomized" />

                    <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Имя расширения" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="TransferNameBox" Margin="0,0,8,6" Watermark="Доработки" Text="Доработки" />

                    <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Префикс" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="TransferPrefixBox" Margin="0,0,8,0" Watermark="Дораб_" Text="Дораб_" />
                  </Grid>
                  <CheckBox x:Name="ShowRemovedMetadataBox"
                            IsChecked="False"
                            Content="Показывать удалённые метаданные" />
                  <WrapPanel Orientation="Horizontal">
                    <Button x:Name="TransferFindButton" Margin="0,0,8,6" Content="Найти доработки" MinWidth="140" Click="OnFindTransfer" />
                    <Button x:Name="TransferSaveButton" Margin="0,0,8,6" Content="Сохранить черновик" IsEnabled="False" Click="OnSaveTransfer" />
                    <Button Margin="0,0,8,6" Content="Сохранить область" Click="OnSaveScope" />
                    <ComboBox x:Name="TransferDecisionFilter" Margin="0,0,8,6" Width="130" SelectedIndex="0" SelectionChanged="OnTransferDecisionFilterChanged">
                      <ComboBoxItem Content="Все решения" />
                      <ComboBoxItem Content="Авто" />
                      <ComboBoxItem Content="Подсветка" />
                      <ComboBoxItem Content="Вручную" />
                      <ComboBoxItem Content="Данные" />
                      <ComboBoxItem Content="Пропуск" />
                    </ComboBox>
                    <TextBox x:Name="TransferFilterBox" Margin="0,0,8,6" Width="220" Watermark="Фильтр" TextChanged="OnTransferFilterChanged" />
                  </WrapPanel>
                  <TextBlock x:Name="TransferStatusText" TextWrapping="Wrap" Text="Доработки ещё не искали." />
                </StackPanel>

                <Grid RowDefinitions="*,160" Margin="0,8,0,0">
                  <DataGrid x:Name="TransferGrid"
                            IsReadOnly="True"
                            AutoGenerateColumns="False"
                            CanUserReorderColumns="True"
                            CanUserResizeColumns="True"
                            GridLinesVisibility="Horizontal"
                            SelectionMode="Single"
                            SelectionChanged="OnTransferSelected"
                            LoadingRow="OnTransferLoadingRow">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="3*" MinWidth="180" />
                      <DataGridTextColumn Header="Метод" Binding="{Binding Method}" Width="2*" MinWidth="120" />
                      <DataGridTextColumn Header="Вид" Binding="{Binding Kind}" Width="110" MinWidth="80" />
                      <DataGridTextColumn Header="Решение" Binding="{Binding Decision}" Width="110" MinWidth="80" />
                      <DataGridTextColumn Header="Хук" Binding="{Binding Hook}" Width="140" MinWidth="100" />
                      <DataGridTextColumn Header="Причина" Binding="{Binding Reason}" Width="4*" MinWidth="200" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="0,8,0,0">
                    <DockPanel Margin="0,0,8,0">
                      <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="В типовой  − удалено" />
                      <TextBox x:Name="TransferBeforeText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" />
                    </DockPanel>
                    <DockPanel Grid.Column="1">
                      <TextBlock DockPanel.Dock="Top" Margin="0,0,0,4" Text="В доработанной  + добавлено" />
                      <TextBox x:Name="TransferAfterText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,monospace" />
                    </DockPanel>
                  </Grid>
                </Grid>
              </DockPanel>
            </Grid>
          </TabItem>
          <TabItem Header="История">
            <DockPanel Margin="0,8,0,0">
              <StackPanel DockPanel.Dock="Top" Spacing="8">
                <TextBlock TextWrapping="Wrap" Text="Сравнение двух сохранённых прогонов (папки с config.json / impact.json)." />
                <Grid ColumnDefinitions="140,*,Auto,Auto" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Прошлый прогон" />
                  <TextBox Grid.Row="0" Grid.Column="1" x:Name="PreviousRunBox" Margin="0,0,8,8" IsReadOnly="True" Watermark="Папка с сохранённым отчётом" />
                  <Button Grid.Row="0" Grid.Column="2" Margin="0,0,8,8" Content="Обзор…" Click="OnBrowsePreviousRun" />
                  <Button Grid.Row="0" Grid.Column="3" Margin="0,0,0,8" Content="Очистить" Click="OnClearPreviousRun" />

                  <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Текущий прогон" />
                  <TextBox Grid.Row="1" Grid.Column="1" x:Name="CurrentRunBox" Margin="0,0,8,0" IsReadOnly="True" Watermark="Папка с сохранённым отчётом" />
                  <Button Grid.Row="1" Grid.Column="2" Margin="0,0,8,0" Content="Обзор…" Click="OnBrowseCurrentRun" />
                  <Button Grid.Row="1" Grid.Column="3" Content="Очистить" Click="OnClearCurrentRun" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="CompareRunsButton" Content="Сравнить прогоны" MinWidth="160" Click="OnCompareRuns" />
                  <TextBox x:Name="HistoryFilterBox" Width="320" Watermark="Фильтр по статусу, объекту, методу" TextChanged="OnHistoryFilterChanged" />
                  <TextBlock x:Name="HistoryStatusText" VerticalAlignment="Center" TextWrapping="Wrap" Text="Прогоны не сравнивались." />
                </StackPanel>
              </StackPanel>
              <DataGrid x:Name="HistoryGrid"
                        Margin="0,8,0,0"
                        IsReadOnly="True"
                        AutoGenerateColumns="False"
                        CanUserReorderColumns="True"
                        CanUserResizeColumns="True"
                        GridLinesVisibility="Horizontal"
                        SelectionMode="Single">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="110" MinWidth="90" />
                  <DataGridTextColumn Header="Раздел" Binding="{Binding Section}" Width="130" MinWidth="100" />
                  <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="3*" MinWidth="180" />
                  <DataGridTextColumn Header="Метод" Binding="{Binding Method}" Width="2*" MinWidth="120" />
                  <DataGridTextColumn Header="Вид" Binding="{Binding Kind}" Width="140" MinWidth="100" />
                  <DataGridTextColumn Header="Суть" Binding="{Binding Summary}" Width="4*" MinWidth="200" />
                </DataGrid.Columns>
              </DataGrid>
            </DockPanel>
          </TabItem>
        </TabControl>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
